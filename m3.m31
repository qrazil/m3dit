// m3: a terminal modal editor in m31.
//
//   m3 FILE...   open the files as buffers (a new buffer when one does not exist yet)
//   m3           the files the project had open at its last exit (a session), else an empty buffer
//   m3 --no-session   start with an empty buffer
//   m3 --keymap FILE  read FILE as the keymap file (--keymap NONE reads none)
//   m3 --no-mouse     do not ask the terminal for mouse reports
//   m3 --no-anim      no animation (also $M3_NO_ANIM=1, TERM=dumb, or :set noanimate)
//   m3 --theme NAME   start with that colour theme
//   m3 --version      print the version and exit; --help is generated, --completions SHELL
//
// The keymap file holds ex lines (`nnoremap`, `let mapleader`, `set` ...); by
// default it is $XDG_CONFIG_HOME/m3/keymap.vim (~/.config/...).
//
// Vim keys (the engine is checked against nvim, see DESIGN.md), `:w` writes,
// `:q` quits (`:q!` discards, `:wq` / `ZZ` write and quit).

import args;
import io;
import os;
import term;
import tui.app.TUI_app;
import tui.core.TUI_buffer;
import tui.core.TUI_geometry;
import tui.core.TUI_mouse;
import tui.core.TUI_style;
import ui.MED_theme;
import ui.MED_app;
import ui.MED_clip;
import ui.MED_sample;
import ui.MED_session;
import ui.MED_state;

// How many colours the terminal has: truecolor when it says so (COLORTERM,
// or a terminal program known to), 256 for a *256color TERM (Terminal.app),
// else the 16 ANSI colours.
TUI_style.Depth colour_depth() {
    str colour_term = os.env("COLORTERM").or("");
    if (colour_term == "truecolor" || colour_term == "24bit") {
        return TUI_style.Depth.TrueColour;
    }
    str program = os.env("TERM_PROGRAM").or("");
    if (program == "iTerm.app" || program == "WezTerm" || program == "vscode" || program == "ghostty") {
        return TUI_style.Depth.TrueColour;
    }
    str term_name = os.env("TERM").or("");
    if (term_name.contains("truecolor") || term_name.contains("direct") || term_name == "xterm-kitty" || term_name == "alacritty") {
        return TUI_style.Depth.TrueColour;
    }
    if (term_name.contains("256color")) {
        return TUI_style.Depth.Ansi256;
    }
    return TUI_style.Depth.Ansi16;
}

// Whether that is the 16-colour ANSI palette and no more.
bool is_sixteen(TUI_style.Depth depth) {
    match (depth) {
        case Ansi16: {
            return true;
        }
        case Ansi256: {
            return false;
        }
        case TrueColour: {
            return false;
        }
    }
}

// Whether colours are 24-bit (fades blend colours only then).
bool is_truecolour() {
    str colour_term = os.env("COLORTERM").or("");
    return colour_term == "truecolor" || colour_term == "24bit" || os.env("TERM_PROGRAM").or("") == "iTerm.app" || os.env("TERM_PROGRAM").or("") == "WezTerm" || os.env("TERM_PROGRAM").or("") == "ghostty";
}

const str VERSION = "0.11.0";

// Standard output, for the options that print and exit.
void say(str text) {
    io.File out = io.stdout();
    match (out.write(text.to_bytes())) {
        case Ok(int count): {
        }
        case Err(io.Error error): {
        }
    }
}

// The command line is Oro's `args` grammar (m31's docs/cli-conventions.md):
// `--keymap FILE`, `--keymap=FILE`, `--k FILE`; `-word` would be a command and
// there are none. vim's `-u` was the one single-dash option; it, `-v` and `-h`
// still work for this one release (each warns) and are then deleted.
args.Parser table = args.Parser("m3", summary: "a terminal modal editor with Vim keys");
table.version = VERSION;
table.value("keymap", short: "k", placeholder: "FILE|NONE", help: "read FILE as the keymap file; NONE reads none and keeps no state files (default: $M3_KEYMAP, else $XDG_CONFIG_HOME/m3/keymap.vim)");
table.value("theme", placeholder: "NAME", help: "start with that colour theme (:theme NAME, <Space>fC, ~/.config/m3/themes/NAME.toml adds one)");
table.value("colors", placeholder: "DEPTH", help: "the colour depth --dump-sample writes at: 16, 256 or true (default: the terminal's)");
table.flag("dump-sample", help: "write the theme (every built-in one without --theme) drawn on sample code as ANSI text and exit");
table.flag("no-session", help: "start with an empty buffer instead of the files the project had open at its last exit");
table.flag("no-anim", help: "no animation (M3_NO_ANIM=1 or TERM=dumb does the same, and so does :set noanimate)");
table.flag("no-mouse", help: "do not ask the terminal for mouse reports (M3_NO_MOUSE=1 does the same)");
table.tail("files", placeholder: "FILE", help: "files to open as buffers (a new buffer when one does not exist yet); with none, an empty buffer");
table.completions();
table.epilog = "keys: Vim; <Space> leader (which-key), <Space>ff files, <Space>e file tree, <Space>? all keys, :Plugins, :q quits\nexit status: 0 ok, 1 could not start (no terminal, unreadable file), 2 usage error";
List<str> raw = os.arguments();
raw.remove_at(0);
args.Parsed given = table.parse_or_exit(args.migrate("m3", raw, ["-u", "--keymap", "-v", "--version", "-h", "--help"]));
str theme_name = given.value("theme").or("");
str dump_colours = given.value("colors").or("");
if (dump_colours != "" && dump_colours != "16" && dump_colours != "256" && dump_colours != "true" && dump_colours != "24") {
    table.fail("'--colors' needs 16, 256 or true, and got '" + dump_colours + "'");
}
bool is_dump = given.is_flag_set("dump-sample");
if (is_dump) {
    TUI_style.Depth depth = colour_depth();
    if (dump_colours == "16") {
        depth = TUI_style.Depth.Ansi16;
    } else if (dump_colours == "256") {
        depth = TUI_style.Depth.Ansi256;
    } else if (dump_colours == "true" || dump_colours == "24") {
        depth = TUI_style.Depth.TrueColour;
    }
    str themes_directory = MED_theme.default_user_directory();
    List<str> wanted = [theme_name];
    if (theme_name == "") {
        wanted = MED_theme.available(themes_directory);
    }
    for (str one in wanted) {
        say(MED_sample.screens(one, themes_directory, depth));
    }
    os.exit(0);
}
if (!term.is_terminal(0) || !term.is_terminal(1)) {
    io.eprint("m3: needs a terminal on standard input and output\n");
    os.exit(1);
}
List<str> files = given.tail("files");
// --keymap FILE reads that keymap file, --keymap NONE reads none
str keymap = MED_app.keymap_path();
bool is_keymap_required = false;
match (given.value("keymap")) {
    case Some(str chosen): {
        keymap = chosen;
        is_keymap_required = true;
        if (keymap == "NONE") {
            keymap = "";
        }
    }
    case None: {
    }
}
bool is_mouse = os.env("M3_NO_MOUSE").or("") == "" && !given.is_flag_set("no-mouse");
bool is_session = !given.is_flag_set("no-session");
bool is_no_anim = given.is_flag_set("no-anim");
// `m3` with no file starts the project's session (the files it had open at its last exit) when there is one;
// a clean run (--keymap NONE) and --no-session start with an empty buffer
bool is_project_session = files.size() == 0 && keymap != "" && is_session;
MED_session.Session saved = MED_session.Session();
if (is_project_session) {
    saved = MED_app.load_project_session(MED_state.default_directory());
    List<str> reopened = [];
    for (MED_session.Entry entry in saved.entries) {
        if (entry.path == saved.active) {
            reopened.insert(0, entry.path);
        } else {
            reopened.push(entry.path);
        }
    }
    files = reopened;
}
if (files.size() == 0) {
    files.push("");
}

// A light terminal background, as COLORFGBG ("foreground;background") says.
bool is_light_background() {
    str pair = os.env("COLORFGBG").or("");
    if (pair == "") {
        return false;
    }
    List<str> parts = pair.split(";");
    int background = parts[parts.size() - 1].parse_int().or(0);
    return background == 7 || background == 15;
}

match (MED_app.open_all(files)) {
    case Ok(MED_app.App app): {
        if (is_light_background()) {
            app.editor.opts.set("background", "light");
        }
        // themes: user files first, the 16-colour twin of the default at 16 colours
        app.theme_directory = MED_theme.default_user_directory();
        app.is_sixteen_colours = is_sixteen(colour_depth());
        app.did_use_theme(MED_theme.DARK);
        app.clipboard = MED_clip.detect();
        app.editor.regs.has_clipboard = app.clipboard.is_present;
        if (keymap != "") {
            // persistent undo is on by default in a normal run (`:set noundofile` in the keymap file turns it off)
            app.editor.opts.set("undofile", "true");
        }
        app.ext_install();
        app.load_keymap(keymap, is_keymap_required);
        if (keymap != "") {
            // --keymap NONE is a clean run: no state files either
            app.state_directory = MED_state.default_directory();
            app.apply_project_all();
            app.load_snippets(keymap);
            app.restore_position();
            app.restore_undo();
            app.apply_session_cursors(saved);
            app.apply_session_layout(saved);
        }
        if (theme_name != "") {
            // after the keymap file, so the flag wins over its :colorscheme
            app.did_use_theme(theme_name);
        }
        TUI_style.Depth depth = colour_depth();
        TUI_app.Loop loop = TUI_app.Loop(should_report_paste: true, should_report_mouse: is_mouse, should_sync: true, should_scroll: true, should_report_focus: true, should_manage_cursor: true, animate_ms: 50, depth: depth);
        app.ext_started();
        app.motion.loop = loop;
        app.motion.configure(is_no_anim, is_truecolour(), !is_light_background());
        match (loop.run_with((TUI_buffer.Buffer buffer, TUI_geometry.Rect area) => app.render(buffer, area), (term.Event event) => app.handle(event), (int elapsed_ms) => app.tick(elapsed_ms), (TUI_mouse.Routed routed) => app.handle_mouse(routed))) {
            case Ok(int frames): {
                // the file in front counts as visited even when the editor is closed within a tick
                app.ext_stop();
                app.note_state();
                if (is_project_session) {
                    app.save_session("");
                }
            }
            case Err(term.Error error): {
                io.eprint("m3: " + error.to_str() + "\n");
                os.exit(1);
            }
        }
    }
    case Err(str message): {
        io.eprint("m3: " + message + "\n");
        os.exit(1);
    }
}
