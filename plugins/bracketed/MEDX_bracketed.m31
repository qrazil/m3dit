/* The `bracketed` plugin: `[b ]b [B ]B` (buffers), `[l ]l [L ]L` (the default list), `[t ]t` (TODO comments), `[h ]h` and
 * `[c ]c` (git hunks), `[d ]d` (diagnostics). It was `App.did_bracketed` and two special cases in `App.handle`; now it
 * is data: Normal-mode maps that run the ex command of the same job (`:bnext`, `:lnext`, `:Todo next`, `:Hunk next`,
 * `:Lsp next_diag`). Nothing runs at activation. `wants: todo` only so that `:Todo` exists when `[t` is typed. */

import ext.MED_ext;

type Bracketed {
}

Result<bool, str> Bracketed.activate(MED_ext.Registry api) {
    return Result<bool, str>.Ok(true);
}

void pair(MED_ext.Spec spec, str previous_keys, str next_keys, str previous, str next, str previous_desc, str next_desc) {
    spec.maps.push(MED_ext.map(MED_ext.MapMode.Normal, previous_keys, previous, previous_desc));
    spec.maps.push(MED_ext.map(MED_ext.MapMode.Normal, next_keys, next, next_desc));
}

pub void register(MED_ext.Registry api) {
    MED_ext.Spec spec = MED_ext.Spec("bracketed", summary: "[b ]b [l ]l [d ]d [h ]h [t ]t [c ]c");
    spec.wants.push("todo");
    spec.wants.push("git");
    pair(spec, "[b", "]b", "bprevious", "bnext", "previous buffer", "next buffer");
    pair(spec, "[B", "]B", "bfirst", "blast", "first buffer", "last buffer");
    pair(spec, "[l", "]l", "lprev", "lnext", "previous list entry", "next list entry");
    pair(spec, "[L", "]L", "lfirst", "llast", "first list entry", "last list entry");
    pair(spec, "[t", "]t", "Todo prev", "Todo next", "previous TODO comment", "next TODO comment");
    pair(spec, "[h", "]h", "Hunk prev", "Hunk next", "previous git hunk", "next git hunk");
    pair(spec, "[H", "]H", "Hunk first", "Hunk last", "first git hunk", "last git hunk");
    // `[c ]c` jump between changes in diff mode (:diffthis, planned): the `default` profile leaves them to vim
    spec.maps.push(MED_ext.map_in(MED_ext.MapMode.Normal, "[c", "Hunk prev", "previous git change", "nvim legacy"));
    spec.maps.push(MED_ext.map_in(MED_ext.MapMode.Normal, "]c", "Hunk next", "next git change", "nvim legacy"));
    pair(spec, "[d", "]d", "Lsp prev_diag", "Lsp next_diag", "previous diagnostic", "next diagnostic");
    api.did_plugin(spec, Bracketed());
}
