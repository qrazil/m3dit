// The `bracketed` plugin through the App: [b ]b [B ]B walk the buffers, the keys are the plugin's (they go with
// :PluginDisable), and which-key labels come from the plugin's maps.

import tests.MED_check;
import ui.MED_app;
import term;

term.Event press(int code_point) {
    return term.Event.Key(term.Key(term.Code.Char(code_point), 0));
}

void type_text(MED_app.App app, str text) {
    for (int index in 0 .. text.size()) {
        if (text.byte_at(index) == 13) {
            app.handle(term.Event.Key(term.Key(term.Code.Enter, 0)));
        } else {
            app.handle(press(text.byte_at(index)));
        }
    }
}

MED_check.Check check = MED_check.Check();
match (MED_app.open("")) {
    case Ok(MED_app.App app): {
        app.ext_install();
        app.ext_started();
        check.eq_str("active", app.ext.state_text(app.ext.find_plugin("bracketed")), "active");
        type_text(app, ":enew\r:enew\r");
        check.eq_int("three buffers, the last is current", app.current_id, 3);
        type_text(app, "[b");
        check.eq_int("[b goes to the previous buffer", app.current_id, 2);
        type_text(app, "]b");
        check.eq_int("]b goes to the next", app.current_id, 3);
        type_text(app, "[B");
        check.eq_int("[B goes to the first", app.current_id, 1);
        type_text(app, "]B");
        check.eq_int("]B goes to the last", app.current_id, 3);
        type_text(app, "]q");
        check.ok("]q with an empty quickfix list is not an error that stops the editor", app.current_id == 3);
        check.eq_str("which-key shows the plugin's label", app.ext.desc_of_keys("n", "]b"), "next buffer");
        type_text(app, ":PluginDisable bracketed\r");
        type_text(app, "[b");
        check.eq_int("disabled: [b does nothing", app.current_id, 3);
        type_text(app, ":PluginEnable bracketed\r[b");
        check.eq_int("enabled again", app.current_id, 2);
    }
    case Err(str message): {
        print("cannot open: " + message);
    }
}
check.finish("t_bracketed");
