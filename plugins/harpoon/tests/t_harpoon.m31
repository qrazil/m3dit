// The `harpoon` plugin through the App: pin, jump by number, next and previous, the menu, remove, and that the keys
// and the which-key labels are the plugin's. The state directory is a scratch directory (M3_TEST_TMP).

import fs;
import io;
import os;
import tests.MED_check;
import ui.MED_app;
import ui.MED_state;
import term;

term.Event press(int code_point) {
    return term.Event.Key(term.Key(term.Code.Char(code_point), 0));
}

void type_text(MED_app.App app, str text) {
    for (int index in 0 .. text.size()) {
        if (text.byte_at(index) == 13) {
            app.handle(term.Event.Key(term.Key(term.Code.Enter, 0)));
        } else {
            app.handle(press(text.byte_at(index)));
        }
    }
}

void write_file(str path, str text) {
    match (io.write(path, text)) {
        case Ok(int count): {
        }
        case Err(io.Error error): {
        }
    }
}

MED_check.Check check = MED_check.Check();
str base = os.env("M3_TEST_TMP").or("/tmp") + "/harpoon";
match (fs.makedirs(base + "/state")) {
    case Ok(bool did_make): {
    }
    case Err(io.Error error): {
    }
}
write_file(base + "/a.txt", "alpha\n");
write_file(base + "/b.txt", "beta\n");
write_file(base + "/c.txt", "gamma\n");
match (MED_app.open(base + "/a.txt")) {
    case Ok(MED_app.App app): {
        app.state_directory = base + "/state";
        app.ext_install();
        app.ext_started();
        MED_state.write_lines(base + "/state", "harpoon-" + MED_state.project_key(app.ext.abs_root), []);
        check.eq_str("lazy until a command runs", app.ext.state_text(app.ext.find_plugin("harpoon")), "lazy");
        type_text(app, " ha");
        check.eq_str("<Space>ha pins", app.notice, "Harpoon: pinned as 1");
        check.eq_str("active now", app.ext.state_text(app.ext.find_plugin("harpoon")), "active");
        type_text(app, " ha");
        check.eq_str("a second time it says so", app.notice, "Harpoon: already pinned (1)");
        type_text(app, ":e " + base + "/b.txt\r ha");
        check.eq_str("another file is pinned as 2", app.notice, "Harpoon: pinned as 2");
        type_text(app, ":e " + base + "/c.txt\r ha");
        check.eq_str("and 3", app.notice, "Harpoon: pinned as 3");
        type_text(app, " 1");
        check.ok("<Space>1 opens the first", app.path.ends_with("/a.txt"));
        check.ok("and says where", app.notice.starts_with("Harpoon 1/3: "));
        type_text(app, " hn");
        check.ok("<Space>hn goes on to the second", app.path.ends_with("/b.txt"));
        type_text(app, " hp");
        type_text(app, " hp");
        check.ok("<Space>hp wraps to the last", app.path.ends_with("/c.txt"));
        type_text(app, " 7");
        check.eq_str("a number that is not pinned", app.notice, "Harpoon: no file 7");
        type_text(app, " hx");
        check.eq_str("<Space>hx unpins the current file", app.notice, "Harpoon: removed");
        type_text(app, " he");
        check.ok("the menu is the finder", app.has_picker);
        type_text(app, "\x1b");
        check.eq_str("which-key shows the plugin's label", app.ext.desc_of_keys("n", " ha"), "Harpoon: add this file");
        type_text(app, ":PluginDisable harpoon\r 1");
        check.ok("disabled: <Space>1 does nothing", app.path.ends_with("/c.txt") || app.notice != "Harpoon 1/2: a.txt");
    }
    case Err(str message): {
        print("cannot open: " + message);
    }
}
check.finish("t_harpoon");
