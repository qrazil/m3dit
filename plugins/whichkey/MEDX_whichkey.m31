// The `whichkey` plugin: after a pause, a pending leader (`<Space>`) or prefix (`g` `z` `[` `]` `<C-w>`, an operator)
// shows the keys that can follow. It was two timers in `App.tick_work`; now the host tells it about pending keys (the
// `PendingKeys` event, API 0.3.0) and it decides when the popup appears: `show_key_help` after DELAY_MS since the last
// key. The keymap tree (core rows, the plugins' `MapSpec`s, the user's maps) and the popup widget stay in the core:
// a build without this plugin has the same keys and no popup. The leader popup is shown even with `:set nowhichkey`
// (that option switches the prefix help only), as before.

import ext.MED_ext;

/// Milliseconds a pending key waits before the popup shows (400, the core's WHICH_KEY_MS before the plugin).
const int DELAY_MS = 400;

Result<bool, str> pending(MED_ext.Ctx context, MED_ext.Info info) {
    if (info.keys.size() == 0 && !info.is_leader) {
        return Result<bool, str>.Ok(true);
    }
    if (info.is_help_shown || info.elapsed_ms < DELAY_MS) {
        return Result<bool, str>.Ok(true);
    }
    if (!info.is_leader && !context.is_flag_on("whichkey", true)) {
        return Result<bool, str>.Ok(true);
    }
    context.show_key_help();
    return Result<bool, str>.Ok(true);
}

type WhichKey {
}

Result<bool, str> WhichKey.activate(MED_ext.Registry api) {
    api.did_hook(MED_ext.Event.PendingKeys, (MED_ext.Ctx context, MED_ext.Info info) => pending(context, info));
    return Result<bool, str>.Ok(true);
}

pub void register(MED_ext.Registry api) {
    MED_ext.Spec spec = MED_ext.Spec("whichkey", summary: "popup of the keys that can follow a pending prefix");
    api.did_plugin(spec, WhichKey());
}
