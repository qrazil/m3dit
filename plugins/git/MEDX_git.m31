/* The `git` plugin: the git gutter (signs for added, changed and removed rows against the index), the hunk commands
 * (`:Hunk stage|reset|undo|preview|next|prev`, `ih` / `ah` through the hunk spans), `:Git log|show|diff|blame|line`,
 * `:GitSigns`, the branch and hunk counts for the status line, and the preview of commit entries in the finder. It
 * was `App.git_info`, `draw_sign`'s git half, `run_git_action`, `run_git_read`, `run_hunk_command`, the branch timer and
 * `ui/MED_git*.m31`; now it is these modules over API 0.5.0: `Ctx.set_signs`, `set_hunk_spans`, `set_git_summary`,
 * `show_text`, `open_scratch`, `pick_list`, `run_in`, `change_count` and `Registry.did_preview`. Reads go through the m31git
 * library first; `git` runs (through `Ctx.run_in`) only where the library cannot answer.
 *
 *   MEDX_git_lib    the library calls (open a repository, HEAD and index contents, log, blame, show, diff, staging)
 *   MEDX_git_hunk   the diff of the buffer against the base, hunk patches and staging
 *   MEDX_git_cmd    what `:Git ARGS` shows */

import engine.MED_buffer;
import ext.MED_ext;
import fs;
import plugins.git.MEDX_git_cmd;
import plugins.git.MEDX_git_hunk;
import plugins.git.MEDX_git_lib;

/// How often (ms) HEAD and the branch are read again.
const int REFRESH_MS = 3000;
const int FIRST_BRANCH_MS = 500;

/// What is known about the file of one buffer.
type FileInfo {
    /// HEAD was asked for (and, when `has_base`, answered).
    bool is_checked = false;
    bool has_base = false;
    List<str> base = [];
    /// `Ctx.change_count` when `hunks` was made.
    int tick = -1;
    MEDX_git_hunk.Hunks hunks = MEDX_git_hunk.Hunks();
}

/// The plugin's state: the files by buffer number, the branch last read and the timers.
type State {
    Map<str, FileInfo> files = {};
    str branch = "";
    int branch_ms = 0;
    int refresh_ms = 0;
}

/// `Ctx.run_in` as the `git` runner of the library modules.
type ContextShell {
    MED_ext.Ctx context;
}

MED_ext.Ran ContextShell.run(List<str> argv, str cwd, str input) {
    return context.run_in(argv, cwd, input, 1000);
}

MEDX_git_lib.Shell shell_of(MED_ext.Ctx context) {
    return ContextShell(context);
}

Result<bool, str> done(MED_ext.Ctx context, str text) {
    context.say(text);
    return Result<bool, str>.Ok(true);
}

/// The lines of the buffer.
List<str> buffer_lines(MED_ext.Ctx context) {
    List<str> lines = [];
    for (int row in 0 .. context.line_count()) {
        lines.push(context.line(row));
    }
    return lines;
}

/// The sign of one change kind.
MED_ext.Sign sign_of(int row, int kind) {
    if (kind == MEDX_git_hunk.ADDED) {
        return MED_ext.Sign(row, "+", "diff.plus");
    }
    if (kind == MEDX_git_hunk.CHANGED) {
        return MED_ext.Sign(row, "~", "diff.delta");
    }
    return MED_ext.Sign(row, "_", "diff.minus");
}

/// The status line numbers for the file as last diffed.
MED_ext.GitSummary summary_of(State state, MED_ext.Ctx context) {
    MED_ext.GitSummary summary = MED_ext.GitSummary(branch: state.branch);
    match (state.files.get(context.buffer_id.to_str())) {
        case Some(FileInfo known): {
            if (known.has_base) {
                summary.has_hunks = true;
                for (int kind in known.hunks.kinds) {
                    if (kind == MEDX_git_hunk.ADDED) {
                        summary.added = summary.added + 1;
                    } else if (kind == MEDX_git_hunk.CHANGED) {
                        summary.changed = summary.changed + 1;
                    } else if (kind == MEDX_git_hunk.REMOVED) {
                        summary.removed = summary.removed + 1;
                    }
                }
            }
        }
        case None: {
        }
    }
    return summary;
}

/// Tell the host what the file looks like now: the signs, the hunk spans and the status line counts.
void publish(State state, MED_ext.Ctx context, FileInfo info) {
    List<MED_ext.Sign> signs = [];
    MED_ext.GitSummary summary = MED_ext.GitSummary(branch: state.branch);
    if (info.has_base) {
        summary.has_hunks = true;
        for (int row in 0 .. info.hunks.kinds.size()) {
            int kind = info.hunks.kinds[row];
            if (kind == MEDX_git_hunk.NONE) {
                continue;
            }
            signs.push(sign_of(row, kind));
            if (kind == MEDX_git_hunk.ADDED) {
                summary.added = summary.added + 1;
            } else if (kind == MEDX_git_hunk.CHANGED) {
                summary.changed = summary.changed + 1;
            } else {
                summary.removed = summary.removed + 1;
            }
        }
        context.set_hunk_spans(MEDX_git_hunk.spans(info.hunks));
    } else {
        context.set_hunk_spans([]);
    }
    context.set_signs(signs, info.has_base);
    context.set_git_summary(summary);
}

/** The git information of this buffer's file, brought up to date: HEAD is read once, the diff again when the text
 * changed (`is_forced` reads HEAD again too). The signs and the status line follow. */
FileInfo refresh(State state, MED_ext.Ctx context, bool is_forced) {
    FileInfo info = FileInfo();
    str file = context.file;
    str slot_key = context.buffer_id.to_str();
    if (file.size() == 0 || !context.is_flag_on("gitsigns", true) || fs.is_directory(file)) {
        context.set_signs([], false);
        context.set_hunk_spans([]);
        context.set_git_summary(MED_ext.GitSummary(branch: state.branch));
        return info;
    }
    match (state.files.get(slot_key)) {
        case Some(FileInfo known): {
            info = known;
        }
        case None: {
        }
    }
    if (is_forced) {
        info.is_checked = false;
    }
    if (!info.is_checked) {
        info.is_checked = true;
        match (MEDX_git_hunk.head_lines(shell_of(context), file)) {
            case Some(List<str> lines): {
                info.has_base = true;
                info.base = lines;
            }
            case None: {
                info.has_base = false;
            }
        }
        info.tick = -1;
    }
    if (info.has_base) {
        int tick = context.change_count();
        if (tick != info.tick || info.tick < 0) {
            info.tick = tick;
            info.hunks = MEDX_git_hunk.diff(info.base, buffer_lines(context));
        }
    }
    state.files.set(slot_key, info);
    publish(state, context, info);
    return info;
}

/// The branch of this buffer's file, read from `.git/HEAD`.
void read_branch(State state, MED_ext.Ctx context) {
    // a buffer with no file is in the working directory
    state.branch = MEDX_git_hunk.branch_of(MEDX_git_hunk.directory_of(context.file));
}

Result<bool, str> opened(State state, MED_ext.Ctx context, MED_ext.Info info) {
    refresh(state, context, false);
    return Result<bool, str>.Ok(true);
}

/** Every TICK_MS: the diff again when the text changed (in Normal mode, so typing is not interrupted), HEAD and the
 * branch every REFRESH_MS. */
Result<bool, str> ticked(State state, MED_ext.Ctx context, MED_ext.Info info) {
    state.branch_ms = state.branch_ms + info.elapsed_ms;
    state.refresh_ms = state.refresh_ms + info.elapsed_ms;
    bool is_forced = false;
    if (state.refresh_ms >= REFRESH_MS) {
        state.refresh_ms = 0;
        is_forced = true;
    }
    if (state.branch_ms >= REFRESH_MS || (state.branch.size() == 0 && state.branch_ms >= FIRST_BRANCH_MS)) {
        state.branch_ms = 0;
        str before = state.branch;
        read_branch(state, context);
        if (state.branch != before) {
            // only a changed branch is told to the host (the signs stay as they are)
            context.set_git_summary(summary_of(state, context));
        }
    }
    if (is_forced) {
        refresh(state, context, true);
        return Result<bool, str>.Ok(true);
    }
    match (state.files.get(context.buffer_id.to_str())) {
        case Some(FileInfo known): {
            if (known.has_base && !context.has_signs()) {
                // the plugin was switched off and on: the host dropped the signs
                refresh(state, context, false);
            } else if (known.has_base && known.tick != context.change_count() && context.mode() == MED_ext.MODE_NORMAL) {
                refresh(state, context, false);
            }
        }
        case None: {
            refresh(state, context, false);
        }
    }
    return Result<bool, str>.Ok(true);
}

// ------------------------------------------------------------------ :Git

/** `:Git commit MESSAGE`, `:Git pull`, `:Git push`, `:Git fetch`: run in the background (they wait on the network or a hook), the
 * answer comes back through the `git` job as a message. Commit takes what is staged. */
Result<bool, str> write_command(MED_ext.Ctx context, str word, str rest) {
    str directory = MEDX_git_hunk.directory_of(context.file);
    if (word == "commit") {
        if (rest.trim().size() == 0) {
            return done(context, "Git commit: a message is needed (:Git commit MESSAGE)");
        }
        context.background("git", ["sh", "-c", "git -C \"$1\" commit -m \"$2\" 2>&1; echo m3-exit:$?", "sh", directory, rest.trim()]);
        return done(context, "Committing...");
    }
    context.background("git", ["sh", "-c", "git -C \"$1\" " + word + " 2>&1; echo m3-exit:$?", "sh", directory]);
    return done(context, "Git " + word + "...");
}

/// The end of a background git job: the last line of its output, or "ok".
Result<bool, str> job_ended(MED_ext.Ctx context, str job, List<str> lines) {
    str verdict = "";
    str last = "";
    for (str line in lines) {
        if (line.starts_with("m3-exit:")) {
            verdict = line.substr(8, line.size());
        } else if (line.trim().size() > 0) {
            last = line.trim();
        }
    }
    if (verdict == "0") {
        if (last.size() == 0) {
            last = "done";
        }
        return done(context, "Git: " + last);
    }
    return done(context, "Git failed: " + last);
}

Result<bool, str> git_command(State state, MED_ext.Ctx context, str arguments) {
    str lead = arguments.trim();
    int space = lead.index_of(" ").or(lead.size());
    str first = lead.substr(0, space);
    if (first == "commit" || first == "pull" || first == "push" || first == "fetch") {
        return write_command(context, first, lead.substr(space, lead.size()));
    }
    MEDX_git_cmd.Out out = MEDX_git_cmd.run(shell_of(context), arguments, context.file, buffer_lines(context), context.cursor().row);
    if (out.error.size() > 0) {
        return done(context, out.error);
    }
    if (!out.is_list) {
        context.open_scratch(out.title, out.lines);
        return Result<bool, str>.Ok(true);
    }
    context.pick_list(out.title, out.entries, out.selected_line);
    return Result<bool, str>.Ok(true);
}

/// `:Git line`: who last changed the cursor's line.
Result<bool, str> blame_line(MED_ext.Ctx context) {
    str file = context.file;
    if (file.size() == 0) {
        return done(context, "No file");
    }
    MEDX_git_lib.Shell shell = shell_of(context);
    int row = context.cursor().row;
    // in process first (m31git); `git blame` when the library cannot answer
    match (MEDX_git_hunk.blame_row(file, buffer_lines(context), row)) {
        case Some(str said): {
            return done(context, said);
        }
        case None: {
        }
    }
    int line = row + 1;
    match (MEDX_git_lib.shell_output(shell, ["git", "-C", MEDX_git_hunk.directory_of(file), "blame", "-L", line.to_str() + "," + line.to_str(), "--date=relative", "--", MEDX_git_hunk.name_of(file)], ".", "")) {
        case Some(str text): {
            return done(context, text.trim());
        }
        case None: {
            return done(context, "Not committed yet");
        }
    }
}

// ------------------------------------------------------------------ :Hunk

/// Replace `count` rows from `first` with `lines` as one change.
void replace_rows(MED_ext.Ctx context, int first, int count, List<str> lines) {
    int total = context.line_count();
    str text = lines.join("\n");
    if (count > 0 && lines.size() > 0) {
        int last = first + count - 1;
        context.did_replace(MED_buffer.Pos(first, 0), MED_buffer.Pos(last, context.line(last).size()), text);
    } else if (count == 0) {
        if (first >= total) {
            int end_row = total - 1;
            context.did_replace(MED_buffer.Pos(end_row, context.line(end_row).size()), MED_buffer.Pos(end_row, context.line(end_row).size()), "\n" + text);
        } else {
            context.did_replace(MED_buffer.Pos(first, 0), MED_buffer.Pos(first, 0), text + "\n");
        }
    } else {
        // delete the rows
        int last = first + count - 1;
        if (last + 1 < total) {
            context.did_replace(MED_buffer.Pos(first, 0), MED_buffer.Pos(last + 1, 0), "");
        } else if (first > 0) {
            context.did_replace(MED_buffer.Pos(first - 1, context.line(first - 1).size()), MED_buffer.Pos(last, context.line(last).size()), "");
        } else {
            context.did_replace(MED_buffer.Pos(0, 0), MED_buffer.Pos(last, context.line(last).size()), "");
        }
    }
}

/// `:Hunk next` and `:Hunk prev`: the start of the next or previous change against the index (wrapping).
Result<bool, str> go_hunk(State state, MED_ext.Ctx context, bool is_forward) {
    FileInfo info = refresh(state, context, false);
    MED_buffer.Pos here = context.cursor();
    int target = -1;
    if (info.has_base) {
        target = MEDX_git_hunk.next_start(info.hunks, here.row, is_forward);
    }
    if (target < 0) {
        return done(context, "No hunk");
    }
    context.set_jump_mark();
    int column = 0;
    str line = context.line(target);
    while (column < line.size() && (line.byte_at(column) == 32 || line.byte_at(column) == 9)) {
        column = column + 1;
    }
    context.set_cursor(MED_buffer.Pos(target, column));
    return Result<bool, str>.Ok(true);
}

/** Stage hunk `index` of `info` (the buffer against the index): in process first (m31git), `git apply` when the library cannot.
 * "" when staged, else why not. */
str stage_one(MED_ext.Ctx context, str file, FileInfo info, int index, List<str> lines) {
    str said = MEDX_git_hunk.stage_hunk(file, info.hunks, index, lines);
    if (said != "!") {
        return said;
    }
    MEDX_git_lib.Shell shell = shell_of(context);
    str directory = MEDX_git_hunk.directory_of(file);
    str prefix = MEDX_git_lib.shell_output(shell, ["git", "-C", directory, "rev-parse", "--show-prefix"], ".", "").or("").trim();
    str relative = prefix + MEDX_git_hunk.name_of(file);
    str patch = MEDX_git_hunk.hunk_patch(info.hunks, index, info.base, lines, relative);
    MED_ext.Ran ran = context.run_in(["git", "-C", directory, "apply", "--cached", "--unidiff-zero", "-"], directory, patch, 1000);
    if (ran.code == 0) {
        return "";
    }
    return first_line_of(ran.errors);
}

/// The hunks (ascending indexes) that touch rows `first` to `last`; a removed hunk sits on the row above its gap.
List<int> hunks_in(FileInfo info, int first, int last) {
    List<int> picked = [];
    for (int index in 0 .. info.hunks.starts.size()) {
        int low = info.hunks.froms[index];
        int high = info.hunks.froms[index] + info.hunks.counts[index] - 1;
        if (info.hunks.counts[index] == 0) {
            low = info.hunks.starts[index];
            high = info.hunks.starts[index];
        }
        if (high >= first && low <= last) {
            picked.push(index);
        }
    }
    return picked;
}

/** `gh{motion}` and `gH{motion}`: stage or reset every hunk the motion covered. The last hunk goes first, so the rows
 * and base lines of the others stay where the diff said they were. */
Result<bool, str> range_command(State state, MED_ext.Ctx context, FileInfo info, bool is_stage) {
    List<int> rows = context.operator_range();
    List<int> picked = hunks_in(info, rows[0], rows[1]);
    if (picked.size() == 0) {
        return done(context, "No hunk in the range");
    }
    List<str> lines = buffer_lines(context);
    int count = 0;
    int walk = picked.size() - 1;
    while (walk >= 0) {
        int index = picked[walk];
        walk = walk - 1;
        if (is_stage) {
            str said = stage_one(context, context.file, info, index, lines);
            if (said != "") {
                refresh(state, context, true);
                return done(context, "Stage failed: " + said);
            }
        } else {
            List<str> old = [];
            for (int offset in 0 .. info.hunks.base_counts[index]) {
                old.push(info.base[info.hunks.base_froms[index] + offset]);
            }
            replace_rows(context, info.hunks.froms[index], info.hunks.counts[index], old);
        }
        count = count + 1;
    }
    refresh(state, context, is_stage);
    str noun = " hunk";
    if (count != 1) {
        noun = " hunks";
    }
    if (is_stage) {
        return done(context, count.to_str() + noun + " staged");
    }
    return done(context, count.to_str() + noun + " reset");
}

/// `:Hunk stage-buffer`: the whole buffer into the index. `:Hunk reset-buffer`: the buffer text back to the index's.
Result<bool, str> buffer_command(State state, MED_ext.Ctx context, FileInfo info, bool is_stage) {
    if (!is_stage) {
        replace_rows(context, 0, context.line_count(), info.base);
        refresh(state, context, false);
        return done(context, "Buffer reset");
    }
    str directory = MEDX_git_hunk.directory_of(context.file);
    match (MEDX_git_lib.open(directory)) {
        case Some(MEDX_git_lib.Repo repo): {
            str relative = MEDX_git_lib.relative_to(repo, directory, MEDX_git_hunk.name_of(context.file));
            str said = MEDX_git_lib.stage_content(repo, relative, (context.text() + "\n").to_bytes());
            refresh(state, context, true);
            if (said == "") {
                return done(context, "Buffer staged");
            }
            return done(context, "Stage failed: " + said);
        }
        case None: {
            return done(context, "Not a git repository");
        }
    }
}

/// `:Hunk stage|reset|undo|preview|first|last|next|prev` and the range and buffer forms behind `gh` `gH` `hS` `hR`.
Result<bool, str> hunk_command(State state, MED_ext.Ctx context, str arguments) {
    str word = arguments.trim();
    if (word == "next" || word == "prev") {
        return go_hunk(state, context, word == "next");
    }
    if (word == "first" || word == "last") {
        return go_end_hunk(state, context, word == "first");
    }
    if (word.starts_with("preview-or ")) {
        // the nvim profile's `hp`: the hunk preview in a tracked buffer, else the command after `preview-or`
        FileInfo known = refresh(state, context, false);
        if (!known.has_base) {
            context.did_run_ex(word.substr(11, word.size()));
            return Result<bool, str>.Ok(true);
        }
        return hunk_command(state, context, "preview");
    }
    if (word != "stage" && word != "reset" && word != "undo" && word != "unstage" && word != "preview" && word != "range-stage" && word != "range-reset" && word != "stage-buffer" && word != "reset-buffer") {
        return done(context, "Hunk: stage, reset, undo, preview, first, last, next or prev");
    }
    str file = context.file;
    if (file.size() == 0) {
        return done(context, "No file");
    }
    FileInfo info = refresh(state, context, false);
    if (!info.has_base) {
        return done(context, "This file is not tracked by git");
    }
    if (word == "range-stage" || word == "range-reset") {
        return range_command(state, context, info, word == "range-stage");
    }
    if (word == "stage-buffer" || word == "reset-buffer") {
        return buffer_command(state, context, info, word == "stage-buffer");
    }
    int row = context.cursor().row;
    if (word == "undo" || word == "unstage") {
        str said = MEDX_git_hunk.unstage_hunk_at(file, info.hunks, row);
        if (said == "") {
            refresh(state, context, true);
            return done(context, "Hunk unstaged");
        }
        if (said == "!") {
            return done(context, "Cannot unstage in process here; use git restore --staged -p");
        }
        return done(context, said);
    }
    int index = MEDX_git_hunk.hunk_at(info.hunks, row);
    if (index < 0) {
        return done(context, "No hunk at the cursor");
    }
    if (word == "preview") {
        context.show_text(MEDX_git_hunk.hunk_preview(info.hunks, index, info.base, buffer_lines(context)));
        return Result<bool, str>.Ok(true);
    }
    if (word == "reset") {
        List<str> old = [];
        for (int offset in 0 .. info.hunks.base_counts[index]) {
            old.push(info.base[info.hunks.base_froms[index] + offset]);
        }
        replace_rows(context, info.hunks.froms[index], info.hunks.counts[index], old);
        return done(context, "Hunk reset");
    }
    str said = stage_one(context, file, info, index, buffer_lines(context));
    if (said == "") {
        refresh(state, context, true);
        return done(context, "Hunk staged");
    }
    return done(context, "Stage failed: " + said);
}

/// `:Hunk first` and `:Hunk last`: the first or last change in the file.
Result<bool, str> go_end_hunk(State state, MED_ext.Ctx context, bool is_first) {
    FileInfo info = refresh(state, context, false);
    if (!info.has_base || info.hunks.starts.size() == 0) {
        return done(context, "No hunk");
    }
    int target = info.hunks.starts[0];
    if (!is_first) {
        target = info.hunks.starts[info.hunks.starts.size() - 1];
    }
    context.set_jump_mark();
    int column = 0;
    str line = context.line(target);
    while (column < line.size() && (line.byte_at(column) == 32 || line.byte_at(column) == 9)) {
        column = column + 1;
    }
    context.set_cursor(MED_buffer.Pos(target, column));
    return Result<bool, str>.Ok(true);
}

str first_line_of(str text) {
    List<str> parts = text.split("\n");
    return parts[0];
}

/// `:GitSigns`: switch the signs on or off for this session.
Result<bool, str> signs_command(State state, MED_ext.Ctx context) {
    context.did_run_ex("set gitsigns!");
    refresh(state, context, false);
    return Result<bool, str>.Ok(true);
}

// ------------------------------------------------------------------ the commit preview

type CommitPreview {
}

List<str> CommitPreview.lines(MED_ext.Ctx context, str detail) {
    return MEDX_git_hunk.show_lines(shell_of(context), context.project_root(), detail);
}

// ------------------------------------------------------------------ registration

type Git {
    State state = State();
}

Result<bool, str> Git.activate(MED_ext.Registry api) {
    State kept = state;
    api.did_hook(MED_ext.Event.BufferOpen, (MED_ext.Ctx context, MED_ext.Info info) => opened(kept, context, info));
    api.did_hook(MED_ext.Event.Tick, (MED_ext.Ctx context, MED_ext.Info info) => ticked(kept, context, info));
    api.did_command("Git", "log, show, diff, blame or line of the git repository", (MED_ext.Ctx context, str arguments, bool is_bang) => git_command_or_line(kept, context, arguments));
    api.did_command("Hunk", "stage, reset, undo, preview, next or prev hunk", (MED_ext.Ctx context, str arguments, bool is_bang) => hunk_command(kept, context, arguments));
    api.did_command("SignsGit", "switch the git signs on or off", (MED_ext.Ctx context, str arguments, bool is_bang) => signs_command(kept, context));
    api.did_preview("commit", CommitPreview());
    api.did_job("git", (MED_ext.Ctx context, str job, List<str> lines) => job_ended(context, job, lines));
    return Result<bool, str>.Ok(true);
}

Result<bool, str> git_command_or_line(State state, MED_ext.Ctx context, str arguments) {
    if (arguments.trim() == "line") {
        return blame_line(context);
    }
    return git_command(state, context, arguments);
}

pub void register(MED_ext.Registry api) {
    MED_ext.Spec spec = MED_ext.Spec("git", summary: "gutter signs, hunk keys, :Git log show diff blame");
    // nvim and legacy: the keys of 0.21.0 (his gitsigns maps are in `:Profile nvim`)
    key(spec, "<Space>gs", "Hunk stage", "Stage hunk", "nvim legacy");
    key(spec, "<Space>gr", "Hunk reset", "Reset hunk", "nvim legacy");
    key(spec, "<Space>gp", "Hunk preview", "Preview hunk", "nvim legacy");
    key(spec, "<Space>gu", "Hunk undo", "Unstage hunk", "nvim legacy");
    key(spec, "<Space>gl", "Git log %", "Git log of this file", "nvim legacy");
    key(spec, "<Space>gd", "Git diff", "Git diff (working tree)", "nvim legacy");
    key(spec, "<Space>gm", "Git blame", "Git blame list", "nvim legacy");
    key(spec, "<Space>gB", "Git line", "Blame line", "nvim legacy");
    key(spec, "<Space>gt", "SignsGit", "Toggle git signs", "nvim legacy");
    // default: the group of docs/KEYMAP-REVIEW.md 3.1 and 13.2 (hunks under `gh`, toggles under `u`)
    spec.groups.push(MED_ext.GroupSpec("<Space>gh", "hunks"));
    key(spec, "<Space>ghs", "Hunk stage", "Stage hunk", "default");
    key(spec, "<Space>ghr", "Hunk reset", "Reset hunk", "default");
    key(spec, "<Space>ghp", "Hunk preview", "Preview hunk", "default");
    key(spec, "<Space>ghu", "Hunk undo", "Unstage hunk", "default");
    key(spec, "<Space>ghb", "Git line", "Blame line", "default");
    key(spec, "<Space>ghB", "Git blame", "Git blame list (buffer)", "default");
    key(spec, "<Space>gL", "Git log %", "Log of this file", "default");
    key(spec, "<Space>gd", "Git diff", "Diff, working tree", "default");
    key(spec, "<Space>uG", "SignsGit", "Toggle git signs", "default");
    typed(spec, "<Space>gc", ":Git commit ", "Commit (type the message)", "default");
    key(spec, "<Space>gp", "Git pull", "Pull", "default");
    key(spec, "<Space>gP", "Git push", "Push", "default");
    api.did_plugin(spec, Git());
}

void typed(MED_ext.Spec spec, str keys, str text, str desc, str profiles) {
    spec.maps.push(MED_ext.MapSpec(MED_ext.MapMode.Normal, keys, MED_ext.Action.Keys(text), desc: desc, profiles: profiles));
}

void key(MED_ext.Spec spec, str keys, str command, str desc, str profiles) {
    spec.maps.push(MED_ext.map_in(MED_ext.MapMode.Normal, keys, command, desc, profiles));
}
