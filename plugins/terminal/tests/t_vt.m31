// Unit checks for MED_vt, the terminal pane's screen model.

import tests.MED_check;
import plugins.terminal.MEDX_terminal_vt;

MED_check.Check check = MED_check.Check();
MEDX_terminal_vt.Screen screen = MEDX_terminal_vt.Screen();
screen.feed("hello\r\nworld");
check.eq_int("two lines", screen.lines.size(), 2);
check.eq_str("first", screen.lines[0], "hello");
check.eq_str("second", screen.lines[1], "world");
screen.feed("\rWO");
check.eq_str("carriage return overwrites", screen.lines[1], "WOrld");
screen.feed("\x08\x08xx");
check.eq_str("backspace moves left", screen.lines[1], "xxrld");
screen.feed("\x1b[1;31mred\x1b[0m");
check.eq_str("colour is dropped", screen.lines[1], "xxred");
screen.feed("\r\x1b[K");
check.eq_str("erase to end of line", screen.lines[1], "");
screen.feed("a\tb");
check.eq_str("tab pads to 8", screen.lines[1], "a       b");
screen.feed("\x1b]0;title\x07ok");
check.eq_str("osc is dropped", screen.lines[1], "a       bok");
screen.feed("\x1b[2J");
check.eq_int("clear", screen.lines.size(), 1);
check.eq_str("cleared line", screen.lines[0], "");
screen.feed("caf\u{e9} \u{4e16}");
check.eq_str("utf-8", screen.lines[0], "caf\u{e9} \u{4e16}");
screen.feed("\r\x1b[3C!");
check.eq_str("cursor right overwrites", screen.lines[0], "caf! \u{4e16}");
MEDX_terminal_vt.Screen long_screen = MEDX_terminal_vt.Screen();
for (int index in 0 .. 6000) {
    long_screen.feed("line\r\n");
}
check.ok("scrollback is capped", long_screen.lines.size() <= 5001);
check.finish("t_vt");
