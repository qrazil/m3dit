/* The `session` plugin: m3 remembers where you were. The cursor position of each file (put back when the file is opened),
 * the list of recent files (`<Space>fr`, the finder's `recent` source reads it) and the visits the finder's frecency
 * ordering uses. It was `App.note_state`, `remember_position`, `restore_position` and a 1 s timer in the core; now it is a
 * `BufferOpen` handler (restore), a `Tick` handler (note the file in front and its cursor row), and `BufferClose` and
 * `Shutdown` handlers (write the position down). The state files are the ones the core wrote (`recent`, `positions` in
 * `$XDG_STATE_HOME/m3`), so nothing is lost on upgrade. `:Session` (named sessions of buffers and layout) stays in the core. */

import engine.MED_buffer;
import ext.MED_ext;
import fs;

const int RECENT_LIMIT = 200;
const int POSITION_LIMIT = 200;

/// What the Tick handler remembers: the file and row it last noted, so that it writes only when one changed.
type Noted {
    str raw = "";
    str file = "";
    int row = -1;
}

/// `list` with `item` first and without its earlier copy, at most `limit` long.
List<str> mru_add(List<str> list, str item, int limit) {
    List<str> out = [item];
    for (str one in list) {
        if (one != item && out.size() < limit) {
            out.push(one);
        }
    }
    return out;
}

/// Row and column of `path` in a positions list ("PATH\tROW\tCOL" lines), or row -1.
List<int> position_of(List<str> positions, str path) {
    for (str line in positions) {
        List<str> parts = line.split("\t");
        if (parts.size() == 3 && parts[0] == path) {
            return [parts[1].parse_int().or(0), parts[2].parse_int().or(0)];
        }
    }
    return [-1, 0];
}

/// `positions` with `path` at `row`, `col` first.
List<str> position_set(List<str> positions, str path, int row, int col) {
    List<str> out = [path + "\t" + row.to_str() + "\t" + col.to_str()];
    for (str line in positions) {
        List<str> parts = line.split("\t");
        if (parts.size() == 3 && parts[0] != path && out.size() < POSITION_LIMIT) {
            out.push(line);
        }
    }
    return out;
}

/// The absolute path of this context's file when it is a file on disk, else "".
str real_file(MED_ext.Ctx context) {
    str file = context.absolute_path();
    if (file.size() == 0 || !fs.is_file(file)) {
        return "";
    }
    return file;
}

void remember(MED_ext.Ctx context, str file) {
    List<str> positions = context.global_state_lines("positions");
    context.did_set_global_state_lines("positions", position_set(positions, file, context.cursor().row, context.cursor().col));
}

/// Put the cursor where the file was left, unless something (a restored `:Session`) already moved it.
Result<bool, str> restore(MED_ext.Ctx context, MED_ext.Info info) {
    if (!context.has_state()) {
        return Result<bool, str>.Ok(true);
    }
    str file = real_file(context);
    if (file.size() == 0 || context.cursor().row != 0 || context.cursor().col != 0) {
        return Result<bool, str>.Ok(true);
    }
    List<int> spot = position_of(context.global_state_lines("positions"), file);
    if (spot[0] > 0 && spot[0] < context.line_count()) {
        context.set_cursor(MED_buffer.Pos(spot[0], spot[1]));
    }
    return Result<bool, str>.Ok(true);
}

/// The file in front counts as recent and visited once; its cursor row is written when it changes.
Result<bool, str> note(Noted noted, MED_ext.Ctx context, MED_ext.Info info) {
    if (!context.has_state() || context.file.size() == 0) {
        return Result<bool, str>.Ok(true);
    }
    if (context.file != noted.raw) {
        noted.raw = context.file;
        noted.file = real_file(context);
        noted.row = -1;
        if (noted.file.size() > 0) {
            context.did_set_global_state_lines("recent", mru_add(context.global_state_lines("recent"), noted.file, RECENT_LIMIT));
            context.note_visit(noted.file);
        }
    }
    if (noted.file.size() > 0 && context.cursor().row != noted.row) {
        noted.row = context.cursor().row;
        remember(context, noted.file);
    }
    return Result<bool, str>.Ok(true);
}

/// A buffer is closed, or the editor quits: write the cursor down.
Result<bool, str> leave(Noted noted, MED_ext.Ctx context, MED_ext.Info info) {
    if (!context.has_state()) {
        return Result<bool, str>.Ok(true);
    }
    str file = real_file(context);
    if (file.size() > 0) {
        remember(context, file);
        if (info.file == noted.raw) {
            noted.row = context.cursor().row;
        }
    }
    return Result<bool, str>.Ok(true);
}

type Session {
    Noted noted;
}

Result<bool, str> Session.activate(MED_ext.Registry api) {
    Noted state = noted;
    api.did_hook(MED_ext.Event.BufferOpen, (MED_ext.Ctx context, MED_ext.Info info) => restore(context, info));
    api.did_hook(MED_ext.Event.Tick, (MED_ext.Ctx context, MED_ext.Info info) => note(state, context, info));
    api.did_hook(MED_ext.Event.BufferClose, (MED_ext.Ctx context, MED_ext.Info info) => leave(state, context, info));
    api.did_hook(MED_ext.Event.Shutdown, (MED_ext.Ctx context, MED_ext.Info info) => leave(state, context, info));
    return Result<bool, str>.Ok(true);
}

pub void register(MED_ext.Registry api) {
    MED_ext.Spec spec = MED_ext.Spec("session", summary: "remember the cursor position of each file");
    api.did_plugin(spec, Session(Noted()));
}
