// The plugins and extensions built into this m3 (generated by scripts/plugins.sh gen; do not edit).
//
// scripts/build.sh resolves the profile (plugins/profiles/default.txt), --plugins, --without and --ext into
// this list, in dependency order (`requires` and `wants` first), and compiles m3 against a copy of this file.
// The checked-in version is the default profile, so a bare `m31c m3.m31` equals the release; tests/test_plugins.sh
// checks that it equals the generator. docs/CORE-AND-PLUGINS.md 5.2, docs/EXTENSIONS.md.

import ext.MED_ext;
import plugins.move.MEDX_move;

pub void install(MED_ext.Registry api) {
    MEDX_move.register(api);
}
