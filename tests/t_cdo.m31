/* :ldo, :lfdo and :bufdo through the App: an ex line at each quickfix entry, once for each file, in each buffer, and the
 * first failing line ends the run. */

import io;
import os;
import tests.MED_check;
import ui.MED_app;
import ui.MED_picker;
import term;

term.Event press(int code_point) {
    return term.Event.Key(term.Key(term.Code.Char(code_point), 0));
}

void type_text(MED_app.App app, str text) {
    for (int index in 0 .. text.size()) {
        if (text.byte_at(index) == 13) {
            app.handle(term.Event.Key(term.Key(term.Code.Enter, 0)));
        } else {
            app.handle(press(text.byte_at(index)));
        }
    }
}

void write_file(str path, str text) {
    match (io.write(path, text)) {
        case Ok(int count): {
        }
        case Err(io.Error error): {
        }
    }
}

MED_check.Check check = MED_check.Check();
str base = os.env("M3_TEST_TMP").or("/tmp") + "/cdo";
write_file(base + "-a.txt", "foo one\nbar\nfoo two\n");
write_file(base + "-b.txt", "foo three\nfoo foo\n");
match (MED_app.open(base + "-a.txt")) {
    case Ok(MED_app.App app): {
        type_text(app, ":e " + base + "-b.txt\r");
        app.lists.replace("", [MED_picker.Entry("a1", path: base + "-a.txt", line: 0, column: 0), MED_picker.Entry("a3", path: base + "-a.txt", line: 2, column: 0), MED_picker.Entry("b1", path: base + "-b.txt", line: 0, column: 0)]);
        type_text(app, ":ldo s/foo/bar/\r");
        check.eq_str("the last file was changed on its entry's line only", app.editor.buffer.dump(), "bar three\nfoo foo\n");
        type_text(app, ":buffer 1\r");
        check.eq_str("the first file at both entries", app.editor.buffer.dump(), "bar one\nbar\nbar two\n");
        type_text(app, ":lfdo %s/bar/BAR/\r");
        check.eq_str(":lfdo ends in the last file", app.editor.buffer.dump(), "BAR three\nfoo foo\n");
        type_text(app, ":buffer 1\r");
        check.eq_str("and changed the first file once", app.editor.buffer.dump(), "BAR one\nBAR\nBAR two\n");
        type_text(app, ":buffer 2\r");
        type_text(app, ":bufdo %s/foo/F/ge\r");
        check.eq_str(":bufdo ran in the second buffer", app.editor.buffer.dump(), "BAR three\nF F\n");
        type_text(app, ":buffer 1\r");
        check.eq_str("and the first", app.editor.buffer.dump(), "BAR one\nBAR\nBAR two\n");
        type_text(app, ":bufdo %s/zzz/y/\r");
        check.ok("the first failing line ends it (E486)", app.editor.message.starts_with("E486") || app.notice.starts_with("E486"));
        type_text(app, ":ldo\r");
        check.ok("no command is an error", app.notice.starts_with("E471") || app.editor.message.starts_with("E471"));
        app.lists.wipe("");
        type_text(app, ":ldo s/a/b/\r");
        check.ok("an empty list is E42", app.notice.starts_with("E42") || app.editor.message.starts_with("E42"));
    }
    case Err(str message): {
        print("cannot open: " + message);
    }
}
check.finish("t_cdo");
