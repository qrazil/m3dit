// The vi additions through the App: the argument list (:args :next :prev :first :last :argdo :windo), tags and :grep.

import io;
import os;
import tests.MED_check;
import ui.MED_app;
import engine.MED_editor;
import ui.MED_picker;
import term;

term.Event press(int code_point) {
    return term.Event.Key(term.Key(term.Code.Char(code_point), 0));
}

void type_text(MED_app.App app, str text) {
    for (int index in 0 .. text.size()) {
        if (text.byte_at(index) == 13) {
            app.handle(term.Event.Key(term.Key(term.Code.Enter, 0)));
        } else {
            app.handle(press(text.byte_at(index)));
        }
    }
}

void write_file(str path, str text) {
    match (io.write(path, text)) {
        case Ok(int count): {
        }
        case Err(io.Error error): {
        }
    }
}

MED_check.Check check = MED_check.Check();
str base = os.env("M3_TEST_TMP").or("/tmp") + "/vi";
write_file(base + "-a.txt", "foo one\n");
write_file(base + "-b.txt", "foo two\n");
write_file(base + "-c.txt", "foo three\n");
match (MED_app.open_all([base + "-a.txt", base + "-b.txt", base + "-c.txt"])) {
    case Ok(MED_app.App app): {
        check.eq_str("the command line files are the argument list", app.arguments_text(), "[" + base + "-a.txt] " + base + "-b.txt " + base + "-c.txt");
        type_text(app, ":next\r");
        check.eq_str(":next goes to the second", app.editor.buffer.dump(), "foo two\n");
        type_text(app, ":next\r");
        check.eq_str(":next again", app.editor.buffer.dump(), "foo three\n");
        type_text(app, ":last\r");
        check.ok(":last is refused and says what to write", app.editor.message.contains(":args"));
        type_text(app, ":next\r");
        check.ok("past the last file is E165", app.notice.starts_with("E165") || app.editor.message.starts_with("E165"));
        type_text(app, ":prev\r");
        check.eq_str(":prev", app.editor.buffer.dump(), "foo two\n");
        type_text(app, ":prev\r");
        check.eq_str(":prev again", app.editor.buffer.dump(), "foo one\n");
        type_text(app, ":Next\r");
        check.ok("before the first file is E164", app.notice.starts_with("E164") || app.editor.message.starts_with("E164"));
        type_text(app, ":argdo s/foo/bar/ | update\r");
        check.eq_str(":argdo ran in the last file", app.editor.buffer.dump(), "bar three\n");
        type_text(app, ":prev\r:prev\r");
        check.eq_str(":argdo ran in the first file", app.editor.buffer.dump(), "bar one\n");
        type_text(app, ":args " + base + "-b.txt " + base + "-c.txt\r");
        check.eq_str(":args FILES edits the first", app.editor.buffer.dump(), "bar two\n");
        check.eq_str("and sets the list", app.arguments_text(), "[" + base + "-b.txt] " + base + "-c.txt");
        type_text(app, ":split\r");
        type_text(app, ":windo s/bar/WIN/\r");
        check.eq_str(":windo ran in a window", app.editor.buffer.dump(), "WIN two\n");
    }
    case Err(str message): {
        print("cannot open: " + message);
    }
}
// tags: a tags file next to the files, found through :set tags=
write_file(base + "-src.c", "int helper(void)\n{\n}\n\nint main(void)\n{\n    return helper();\n}\n");
write_file(base + "-tags", "!_TAG_FILE_FORMAT\t2\nhelper\t" + base + "-src.c\t/^int helper(void)$/;\"\tf\nmain\t" + base + "-src.c\t5;\"\tf\n");
match (MED_app.open_all([base + "-a.txt"])) {
    case Ok(MED_app.App app): {
        type_text(app, ":set tags=" + base + "-tags\r");
        type_text(app, ":tag main\r");
        check.eq_int(":tag with a line number address", app.editor.row, 4);
        check.eq_int("the tag stack has the place left", app.tag_stack.size(), 1);
        type_text(app, "jjj");
        type_text(app, ":tag helper\r");
        check.eq_int(":tag with a search address", app.editor.row, 0);
        type_text(app, ":pop\r");
        check.eq_int(":pop returns to the line left", app.editor.row, 7);
        app.editor.row = 6;
        app.editor.col = 12;
        type_text(app, "\x1d");
        check.eq_int("CTRL-] jumps to the word under the cursor", app.editor.row, 0);
        type_text(app, "\x14");
        check.eq_int("CTRL-T returns", app.editor.row, 6);
        type_text(app, ":tag nosuch\r");
        check.ok("an unknown tag is E426", app.notice.starts_with("E426") || app.editor.message.starts_with("E426"));
        type_text(app, ":pop\r");
        type_text(app, ":pop\r");
        check.ok("an empty stack is E73", app.notice.starts_with("E73") || app.editor.message.starts_with("E73"));
    }
    case Err(str message): {
        print("cannot open: " + message);
    }
}
// :grep and :vimgrep fill the quickfix list; :make runs makeprg and reads file:line: text
match (MED_app.open_all([base + "-a.txt"])) {
    case Ok(MED_app.App app): {
        app.root = os.env("M3_TEST_TMP").or("/tmp");
        type_text(app, ":vimgrep /three/ " + base + "-c.txt " + base + "-b.txt\r");
        check.eq_int(":vimgrep found one entry", app.lists.size(""), 1);
        check.eq_int("at line 0", app.lists.items("")[0].line, 0);
        type_text(app, ":set makeprg=printf\\ 'x.c:3:7:\\ boom\\\\nnoise\\\\ny.c:9:\\ bad\\\\n'\r");
        type_text(app, ":make!\r");
        check.eq_int(":make parsed two places", app.lists.size(""), 2);
        check.eq_str("the first", app.lists.items("")[0].text, "x.c:3: boom");
        check.eq_int("with its column", app.lists.items("")[0].column, 6);
        type_text(app, ":grep zzzz " + base + "-c.txt\r");
        check.eq_int(":grep with no match empties the list", app.lists.size(""), 0);
        type_text(app, ":grep three " + base + "-c.txt\r");
        check.eq_int(":grep finds the line", app.lists.size(""), 1);
        check.eq_str("and went to it", app.editor.buffer.dump(), "foo three\n");
    }
    case Err(str message): {
        print("cannot open: " + message);
    }
}
// Ex mode, :append, :z and the other removed commands are refused with a way forward
match (MED_app.open_all([base + "-a.txt"])) {
    case Ok(MED_app.App app): {
        type_text(app, "gQ");
        check.ok("gQ does not open the command line", app.editor.mode == MED_editor.NORMAL);
        check.ok("and says so", app.editor.message.contains("Ex mode"));
        type_text(app, ":append\r");
        check.ok(":append is refused", app.editor.message.contains("E492") && app.editor.message.contains("o, O or cc"));
        type_text(app, ":3z\r");
        check.ok(":z is refused", app.editor.message.contains("E492") && app.editor.message.contains("<C-f>"));
        type_text(app, ":visual\r");
        check.ok(":visual is refused", app.editor.message.contains("no Ex mode"));
        type_text(app, ":set swapfile\r");
        check.ok("an option m3 does not read is refused with the reason", app.editor.message.starts_with("E518") && app.editor.message.contains("recovery copy"));
        type_text(app, ":set noshowmode\r");
        check.ok("also in the no form", app.editor.message.starts_with("E518"));
        type_text(app, ":set gdefault\r");
        check.ok("an option that acts is accepted", app.editor.is_option_on("gdefault", false));
        type_text(app, ":s/o/0/\r");
        check.eq_str("'gdefault' makes :s change every match", app.editor.buffer.dump(), "f00 0ne\n");
        type_text(app, ":set showtabline=2\r");
        check.eq_int("'showtabline' 2 always shows the tab line", app.tabline_rows(), 1);
        type_text(app, ":set showtabline=0\r");
        check.eq_int("and 0 never", app.tabline_rows(), 0);
        type_text(app, ":set signcolumn=no\r");
        check.eq_str("'signcolumn' is stored for the renderer", app.editor.opts.get("signcolumn").or(""), "no");
        type_text(app, "g?w");
        check.ok("g? is refused", app.editor.message.contains("E492") && app.editor.message.contains("rot13"));
        type_text(app, "gR");
        check.ok("gR is refused", app.editor.message.contains("Virtual Replace"));
        type_text(app, "ghx");
        check.ok("gh with a third key that is none of ghs ghr ghS ghR ghd ghD ghb ghl is refused", app.editor.message.starts_with("E492") && app.editor.message.contains("ghx"));
        check.eq_int("and the x was not typed as a command", app.editor.mode, MED_editor.NORMAL);
        type_text(app, "gH");
        check.ok("gH is gone and says what to type", app.editor.message.contains("ghr"));
    }
    case Err(str message): {
        print("cannot open: " + message);
    }
}
// surround and autopairs are core features, on by default, each with its switch
write_file(base + "-p.txt", "word\n");
match (MED_app.open_all([base + "-p.txt"])) {
    case Ok(MED_app.App app): {
        type_text(app, "A (\x1b");
        check.eq_str("autopairs closes a bracket by default", app.editor.buffer.dump(), "word ()\n");
        type_text(app, "u");
        check.eq_str("and one undo takes the pair out", app.editor.buffer.dump(), "word\n");
        type_text(app, ":set noautopairs\r");
        type_text(app, "A (\x1b");
        check.eq_str(":set noautopairs types only the bracket", app.editor.buffer.dump(), "word (\n");
        type_text(app, "u");
        type_text(app, "ysiw)");
        check.eq_str("surround wraps a word by default", app.editor.buffer.dump(), "(word)\n");
        type_text(app, "ds)");
        check.eq_str("ds) takes it off", app.editor.buffer.dump(), "word\n");
        type_text(app, "ysiw)");
        type_text(app, ":set nosurround\r");
        type_text(app, "ds)");
        check.eq_str(":set nosurround turns the keys off", app.editor.buffer.dump(), "(word)\n");
    }
    case Err(str message): {
        print("cannot open: " + message);
    }
}
// several tag matches are a list
write_file(base + "-dup.c", "int dup(void)\n{\n}\nint dup2(void)\n{\n}\n");
write_file(base + "-tags2", "dup\t" + base + "-dup.c\t1;\"\tf\ndup\t" + base + "-dup.c\t4;\"\tf\n");
match (MED_app.open_all([base + "-a.txt"])) {
    case Ok(MED_app.App app): {
        type_text(app, ":set tags=" + base + "-tags2\r");
        type_text(app, ":tag dup\r");
        check.eq_int("the first match", app.editor.row, 0);
        check.eq_int("both matches are in the list", app.lists.size(""), 2);
        type_text(app, ":lnext\r");
        check.eq_int(":lnext goes to the second match", app.editor.row, 3);
        type_text(app, ":tnext\r");
        check.ok(":tnext is refused and says to write :lnext", app.editor.message.contains(":lnext"));
    }
    case Err(str message): {
        print("cannot open: " + message);
    }
}
// :Formatter runs a filter over the buffer before :w
write_file(base + "-f.txt", "quiet words\n");
match (MED_app.open_all([base + "-f.txt"])) {
    case Ok(MED_app.App app): {
        type_text(app, ":Formatter txt tr a-z A-Z\r");
        type_text(app, ":w\r");
        check.eq_str("the formatter ran before the write", app.editor.buffer.dump(), "QUIET WORDS\n");
        type_text(app, "u");
        check.eq_str("and is one undo step", app.editor.buffer.dump(), "quiet words\n");
        type_text(app, ":set noformatonsave\r:w\r");
        check.eq_str("noformatonsave turns it off", app.editor.buffer.dump(), "quiet words\n");
    }
    case Err(str message): {
        print("cannot open: " + message);
    }
}
// :Profile nvim: the owner's maps and options
match (MED_app.open_all([base + "-a.txt"])) {
    case Ok(MED_app.App app): {
        type_text(app, ":Profile nvim\r");
        check.eq_str("no error", app.notice, "");
        check.eq_int("tabstop", app.editor.tab, 4);
        check.eq_int("shiftwidth", app.editor.shiftwidth, 4);
        check.eq_str("pumkeys", app.editor.opts.get("pumkeys").or(""), "blink");
        type_text(app, "ofirst\x1bosecond\x1bgg");
        type_text(app, "J");
        check.eq_str("J moves the line down (mini.move), not a join", app.editor.buffer.dump(), "first\nfoo one\nsecond\n");
        type_text(app, ":Profile nosuch\r");
        check.ok("an unknown profile is E474", app.notice.starts_with("E474") || app.editor.message.starts_with("E474"));
    }
    case Err(str message): {
        print("cannot open: " + message);
    }
}
check.finish("t_vi");
