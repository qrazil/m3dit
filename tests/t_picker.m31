/* Unit checks for MED_picker and MED_keymap: the prompt, ranking, selection,
 * toggles and the leader table. */

import tests.MED_check;
import tui.widgets.TUI_menu;
import engine.MED_key;
import ui.MED_keymap;
import ui.MED_picker;
import ui.MED_picker_view;

MED_check.Check check = MED_check.Check();

List<MED_picker.Entry> entries_of(List<str> texts) {
    List<MED_picker.Entry> out = [];
    for (str text in texts) {
        out.push(MED_picker.Entry(text));
    }
    return out;
}

void type_text(MED_picker.Picker picker, str text) {
    for (int code_point in text.chars()) {
        picker.feed(code_point);
    }
}

str current_text(MED_picker.Picker picker) {
    match (picker.current()) {
        case Some(MED_picker.Entry entry): {
            return entry.text;
        }
        case None: {
            return "";
        }
    }
}

MED_picker.Picker picker = MED_picker.make(MED_picker.KIND_FILES, "Files");
picker.set_entries(entries_of(["src/main.m31", "README.md", "src/MED_app.m31", "tests/t_app.m31"]));
check.eq_int("all shown with an empty prompt", picker.count(), 4);
check.eq_str("first is the first entry", current_text(picker), "src/main.m31");
type_text(picker, "app");
check.eq_int("filter keeps the matches", picker.count(), 2);
// both names hold "app" as a run; the shorter name is the closer match
check.eq_str("best match first", current_text(picker), "tests/t_app.m31");
picker.feed(MED_key.DOWN);
check.eq_str("down selects the next", current_text(picker), "src/MED_app.m31");
picker.feed(MED_key.DOWN);
check.eq_str("down stops at the end", current_text(picker), "src/MED_app.m31");
picker.feed(16);
check.eq_str("ctrl-p goes up", current_text(picker), "tests/t_app.m31");
picker.feed(MED_key.BACKSPACE);
check.eq_str("backspace edits the prompt", picker.query, "ap");
picker.feed(21);
check.eq_str("ctrl-u clears", picker.query, "");
check.eq_int("cleared prompt shows all", picker.count(), 4);
type_text(picker, "src main");
picker.feed(23);
check.eq_str("ctrl-w deletes a word", picker.query, "src ");
picker.feed(21);
type_text(picker, "zzzz");
check.eq_int("no match", picker.count(), 0);
check.ok("no current entry", current_text(picker) == "");
check.ok("accept with nothing still reports", picker.feed(MED_key.CARRIAGE_RETURN) == MED_picker.Outcome.Accept);
check.ok("ctrl-s accepts in a split below", picker.feed(19) == MED_picker.Outcome.AcceptSplit);
check.ok("ctrl-v accepts in a split beside", picker.feed(22) == MED_picker.Outcome.AcceptVsplit);
check.ok("esc cancels", picker.feed(MED_key.ESC) == MED_picker.Outcome.Cancel);
check.ok("ctrl-c cancels", picker.feed(3) == MED_picker.Outcome.Cancel);
check.ok("tab toggles ignore and reloads", picker.feed(MED_key.TAB) == MED_picker.Outcome.Reload);
check.ok("ignore is off", !picker.is_ignore_used);
check.ok("ctrl-h toggles hidden", picker.feed(MED_key.CTRL_H) == MED_picker.Outcome.Reload);
check.ok("hidden is on", picker.is_hidden_shown);
picker.feed(21);
picker.set_entries(entries_of(["a", "b", "c"]));
picker.feed(MED_key.END);
check.eq_str("end selects the last", current_text(picker), "c");
picker.feed(MED_key.HOME);
check.eq_str("home selects the first", current_text(picker), "a");
picker.selected = 2;
picker.top = 0;
picker.scroll_to(2);
check.eq_int("scroll keeps the selection visible", picker.top, 1);
MED_picker.Picker grep = MED_picker.make(MED_picker.KIND_GREP, "Grep");
grep.set_entries(entries_of(["x:1: foo", "y:2: bar"]));
check.ok("grep typing asks for a search", grep.feed(102) == MED_picker.Outcome.Requery);
check.eq_int("grep does not filter", grep.count(), 2);
check.ok("ctrl-f toggles fixed", grep.feed(6) == MED_picker.Outcome.Requery);
check.ok("fixed is on", grep.is_fixed);
MED_picker.Picker explore = MED_picker.make(MED_picker.KIND_EXPLORE, "Explore");
check.ok("minus goes up on an empty prompt", explore.feed(45) == MED_picker.Outcome.Up);
explore.feed(97);
check.ok("minus is text otherwise", explore.feed(45) == MED_picker.Outcome.Stay);
check.eq_str("minus typed", explore.query, "a-");
// the leader table
List<MED_keymap.Binding> table = MED_keymap.defaults("legacy");
check.eq_int("f is a prefix", MED_keymap.lookup(table, "f"), MED_keymap.IS_PREFIX);
check.eq_int("ff is a leaf", MED_keymap.lookup(table, "ff"), MED_keymap.IS_LEAF);
check.eq_int("space space is a leaf", MED_keymap.lookup(table, " "), MED_keymap.IS_LEAF);
check.eq_int("zz is nothing", MED_keymap.lookup(table, "zz"), MED_keymap.NO_BINDING);
check.eq_str("leaf action", MED_keymap.leaf(table, "ff").action, "picker:files");
check.eq_str("leaf ex action", MED_keymap.leaf(table, "bn").action, "ex:bnext");
List<TUI_menu.Item> items = MED_keymap.next_items(table, "f");
check.ok("which-key lists the next keys", items.size() >= 4);
check.eq_str("which-key labels a leaf", items[0].label, "Find files");
List<TUI_menu.Item> top_items = MED_keymap.next_items(table, "");
bool is_group_named = false;
for (TUI_menu.Item item in top_items) {
    if (item.key == "f" && item.label == "+find") {
        is_group_named = true;
    }
}
check.ok("which-key names a group", is_group_named);
check.eq_str("entry text with keys last", MED_keymap.entry_text(MED_keymap.leaf(table, "ff"), false), "Find files  (<Space>ff)");
check.eq_str("entry text with keys first", MED_keymap.entry_text(MED_keymap.leaf(table, "ff"), true), "<Space>ff  Find files");
// streaming, marks and the quickfix key
MED_picker.Picker live = MED_picker.make(MED_picker.KIND_LIST, "Live");
live.set_entries([]);
live.append([MED_picker.Entry("alpha.txt"), MED_picker.Entry("beta.txt")]);
check.eq_int("appended entries are shown", live.shown.size(), 2);
live.feed(20);
check.eq_int("ctrl-t marks", live.marked.size(), 1);
check.eq_int("and moves on", live.selected, 1);
live.feed(20);
check.eq_int("two marked", live.marked.size(), 2);
live.selected = 0;
live.feed(20);
check.eq_int("ctrl-t again unmarks", live.marked.size(), 1);
check.eq_int("chosen is the marked one", live.chosen().size(), 1);
check.eq_str("marked entry", live.chosen()[0].text, "beta.txt");
check.ok("ctrl-q asks for the quickfix list", live.feed(17).eq(MED_picker.Outcome.Quickfix));
live.query = "bet";
live.refilter();
live.append([MED_picker.Entry("bet_more.txt")]);
check.ok("a prompt makes the ranking stale", live.is_dirty);
live.refilter();
check.ok("and ranking again fixes it", !live.is_dirty);
check.eq_int("both match", live.shown.size(), 2);
// the finder ranks paths by name first, shows a relevance, and remembers what it matched
MED_picker.Picker finder = MED_picker.make(MED_picker.KIND_FILES, "Files");
finder.set_entries(entries_of(["pxxxxxxoxxxxxxxx_fbdjdk_m", "poxm.txt", "parent/pom.xml", "pom.xml", "README.md"]));
type_text(finder, "pom");
check.eq_str("pom: pom.xml first", current_text(finder), "pom.xml");
check.eq_int("four match", finder.count(), 4);
check.eq_str("then parent/pom.xml", finder.entries[finder.shown[1]].text, "parent/pom.xml");
check.eq_str("then poxm.txt", finder.entries[finder.shown[2]].text, "poxm.txt");
check.eq_str("the scattered one last", finder.entries[finder.shown[3]].text, "pxxxxxxoxxxxxxxx_fbdjdk_m");
check.eq_int("a percentage per row", finder.percents.size(), 4);
check.ok("percentages fall down the list", finder.percents[0] >= finder.percents[1] && finder.percents[1] > finder.percents[2] && finder.percents[2] > finder.percents[3]);
check.ok("the pool holds the matches", finder.has_pool && finder.pool.size() == 4);
finder.feed(MED_key.BACKSPACE);
check.eq_int("shorter prompt: more matches (po)", finder.count(), 4);
type_text(finder, "m");
check.eq_str("typing again gives the same first", current_text(finder), "pom.xml");
check.ok("narrowing starts from the pool", finder.can_narrow("pomx"));
check.ok("but not from a shorter prompt", !finder.can_narrow("po"));
check.ok("nor across a negation", !finder.can_narrow("pom !x"));
check.ok("nor with a suffix anchor", !finder.can_narrow("pom$"));
type_text(finder, "x");
check.eq_int("narrowed: pomx is a subsequence of three", finder.count(), 3);
check.eq_str("narrowed: first", current_text(finder), "pom.xml");
// frecency: with an empty prompt the visited come first, hottest then latest
MED_picker.Picker hot = MED_picker.make(MED_picker.KIND_FILES, "Files");
hot.set_entries(entries_of(["a.txt", "b.txt", "c.txt", "d.txt", "e.txt"]));
hot.set_frecency([0, 3000, 0, 1000, 1000], [0, 100, 0, 50, 70]);
check.eq_str("empty prompt: the hottest first", current_text(hot), "b.txt");
check.eq_str("then the more recent of equals", hot.entries[hot.shown[1]].text, "e.txt");
check.eq_str("then the older", hot.entries[hot.shown[2]].text, "d.txt");
check.eq_str("then the never visited, in source order", hot.entries[hot.shown[3]].text, "a.txt");
check.eq_int("all are listed", hot.count(), 5);
check.ok("the hottest is marked", hot.is_frecent(1));
check.ok("a never visited file is not", !hot.is_frecent(0));
// ... and with a prompt it lifts within a match tier only
hot.set_entries(entries_of(["a/x.txt", "b/x.txt", "x.txt", "xylophone.txt"]));
type_text(hot, "x");
check.eq_str("plain: the shortest basename match", current_text(hot), "x.txt");
hot.set_frecency([0, 3000, 0, 0], [0, 100, 0, 0]);
check.eq_str("a visited file moves up among equals", current_text(hot), "b/x.txt");
check.ok("and shows it in its relevance", hot.percents[0] >= hot.percents[1]);
// typing is ranked once per batch of keys when asked
MED_picker.Picker lazy = MED_picker.make(MED_picker.KIND_FILES, "Files");
lazy.set_entries(entries_of(["alpha.txt", "beta.txt"]));
lazy.is_deferred = true;
type_text(lazy, "bet");
check.eq_int("deferred: not ranked yet", lazy.count(), 2);
lazy.refresh();
check.eq_int("deferred: ranked on refresh", lazy.count(), 1);
type_text(lazy, "a");
lazy.feed(MED_key.DOWN);
check.eq_int("a movement key ranks first", lazy.count(), 1);
// the preview prepares its lines once: tabs to the next stop, long lines cut by columns
check.eq_str("tab to the next stop of 4", MED_picker_view.expand_tabs("a\tb", 4, 100), "a   b");
check.eq_str("a tab at a stop is a whole stop", MED_picker_view.expand_tabs("abcd\te", 4, 100), "abcd    e");
check.eq_str("a wide character moves the stop", MED_picker_view.expand_tabs("\u{4E2D}\tx", 4, 100), "\u{4E2D}  x");
check.eq_str("leading tabs", MED_picker_view.expand_tabs("\t\tx", 4, 100), "        x");
check.eq_str("no tab, no change", MED_picker_view.expand_tabs("plain", 4, 100), "plain");
check.eq_int("a long line is cut at the limit", MED_picker_view.expand_tabs("x".repeat(10000), 4, 50).size(), 50);
check.eq_str("a cut never splits a cluster", MED_picker_view.expand_tabs("e\u{301}".repeat(100), 4, 3), "e\u{301}e\u{301}e\u{301}");
// the hint line
List<str> hints = MED_picker_view.hints_for(finder);
check.eq_str("the hints start with what Enter does", hints[0], "Enter open");
check.eq_str("they all fit when there is room", MED_picker_view.hint_text(["a", "b", "c"], 20), "a  b  c");
check.eq_str("what does not fit is dropped from the end", MED_picker_view.hint_text(["aaa", "bbb", "ccc"], 9), "aaa  bbb");
check.eq_str("nothing fits in nothing", MED_picker_view.hint_text(["aaa"], 2), "");
check.ok("the files hints show the hidden toggle", MED_picker_view.hint_text(hints, 200).contains("^H hidden:off"));
check.ok("and the redraw key", MED_picker_view.hint_text(hints, 200).contains("^L redraw"));
MED_picker.Picker commands = MED_picker.make(MED_picker.KIND_COMMANDS, "Commands");
check.eq_str("the palette is contextual", MED_picker_view.hints_for(commands)[0], "Enter run");
check.ok("and has no hidden toggle", !MED_picker_view.hint_text(MED_picker_view.hints_for(commands), 200).contains("hidden"));
MED_picker.Picker side = MED_picker.make(MED_picker.KIND_LIST, "Themes");
side.is_side = true;
check.eq_int("a side picker has no hints", MED_picker_view.hints_for(side).size(), 0);
// the score column
check.eq_str("a percentage is right aligned", MED_picker_view.pad_left("7%", 4), "  7%");
check.eq_str("a long label is not cut", MED_picker_view.pad_left("100%", 3), "100%");
check.eq_str("the label of the first row", MED_picker_view.score_label(finder, 0), "  " + MED_picker_view.pad_left(finder.percents[0].to_str() + "%", 3));
check.ok("a frecent file is starred", MED_picker_view.score_label(hot, 0).starts_with("*"));
check.ok("a plain one is not", !MED_picker_view.score_label(finder, 0).starts_with("*"));
check.finish("t_picker");
