/* The engine half of the regex oracle (tests/oracles/oracle_regex.py).
 *
 * Usage: t_regex_run CASES_FILE
 *
 * A case line is tab separated: index, hex(pattern), hex(text), flags where
 * flags holds `i` (ignorecase) and `s` (smartcase). The result line is
 * `index  srow  scol  erow  ecol  hex(whole);hex(\1);...;hex(\9)` for the first
 * match in row 0 (byte offsets, `\zs`/`\ze` applied), `index none` for no match and
 * `index err` when the pattern does not compile. nvim_regex.lua prints the same. */

import engine.MED_regex;
import engine.MED_buffer;
import encoding.hexcodec;
import io;
import os;

str hex_of(str text) {
    return hexcodec.encode(text.to_bytes());
}

str unhex(str digits) {
    match (hexcodec.decode(digits)) {
        case Ok(bytes data): {
            match (data.utf8()) {
                case Some(str text): {
                    return text;
                }
                case None: {
                    return "";
                }
            }
        }
        case Err(hexcodec.Error error): {
            return "";
        }
    }
}

str run_case(str line) {
    List<str> flags_value = line.split("\t");
    str pattern = unhex(flags_value[1]);
    str text = unhex(flags_value[2]);
    str flags = "";
    if (flags_value.size() > 3) {
        flags = flags_value[3];
    }
    MED_regex.Regex regex = MED_regex.compile(pattern, flags.index_of("i").is_some(), flags.index_of("s").is_some(), "");
    if (!regex.is_ok) {
        return flags_value[0] + "\terr";
    }
    MED_buffer.Buffer buffer = MED_buffer.load("");
    buffer.lines = text.split("\n");
    MED_regex.Match match_value = regex.search_line(buffer, 0, 0);
    if (!match_value.is_ok) {
        return flags_value[0] + "\tnone";
    }
    List<str> parts = [];
    for (str group_text in match_value.groups) {
        parts.push(hex_of(group_text));
    }
    return flags_value[0] + "\t" + match_value.srow.to_str() + "\t" + match_value.scol.to_str() + "\t" + match_value.erow.to_str() + "\t" + match_value.ecol.to_str() + "\t" + parts.join(";");
}

List<str> arguments = os.arguments();
match (io.read(arguments[1])) {
    case Ok(str content): {
        for (str line in content.split("\n")) {
            if (line.size() > 0) {
                print(run_case(line));
            }
        }
    }
    case Err(io.Error error): {
        print("error reading cases: " + error.to_str());
        os.exit(2);
    }
}
