/* The generic list (docs/LIST.md): the store, then `:l` `:lnext` `:lprev` `:lfirst` `:llast` `:lclear`, their `:List*` long
 * forms and the `:c*` aliases, through the App. */

import io;
import os;
import tests.MED_check;
import ui.MED_app;
import ui.MED_lists;
import ui.MED_picker;
import term;

term.Event press(int code_point) {
    return term.Event.Key(term.Key(term.Code.Char(code_point), 0));
}

void type_text(MED_app.App app, str text) {
    for (int index in 0 .. text.size()) {
        if (text.byte_at(index) == 13) {
            app.handle(term.Event.Key(term.Key(term.Code.Enter, 0)));
        } else {
            app.handle(press(text.byte_at(index)));
        }
    }
}

void write_file(str path, str text) {
    match (io.write(path, text)) {
        case Ok(int count): {
        }
        case Err(io.Error error): {
        }
    }
}

MED_check.Check check = MED_check.Check();
str base = os.env("M3_TEST_TMP").or("/tmp") + "/list";
write_file(base + "-a.txt", "one\ntwo\nthree\nfour\n");
write_file(base + "-b.txt", "uno\ndos\n");
// the store
MED_lists.Store store = MED_lists.Store();
check.eq_int("a list that was never made is empty", store.size("x"), 0);
check.eq_int("and has no current row", store.current("x"), -1);
check.eq_int("stepping an empty list says so", store.step("x", 1), -1);
store.replace("x", [MED_picker.Entry("r1"), MED_picker.Entry("r2"), MED_picker.Entry("r3")]);
check.eq_int("next from nothing is the first", store.step("x", 1), 0);
check.eq_int("next", store.step("x", 1), 1);
check.eq_int("previous", store.step("x", -1), 0);
check.eq_int("previous wraps to the last", store.step("x", -1), 2);
check.eq_int("next wraps to the first", store.step("x", 1), 0);
check.eq_int("last", store.step("x", 2), 2);
check.eq_int("first", store.step("x", 0), 0);
check.eq_int("pick clamps high", store.pick("x", 99), 2);
check.eq_int("and low", store.pick("x", -4), 0);
store.append("x", [MED_picker.Entry("r4")]);
check.eq_int("append adds at the end", store.size("x"), 4);
check.eq_int("and keeps the current row", store.current("x"), 0);
store.replace("x", [MED_picker.Entry("fresh")]);
check.eq_int("replace forgets the current row", store.current("x"), -1);
store.replace("y", [MED_picker.Entry("other")]);
check.eq_int("lists are independent", store.size("x") + store.size("y"), 2);
store.wipe("x");
check.eq_int("wipe", store.size("x"), 0);
check.eq_str("an empty name is the default list", MED_lists.named(" "), "quickfix");
// the commands through the App
match (MED_app.open(base + "-a.txt")) {
    case Ok(MED_app.App app): {
        List<MED_picker.Entry> rows = [MED_picker.Entry("A2", path: base + "-a.txt", line: 1, column: 0), MED_picker.Entry("A4", path: base + "-a.txt", line: 3, column: 1), MED_picker.Entry("B1", path: base + "-b.txt", line: 1, column: 0)];
        app.lists.replace("", rows);
        type_text(app, ":lnext\r");
        check.eq_int(":lnext goes to the first row", app.editor.row, 1);
        check.ok("and says where", app.notice.starts_with("(1 of 3)"));
        type_text(app, ":lnext\r");
        check.eq_int("the second", app.editor.row, 3);
        check.eq_int("with its column", app.editor.col, 1);
        type_text(app, ":lnext\r");
        check.eq_str("the third is in the other file", app.editor.buffer.dump(), "uno\ndos\n");
        type_text(app, ":lnext\r");
        check.eq_int("and it wraps", app.editor.row, 1);
        check.eq_str("back in the first file", app.editor.buffer.dump(), "one\ntwo\nthree\nfour\n");
        type_text(app, ":lprev\r");
        check.ok(":lprev wraps back to the last row", app.notice.starts_with("(3 of 3)"));
        type_text(app, ":lfirst\r");
        check.ok(":lfirst", app.notice.starts_with("(1 of 3)"));
        type_text(app, ":llast\r");
        check.ok(":llast", app.notice.starts_with("(3 of 3)"));
        type_text(app, ":ListFirst\r");
        check.ok(":ListFirst is :lfirst", app.notice.starts_with("(1 of 3)"));
        type_text(app, ":ListNext\r");
        check.ok(":ListNext is :lnext", app.notice.starts_with("(2 of 3)"));
        type_text(app, ":ListPrev\r");
        check.ok(":ListPrev is :lprev", app.notice.starts_with("(1 of 3)"));
        type_text(app, ":ListLast\r");
        check.ok(":ListLast is :llast", app.notice.starts_with("(3 of 3)"));
        type_text(app, ":lnext 2\r");
        check.ok(":lnext N goes to row N", app.notice.starts_with("(2 of 3)") && app.lists.current("") == 1);
        type_text(app, ":lnext\r");
        check.ok(":lnext goes on from there", app.lists.current("") == 2);
        type_text(app, ":cnext\r");
        check.ok(":cnext is refused and says what to write", app.editor.message.contains(":lnext") && app.lists.current("") == 2);
        type_text(app, ":lgrep x\r");
        check.ok(":lgrep is refused and says what to write", app.editor.message.contains(":grep"));
        type_text(app, ":l\r");
        check.ok(":l opens the list", app.has_picker && app.picker.title == "List");
        check.eq_int("with its rows", app.picker.entries.size(), 3);
        type_text(app, "\x1b");
        check.ok("Escape closes it", !app.has_picker);
        type_text(app, ":list\r");
        check.ok(":list opens it too", app.has_picker);
        type_text(app, "\x1b");
        type_text(app, ":List\r");
        check.ok(":List opens it too", app.has_picker);
        type_text(app, "\x1b");
        app.lists.replace("mine", [MED_picker.Entry("M", path: base + "-b.txt", line: 0, column: 0)]);
        type_text(app, ":l mine\r");
        check.ok(":l NAME opens that list", app.has_picker && app.picker.title == "List: mine");
        type_text(app, "\x1b");
        type_text(app, ":lnext mine\r");
        check.eq_str(":lnext NAME walks that list", app.editor.buffer.dump(), "uno\ndos\n");
        type_text(app, ":lclear\r");
        check.eq_int(":lclear empties the default list", app.lists.size(""), 0);
        check.eq_int("and only that one", app.lists.size("mine"), 1);
        type_text(app, ":lnext\r");
        check.ok("an empty list is said, not an error that stops anything", app.notice.contains("empty"));
        type_text(app, ":l\r");
        check.ok("opening an empty list opens nothing", !app.has_picker);
        type_text(app, ":lclear mine\r");
        check.eq_int(":lclear NAME", app.lists.size("mine"), 0);
    }
    case Err(str message): {
        print("cannot open: " + message);
    }
}
check.finish("t_list");
