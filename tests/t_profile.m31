/* Key profiles through the App (docs/KEYMAP-REVIEW.md B1): a profile is a whole key tree. `default` is the sane IDE tree,
 * `legacy` the tree of 0.21.0, `minimal` bare vi (no leader, no plugin keys), `nvim` the owner's keys on the legacy tree;
 * `:Profile NAME` swaps one for another and nothing of the old one stays. */

import io;
import os;
import tests.MED_check;
import ui.MED_app;
import ui.MED_keymap;
import term;

term.Event press(int code_point) {
    return term.Event.Key(term.Key(term.Code.Char(code_point), 0));
}

void type_text(MED_app.App app, str text) {
    for (int index in 0 .. text.size()) {
        if (text.byte_at(index) == 13) {
            app.handle(term.Event.Key(term.Key(term.Code.Enter, 0)));
        } else if (text.byte_at(index) == 27) {
            app.handle(term.Event.Key(term.Key(term.Code.Escape, 0)));
        } else {
            app.handle(press(text.byte_at(index)));
        }
    }
}

void write_file(str path, str text) {
    match (io.write(path, text)) {
        case Ok(int count): {
        }
        case Err(io.Error error): {
        }
    }
}

MED_check.Check check = MED_check.Check();
str base = os.env("M3_TEST_TMP").or("/tmp") + "/profile";
write_file(base + "-a.txt", "one\ntwo\nthree\n");
match (MED_app.open_all([base + "-a.txt"])) {
    case Ok(MED_app.App app): {
        app.ext_install();
        app.ext_started();
        check.eq_str("a build with plugins starts in default", app.profile, "default");
        // default: <Space>w is the windows group, <Space>- splits
        type_text(app, " -");
        check.eq_int("<Space>- splits", app.wins.size(), 2);
        type_text(app, " wd");
        check.eq_int("<Space>wd closes", app.wins.size(), 1);
        type_text(app, "x");
        type_text(app, " w");
        check.ok("<Space>w alone does not write", app.is_leader);
        type_text(app, "\x1b");
        check.ok("the buffer is still modified", app.is_modified());
        // <C-s> writes in default
        type_text(app, "\x13");
        check.ok("<C-s> writes", !app.is_modified());
        // the plugins' keys follow the profile: harpoon remove is hx
        check.eq_str("default: hx is harpoon remove", app.ext.desc_of_keys("n", " hx"), "Harpoon: remove this file");
        check.eq_str("default: hd is not mapped", app.ext.desc_of_keys("n", " hd"), "");
        check.eq_str("default: gc commits", app.ext.desc_of_keys("n", " gc"), "Commit (type the message)");
        check.eq_str("default: gp pulls", app.ext.desc_of_keys("n", " gp"), "Pull");
        check.eq_str("default: gP pushes", app.ext.desc_of_keys("n", " gP"), "Push");
        check.eq_str("default: ]H is the last hunk", app.ext.desc_of_keys("n", "]H"), "last git hunk");
        // legacy: the old tree
        type_text(app, ":Profile legacy\r");
        check.eq_str("legacy", app.profile, "legacy");
        type_text(app, "x");
        type_text(app, " w");
        check.ok("legacy: <Space>w writes", !app.is_modified());
        check.eq_str("legacy: hd is harpoon remove", app.ext.desc_of_keys("n", " hd"), "Harpoon: remove this file");
        check.eq_str("legacy: hx is not mapped", app.ext.desc_of_keys("n", " hx"), "");
        type_text(app, "x");
        type_text(app, "\x13");
        check.ok("legacy: <C-s> is vi's (it does not write)", app.is_modified());
        // nvim: H J K L move the line; going back to default takes the maps away again
        type_text(app, ":e!\r:Profile nvim\r");
        check.eq_str("nvim", app.profile, "nvim");
        type_text(app, "gg");
        type_text(app, "J");
        check.eq_str("nvim: J moves the line down", app.editor.buffer.line(0), "two");
        type_text(app, ":Profile default\r");
        type_text(app, "gg");
        type_text(app, "J");
        check.ok("default: J joins again", app.editor.buffer.line(0).starts_with("two "));
        // minimal: bare vi, <Space> is a motion, the plugins' keys are gone
        write_file(base + "-a.txt", "one\ntwo\nthree\n");
        type_text(app, ":e!\r:Profile minimal\r");
        check.eq_str("minimal", app.profile, "minimal");
        type_text(app, "gg0");
        type_text(app, " ");
        check.ok("minimal: <Space> is not a leader", !app.is_leader);
        check.eq_int("minimal: <Space> moves right", app.editor.col, 1);
        check.eq_str("minimal: no plugin keys", app.ext.desc_of_keys("n", "]b"), "");
        type_text(app, ":Profile default\r");
        check.eq_str("and back", app.ext.desc_of_keys("n", "]b"), "next buffer");
        type_text(app, ":Profile nosuch\r");
        check.ok("an unknown profile is E474", app.notice.starts_with("E474") || app.editor.message.starts_with("E474"));
        check.eq_str("and nothing changed", app.profile, "default");
        // the tables
        check.eq_int("minimal has no leader rows", MED_keymap.defaults("minimal").size(), 0);
        check.ok("default has no <Space>sa surround row", MED_keymap.lookup(MED_keymap.defaults("default"), "sa") == MED_keymap.NO_BINDING);
        check.ok("legacy keeps it", MED_keymap.lookup(MED_keymap.defaults("legacy"), "sa") == MED_keymap.IS_LEAF);
    }
    case Err(str message): {
        print("cannot open: " + message);
    }
}
// a build with no plugin at all starts in minimal
match (MED_app.open_all([base + "-a.txt"])) {
    case Ok(MED_app.App bare): {
        check.eq_str("the profile of an App nobody installed plugins in", bare.profile, "default");
    }
    case Err(str message): {
        print("cannot open: " + message);
    }
}
check.finish("t_profile");
