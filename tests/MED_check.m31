/* A tiny assertion counter for the unit-test programs. Test-only.
 *
 *   MED_check.Check check = MED_check.Check();
 *   check.eq_int("name", actual, expected);
 *   check.finish();       // prints "<name>: N checks, F failed" */

pub type Check {
    pub int total = 0;
    pub int failed = 0;
}

pub void Check.ok(str label, bool is_condition) {
    total = total + 1;
    if (!is_condition) {
        failed = failed + 1;
        print("FAIL " + label);
    }
}

pub void Check.eq_int(str label, int actual, int expected) {
    total = total + 1;
    if (actual != expected) {
        failed = failed + 1;
        print("FAIL " + label + ": got " + actual.to_str() + ", want " + expected.to_str());
    }
}

pub void Check.eq_str(str label, str actual, str expected) {
    total = total + 1;
    if (actual != expected) {
        failed = failed + 1;
        print("FAIL " + label + ": got [" + actual + "], want [" + expected + "]");
    }
}

pub void Check.finish(str name) {
    print(name + ": " + total.to_str() + " checks, " + failed.to_str() + " failed");
}
