// Unit checks for MED_window: the layout tree, splitting, closing, geometry
// and directional neighbours.

import tests.MED_check;
import ui.MED_window;

MED_check.Check check = MED_check.Check();

str ids(MED_window.Node root) {
    List<str> parts = [];
    for (int id in MED_window.leaves(root)) {
        parts.push(id.to_str());
    }
    return parts.join(",");
}

MED_window.Node root = MED_window.leaf(1);
check.eq_str("one window", ids(root), "1");
MED_window.Layout single = MED_window.place(root, 0, 0, 80, 23);
check.eq_int("the whole area", MED_window.placed_of(single, 1).width, 80);
check.eq_int("the whole height", MED_window.placed_of(single, 1).height, 23);
// :split puts the new window above, :vsplit to the left (is_after false);
// the new window gets the larger half, as in nvim
root = MED_window.split(root, 1, 2, false, false);
check.eq_str("new window above", ids(root), "2,1");
MED_window.Layout stacked = MED_window.place(root, 0, 0, 80, 23);
check.eq_int("upper height gets the odd row", MED_window.placed_of(stacked, 2).height, 12);
check.eq_int("lower height", MED_window.placed_of(stacked, 1).height, 11);
check.eq_int("lower starts below", MED_window.placed_of(stacked, 1).y, 12);
check.eq_int("full width", MED_window.placed_of(stacked, 1).width, 80);
check.eq_int("no separator when stacked", stacked.separators.size(), 0);
// the new window below (splitbelow) is the larger one too
MED_window.Node below = MED_window.leaf(1);
MED_window.place(below, 0, 0, 80, 23);
below = MED_window.split(below, 1, 2, false, true);
MED_window.Layout under = MED_window.place(below, 0, 0, 80, 23);
check.eq_int("old window above keeps the smaller half", MED_window.placed_of(under, 1).height, 11);
check.eq_int("new window below is larger", MED_window.placed_of(under, 2).height, 12);
// splitting a window of a stack in the same direction adds a sibling, and
// the three are shared out again with the active one first
root = MED_window.split(root, 1, 3, false, true);
check.eq_str("a third in the same column", ids(root), "2,1,3");
check.eq_int("one branch, three kids", root.kids.size(), 3);
MED_window.Layout three = MED_window.place(root, 0, 0, 80, 23);
check.eq_int("thirds: first", MED_window.placed_of(three, 2).height, 8);
check.eq_int("thirds: second", MED_window.placed_of(three, 1).height, 7);
check.eq_int("thirds: third", MED_window.placed_of(three, 3).height, 8);
check.eq_int("third starts at 15", MED_window.placed_of(three, 3).y, 15);
// the terminal grows by one row: the last window takes it
three = MED_window.place(root, 0, 0, 80, 24);
check.eq_int("the last window gets the new row", MED_window.placed_of(three, 3).height, 9);
check.eq_int("the others keep theirs", MED_window.placed_of(three, 2).height, 8);
// the terminal shrinks: the last window gives up rows first, down to its least
three = MED_window.place(root, 0, 0, 80, 12);
check.eq_int("shrunk: the last takes the loss", MED_window.placed_of(three, 3).height, 2);
three = MED_window.place(root, 0, 0, 80, 23);
// a vertical split inside the stack nests
root = MED_window.split(root, 1, 4, true, true);
check.eq_str("side by side inside the stack", ids(root), "2,1,4,3");
MED_window.Layout nested = MED_window.place(root, 0, 0, 80, 23);
MED_window.Placed left_one = MED_window.placed_of(nested, 1);
MED_window.Placed right_one = MED_window.placed_of(nested, 4);
check.eq_int("left plus separator plus right fills the width", left_one.width + 1 + right_one.width, 80);
check.ok("the new window is the larger half", right_one.width >= left_one.width);
check.eq_int("right half starts after the separator", right_one.x, left_one.width + 1);
check.eq_int("one separator", nested.separators.size(), 1);
check.eq_int("the separator column", nested.separators[0].x, left_one.width);
check.eq_int("the separator is as tall as the window", nested.separators[0].height, left_one.height);
check.eq_int("window at a cell", MED_window.window_at(nested, right_one.x + 2, left_one.y + 1), 4);
check.eq_int("window at a separator", MED_window.window_at(nested, left_one.width, left_one.y + 1), 0);
// neighbours
int row_in = left_one.y + 1;
int col_left = 2;
int col_right = right_one.x + 2;
check.eq_int("right of 1 is 4", MED_window.neighbor(nested, 1, MED_window.GO_RIGHT, col_left, row_in), 4);
check.eq_int("left of 4 is 1", MED_window.neighbor(nested, 4, MED_window.GO_LEFT, col_right, row_in), 1);
check.eq_int("up of 1 is 2", MED_window.neighbor(nested, 1, MED_window.GO_UP, col_left, row_in), 2);
check.eq_int("down of 4 is 3", MED_window.neighbor(nested, 4, MED_window.GO_DOWN, col_right, row_in), 3);
check.eq_int("nothing left of 1", MED_window.neighbor(nested, 1, MED_window.GO_LEFT, col_left, row_in), 0);
check.eq_int("nothing up of 2", MED_window.neighbor(nested, 2, MED_window.GO_UP, col_left, 2), 0);
check.eq_int("down of 3 is nothing", MED_window.neighbor(nested, 3, MED_window.GO_DOWN, col_left, 20), 0);
check.eq_int("up from 3 follows the column of the cursor", MED_window.neighbor(nested, 3, MED_window.GO_UP, col_right, 18), 4);
check.eq_int("up from 3 on the left", MED_window.neighbor(nested, 3, MED_window.GO_UP, col_left, 18), 1);
// closing
root = MED_window.without(root, 4, 1);
check.eq_str("closing a side window", ids(root), "2,1,3");
check.eq_int("the branch collapses to the stack", root.kids.size(), 3);
root = MED_window.without(root, 2, 1);
check.eq_str("closing the top", ids(root), "1,3");
root = MED_window.without(root, 3, 1);
check.eq_str("closing down to one", ids(root), "1");
check.ok("the root is a leaf again", root.win_id == 1);
root = MED_window.without(root, 1, 1);
check.eq_str("the last window stays", ids(root), "1");
// merging after a close: side by side inside a stack, one stack member goes
MED_window.Node tree = MED_window.leaf(1);
tree = MED_window.split(tree, 1, 2, true, true);
tree = MED_window.split(tree, 2, 3, false, true);
check.eq_str("left, then right over right", ids(tree), "1,2,3");
tree = MED_window.without(tree, 3, 2);
check.eq_str("back to two side by side", ids(tree), "1,2");
check.ok("a vertical branch", tree.is_vertical);
tree = MED_window.split(tree, 1, 5, false, true);
tree = MED_window.without(tree, 2, 1);
check.eq_str("the stack remains", ids(tree), "1,5");
check.ok("and is stacked", !tree.is_vertical);
// sizes, rotation, exchange, moving to an edge
MED_window.Node sized = MED_window.leaf(1);
sized = MED_window.split(sized, 1, 2, false, true);
sized = MED_window.split(sized, 2, 3, false, true);
MED_window.place(sized, 0, 0, 40, 20);
check.ok("set a height", MED_window.did_resize(sized, 1, 4, false));
MED_window.Layout shown = MED_window.place(sized, 0, 0, 40, 20);
check.eq_int("the window has the rows asked for and its status line", MED_window.placed_of(shown, 1).height, 5);
check.eq_int("the rest is shared out of what is left (8, 7)", MED_window.placed_of(shown, 2).height + MED_window.placed_of(shown, 3).height, 15);
MED_window.equalize(sized, 1);
shown = MED_window.place(sized, 0, 0, 40, 18);
check.eq_int("equalized, the shrunk screen takes from the last window", MED_window.placed_of(shown, 3).height, 4);
MED_window.equalize(sized, 1);
shown = MED_window.place(sized, 0, 0, 40, 18);
check.eq_int("equalized: the active window gets the odd row", MED_window.placed_of(shown, 1).height, 6);
check.eq_int("equalized second", MED_window.placed_of(shown, 2).height, 6);
check.eq_int("equalized third", MED_window.placed_of(shown, 3).height, 6);
check.ok("rotate", MED_window.did_rotate(sized, 1, true));
check.eq_str("rotated down", ids(sized), "3,1,2");
check.eq_int("exchange", MED_window.exchange(sized, 3), 1);
check.eq_str("exchanged", ids(sized), "1,3,2");
sized = MED_window.moved_to_edge(sized, 2, MED_window.GO_LEFT);
check.eq_str("moved to the left edge", ids(sized), "2,1,3");
check.ok("as a vertical branch", sized.is_vertical);
// the tab line: labels are drawn as " label " one after the other from column 0
List<str> tabs = ["a", "bb", "c d"];
check.eq_int("first column of the first label", MED_window.tab_at(tabs, 80, 0), 0);
check.eq_int("last column of the first label", MED_window.tab_at(tabs, 80, 2), 0);
check.eq_int("first column of the second", MED_window.tab_at(tabs, 80, 3), 1);
check.eq_int("last column of the second", MED_window.tab_at(tabs, 80, 6), 1);
check.eq_int("the third", MED_window.tab_at(tabs, 80, 7), 2);
check.eq_int("its last column", MED_window.tab_at(tabs, 80, 11), 2);
check.eq_int("past the last label", MED_window.tab_at(tabs, 80, 12), -1);
check.eq_int("a label the line has no room for is not drawn", MED_window.tab_at(tabs, 10, 8), -1);
check.eq_int("the one before it still is", MED_window.tab_at(tabs, 10, 4), 1);
check.eq_int("wide characters take two columns", MED_window.tab_at(["\u{65e5}\u{672c}", "x"], 80, 6), 1);
check.eq_int("and the label before is hit across them", MED_window.tab_at(["\u{65e5}\u{672c}", "x"], 80, 5), 0);
check.eq_int("no labels", MED_window.tab_at([], 80, 0), -1);
check.finish("t_window");
