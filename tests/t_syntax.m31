/* Unit checks for MED_hl (the adapter over the `syntax` library): the
 * language of a buffer, the classes of a line, incremental updates after
 * edits, ten languages opened as files, and a speed check on 20k lines. */

import engine.MED_buffer;
import engine.MED_editor;
import engine.MED_hl;
import syntax.core.SYN_class;
import syntax.core.SYN_detect;
import timer;
import tests.MED_check;

MED_check.Check check = MED_check.Check();

MED_editor.Editor open(str path, str text) {
    MED_editor.Editor editor = MED_editor.new(text);
    editor.buffer.path = path;
    return editor;
}

List<int> classes_at(MED_editor.Editor editor, int row) {
    return MED_hl.classes_of(editor, row, MED_hl.language(editor));
}

bool has_class(List<int> classes, int wanted) {
    for (int value in classes) {
        if (value == wanted) {
            return true;
        }
    }
    return false;
}

// --- detection (SYN_detect) -----------------------------------------------
check.eq_str("c by extension", SYN_detect.language_of("a/b/x.c", ""), "c");
check.eq_str("rust", SYN_detect.language_of("main.rs", ""), "rust");
check.eq_str("m31", SYN_detect.language_of("m3.m31", ""), "m31");
check.eq_str("shebang", SYN_detect.language_of("tool", "#!/usr/bin/env python3"), "python");
check.eq_str("unknown", SYN_detect.language_of("notes.txt", ""), "");
check.eq_str("dotfile name", SYN_detect.language_of("/home/u/.bashrc", ""), "sh");
check.eq_str("ts is typescript", SYN_detect.language_of("a.ts", ""), "typescript");
// --- options ----------------------------------------------------------------
MED_editor.Editor named = open("x.txt", "def f(): pass");
check.eq_str("plain text has no language", MED_hl.language(named), "");
named.opts.set("syntax", "py");
check.eq_str("alias py", MED_hl.language(named), "python");
named.opts.set("syntax", "bash");
check.eq_str("alias bash", MED_hl.language(named), "sh");
named.opts.set("syntax", "nonsense");
check.eq_str("unknown name", MED_hl.language(named), "");
named.opts.set("syntax", "off");
check.eq_str("off", MED_hl.language(named), "");
named.opts.set("syntax", "");
named.opts.set("syntaxenabled", "false");
check.eq_str("syntax off", MED_hl.language(open("a.rs", "")), "rust");
MED_editor.Editor disabled = open("a.rs", "fn main() {}");
disabled.opts.set("syntaxenabled", "false");
check.eq_str("syntaxenabled=false", MED_hl.language(disabled), "");
check.eq_int("no classes when off", classes_at(disabled, 0).size(), 0);
// --- classes of a line --------------------------------------------------------
MED_editor.Editor python = open("a.py", "def f(x): # note\nx = \"\"\"abc\ndef\"\"\" + 1");
List<int> py0 = classes_at(python, 0);
check.eq_int("keyword", py0[0], SYN_class.KEYWORD);
check.eq_int("function name", py0[4], SYN_class.FUNCTION);
check.eq_int("comment", py0[11], SYN_class.COMMENT);
check.eq_int("string opens", classes_at(python, 1)[6], SYN_class.STRING);
List<int> py2 = classes_at(python, 2);
check.eq_int("inside the string", py2[0], SYN_class.STRING);
check.eq_int("number after it", py2[9], SYN_class.NUMBER);
MED_editor.Editor source = open("a.c", "int x; /* start\nend */ return 0;\n#include <stdio.h>");
check.eq_int("type", classes_at(source, 0)[0], SYN_class.TYPE);
check.eq_int("block comment", classes_at(source, 0)[8], SYN_class.COMMENT);
check.eq_int("comment ends", classes_at(source, 1)[4], SYN_class.COMMENT);
check.eq_int("keyword after", classes_at(source, 1)[7], SYN_class.KEYWORD);
// the library classes a directive as a keyword (it was PREPROC in 0.1.0)
check.eq_int("preprocessor directive", classes_at(source, 2)[3], SYN_class.KEYWORD);
MED_editor.Editor notes = open("a.md", "## Title\n```rust\nfn main() { let x = 1; } // c\n```\nafter");
check.eq_int("heading", classes_at(notes, 0)[3], SYN_class.TITLE);
List<int> fenced = classes_at(notes, 2);
check.eq_int("rust keyword in a rust fence", fenced[0], SYN_class.KEYWORD);
check.eq_int("rust function name", fenced[3], SYN_class.FUNCTION);
check.eq_int("rust number", fenced[20], SYN_class.NUMBER);
check.eq_int("rust comment", fenced[27], SYN_class.COMMENT);
// the library classes the fence marker as raw text; it was SPECIAL in 0.1.0 (0.3.0 draws RAW itself)
check.eq_int("closing fence marker", classes_at(notes, 3)[0], SYN_class.RAW);
check.ok("after the fence is not rust", !has_class(classes_at(notes, 4), SYN_class.KEYWORD));
// --- richer classes reach the renderer unfolded (0.3.0) -------------------------------
MED_editor.Editor data = open("a.json", "{\"key\": 1}");
check.eq_int("json key is a property", classes_at(data, 0)[2], SYN_class.PROPERTY);
check.eq_int("json number", classes_at(data, 0)[8], SYN_class.NUMBER);
MED_editor.Editor page = open("a.html", "<a href=\"x\">t</a>");
check.eq_int("html tag name", classes_at(page, 0)[1], SYN_class.TAG);
check.ok("html attribute", has_class(classes_at(page, 0), SYN_class.ATTRIBUTE));
MED_editor.Editor calls = open("a.py", "print(self.x)");
check.eq_int("a call", classes_at(calls, 0)[0], SYN_class.CALL);
check.ok("self is a builtin variable", has_class(classes_at(calls, 0), SYN_class.BUILTIN_VAR));
// --- incremental: edits move the states -------------------------------------------
MED_editor.Editor edited = open("a.c", "int a;\nint b;\nint c;\n");
check.eq_int("before: plain", classes_at(edited, 2)[0], SYN_class.TYPE);
edited.change(MED_buffer.Pos(0, 0), MED_buffer.Pos(0, 0), "/* ");
check.eq_int("an opened comment reaches the later lines", classes_at(edited, 2)[0], SYN_class.COMMENT);
edited.change(MED_buffer.Pos(1, 0), MED_buffer.Pos(1, 0), "*/ ");
check.eq_int("closed again", classes_at(edited, 2)[0], SYN_class.TYPE);
edited.change(MED_buffer.Pos(0, 0), MED_buffer.Pos(0, 0), "x\ny\n");
check.eq_int("lines inserted above keep the states", classes_at(edited, 4)[0], SYN_class.TYPE);
check.eq_int("the new line is code", classes_at(edited, 2)[0], SYN_class.COMMENT);
// --- ten languages opened as files -----------------------------------------------------
List<str> paths = ["a.c", "a.cpp", "a.go", "a.js", "a.json", "a.m31", "a.py", "a.rs", "a.sh", "a.toml", "a.yaml", "a.html", "a.css", "a.sql", "a.java", "a.rb", "a.lua"];
List<str> sources = ["int main(void) { return 0; }", "class A { int x = 1; };", "package main\nfunc main() { x := 1 }", "const a = function() { return 1; };", "{\"a\": [1, true, \"s\"]}", "fn main() { int x = 1; }", "def f(x):\n    return 1", "fn main() { let x = 1; }", "if [ -f x ]; then echo \"hi\"; fi", "[package]\nname = \"x\"\nn = 3", "key: value\nn: 3", "<div class=\"a\">text</div>", "a { color: red; margin: 0 }", "SELECT a FROM t WHERE b = 1;", "public class A { int x = 1; }", "def f\n  puts \"hi\"\nend", "local x = 1\nfunction f() return x end"];
for (int index in 0 .. paths.size()) {
    MED_editor.Editor opened = open(paths[index], sources[index]);
    str lang = MED_hl.language(opened);
    check.ok(paths[index] + " has a language", lang != "");
    bool is_any = false;
    for (int row in 0 .. opened.buffer.line_count()) {
        List<int> found = classes_at(opened, row);
        check.eq_int(paths[index] + " row " + row.to_str() + " has a class per byte", found.size(), opened.buffer.line(row).size());
        for (int value in found) {
            if (value != SYN_class.NORMAL) {
                is_any = true;
            }
        }
    }
    check.ok(paths[index] + " highlights something", is_any);
}
// --- speed: 20k lines, incremental ---------------------------------------------------------
List<str> big = [];
for (int row in 0 .. 20000) {
    big.push("int f" + row.to_str() + "(int x) { return x + " + row.to_str() + "; } // line \"" + row.to_str() + "\"");
}
MED_editor.Editor large = open("big.c", big.join("\n"));
int started = timer.monotonic_ns();
int shown = 0;
for (int row in 0 .. 20000) {
    shown = shown + classes_at(large, row).size();
}
int cold_ms = (timer.monotonic_ns() - started) / 1000000;
check.ok("20k lines classified", shown > 0);
// 1000 keystrokes at the top of the file, each followed by a redraw of 50 lines
started = timer.monotonic_ns();
for (int key in 0 .. 1000) {
    large.change(MED_buffer.Pos(0, 0), MED_buffer.Pos(0, 0), "x");
    for (int row in 0 .. 50) {
        classes_at(large, row);
    }
}
int edit_ms = (timer.monotonic_ns() - started) / 1000000;
print("cold pass over 20000 lines: " + cold_ms.to_str() + " ms (budget 10000)");
print("1000 edits + 50-line redraws: " + edit_ms.to_str() + " ms (budget 5000)");
check.ok("cold highlight of 20k lines within 10 s", cold_ms < 10000);
check.ok("1000 incremental edits within 5 s", edit_ms < 5000);
// an edit at the bottom of the file after the whole file was walked
check.eq_int("the last line is still code", classes_at(large, 19999)[0], SYN_class.TYPE);
check.finish("t_syntax");
