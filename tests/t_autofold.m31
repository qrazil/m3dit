// The fold structure of 'foldmethod' marker (engine/MED_autofold.m31). The expected values are what nvim shows: the folds
// closed at 'foldlevel' 0 to 6 (foldclosed() / foldclosedend() with 'foldminlines' 0), so they fix the whole tree. A jump
// level ({{{3, }}}2) raises or lowers the level; a fold runs on over lines below its level when a later line at the level
// has no start marker of its own. tests/oracles/oracle_folds.py checks random texts against nvim.

import engine.MED_editor;
import engine.MED_buffer;
import engine.MED_autofold;
import tests.MED_check;

// "level:first-last" of every closed fold at 'foldlevel' 0 to 6
str view_of(List<str> lines) {
    MED_editor.Editor editor = MED_editor.new("");
    editor.opts.set("foldmethod", "marker");
    editor.opts.set("foldminlines", "0");
    editor.buffer.lines = lines;
    editor.init_marks();
    List<str> parts = [];
    for (int level in 0 .. 7) {
        editor.opts.set("foldlevel", level.to_str());
        MED_autofold.sync(editor);
        int row = 0;
        while (row < editor.buffer.line_count()) {
            int last = editor.fold_end_of(row);
            if (last >= 0) {
                parts.push(level.to_str() + ":" + (editor.fold_start_of(row) + 1).to_str() + "-" + (last + 1).to_str());
                row = last + 1;
            } else {
                row = row + 1;
            }
        }
    }
    return parts.join(" ");
}

MED_check.Check check = MED_check.Check();
check.eq_str("a / {{{ / b / }}} / c", view_of(["a", "{{{", "b", "}}}", "c"]), "0:2-4");
check.eq_str("{{{ / {{{ / b / }}} / c / }}}", view_of(["{{{", "{{{", "b", "}}}", "c", "}}}"]), "0:1-6 1:2-4");
check.eq_str("a {{{ / b / c }}} / d / e {{{ / f / g }}}", view_of(["a {{{", "b", "c }}}", "d", "e {{{", "f", "g }}}"]), "0:1-3 0:5-7");
check.eq_str("{{{3 deep / x / }}}3 / y {{{ / z / }}}", view_of(["{{{3 deep", "x", "}}}3", "y {{{", "z", "}}}"]), "0:1-6 1:1-6 2:1-3 2:4-6");
check.eq_str("{{{1 / }}}1 / y / }}}1", view_of(["{{{1", "}}}1", "y", "}}}1"]), "0:1-4");
check.eq_str("{{{1 / }}}3 / y / y / b }}} / }}}2 / y", view_of(["{{{1", "}}}3", "y", "y", "b }}}", "}}}2", "y"]), "0:1-6 1:2-6 2:2-2");
check.eq_str("{{{1 / {{{3 / }}}1 / }}}3 / y / y", view_of(["{{{1", "{{{3", "}}}1", "}}}3", "y", "y"]), "0:1-4 1:2-4 2:2-4");
check.eq_str("a {{{ / a {{{ / {{{ / {{{1 / y / }}}2 / }}}1 / y / }}}1", view_of(["a {{{", "a {{{", "{{{", "{{{1", "y", "}}}2", "}}}1", "y", "}}}1"]), "0:1-3 0:4-9 1:2-3 1:6-6 2:3-3");
check.eq_str("y / a {{{ / }}}1 / y / }}} / }}}2 / b }}}", view_of(["y", "a {{{", "}}}1", "y", "}}}", "}}}2", "b }}}"]), "0:2-6 1:6-6");
check.eq_str("}}}3 / y / y / }}}3 / {{{2 / }}}1 / b }}}", view_of(["}}}3", "y", "y", "}}}3", "{{{2", "}}}1", "b }}}"]), "0:1-4 0:5-6 1:1-4 1:5-5 2:1-4");
check.eq_str("{{{2 / }}}1 / y / }}}1 / }}}2", view_of(["{{{2", "}}}1", "y", "}}}1", "}}}2"]), "0:1-5 1:1-1 1:5-5");
check.eq_str("x / {{{ }}} / y", view_of(["x", "{{{ }}}", "y"]), "0:2-2");
check.eq_str("{{{ / b {{{ / c", view_of(["{{{", "b {{{", "c"]), "0:1-3 1:2-3");
// a fold opened by hand stays open through an edit that moves its end
MED_editor.Editor editor = MED_editor.new("");
editor.opts.set("foldmethod", "marker");
editor.buffer.lines = ["{{{1 one", "x", "{{{2 two", "y", "}}}2", "z", "}}}1", "w"];
editor.init_marks();
MED_autofold.sync(editor);
check.eq_int("folds", editor.folds.size(), 2);
check.ok("closed to start with", editor.folds[0].is_closed);
editor.folds[0].is_closed = false;
editor.folds[0].is_level = false;
editor.change(MED_buffer.Pos(6, 0), MED_buffer.Pos(6, 1), "");
MED_autofold.sync(editor);
check.ok("the marker went: the fold runs to the end", editor.folds[0].end == 7);
check.ok("and is still open", !editor.folds[0].is_closed);
check.finish("t_autofold");
