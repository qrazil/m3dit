// Unit checks for MED_lsp: framing, JSON-RPC decoding, URIs, UTF-16 columns,
// text edits, and a round trip with a scripted server (python3).

import encoding.json;
import tests.MED_check;
import ui.MED_lsp;

MED_check.Check check = MED_check.Check();
// framing
check.eq_str("frame", MED_lsp.frame("{}"), "Content-Length: 2\r\n\r\n{}");
MED_lsp.Reader reader = MED_lsp.Reader();
List<str> none = reader.feed("Content-Length: 7\r\n\r\n{\"a\"".to_bytes());
check.eq_int("partial body waits", none.size(), 0);
List<str> two = reader.feed(":1}Content-Length: 2\r\n\r\n{}".to_bytes());
check.eq_int("two bodies", two.size(), 2);
check.eq_str("first body", two[0], "{\"a\":1}");
check.eq_str("second body", two[1], "{}");
// decoding
MED_lsp.Message response = MED_lsp.decode("{\"jsonrpc\":\"2.0\",\"id\":7,\"result\":{\"x\":1}}");
check.eq_str("response", response.kind, "response");
check.eq_int("response id", response.id, 7);
MED_lsp.Message notification = MED_lsp.decode("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"file:///tmp/a.txt\",\"diagnostics\":[{\"range\":{\"start\":{\"line\":1,\"character\":2},\"end\":{\"line\":1,\"character\":5}},\"severity\":2,\"message\":\"bad\"}]}}");
check.eq_str("notification", notification.kind, "notification");
List<MED_lsp.Diagnostic> found = MED_lsp.diagnostics_of(notification.body);
check.eq_int("one diagnostic", found.size(), 1);
check.eq_int("diagnostic line", found[0].row, 1);
check.eq_int("diagnostic severity", found[0].severity, 2);
check.eq_str("diagnostic message", found[0].message, "bad");
MED_lsp.Message problem = MED_lsp.decode("{\"id\":1,\"error\":{\"code\":-1,\"message\":\"no\"}}");
check.ok("error response", problem.is_error);
check.eq_str("error text", problem.error_text, "no");
check.eq_str("garbage is not a message", MED_lsp.decode("nope").kind, "");
// URIs and columns
check.eq_str("uri", MED_lsp.uri_of("/tmp/my file.txt"), "file:///tmp/my%20file.txt");
check.eq_str("path", MED_lsp.path_of("file:///tmp/my%20file.txt"), "/tmp/my file.txt");
check.eq_str("not a file uri", MED_lsp.path_of("http://x"), "");
check.eq_int("ascii column", MED_lsp.byte_of("hello", 3), 3);
check.eq_int("two-byte char", MED_lsp.byte_of("h\u{e9}llo", 2), 3);
check.eq_int("astral char is two units", MED_lsp.byte_of("a\u{1f600}b", 3), 5);
check.eq_int("units of bytes", MED_lsp.units_of("a\u{1f600}b", 5), 3);
// edits
List<MED_lsp.TextEdit> edits = [MED_lsp.TextEdit(0, 0, 0, 5, "HELLO"), MED_lsp.TextEdit(1, 0, 1, 0, "new\n")];
List<str> edited = MED_lsp.apply_edits(["hello world", "second"], edits);
check.eq_str("replace", edited[0], "HELLO world");
check.eq_str("insert a line", edited[1], "new");
check.eq_str("rest follows", edited[2], "second");
List<str> joined = MED_lsp.apply_edits(["a", "b", "c"], [MED_lsp.TextEdit(0, 1, 2, 0, "-")]);
check.eq_int("multi-line replace", joined.size(), 1);
check.eq_str("multi-line result", joined[0], "a-c");
// a scripted server: answers initialize, then hover with "hi from server"
str script = "import sys, json\n" + "def read():\n" + "    h = sys.stdin.buffer.readline()\n" + "    if not h: return None\n" + "    n = int(h.split(b':')[1])\n" + "    sys.stdin.buffer.readline()\n" + "    return json.loads(sys.stdin.buffer.read(n))\n" + "def send(o):\n" + "    b = json.dumps(o).encode()\n" + "    sys.stdout.buffer.write(b'Content-Length: %d\\r\\n\\r\\n' % len(b) + b); sys.stdout.buffer.flush()\n" + "while True:\n" + "    m = read()\n" + "    if m is None: break\n" + "    if m.get('method') == 'initialize': send({'jsonrpc':'2.0','id':m['id'],'result':{'capabilities':{}}})\n" + "    elif m.get('method') == 'textDocument/hover': send({'jsonrpc':'2.0','id':m['id'],'result':{'contents':{'kind':'plaintext','value':'hi from server'}}})\n" + "    elif m.get('method') == 'shutdown': send({'jsonrpc':'2.0','id':m['id'],'result':None})\n" + "    elif m.get('method') == 'exit': break\n";
MED_lsp.Server server = MED_lsp.start("fake", ["python3", "-c", script], "/tmp");
check.ok("server started", !server.is_dead);
int hover_id = 0;
str answer = "";
bool is_ready = false;
for (int round in 0 .. 3000) {
    for (MED_lsp.Message message in server.poll()) {
        if (message.kind == "response" && message.id == server.initialize_id) {
            is_ready = true;
            server.notify("initialized", json.Value.Object({}));
            hover_id = server.request("textDocument/hover", MED_lsp.object(["textDocument"], [MED_lsp.object(["uri"], [MED_lsp.text("file:///tmp/a")])]));
        } else if (message.kind == "response" && message.id == hover_id) {
            answer = MED_lsp.hover_text(message.body);
        }
    }
    if (answer.size() > 0) {
        break;
    }
}
check.ok("initialize answered", is_ready);
check.eq_str("hover text", answer, "hi from server");
server.stop();
check.ok("stopped", server.is_dead);
// languageId and string request ids
check.eq_str("typescript id", MED_lsp.language_id_of("/p/a.ts", "javascript"), "typescript");
check.eq_str("tsx id", MED_lsp.language_id_of("/p/a.tsx", "javascript"), "typescriptreact");
check.eq_str("jsx id", MED_lsp.language_id_of("/p/a.jsx", "javascript"), "javascriptreact");
check.eq_str("js id", MED_lsp.language_id_of("/p/a.js", "javascript"), "javascript");
check.eq_str("shell id", MED_lsp.language_id_of("/p/a.sh", "sh"), "shellscript");
check.eq_str("lua by extension", MED_lsp.language_of_extension("/p/a.lua"), "lua");
check.eq_str("no language by extension", MED_lsp.language_of_extension("/p/a.txt"), "");
MED_lsp.Message by_string = MED_lsp.decode("{\"jsonrpc\":\"2.0\",\"id\":\"abc\",\"method\":\"client/registerCapability\",\"params\":{}}");
check.eq_str("a request", by_string.kind, "request");
check.eq_str("its string id is kept", MED_lsp.text_of(by_string.id_value), "abc");
MED_lsp.Message failed = MED_lsp.decode("{\"jsonrpc\":\"2.0\",\"id\":3,\"error\":{\"code\":-32801,\"message\":\"content modified\"}}");
check.eq_int("error code", failed.error_code, -32801);
check.ok("capabilities unknown: everything is tried", MED_lsp.Server("x", [], "/").can_do("renameProvider"));
check.eq_str("snippet placeholder", MED_lsp.plain_snippet("f(${1:arg}, ${2:other})$0"), "f(arg, other)");
check.eq_str("bare tab stops", MED_lsp.plain_snippet("a$1b${2}c$0"), "abc");
check.eq_str("choice", MED_lsp.plain_snippet("${1|one,two|}"), "one");
check.eq_str("escaped dollar", MED_lsp.plain_snippet("\\$x"), "$x");
check.eq_str("nested placeholder", MED_lsp.plain_snippet("${1:a${2:b}}"), "ab");
check.ok("order a < b", MED_lsp.is_before("a", "b"));
check.ok("prefix sorts first", MED_lsp.is_before("ab", "abc"));
check.ok("equal is not before", !MED_lsp.is_before("x", "x"));
// signature help and inlay hints
MED_lsp.Message signature = MED_lsp.decode("{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"signatures\":[{\"label\":\"greet(name, greeting)\",\"parameters\":[{\"label\":\"name\"},{\"label\":[12,20],\"documentation\":\"the words\"}],\"documentation\":{\"kind\":\"markdown\",\"value\":\"Say hello\"}}],\"activeSignature\":0,\"activeParameter\":1}}");
List<str> signature_lines = MED_lsp.signature_lines(signature.body);
check.eq_int("signature lines", signature_lines.size(), 4);
check.eq_str("the label", signature_lines[0], "greet(name, greeting)");
check.eq_str("the active parameter by offsets", signature_lines[1], "-> greeting");
check.eq_str("the parameter documentation", signature_lines[2], "the words");
check.eq_str("the documentation", signature_lines[3], "Say hello");
check.eq_int("no signatures", MED_lsp.signature_lines(MED_lsp.member(signature.body, "nothing")).size(), 0);
MED_lsp.Message hints = MED_lsp.decode("{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":[{\"position\":{\"line\":1,\"character\":2},\"label\":\"x:\"},{\"position\":{\"line\":2,\"character\":0},\"label\":[{\"value\":\"a\"},{\"value\":\": int\"}]}]}");
List<json.Value> hint_items = MED_lsp.items_of(hints.body);
check.eq_str("a string label", MED_lsp.inlay_label(hint_items[0]), "x:");
check.eq_str("a label of parts", MED_lsp.inlay_label(hint_items[1]), "a: int");
// positions moved by edits made elsewhere (additionalTextEdits of a completion)
List<int> moved = MED_lsp.map_point([MED_lsp.TextEdit(0, 0, 0, 0, "import x\n")], 4, 7);
check.eq_int("an import above moves the line", moved[0], 5);
check.eq_int("and leaves the column", moved[1], 7);
moved = MED_lsp.map_point([MED_lsp.TextEdit(3, 0, 3, 0, "a\nb\n")], 3, 4);
check.eq_int("an insert at the same row start", moved[0], 5);
check.eq_int("moves the column to the new last line", moved[1], 4);
moved = MED_lsp.map_point([MED_lsp.TextEdit(2, 1, 2, 3, "xxxx")], 2, 6);
check.eq_int("same line, before the point", moved[0], 2);
check.eq_int("column grows by the difference", moved[1], 8);
moved = MED_lsp.map_point([MED_lsp.TextEdit(5, 0, 6, 0, "")], 8, 1);
check.eq_int("a deleted line moves it up", moved[0], 7);
moved = MED_lsp.map_point([MED_lsp.TextEdit(9, 0, 9, 0, "late\n")], 4, 2);
check.eq_int("an edit after the point does nothing", moved[0], 4);
check.ok("is_true", MED_lsp.is_true(json.Value.Bool(true)) && !MED_lsp.is_true(json.Value.Null) && !MED_lsp.is_true(json.Value.Int(1)));
check.eq_int("utf16 size of an astral char", MED_lsp.utf16_size("a\u{1f600}"), 3);
// await, the backlog and $/cancelRequest, against a scripted server
str waiter = "import sys, json\n" + "last = [None]\n" + "def read():\n" + "    h = sys.stdin.buffer.readline()\n" + "    if not h: return None\n" + "    n = int(h.split(b':')[1])\n" + "    sys.stdin.buffer.readline()\n" + "    return json.loads(sys.stdin.buffer.read(n))\n" + "def send(o):\n" + "    b = json.dumps(o).encode()\n" + "    sys.stdout.buffer.write(b'Content-Length: %d\\r\\n\\r\\n' % len(b) + b); sys.stdout.buffer.flush()\n" + "while True:\n" + "    m = read()\n" + "    if m is None: break\n" + "    t = m.get('method')\n" + "    if t == 'initialize': send({'jsonrpc':'2.0','id':m['id'],'result':{'capabilities':{'completionProvider':{'triggerCharacters':['.',':'],'allCommitCharacters':[';']}}}})\n" + "    elif t == '$/cancelRequest': last[0] = m['params']['id']\n" + "    elif t == 'x/ping':\n" + "        send({'jsonrpc':'2.0','method':'x/note','params':{}})\n" + "        send({'jsonrpc':'2.0','id':m['id'],'result':{'cancelled':last[0]}})\n" + "    elif t == 'shutdown': send({'jsonrpc':'2.0','id':m['id'],'result':None})\n" + "    elif t == 'exit': break\n";
MED_lsp.Server waiting = MED_lsp.start("fake", ["python3", "-c", waiter], "/tmp");
check.ok("second server started", !waiting.is_dead);
check.ok("it is ready", waiting.await(waiting.initialize_id, 5000).is_some());
waiting.capabilities = json.Value.Object({"completionProvider": MED_lsp.object(["triggerCharacters", "allCommitCharacters"], [json.Value.Array([MED_lsp.text("."), MED_lsp.text(":")]), json.Value.Array([MED_lsp.text(";")])])});
int stalled = waiting.request("x/stall", json.Value.Null);
waiting.cancel(stalled);
int ping = waiting.request("x/ping", json.Value.Null);
match (waiting.await(ping, 5000)) {
    case Some(MED_lsp.Message reply): {
        check.eq_int("the server saw the cancel of the right id", MED_lsp.int_of(MED_lsp.member(reply.body, "cancelled"), -1), stalled);
    }
    case None: {
        check.ok("await answered", false);
    }
}
List<MED_lsp.Message> kept = waiting.poll();
check.eq_int("what arrived meanwhile is kept for poll", kept.size(), 1);
check.eq_str("the notification", kept[0].method, "x/note");
check.eq_int("and only once", waiting.poll().size(), 0);
check.ok("await times out", waiting.await(9999, 150).is_none());
check.eq_str("trigger characters", waiting.trigger_characters().join(""), ".:");
check.ok("an all-commit character", waiting.is_commit_character(json.Value.Null, ";"));
check.ok("not a commit character", !waiting.is_commit_character(json.Value.Null, ","));
check.ok("an item's own commit characters win", !waiting.is_commit_character(MED_lsp.object(["commitCharacters"], [json.Value.Array([MED_lsp.text("(")])]), ";"));
waiting.stop();

// incremental changes: the one change event turns the old document into the new one
json.Value parsed_json(str body) {
    match (json.parse(body)) {
        case Ok(json.Value value): {
            return value;
        }
        case Err(json.Error error): {
            return json.Value.Null;
        }
    }
}

// the event applied to `before` (rows plus the empty row after the final line break) gives `after`
bool is_equivalent(List<str> before, List<str> after) {
    json.Value event = MED_lsp.change_of(before, after);
    if (MED_lsp.is_null(event)) {
        return before.join("\n") == after.join("\n");
    }
    json.Value range = MED_lsp.member(event, "range");
    json.Value start = MED_lsp.member(range, "start");
    json.Value finish = MED_lsp.member(range, "end");
    MED_lsp.TextEdit edit = MED_lsp.TextEdit(MED_lsp.int_of(MED_lsp.member(start, "line"), 0), MED_lsp.int_of(MED_lsp.member(start, "character"), 0), MED_lsp.int_of(MED_lsp.member(finish, "line"), 0), MED_lsp.int_of(MED_lsp.member(finish, "character"), 0), MED_lsp.text_of(MED_lsp.member(event, "text")));
    List<str> padded_before = before.slice(0, before.size());
    padded_before.push("");
    List<str> padded_after = after.slice(0, after.size());
    padded_after.push("");
    return MED_lsp.apply_edits(padded_before, [edit]).join("\n") == padded_after.join("\n");
}

json.Value one_event = MED_lsp.change_of(["hello world", "second"], ["hello there", "second"]);
check.eq_str("a character change is a ranged text", MED_lsp.text_of(MED_lsp.member(one_event, "text")), "there");
check.eq_int("it starts after the common prefix", MED_lsp.int_of(MED_lsp.member(MED_lsp.member(MED_lsp.member(one_event, "range"), "start"), "character"), -1), 6);
check.eq_int("it ends before the common suffix", MED_lsp.int_of(MED_lsp.member(MED_lsp.member(MED_lsp.member(one_event, "range"), "end"), "character"), -1), 11);
check.ok("no change is null", MED_lsp.is_null(MED_lsp.change_of(["a", "b"], ["a", "b"])));
json.Value inserted_rows = MED_lsp.change_of(["a", "d"], ["a", "b", "c", "d"]);
check.eq_str("inserted rows are the rows and a line break", MED_lsp.text_of(MED_lsp.member(inserted_rows, "text")), "b\nc\n");
check.eq_int("at the start of the next row", MED_lsp.int_of(MED_lsp.member(MED_lsp.member(MED_lsp.member(inserted_rows, "range"), "start"), "line"), -1), 1);
json.Value deleted_rows = MED_lsp.change_of(["a", "b", "c", "d"], ["a", "d"]);
check.eq_str("deleted rows have no text", MED_lsp.text_of(MED_lsp.member(deleted_rows, "text")), "");
check.eq_int("the range ends at the start of the row after", MED_lsp.int_of(MED_lsp.member(MED_lsp.member(MED_lsp.member(deleted_rows, "range"), "end"), "line"), -1), 3);
json.Value wide = MED_lsp.change_of(["a\u{1f600}b"], ["a\u{1f600}c"]);
check.eq_int("columns are UTF-16 units", MED_lsp.int_of(MED_lsp.member(MED_lsp.member(MED_lsp.member(wide, "range"), "start"), "character"), -1), 3);
check.ok("append at the end of the document", is_equivalent(["a"], ["a", "b"]));
check.ok("remove the last line", is_equivalent(["a", "b"], ["a"]));
check.ok("empty document grows", is_equivalent([], ["x"]));
check.ok("document is emptied", is_equivalent(["x"], []));
check.ok("one line becomes two", is_equivalent(["ab"], ["a", "b"]));
check.ok("two lines are joined", is_equivalent(["a", "b"], ["ab"]));
// a deterministic pile of random edits: every pair of documents round-trips
List<str> alphabet = ["", "a", "ab", "b", "\u{e9}", "\u{1f600}x", "xyz", "  ", "a b"];
int seed = 12345;
int bad_pairs = 0;
for (int round in 0 .. 400) {
    List<str> old_doc = [];
    int old_count = 0;
    seed = (seed * 1103515245 + 12345) % 2147483648;
    old_count = (seed / 65536) % 6;
    for (int row in 0 .. old_count) {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        old_doc.push(alphabet[(seed / 65536) % alphabet.size()]);
    }
    List<str> new_doc = old_doc.slice(0, old_doc.size());
    seed = (seed * 1103515245 + 12345) % 2147483648;
    int edit_count = 1 + (seed / 65536) % 3;
    for (int one in 0 .. edit_count) {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        int kind = (seed / 65536) % 4;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        int place = 0;
        if (new_doc.size() > 0) {
            place = (seed / 65536) % new_doc.size();
        }
        seed = (seed * 1103515245 + 12345) % 2147483648;
        str piece = alphabet[(seed / 65536) % alphabet.size()];
        if (kind == 0) {
            new_doc.insert(place, piece);
        } else if (kind == 1 && new_doc.size() > 0) {
            new_doc.remove_at(place);
        } else if (kind == 2 && new_doc.size() > 0) {
            new_doc[place] = new_doc[place] + piece;
        } else if (kind == 3 && new_doc.size() > 0) {
            new_doc[place] = piece;
        }
    }
    if (!is_equivalent(old_doc, new_doc)) {
        bad_pairs = bad_pairs + 1;
        print("pair fails: [" + old_doc.join("|") + "] -> [" + new_doc.join("|") + "]");
    }
}
check.eq_int("400 random edits all round-trip through change_of", bad_pairs, 0);
// sync kind and dynamic registration
MED_lsp.Server plain_server = MED_lsp.Server("x", [], "/");
plain_server.capabilities = parsed_json("{\"textDocumentSync\":2}");
check.eq_int("incremental announced as a number", plain_server.sync_kind(), 2);
plain_server.capabilities = parsed_json("{\"textDocumentSync\":{\"openClose\":true,\"change\":2}}");
check.eq_int("incremental announced in an object", plain_server.sync_kind(), 2);
plain_server.capabilities = parsed_json("{\"textDocumentSync\":1}");
check.eq_int("full sync stays full", plain_server.sync_kind(), 1);
plain_server.capabilities = parsed_json("{}");
check.eq_int("silent servers get the whole text (as before)", plain_server.sync_kind(), 1);
check.ok("not announced yet", !plain_server.can_do("completionProvider"));
plain_server.register(parsed_json("{\"registrations\":[{\"id\":\"1\",\"method\":\"textDocument/completion\",\"registerOptions\":{\"triggerCharacters\":[\".\"]}},{\"id\":\"2\",\"method\":\"textDocument/didChange\",\"registerOptions\":{\"syncKind\":2}},{\"id\":\"3\",\"method\":\"workspace/didChangeWatchedFiles\",\"registerOptions\":{\"watchers\":[]}},{\"id\":\"4\",\"method\":\"textDocument/formatting\"},{\"id\":\"5\",\"method\":\"unknown/method\"}]}"));
check.ok("a registered capability can be used", plain_server.can_do("completionProvider"));
check.eq_str("its options are seen", plain_server.trigger_characters().join(""), ".");
check.eq_int("a registered sync kind", plain_server.sync_kind(), 2);
check.ok("a registration without options is true", plain_server.can_do("documentFormattingProvider"));
check.eq_int("watchers are remembered", plain_server.watchers.size(), 1);
plain_server.unregister(parsed_json("{\"unregisterations\":[{\"id\":\"1\",\"method\":\"textDocument/completion\"},{\"id\":\"2\",\"method\":\"textDocument/didChange\"},{\"id\":\"3\",\"method\":\"workspace/didChangeWatchedFiles\"},{\"id\":\"9\",\"method\":\"x\"}]}"));
check.ok("unregistered: gone again", !plain_server.can_do("completionProvider"));
check.eq_int("the sync kind is back", plain_server.sync_kind(), 1);
check.eq_int("no watchers", plain_server.watchers.size(), 0);
check.ok("the other registration stays", plain_server.can_do("documentFormattingProvider"));
// WorkspaceEdit steps, in order
List<MED_lsp.FileOp> ops = MED_lsp.workspace_ops(parsed_json("{\"documentChanges\":[{\"kind\":\"create\",\"uri\":\"file:///p/new.txt\",\"options\":{\"ignoreIfExists\":true}},{\"textDocument\":{\"uri\":\"file:///p/a.py\",\"version\":4},\"edits\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}},\"newText\":\"X\"}]},{\"kind\":\"rename\",\"oldUri\":\"file:///p/new.txt\",\"newUri\":\"file:///p/moved.txt\"},{\"kind\":\"delete\",\"uri\":\"file:///p/old.txt\",\"options\":{\"ignoreIfNotExists\":true}}]}"));
check.eq_int("four steps", ops.size(), 4);
check.eq_str("create", ops[0].kind, "create");
check.ok("create option", ops[0].is_ignored);
check.eq_str("edit", ops[1].kind, "edit");
check.eq_int("edit version", ops[1].version, 4);
check.eq_int("edit count", ops[1].edits.size(), 1);
check.eq_str("rename from", ops[2].path, "/p/new.txt");
check.eq_str("rename to", ops[2].target, "/p/moved.txt");
check.eq_str("delete", ops[3].kind, "delete");
List<MED_lsp.FileOp> plain_ops = MED_lsp.workspace_ops(parsed_json("{\"changes\":{\"file:///p/a.py\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"newText\":\"x\"}]}}"));
check.eq_int("`changes` is one edit step per file", plain_ops.size(), 1);
check.eq_int("unversioned", plain_ops[0].version, -1);
check.finish("t_lsp");
