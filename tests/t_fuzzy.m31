/* Unit checks for MED_fuzzy: matching, smart-case, extended syntax, ranking,
 * highlight positions. */

import tests.MED_check;
import ui.MED_fuzzy;

MED_check.Check check = MED_check.Check();

bool is_match(str query, str candidate) {
    return MED_fuzzy.parse(query).score(candidate) >= 0;
}

int score_of(str query, str candidate) {
    return MED_fuzzy.parse(query).score(candidate);
}

str joined(List<int> numbers) {
    List<str> parts = [];
    for (int number in numbers) {
        parts.push(number.to_str());
    }
    return parts.join(",");
}

str joined_items(List<MED_fuzzy.Ranked> ranked) {
    List<int> numbers = [];
    for (MED_fuzzy.Ranked one in ranked) {
        numbers.push(one.item_index);
    }
    return joined(numbers);
}

str best_of(str query, List<str> candidates) {
    List<MED_fuzzy.Ranked> ranked = MED_fuzzy.rank(MED_fuzzy.parse(query), candidates, -1);
    if (ranked.size() == 0) {
        return "";
    }
    return candidates[ranked[0].item_index];
}

check.ok("subsequence matches", is_match("abc", "a_b_c"));
check.ok("order matters", !is_match("cba", "abc"));
check.ok("missing char", !is_match("abz", "abc"));
check.ok("empty query matches all", is_match("", "anything"));
check.ok("smart-case: lower matches upper", is_match("readme", "README.md"));
check.ok("smart-case: capital is exact", !is_match("Readme", "readme.md"));
check.ok("capital matches itself", is_match("Readme", "Readme.md"));
check.ok("exact term", is_match("'ead", "readme"));
check.ok("exact term needs contiguity", !is_match("'rdm", "readme"));
check.ok("prefix", is_match("^rea", "readme"));
check.ok("prefix fails inside", !is_match("^eadm", "readme"));
check.ok("suffix", is_match("me$", "readme"));
check.ok("suffix fails inside", !is_match("ead$", "readme"));
check.ok("negation excludes", !is_match("read !me", "readme"));
check.ok("negation keeps others", is_match("read !xyz", "readme"));
check.ok("terms are ANDed", is_match("src app", "src/MED_app.m31"));
check.ok("one term missing", !is_match("src zzz", "src/MED_app.m31"));
check.ok("non-ASCII", is_match("caf", "Café"));
// ranking prefers boundaries, consecutive runs and shorter names
check.eq_str("consecutive run wins", best_of("app", ["axxpxxp", "MED_app.m31", "xaxpxp"]), "MED_app.m31");
check.eq_str("boundary wins", best_of("fb", ["foobar", "foo_bar", "fxxbxx"]), "foo_bar");
check.eq_str("shorter wins a tie", best_of("a", ["abc", "a"]), "a");
check.eq_str("camel case boundary", best_of("fb", ["fooBar", "foobar"]), "fooBar");
check.ok("score is positive", score_of("a", "a") > 0);
check.ok("gap costs", score_of("ab", "ab") > score_of("ab", "axxxb"));
List<MED_fuzzy.Ranked> everything = MED_fuzzy.rank(MED_fuzzy.parse(""), ["b", "a"], -1);
check.eq_int("empty query keeps all", everything.size(), 2);
check.eq_int("empty query keeps the order", everything[0].item_index, 0);
check.eq_int("limit", MED_fuzzy.rank(MED_fuzzy.parse("a"), ["a", "aa", "aaa"], 2).size(), 2);
// highlight positions
check.eq_str("consecutive positions", joined(MED_fuzzy.parse("app").positions("MED_app.m31")), "4,5,6");
check.eq_str("boundary positions", joined(MED_fuzzy.parse("fb").positions("foo_bar")), "0,4");
check.eq_str("exact positions", joined(MED_fuzzy.parse("'ead").positions("readme")), "1,2,3");
check.eq_str("prefix positions", joined(MED_fuzzy.parse("^re").positions("readme")), "0,1");
check.eq_str("suffix positions", joined(MED_fuzzy.parse("me$").positions("readme")), "4,5");
check.eq_str("no match, no positions", joined(MED_fuzzy.parse("zz").positions("readme")), "");
check.eq_str("two terms merge", joined(MED_fuzzy.parse("sr ap").positions("src/app")), "0,1,4,5");
// a very long candidate takes the greedy path and still matches
str long_text = "x".repeat(300) + "needle";
check.ok("long candidate", is_match("needle", long_text));
check.ok("long candidate, no match", !is_match("needlz", long_text));

// --- paths: the name first (docs/FINDER.md) ---------------------------------------

/// The candidates that match `query` as paths, best first, joined with " | ".
str path_order(str query, List<str> candidates) {
    MED_fuzzy.Ranking ranking = MED_fuzzy.rank_path(MED_fuzzy.parse(query), candidates, [], false, [], -1);
    List<str> names = [];
    for (MED_fuzzy.Ranked one in ranking.top) {
        names.push(candidates[one.item_index]);
    }
    return names.join(" | ");
}

int percent_of(str query, str candidate) {
    return MED_fuzzy.parse(query).match_path(candidate).percent;
}

str scattered = "pxxxxxxoxxxxxxxx_fbdjdk_m";
check.eq_str("pom: pom files, then poxm, then the scattered one", path_order("pom", [scattered, "poxm.txt", "parent/pom.xml", "pom.xml"]), "pom.xml | parent/pom.xml | poxm.txt | " + scattered);
check.eq_str("pom: input order does not matter", path_order("pom", ["pom.xml", "poxm.txt", scattered, "parent/pom.xml"]), "pom.xml | parent/pom.xml | poxm.txt | " + scattered);
check.eq_str("every tier in order", path_order("pom", ["a/b/pxxxxxxoxxxxxxxx_m", "src/po/m.txt", "poxm.txt", "xpomx.txt", "pomelo.txt", "pom.xml", "pom"]), "pom | pom.xml | pomelo.txt | xpomx.txt | poxm.txt | src/po/m.txt | a/b/pxxxxxxoxxxxxxxx_m");
check.eq_str("a name beats a directory", path_order("main", ["main/zzz.txt", "src/main.rs", "docs/maintenance_notes.md"]), "src/main.rs | docs/maintenance_notes.md | main/zzz.txt");
check.eq_str("a typed path suffix wins", path_order("ui/med_app", ["ui/MED_app.m31", "xx/ui/other/MED_app.m31", "ui/MED_application_notes.m31"]), "ui/MED_app.m31 | ui/MED_application_notes.m31 | xx/ui/other/MED_app.m31");
check.eq_str("shorter path breaks a tie", path_order("a", ["dir/dir/a", "a", "dir/a"]), "a | dir/a | dir/dir/a");
check.eq_str("equal candidates keep their input order", path_order("x", ["b/x", "a/x"]), "b/x | a/x");
check.eq_str("non-matching are dropped", path_order("zzq", ["pom.xml", "poxm.txt"]), "");
check.eq_str("negation drops", path_order("pom !parent", ["pom.xml", "parent/pom.xml"]), "pom.xml");
check.eq_str("two terms are ANDed", path_order("src app", ["src/MED_app.m31", "src/other.m31"]), "src/MED_app.m31");
check.eq_str("capital makes it exact", path_order("Pom", ["pom.xml", "POM.xml", "Pom.java"]), "Pom.java");
check.eq_str("empty query keeps all in order", path_order("", ["b", "a"]), "b | a");
check.eq_str("determinism: a second run is identical", path_order("pom", [scattered, "poxm.txt", "parent/pom.xml", "pom.xml"]), path_order("pom", [scattered, "poxm.txt", "parent/pom.xml", "pom.xml"]));
// percentages
check.eq_int("the basename itself is 100", percent_of("pom", "pom"), 100);
check.ok("the stem is a few short of it", percent_of("pom", "pom.xml") < 100 && percent_of("pom", "pom.xml") >= 95);
check.ok("percent falls with the tier", percent_of("pom", "pom.xml") > percent_of("pom", "pomelo.txt") && percent_of("pom", "pomelo.txt") > percent_of("pom", "xpomx.txt") && percent_of("pom", "xpomx.txt") > percent_of("pom", "poxm.txt") && percent_of("pom", "poxm.txt") > percent_of("pom", "src/po/m.txt") && percent_of("pom", "src/po/m.txt") > percent_of("pom", scattered));
check.ok("a scattered match is low but not zero", percent_of("pom", scattered) > 0 && percent_of("pom", scattered) < 30);
check.ok("a shorter name is a closer prefix", percent_of("pom", "pomx") > percent_of("pom", "pom_extra_long.txt"));
check.eq_int("no match, no percent", percent_of("pom", "readme"), 0);
// frecency boosts reorder inside a tier and never across one
List<str> pair = ["pom.xml", "parent/pom.xml"];
MED_fuzzy.Ranking plain = MED_fuzzy.rank_path(MED_fuzzy.parse("pom"), pair, [], false, [], -1);
MED_fuzzy.Ranking boosted = MED_fuzzy.rank_path(MED_fuzzy.parse("pom"), pair, [], false, [0, 150], -1);
check.eq_int("without a boost the shorter is first", plain.top[0].item_index, 0);
check.eq_int("a boost lifts the visited one", boosted.top[0].item_index, 1);
check.ok("and shows in its percent", boosted.top[0].percent > plain.top[1].percent);
MED_fuzzy.Ranking tiers = MED_fuzzy.rank_path(MED_fuzzy.parse("pom"), ["poxm.txt", "pom.xml"], [], false, [150, 0], -1);
check.eq_int("a boost never crosses a tier", tiers.top[0].item_index, 1);
check.eq_int("percent stays at 100", MED_fuzzy.rank_path(MED_fuzzy.parse("pom"), ["pom"], [], false, [150], -1).top[0].percent, 100);
// narrowing: the pool of a shorter query gives the same answer as everything
List<str> tree = ["src/MED_app.m31", "src/MED_fuzzy.m31", "pom.xml", "docs/ROADMAP.md", "apple.txt", "tests/t_app.m31"];
MED_fuzzy.Ranking wide = MED_fuzzy.rank_path(MED_fuzzy.parse("ap"), tree, [], false, [], -1);
MED_fuzzy.Ranking narrow = MED_fuzzy.rank_path(MED_fuzzy.parse("app"), tree, wide.matches, true, [], -1);
MED_fuzzy.Ranking direct = MED_fuzzy.rank_path(MED_fuzzy.parse("app"), tree, [], false, [], -1);
check.eq_int("narrowing finds the same number", narrow.top.size(), direct.top.size());
check.eq_str("narrowing finds the same order", joined_items(narrow.top), joined_items(direct.top));
check.ok("the pool is a superset", wide.matches.size() >= direct.matches.size());
// limits
check.eq_int("limit cuts the list, not the pool", MED_fuzzy.rank_path(MED_fuzzy.parse("a"), tree, [], false, [], 2).top.size(), 2);
check.eq_int("the pool keeps every match", MED_fuzzy.rank_path(MED_fuzzy.parse("a"), tree, [], false, [], 2).matches.size(), 4);
// the byte prefilter never rejects a match
check.ok("prefilter: non-ASCII candidate is never rejected early", MED_fuzzy.parse("cafe").can_match("Caf\u{E9}/x"));
check.ok("prefilter: rejects an impossible ASCII candidate", !MED_fuzzy.parse("zzz").can_match("pom.xml"));
check.ok("prefilter: case folds", MED_fuzzy.parse("pom").can_match("POM.XML"));
check.ok("prefilter: sensitive pattern is exact", !MED_fuzzy.parse("Pom").can_match("pom.xml"));
// the allocation-free byte matcher and the code point matcher give the same answers
List<str> parity_paths = ["pom.xml", "parent/pom.xml", "poxm.txt", "src/MED_app.m31", "foo_bar", "fooBar", "a/b/c/d.txt", "x", "src/main/java/com/Example.java", "README.md", "docs/ROADMAP.md", "pxxxxxxoxxxxxxxx_fbdjdk_m", "ui/MED_picker_view.m31"];
List<str> parity_queries = ["pom", "fb", "app", "e", "rd", "mj", "po m", "^pom", "Pom", "ex", "med", "zz", "src app", "r", "ui/med"];
int parity_bad = 0;
for (str parity_query in parity_queries) {
    MED_fuzzy.Query parity = MED_fuzzy.parse(parity_query);
    for (str parity_path in parity_paths) {
        MED_fuzzy.Match fast = parity.match_path(parity_path);
        MED_fuzzy.Match slow = parity.match_path(parity_path, is_slow: true);
        if (fast.score != slow.score || fast.percent != slow.percent) {
            parity_bad = parity_bad + 1;
            print("parity " + parity_query + " on " + parity_path + ": fast " + fast.score.to_str() + "/" + fast.percent.to_str() + " slow " + slow.score.to_str() + "/" + slow.percent.to_str());
        }
    }
}
check.eq_int("fast and slow path matchers agree", parity_bad, 0);
check.ok("an initialism is a tight match", percent_of("fb", "foo_bar") > percent_of("fb", "fxxxxxxxxxxxxxxxxxbx"));
check.eq_str("an initialism beats a loose one", path_order("fb", ["fxxxxxxxxxxxxxxxxxbx", "foo_bar", "fooBar"]), "fooBar | foo_bar | fxxxxxxxxxxxxxxxxxbx");
check.finish("t_fuzzy");
