/* The system clipboard behind the `+` and `*` registers, through the
 * command line tools nvim uses: pbcopy / pbpaste on macOS, wl-copy /
 * wl-paste, xclip or xsel elsewhere. `os.run` leaves standard output alone,
 * so each call goes through `sh` with a file in between.
 *
 * API */
// ---
/*   MED_clip.detect()           Provider: the first tool pair found, or one that is_absent
 *   MED_clip.did_copy(p, text)  true when the text was handed to the tool
 *   MED_clip.paste(p)           Option<str>: what the tool printed
 *
 * `M3_CLIP_COPY` and `M3_CLIP_PASTE` name the two commands when a
 * machine has others (a copy command reads standard input, a paste command
 * writes standard output). */

import fs;
import io;
import os;
import random;

pub type Provider {
    pub bool is_present = false;
    pub str copy = "";
    pub str paste = "";
    /// Where text goes between this program and the tool.
    pub str scratch = "";
}

bool is_on_path(str name) {
    match (os.run(["sh", "-c", "command -v " + name + " >/dev/null 2>&1"])) {
        case Ok(os.ExitStatus status): {
            return status.is_success();
        }
        case Err(io.Error error): {
            return false;
        }
    }
}

str scratch_name() {
    str base = os.env("TMPDIR").or("/tmp");
    if (base.ends_with("/")) {
        base = base.substr(0, base.size() - 1);
    }
    return base + "/m3-clip-" + random.system().hex(6);
}

void remove_scratch(Provider provider) {
    match (fs.remove(provider.scratch)) {
        case Ok(bool is_removed): {
        }
        case Err(io.Error error): {
        }
    }
}

/// Look for a clipboard tool pair: the environment first, then the usual ones.
pub Provider detect() {
    Provider found = Provider();
    str copy_env = os.env("M3_CLIP_COPY").or("");
    str paste_env = os.env("M3_CLIP_PASTE").or("");
    if (copy_env != "" && paste_env != "") {
        found.is_present = true;
        found.copy = copy_env;
        found.paste = paste_env;
    } else if (is_on_path("pbcopy") && is_on_path("pbpaste")) {
        found.is_present = true;
        found.copy = "pbcopy";
        found.paste = "pbpaste";
    } else if (is_on_path("wl-copy") && is_on_path("wl-paste") && os.env("WAYLAND_DISPLAY").or("") != "") {
        found.is_present = true;
        found.copy = "wl-copy";
        found.paste = "wl-paste --no-newline";
    } else if (is_on_path("xclip") && os.env("DISPLAY").or("") != "") {
        found.is_present = true;
        found.copy = "xclip -quiet -i -selection clipboard";
        found.paste = "xclip -o -selection clipboard";
    } else if (is_on_path("xsel") && os.env("DISPLAY").or("") != "") {
        found.is_present = true;
        found.copy = "xsel --nodetach -i -b";
        found.paste = "xsel -o -b";
    }
    if (found.is_present) {
        found.scratch = scratch_name();
    }
    return found;
}

/// Hand `text` to the copy tool.
pub bool did_copy(Provider provider, str text) {
    if (!provider.is_present) {
        return false;
    }
    match (io.write(provider.scratch, text)) {
        case Ok(int count): {
        }
        case Err(io.Error error): {
            return false;
        }
    }
    bool is_ok = false;
    match (os.run(["sh", "-c", "(" + provider.copy + ") < '" + provider.scratch + "' >/dev/null 2>&1"])) {
        case Ok(os.ExitStatus status): {
            is_ok = status.is_success();
        }
        case Err(io.Error error): {
            is_ok = false;
        }
    }
    remove_scratch(provider);
    return is_ok;
}

/// What the paste tool prints.
pub Option<str> paste(Provider provider) {
    if (!provider.is_present) {
        return Option<str>.None;
    }
    match (os.run(["sh", "-c", "(" + provider.paste + ") > '" + provider.scratch + "' 2>/dev/null"])) {
        case Ok(os.ExitStatus status): {
            if (!status.is_success()) {
                remove_scratch(provider);
                return Option<str>.None;
            }
        }
        case Err(io.Error error): {
            return Option<str>.None;
        }
    }
    match (io.read(provider.scratch)) {
        case Ok(str text): {
            remove_scratch(provider);
            return Option<str>.Some(text);
        }
        case Err(io.Error error): {
            return Option<str>.None;
        }
    }
}
