/* The picker's state machine: a prompt, a ranked list and a selection. No
 * drawing and no I/O; the front end fills `entries`, feeds keys, and carries
 * out the result.
 *
 * Kinds: files, buffers, grep (the prompt is the search, not a filter),
 * commands (the palette), help (the keymap), explore (one directory), marks,
 * and list (everything else: recent files, lines, quickfix, git branches and
 * commits, symbols ... an entry has a file position or an action).
 *
 * Keys (engine key codes): printable characters edit the prompt; Backspace,
 * CTRL-U (clear) and CTRL-W (word) delete; Down/CTRL-N/CTRL-J and Up/CTRL-P/
 * CTRL-K move; PageUp/PageDown jump a page; Enter accepts; Esc/CTRL-C/CTRL-G
 * cancel; CTRL-H toggles hidden files, Tab (CTRL-I) toggles the ignore rules,
 * CTRL-F toggles fixed-string grep; CTRL-T marks or unmarks the entry (and moves
 * on), CTRL-Q sends the marked entries (all shown ones when none is marked) to
 * the quickfix list; CTRL-S / CTRL-V accept into a new window
 * below / beside (files, buffers, grep). In the explorer `-` on an empty prompt goes
 * up a directory. */

import ui.MED_frecency;
import ui.MED_fuzzy;
import engine.MED_key;

pub const int KIND_FILES = 0;
pub const int KIND_BUFFERS = 1;
pub const int KIND_GREP = 2;
pub const int KIND_COMMANDS = 3;
pub const int KIND_HELP = 4;
pub const int KIND_EXPLORE = 5;
pub const int KIND_MARKS = 6;
pub const int KIND_LIST = 7;
/// Most rows ranked and kept (the list shows a window of them).
const int MAX_SHOWN = 5000;
const int PAGE = 10;

pub type Entry {
    /// What is shown and matched.
    pub str text;
    /// The file, for files, grep and explorer entries.
    pub str path = "";
    /// The 0-based line and byte column of a grep hit.
    pub int line = 0;
    pub int column = 0;
    /// The buffer number of a buffer entry.
    pub int id = 0;
    /// The action of a palette or help entry.
    pub str action = "";
    /// What the preview asks for when it is not a file (a commit hash).
    pub str detail = "";
}

pub enum Outcome {
    Stay;
    Accept;
    Cancel;
    /// The grep prompt changed: search again.
    Requery;
    /// A toggle changed which files exist: list them again.
    Reload;
    /// The explorer goes up one directory.
    Up;
    /// Accept, opening the entry in a new window below (CTRL-S) or right (CTRL-V).
    AcceptSplit;
    AcceptVsplit;
    /// CTRL-Q: the marked entries go to the quickfix list.
    Quickfix;
}

pub int Outcome.code() {
    match (this) {
        case Stay: {
            return 0;
        }
        case Accept: {
            return 1;
        }
        case Cancel: {
            return 2;
        }
        case Requery: {
            return 3;
        }
        case Reload: {
            return 4;
        }
        case Up: {
            return 5;
        }
        case AcceptSplit: {
            return 6;
        }
        case AcceptVsplit: {
            return 7;
        }
        case Quickfix: {
            return 8;
        }
    }
}

pub bool Outcome.eq(Outcome other) {
    return code() == other.code();
}

pub type Picker {
    pub int kind = 0;
    pub str title = "";
    pub List<Entry> entries = [];
    /// Indices into `entries`, best first.
    pub List<int> shown = [];
    pub str query = "";
    pub int selected = 0;
    pub int top = 0;
    /// A narrow box on the left that leaves the text visible (the theme picker).
    pub bool is_side = false;
    pub bool is_hidden_shown = false;
    pub bool is_ignore_used = true;
    pub bool is_fixed = false;
    /// The explorer's directory ("" for the others).
    pub str directory = "";
    /// Indices into `entries` marked with CTRL-T.
    pub List<int> marked = [];
    /// A source is still delivering entries.
    pub bool is_loading = false;
    /// Entries arrived that the ranking does not include yet.
    pub bool is_dirty = false;
    /** The entries are file paths: ranked by file name first, with a relevance
     * percentage per row and frecency (files, recent files). */
    pub bool is_path = false;
    /// Show the relevance percentage and frecency marker (`:set nofinderscore` hides them).
    pub bool is_score_shown = true;
    /** Frecency per entry: heat in thousandths and the epoch second of the last visit
     * (empty, or shorter than `entries`, for entries never visited). */
    pub List<int> heat = [];
    pub List<int> recency = [];
    /// The ranking boost of each entry, from its heat (kept in step by `set_frecency`).
    pub List<int> boosts = [];
    /// Relevance 0 to 100 of each shown row (path pickers with a prompt; else empty).
    pub List<int> percents = [];
    /// The entry texts, kept beside `entries` so a keystroke does not rebuild them.
    pub List<str> texts = [];
    /** Every entry the last ranking matched, and the prompt it was for: a longer prompt
     * of the same kind only looks at these. */
    pub List<int> pool = [];
    pub bool has_pool = false;
    pub str pool_query = "";
    /// Typing ranks once per batch of keys (the front end calls `refresh`), not per key.
    pub bool is_deferred = false;
    pub bool is_stale = false;
}

/// The entries CTRL-Q sends: the marked ones, or every shown one.
pub List<Entry> Picker.chosen() {
    List<Entry> out = [];
    if (marked.size() > 0) {
        for (int index in marked) {
            if (index < entries.size()) {
                out.push(entries[index]);
            }
        }
        return out;
    }
    for (int index in shown) {
        out.push(entries[index]);
    }
    return out;
}

/// Whether the prompt is a filter over `entries` (every kind but grep).
pub bool Picker.is_filter() {
    return kind != KIND_GREP;
}

/// Replace the entries and rank them again.
pub void Picker.set_entries(List<Entry> fresh) {
    entries = fresh;
    texts = [];
    for (Entry entry in fresh) {
        texts.push(entry.text);
    }
    has_pool = false;
    marked = [];
    heat = [];
    recency = [];
    boosts = [];
    refilter();
}

/** Frecency for the entries: heat (thousandths) and last visit per entry, in order
 * (call it after `set_entries`, which forgets any). Ranks again. */
pub void Picker.set_frecency(List<int> fresh_heat, List<int> fresh_recency) {
    heat = fresh_heat;
    recency = fresh_recency;
    boosts = [];
    for (int one in fresh_heat) {
        boosts.push(MED_frecency.boost_of(one));
    }
    has_pool = false;
    refilter();
}

/// Whether entry `index` is frecent enough to be marked in the list.
pub bool Picker.is_frecent(int index) {
    return index < boosts.size() && boosts[index] >= MED_frecency.MARK_FROM;
}

/** Whether a longer prompt can be answered from the matches of the shorter one: it
 * extends it, and neither has a negation (which a longer term can relax) or a `$` (which
 * a longer term moves). */
pub bool Picker.can_narrow(str typed) {
    if (!has_pool || pool_query.size() == 0 || !typed.starts_with(pool_query)) {
        return false;
    }
    return !typed.contains("!") && !typed.contains("$");
}

/// Rank the entries by the prompt, keeping the selection on the first row.
pub void Picker.refilter() {
    is_dirty = false;
    is_stale = false;
    shown = [];
    percents = [];
    selected = 0;
    top = 0;
    if (!is_filter()) {
        has_pool = false;
        for (int index in 0 .. entries.size()) {
            if (index >= MAX_SHOWN) {
                break;
            }
            shown.push(index);
        }
        return;
    }
    MED_fuzzy.Query parsed = MED_fuzzy.parse(query);
    if (parsed.is_empty()) {
        has_pool = false;
        if (is_path && heat.size() > 0) {
            list_by_heat();
            return;
        }
        for (int index in 0 .. entries.size()) {
            if (index >= MAX_SHOWN) {
                break;
            }
            shown.push(index);
        }
        return;
    }
    if (is_path) {
        bool is_narrowed = can_narrow(query);
        MED_fuzzy.Ranking ranking = MED_fuzzy.rank_path(parsed, texts, pool, is_narrowed, boosts, MAX_SHOWN);
        for (MED_fuzzy.Ranked ranked in ranking.top) {
            shown.push(ranked.item_index);
            percents.push(ranked.percent);
        }
        pool = ranking.matches;
        has_pool = true;
        pool_query = query;
        return;
    }
    for (MED_fuzzy.Ranked ranked in MED_fuzzy.rank(parsed, texts, MAX_SHOWN)) {
        shown.push(ranked.item_index);
    }
}

/** The empty prompt of a path picker: files that were visited first (by heat, then
 * recency), then the rest in the order the source gave. */
void Picker.list_by_heat() {
    List<Hot> hot = [];
    List<bool> is_taken = [false; entries.size()];
    for (int index in 0 .. heat.size()) {
        if (index < entries.size() && heat[index] > 0) {
            int stamp = 0;
            if (index < recency.size()) {
                stamp = recency[index];
            }
            hot.push(Hot(index, heat[index], stamp));
        }
    }
    hot.sort();
    for (Hot one in hot) {
        if (shown.size() >= MAX_SHOWN) {
            return;
        }
        shown.push(one.index);
        is_taken[one.index] = true;
    }
    for (int index in 0 .. entries.size()) {
        if (shown.size() >= MAX_SHOWN) {
            return;
        }
        if (!is_taken[index]) {
            shown.push(index);
        }
    }
}

/// Rank now if keys changed the prompt since the last ranking (`is_deferred`).
pub void Picker.refresh() {
    if (is_stale) {
        refilter();
    }
}

/** Add entries from a source that is still delivering. With an empty prompt
 * they are listed at once and the selection stays; with a prompt `is_dirty`
 * says the ranking is stale (the front end ranks again at a calm moment). */
pub void Picker.append(List<Entry> batch) {
    bool is_listed_directly = !is_filter() || MED_fuzzy.parse(query).is_empty();
    for (Entry entry in batch) {
        entries.push(entry);
        texts.push(entry.text);
        if (is_listed_directly && shown.size() < MAX_SHOWN) {
            shown.push(entries.size() - 1);
        }
    }
    if (batch.size() > 0) {
        has_pool = false;
    }
    if (!is_listed_directly && batch.size() > 0) {
        is_dirty = true;
    }
}

pub int Picker.count() {
    return shown.size();
}

/// The selected entry; `None` when nothing matches.
pub Option<Entry> Picker.current() {
    if (selected < 0 || selected >= shown.size()) {
        return Option<Entry>.None;
    }
    return Option<Entry>.Some(entries[shown[selected]]);
}

/// Move the selection by `step`, clamped to the list.
void Picker.move(int step) {
    selected = selected + step;
    if (selected >= shown.size()) {
        selected = shown.size() - 1;
    }
    if (selected < 0) {
        selected = 0;
    }
}

/// Scroll so the selection is inside a window of `rows` rows.
pub void Picker.scroll_to(int rows) {
    if (rows < 1) {
        return;
    }
    if (selected < top) {
        top = selected;
    }
    if (selected >= top + rows) {
        top = selected - rows + 1;
    }
}

/// The prompt changed: filter again, or ask for a new grep.
Outcome Picker.edited() {
    if (is_filter()) {
        if (is_deferred) {
            is_stale = true;
        } else {
            refilter();
        }
        return Outcome.Stay;
    }
    return Outcome.Requery;
}

/// One key.
pub Outcome Picker.feed(int key) {
    if (is_stale && !is_text_key(key)) {
        refresh();
    }
    if (key == MED_key.ESC || key == 3 || key == 7) {
        return Outcome.Cancel;
    }
    if (key == MED_key.CARRIAGE_RETURN) {
        return Outcome.Accept;
    }
    if (key == 19) {
        return Outcome.AcceptSplit;
    }
    if (key == 22) {
        return Outcome.AcceptVsplit;
    }
    if (key == MED_key.DOWN || key == 14 || key == 10) {
        move(1);
        return Outcome.Stay;
    }
    if (key == MED_key.UP_KEY || key == 16 || key == 11) {
        move(-1);
        return Outcome.Stay;
    }
    if (key == MED_key.PAGE_DOWN) {
        move(PAGE);
        return Outcome.Stay;
    }
    if (key == MED_key.PAGE_UP) {
        move(-PAGE);
        return Outcome.Stay;
    }
    if (key == MED_key.HOME) {
        selected = 0;
        return Outcome.Stay;
    }
    if (key == MED_key.END) {
        move(shown.size());
        return Outcome.Stay;
    }
    if (key == MED_key.BACKSPACE) {
        if (query.size() == 0) {
            return Outcome.Stay;
        }
        query = without_last_char(query);
        return edited();
    }
    if (key == 21) {
        query = "";
        return edited();
    }
    if (key == 23) {
        query = without_last_word(query);
        return edited();
    }
    if (key == MED_key.CTRL_H) {
        is_hidden_shown = !is_hidden_shown;
        return Outcome.Reload;
    }
    if (key == MED_key.TAB) {
        is_ignore_used = !is_ignore_used;
        return Outcome.Reload;
    }
    if (key == 20) {
        if (selected >= 0 && selected < shown.size()) {
            int index = shown[selected];
            if (marked.contains(index)) {
                List<int> kept = [];
                for (int one in marked) {
                    if (one != index) {
                        kept.push(one);
                    }
                }
                marked = kept;
            } else {
                marked.push(index);
            }
            move(1);
        }
        return Outcome.Stay;
    }
    if (key == 17) {
        return Outcome.Quickfix;
    }
    if (key == 6) {
        is_fixed = !is_fixed;
        if (kind == KIND_GREP) {
            return Outcome.Requery;
        }
        return Outcome.Stay;
    }
    if (key == 45 && kind == KIND_EXPLORE && query.size() == 0) {
        return Outcome.Up;
    }
    if (key >= 32 && key != 127 && key < MED_key.UP_KEY) {
        query = query + str.from_chars([key]);
        return edited();
    }
    return Outcome.Stay;
}

/// A heat in the sort: the hottest entry first, the most recently visited among equals.
type Hot {
    int index;
    int heat;
    int stamp;
}

int Hot.cmp(Hot other) {
    if (heat != other.heat) {
        if (heat > other.heat) {
            return -1;
        }
        return 1;
    }
    if (stamp != other.stamp) {
        if (stamp > other.stamp) {
            return -1;
        }
        return 1;
    }
    if (index < other.index) {
        return -1;
    }
    if (index > other.index) {
        return 1;
    }
    return 0;
}

/// Whether `key` edits the prompt (so ranking can wait for the next key).
bool is_text_key(int key) {
    if (key == MED_key.BACKSPACE || key == 21 || key == 23) {
        return true;
    }
    return key >= 32 && key != 127 && key < MED_key.UP_KEY;
}

pub Picker make(int kind, str title) {
    return Picker(kind: kind, title: title, is_path: kind == KIND_FILES);
}

/// Delete the last word of the prompt (and the blanks before it).
str without_last_word(str text) {
    List<int> chars = text.chars();
    int stop = chars.size();
    while (stop > 0 && chars[stop - 1] == 32) {
        stop = stop - 1;
    }
    while (stop > 0 && chars[stop - 1] != 32) {
        stop = stop - 1;
    }
    return str.from_chars(chars.slice(0, stop));
}

str without_last_char(str text) {
    List<int> chars = text.chars();
    return str.from_chars(chars.slice(0, chars.size() - 1));
}
