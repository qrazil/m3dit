/* Drawing a picker: a bordered box over the text with the prompt on top, the
 * ranked list under it (matched characters highlighted) and, when the box is
 * wide enough, a preview of the selected file on the right. */

import tui.core.TUI_buffer;
import tui.core.TUI_geometry;
import tui.core.TUI_style;
import tui.core.TUI_text;
import tui.core.TUI_widget;
import ui.MED_theme;
import ui.MED_fuzzy;
import ui.MED_picker;

/// The box needs this much width for a preview pane beside the list.
const int PREVIEW_MIN_WIDTH = 100;
/// The width of a side picker (the theme picker), which leaves the text visible.
const int SIDE_WIDTH = 36;
/// Rows of the screen left uncovered below the box (status and command line).
const int FOOTER = 2;

/** The preview pane's text: lines of a file from `first`, with `focus` (a line
 * index, or -1) marked. */
pub type Preview {
    pub str title = "";
    pub List<str> lines = [];
    pub int first = 0;
    pub int focus = -1;
    /** The preview pane has been shown for this picker: it keeps its place (an empty
     * pane) when a query has no match, so the list does not jump between widths. */
    pub bool is_pane = false;
}

/// The box a picker occupies in `area`.
pub TUI_geometry.Rect box_of(TUI_geometry.Rect area, bool is_side = false) {
    int margin_x = 2;
    if (area.width < 50) {
        margin_x = 0;
    }
    int height = area.height - FOOTER - 1;
    if (height < 5) {
        height = area.height - FOOTER;
    }
    if (is_side && area.width >= 70) {
        return TUI_geometry.Rect(area.x + margin_x, area.y, SIDE_WIDTH, height);
    }
    return TUI_geometry.Rect(area.x + margin_x, area.y, area.width - margin_x * 2, height);
}

/// The rows of the list inside the box (for scrolling and mouse picking).
pub int list_rows(TUI_geometry.Rect area) {
    int rows = box_of(area).height - 3;
    if (rows < 1) {
        return 1;
    }
    return rows;
}

/** Draw `text` with the characters at `matched` (code point indices) highlighted,
 * `max` columns at most. It goes one grapheme cluster at a time: a combining mark, a
 * joiner or a flag is part of the cell before it, not a cell of its own, and a
 * two-column cluster that does not fit is left out whole. */
void draw_matched(TUI_buffer.Buffer buffer, int x, int y, str text, List<int> matched, TUI_style.Style base, TUI_style.Style hot, int max) {
    int spot = x;
    int index = 0;
    for (str cluster in TUI_text.clusters(text)) {
        int width = TUI_text.width(cluster);
        int length = cluster.chars().size();
        if (spot - x + width > max) {
            break;
        }
        TUI_style.Style style = base;
        for (int step in 0 .. length) {
            if (matched.contains(index + step)) {
                style = hot;
            }
        }
        buffer.set_str(spot, y, cluster, style, max: max - (spot - x));
        spot = spot + width;
        index = index + length;
    }
}

/// The columns the score column takes at the right of a row: a marker and "100%".
const int SCORE_WIDTH = 5;

/// `text` padded with blanks on the left to `width` columns.
pub str pad_left(str text, int width) {
    int missing = width - TUI_text.width(text);
    if (missing <= 0) {
        return text;
    }
    return " ".repeat(missing) + text;
}

/// The score column of one row: `*` when the file is frecent, then the relevance.
pub str score_label(MED_picker.Picker picker, int rank) {
    str star = " ";
    if (picker.is_frecent(picker.shown[rank])) {
        star = "*";
    }
    if (rank < picker.percents.size()) {
        return star + pad_left(picker.percents[rank].to_str() + "%", SCORE_WIDTH - 1);
    }
    return star + " ".repeat(SCORE_WIDTH - 1);
}

void draw_list(TUI_buffer.Buffer buffer, TUI_geometry.Rect rect, MED_picker.Picker picker, MED_theme.Theme theme) {
    MED_fuzzy.Query query = MED_fuzzy.parse(picker.query);
    TUI_style.Style plain = theme.look("ui.picker");
    TUI_style.Style chosen = theme.over("ui.picker", "ui.picker.selected");
    TUI_style.Style plain_hot = theme.over("ui.picker", "ui.picker.match");
    TUI_style.Style chosen_hot = chosen.merged(theme.style("ui.picker.match"));
    TUI_style.Style faint = theme.over("ui.picker", "ui.text.inactive");
    bool is_scored = picker.is_path && picker.is_score_shown && rect.width >= 24;
    int text_width = rect.width - 2;
    if (is_scored) {
        text_width = text_width - SCORE_WIDTH - 2;
    }
    for (int row in 0 .. rect.height) {
        int rank = picker.top + row;
        if (rank >= picker.shown.size()) {
            break;
        }
        MED_picker.Entry entry = picker.entries[picker.shown[rank]];
        int y = rect.y + row;
        TUI_style.Style style = plain;
        TUI_style.Style hot = plain_hot;
        str marker = "  ";
        if (picker.marked.contains(picker.shown[rank])) {
            marker = "* ";
        }
        if (rank == picker.selected) {
            style = chosen;
            hot = chosen_hot;
            marker = "> ";
            if (picker.marked.contains(picker.shown[rank])) {
                marker = ">*";
            }
            buffer.fill(TUI_geometry.Rect(rect.x, y, rect.width, 1), " ", chosen);
        }
        buffer.set_str(rect.x, y, marker, style, max: rect.width);
        List<int> matched = [];
        if (picker.is_filter()) {
            matched = query.positions(entry.text);
        }
        draw_matched(buffer, rect.x + 2, y, entry.text, matched, style, hot, text_width);
        if (is_scored) {
            TUI_style.Style score_style = faint;
            if (rank == picker.selected) {
                score_style = chosen;
            }
            buffer.set_str(rect.x + rect.width - SCORE_WIDTH - 2, y, " " + score_label(picker, rank), score_style, max: SCORE_WIDTH + 1);
        }
    }
}

void draw_preview(TUI_buffer.Buffer buffer, TUI_geometry.Rect rect, Preview preview, MED_theme.Theme theme) {
    TUI_style.Style dim = theme.over("ui.picker", "ui.linenr");
    TUI_style.Style focus = theme.over("ui.picker", "ui.picker.selected");
    TUI_style.Style plain = theme.look("ui.picker");
    buffer.set_str(rect.x, rect.y, TUI_text.truncate(preview.title, rect.width), theme.over("ui.picker", "ui.picker.title"), max: rect.width);
    for (int row in 1 .. rect.height) {
        int index = preview.first + row - 1;
        if (index >= preview.lines.size()) {
            break;
        }
        int y = rect.y + row;
        str number = (index + 1).to_str();
        str gutter = " ".repeat(4 - number.size()) + number + " ";
        if (number.size() > 4) {
            gutter = number + " ";
        }
        TUI_style.Style style = plain;
        if (index == preview.focus) {
            style = focus;
            buffer.fill(TUI_geometry.Rect(rect.x, y, rect.width, 1), " ", focus);
        }
        buffer.set_str(rect.x, y, gutter, dim, max: rect.width);
        str text = preview.lines[index];
        buffer.set_str(rect.x + gutter.size(), y, text, style, max: rect.width - gutter.size());
    }
}

/// Draw the picker in `area`.
pub void render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area, MED_picker.Picker picker, Preview preview, MED_theme.Theme theme) {
    TUI_geometry.Rect box = box_of(area, is_side: picker.is_side);
    TUI_style.Style plain = theme.look("ui.picker");
    TUI_style.Style faint = theme.over("ui.picker", "ui.text.inactive");
    buffer.fill(box, " ", plain);
    str title = " " + picker.title + " " + picker.shown.size().to_str() + "/" + picker.entries.size().to_str() + " ";
    if (picker.is_loading) {
        title = " " + picker.title + " " + picker.shown.size().to_str() + "/" + picker.entries.size().to_str() + " ... ";
    }
    if (picker.marked.size() > 0) {
        title = title + "[" + picker.marked.size().to_str() + " marked] ";
    }
    TUI_widget.Block block = TUI_widget.Block(title: title, borders: TUI_widget.Borders.Rounded, style: plain, title_style: theme.over("ui.picker", "ui.picker.title"), pad_x: 1);
    block.render(buffer, box);
    TUI_geometry.Rect inner = block.inner(box);
    if (inner.height < 2 || inner.width < 4) {
        return;
    }
    buffer.set_str(inner.x, inner.y, "> " + picker.query, theme.over("ui.picker", "ui.prompt"), max: inner.width);
    int cursor_x = inner.x + 2 + TUI_text.width(picker.query);
    if (cursor_x < inner.x + inner.width) {
        buffer.set_style(cursor_x, inner.y, theme.cursor("normal"));
    }
    draw_hints(buffer, box, picker, faint);
    TUI_geometry.Rect body = TUI_geometry.Rect(inner.x, inner.y + 2, inner.width, inner.height - 2);
    if (body.height < 1) {
        return;
    }
    buffer.fill(TUI_geometry.Rect(inner.x, inner.y + 1, inner.width, 1), "\u{2500}", faint);
    if (preview.title.size() > 0) {
        preview.is_pane = true;
    }
    if (inner.width >= PREVIEW_MIN_WIDTH && preview.is_pane) {
        int list_width = inner.width * 2 / 5;
        draw_list(buffer, TUI_geometry.Rect(body.x, body.y, list_width, body.height), picker, theme);
        for (int row in 0 .. body.height) {
            buffer.set_str(body.x + list_width, body.y + row, "\u{2502}", faint);
        }
        draw_preview(buffer, TUI_geometry.Rect(body.x + list_width + 2, body.y, inner.width - list_width - 2, body.height), preview, theme);
    } else {
        draw_list(buffer, body, picker, theme);
    }
}

str flag(bool is_on) {
    if (is_on) {
        return "on";
    }
    return "off";
}

/** `line` with each tab expanded to the next multiple of `stops` columns (clusters are
 * measured in columns, so a wide character moves the next stop), cut after `limit`
 * columns: a preview line is only ever drawn that far, and a minified file may have a
 * single line of megabytes. */
pub str expand_tabs(str line, int stops, int limit) {
    if (!line.contains("\t") && line.size() <= limit) {
        return line;
    }
    List<str> out = [];
    int column = 0;
    for (str cluster in TUI_text.clusters(line)) {
        if (column >= limit) {
            break;
        }
        if (cluster == "\t") {
            int spaces = stops - column % stops;
            out.push(" ".repeat(spaces));
            column = column + spaces;
        } else {
            out.push(cluster);
            column = column + TUI_text.width(cluster);
        }
    }
    return out.join("");
}

/// The key hints for this picker, most useful first. `hint_text` drops what does not fit.
pub List<str> hints_for(MED_picker.Picker picker) {
    List<str> items = [];
    if (picker.is_side) {
        return items;
    }
    int kind = picker.kind;
    if (kind == MED_picker.KIND_COMMANDS) {
        items.push("Enter run");
    } else if (kind == MED_picker.KIND_HELP || kind == MED_picker.KIND_MARKS) {
        items.push("Enter select");
    } else {
        items.push("Enter open");
        items.push("^S split");
        items.push("^V vsplit");
    }
    if (kind == MED_picker.KIND_EXPLORE) {
        items.push("- up");
    }
    if (kind == MED_picker.KIND_FILES || kind == MED_picker.KIND_GREP || kind == MED_picker.KIND_LIST) {
        items.push("^T mark");
        if (picker.marked.size() > 0 || kind == MED_picker.KIND_GREP || kind == MED_picker.KIND_LIST) {
            items.push("^Q quickfix");
        }
    }
    if (kind == MED_picker.KIND_FILES || kind == MED_picker.KIND_GREP) {
        items.push("^H hidden:" + flag(picker.is_hidden_shown));
        items.push("Tab ignore:" + flag(picker.is_ignore_used));
    }
    if (kind == MED_picker.KIND_GREP) {
        items.push("^F fixed:" + flag(picker.is_fixed));
    }
    items.push("^L redraw");
    items.push("Esc close");
    return items;
}

/// The hints joined with two spaces, as many as fit in `columns`.
pub str hint_text(List<str> items, int columns) {
    str out = "";
    for (str item in items) {
        str next = item;
        if (out.size() > 0) {
            next = out + "  " + item;
        }
        if (TUI_text.width(next) > columns) {
            break;
        }
        out = next;
    }
    return out;
}

/// The hint line: on the bottom edge of the box, dim, in the border row, never in the list.
void draw_hints(TUI_buffer.Buffer buffer, TUI_geometry.Rect box, MED_picker.Picker picker, TUI_style.Style faint) {
    if (box.height < 5 || box.width < 14) {
        return;
    }
    str line = hint_text(hints_for(picker), box.width - 6);
    if (line.size() == 0) {
        return;
    }
    buffer.set_str(box.x + 2, box.y + box.height - 1, " " + line + " ", faint, max: box.width - 4);
}
