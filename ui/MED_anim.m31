// Motion: the pure part. Nothing here touches a terminal, an editor or a
// clock: every function is given the time (monotonic nanoseconds) and the
// state it works on, so a test can drive it with a made-up clock and get the
// same frames every time.
//
// What moves, and the one rule behind all of it: **an animation is only ever a
// path to a state the editor already computed.** The engine decides the final
// state (where the window's top line is, where the cursor is) exactly as it
// does with animation off; this module only decides what to draw on the way
// there, and the last frame is always the engine's own. So an animation can
// make a scroll take 100 ms; it can never make it end somewhere else.
//
//   Scroll   the window's top line chases the engine's top line. Each frame
//            closes a fixed share of what is left (an exponential ease-out,
//            `tau_ms`), so a long jump is quick at first and settles softly, a
//            second scroll while the first is running just moves the goal (no
//            restart, no jump in speed), a mouse wheel's burst of notches
//            accumulates, and the whole thing is over in about 100-150 ms
//            whatever the distance (a hard cap, `max_ms`, lands it exactly).
//   Pacer    watches how long frames take to draw and slows the animation down,
//            or switches it off, on a terminal (or ssh link) that cannot keep up.
//   blend    colour mixing in a gamma-2 space (the average of two sRGB colours
//            is too dark if the channels are averaged as they are), for fades
//            and flashes in 24-bit colour.
//
// Display rows follow the animated top (`clamp_row`) with 'scrolloff' kept at
// every frame, so the cursor line slides with the text instead of vanishing
// off the edge and reappearing.

import math;
import timer;
import tui.core.TUI_buffer;
import tui.core.TUI_geometry;
import tui.core.TUI_style;

/// Monotonic nanoseconds: the clock every animation reads.
pub int now_ns() {
    return timer.monotonic_ns();
}

pub const int NS_PER_MS = 1000000;
/// How far into its first frame a new scroll starts, in ms.
pub const int PRIME_MS = 12;
/// A scroll of fewer lines than this is not animated: j and k stay instant.
pub const int MIN_SCROLL_LINES = 2;

// ----------------------------------------------------------------- settings

/// The switches (`:set animate`, `animatetime`, `animatescroll`, `animatefade`,
/// `animateflash`), plus what the terminal can do. Built by the front end from
/// the options and the environment, once per frame.
pub type Config {
    /// `animate`: the master switch.
    pub bool is_on = true;
    pub bool is_scroll = true;
    pub bool is_fade = true;
    pub bool is_flash = true;
    /// `animatetime`: about how long a scroll takes to settle, in ms.
    pub int time_ms = 100;
    /// 24-bit colour: colour fades only run when it is true.
    pub bool is_truecolour = false;
    /// The terminal is a dark one (decides what "default" colours blend with).
    pub bool is_dark = true;
}

/// The time constant of the scroll ease-out for an `animatetime`: the time to
/// settle is about `tau * ln(distance * 2)`, ~4 time constants for 30 lines.
pub int tau_for(int time_ms) {
    int tau = time_ms / 4;
    if (tau < 8) {
        return 8;
    }
    if (tau > 60) {
        return 60;
    }
    return tau;
}

// ---------------------------------------------------------------- scrolling

/// The scroll of one window. The front end calls `observe` for the active
/// window every frame with the top line the engine settled on; `observe` answers
/// the top line to draw.
pub type Scroll {
    /// A scroll is under way: the next frame is due.
    pub bool is_active = false;
    /// What was scrolled last frame (window and buffer, as one number): a
    /// different one starts over rather than animating between two documents.
    pub int key = -1;
    /// The buffer's change counter last frame: an edit is shown at once.
    pub int version = -1;
    /// The engine's top line last frame.
    pub int seen_top = 0;
    /// The engine's top line now: where the animation is going.
    pub int target = 0;
    /// Where it is, in lines (fractional between frames).
    pub float position = 0.0;
    /// The top line to draw: `position` rounded.
    pub int shown = 0;
    /// When `position` was last brought up to date, and when this run began.
    pub int clock_ns = 0;
    pub int started_ns = 0;
    /// How many lines the window shows, for capping a long jump.
    pub int rows = 1;
    pub int tau_ms = 25;
    pub int max_ms = 160;
}

/// Stop and forget nothing but the animation: the next frame shows the engine's
/// state (`observe` returns the target).
pub void Scroll.stop() {
    is_active = false;
    position = float(target);
    shown = target;
}

/// The goal moved to `top`, `now` being the time. Starts an animation from the
/// line last drawn (`shown`, which is the old goal when nothing was running), or
/// redirects the one that is running.
void Scroll.aim(int top, int now) {
    bool is_fresh = !is_active;
    if (!is_active) {
        position = float(shown);
        started_ns = now;
        // the first frame is already one frame in, so the key shows movement at once
        clock_ns = now - PRIME_MS * NS_PER_MS;
    } else {
        did_advance(now);
    }
    target = top;
    is_active = true;
    // A very long jump starts one and a bit screens away: the last stretch is
    // the animation, the rest of the distance would be a blur.
    float cap = float(rows + rows / 4 + 1);
    float distance = float(target) - position;
    if (distance > cap) {
        position = float(target) - cap;
    } else if (distance < -cap) {
        position = float(target) + cap;
    }
    shown = round_to_int(position);
    if (shown == target) {
        stop();
    } else if (is_fresh) {
        // step into the first frame now: the key shows movement at once
        did_advance(now);
    }
}

/// Bring `position` up to `now`. True when the line to draw changed, or the animation
/// ended, so a frame is worth drawing.
pub bool Scroll.did_advance(int now) {
    if (!is_active) {
        return false;
    }
    int before = shown;
    int elapsed = now - clock_ns;
    if (elapsed < 0) {
        elapsed = 0;
    }
    clock_ns = now;
    float remaining = float(target) - position;
    if (now - started_ns >= max_ms * NS_PER_MS) {
        // the hard cap: land exactly
        stop();
        return true;
    }
    float decay = math.exp(-(float(elapsed) / float(tau_ms * NS_PER_MS)));
    position = float(target) - remaining * decay;
    float left = float(target) - position;
    if (left < 0.0) {
        left = -left;
    }
    if (left < 0.5) {
        stop();
        return true;
    }
    shown = round_to_int(position);
    return shown != before;
}

/// The engine settled on top line `top` for window/buffer `new_key` whose text
/// is at `new_version`; `rows` is the window's height. Returns the top line to
/// draw. `is_allowed` false (animation off, a macro replaying, input queued,
/// paste...) shows `top` at once and ends any animation in progress. A change of
/// window or buffer, or of the text, also shows `top` at once. A move of fewer
/// than `MIN_SCROLL_LINES` is instant too, unless an animation is already
/// running, which it simply redirects.
pub int Scroll.observe(int new_key, int new_version, int top, int new_rows, bool is_allowed, int now) {
    rows = new_rows;
    bool is_same = new_key == key && new_version == version;
    key = new_key;
    version = new_version;
    if (!is_same || !is_allowed) {
        seen_top = top;
        target = top;
        stop();
        return top;
    }
    if (top != seen_top) {
        int moved = top - seen_top;
        if (moved < 0) {
            moved = -moved;
        }
        seen_top = top;
        if (is_active || moved >= MIN_SCROLL_LINES) {
            aim(top, now);
        } else {
            target = top;
            stop();
        }
    } else if (is_active) {
        did_advance(now);
    }
    if (is_active) {
        return shown;
    }
    return top;
}

/// The goal: the engine's top line, as `Scroll` last saw it.
pub int Scroll.goal() {
    return target;
}

/// `x` rounded to the nearest int (halves away from zero).
pub int round_to_int(float x) {
    if (x >= 0.0) {
        return int(x + 0.5);
    }
    return -int(0.5 - x);
}

/// The row to draw the cursor on while the window shows `top`: the engine's row
/// when it is inside the window honouring `margin` lines of 'scrolloff' (fewer at
/// the start and end of the buffer, where the window cannot scroll further),
/// else the nearest row that does.
pub int clamp_row(int row, int top, int rows, int margin, int line_count) {
    int low = top + margin;
    if (top == 0) {
        low = 0;
    }
    int high = top + rows - 1 - margin;
    if (top + rows >= line_count) {
        high = line_count - 1;
    }
    if (high < low) {
        // a margin too big for the window: the middle
        return top + (rows - 1) / 2;
    }
    if (row < low) {
        return low;
    }
    if (row > high) {
        return high;
    }
    return row;
}

// ------------------------------------------------------------------- pacing

/// Watches how long frames take (microseconds, from the start of drawing to the
/// end of the write) and answers how often animation frames may be asked for.
/// A smoothed time under 8 ms keeps 16 ms frames; slower halves the rate and then
/// halves it again; a terminal that takes 30 ms or more per frame gets no
/// animation, because every frame is already late.
pub type Pacer {
    pub int average_us = 0;
}

pub void Pacer.note(int frame_us) {
    if (frame_us <= 0) {
        return;
    }
    if (average_us == 0) {
        average_us = frame_us;
        return;
    }
    // new samples count a quarter: one slow frame (a big redraw) does not
    // switch animation off, several in a row do
    average_us = (average_us * 3 + frame_us) / 4;
}

/// Milliseconds between animation frames; 0 when animation should be skipped.
pub int Pacer.interval_ms() {
    if (average_us < 8000) {
        return 16;
    }
    if (average_us < 16000) {
        return 33;
    }
    if (average_us < 30000) {
        return 66;
    }
    return 0;
}

// ----------------------------------------------------------------- colours

/// sRGB channel -> a gamma-2 "linear-ish" value (0..65025), and back.
int to_linear(int channel) {
    return channel * channel;
}

int from_linear(int linear) {
    if (linear <= 0) {
        return 0;
    }
    int root = int(math.sqrt(float(linear)) + 0.5);
    if (root > 255) {
        return 255;
    }
    return root;
}

/// One channel of the mix of `from` and `to`, `permille` of the way (0 is
/// `from`, 1000 is `target`), mixed in gamma-2 space.
pub int blend_channel(int from, int target, int permille) {
    if (permille <= 0) {
        return from;
    }
    if (permille >= 1000) {
        return target;
    }
    int mixed = (to_linear(from) * (1000 - permille) + to_linear(target) * permille) / 1000;
    return from_linear(mixed);
}

/// The packed colour (0xRRGGBB) `permille` of the way from `from` to `target`.
pub int blend_rgb(int from, int target, int permille) {
    int red = blend_channel(from / 65536, target / 65536, permille);
    int green = blend_channel(from / 256 % 256, target / 256 % 256, permille);
    int blue = blend_channel(from % 256, target % 256, permille);
    return red * 65536 + green * 256 + blue;
}

/// The RGB a colour stands for on screen; `fallback` for the terminal's own
/// default colour, which a program cannot know.
pub int colour_rgb(TUI_style.Colour colour, int fallback) {
    match (colour) {
        case Default: {
            return fallback;
        }
        case Indexed(int index): {
            return TUI_style.palette_rgb(index);
        }
        case Rgb(int red, int green, int blue): {
            return red * 65536 + green * 256 + blue;
        }
    }
}

/// `colour` mixed `permille` of the way towards `target` (an RGB), as a 24-bit
/// colour. `fallback` stands in for a default colour.
pub TUI_style.Colour mix_towards(TUI_style.Colour colour, int target, int permille, int fallback) {
    int rgb = blend_rgb(colour_rgb(colour, fallback), target, permille);
    return TUI_style.Colour.Rgb(rgb / 65536, rgb / 256 % 256, rgb % 256);
}

/// What to draw for a popup that is fading in: every cell of `rect` of `frame`
/// (the finished popup) is given colours `permille` of the way from what
/// `under` (the frame as it was before the popup) showed there. The glyphs are
/// the popup's own; their colour rises out of the background they sit on, so the
/// text appears rather than the box snapping in. At 1000 nothing changes.
/// `default_fg` / `default_bg` stand in for the terminal's own colours (the
/// theme's `ui.text` and `ui.background`).
pub void fade_in(TUI_buffer.Buffer frame, TUI_buffer.Buffer under, TUI_geometry.Rect rect, int permille, int default_fg, int default_bg) {
    if (permille >= 1000) {
        return;
    }
    TUI_geometry.Rect area = frame.area();
    for (int y in rect.y .. rect.bottom()) {
        for (int x in rect.x .. rect.right()) {
            if (!area.has_point(x, y) || frame.is_same_cell(under, x, y)) {
                continue;
            }
            TUI_style.Style popup = TUI_style.Style.unpack(frame.style_at(x, y));
            TUI_style.Style behind = TUI_style.Style.unpack(under.style_at(x, y));
            int behind_bg = colour_rgb(behind.background, default_bg);
            int popup_bg = colour_rgb(popup.background, default_bg);
            int shade = blend_rgb(behind_bg, popup_bg, permille);
            // the text starts as the colour of what was behind it
            int ink = blend_rgb(behind_bg, colour_rgb(popup.foreground, default_fg), permille);
            TUI_style.Style faded = TUI_style.Style(foreground: TUI_style.Colour.Rgb(ink / 65536, ink / 256 % 256, ink % 256), background: TUI_style.Colour.Rgb(shade / 65536, shade / 256 % 256, shade % 256), attrs: popup.attrs);
            frame.set_style(x, y, faded);
        }
    }
}

/// `fade_in` for a transparent theme (docs/TRANSPARENCY.md): there is no
/// background to blend from and the colour of the desktop behind the popup is
/// not known, so nothing may be mixed with it. The popup's cells are drawn dim
/// for the first half of the fade and as they are after that; no colour is
/// invented, and a cell with the terminal's own background keeps it.
pub void fade_in_dim(TUI_buffer.Buffer frame, TUI_buffer.Buffer under, TUI_geometry.Rect rect, int permille) {
    if (permille >= 500) {
        return;
    }
    TUI_geometry.Rect area = frame.area();
    for (int y in rect.y .. rect.bottom()) {
        for (int x in rect.x .. rect.right()) {
            if (!area.has_point(x, y) || frame.is_same_cell(under, x, y)) {
                continue;
            }
            frame.set_style(x, y, TUI_style.Style.unpack(frame.style_at(x, y)).with_attrs(TUI_style.DIM));
        }
    }
}

/// How far a one-shot effect that began at `started_ns` has run at `now`, over
/// `duration_ms`, as permille (0 at the start, 1000 when over); eased out.
pub int progress(int started_ns, int now, int duration_ms) {
    if (duration_ms <= 0) {
        return 1000;
    }
    int elapsed = (now - started_ns) / NS_PER_MS;
    if (elapsed >= duration_ms) {
        return 1000;
    }
    if (elapsed <= 0) {
        return 0;
    }
    int done = elapsed * 1000 / duration_ms;
    int left = 1000 - done;
    // ease-out cubic: 1 - (1 - done)^3
    return 1000 - left * left * left / 1000000;
}
