    "\"ui.text.focus\" = { bg = \"sel1\", fg = \"fg1\" } # Selection highlight in buffer-picker or file-picker.",
    "\"ui.text.info\" = { fg = \"fg2\", bg = \"sel0\" } # Info popup contents (space mode menu).",
    "",
