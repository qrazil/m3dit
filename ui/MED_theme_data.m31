/// The source lines of built-in theme `name` (empty when there is none).
pub List<str> source_of(str name) {
    if (name == "catppuccin-mocha") {
        return CATPPUCCIN_MOCHA;
    }
    if (name == "default-light") {
        return DEFAULT_LIGHT;
    }
    if (name == "default") {
        return DEFAULT;
    }
    if (name == "dracula") {
        return DRACULA;
    }
    if (name == "github-light") {
        return GITHUB_LIGHT;
    }
    if (name == "gruvbox-material-soft") {
        return GRUVBOX_MATERIAL_SOFT;
    }
    if (name == "gruvbox-material") {
        return GRUVBOX_MATERIAL;
    }
    if (name == "gruvbox") {
        return GRUVBOX;
    }
    if (name == "nightfox") {
        return NIGHTFOX;
    }
    if (name == "nord") {
        return NORD;
    }
    if (name == "onedark") {
        return ONEDARK;
    }
    if (name == "term16-dark") {
        return TERM16_DARK;
    }
    if (name == "term16-light") {
        return TERM16_LIGHT;
    }
    if (name == "tokyonight") {
        return TOKYONIGHT;
    }
    return [];
}
