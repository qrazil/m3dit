/* The generic list service (docs/LIST.md).
 *
 * Named lists of places and rows: the finder's CTRL-Q, `:grep`, `:make`, `:vimgrep`, LSP references, the git hunks
 * and any plugin put their results in a list, and `:l` `:lnext` `[l` `]l` walk them. The default list is called
 * "quickfix" (the `:c*` commands and `:cdo` work on it). There is one store: a location list is a list with
 * another name.
 *
 *   Store.items(name)        the rows of a list
 *   Store.replace(name, ...) a new content, nothing current
 *   Store.append(name, ...)  more rows
 *   Store.wipe(name)         the list is gone
 *   Store.step(name, how)    move the current row (1 next, -1 previous, 0 first, 2 last); the new row, -1 if empty
 *   Store.pick(name, number) make row number (1-based, clamped) current
 */

import ui.MED_picker;

/// The name of the list the `:c*` commands, `:cdo`, `:grep` and `:make` use.
pub const str DEFAULT_NAME = "quickfix";

pub type Bag {
    pub List<MED_picker.Entry> rows = [];
    pub int current = -1;
}

pub type Store {
    pub Map<str, Bag> bags = {};
}

/// The rows of a list (empty when it does not exist).
pub List<MED_picker.Entry> Store.items(str name) {
    return bags.get(named(name)).or(Bag()).rows;
}

/// The 0-based current row, -1 when none was visited.
pub int Store.current(str name) {
    return bags.get(named(name)).or(Bag()).current;
}

pub int Store.size(str name) {
    return items(name).size();
}

/// The names of the lists that hold rows, in the order they were made.
pub List<str> Store.names() {
    List<str> out = [];
    for (str one in bags.keys()) {
        if (bags.get(one).or(Bag()).rows.size() > 0) {
            out.push(one);
        }
    }
    return out;
}

/// Give a list new rows; no row is current.
pub void Store.replace(str name, List<MED_picker.Entry> rows) {
    Bag fresh = Bag();
    fresh.rows = rows;
    bags.set(named(name), fresh);
}

/// Add rows to the end of a list.
pub void Store.append(str name, List<MED_picker.Entry> rows) {
    Bag bag = bags.get(named(name)).or(Bag());
    List<MED_picker.Entry> joined = [];
    for (MED_picker.Entry one in bag.rows) {
        joined.push(one);
    }
    for (MED_picker.Entry one in rows) {
        joined.push(one);
    }
    bag.rows = joined;
    bags.set(named(name), bag);
}

/// Empty a list.
pub void Store.wipe(str name) {
    bags.remove(named(name));
}

/// Move the current row: `how` 1 next, -1 previous (both wrap), 0 first, 2 last. Returns the new 0-based row, -1 for an empty list.
pub int Store.step(str name, int how) {
    Bag bag = bags.get(named(name)).or(Bag());
    int total = bag.rows.size();
    if (total == 0) {
        return -1;
    }
    int next = 0;
    if (how == 1) {
        next = bag.current + 1;
        if (next >= total) {
            next = 0;
        }
    } else if (how == -1) {
        next = bag.current - 1;
        if (next < 0) {
            next = total - 1;
        }
    } else if (how == 2) {
        next = total - 1;
    }
    bag.current = next;
    bags.set(named(name), bag);
    return next;
}

/// Make row `number` (1-based, clamped into the list) current. Returns the 0-based row, -1 for an empty list.
pub int Store.pick(str name, int number) {
    Bag bag = bags.get(named(name)).or(Bag());
    int total = bag.rows.size();
    if (total == 0) {
        return -1;
    }
    int row = number - 1;
    if (row < 0) {
        row = 0;
    }
    if (row >= total) {
        row = total - 1;
    }
    bag.current = row;
    bags.set(named(name), bag);
    return row;
}

/// The list called `name`, or `DEFAULT_NAME` for an empty name.
pub str named(str name) {
    if (name.trim().size() == 0) {
        return DEFAULT_NAME;
    }
    return name.trim();
}
