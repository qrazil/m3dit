/* What the front end keeps on disk for a buffer between sessions (besides the recent-file and
 * cursor lists of MED_state): the undo file. Everything takes the state directory as an argument and
 * does nothing when it is "" (tests and `-u NONE` stay hermetic). Failures are silent: persistence is a
 * convenience and must never get in the way of editing. */

import engine.MED_editor;
import engine.MED_undofile;
import fs;
import io;

/** Load the saved undo tree of the file at absolute path `file` into `editor` when the buffer still
 * holds the text it was saved for. True when a tree was loaded. */
pub bool did_restore_undo(str directory, str file, MED_editor.Editor editor) {
    if (directory.size() == 0 || file.size() == 0 || editor.nodes.size() != 1) {
        return false;
    }
    str name = directory + "/" + MED_undofile.file_name(file);
    if (!fs.is_file(name)) {
        return false;
    }
    match (io.read(name)) {
        case Ok(str data): {
            return MED_undofile.did_restore(editor, data);
        }
        case Err(io.Error error): {
            return false;
        }
    }
}

/** Write the undo tree of `editor`, which holds the text just written to the file at absolute path
 * `file`. An editor without history removes a stale undo file. */
pub void save_undo(str directory, str file, MED_editor.Editor editor) {
    if (directory.size() == 0 || file.size() == 0) {
        return;
    }
    str name = directory + "/" + MED_undofile.file_name(file);
    str data = MED_undofile.encode(editor);
    if (data.size() == 0) {
        if (fs.is_file(name)) {
            match (fs.remove(name)) {
                case Ok(bool did_remove): {
                }
                case Err(io.Error error): {
                }
            }
        }
        return;
    }
    match (fs.makedirs(directory + "/undo")) {
        case Ok(bool did_make): {
        }
        case Err(io.Error error): {
            return;
        }
    }
    match (io.write(name, data)) {
        case Ok(int count): {
        }
        case Err(io.Error error): {
        }
    }
}

/// A fingerprint of the file at `file` on disk: size and modification time in nanoseconds ("" when it is not there).
pub str disk_stamp(str file) {
    if (file.size() == 0) {
        return "";
    }
    match (fs.stat(file)) {
        case Ok(fs.Stat stat): {
            return stat.size.to_str() + ":" + stat.mtime_ns.to_str();
        }
        case Err(io.Error error): {
            return "";
        }
    }
}

/** The recovery file of the buffer at absolute path `file`: the text as it was when the editor last sat idle, so a
 * `kill -9`, a power cut or a crash loses at most the last moments. `directory/recover/` + the path with `/` as `%`. */
pub str recovery_file(str directory, str file) {
    return directory + "/recover/" + file.split("/").join("%");
}

/** Write the recovery file. `stamp` is the disk stamp of the file the text started from (the header tells
 * `:recover` whether the file changed meanwhile). Silent on failure: this must never get in the way of editing. */
pub void save_recovery(str directory, str file, str stamp, str text) {
    if (directory.size() == 0 || file.size() == 0) {
        return;
    }
    match (fs.makedirs(directory + "/recover")) {
        case Ok(bool did_make): {
        }
        case Err(io.Error error): {
            return;
        }
    }
    match (io.write(recovery_file(directory, file), "m3recover 1\n" + file.split("\n").join(" ") + "\n" + stamp + "\n" + text)) {
        case Ok(int count): {
        }
        case Err(io.Error error): {
        }
    }
}

/// Remove the recovery file (the buffer was written, or its changes were given up on purpose).
pub void remove_recovery(str directory, str file) {
    if (directory.size() == 0 || file.size() == 0) {
        return;
    }
    str name = recovery_file(directory, file);
    if (fs.is_file(name)) {
        match (fs.remove(name)) {
            case Ok(bool did_remove): {
            }
            case Err(io.Error error): {
            }
        }
    }
}

/** The text a recovery file holds; "" when there is none or it is not ours. A buffer with no text at all is
 * "\n"-less, so "no recovery" and "recovered an empty buffer" are told apart by `has_recovery`. */
pub str read_recovery(str directory, str file) {
    if (directory.size() == 0 || file.size() == 0) {
        return "";
    }
    str name = recovery_file(directory, file);
    if (!fs.is_file(name)) {
        return "";
    }
    match (io.read(name)) {
        case Ok(str data): {
            List<str> parts = data.split("\n");
            if (parts.size() < 4 || parts[0] != "m3recover 1") {
                return "";
            }
            int skip = parts[0].size() + parts[1].size() + parts[2].size() + 3;
            return data.substr(skip, data.size());
        }
        case Err(io.Error error): {
            return "";
        }
    }
}

/// Whether a recovery file exists for `file`.
pub bool has_recovery(str directory, str file) {
    return directory.size() > 0 && file.size() > 0 && fs.is_file(recovery_file(directory, file));
}
