// Windows: the layout tree and the geometry of the split screen.
//
// A tree whose leaves are windows and whose branches hold their children side
// by side (`is_vertical`, made by :vsplit) or one above the other (:split).
// Every window has its own status line as its last row, so stacked windows
// need no separator; windows side by side are parted by a one-column
// separator, which belongs to the frame of the window on its left.
//
// The sizes follow nvim's frame model (window.c): every node keeps the size
// it was given (`width` and `height` include the separator and the status
// line), and the operations that change the layout did_resize frames the way nvim
// does: a split halves the window and then equalizes ('equalalways', the
// current window first and at least 'winwidth' wide), a close gives the space
// to the neighbour and equalizes, `:did_resize` takes the room from the frames
// after the window and then before it, a change of the screen size shrinks
// the last frames first and gives extra room to the last one. The differential
// test against nvim is tests/oracles/oracle_windows.py.
//
// Pure data and arithmetic, no terminal: the front end (MED_app) owns the
// buffers and asks this module where everything goes.

import engine.MED_text;

/// One window: the buffer it shows and, while it is not the active window,
/// where its cursor and view are. (The active window's own values live in the
/// editor and are stored back here whenever the front end saves its state.)
pub type Win {
    pub int id;
    pub int buffer_id;
    pub int row = 0;
    pub int col = 0;
    pub int view_top = 0;
    pub int left_column = 0;
}

/// A leaf (`win_id` > 0) or a branch (`kids`). `width` and `height` are the
/// size of the frame: a leaf's include its status line row and, unless it is
/// at the right edge of the screen, the separator column. 0 until placed.
pub type Node {
    pub int win_id = 0;
    pub bool is_vertical = false;
    pub List<Node> kids = [];
    pub int width = 0;
    pub int height = 0;
    int tag = 0;
}

/// A rectangle of the screen for window `win_id` (0 for a separator). A
/// window's height includes its status line row.
pub type Placed {
    pub int win_id;
    pub int x;
    pub int y;
    pub int width;
    pub int height;
}

pub type Layout {
    pub List<Placed> windows = [];
    pub List<Placed> separators = [];
}

pub const int GO_LEFT = 104;
pub const int GO_DOWN = 106;
pub const int GO_UP = 107;
pub const int GO_RIGHT = 108;
// nvim's 'winwidth' (the least width of the current window while equalizing),
// 'winminwidth', 'winheight' and 'winminheight'.
const int WIN_WIDTH = 20;
const int WIN_MIN_WIDTH = 1;
const int WIN_HEIGHT = 1;
const int WIN_MIN_HEIGHT = 1;

pub Node leaf(int id) {
    return Node(win_id: id);
}

pub bool is_leaf(Node node) {
    return node.win_id > 0;
}

/// The window ids in reading order (left to right, top to bottom).
pub List<int> leaves(Node node) {
    List<int> found = [];
    if (is_leaf(node)) {
        found.push(node.win_id);
        return found;
    }
    for (Node kid in node.kids) {
        for (int id in leaves(kid)) {
            found.push(id);
        }
    }
    return found;
}

// Whether the subtree under `node` holds window `id`.
bool is_holding(Node node, int id) {
    if (is_leaf(node)) {
        return node.win_id == id;
    }
    for (Node kid in node.kids) {
        if (is_holding(kid, id)) {
            return true;
        }
    }
    return false;
}

// The first window of a subtree (nvim's frame2win).
int first_leaf(Node node) {
    if (is_leaf(node)) {
        return node.win_id;
    }
    return first_leaf(node.kids[0]);
}

// ------------------------------------------------------------------ minimums

// The least width of a frame; the window `current` counts 'winwidth' (0: none
// does). `is_edge`: the frame touches the right edge of the screen, so its
// windows have no separator.
int min_width(Node node, int current, bool is_edge) {
    if (is_leaf(node)) {
        int own = WIN_MIN_WIDTH;
        if (node.win_id == current) {
            own = WIN_WIDTH;
        }
        if (!is_edge) {
            own = own + 1;
        }
        return own;
    }
    int total = 0;
    int count = node.kids.size();
    for (int index in 0 .. count) {
        bool is_kid_edge = is_edge && (!node.is_vertical || index == count - 1);
        int one = min_width(node.kids[index], current, is_kid_edge);
        if (node.is_vertical) {
            total = total + one;
        } else if (one > total) {
            total = one;
        }
    }
    return total;
}

// The least height of a frame (every window has a status line).
int min_height(Node node, int current) {
    if (is_leaf(node)) {
        int own = WIN_MIN_HEIGHT;
        if (node.win_id == current) {
            own = WIN_HEIGHT;
        }
        return own + 1;
    }
    int total = 0;
    for (Node kid in node.kids) {
        int one = min_height(kid, current);
        if (!node.is_vertical) {
            total = total + one;
        } else if (one > total) {
            total = one;
        }
    }
    return total;
}

// ------------------------------------------------------------------ resizing

// nvim's frame_new_height: give the frame `height`; a column of frames
// changes its bottom frame first (its top one when `is_top_first`), shrinking
// the frames above when that one is at its least.
void new_height(Node node, int height, bool is_top_first) {
    int wanted = height;
    if (!is_leaf(node)) {
        if (node.is_vertical) {
            bool is_again = true;
            while (is_again) {
                is_again = false;
                for (Node kid in node.kids) {
                    new_height(kid, wanted, is_top_first);
                    if (kid.height > wanted) {
                        wanted = kid.height;
                        is_again = true;
                        break;
                    }
                }
            }
        } else {
            int count = node.kids.size();
            int spot = count - 1;
            int step = -1;
            if (is_top_first) {
                spot = 0;
                step = 1;
            }
            int extra = wanted - node.height;
            if (extra < 0) {
                while (spot >= 0 && spot < count) {
                    Node kid = node.kids[spot];
                    int least = min_height(kid, 0);
                    if (kid.height + extra < least) {
                        extra = extra + kid.height - least;
                        new_height(kid, least, is_top_first);
                    } else {
                        new_height(kid, kid.height + extra, is_top_first);
                        break;
                    }
                    spot = spot + step;
                    if (spot < 0 || spot >= count) {
                        wanted = wanted - extra;
                    }
                }
            } else if (extra > 0) {
                new_height(node.kids[spot], node.kids[spot].height + extra, is_top_first);
            }
        }
    }
    node.height = wanted;
}

// nvim's frame_new_width (see new_height); the last frame of a row gives up
// its separator when it is the one at the right edge.
void new_width(Node node, int width, bool is_left_first, bool is_edge) {
    int wanted = width;
    if (!is_leaf(node)) {
        if (!node.is_vertical) {
            bool is_again = true;
            while (is_again) {
                is_again = false;
                for (Node kid in node.kids) {
                    new_width(kid, wanted, is_left_first, is_edge);
                    if (kid.width > wanted) {
                        wanted = kid.width;
                        is_again = true;
                        break;
                    }
                }
            }
        } else {
            int count = node.kids.size();
            int spot = count - 1;
            int step = -1;
            if (is_left_first) {
                spot = 0;
                step = 1;
            }
            int extra = wanted - node.width;
            if (extra < 0) {
                while (spot >= 0 && spot < count) {
                    Node kid = node.kids[spot];
                    bool is_kid_edge = is_edge && spot == count - 1;
                    int least = min_width(kid, 0, is_kid_edge);
                    if (kid.width + extra < least) {
                        extra = extra + kid.width - least;
                        new_width(kid, least, is_left_first, is_kid_edge);
                    } else {
                        new_width(kid, kid.width + extra, is_left_first, is_kid_edge);
                        break;
                    }
                    spot = spot + step;
                    if (spot < 0 || spot >= count) {
                        wanted = wanted - extra;
                    }
                }
            } else if (extra > 0) {
                new_width(node.kids[spot], node.kids[spot].width + extra, is_left_first, is_edge && spot == count - 1);
            }
        }
    }
    node.width = wanted;
}

// nvim's win_equal_rec: size the frames of `node` equally ('b' both
// directions, 'h' widths only, 'v' heights only). The frame holding
// `current_id` is sized first and at least 'winwidth' wide; `is_current`
// (only the frame that was split or closed) skips the frames whose size does
// not change.
void equal_into(Node node, int current_id, bool is_current, bool is_top, str direction, int width, int height, bool is_edge) {
    if (is_leaf(node)) {
        node.width = width;
        node.height = height;
        return;
    }
    node.width = width;
    node.height = height;
    int count = node.kids.size();
    bool has_current = is_holding(node, current_id);
    int total_count = 0;
    int room = 0;
    int current_size = 0;
    int extra_separator = 0;
    if (node.is_vertical) {
        if (direction != "v") {
            int least = min_width(node, 0, is_edge);
            if (is_edge) {
                extra_separator = 1;
            }
            total_count = (least + extra_separator) / (WIN_MIN_WIDTH + 1);
            int with_current = min_width(node, current_id, is_edge);
            room = width - with_current;
            if (room < 0) {
                current_size = WIN_WIDTH + room;
                room = 0;
            } else if (!has_current) {
                current_size = 0;
            } else if (total_count > 1 && (room + (total_count - 2)) / (total_count - 1) > WIN_WIDTH) {
                current_size = (room + WIN_WIDTH + (total_count - 1) * WIN_MIN_WIDTH + (total_count - 1)) / total_count;
                room = room - (current_size - WIN_WIDTH);
            } else {
                current_size = WIN_WIDTH;
            }
            if (has_current) {
                total_count = total_count - 1;
            }
        }
        int left = width;
        for (int index in 0 .. count) {
            Node kid = node.kids[index];
            bool is_kid_edge = is_edge && index == count - 1;
            int wincount = 1;
            int new_size = 0;
            if (index == count - 1) {
                new_size = left;
            } else if (direction == "v") {
                new_size = kid.width;
            } else {
                int least = min_width(kid, 0, is_kid_edge);
                wincount = least / (WIN_MIN_WIDTH + 1);
                int with_current = min_width(kid, current_id, is_kid_edge);
                bool is_here = has_current && is_holding(kid, current_id);
                if (is_here) {
                    wincount = wincount - 1;
                }
                if (total_count == 0) {
                    new_size = room;
                } else {
                    new_size = (wincount * room + total_count / 2) / total_count;
                }
                if (is_here) {
                    current_size = current_size - (WIN_WIDTH - (with_current - least));
                    new_size = new_size + current_size;
                    room = room - (new_size - current_size);
                } else {
                    room = room - new_size;
                }
                new_size = new_size + least;
            }
            if (!is_current || direction != "v" || !is_top || new_size != kid.width || is_holding(kid, current_id)) {
                equal_into(kid, current_id, is_current, false, direction, new_size, height, is_kid_edge);
            }
            left = left - new_size;
            total_count = total_count - wincount;
        }
    } else {
        if (direction != "h") {
            int least = min_height(node, 0);
            total_count = least / (WIN_MIN_HEIGHT + 1);
            int with_current = min_height(node, current_id);
            room = height - with_current;
            if (room < 0) {
                current_size = WIN_HEIGHT + room;
                room = 0;
            } else if (!has_current) {
                current_size = 0;
            } else if (total_count > 1 && (room + (total_count - 2)) / (total_count - 1) > WIN_HEIGHT) {
                current_size = (room + WIN_HEIGHT + (total_count - 1) * WIN_MIN_HEIGHT + (total_count - 1)) / total_count;
                room = room - (current_size - WIN_HEIGHT);
            } else {
                current_size = WIN_HEIGHT;
            }
            if (has_current) {
                total_count = total_count - 1;
            }
        }
        int left = height;
        for (int index in 0 .. count) {
            Node kid = node.kids[index];
            int wincount = 1;
            int new_size = 0;
            if (index == count - 1) {
                new_size = left;
            } else if (direction == "h") {
                new_size = kid.height;
            } else {
                int least = min_height(kid, 0);
                wincount = least / (WIN_MIN_HEIGHT + 1);
                int with_current = min_height(kid, current_id);
                bool is_here = has_current && is_holding(kid, current_id);
                if (is_here) {
                    wincount = wincount - 1;
                }
                if (total_count == 0) {
                    new_size = room;
                } else {
                    new_size = (wincount * room + total_count / 2) / total_count;
                }
                if (is_here) {
                    current_size = current_size - (WIN_HEIGHT - (with_current - least));
                    new_size = new_size + current_size;
                    room = room - (new_size - current_size);
                } else {
                    room = room - new_size;
                }
                new_size = new_size + least;
            }
            if (!is_current || direction != "h" || !is_top || new_size != kid.height || is_holding(kid, current_id)) {
                equal_into(kid, current_id, is_current, false, direction, width, new_size, is_edge);
            }
            left = left - new_size;
            total_count = total_count - wincount;
        }
    }
}

// nvim's win_equal on the whole tree.
void equal_tree(Node root, int current_id, bool is_current, str direction) {
    if (root.width <= 0 || root.height <= 0) {
        return;
    }
    equal_into(root, current_id, is_current, true, direction, root.width, root.height, true);
}

/// `CTRL-W =`: every window shares the space equally again; `current_id`, the
/// active window, gets the odd cells.
pub void equalize(Node root, int current_id) {
    equal_tree(root, current_id, false, "b");
}

// ------------------------------------------------------------------ geometry

/// Fit the tree to an area of `width` x `height` cells whose top left is
/// (`x`, `y`), then say where each window and separator goes. The sizes the
/// tree has are kept; a tree that is new takes the area, and one whose area
/// changed (the terminal was resized) shrinks its last frames first and gives
/// extra room to the last one, as nvim does.
pub Layout place(Node root, int x, int y, int width, int height) {
    if (root.width == 0 || root.height == 0) {
        if (is_leaf(root)) {
            root.width = width;
            root.height = height;
        } else {
            equal_into(root, 0, false, true, "b", width, height, true);
        }
    } else {
        if (root.height != height) {
            new_height(root, height, false);
        }
        if (root.width != width) {
            new_width(root, width, false, true);
        }
    }
    Layout out = Layout();
    place_into(root, x, y, true, out);
    return out;
}

void place_into(Node node, int x, int y, bool is_edge, Layout out) {
    if (is_leaf(node)) {
        int shown = node.width;
        if (!is_edge) {
            shown = shown - 1;
            out.separators.push(Placed(0, x + shown, y, 1, node.height));
        }
        out.windows.push(Placed(node.win_id, x, y, shown, node.height));
        return;
    }
    int used_x = 0;
    int used_y = 0;
    int count = node.kids.size();
    for (int index in 0 .. count) {
        Node kid = node.kids[index];
        if (node.is_vertical) {
            place_into(kid, x + used_x, y, is_edge && index == count - 1, out);
            used_x = used_x + kid.width;
        } else {
            place_into(kid, x, y + used_y, is_edge, out);
            used_y = used_y + kid.height;
        }
    }
}

/// The rectangle of window `id`; a zero-sized one when there is no such window.
pub Placed placed_of(Layout layout, int id) {
    for (Placed one in layout.windows) {
        if (one.win_id == id) {
            return one;
        }
    }
    return Placed(0, 0, 0, 0, 0);
}

/// The window whose rectangle holds the cell (`x`, `y`), or 0.
pub int window_at(Layout layout, int x, int y) {
    for (Placed one in layout.windows) {
        if (x >= one.x && x < one.x + one.width && y >= one.y && y < one.y + one.height) {
            return one.win_id;
        }
    }
    return 0;
}

// ------------------------------------------------------------------ paths

// The nodes from `node` down to window `id` (empty when there is none) and,
// for each but the first, its index in its parent.
bool did_find_chain(Node node, int id, List<Node> nodes, List<int> indexes) {
    nodes.push(node);
    if (is_leaf(node)) {
        if (node.win_id == id) {
            return true;
        }
        nodes.pop();
        return false;
    }
    for (int index in 0 .. node.kids.size()) {
        indexes.push(index);
        if (did_find_chain(node.kids[index], id, nodes, indexes)) {
            return true;
        }
        indexes.pop();
    }
    nodes.pop();
    return false;
}

// Whether the node at `depth` of a chain touches the right edge of the screen.
bool is_chain_edge(List<Node> nodes, List<int> indexes, int depth) {
    for (int step in 0 .. depth) {
        Node parent = nodes[step];
        if (parent.is_vertical && indexes[step] != parent.kids.size() - 1) {
            return false;
        }
    }
    return true;
}

// ------------------------------------------------------------------ splitting

/// Whether window `target` can be split (nvim's E36 test): its frame, and the
/// frames beside it up the tree, must keep their least sizes.
pub bool can_split(Node root, int target, bool is_vertical) {
    List<Node> nodes = [];
    List<int> indexes = [];
    if (!did_find_chain(root, target, nodes, indexes)) {
        return false;
    }
    int depth = nodes.size() - 1;
    if (root.width == 0 || root.height == 0) {
        return true;
    }
    if (is_vertical) {
        int minimum = min_width(nodes[depth], 0, is_chain_edge(nodes, indexes, depth));
        for (int step in 0 .. depth) {
            Node parent = nodes[step];
            if (parent.is_vertical) {
                for (int index in 0 .. parent.kids.size()) {
                    if (index != indexes[step]) {
                        minimum = minimum + min_width(parent.kids[index], 0, is_chain_edge(nodes, indexes, step) && index == parent.kids.size() - 1);
                    }
                }
            }
        }
        return root.width >= WIN_MIN_WIDTH + 1 + minimum;
    }
    int minimum = min_height(nodes[depth], 0);
    for (int step in 0 .. depth) {
        Node parent = nodes[step];
        if (!parent.is_vertical) {
            for (int index in 0 .. parent.kids.size()) {
                if (index != indexes[step]) {
                    minimum = minimum + min_height(parent.kids[index], 0);
                }
            }
        }
    }
    return root.height >= WIN_MIN_HEIGHT + 1 + 1 + minimum;
}

/// Split the window `target`: the new window `new_id` goes before it (left or
/// above) or, when `is_after`, after it, and becomes the one the space is
/// shared for. Returns the new root.
pub Node split(Node root, int target, int new_id, bool is_vertical, bool is_after) {
    List<Node> nodes = [];
    List<int> indexes = [];
    if (!did_find_chain(root, target, nodes, indexes)) {
        return root;
    }
    int depth = nodes.size() - 1;
    Node old = nodes[depth];
    bool is_edge = is_chain_edge(nodes, indexes, depth);
    bool is_sized = root.width > 0 && root.height > 0;
    // 'equalalways' shares the space out again only when the halves do not
    // fit, or one of the other windows of the branch is bigger than a half
    bool is_equal = false;
    // the new window's frame and what is left of the old one
    Node fresh = leaf(new_id);
    if (is_sized) {
        if (is_vertical) {
            int old_separator = 1;
            if (is_edge) {
                old_separator = 0;
            }
            int new_size = (old.width - old_separator) / 2;
            int minimum = min_width(old, 0, is_edge);
            for (int step in 0 .. depth) {
                Node parent = nodes[step];
                if (parent.is_vertical) {
                    for (int index in 0 .. parent.kids.size()) {
                        if (index != indexes[step]) {
                            minimum = minimum + min_width(parent.kids[index], 0, is_chain_edge(nodes, indexes, step) && index == parent.kids.size() - 1);
                        }
                    }
                }
            }
            int available = root.width;
            if (new_size > available - minimum - 1) {
                new_size = available - minimum - 1;
            }
            if (new_size < WIN_MIN_WIDTH) {
                new_size = WIN_MIN_WIDTH;
            }
            int old_text = old.width - old_separator;
            if (old_text - new_size - 1 < WIN_MIN_WIDTH) {
                is_equal = true;
            }
            if (!is_equal && depth > 0) {
                Node beside = nodes[depth - 1];
                for (int index in 0 .. beside.kids.size()) {
                    Node other = beside.kids[index];
                    if (index == indexes[depth - 1] || !is_leaf(other)) {
                        continue;
                    }
                    int other_text = other.width;
                    if (beside.is_vertical && !(is_chain_edge(nodes, indexes, depth - 1) && index == beside.kids.size() - 1)) {
                        other_text = other.width - 1;
                    }
                    if (other_text > new_size || other_text > old_text - new_size - 1) {
                        is_equal = true;
                    }
                }
            }
            int taken = new_size + old_separator;
            if (!is_after) {
                taken = new_size + 1;
            }
            fresh.width = taken;
            fresh.height = old.height;
            old.width = old.width - taken;
        } else {
            int new_size = (old.height - 1) / 2;
            int minimum = min_height(old, 0);
            for (int step in 0 .. depth) {
                Node parent = nodes[step];
                if (!parent.is_vertical) {
                    for (int index in 0 .. parent.kids.size()) {
                        if (index != indexes[step]) {
                            minimum = minimum + min_height(parent.kids[index], 0);
                        }
                    }
                }
            }
            int available = root.height;
            if (new_size > available - minimum - 1) {
                new_size = available - minimum - 1;
            }
            if (new_size < WIN_MIN_HEIGHT) {
                new_size = WIN_MIN_HEIGHT;
            }
            int old_text = old.height - 1;
            if (old_text - new_size - 1 < WIN_MIN_HEIGHT) {
                is_equal = true;
            }
            if (!is_equal && depth > 0) {
                Node beside = nodes[depth - 1];
                for (int index in 0 .. beside.kids.size()) {
                    Node other = beside.kids[index];
                    if (index == indexes[depth - 1] || !is_leaf(other)) {
                        continue;
                    }
                    int other_text = other.height - 1;
                    if (other_text > new_size || other_text > old_text - new_size - 1) {
                        is_equal = true;
                    }
                }
            }
            fresh.height = new_size + 1;
            fresh.width = old.width;
            old.height = old.height - fresh.height;
        }
    }
    Node result = root;
    if (depth == 0) {
        Node wrapped = leaf(old.win_id);
        wrapped.width = old.width;
        wrapped.height = old.height;
        Node branch = Node(is_vertical: is_vertical, kids: pair(wrapped, fresh, is_after));
        branch.width = root.width;
        branch.height = root.height;
        if (is_sized) {
            if (is_vertical) {
                branch.width = wrapped.width + fresh.width;
            } else {
                branch.height = wrapped.height + fresh.height;
            }
        }
        result = branch;
    } else {
        Node parent = nodes[depth - 1];
        int position = indexes[depth - 1];
        if (parent.is_vertical == is_vertical) {
            int spot = position;
            if (is_after) {
                spot = position + 1;
            }
            parent.kids.insert(spot, fresh);
        } else {
            Node wrapped = leaf(old.win_id);
            wrapped.width = old.width;
            wrapped.height = old.height;
            Node branch = Node(is_vertical: is_vertical, kids: pair(wrapped, fresh, is_after));
            if (is_sized) {
                if (is_vertical) {
                    branch.width = wrapped.width + fresh.width;
                    branch.height = wrapped.height;
                } else {
                    branch.width = wrapped.width;
                    branch.height = wrapped.height + fresh.height;
                }
            }
            parent.kids[position] = branch;
        }
    }
    if (is_sized && is_equal) {
        str direction = "v";
        if (is_vertical) {
            direction = "h";
        }
        equal_tree(result, new_id, true, direction);
    }
    return result;
}

List<Node> pair(Node old, Node added, bool is_after) {
    if (is_after) {
        return [old, added];
    }
    return [added, old];
}

// ------------------------------------------------------------------ closing

/// The window that takes over when `id` closes (nvim: the first window of the
/// frame before it, or after it for the first frame); 0 for the only window.
pub int successor(Node root, int id) {
    List<Node> nodes = [];
    List<int> indexes = [];
    if (!did_find_chain(root, id, nodes, indexes) || nodes.size() < 2) {
        return 0;
    }
    Node parent = nodes[nodes.size() - 2];
    int position = indexes[indexes.size() - 1];
    if (position == 0) {
        return first_leaf(parent.kids[1]);
    }
    return first_leaf(parent.kids[position - 1]);
}

// Take window `id` out of the tree, handing its space to the neighbour.
// Returns the direction the space went ("v" for a column, "h" for a row) and
// leaves the branch it left in `left_branch` (tagged) for the caller.
str remove_window(Node root, int id) {
    List<Node> nodes = [];
    List<int> indexes = [];
    if (!did_find_chain(root, id, nodes, indexes) || nodes.size() < 2) {
        return "";
    }
    Node parent = nodes[nodes.size() - 2];
    int position = indexes[indexes.size() - 1];
    Node closing = parent.kids[position];
    int alt = position - 1;
    bool is_next = false;
    if (position == 0) {
        alt = 1;
        is_next = true;
    }
    Node target = parent.kids[alt];
    if (parent.is_vertical) {
        new_width(target, target.width + closing.width, is_next, false);
    } else {
        new_height(target, target.height + closing.height, is_next);
    }
    parent.kids.remove_at(position);
    parent.tag = -1;
    if (parent.is_vertical) {
        return "h";
    }
    return "v";
}

/// Remove window `id`; its space goes to its neighbour and the windows are
/// shared out again around `focus`, the window that becomes the active one.
/// Returns the new root (the same root when `id` is the only window).
pub Node without(Node root, int id, int focus) {
    if (is_leaf(root)) {
        return root;
    }
    str direction = remove_window(root, id);
    if (direction == "") {
        return root;
    }
    Node result = normalized(root);
    // only the frame that lost the window is shared out again when the new
    // active window is directly in it
    bool is_current = false;
    List<Node> nodes = [];
    List<int> indexes = [];
    if (did_find_chain(result, focus, nodes, indexes) && nodes.size() >= 2) {
        is_current = nodes[nodes.size() - 2].tag == -1;
    }
    clear_tags(result);
    equal_tree(result, focus, is_current, direction);
    return result;
}

void clear_tags(Node node) {
    node.tag = 0;
    for (Node kid in node.kids) {
        clear_tags(kid);
    }
}

/// `:only`: the one window `id` is left with the whole area.
pub Node only(Node root, int id) {
    Node one = leaf(id);
    one.width = root.width;
    one.height = root.height;
    return one;
}

/// Branches with one child collapse into it; a branch inside a branch of the
/// same direction is merged into it; empty branches vanish.
Node normalized(Node node) {
    if (is_leaf(node)) {
        return node;
    }
    List<Node> kept = [];
    for (Node kid in node.kids) {
        Node flat = normalized(kid);
        if (is_leaf(flat)) {
            kept.push(flat);
        } else if (flat.kids.size() > 0) {
            if (flat.is_vertical == node.is_vertical) {
                for (Node inner in flat.kids) {
                    kept.push(inner);
                }
            } else {
                kept.push(flat);
            }
        }
    }
    node.kids = kept;
    if (kept.size() == 1) {
        Node only_kid = kept[0];
        only_kid.width = node.width;
        only_kid.height = node.height;
        if (node.tag == -1 && !is_leaf(only_kid)) {
            // nvim moves the only child into the parent's frame: the branch
            // that lost a window stays "the frame that was closed in"
            only_kid.tag = -1;
        }
        return only_kid;
    }
    return node;
}

/// One tab page: the windows and layout it had when it was left, and which
/// window was active (the active tab page's own live values are in the front
/// end and are stored back here whenever it leaves the page).
pub type Page {
    pub List<Win> wins = [];
    pub Node layout = Node();
    pub int current_win = 1;
    pub int previous_win = 0;
}

/// The window next to `active` in direction `direction` (GO_LEFT, GO_DOWN, GO_UP, GO_RIGHT) as
/// seen from the screen cell (`ref_x`, `ref_y`), or 0 when there is none.
pub int neighbor(Layout layout, int active, int direction, int ref_x, int ref_y) {
    Placed here = placed_of(layout, active);
    int best = 0;
    int best_edge = 0;
    for (int pass in 0 .. 2) {
        for (Placed one in layout.windows) {
            if (one.win_id == active) {
                continue;
            }
            bool is_beside = false;
            int edge = 0;
            if (direction == GO_LEFT && one.x + one.width < here.x + 1) {
                is_beside = true;
                edge = one.x;
            } else if (direction == GO_RIGHT && one.x > here.x + here.width) {
                is_beside = true;
                edge = 10000 - one.x;
            } else if (direction == GO_UP && one.y + one.height <= here.y) {
                is_beside = true;
                edge = one.y;
            } else if (direction == GO_DOWN && one.y >= here.y + here.height) {
                is_beside = true;
                edge = 10000 - one.y;
            }
            if (!is_beside) {
                continue;
            }
            bool is_sideways = direction == GO_LEFT || direction == GO_RIGHT;
            bool is_inside = false;
            if (pass == 0 && is_sideways) {
                is_inside = ref_y >= one.y && ref_y < one.y + one.height;
            } else if (pass == 0) {
                is_inside = ref_x >= one.x && ref_x < one.x + one.width;
            } else if (is_sideways) {
                is_inside = one.y < here.y + here.height && one.y + one.height > here.y;
            } else {
                is_inside = one.x < here.x + here.width && one.x + one.width > here.x;
            }
            if (is_inside && (best == 0 || edge > best_edge)) {
                best = one.win_id;
                best_edge = edge;
            }
        }
        if (best > 0) {
            return best;
        }
    }
    return 0;
}

// ------------------------------------------------------------------ did_resize

// nvim's frame_setheight: give the frame at `depth` of the chain `height`
// rows, taking them from the frames after it and then before it.
void set_frame_height(Node root, List<Node> nodes, List<int> indexes, int depth, int height) {
    Node current = nodes[depth];
    int wanted = height;
    if (depth == 0) {
        if (wanted > root.height) {
            wanted = root.height;
        }
        if (wanted > 0) {
            new_height(current, wanted, false);
        }
        return;
    }
    Node parent = nodes[depth - 1];
    int position = indexes[depth - 1];
    if (parent.is_vertical) {
        int least = min_height(parent, 0);
        if (wanted < least) {
            wanted = least;
        }
        set_frame_height(root, nodes, indexes, depth - 1, wanted);
        return;
    }
    for (int run in 1 .. 3) {
        int room = 0;
        for (int index in 0 .. parent.kids.size()) {
            room = room + parent.kids[index].height;
            if (index != position) {
                room = room - min_height(parent.kids[index], 0);
            }
        }
        if (wanted <= room) {
            break;
        }
        if (run == 2 || current.width == root.width) {
            wanted = room;
            break;
        }
        set_frame_height(root, nodes, indexes, depth - 1, wanted + min_height(parent, 0) - WIN_MIN_HEIGHT - 1);
    }
    int take = wanted - current.height;
    new_height(current, wanted, false);
    for (int run in 0 .. 2) {
        int spot = position + 1;
        int step = 1;
        if (run == 1) {
            spot = position - 1;
            step = -1;
        }
        while (spot >= 0 && spot < parent.kids.size() && take != 0) {
            Node kid = parent.kids[spot];
            int least = min_height(kid, 0);
            if (kid.height - take < least) {
                take = take - (kid.height - least);
                new_height(kid, least, false);
            } else {
                new_height(kid, kid.height - take, false);
                take = 0;
            }
            spot = spot + step;
        }
    }
}

// nvim's frame_setwidth (the same with columns; a window cannot change the
// width of the whole screen).
void set_frame_width(Node root, List<Node> nodes, List<int> indexes, int depth, int width) {
    if (depth == 0) {
        return;
    }
    Node current = nodes[depth];
    Node parent = nodes[depth - 1];
    int position = indexes[depth - 1];
    int wanted = width;
    bool is_parent_edge = is_chain_edge(nodes, indexes, depth - 1);
    if (!parent.is_vertical) {
        int least = min_width(parent, 0, is_parent_edge);
        if (wanted < least) {
            wanted = least;
        }
        set_frame_width(root, nodes, indexes, depth - 1, wanted);
        return;
    }
    int count = parent.kids.size();
    for (int run in 1 .. 3) {
        int room = 0;
        for (int index in 0 .. count) {
            room = room + parent.kids[index].width;
            if (index != position) {
                room = room - min_width(parent.kids[index], 0, is_parent_edge && index == count - 1);
            }
        }
        if (wanted <= room) {
            break;
        }
        if (run == 2 || current.height >= root.height) {
            wanted = room;
            break;
        }
        set_frame_width(root, nodes, indexes, depth - 1, wanted + min_width(parent, 0, is_parent_edge) - WIN_MIN_WIDTH - 1);
    }
    int take = wanted - current.width;
    new_width(current, wanted, false, is_parent_edge && position == count - 1);
    for (int run in 0 .. 2) {
        int spot = position + 1;
        int step = 1;
        if (run == 1) {
            spot = position - 1;
            step = -1;
        }
        while (spot >= 0 && spot < count && take != 0) {
            Node kid = parent.kids[spot];
            bool is_kid_edge = is_parent_edge && spot == count - 1;
            int least = min_width(kid, 0, is_kid_edge);
            if (kid.width - take < least) {
                take = take - (kid.width - least);
                new_width(kid, least, false, is_kid_edge);
            } else {
                new_width(kid, kid.width - take, false, is_kid_edge);
                take = 0;
            }
            spot = spot + step;
        }
    }
}

/// Give window `id` the height (or, `is_vertical`, the width) `size` cells of
/// text, as far as the other windows allow (`:did_resize`, CTRL-W _ | + - < >).
/// False when there is no such window.
pub bool did_resize(Node root, int id, int size, bool is_vertical) {
    List<Node> nodes = [];
    List<int> indexes = [];
    if (!did_find_chain(root, id, nodes, indexes)) {
        return false;
    }
    int depth = nodes.size() - 1;
    int wanted = size;
    if (wanted < 1) {
        wanted = 1;
    }
    if (is_vertical) {
        int separator = 1;
        if (is_chain_edge(nodes, indexes, depth)) {
            separator = 0;
        }
        set_frame_width(root, nodes, indexes, depth, wanted + separator);
    } else {
        set_frame_height(root, nodes, indexes, depth, wanted + 1);
    }
    return true;
}

/// The text height (rows without the status line) of window `id`, 0 if none.
pub int text_height(Node root, int id) {
    List<Node> nodes = [];
    List<int> indexes = [];
    if (!did_find_chain(root, id, nodes, indexes)) {
        return 0;
    }
    return nodes[nodes.size() - 1].height - 1;
}

/// The text width (columns without the separator) of window `id`, 0 if none.
pub int text_width(Node root, int id) {
    List<Node> nodes = [];
    List<int> indexes = [];
    if (!did_find_chain(root, id, nodes, indexes)) {
        return 0;
    }
    int depth = nodes.size() - 1;
    int width = nodes[depth].width;
    if (!is_chain_edge(nodes, indexes, depth)) {
        width = width - 1;
    }
    return width;
}

// ------------------------------------------------------------------ moving

/// The branch whose kid is window `id` (a leaf), or an empty branch.
Node parent_of(Node node, int id) {
    for (Node kid in node.kids) {
        if (is_leaf(kid) && kid.win_id == id) {
            return node;
        }
        if (!is_leaf(kid)) {
            Node found = parent_of(kid, id);
            if (found.kids.size() > 0) {
                return found;
            }
        }
    }
    return Node();
}

// Put the kids of `parent` in a new order: position `position` gets the kid
// that was at `from[position]`. Each window keeps its size; in a row the text
// width travels and the separator column stays at the position (the last
// window of a row at the screen edge has none).
void reorder(Node root, int id, Node parent, List<int> from) {
    int count = parent.kids.size();
    List<Node> turned = [];
    for (int position in 0 .. count) {
        turned.push(parent.kids[from[position]]);
    }
    if (parent.is_vertical) {
        List<Node> nodes = [];
        List<int> indexes = [];
        bool is_edge = false;
        if (did_find_chain(root, id, nodes, indexes)) {
            is_edge = is_chain_edge(nodes, indexes, nodes.size() - 2);
        }
        List<int> text = [];
        for (int position in 0 .. count) {
            int separator = 1;
            if (is_edge && position == count - 1) {
                separator = 0;
            }
            text.push(parent.kids[position].width - separator);
        }
        for (int position in 0 .. count) {
            int separator = 1;
            if (is_edge && position == count - 1) {
                separator = 0;
            }
            turned[position].width = text[from[position]] + separator;
        }
    }
    parent.kids = turned;
}

/// `CTRL-W x`: swap window `id` with the next one in its branch (the previous
/// one when it is the last); each keeps its size. Returns the id of the other
/// window, or 0.
pub int exchange(Node root, int id) {
    Node parent = parent_of(root, id);
    if (parent.kids.size() < 2) {
        return 0;
    }
    int position = 0;
    for (int index in 0 .. parent.kids.size()) {
        if (is_leaf(parent.kids[index]) && parent.kids[index].win_id == id) {
            position = index;
        }
    }
    int other = position + 1;
    if (other >= parent.kids.size()) {
        other = position - 1;
    }
    Node partner = parent.kids[other];
    if (!is_leaf(partner)) {
        return 0;
    }
    List<int> from = [];
    for (int index in 0 .. parent.kids.size()) {
        from.push(index);
    }
    from[position] = other;
    from[other] = position;
    reorder(root, id, parent, from);
    return partner.win_id;
}

/// `CTRL-W r` (`is_down`) and `CTRL-W R`: rotate the windows of the branch
/// that holds `id`; each keeps its own size. False when a kid is not a plain
/// window.
pub bool did_rotate(Node root, int id, bool is_down) {
    Node parent = parent_of(root, id);
    if (parent.kids.size() < 2) {
        return false;
    }
    for (Node kid in parent.kids) {
        if (!is_leaf(kid)) {
            return false;
        }
    }
    int count = parent.kids.size();
    List<int> from = [];
    for (int position in 0 .. count) {
        if (is_down) {
            from.push((position + count - 1) % count);
        } else {
            from.push((position + 1) % count);
        }
    }
    reorder(root, id, parent, from);
    return true;
}

/// `CTRL-W H J K L`: window `id` becomes a full height / width window at an
/// edge (nvim's win_totop). Returns the new root.
pub Node moved_to_edge(Node root, int id, int direction) {
    if (is_leaf(root)) {
        return root;
    }
    bool is_vertical = direction == GO_LEFT || direction == GO_RIGHT;
    bool is_first = direction == GO_LEFT || direction == GO_UP;
    int height_before = text_height(root, id);
    str removed = remove_window(root, id);
    Node rest = normalized(root);
    clear_tags(rest);
    Node fresh = leaf(id);
    List<int> order = leaves(rest);
    int beside = order[order.size() - 1];
    if (is_first) {
        beside = order[0];
    }
    bool is_sized = rest.width > 0 && rest.height > 0;
    Node result = rest;
    if (is_vertical) {
        int new_size = 1;
        int taken = 1;
        if (is_sized) {
            new_size = text_width(rest, beside) / 2;
            int minimum = min_width(rest, 0, true);
            if (new_size > rest.width - minimum - 1) {
                new_size = rest.width - minimum - 1;
            }
            if (new_size < WIN_MIN_WIDTH) {
                new_size = WIN_MIN_WIDTH;
            }
            taken = new_size;
            if (is_first) {
                taken = new_size + 1;
            }
            fresh.width = taken;
            fresh.height = rest.height;
        }
        if (rest.is_vertical) {
            Node side = rest.kids[rest.kids.size() - 1];
            int spot = rest.kids.size();
            if (is_first) {
                side = rest.kids[0];
                spot = 0;
            }
            if (is_sized) {
                new_width(side, side.width - taken, is_first, false);
            }
            rest.kids.insert(spot, fresh);
        } else {
            int whole = rest.width;
            if (is_sized) {
                new_width(rest, rest.width - taken, is_first, is_first);
            }
            result = Node(is_vertical: true, kids: pair(rest, fresh, !is_first));
            result.width = whole;
            result.height = rest.height;
        }
    } else {
        int new_size = 1;
        if (is_sized) {
            new_size = (text_height(rest, beside)) / 2;
            int minimum = min_height(rest, 0);
            if (new_size > rest.height - minimum - 1) {
                new_size = rest.height - minimum - 1;
            }
            if (new_size < WIN_MIN_HEIGHT) {
                new_size = WIN_MIN_HEIGHT;
            }
            fresh.height = new_size + 1;
            fresh.width = rest.width;
        }
        if (!rest.is_vertical && !is_leaf(rest)) {
            Node side = rest.kids[rest.kids.size() - 1];
            int spot = rest.kids.size();
            if (is_first) {
                side = rest.kids[0];
                spot = 0;
            }
            if (is_sized) {
                new_height(side, side.height - fresh.height, is_first);
            }
            rest.kids.insert(spot, fresh);
        } else {
            int whole = rest.height;
            if (is_sized) {
                new_height(rest, rest.height - fresh.height, is_first);
            }
            result = Node(is_vertical: false, kids: pair(rest, fresh, !is_first));
            result.width = rest.width;
            result.height = whole;
        }
    }
    if (is_sized) {
        str direction_char = "h";
        if (is_vertical) {
            if (removed == "v") {
                direction_char = "b";
            }
        } else {
            direction_char = "v";
            if (removed == "h") {
                direction_char = "b";
            }
        }
        equal_tree(result, id, true, direction_char);
        if (!is_vertical) {
            did_resize(result, id, height_before, false);
            equal_tree(result, id, true, "v");
        }
    }
    return result;
}

/// The tab page whose label the column `x` of the tab line falls on, or -1. The labels are drawn as ` label ` one
/// after the other from column 0 (MED_app.draw_tabline); one the line has no room for is not drawn, so not hit.
pub int tab_at(List<str> labels, int width, int x) {
    int start = 0;
    for (int index in 0 .. labels.size()) {
        int size = MED_text.line_width(" " + labels[index] + " ", 4);
        if (start + size > width) {
            return -1;
        }
        if (x >= start && x < start + size) {
            return index;
        }
        start = start + size;
    }
    return -1;
}
