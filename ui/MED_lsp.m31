// A minimal Language Server Protocol client: JSON-RPC over a child process's
// pipes (stdlib `proc`), no threads. The front end calls `Server.poll` from
// its tick and `Server.request` / `Server.notify` from its commands.
//
// API
// ---
//   MED_lsp.Server                    one running language server
//   MED_lsp.start(name, argv, root)   Server (is_dead when it cannot start)
//   server.request(method, parameters)    id of the request sent
//   server.notify(method, parameters)     a notification
//   server.poll()                     List<Message> that arrived (never blocks)
//   server.stop()                     shutdown, exit, kill
//   MED_lsp.uri_of(path), path_of(uri)         file:// URIs
//   MED_lsp.byte_of(line, units)      a UTF-16 column to a byte offset
//   MED_lsp.units_of(line, byte)      a byte offset to a UTF-16 column
//   MED_lsp.diagnostics_of(parameters)    the diagnostics of a publishDiagnostics
//   MED_lsp.edits_of(value)           TextEdits from a result
//
// What is deliberately not here: incremental sync (the whole text is sent),
// semantic tokens, completion, workspace folders, dynamic registration. The
// servers a user is likely to run (rust-analyzer, gopls, pyright, clangd,
// typescript-language-server, lua-language-server, marksman) all work with
// full-document sync and the requests below.

import encoding.json;
import io;
import os;
import proc;
import timer;

pub type Diagnostic {
    pub int row;
    pub int col;
    pub int end_row;
    pub int end_col;
    /// 1 error, 2 warning, 3 information, 4 hint
    pub int severity;
    pub str message;
}

/// One message from the server.
pub type Message {
    /// "response", "notification" or "request"
    pub str kind;
    pub int id = 0;
    /// The id exactly as the server wrote it (a number or a string), for the reply.
    pub json.Value id_value = json.Value.Null;
    pub str method = "";
    /// `result` of a response, `parameters` of the others.
    pub json.Value body = json.Value.Null;
    pub bool is_error = false;
    pub str error_text = "";
    pub int error_code = 0;
}

// ---------------------------------------------------------------- JSON helpers

/// An object from parallel key and value lists.
pub json.Value object(List<str> keys, List<json.Value> values) {
    Map<str, json.Value> members = {};
    for (int index in 0 .. keys.size()) {
        members.set(keys[index], values[index]);
    }
    return json.Value.Object(members);
}

pub json.Value text(str value) {
    return json.Value.Str(value);
}

pub json.Value number(int value) {
    return json.Value.Int(value);
}

pub json.Value position_value(int line, int character) {
    return object(["line", "character"], [number(line), number(character)]);
}

/// The member `key` of an object; Null when it is not one or has no such key.
pub json.Value member(json.Value value, str key) {
    match (value) {
        case Object(Map<str, json.Value> members): {
            return members.get(key).or(json.Value.Null);
        }
        case Null: {
            return json.Value.Null;
        }
        case Bool(bool flag): {
            return json.Value.Null;
        }
        case Int(int whole): {
            return json.Value.Null;
        }
        case Float(float real): {
            return json.Value.Null;
        }
        case Str(str words): {
            return json.Value.Null;
        }
        case Array(List<json.Value> items): {
            return json.Value.Null;
        }
    }
}

/// The text of a string value, "" for anything else.
pub str text_of(json.Value value) {
    match (value) {
        case Str(str words): {
            return words;
        }
        case Null: {
            return "";
        }
        case Bool(bool flag): {
            return "";
        }
        case Int(int whole): {
            return "";
        }
        case Float(float real): {
            return "";
        }
        case Array(List<json.Value> items): {
            return "";
        }
        case Object(Map<str, json.Value> members): {
            return "";
        }
    }
}

pub int int_of(json.Value value, int fallback) {
    match (value) {
        case Int(int whole): {
            return whole;
        }
        case Null: {
            return fallback;
        }
        case Bool(bool flag): {
            return fallback;
        }
        case Float(float real): {
            return fallback;
        }
        case Str(str words): {
            return fallback;
        }
        case Array(List<json.Value> items): {
            return fallback;
        }
        case Object(Map<str, json.Value> members): {
            return fallback;
        }
    }
}

/// The elements of an array value; empty for anything else.
pub List<json.Value> items_of(json.Value value) {
    match (value) {
        case Array(List<json.Value> items): {
            return items;
        }
        case Null: {
            return [];
        }
        case Bool(bool flag): {
            return [];
        }
        case Int(int whole): {
            return [];
        }
        case Float(float real): {
            return [];
        }
        case Str(str words): {
            return [];
        }
        case Object(Map<str, json.Value> members): {
            return [];
        }
    }
}

pub bool is_null(json.Value value) {
    match (value) {
        case Null: {
            return true;
        }
        case Bool(bool flag): {
            return false;
        }
        case Int(int whole): {
            return false;
        }
        case Float(float real): {
            return false;
        }
        case Str(str words): {
            return false;
        }
        case Array(List<json.Value> items): {
            return false;
        }
        case Object(Map<str, json.Value> members): {
            return false;
        }
    }
}

/// Whether a value is the boolean true (false for anything else, null included).
pub bool is_true(json.Value value) {
    match (value) {
        case Bool(bool flag): {
            return flag;
        }
        case Null: {
            return false;
        }
        case Int(int whole): {
            return false;
        }
        case Float(float real): {
            return false;
        }
        case Str(str words): {
            return false;
        }
        case Array(List<json.Value> items): {
            return false;
        }
        case Object(Map<str, json.Value> members): {
            return false;
        }
    }
}

// ---------------------------------------------------------------- framing

/// `body` with its Content-Length header.
pub str frame(str body) {
    return "Content-Length: " + body.size().to_str() + "\r\n\r\n" + body;
}

/// Collects the bytes a server writes and hands out complete message bodies.
pub type Reader {
    bytes buffer = [];
}

/// Add `data`; the complete bodies now available.
pub List<str> Reader.feed(bytes data) {
    buffer.extend(data);
    List<str> bodies = [];
    while (true) {
        match (buffer.index_of("\r\n\r\n".to_bytes())) {
            case Some(int header_end): {
                bytes header = buffer.substr(0, header_end);
                int length = -1;
                match (header.utf8()) {
                    case Some(str header_text): {
                        for (str line in header_text.split("\r\n")) {
                            str lower = line.to_lower();
                            if (lower.starts_with("content-length:")) {
                                length = line.substr(15, line.size()).trim().parse_int().or(-1);
                            }
                        }
                    }
                    case None: {
                    }
                }
                if (length < 0) {
                    // a header we cannot use: drop it and look for the next
                    buffer.drop_front(header_end + 4);
                    continue;
                }
                int total = header_end + 4 + length;
                if (buffer.size() < total) {
                    return bodies;
                }
                bytes body = buffer.substr(header_end + 4, total);
                buffer.drop_front(total);
                match (body.utf8()) {
                    case Some(str body_text): {
                        bodies.push(body_text);
                    }
                    case None: {
                    }
                }
            }
            case None: {
                return bodies;
            }
        }
    }
}

/// A decoded message; `kind` is "" when the body is not JSON-RPC.
pub Message decode(str body) {
    match (json.parse(body)) {
        case Ok(json.Value value): {
            json.Value method = member(value, "method");
            json.Value id = member(value, "id");
            if (!is_null(method)) {
                Message message = Message("notification");
                message.method = text_of(method);
                message.body = member(value, "params");
                if (!is_null(id)) {
                    message.kind = "request";
                    message.id = int_of(id, 0);
                    message.id_value = id;
                }
                return message;
            }
            if (!is_null(id)) {
                Message message = Message("response");
                message.id = int_of(id, 0);
                json.Value problem = member(value, "error");
                if (!is_null(problem)) {
                    message.is_error = true;
                    message.error_text = text_of(member(problem, "message"));
                    message.error_code = int_of(member(problem, "code"), 0);
                }
                message.body = member(value, "result");
                return message;
            }
            return Message("");
        }
        case Err(json.Error error): {
            return Message("");
        }
    }
}

// ---------------------------------------------------------------- positions, URIs

/// `path` as a file:// URI (the characters a URI cannot hold are %-escaped).
pub str uri_of(str path) {
    str absolute = path;
    str out = "file://";
    for (int byte in absolute.to_bytes()) {
        bool is_plain = (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 47 || byte == 45 || byte == 46 || byte == 95 || byte == 126 || byte == 58;
        if (is_plain) {
            out = out + str.from_chars([byte]);
        } else {
            out = out + "%" + hex_digit(byte / 16) + hex_digit(byte % 16);
        }
    }
    return out;
}

str hex_digit(int value) {
    return "0123456789ABCDEF".substr(value, value + 1);
}

/// The path a file:// URI names ("" for any other kind of URI).
pub str path_of(str uri) {
    if (!uri.starts_with("file://")) {
        return "";
    }
    bytes raw = uri.substr(7, uri.size()).to_bytes();
    bytes out = [];
    int index = 0;
    while (index < raw.size()) {
        if (raw[index] == 37 && index + 2 < raw.size()) {
            int high = hex_value(raw[index + 1]);
            int low = hex_value(raw[index + 2]);
            if (high >= 0 && low >= 0) {
                out.push(high * 16 + low);
                index = index + 3;
                continue;
            }
        }
        out.push(raw[index]);
        index = index + 1;
    }
    return out.utf8().or("");
}

int hex_value(int byte) {
    if (byte >= 48 && byte <= 57) {
        return byte - 48;
    }
    if (byte >= 65 && byte <= 70) {
        return byte - 55;
    }
    if (byte >= 97 && byte <= 102) {
        return byte - 87;
    }
    return -1;
}

/// The byte offset of UTF-16 column `units` in `line` (clamped to the line).
pub int byte_of(str line, int units) {
    int used = 0;
    int offset = 0;
    for (int code_point in line.chars()) {
        if (used >= units) {
            return offset;
        }
        offset = offset + str.from_chars([code_point]).size();
        used = used + 1;
        if (code_point > 65535) {
            used = used + 1;
        }
    }
    return offset;
}

/// The UTF-16 column of byte offset `byte` in `line`.
pub int units_of(str line, int byte) {
    int units = 0;
    int offset = 0;
    for (int code_point in line.chars()) {
        if (offset >= byte) {
            return units;
        }
        offset = offset + str.from_chars([code_point]).size();
        units = units + 1;
        if (code_point > 65535) {
            units = units + 1;
        }
    }
    return units;
}

// ---------------------------------------------------------------- results

/// The diagnostics of a `textDocument/publishDiagnostics` notification, with
/// positions as (line, UTF-16 column): the caller converts to bytes with the
/// buffer text it has.
pub List<Diagnostic> diagnostics_of(json.Value parameters) {
    List<Diagnostic> out = [];
    for (json.Value item in items_of(member(parameters, "diagnostics"))) {
        json.Value range = member(item, "range");
        json.Value from_value = member(range, "start");
        json.Value to_value = member(range, "end");
        int severity = int_of(member(item, "severity"), 1);
        out.push(Diagnostic(int_of(member(from_value, "line"), 0), int_of(member(from_value, "character"), 0), int_of(member(to_value, "line"), 0), int_of(member(to_value, "character"), 0), severity, text_of(member(item, "message"))));
    }
    return out;
}

/// A text edit: a range in (line, UTF-16 column) and the replacement.
pub type TextEdit {
    pub int line;
    pub int character;
    pub int end_line;
    pub int end_character;
    pub str new_text;
}

/// TextEdits of an array value (a `textDocument/formatting` result, or the
/// edits of one file in a WorkspaceEdit).
pub List<TextEdit> edits_of(json.Value value) {
    List<TextEdit> out = [];
    for (json.Value item in items_of(value)) {
        json.Value range = member(item, "range");
        json.Value from_value = member(range, "start");
        json.Value to_value = member(range, "end");
        out.push(TextEdit(int_of(member(from_value, "line"), 0), int_of(member(from_value, "character"), 0), int_of(member(to_value, "line"), 0), int_of(member(to_value, "character"), 0), text_of(member(item, "newText"))));
    }
    return out;
}

/// UTF-16 units of `text`.
pub int utf16_size(str text) {
    return units_of(text, text.size());
}

int count_of(str text, str piece) {
    return text.split(piece).size() - 1;
}

/// Where the point (line, character) of the original document is after `edits` (all in original coordinates,
/// as the LSP defines them) are applied: edits that end at or before the point move it, the rest leave it.
pub List<int> map_point(List<TextEdit> edits, int line, int character) {
    List<TextEdit> ordered = [];
    for (TextEdit one in edits) {
        if (one.end_line > line || (one.end_line == line && one.end_character > character)) {
            continue;
        }
        int place = ordered.size();
        for (int index in 0 .. ordered.size()) {
            TextEdit other = ordered[index];
            if (one.line < other.line || (one.line == other.line && one.character < other.character)) {
                place = index;
                break;
            }
        }
        ordered.insert(place, one);
    }
    int moved_lines = 0;
    int shift = 0;
    for (TextEdit one in ordered) {
        int added = count_of(one.new_text, "\n");
        moved_lines = moved_lines + added - (one.end_line - one.line);
        if (one.end_line == line) {
            if (added > 0) {
                List<str> parts = one.new_text.split("\n");
                shift = utf16_size(parts[parts.size() - 1]) - one.end_character;
            } else if (one.line == one.end_line) {
                shift = shift + utf16_size(one.new_text) - (one.end_character - one.character);
            } else {
                shift = one.character + utf16_size(one.new_text) - one.end_character;
            }
        }
    }
    return [line + moved_lines, character + shift];
}

// ---------------------------------------------------------------- incremental sync

// Row `index` of a document whose text ends with a line break: the row after the last line is empty.
str row_at(List<str> lines, int index) {
    if (index >= lines.size()) {
        return "";
    }
    return lines[index];
}

/// The one change that turns the document `before` (lines; its text is the lines joined with line breaks and a
/// final one) into `after`, as a `TextDocumentContentChangeEvent` (a range in UTF-16 columns and the new text);
/// null when they are the same. The range spans only what differs: the common leading and trailing rows are
/// left out, then the common leading and trailing characters of the first and last row that differ.
pub json.Value change_of(List<str> before, List<str> after) {
    int old_rows = before.size() + 1;
    int new_rows = after.size() + 1;
    int limit = old_rows;
    if (new_rows < limit) {
        limit = new_rows;
    }
    int head = 0;
    while (head < limit - 1 && row_at(before, head) == row_at(after, head)) {
        head = head + 1;
    }
    int tail = 0;
    while (tail < limit - head && row_at(before, old_rows - 1 - tail) == row_at(after, new_rows - 1 - tail)) {
        tail = tail + 1;
    }
    int old_end = old_rows - tail;
    int new_end = new_rows - tail;
    if (old_end == head && new_end == head) {
        return json.Value.Null;
    }
    if (old_end == head) {
        // rows were inserted before row `head`
        List<str> inserted = [];
        for (int index in head .. new_end) {
            inserted.push(row_at(after, index));
        }
        return change_event(position_value(head, 0), position_value(head, 0), inserted.join("\n") + "\n");
    }
    if (new_end == head) {
        // rows head .. old_end were removed
        return change_event(position_value(head, 0), position_value(old_end, 0), "");
    }
    List<int> first_old = row_at(before, head).chars();
    List<int> first_new = row_at(after, head).chars();
    List<int> last_old = row_at(before, old_end - 1).chars();
    List<int> last_new = row_at(after, new_end - 1).chars();
    int prefix = 0;
    while (prefix < first_old.size() && prefix < first_new.size() && first_old[prefix] == first_new[prefix]) {
        prefix = prefix + 1;
    }
    int room_old = last_old.size();
    if (old_end - 1 == head) {
        room_old = room_old - prefix;
    }
    int room_new = last_new.size();
    if (new_end - 1 == head) {
        room_new = room_new - prefix;
    }
    int suffix = 0;
    while (suffix < room_old && suffix < room_new && last_old[last_old.size() - 1 - suffix] == last_new[last_new.size() - 1 - suffix]) {
        suffix = suffix + 1;
    }
    str start_head = str.from_chars(first_old.slice(0, prefix));
    int start_units = utf16_size(start_head);
    int end_units = utf16_size(str.from_chars(last_old.slice(0, last_old.size() - suffix)));
    List<str> pieces = [];
    for (int index in head .. new_end) {
        pieces.push(row_at(after, index));
    }
    str first_piece = str.from_chars(first_new.slice(prefix, first_new.size()));
    if (pieces.size() == 1) {
        first_piece = str.from_chars(first_new.slice(prefix, first_new.size() - suffix));
        pieces[0] = first_piece;
    } else {
        pieces[0] = first_piece;
        pieces[pieces.size() - 1] = str.from_chars(last_new.slice(0, last_new.size() - suffix));
    }
    return change_event(position_value(head, start_units), position_value(old_end - 1, end_units), pieces.join("\n"));
}

json.Value change_event(json.Value from_value, json.Value to_value, str replacement) {
    return object(["range", "text"], [object(["start", "end"], [from_value, to_value]), text(replacement)]);
}

// ---------------------------------------------------------------- workspace edits

/// One step of a WorkspaceEdit, in order: kind "edit" (a file's text edits, `version` the document version the
/// server saw or -1), "create", "rename" (`path` to `target`) or "delete".
pub type FileOp {
    pub str kind;
    pub str path;
    pub str target = "";
    pub List<TextEdit> edits = [];
    pub int version = -1;
    pub bool is_overwrite = false;
    pub bool is_ignored = false;
}

/// The steps of a WorkspaceEdit: `documentChanges` (text document edits and create / rename / delete
/// operations) when it has them, else `changes`.
pub List<FileOp> workspace_ops(json.Value edit) {
    List<FileOp> out = [];
    List<json.Value> changes = items_of(member(edit, "documentChanges"));
    if (changes.size() == 0) {
        for (FileEdits one in workspace_edits(edit)) {
            FileOp step = FileOp("edit", one.path);
            step.edits = one.edits;
            out.push(step);
        }
        return out;
    }
    for (json.Value change in changes) {
        str kind = text_of(member(change, "kind"));
        json.Value options = member(change, "options");
        if (kind == "create" || kind == "delete") {
            FileOp step = FileOp(kind, path_of(text_of(member(change, "uri"))));
            step.is_overwrite = is_true(member(options, "overwrite")) || is_true(member(options, "recursive"));
            step.is_ignored = is_true(member(options, "ignoreIfExists")) || is_true(member(options, "ignoreIfNotExists"));
            out.push(step);
        } else if (kind == "rename") {
            FileOp step = FileOp(kind, path_of(text_of(member(change, "oldUri"))));
            step.target = path_of(text_of(member(change, "newUri")));
            step.is_overwrite = is_true(member(options, "overwrite"));
            step.is_ignored = is_true(member(options, "ignoreIfExists"));
            out.push(step);
        } else {
            json.Value document = member(change, "textDocument");
            str uri = text_of(member(document, "uri"));
            if (uri.size() > 0) {
                FileOp step = FileOp("edit", path_of(uri));
                step.edits = edits_of(member(change, "edits"));
                step.version = int_of(member(document, "version"), -1);
                out.push(step);
            }
        }
    }
    return out;
}

/// A location: file path, line and UTF-16 column (path "" when the value is
/// not one). Accepts Location and LocationLink.
pub type Place {
    pub str path;
    pub int line;
    pub int character;
}

pub Place place_of(json.Value value) {
    json.Value uri = member(value, "uri");
    json.Value range = member(value, "range");
    if (is_null(uri)) {
        uri = member(value, "targetUri");
        range = member(value, "targetSelectionRange");
    }
    json.Value from_value = member(range, "start");
    return Place(path_of(text_of(uri)), int_of(member(from_value, "line"), 0), int_of(member(from_value, "character"), 0));
}

/// Locations of a result (one Location, an array, or null).
pub List<Place> places_of(json.Value value) {
    List<Place> out = [];
    List<json.Value> items = items_of(value);
    if (items.size() == 0 && !is_null(value)) {
        Place single = place_of(value);
        if (single.path.size() > 0) {
            out.push(single);
        }
        return out;
    }
    for (json.Value item in items) {
        Place one = place_of(item);
        if (one.path.size() > 0) {
            out.push(one);
        }
    }
    return out;
}

/// The text of a hover result: a string, MarkedString(s) or MarkupContent.
pub str hover_text(json.Value value) {
    json.Value contents = member(value, "contents");
    if (is_null(contents)) {
        return "";
    }
    List<json.Value> items = items_of(contents);
    if (items.size() > 0) {
        List<str> parts = [];
        for (json.Value item in items) {
            str piece = text_of(item);
            if (piece.size() == 0) {
                piece = text_of(member(item, "value"));
            }
            if (piece.size() > 0) {
                parts.push(piece);
            }
        }
        return parts.join("\n\n");
    }
    str plain = text_of(contents);
    if (plain.size() > 0) {
        return plain;
    }
    return text_of(member(contents, "value"));
}

/// The edits of a WorkspaceEdit as (path, edits) pairs.
pub type FileEdits {
    pub str path;
    pub List<TextEdit> edits;
}

pub List<FileEdits> workspace_edits(json.Value edit) {
    List<FileEdits> out = [];
    json.Value changes = member(edit, "changes");
    match (changes) {
        case Object(Map<str, json.Value> members): {
            for (str uri in members.keys()) {
                out.push(FileEdits(path_of(uri), edits_of(members.get(uri).or(json.Value.Null))));
            }
        }
        case Null: {
        }
        case Bool(bool flag): {
        }
        case Int(int whole): {
        }
        case Float(float real): {
        }
        case Str(str words): {
        }
        case Array(List<json.Value> items): {
        }
    }
    for (json.Value document in items_of(member(edit, "documentChanges"))) {
        json.Value uri = member(member(document, "textDocument"), "uri");
        if (!is_null(uri)) {
            out.push(FileEdits(path_of(text_of(uri)), edits_of(member(document, "edits"))));
        }
    }
    return out;
}

/// `new_text` applied to `lines` by `edits` (any order; later ranges first so
/// earlier positions stay valid). Positions are UTF-16 columns.
pub List<str> apply_edits(List<str> lines, List<TextEdit> edits) {
    List<TextEdit> ordered = [];
    for (TextEdit one in edits) {
        int place = ordered.size();
        for (int index in 0 .. ordered.size()) {
            TextEdit other = ordered[index];
            if (one.line > other.line || (one.line == other.line && one.character > other.character)) {
                place = index;
                break;
            }
        }
        ordered.insert(place, one);
    }
    List<str> result = lines.slice(0, lines.size());
    if (result.size() == 0) {
        result.push("");
    }
    for (TextEdit one in ordered) {
        int first = one.line;
        int last = one.end_line;
        if (first >= result.size()) {
            first = result.size() - 1;
            last = first;
        }
        if (last >= result.size()) {
            last = result.size() - 1;
        }
        str head = result[first];
        str tail = result[last];
        int start_byte = byte_of(head, one.character);
        int end_byte = byte_of(tail, one.end_character);
        if (one.end_line >= lines.size()) {
            end_byte = tail.size();
        }
        str inserted = one.new_text;
        if (one.end_line >= lines.size() && inserted.ends_with("\n")) {
            // the edit runs to the end of the document, whose last line break
            // is not a line of its own here
            inserted = inserted.substr(0, inserted.size() - 1);
        }
        str replaced = head.substr(0, start_byte) + inserted + tail.substr(end_byte, tail.size());
        List<str> pieces = replaced.split("\n");
        List<str> next = result.slice(0, first);
        for (str piece in pieces) {
            next.push(piece);
        }
        for (int index in last + 1 .. result.size()) {
            next.push(result[index]);
        }
        result = next;
    }
    return result;
}

// ---------------------------------------------------------------- the process

pub type Server {
    pub str name;
    pub List<str> argv;
    pub str root;
    List<proc.Proc> children = [];
    Reader reader = Reader();
    pub bool is_dead = true;
    /// The `initialize` answer arrived.
    pub bool is_ready = false;
    pub int next_id = 1;
    pub int initialize_id = 0;
    /// Documents opened (path -> version).
    pub Map<str, int> versions = {};
    /// The `capabilities` of the initialize answer (Null until it arrives).
    pub json.Value capabilities = json.Value.Null;
    /// The last bytes the server wrote to standard error (it is drained, never
    /// closed: a closed stderr kills servers that log, clangd among them).
    pub str log = "";
    /// What the server says it is busy with ($/progress), "" when idle.
    pub str progress = "";
    /// Progress tokens in flight (token text -> title).
    pub Map<str, str> tokens = {};
    /// Why the server stopped, when it did by itself.
    pub str exit_note = "";
    /// Messages that arrived while `await` waited for another one; `poll` returns them first.
    List<Message> backlog = [];
    /// The text the server has of each open document (path -> lines), the base of the next incremental change.
    Map<str, List<str>> snapshots = {};
    /// `client/registerCapability` ids -> the capability key they set (and what it was before).
    Map<str, str> registered = {};
    Map<str, json.Value> replaced = {};
    /// A dynamically registered `textDocument/didChange` sync kind (-1: none registered).
    int synced = -1;
    /// Ids of `workspace/didChangeWatchedFiles` registrations.
    pub List<str> watchers = [];
}

void Server.transmit(str body) {
    if (is_dead || children.size() == 0) {
        return;
    }
    children[0].stdin.set_deadline_ns(timer.monotonic_ns() + 1000000000);
    match (children[0].stdin.write(frame(body).to_bytes())) {
        case Ok(int count): {
        }
        case Err(io.Error error): {
            is_dead = true;
        }
    }
}

/// Send a request; its id.
pub int Server.request(str method, json.Value parameters) {
    int id = next_id;
    next_id = next_id + 1;
    json.Value message = object(["jsonrpc", "id", "method", "params"], [text("2.0"), number(id), text(method), parameters]);
    transmit(encode(message));
    return id;
}

pub void Server.notify(str method, json.Value parameters) {
    json.Value message = object(["jsonrpc", "method", "params"], [text("2.0"), text(method), parameters]);
    transmit(encode(message));
}

/// An answer to a request the server made (`workspace/applyEdit` ...).
pub void Server.respond(int id, json.Value result) {
    json.Value message = object(["jsonrpc", "id", "result"], [text("2.0"), number(id), result]);
    transmit(encode(message));
}

/// An answer to a request, with the id as the server wrote it.
pub void Server.respond_to(Message request, json.Value result) {
    json.Value message = object(["jsonrpc", "id", "result"], [text("2.0"), request.id_value, result]);
    transmit(encode(message));
}

/// Whether the server announced support for `feature` (a capability key such
/// as "renameProvider"); true when the capabilities are not known yet.
pub bool Server.can_do(str feature) {
    if (is_null(capabilities)) {
        return true;
    }
    json.Value value = member(capabilities, feature);
    match (value) {
        case Null: {
            return false;
        }
        case Bool(bool flag): {
            return flag;
        }
        case Int(int whole): {
            return true;
        }
        case Float(float real): {
            return true;
        }
        case Str(str words): {
            return true;
        }
        case Array(List<json.Value> items): {
            return true;
        }
        case Object(Map<str, json.Value> members): {
            return true;
        }
    }
}

/// How the server wants document changes: 2 incremental, 1 the whole text (also when it says nothing, as
/// before), after `textDocumentSync` or a dynamic registration.
pub int Server.sync_kind() {
    if (synced >= 0) {
        return synced;
    }
    json.Value sync = member(capabilities, "textDocumentSync");
    int kind = int_of(sync, -1);
    if (kind < 0) {
        kind = int_of(member(sync, "change"), 1);
    }
    if (kind == 2) {
        return 2;
    }
    return 1;
}

/// `textDocument/didOpen` for `key` (a path) with the buffer `lines`; the text becomes the base of later changes.
pub void Server.did_open(str key, str language, List<str> lines) {
    versions.set(key, 1);
    snapshots.set(key, lines.slice(0, lines.size()));
    notify("textDocument/didOpen", object(["textDocument"], [object(["uri", "languageId", "version", "text"], [text(uri_of(key)), text(language), number(1), text(lines.join("\n") + "\n")])]));
}

/// `textDocument/didChange` for `key` after its buffer became `lines`: one ranged change when the server
/// announced incremental sync and the previous text is known, else the whole text. Nothing is sent (and the
/// version stays) when the text is the same as the server's.
pub void Server.did_change(str key, List<str> lines) {
    json.Value event = json.Value.Null;
    bool is_incremental = sync_kind() == 2 && snapshots.contains(key);
    if (is_incremental) {
        event = change_of(snapshots.get(key).or([]), lines);
        if (is_null(event)) {
            return;
        }
    } else {
        event = object(["text"], [text(lines.join("\n") + "\n")]);
    }
    int version = versions.get(key).or(1) + 1;
    versions.set(key, version);
    snapshots.set(key, lines.slice(0, lines.size()));
    notify("textDocument/didChange", object(["textDocument", "contentChanges"], [object(["uri", "version"], [text(uri_of(key)), number(version)]), json.Value.Array([event])]));
}

// `capabilities` with `key` set to `value` (or removed when `value` is None-like: the Null value).
void Server.set_capability(str key, json.Value value) {
    Map<str, json.Value> copy = {};
    match (capabilities) {
        case Object(Map<str, json.Value> members): {
            for (str member_name in members.keys()) {
                copy.set(member_name, members.get(member_name).or(json.Value.Null));
            }
        }
        case Null: {
        }
        case Bool(bool flag): {
        }
        case Int(int whole): {
        }
        case Float(float real): {
        }
        case Str(str words): {
        }
        case Array(List<json.Value> items): {
        }
    }
    if (is_null(value)) {
        copy.remove(key);
    } else {
        copy.set(key, value);
    }
    capabilities = json.Value.Object(copy);
}

/// `client/registerCapability`: every registration of a method that is a capability sets it (so `can_do` and the
/// trigger characters see it); `textDocument/didChange` sets the sync kind; `workspace/didChangeWatchedFiles` is
/// remembered (the client then reports saved, created and deleted files).
pub void Server.register(json.Value parameters) {
    for (json.Value one in items_of(member(parameters, "registrations"))) {
        str id = text_of(member(one, "id"));
        str method = text_of(member(one, "method"));
        json.Value options = member(one, "registerOptions");
        if (method == "textDocument/didChange") {
            synced = int_of(member(options, "syncKind"), 1);
            registered.set(id, "!sync");
            continue;
        }
        if (method == "workspace/didChangeWatchedFiles") {
            watchers.push(id);
            registered.set(id, "!watch");
            continue;
        }
        str key = capability_key(method);
        if (key.size() == 0) {
            continue;
        }
        if (is_null(options)) {
            options = json.Value.Bool(true);
        }
        replaced.set(id, member(capabilities, key));
        registered.set(id, key);
        set_capability(key, options);
    }
}

/// `client/unregisterCapability`: undo what the registration set (the static value comes back).
pub void Server.unregister(json.Value parameters) {
    for (json.Value one in items_of(member(parameters, "unregisterations"))) {
        str id = text_of(member(one, "id"));
        str key = registered.get(id).or("");
        if (key.size() == 0) {
            continue;
        }
        registered.remove(id);
        if (key == "!sync") {
            synced = -1;
        } else if (key == "!watch") {
            List<str> kept = [];
            for (str other in watchers) {
                if (other != id) {
                    kept.push(other);
                }
            }
            watchers = kept;
        } else {
            set_capability(key, replaced.get(id).or(json.Value.Null));
            replaced.remove(id);
        }
    }
}

/// `workspace/didChangeWatchedFiles` for the files in `paths` (change type 1 created, 2 changed, 3 deleted),
/// when the server registered for it.
pub void Server.report_files(List<str> paths, List<int> kinds) {
    if (watchers.size() == 0 || is_dead) {
        return;
    }
    List<json.Value> changes = [];
    for (int index in 0 .. paths.size()) {
        changes.push(object(["uri", "type"], [text(uri_of(paths[index])), number(kinds[index])]));
    }
    notify("workspace/didChangeWatchedFiles", object(["changes"], [json.Value.Array(changes)]));
}

/// The characters after which the server wants completion requested (its `completionProvider`).
pub List<str> Server.trigger_characters() {
    List<str> out = [];
    for (json.Value one in items_of(member(member(capabilities, "completionProvider"), "triggerCharacters"))) {
        out.push(text_of(one));
    }
    return out;
}

/// Whether typing `typed` commits the selected completion item `item` (its own `commitCharacters`, else the
/// server's `allCommitCharacters`).
pub bool Server.is_commit_character(json.Value item, str typed) {
    List<json.Value> own = items_of(member(item, "commitCharacters"));
    if (own.size() == 0) {
        own = items_of(member(member(capabilities, "completionProvider"), "allCommitCharacters"));
    }
    for (json.Value one in own) {
        if (text_of(one) == typed) {
            return true;
        }
    }
    return false;
}

// Read and keep the tail of what the server wrote to standard error.
void Server.drain_log() {
    if (children.size() == 0) {
        return;
    }
    for (int round in 0 .. 4) {
        children[0].stderr.set_deadline_ns(timer.monotonic_ns() + 1000);
        match (children[0].stderr.read(65536)) {
            case Ok(bytes data): {
                if (data.size() == 0) {
                    return;
                }
                str piece = data.utf8().or("");
                log = log + piece;
                if (log.size() > 4000) {
                    log = log.substr(log.size() - 4000, log.size());
                }
            }
            case Err(io.Error error): {
                return;
            }
        }
    }
}

/// The messages that have arrived (those `await` set aside first).
pub List<Message> Server.poll() {
    List<Message> out = backlog;
    backlog = [];
    for (Message one in read_messages(20000)) {
        out.push(one);
    }
    return out;
}

// Read what the server wrote, waiting at most `wait_ns` for the first bytes.
List<Message> Server.read_messages(int wait_ns) {
    List<Message> out = [];
    if (is_dead || children.size() == 0) {
        return out;
    }
    drain_log();
    int rounds = 0;
    int wait = wait_ns;
    while (rounds < 16) {
        rounds = rounds + 1;
        children[0].stdout.set_deadline_ns(timer.monotonic_ns() + wait);
        wait = 20000;
        match (children[0].stdout.read(65536)) {
            case Ok(bytes data): {
                if (data.size() == 0) {
                    is_dead = true;
                    drain_log();
                    exit_note = "the server exited";
                    break;
                }
                for (str body in reader.feed(data)) {
                    Message message = decode(body);
                    if (message.kind.size() > 0) {
                        out.push(message);
                    }
                }
            }
            case Err(io.Error error): {
                break;
            }
        }
    }
    return out;
}

/// Wait up to `timeout_ms` for the response to request `id`. Everything else that arrives meanwhile is kept
/// for the next `poll`. None when the time ran out or the server died.
pub Option<Message> Server.await(int id, int timeout_ms) {
    int deadline = timer.monotonic_ns() + timeout_ms * 1000000;
    Option<Message> found = Option<Message>.None;
    while (!is_dead && timer.monotonic_ns() < deadline) {
        for (Message one in read_messages(2000000)) {
            if (found.is_none() && one.kind == "response" && one.id == id) {
                found = Option<Message>.Some(one);
            } else {
                backlog.push(one);
            }
        }
        if (found.is_some()) {
            break;
        }
    }
    return found;
}

/// Tell the server the answer to request `id` is no longer wanted (`$/cancelRequest`).
pub void Server.cancel(int id) {
    notify("$/cancelRequest", object(["id"], [number(id)]));
}

/// Ask the server to shut down, then kill it.
pub void Server.stop() {
    if (!is_dead && children.size() > 0) {
        int id = request("shutdown", json.Value.Null);
        notify("exit", json.Value.Null);
    }
    if (!is_dead && children.size() > 0) {
        // give the server a moment to exit on its own, so the processes it
        // started (proc-macro servers, tsserver) go with it
        for (int round in 0 .. 12) {
            children[0].stdout.set_deadline_ns(timer.monotonic_ns() + 25000000);
            match (children[0].stdout.read(65536)) {
                case Ok(bytes data): {
                    if (data.size() == 0) {
                        break;
                    }
                }
                case Err(io.Error error): {
                }
            }
        }
    }
    if (children.size() > 0) {
        Result<bool, proc.Error> killed = children[0].kill(proc.SIGKILL);
        Result<os.ExitStatus, proc.Error> waited = children[0].wait();
        children = [];
    }
    is_dead = true;
}

/// The capability key a dynamically registered method sets ("" for one that is not a capability).
pub str capability_key(str method) {
    if (method == "textDocument/completion") {
        return "completionProvider";
    }
    if (method == "textDocument/hover") {
        return "hoverProvider";
    }
    if (method == "textDocument/signatureHelp") {
        return "signatureHelpProvider";
    }
    if (method == "textDocument/definition") {
        return "definitionProvider";
    }
    if (method == "textDocument/references") {
        return "referencesProvider";
    }
    if (method == "textDocument/rename") {
        return "renameProvider";
    }
    if (method == "textDocument/formatting") {
        return "documentFormattingProvider";
    }
    if (method == "textDocument/codeAction") {
        return "codeActionProvider";
    }
    if (method == "textDocument/inlayHint") {
        return "inlayHintProvider";
    }
    if (method == "textDocument/semanticTokens") {
        return "semanticTokensProvider";
    }
    return "";
}

/// Start `argv` as language server `name` for `root`, and send `initialize`.
pub Server start(str name, List<str> argv, str root) {
    Server server = Server(name, argv, root);
    match (proc.start(argv, cwd: root)) {
        case Ok(proc.Proc child): {
            server.children.push(child);
            server.is_dead = false;
        }
        case Err(proc.Error error): {
            return server;
        }
    }
    json.Value yes = json.Value.Bool(true);
    json.Value synchronization = object(["didSave", "dynamicRegistration"], [yes, yes]);
    json.Value markup = object(["contentFormat", "dynamicRegistration"], [json.Value.Array([text("markdown"), text("plaintext")]), yes]);
    json.Value diagnostics = object(["relatedInformation", "versionSupport"], [json.Value.Bool(false), yes]);
    json.Value signature = object(["signatureInformation", "dynamicRegistration"], [object(["documentationFormat", "parameterInformation"], [json.Value.Array([text("plaintext")]), object(["labelOffsetSupport"], [yes])]), yes]);
    json.Value completion_item = object(["snippetSupport", "documentationFormat", "resolveSupport", "insertReplaceSupport", "commitCharactersSupport", "labelDetailsSupport", "preselectSupport"], [yes, json.Value.Array([text("markdown"), text("plaintext")]), object(["properties"], [json.Value.Array([text("documentation"), text("detail"), text("additionalTextEdits")])]), yes, yes, yes, yes]);
    json.Value completion = object(["contextSupport", "completionItem", "dynamicRegistration"], [yes, completion_item, yes]);
    json.Value plain = object(["dynamicRegistration"], [yes]);
    json.Value definition = object(["linkSupport", "dynamicRegistration"], [json.Value.Bool(false), yes]);
    json.Value rename = object(["prepareSupport", "dynamicRegistration"], [json.Value.Bool(false), yes]);
    json.Value action = object(["isPreferredSupport", "dataSupport", "resolveSupport", "dynamicRegistration"], [json.Value.Bool(false), yes, object(["properties"], [json.Value.Array([text("edit")])]), yes]);
    json.Value document_capabilities = object(["completion", "synchronization", "hover", "signatureHelp", "inlayHint", "definition", "references", "rename", "codeAction", "formatting", "publishDiagnostics"], [completion, synchronization, markup, signature, plain, definition, plain, rename, action, plain, diagnostics]);
    // workspaceFolders is deliberately not declared: pyright then never starts
    // analysing (the root is passed as rootUri and as one workspace folder)
    json.Value workspace_capabilities = object(["applyEdit", "workspaceEdit", "didChangeWatchedFiles"], [json.Value.Bool(true), object(["documentChanges", "resourceOperations", "failureHandling"], [json.Value.Bool(true), json.Value.Array([text("create"), text("rename"), text("delete")]), text("abort")]), plain]);
    json.Value window_capabilities = object(["workDoneProgress"], [json.Value.Bool(true)]);
    json.Value general = object(["positionEncodings"], [json.Value.Array([text("utf-16")])]);
    json.Value capabilities = object(["textDocument", "workspace", "window", "general"], [document_capabilities, workspace_capabilities, window_capabilities, general]);
    json.Value folder = object(["uri", "name"], [text(uri_of(root)), text(base_name(root))]);
    json.Value parameters = object(["processId", "rootUri", "rootPath", "capabilities", "clientInfo", "workspaceFolders", "trace"], [json.Value.Null, text(uri_of(root)), text(root), capabilities, object(["name", "version"], [text("m3"), text("0.1.0")]), json.Value.Array([folder]), text("off")]);
    server.initialize_id = server.request("initialize", parameters);
    return server;
}

/// The text of an inlay hint label: a string or the values of its parts.
pub str inlay_label(json.Value hint) {
    json.Value label = member(hint, "label");
    str plain = text_of(label);
    if (plain.size() > 0) {
        return plain;
    }
    str joined = "";
    for (json.Value part in items_of(label)) {
        joined = joined + text_of(member(part, "value"));
    }
    return joined;
}

/// The text of a documentation value: a string or MarkupContent.
pub str documentation_text(json.Value value) {
    str plain = text_of(value);
    if (plain.size() > 0) {
        return plain;
    }
    return text_of(member(value, "value"));
}

/// A signature help result as lines: the active signature, the active
/// parameter and the documentation. Empty when there is no signature.
pub List<str> signature_lines(json.Value result) {
    List<str> lines = [];
    List<json.Value> signatures = items_of(member(result, "signatures"));
    if (signatures.size() == 0) {
        return lines;
    }
    int active = int_of(member(result, "activeSignature"), 0);
    if (active < 0 || active >= signatures.size()) {
        active = 0;
    }
    json.Value signature = signatures[active];
    str label = text_of(member(signature, "label"));
    lines.push(label);
    int wanted = int_of(member(signature, "activeParameter"), -1);
    if (wanted < 0) {
        wanted = int_of(member(result, "activeParameter"), 0);
    }
    List<json.Value> parameters = items_of(member(signature, "parameters"));
    if (wanted >= 0 && wanted < parameters.size()) {
        json.Value parameter = member(parameters[wanted], "label");
        str name = text_of(parameter);
        List<json.Value> offsets = items_of(parameter);
        if (name.size() == 0 && offsets.size() == 2) {
            int from = byte_of(label, int_of(offsets[0], 0));
            int stop = byte_of(label, int_of(offsets[1], 0));
            name = label.substr(from, stop);
        }
        if (name.size() > 0) {
            lines.push("-> " + name);
        }
        str parameter_doc = documentation_text(member(parameters[wanted], "documentation")).trim();
        if (parameter_doc.size() > 0) {
            lines.push(parameter_doc);
        }
    }
    str doc = documentation_text(member(signature, "documentation")).trim();
    if (doc.size() > 0) {
        for (str one in doc.split("\n")) {
            lines.push(one);
        }
    }
    return lines;
}

/// A completion snippet as plain text: placeholders `${1:name}` become their
/// default, `$1` / `${1}` / `$0` vanish, `\$` is a dollar sign.
pub str plain_snippet(str snippet) {
    bytes raw = snippet.to_bytes();
    bytes out = [];
    int index = 0;
    while (index < raw.size()) {
        int byte = raw[index];
        if (byte == 92 && index + 1 < raw.size()) {
            out.push(raw[index + 1]);
            index = index + 2;
            continue;
        }
        if (byte == 36 && index + 1 < raw.size()) {
            int next = raw[index + 1];
            if (next >= 48 && next <= 57) {
                index = index + 2;
                while (index < raw.size() && raw[index] >= 48 && raw[index] <= 57) {
                    index = index + 1;
                }
                continue;
            }
            if (next == 123) {
                // ${N}, ${N:default}, ${N|a,b|}: find the matching brace
                int depth = 1;
                int scan = index + 2;
                while (scan < raw.size() && depth > 0) {
                    if (raw[scan] == 92) {
                        scan = scan + 2;
                        continue;
                    }
                    if (raw[scan] == 123) {
                        depth = depth + 1;
                    } else if (raw[scan] == 125) {
                        depth = depth - 1;
                    }
                    scan = scan + 1;
                }
                bytes inner = raw.substr(index + 2, scan - 1);
                str inner_text = inner.utf8().or("");
                int colon = inner_text.index_of(":").or(-1);
                int bar = inner_text.index_of("|").or(-1);
                if (colon >= 0) {
                    inner_text = plain_snippet(inner_text.substr(colon + 1, inner_text.size()));
                } else if (bar >= 0) {
                    str choices = inner_text.substr(bar + 1, inner_text.size());
                    int comma = choices.index_of(",").or(choices.size());
                    int stop = choices.index_of("|").or(choices.size());
                    if (comma < stop) {
                        stop = comma;
                    }
                    inner_text = choices.substr(0, stop);
                } else {
                    inner_text = "";
                }
                out.extend(inner_text.to_bytes());
                index = scan;
                continue;
            }
        }
        out.push(byte);
        index = index + 1;
    }
    return out.utf8().or(snippet);
}

/// Whether `left` sorts before `right` (byte order).
pub bool is_before(str left, str right) {
    int length = left.size();
    if (right.size() < length) {
        length = right.size();
    }
    for (int index in 0 .. length) {
        int one = left.byte_at(index);
        int other = right.byte_at(index);
        if (one != other) {
            return one < other;
        }
    }
    return left.size() < right.size();
}

int last_byte(str text_value, int byte) {
    int found = -1;
    for (int index in 0 .. text_value.size()) {
        if (text_value.byte_at(index) == byte) {
            found = index;
        }
    }
    return found;
}

str base_name(str path) {
    return path.substr(last_byte(path, 47) + 1, path.size());
}

/// The LSP `languageId` of file `path` whose highlighter language is `lang`.
pub str language_id_of(str path, str lang) {
    str base = base_name(path);
    int dot = last_byte(base, 46);
    str extension = "";
    if (dot >= 0) {
        extension = base.substr(dot + 1, base.size()).to_lower();
    }
    if (extension == "ts" || extension == "mts" || extension == "cts") {
        return "typescript";
    }
    if (extension == "tsx") {
        return "typescriptreact";
    }
    if (extension == "jsx") {
        return "javascriptreact";
    }
    if (extension == "lua") {
        return "lua";
    }
    if (lang == "sh") {
        return "shellscript";
    }
    if (lang == "m31") {
        return "m31";
    }
    return lang;
}

/// The language a file is served as when the highlighter does not know it.
pub str language_of_extension(str path) {
    str base = base_name(path);
    int dot = last_byte(base, 46);
    if (dot < 0) {
        return "";
    }
    str extension = base.substr(dot + 1, base.size()).to_lower();
    if (extension == "lua") {
        return "lua";
    }
    return "";
}

str encode(json.Value message) {
    match (json.stringify(message)) {
        case Ok(str text_value): {
            return text_value;
        }
        case Err(json.Error error): {
            return "{}";
        }
    }
}
