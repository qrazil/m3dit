// ---------------------------------------------------------------- terminal pane

/// Engine key to the bytes a terminal program expects.
bytes terminal_bytes(int key) {
    if (key == MED_key.UP_KEY) {
        return "\x1b[A".to_bytes();
    }
    if (key == MED_key.DOWN) {
        return "\x1b[B".to_bytes();
    }
    if (key == MED_key.RIGHT) {
        return "\x1b[C".to_bytes();
    }
    if (key == MED_key.LEFT) {
        return "\x1b[D".to_bytes();
    }
    if (key == MED_key.HOME) {
        return "\x1b[H".to_bytes();
    }
    if (key == MED_key.END) {
        return "\x1b[F".to_bytes();
    }
    if (key == MED_key.DEL) {
        return "\x1b[3~".to_bytes();
    }
    if (key == MED_key.PAGE_UP) {
        return "\x1b[5~".to_bytes();
    }
    if (key == MED_key.PAGE_DOWN) {
        return "\x1b[6~".to_bytes();
    }
    if (key >= MED_key.UP_KEY || key < 0) {
        return [];
    }
    return str.from_chars([key]).to_bytes();
}

// The text of `pending` up to a complete UTF-8 sequence; the rest stays.
str decode_terminal(bytes pending) {
    for (int cut in 0 .. 4) {
        if (pending.size() - cut < 0) {
            break;
        }
        match (pending.substr(0, pending.size() - cut).utf8()) {
            case Some(str text): {
                return text;
            }
            case None: {
            }
        }
    }
    return "";
}

// ---------------------------------------------------------------- language servers

/// The server commands tried for a language, first one installed wins.
List<List<str>> default_servers(str lang) {
    if (lang == "rust") {
        return [["rust-analyzer"]];
    }
    if (lang == "go") {
        return [["gopls"]];
    }
    if (lang == "python") {
        return [["pyright-langserver", "--stdio"], ["pylsp"], ["jedi-language-server"]];
    }
    if (lang == "c" || lang == "cpp") {
        return [["clangd"]];
    }
    if (lang == "javascript" || lang == "typescript") {
        return [["typescript-language-server", "--stdio"]];
    }
    if (lang == "lua") {
        return [["lua-language-server"]];
    }
    if (lang == "markdown") {
        return [["marksman", "server"]];
    }
    if (lang == "sh") {
        return [["bash-language-server", "start"]];
    }
    return [];
}

bool is_lsp_key(int key) {
    return key == 75 || key == 100;
}

str severity_name(int severity) {
    if (severity == 1) {
        return "error";
    }
    if (severity == 2) {
        return "warning";
    }
    if (severity == 3) {
        return "info";
    }
    return "hint";
}

/// Where the last `/` of `text` is, or -1.
int last_slash(str text) {
    int spot = text.size() - 1;
    while (spot >= 0) {
        if (text.byte_at(spot) == 47) {
            return spot;
        }
        spot = spot - 1;
    }
    return -1;
}

bool is_word_byte(int byte) {
    return (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95;
}

str bool_text(bool is_value) {
    if (is_value) {
        return "true";
    }
    return "false";
}

/// The directory of a file path ("." when it has none).
str parent_directory(str file) {
    int spot = last_slash(file);
    if (spot < 0) {
        return ".";
    }
    if (spot == 0) {
        return "/";
    }
    return file.substr(0, spot);
}

/// The directory above `directory`.
str up_directory(str directory) {
    if (directory == ".") {
        return "..";
    }
    if (directory == ".." || directory.ends_with("/..") || directory == "/") {
        if (directory == "/") {
            return "/";
        }
        return directory + "/..";
    }
    return parent_directory(directory);
}

str child_path(str directory, str name) {
    if (directory == ".") {
        return name;
    }
    if (directory.ends_with("/")) {
        return directory + name;
    }
    return directory + "/" + name;
}

/// Lines ready for the preview pane: tabs expanded, long lines cut.
List<str> preview_ready(List<str> lines) {
    List<str> ready = [];
    for (str line in lines) {
        ready.push(MED_picker_view.expand_tabs(line, 4, PREVIEW_COLUMNS));
    }
    return ready;
}

/// The lines of a file for the preview pane.
List<str> read_preview(str file) {
    if (!fs.is_file(file)) {
        return ["(not a file)"];
    }
    match (io.read(file)) {
        case Ok(str text): {
            if (text.size() > MED_grep.MAX_BYTES) {
                return ["(file too large to preview)"];
            }
            for (int spot in 0 .. 512) {
                if (spot < text.size() && text.byte_at(spot) == 0) {
                    return ["(binary file)"];
                }
            }
            List<str> lines = text.split("\n");
            if (lines.size() > PREVIEW_LINES) {
                lines = lines.slice(0, PREVIEW_LINES);
            }
            // CRLF files: the carriage return is not part of the line
            for (int spot in 0 .. lines.size()) {
                if (lines[spot].ends_with("\r")) {
                    lines[spot] = lines[spot].substr(0, lines[spot].size() - 1);
                }
            }
            // tabs and over-long lines are dealt with once here, not on every frame
            return preview_ready(lines);
        }
        case Err(io.Error error): {
            return ["(cannot read: " + error.to_str() + ")"];
        }
    }
}

/// Where `value` is in `items`, or -1.
int position_of(List<int> items, int value) {
    for (int position in 0 .. items.size()) {
        if (items[position] == value) {
            return position;
        }
    }
    return -1;
}

/// The rows of text for a window of `rows` rows.
pub int text_rows(int rows) {
    if (rows - FOOTER_ROWS < 1) {
        return 1;
    }
    return rows - FOOTER_ROWS;
}

/// The engine key for a terminal key code, or -1 when it has none.
int key_code(term.Code code) {
    match (code) {
        case Char(int code_point): {
            return code_point;
        }
        case Enter: {
            return MED_key.CARRIAGE_RETURN;
        }
        case Tab: {
            return MED_key.TAB;
        }
        case BackTab: {
            return MED_key.MOD_SHIFT | MED_key.TAB;
        }
        case Backspace: {
            return MED_key.BACKSPACE;
        }
        case Escape: {
            return MED_key.ESC;
        }
        case Up: {
            return MED_key.UP_KEY;
        }
        case Down: {
            return MED_key.DOWN;
        }
        case Right: {
            return MED_key.RIGHT;
        }
        case Left: {
            return MED_key.LEFT;
        }
        case Home: {
            return MED_key.HOME;
        }
        case End: {
            return MED_key.END;
        }
        case PageUp: {
            return MED_key.PAGE_UP;
        }
        case PageDown: {
            return MED_key.PAGE_DOWN;
        }
        case Insert: {
            return MED_key.INSERT;
        }
        case Delete: {
            return MED_key.DEL;
        }
        case F(int number): {
            if (number >= 1 && number <= 12) {
                return MED_key.FKEY_BASE + number;
            }
            return -1;
        }
    }
}

/// The code point of a character key, or -1 for any other key.
int char_of(term.Code code) {
    match (code) {
        case Char(int code_point): {
            return code_point;
        }
        case Enter: {
            return -1;
        }
        case Tab: {
            return -1;
        }
        case BackTab: {
            return -1;
        }
        case Backspace: {
            return -1;
        }
        case Escape: {
            return -1;
        }
        case Up: {
            return -1;
        }
        case Down: {
            return -1;
        }
        case Right: {
            return -1;
        }
        case Left: {
            return -1;
        }
        case Home: {
            return -1;
        }
        case End: {
            return -1;
        }
        case PageUp: {
            return -1;
        }
        case PageDown: {
            return -1;
        }
        case Insert: {
            return -1;
        }
        case Delete: {
            return -1;
        }
        case F(int number): {
            return -1;
        }
    }
}

/// The control character of a letter or one of `@ [ \ ] ^ _`, or -1.
int control_of(int code_point) {
    if (code_point == 32) {
        // CTRL-Space is NUL
        return 0;
    }
    if (code_point >= 97 && code_point <= 122) {
        return code_point - 96;
    }
    if (code_point >= 64 && code_point <= 95) {
        return code_point & 31;
    }
    return -1;
}

/// The engine keys for one terminal key press: Alt is an Escape first, Ctrl on
/// a character is its control code, Shift/Ctrl on a special key are modifier
/// bits.
pub List<int> keys_of_key(term.Key key) {
    List<int> keys = [];
    int code = key_code(key.code);
    if (code < 0) {
        return keys;
    }
    bool is_special = code >= MED_key.UP_KEY;
    int code_point = char_of(key.code);
    if (key.has_modifiers(term.CTRL) && code_point >= 0) {
        code = control_of(code_point);
        if (code < 0) {
            return keys;
        }
    }
    if (is_special) {
        if (key.has_modifiers(term.CTRL)) {
            code = code | MED_key.MOD_CTRL;
        }
        if (key.has_modifiers(term.SHIFT)) {
            code = code | MED_key.MOD_SHIFT;
        }
    }
    if (key.has_modifiers(term.ALT)) {
        keys.push(MED_key.ESC);
    }
    keys.push(code);
    return keys;
}

/// What a character shows as: a tab is blanks, a control character is `^X`.
str shown(str line, int col, int next, int width) {
    int code_point = MED_text.cp_at(line, col);
    if (code_point == 9) {
        return " ".repeat(width);
    }
    if (code_point >= 0 && code_point < 32) {
        return "^" + str.from_chars([code_point + 64]);
    }
    if (code_point == 127) {
        return "^?";
    }
    return line.substr(col, next);
}

/// The first line of a message.
str first_line(str text) {
    List<str> parts = text.split("\n");
    return parts[0];
}

bool is_error_text(str text) {
    if (text.size() < 2 || text.byte_at(0) != 69) {
        return false;
    }
    int second = text.byte_at(1);
    return second >= 48 && second <= 57;
}
