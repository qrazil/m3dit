/// Rows below the text: the status line and the command line.
const int FOOTER_ROWS = 2;
/// How often (ms) HEAD is read again for the git gutter.
const int GIT_REFRESH_MS = 3000;
/// Lines the mouse wheel scrolls per notch.
const int WHEEL_LINES = 3;
/// Quiet time (ms) after typing in the grep prompt before the search runs.
const int GREP_DEBOUNCE_MS = 120;
/// How long (ms) a typed prefix of a longer mapping waits ('timeoutlen').
const int MAP_TIMEOUT_MS = 1000;
/// How often (ms) the active buffer's file is checked for an outside change.
const int WATCH_MS = 1000;
/// How often (ms) the recent-files and cursor-position state is brought up to date.
const int STATE_MS = 1000;
const int PREVIEW_LINES = 3000;
/// A preview line is kept this many columns long (the pane is never wider).
const int PREVIEW_COLUMNS = 400;
/// The smallest a window may get, status line included.
const int VKIND_CHAR = 118;
const int VKIND_LINE = 86;

/// What the git gutter knows about one file.
pub type GitInfo {
    /// HEAD was asked for (and, when `has_base`, answered).
    pub bool is_checked = false;
    pub bool has_base = false;
    pub List<str> base = [];
    pub int tick = -1;
    /// The text changed since `hunks` was made; the next quiet tick diffs again.
    pub bool is_dirty = false;
    pub MED_git.Hunks hunks = MED_git.Hunks();
}

/// One buffer of the session: its engine state (a reference, so the active
/// buffer's editor is the very object the App drives) and its file.
pub type Slot {
    /// Buffer number, as `:ls` shows it; never reused.
    pub int id;
    pub MED_editor.Editor editor;
    pub str path;
    pub int saved_current = 0;
    pub int left_column = 0;
    /// A directory listing (`:Explore`): `path` is the directory, the text is
    /// read-only and Enter opens the entry under the cursor.
    pub bool is_listing = false;
    /// A terminal pane's name ("" for an ordinary buffer).
    pub str title = "";
    /// The `:set` lines `.editorconfig` / `.m3.toml` gave this buffer; run again whenever it becomes active
    /// (options are shared between buffers, these are not).
    pub List<str> local_lines = [];
    /// The file on disk as last read or written (MED_persist.disk_stamp), to notice an outside change.
    pub str stamp = "";
}

/// A terminal pane: a program on a pty whose output fills a buffer.
pub type Term {
    pub int buffer_id;
    List<proc.Pty> ptys = [];
    pub MED_vt.Screen screen = MED_vt.Screen();
    /// Keys go to the program (until CTRL-\ CTRL-N).
    pub bool is_input = true;
    pub bool is_alive = true;
    bool is_leaving = false;
    bytes pending = [];
}

pub type App {
    pub MED_editor.Editor editor;
    /// The git gutter of each file path, and how long since HEAD was last read.
    pub Map<str, GitInfo> git = {};
    pub int git_ms = 0;
    /// Directory listings show dotfiles (`gh` in a listing toggles it).
    pub bool is_dotfiles_listed = true;
    bool is_pending_g = false;
    /// The match 'incsearch' shows while a pattern is typed (row -1: none).
    int inc_row = -1;
    int inc_col = 0;
    int inc_end_row = 0;
    int inc_end_col = 0;
    /// The system clipboard tools, when `m3` found a pair (see MED_clip).
    pub MED_clip.Provider clipboard = MED_clip.Provider();
    /// The file `:w` writes; empty for a buffer with no name yet.
    pub str path;
    /// The undo node (`editor.current`) that was last written to disk.
    pub int saved_current = 0;
    /// A message of the UI layer (written, E37 ...), cleared by the next key.
    pub str notice = "";
    /// First display column shown (horizontal scrolling).
    pub int left_column = 0;
    /// Every buffer; `editor`, `path`, `saved_current` and `left_column` belong
    /// to the active one (`current_id`) and are stored back by `save_active`.
    pub List<Slot> slots = [];
    pub int current_id = 1;
    /// The buffer `:b#` and CTRL-^ go to; 0 when there is none.
    pub int alternate_id = 0;
    pub int next_id = 2;
    /// Lines shown over the text until the next key (`:ls` and long messages).
    pub List<str> overlay = [];
    /// The open picker, if any.
    pub MED_picker.Picker picker = MED_picker.make(0, "");
    pub bool has_picker = false;
    /// The project root the file and grep pickers walk.
    pub str root = ".";
    pub MED_grep.Corpus corpus = MED_grep.Corpus();
    pub bool is_grep_due = false;
    pub int idle_ms = 0;
    pub MED_picker_view.Preview preview = MED_picker_view.Preview();
    pub str preview_path = "";
    /// Size and modification time of the previewed file when it was read.
    pub str preview_stamp = "";
    pub List<str> preview_lines = [];
    /// <Space> was typed: the keys after it so far, and the wait for which-key.
    pub bool is_leader = false;
    pub str leader = "";
    pub int leader_ms = 0;
    pub bool is_which_key = false;
    /// The mode the pending leader sequence started in ("n" or "x").
    pub str leader_mode = "n";
    /// Built-in plugins switched off (`:PluginDisable`).
    pub List<str> disabled_plugins = [];
    /// How long (ms) a pending prefix (g, z, [, CTRL-W, an operator) has waited.
    pub int prefix_ms = 0;
    pub bool is_prefix_help = false;
    /// The terminal panes.
    pub List<Term> terms = [];
    /// Running language servers, the language each one serves, and the
    /// commands the user set (`:Lsp server LANG CMD...`).
    pub List<MED_lsp.Server> servers = [];
    pub List<str> server_languages = [];
    pub Map<str, str> server_commands = {};
    /// Diagnostics by absolute file path, as (row, byte column) positions.
    pub Map<str, List<MED_lsp.Diagnostic>> diagnostics = {};
    /// Requests in flight: "SERVER#ID" -> "purpose|path".
    Map<str, str> lsp_pending = {};
    /// The edits of the code actions last offered.
    List<json.Value> lsp_actions = [];
    /// The completion items offered, and where the word being completed began.
    List<json.Value> lsp_completions = [];
    int lsp_completion_row = 0;
    int lsp_completion_byte = 0;
    /// Per document: the buffer tick last sent and the document version.
    Map<str, int> lsp_ticks = {};
    int lsp_quiet_ms = 0;
    /// Inlay hints: by absolute file path, row -> the hints of that row as one
    /// text; shown after the end of the line while `is_hints_on`.
    pub Map<str, Map<str, str>> hints = {};
    pub bool is_hints_on = false;
    int hints_tick = -1;
    int hints_top = -1;
    str hints_for = "";
    /// Rows with a diagnostic in the window being drawn (severity, 0 none).
    List<int> diagnostic_rows = [];
    /// The running child that fills the open picker (rg, fd, git).
    pub MED_shell.Stream source = MED_shell.Stream();
    pub str source_kind = "";
    pub int source_ms = 0;
    /// The git branch shown in the statusline, read from .git/HEAD.
    pub str branch = "";
    int branch_ms = 0;
    /// Extensions built in (docs/EXTENSIONS.md): empty unless the build named some. The mode, cursor, text tick and
    /// buffer the Mode/Cursor/Text events last saw, and the extension command names.
    pub MED_ext.Registry ext = MED_ext.Registry();
    List<str> ext_commands = [];
    int ext_mode = 0;
    int ext_row = 0;
    int ext_col = 0;
    int ext_tick = 0;
    int ext_buffer = 0;
    /// The quickfix list and the entry `]q` / `:cnext` last went to.
    pub List<MED_picker.Entry> quickfix_list = [];
    pub int quickfix_index = -1;
    /// Where recent files, positions and harpoon lists are kept ("" none).
    pub str state_directory = "";
    pub List<str> recent = [];
    /// How often and how lately files were opened (the finder's frecency); read from the
    /// state directory on first use, never with a clean run (`-u NONE`).
    pub MED_frecency.Store frecency = MED_frecency.Store();
    pub bool is_frecency_loaded = false;
    /// Buffers read `.editorconfig` and `.m3.toml` (off for `-u NONE`, so test runs stay hermetic).
    pub bool is_project_conf = false;
    pub List<str> positions = [];
    pub List<str> harpoon = [];
    pub int harpoon_index = -1;
    str noted_path = "";
    int noted_row = -1;
    int state_ms = 0;
    /// Time since the last disk check ('autoread') and since the last key ('autosave').
    int watch_ms = 0;
    int quiet_ms = 0;
    str lsp_failed_for = "";
    bool is_lsp_gr = false;
    /// Label jump: 0 off, 1 waiting for the character to look for, 2 for a label.
    int jump_stage = 0;
    List<int> jump_rows = [];
    List<int> jump_columns = [];
    /// The previous key fed to the engine (for the `jk` mapping).
    pub int last_key = 0;
    /// How long (ms) typed keys have waited for a longer mapping.
    pub int map_ms = 0;
    /// The windows and how they are laid out; `current_win` is the active one,
    /// whose cursor and view live in `editor` and `left_column`.
    pub List<MED_window.Win> wins = [];
    pub MED_window.Node layout = MED_window.leaf(1);
    pub int current_win = 1;
    pub int previous_win = 0;
    pub int next_win = 2;
    /// The tab pages (empty: only the one in `wins` / `layout`). The active
    /// page's entry is stale, its live values being the fields above.
    pub List<MED_window.Page> pages = [];
    pub int page_index = 0;
    /// CTRL-W was typed: the next key is a window command.
    pub bool is_window_key = false;
    /// The count typed with CTRL-W (`CTRL-W 5 _`, `5 CTRL-W w`).
    int window_count = 0;
    /// The file tree sidebar (`:Neotree`, <Space>e).
    pub MED_tree.Tree tree = MED_tree.Tree();
    bool is_tree_pending_g = false;
    /// The syntax language of the window being drawn ("": none).
    str syntax_lang = "";
    /// The directory the working path of a snippet's $TM_FILEPATH is built on (read once).
    str snip_cwd = "";
    /// Where the active window's cursor was drawn.
    pub int cursor_x = 0;
    pub int cursor_y = 0;
    /// The colour theme every drawing call looks its styles up in, the
    /// directory user themes are read from ("" for none), whether the terminal
    /// has only 16 colours, and the `background` option as the theme last saw it.
    pub MED_theme.Theme theme = MED_theme.plain();
    pub str theme_directory = "";
    pub bool is_sixteen_colours = false;
    str theme_background = "dark";
    /// The theme picker is open: the theme to return to when it is cancelled.
    bool is_theme_picker = false;
    str theme_before = "";
    /// Animated scrolling and effects (MED_glide): what is drawn between two states.
    pub MED_glide.Glide motion = MED_glide.Glide();
    /// A left-button drag is under way, where the pointer is, and how long it has
    /// sat at the top or bottom edge (the autoscroll's speed ramp).
    bool is_dragging = false;
    bool is_bar_drag = false;
    int bar_win = 0;
    int drag_x = 0;
    int drag_y = 0;
    int edge_total_ms = 0;
    int edge_wait_ms = 0;
}

/// Whether the text differs from what was last written (undo back to the
/// written state counts as unmodified).
pub bool App.is_modified() {
    return editor.current != saved_current;
}

/// The engine keys typed by a terminal event.
List<int> App.keys_of(term.Event event) {
    List<int> keys = [];
    match (event) {
        case Key(term.Key key): {
            return keys_of_key(key);
        }
        case Paste(str text): {
            // a paste is typed text in Insert mode; elsewhere it would run as commands
            if (editor.mode == MED_editor.INSERT || editor.mode == MED_editor.REPLACE || editor.mode == MED_editor.CMDLINE) {
                for (int code_point in text.chars()) {
                    if (code_point == 10) {
                        keys.push(MED_key.CARRIAGE_RETURN);
                    } else if (code_point != 13) {
                        keys.push(code_point);
                    }
                }
            }
        }
        case Mouse(term.Mouse mouse): {
        }
        case Unknown(bytes data): {
        }
    }
    return keys;
}

/// The slot of the active buffer, brought up to date.
Slot App.active_slot() {
    save_active();
    return slots[index_of(current_id)];
}

/// Store the active buffer's own values back into its slot.
void App.save_active() {
    int position = index_of(current_id);
    if (position < 0) {
        return;
    }
    Slot slot = slots[position];
    slot.editor = editor;
    slot.path = path;
    slot.saved_current = saved_current;
    left_column = editor.view_left;
    slot.left_column = left_column;
    int at_window = win_index(current_win);
    if (at_window >= 0) {
        MED_window.Win win = wins[at_window];
        win.buffer_id = current_id;
        win.row = editor.row;
        win.col = editor.col;
        win.view_top = editor.view_top;
        win.left_column = left_column;
    }
}

/// Where window `id` is in `wins`, or -1.
int App.win_index(int id) {
    for (int position in 0 .. wins.size()) {
        if (wins[position].id == id) {
            return position;
        }
    }
    return -1;
}

/// Where buffer `id` is in `slots`, or -1.
int App.index_of(int id) {
    for (int position in 0 .. slots.size()) {
        if (slots[position].id == id) {
            return position;
        }
    }
    return -1;
}

/// Write the active buffer to `target` (the buffer's own file when empty).
void App.write_file(str target) {
    Slot slot = active_slot();
    notice = write_hooked(slot, target);
    path = slot.path;
    saved_current = slot.saved_current;
    if (!notice.starts_with("E")) {
        save_undo(slot);
    }
    if (servers.size() > 0 && !notice.starts_with("E")) {
        lsp_did_save(slot.path);
    }
}

/// `:w` for every buffer that has changed (`:wall`).
void App.write_all() {
    save_active();
    int written = 0;
    for (Slot slot in slots) {
        if (!is_slot_modified(slot)) {
            continue;
        }
        if (slot.path.size() == 0) {
            notice = "E141: No file name for buffer " + slot.id.to_str();
            return;
        }
        str result = write_hooked(slot, "");
        if (result.starts_with("E")) {
            notice = result;
            return;
        }
        save_undo(slot);
        written = written + 1;
    }
    Slot active = slots[index_of(current_id)];
    path = active.path;
    saved_current = active.saved_current;
    if (written > 0) {
        notice = written.to_str() + " buffer(s) written";
    }
}

/// Make buffer `id` the active one; the buffer left becomes the alternate.
void App.activate(int id) {
    save_active();
    int position = index_of(id);
    if (position < 0 || id == current_id) {
        return;
    }
    remember_position();
    Slot target = slots[position];
    share_state(editor, target.editor);
    run_local(target);
    alternate_id = current_id;
    current_id = id;
    editor = target.editor;
    path = target.path;
    saved_current = target.saved_current;
    left_column = target.left_column;
    editor.view_left = left_column;
    editor.view_height = current_text_rows();
    check_disk();
}

/// Run the project settings of `slot` on its editor.
void App.run_local(Slot slot) {
    for (str line in slot.local_lines) {
        if (!MED_ex.did_run_line(slot.editor, line)) {
            slot.editor.message = "";
        }
    }
}

/// Read `.editorconfig` and `.m3.toml` for `slot` and apply them (`is_project_conf`).
pub void App.apply_project(Slot slot) {
    if (!is_project_conf || slot.is_listing || slot.path.size() == 0) {
        return;
    }
    str file = MED_projconf.absolute_path(slot.path);
    if (file.size() == 0) {
        return;
    }
    str language = SYN_detect.language_of(slot.path, slot.editor.buffer.line(0));
    MED_projconf.Conf conf = MED_projconf.for_file(file, language);
    slot.local_lines = conf.lines;
    run_local(slot);
    if (conf.final_newline >= 0) {
        slot.editor.buffer.is_eol = conf.final_newline == 1;
    }
}

/// Apply the project settings to every buffer opened so far (the startup files).
pub void App.apply_project_all() {
    is_project_conf = true;
    for (Slot slot in slots) {
        apply_project(slot);
        apply_fold_start(slot);
    }
}

/// 'foldlevelstart' (when 0 or more) sets 'foldlevel' as a buffer is first shown, as nvim does for a buffer it loads.
void App.apply_fold_start(Slot slot) {
    int start = slot.editor.option_number("foldlevelstart", -1);
    if (start >= 0) {
        slot.editor.opts.set("foldlevel", start.to_str());
    }
}

/// Add `slot` to the session and make it active.
void App.adopt(Slot slot) {
    apply_project(slot);
    slots.push(slot);
    next_id = slot.id + 1;
    activate(slot.id);
    apply_fold_start(slot);
    restore_position();
    restore_undo();
    if (!slot.is_listing) {
        ext_fire_slot(MED_ext.Event.BufOpen, slot, slot.path);
    }
}

/// Put the cursors of a restored session where they were (the active buffer's included).
pub void App.apply_session_cursors(MED_session.Session session) {
    for (MED_session.Entry entry in session.entries) {
        for (int index in 0 .. slots.size()) {
            Slot slot = slots[index];
            if (slot.path == entry.path && !slot.is_listing) {
                slot.editor.row = MED_num.smaller(entry.row, slot.editor.buffer.line_count() - 1);
                slot.editor.col = entry.col;
                slot.editor.clamp();
                slot.editor.want_from_cursor();
            }
        }
    }
}

/// The buffers worth keeping in a session: ordinary files that exist, in buffer order.
List<MED_session.Entry> App.session_entries() {
    save_active();
    List<MED_session.Entry> out = [];
    for (Slot slot in slots) {
        if (slot.is_listing || slot.title.size() > 0 || slot.path.size() == 0) {
            continue;
        }
        str file = absolute_of(slot.path);
        if (file.size() == 0 || !fs.is_file(file)) {
            continue;
        }
        out.push(MED_session.Entry(file, row: slot.editor.row, col: slot.editor.col));
    }
    return out;
}

/// Write the session `name` ("" is the one of the current directory).
pub void App.save_session(str name) {
    if (state_directory.size() == 0) {
        return;
    }
    List<MED_session.Entry> entries = session_entries();
    if (entries.size() == 0 && name.size() == 0) {
        return;
    }
    str active = "";
    if (path.size() > 0) {
        active = absolute_of(path);
    }
    MED_session.save(state_directory, MED_session.file_for(name, MED_projconf.absolute_path(".")), MED_session.encode(entries, active));
}

/// `:Session save|load|delete|list [NAME]`.
void App.run_session(str arg) {
    List<str> words = arg.trim().split(" ");
    str verb = words[0];
    str name = "";
    if (words.size() > 1) {
        name = words[1].trim();
    }
    if (state_directory.size() == 0) {
        notice = "Sessions need a state directory (HOME is not set, or -u NONE)";
        return;
    }
    if (verb == "list" || verb == "") {
        List<str> found = MED_session.names(state_directory);
        notice = "Sessions: " + found.join(" ");
        if (found.size() == 0) {
            notice = "No saved sessions";
        }
        return;
    }
    if (verb != "save" && verb != "load" && verb != "delete") {
        notice = "E474: Invalid argument: " + verb;
        return;
    }
    if (name.size() > 0 && !MED_session.is_valid_name(name)) {
        notice = "E474: Invalid session name: " + name;
        return;
    }
    str file = MED_session.file_for(name, MED_projconf.absolute_path("."));
    if (verb == "save") {
        save_session(name);
        notice = "Session saved";
    } else if (verb == "delete") {
        if (MED_session.did_delete(state_directory, file)) {
            notice = "Session deleted";
        } else {
            notice = "E484: No such session";
        }
    } else {
        MED_session.Session session = MED_session.load(state_directory, file);
        if (session.entries.size() == 0) {
            notice = "E484: No such session";
            return;
        }
        for (MED_session.Entry entry in session.entries) {
            if (entry.path != session.active) {
                edit(entry.path, false);
            }
        }
        edit(session.active, false);
        apply_session_cursors(session);
        notice = "Session loaded: " + session.entries.size().to_str() + " buffers";
    }
}

/// Read the active buffer's file again (`:e!`, an outside change under 'autoread'); the cursor stays on its line.
/// False (with the message in `notice`) when the file cannot be read.
bool App.did_reload_active() {
    int row = editor.row;
    int col = editor.col;
    match (read_slot(current_id, path)) {
        case Ok(Slot fresh): {
            MED_editor.Editor old = editor;
            share_state(old, fresh.editor);
            apply_project(fresh);
            editor = fresh.editor;
            saved_current = fresh.saved_current;
            left_column = 0;
            editor.row = MED_num.smaller(row, editor.buffer.line_count() - 1);
            editor.col = col;
            editor.clamp();
            editor.want_from_cursor();
            save_active();
            slots[index_of(current_id)].stamp = fresh.stamp;
            return true;
        }
        case Err(str message): {
            notice = message;
            return false;
        }
    }
}

/// Notice a change of the active buffer's file on disk ('autoread'): an unmodified buffer is read again, a modified
/// one only gets the warning, once per change. `:checktime` and every tick of a quiet Normal mode run this.
void App.check_disk() {
    Slot slot = active_slot();
    if (slot.is_listing || slot.path.size() == 0 || slot.title.size() > 0) {
        return;
    }
    str now = MED_persist.disk_stamp(slot.path);
    if (now == slot.stamp) {
        return;
    }
    bool was_present = slot.stamp.size() > 0;
    slot.stamp = now;
    if (now.size() == 0) {
        if (was_present) {
            notice = "E211: File \"" + slot.path + "\" no longer available";
        }
        return;
    }
    if (!was_present) {
        return;
    }
    if (is_modified()) {
        notice = "W12: Warning: File \"" + slot.path + "\" has changed and the buffer was changed in Vim as well";
        return;
    }
    if (!editor.is_option_on("autoread", true)) {
        notice = "W11: Warning: File \"" + slot.path + "\" has changed since editing started";
        return;
    }
    if (did_reload_active()) {
        notice = "\"" + slot.path + "\" changed on disk, reloaded";
    }
}

/// 'autowrite' / 'autowriteall': write every modified buffer that has a file before a command that would leave it
/// ('autowriteall' for :edit, :quit and closing too, 'autowrite' for CTRL-^ and `:e #`). A buffer that cannot be
/// written stays modified and the command then fails the usual way.
void App.autowrite(bool is_all_command) {
    bool is_on = editor.is_option_on("autowriteall", false) || (!is_all_command && editor.is_option_on("autowrite", false));
    if (!is_on) {
        return;
    }
    save_active();
    for (Slot slot in slots) {
        if (!is_slot_modified(slot) || slot.path.size() == 0 || slot.is_listing) {
            continue;
        }
        if (!write_hooked(slot, "").starts_with("E")) {
            save_undo(slot);
        }
    }
    Slot active = slots[index_of(current_id)];
    path = active.path;
    saved_current = active.saved_current;
}

/// Write the modified buffers once the user has been quiet for 'autosave' seconds (Normal mode only, so a half-typed
/// insert or command is never written).
void App.autosave_idle(int elapsed_ms) {
    int seconds = editor.option_number("autosave", 0);
    if (seconds <= 0 || editor.mode != MED_editor.NORMAL) {
        quiet_ms = 0;
        return;
    }
    quiet_ms = quiet_ms + elapsed_ms;
    if (quiet_ms < seconds * 1000) {
        return;
    }
    quiet_ms = 0;
    save_active();
    int written = 0;
    for (Slot slot in slots) {
        if (is_slot_modified(slot) && slot.path.size() > 0 && !slot.is_listing && slot.title.size() == 0) {
            if (!write_hooked(slot, "").starts_with("E")) {
                save_undo(slot);
                written = written + 1;
            }
        }
    }
    if (written > 0) {
        Slot active = slots[index_of(current_id)];
        path = active.path;
        saved_current = active.saved_current;
        if (written == 1) {
            notice = "autosaved 1 buffer";
        } else {
            notice = "autosaved " + written.to_str() + " buffers";
        }
    }
}

/// `:e [file]`, `:e!`, `:e #`, `:enew`.
void App.edit(str target, bool is_forced) {
    str name = target.trim();
    if (name == "#") {
        switch_alternate();
        return;
    }
    if (name.size() == 0 && is_in_listing()) {
        reload_listing(path, editor.buffer.line(editor.row));
        return;
    }
    if (name.size() > 0 && fs.is_directory(name)) {
        open_listing(name, "");
        return;
    }
    if (name.size() == 0) {
        // re-read the file of this buffer
        if (!is_forced && is_modified()) {
            notice = "E37: No write since last change (add ! to override)";
            return;
        }
        if (did_reload_active()) {
            notice = file_note(path, editor);
        }
        return;
    }
    autowrite(true);
    for (Slot known in slots) {
        if (known.path == name) {
            activate(known.id);
            notice = file_note(path, editor);
            return;
        }
    }
    match (read_slot(next_id, name)) {
        case Ok(Slot fresh): {
            adopt(fresh);
            notice = file_note(name, editor);
        }
        case Err(str message): {
            notice = message;
        }
    }
}

/// `:enew`: a buffer with no name.
void App.new_buffer() {
    match (read_slot(next_id, "")) {
        case Ok(Slot fresh): {
            adopt(fresh);
        }
        case Err(str message): {
            notice = message;
        }
    }
}

void App.switch_alternate() {
    if (alternate_id == 0 || index_of(alternate_id) < 0) {
        notice = "E23: No alternate file";
        return;
    }
    autowrite(false);
    activate(alternate_id);
    notice = file_note(path, editor);
}

/// The buffer `:b ARG` names: a number, `#`, `%`, or part of a file name that
/// only one buffer has. 0 when there is none, -1 when the name is ambiguous.
int App.find_buffer(str arg) {
    str word = arg.trim();
    if (word == "#") {
        return alternate_id;
    }
    if (word == "%") {
        return current_id;
    }
    match (word.parse_int()) {
        case Some(int number): {
            if (index_of(number) >= 0) {
                return number;
            }
            return 0;
        }
        case None: {
        }
    }
    int found = 0;
    int matches = 0;
    for (Slot slot in slots) {
        if (slot.path.contains(word)) {
            found = slot.id;
            matches = matches + 1;
        }
    }
    if (matches > 1) {
        return -1;
    }
    return found;
}

/// `:b ARG`.
void App.go_buffer(str arg) {
    if (arg.trim().size() == 0) {
        return;
    }
    save_active();
    int id = find_buffer(arg);
    if (id < 0) {
        notice = "E93: More than one match for " + arg.trim();
        return;
    }
    if (id == 0) {
        if (arg.trim() == "#") {
            notice = "E23: No alternate file";
        } else {
            notice = "E86: Buffer " + arg.trim() + " does not exist";
        }
        return;
    }
    activate(id);
    notice = file_note(path, editor);
}

/// `:bn`, `:bp`, `:bf`, `:bl` by position in the list; `step` wraps around.
void App.go_relative(int step, bool is_absolute) {
    save_active();
    int count = slots.size();
    int position = index_of(current_id);
    int target = 0;
    if (is_absolute) {
        if (step < 0) {
            target = count - 1;
        }
    } else {
        target = (position + step + count) % count;
    }
    activate(slots[target].id);
    notice = file_note(path, editor);
}

/// `:bd [N]`: drop a buffer; the last one is replaced by an empty buffer.
void App.delete_buffer(str arg, bool is_forced) {
    save_active();
    int id = current_id;
    if (arg.trim().size() > 0) {
        id = find_buffer(arg);
    }
    if (id <= 0) {
        notice = "E516: No buffers were deleted: bd " + arg.trim();
        return;
    }
    int position = index_of(id);
    Slot victim = slots[position];
    if (is_slot_modified(victim) && !is_forced) {
        notice = "E89: No write since last change for buffer " + id.to_str() + " (add ! to override)";
        return;
    }
    List<int> shown_in = [];
    for (MED_window.Win win in wins) {
        if (win.buffer_id == id && win.id != current_win) {
            shown_in.push(win.id);
        }
    }
    for (int win_id in shown_in) {
        close_window(win_id);
    }
    if (slots.size() == 1) {
        match (read_slot(next_id, "")) {
            case Ok(Slot fresh): {
                slots.push(fresh);
                next_id = fresh.id + 1;
            }
            case Err(str message): {
                notice = message;
                return;
            }
        }
    }
    if (id == current_id) {
        int target = alternate_id;
        if (target == 0 || target == id || index_of(target) < 0) {
            target = 0;
            for (Slot slot in slots) {
                if (slot.id != id && target == 0) {
                    target = slot.id;
                }
            }
        }
        activate(target);
    }
    ext_fire_slot(MED_ext.Event.BufClose, victim, victim.path);
    lsp_did_close(slot_key(slots[index_of(id)]));
    slots.remove_at(index_of(id));
    if (alternate_id == id) {
        alternate_id = 0;
    }
}

/// The `:ls` listing, one line per buffer.
List<str> App.buffer_list() {
    save_active();
    List<str> lines = [];
    for (Slot slot in slots) {
        str flags = " ";
        if (slot.id == current_id) {
            flags = "%a";
        } else if (slot.id == alternate_id) {
            flags = "# ";
        } else {
            flags = "  ";
        }
        str modified = " ";
        if (is_slot_modified(slot)) {
            modified = "+";
        }
        str line = slot.id.to_str();
        while (line.size() < 3) {
            line = " " + line;
        }
        int row = slot.editor.row + 1;
        lines.push(line + " " + flags + " " + modified + " \"" + slot_name(slot) + "\" line " + row.to_str());
    }
    return lines;
}

/// Carry out what the engine asked of the UI layer.
void App.run_request(str request) {
    List<str> parts = split_request(request);
    str name = parts[0];
    str arg = parts[1];
    bool is_forced = name.ends_with("!");
    if (is_forced) {
        name = name.substr(0, name.size() - 1);
    }
    if (!ext.is_empty() && ext.has_command(name)) {
        MED_ext.Ctx context = MED_ext.context(ext, editor, path);
        ext.did_run_command(name, context, arg.trim(), is_forced);
        ext_finish(context);
        return;
    }
    if (name == "write") {
        write_file(arg);
    } else if (name == "update") {
        if (is_modified() || arg.trim().size() > 0) {
            write_file(arg);
        }
    } else if (name == "wall") {
        write_all();
    } else if (name == "Session") {
        run_session(arg);
    } else if (name == "checktime") {
        check_disk();
    } else if (name == "edit") {
        edit(arg, is_forced);
    } else if (name == "enew") {
        new_buffer();
    } else if (name == "buffer") {
        go_buffer(arg);
    } else if (name == "bnext") {
        go_relative(1, false);
    } else if (name == "bprevious" || name == "bNext") {
        go_relative(-1, false);
    } else if (name == "bfirst" || name == "brewind") {
        go_relative(1, true);
    } else if (name == "blast") {
        go_relative(-1, true);
    } else if (name == "bdelete" || name == "bwipeout" || name == "bunload") {
        delete_buffer(arg, is_forced);
    } else if (name == "ls" || name == "buffers" || name == "files") {
        overlay = buffer_list();
    } else if (name == "split" || name == "vsplit" || name == "new" || name == "vnew") {
        run_split(name, arg);
    } else if (name == "close") {
        if (is_forced || is_close_allowed()) {
            close_window(current_win);
        }
    } else if (name == "only") {
        only_window();
    } else if (name.starts_with("tab")) {
        run_tab_command(name, arg, is_forced);
    } else if (name == "Rename" || name == "Delete" || name == "Create" || name == "Mkdir") {
        listing_file_command(name, arg);
    } else if (name == "resize" || name == "vresize") {
        str amount = arg.trim();
        bool is_vertical = name == "vresize";
        if (amount.size() == 0) {
            resize_window(1000, is_vertical, true);
        } else if (amount.byte_at(0) == 43 || amount.byte_at(0) == 45) {
            int delta = amount.substr(1, amount.size()).parse_int().or(1);
            if (amount.byte_at(0) == 45) {
                delta = 0 - delta;
            }
            resize_window(delta, is_vertical, false);
        } else {
            resize_window(amount.parse_int().or(1), is_vertical, true);
        }
    } else if (name == "wincmd") {
        if (arg.trim().size() == 0) {
            notice = "E471: Argument required";
        } else {
            window_command(arg.trim().byte_at(0), 0);
        }
    } else if (name == "source") {
        source_file(arg.trim());
    } else if (name == "Recent") {
        open_picker("recent", arg);
    } else if (name == "Symbols") {
        open_picker("symbols", arg);
    } else if (name == "Todo") {
        open_picker("todos", arg);
    } else if (name == "Branches") {
        open_picker("branches", arg);
    } else if (name == "Commits") {
        open_picker("commits", arg);
    } else if (name == "Changed") {
        open_picker("changed", arg);
    } else if (name == "Files") {
        open_picker("files", arg);
    } else if (name == "Buffers") {
        open_picker("buffers", arg);
    } else if (name == "Grep") {
        open_picker("grep", arg);
    } else if (name == "Commands") {
        open_picker("commands", arg);
    } else if (name == "help") {
        open_picker("help", arg);
    } else if (name == "Lsp") {
        str word = arg.trim();
        int space = word.index_of(" ").or(word.size());
        run_lsp_command(word.substr(0, space), word.substr(space, word.size()).trim());
    } else if (name == "terminal") {
        start_terminal(arg.trim());
    } else if (name == "Keys") {
        open_picker("help", "");
    } else if (name == "copen") {
        open_picker("quickfix", "");
    } else if (name == "cclose") {
        has_picker = false;
    } else if (name == "cnext") {
        go_quickfix(1);
    } else if (name == "cprevious" || name == "cNext") {
        go_quickfix(-1);
    } else if (name == "cfirst") {
        go_quickfix(0);
    } else if (name == "clast") {
        go_quickfix(2);
    } else if (name == "theme" || name == "colorscheme") {
        run_theme_command(arg.trim());
    } else if (name == "Plugins" || name == "PluginEnable" || name == "PluginDisable") {
        run_plugin_command(name, arg.trim());
    } else if (name == "Neotree" || name == "NeoTree") {
        run_tree(arg.trim());
    } else if (name == "Explore") {
        open_listing(explore_directory(arg), current_file_name());
    } else if (name == "Sexplore" || name == "Vexplore") {
        str directory = explore_directory(arg);
        str focus = current_file_name();
        if (did_split(name == "Vexplore")) {
            open_listing(directory, focus);
        }
    } else {
        notice = "Not supported yet: :" + request.trim();
    }
}

/// The theme loaded for `name`: the 16-colour twin of `default` and
/// `default-light` when the terminal has no more colours than that.
str App.theme_choice(str name) {
    if (is_sixteen_colours && name == MED_theme.DARK) {
        return MED_theme.DARK_16;
    }
    if (is_sixteen_colours && name == MED_theme.LIGHT) {
        return MED_theme.LIGHT_16;
    }
    return name;
}

/// Switch to theme `name` (a user file in the themes directory, else a
/// built-in). On failure the theme in use stays and `notice` says why; a
/// theme with entries that could not be read still loads and says so.
pub bool App.did_use_theme(str name) {
    str chosen = theme_choice(name);
    match (MED_theme.load(chosen, theme_directory)) {
        case Ok(MED_theme.Theme loaded): {
            theme = loaded;
            theme_background = editor.opts.get("background").or("dark");
            if (loaded.warnings.size() > 0) {
                notice = loaded.warnings[0];
                if (loaded.warnings.size() > 1) {
                    notice = notice + " (and " + (loaded.warnings.size() - 1).to_str() + " more)";
                }
            }
            return true;
        }
        case Err(str message): {
            notice = message;
            if (message.starts_with("unknown theme")) {
                notice = message + " (:theme <Tab> lists them)";
            }
            return false;
        }
    }
}

/// `:theme` shows the theme in use, `:theme NAME` (and `:colorscheme NAME`)
/// switches to it.
void App.run_theme_command(str name) {
    if (name.size() == 0) {
        notice = "theme: " + theme.name + " (" + MED_theme.available(theme_directory).size().to_str() + " available, :theme <Tab>)";
        return;
    }
    if (did_use_theme(name) && notice.size() == 0) {
        notice = "theme: " + theme.name;
    }
}

/// `:set background=dark|light` moves between the default themes, as Vim moves
/// between its default colours; any other theme stays as it is.
void App.follow_background() {
    str wanted = editor.opts.get("background").or("dark");
    if (wanted == theme_background) {
        return;
    }
    theme_background = wanted;
    if (theme.name == MED_theme.DARK || theme.name == MED_theme.LIGHT || theme.name == MED_theme.DARK_16 || theme.name == MED_theme.LIGHT_16) {
        did_use_theme(MED_theme.default_for(wanted == "light", false));
    }
}

/// While the theme picker is open, the highlighted theme is the one in use.
void App.preview_selected_theme() {
    match (picker.current()) {
        case Some(MED_picker.Entry entry): {
            if (!entry.action.starts_with("ex:theme ")) {
                return;
            }
            str wanted = entry.action.substr(9, entry.action.size());
            if (theme_choice(wanted) != theme.name) {
                str kept = notice;
                did_use_theme(wanted);
                notice = kept;
            }
        }
        case None: {
        }
    }
}

/// The theme picker closed: a cancel puts back the theme it was opened with.
void App.end_theme_picker(bool is_cancelled) {
    if (!is_theme_picker) {
        return;
    }
    is_theme_picker = false;
    if (is_cancelled) {
        str kept = notice;
        did_use_theme(theme_before);
        notice = kept;
    }
}

/// `:Plugins` lists the built-in plugins; `:PluginDisable NAME` and
/// `:PluginEnable NAME` switch one.
void App.run_plugin_command(str name, str arg) {
    if (name == "Plugins") {
        List<str> lines = ["Built-in plugins (:PluginDisable NAME / :PluginEnable NAME):"];
        for (MED_plugin.Plugin one in MED_plugin.all()) {
            str state = "on ";
            if (disabled_plugins.contains(one.name)) {
                state = "off";
            }
            lines.push("  " + state + "  " + one.name + "  " + one.summary);
        }
        for (MED_ext.Extension built_in in ext.extensions) {
            lines.push("  ext  " + built_in.name + "  " + built_in.summary);
        }
        overlay = lines;
        return;
    }
    if (arg.size() == 0) {
        notice = "E471: Argument required";
        return;
    }
    if (!MED_plugin.is_known(arg)) {
        notice = "E474: No such plugin: " + arg;
        return;
    }
    bool is_disable = name == "PluginDisable";
    if (is_disable && MED_plugin.is_core(arg)) {
        notice = "The core plugin cannot be disabled";
        return;
    }
    if (is_disable) {
        if (!disabled_plugins.contains(arg)) {
            disabled_plugins.push(arg);
        }
    } else {
        List<str> kept = [];
        for (str one in disabled_plugins) {
            if (one != arg) {
                kept.push(one);
            }
        }
        disabled_plugins = kept;
    }
    str option = MED_plugin.find(arg).option;
    if (option.size() > 0) {
        for (int position in 0 .. slots.size()) {
            Slot slot = slots[position];
            if (is_disable) {
                slot.editor.opts.set(option, "false");
            } else {
                slot.editor.opts.set(option, "true");
            }
        }
        if (is_disable) {
            editor.opts.set(option, "false");
        } else {
            editor.opts.set(option, "true");
        }
    }
}

/// Whether the built-in plugin `name` is on.
pub bool App.is_plugin_on(str name) {
    return MED_plugin.is_on(disabled_plugins, name);
}

/// A front-end action of a keymap row (`app:NAME ARG`).
void App.run_app_action(str spec) {
    str action = spec;
    str arg = "";
    int space = spec.index_of(" ").or(-1);
    if (space >= 0) {
        action = spec.substr(0, space);
        arg = spec.substr(space + 1, spec.size()).trim();
    }
    if (action.starts_with("lsp_")) {
        run_lsp_command(action.substr(4, action.size()), arg);
    } else if (action.starts_with("harpoon")) {
        run_harpoon(action, arg);
    } else if (action == "hunk_stage" || action == "hunk_reset" || action == "hunk_preview" || action == "blame" || action == "signs") {
        run_git_action(action);
    } else if (action == "jump") {
        if (is_plugin_on("jump")) {
            jump_stage = 1;
            jump_rows = [];
            jump_columns = [];
        }
    } else if (action == "diag_float") {
        show_diagnostic_here();
    } else if (action == "diag_next" || action == "diag_prev") {
        go_diagnostic(action == "diag_next");
    } else {
        notice = "Not supported yet: " + action;
    }
}

/// Run the requests the engine queued, and the ones those queue in turn (a
/// `:source`d file's `:theme` lines).
void App.run_requests() {
    int rounds = 0;
    while (editor.requests.size() > 0 && rounds < 20) {
        rounds = rounds + 1;
        List<str> requests = editor.requests;
        editor.requests = [];
        for (str request in requests) {
            run_request(request);
        }
    }
}

/// Run the pending requests, then say whether the editor should quit now. A
/// quit with unsaved changes is refused the way Vim refuses it (E37, or E162
/// for another buffer) unless it was forced.
bool App.did_finish() {
    run_requests();
    if (editor.message.contains("\n") && editor.mode != MED_editor.CMDLINE) {
        overlay = editor.message.split("\n");
    }
    if (!editor.is_quit) {
        return false;
    }
    remember_position();
    editor.is_quit = false;
    bool is_forced = editor.is_force_quit;
    editor.is_force_quit = false;
    bool is_one = editor.is_quit_one;
    editor.is_quit_one = false;
    if (is_one && wins.size() < 2 && pages.size() > 1) {
        close_page(page_index, is_forced);
        return false;
    }
    if (is_one && wins.size() > 1) {
        if (!is_forced && !is_close_allowed()) {
            return false;
        }
        close_window(current_win);
        return false;
    }
    if (is_forced) {
        return true;
    }
    autowrite(true);
    save_active();
    if (is_modified()) {
        notice = "E37: No write since last change (add ! to override)";
        return false;
    }
    for (Slot slot in slots) {
        if (is_slot_modified(slot)) {
            notice = "E162: No write since last change for buffer \"" + slot_name(slot) + "\" (add ! to override)";
            return false;
        }
    }
    return true;
}

/// The whole screen as the loop gives it.
TUI_geometry.Rect App.screen_rect() {
    term.Size size = TUI_app.screen_size();
    int top = tabline_rows();
    return TUI_geometry.Rect(0, top, size.columns, size.rows - top);
}

/// 1 when the tabline (buffer list) is shown: two or more buffers, plugin on.
int App.tabline_rows() {
    if (pages.size() >= 2) {
        return 1;
    }
    if (!is_plugin_on("statusline") || !editor.is_option_on("bufferline", true)) {
        return 0;
    }
    int count = 0;
    for (Slot one in slots) {
        if (!one.is_listing) {
            count = count + 1;
        }
    }
    if (count >= 2) {
        return 1;
    }
    return 0;
}

/// The buffer list on the first row: ` 1 name `, the current one reversed.
void App.draw_tabline(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    TUI_style.Style bar = theme.look("ui.bufferline");
    TUI_style.Style current = theme.over("ui.bufferline", "ui.bufferline.active");
    buffer.fill(TUI_geometry.Rect(area.x, area.y, area.width, 1), " ", bar);
    int x = area.x;
    if (pages.size() >= 2) {
        List<str> labels = tab_labels();
        for (int position in 0 .. labels.size()) {
            str label = " " + labels[position] + " ";
            TUI_style.Style look = bar;
            if (position == page_index) {
                look = current;
            }
            int label_cells = MED_text.line_width(label, 4);
            if (x + label_cells > area.x + area.width) {
                break;
            }
            buffer.set_str(x, area.y, label, look);
            x = x + label_cells;
        }
        return;
    }
    for (Slot one in slots) {
        if (one.is_listing) {
            continue;
        }
        str name = slot_name(one);
        int slash = last_slash(name);
        if (slash >= 0 && one.title.size() == 0) {
            name = name.substr(slash + 1, name.size());
        }
        str label = " " + one.id.to_str() + " " + name;
        if (is_slot_modified(one)) {
            label = label + " +";
        }
        label = label + " ";
        TUI_style.Style style = bar;
        if (one.id == current_id) {
            style = current;
        }
        if (x + label.size() > area.x + area.width) {
            break;
        }
        buffer.set_str(x, area.y, label, style);
        x = x + label.size();
    }
}

/// Where the windows go on `area`: every row but the last (the command line).
MED_window.Layout App.layout_in(TUI_geometry.Rect area) {
    int height = area.height - 1;
    if (height < 1) {
        height = 1;
    }
    int side = tree_columns(area.width);
    if (side > 0) {
        return MED_window.place(layout, area.x + side + 1, area.y, area.width - side - 1, height);
    }
    return MED_window.place(layout, area.x, area.y, area.width, height);
}

/// The text rows of the active window (its status line takes the last row).
int App.current_text_rows() {
    MED_window.Placed placed = MED_window.placed_of(layout_in(screen_rect()), current_win);
    if (placed.height - 1 < 1) {
        return 1;
    }
    return placed.height - 1;
}

/// Make window `id` the active one: its buffer and cursor come back.
void App.focus_window(int id) {
    save_active();
    int position = win_index(id);
    if (position < 0 || id == current_win) {
        return;
    }
    MED_window.Win target = wins[position];
    int buffer_position = index_of(target.buffer_id);
    if (buffer_position < 0) {
        return;
    }
    if (target.buffer_id != current_id) {
        Slot slot = slots[buffer_position];
        share_state(editor, slot.editor);
        current_id = slot.id;
        editor = slot.editor;
        path = slot.path;
        saved_current = slot.saved_current;
    }
    if (win_index(current_win) >= 0) {
        previous_win = current_win;
    }
    current_win = id;
    editor.row = target.row;
    editor.col = target.col;
    editor.view_top = target.view_top;
    left_column = target.left_column;
    editor.view_left = left_column;
    editor.clamp();
    editor.want_from_cursor();
    // entering a window widens it to 'winwidth' (20) when the others allow
    layout_in(screen_rect());
    if (MED_window.text_width(layout, id) < 20) {
        MED_window.did_resize(layout, id, 20, true);
    }
    editor.view_height = current_text_rows();
}

/// Split the active window (side by side when `is_vertical`); the new window
/// goes right or below, shows the same buffer and takes the focus. False when
/// there is no room.
bool App.did_split(bool is_vertical) {
    save_active();
    // the tree takes the sizes of the screen before it is split
    layout_in(screen_rect());
    if (!MED_window.can_split(layout, current_win, is_vertical)) {
        notice = "E36: Not enough room";
        return false;
    }
    int id = next_win;
    wins.push(MED_window.Win(id, current_id, row: editor.row, col: editor.col, view_top: editor.view_top, left_column: left_column));
    layout = MED_window.split(layout, current_win, id, is_vertical, true);
    next_win = id + 1;
    focus_window(id);
    return true;
}

/// Close window `id`; the one before it in reading order (or after, for the
/// first) gets the focus when it was the active one. The buffer stays loaded.
/// Whether the active window may close: a modified buffer that no other
/// window shows is E37 (the window's buffer would be hidden).
bool App.is_close_allowed() {
    if (!is_modified()) {
        return true;
    }
    int showing = 0;
    for (MED_window.Win one in wins) {
        if (one.buffer_id == current_id) {
            showing = showing + 1;
        }
    }
    if (showing > 1) {
        return true;
    }
    notice = "E37: No write since last change (add ! to override)";
    return false;
}

void App.close_window(int id) {
    if (wins.size() < 2 && pages.size() > 1 && win_index(id) >= 0) {
        // the last window of a tab page closes the page
        close_page(page_index, true);
        return;
    }
    if (wins.size() < 2 || win_index(id) < 0) {
        notice = "E444: Cannot close last window";
        return;
    }
    save_active();
    // the window that gets the space becomes the active one
    int target = current_win;
    if (id == current_win) {
        target = MED_window.successor(layout, id);
    }
    layout = MED_window.without(layout, id, target);
    wins.remove_at(win_index(id));
    if (previous_win == id) {
        previous_win = 0;
    }
    if (id == current_win) {
        current_win = -1;
        focus_window(target);
    }
}

/// `:only`: keep the active window.
void App.only_window() {
    save_active();
    if (wins.size() < 2) {
        notice = "Already only one window";
        return;
    }
    wins = [wins[win_index(current_win)]];
    layout_in(screen_rect());
    layout = MED_window.only(layout, current_win);
    previous_win = 0;
}

/// CTRL-W w / W: the next or previous window in reading order, wrapping.
void App.cycle_window(int step) {
    List<int> order = MED_window.leaves(layout);
    int count = order.size();
    int spot = position_of(order, current_win);
    focus_window(order[(spot + step + count) % count]);
}

/// CTRL-W h j k l: the window in that direction, from where the cursor is.
void App.move_window(int direction) {
    save_active();
    MED_window.Layout current = layout_in(screen_rect());
    MED_window.Placed here = MED_window.placed_of(current, current_win);
    int spot = MED_text.display_col(editor.buffer.line(editor.row), editor.col, editor.tab);
    int ref_x = here.x + gutter_width() + spot - left_column;
    int ref_y = here.y + editor.row - editor.view_top;
    int target = MED_window.neighbor(current, current_win, direction, ref_x, ref_y);
    if (target > 0) {
        focus_window(target);
    } else if (direction == MED_window.GO_LEFT && tree.is_open) {
        tree.is_focused = true;
    }
}

/// Whether the pending keys are only a count (`12`).
bool App.is_count_pending() {
    if (editor.pending.size() == 0) {
        return false;
    }
    for (int digit in editor.pending) {
        if (digit < 48 || digit > 57) {
            return false;
        }
    }
    return editor.pending[0] != 48;
}

/// `CTRL-W T`: the window moves to a tab page of its own.
void App.window_to_page() {
    if (wins.size() < 2) {
        notice = "Already only one window";
        return;
    }
    save_page();
    int id = current_win;
    MED_window.Win moving = wins[win_index(id)];
    int target = MED_window.successor(layout, id);
    int next_page = page_index + 1;
    // the tab line is there from now on: the old page is laid out under it
    // before the window leaves it, as nvim closes the window after opening
    // the new page
    pages.insert(next_page, MED_window.Page(wins: [moving], layout: MED_window.leaf(id), current_win: id));
    layout_in(screen_rect());
    layout = MED_window.without(layout, id, target);
    wins.remove_at(win_index(id));
    pages[page_index] = MED_window.Page(wins: wins, layout: layout, current_win: target);
    page_index = next_page;
    wins = [moving];
    layout = pages[next_page].layout;
    current_win = id;
    previous_win = 0;
}

/// The window command `key` (CTRL-W KEY, `:wincmd KEY`) with an optional count.
void App.window_command(int key, int count) {
    int steps = count;
    if (steps < 1) {
        steps = 1;
    }
    if (tree.is_focused) {
        // from the tree every window command goes back to the editor windows
        tree.is_focused = false;
        if (key == 108 || key == 12 || key == 119 || key == 23 || key == 112 || key == 16 || key == 87) {
            return;
        }
    }
    List<int> order = MED_window.leaves(layout);
    if (key == 115 || key == 83 || key == 19) {
        did_split(false);
    } else if (key == 118 || key == 22) {
        did_split(true);
    } else if (key == 110 || key == 14) {
        if (did_split(false)) {
            new_buffer();
        }
    } else if (key == 99) {
        if (is_close_allowed()) {
            close_window(current_win);
        }
    } else if (key == 113 || key == 17) {
        editor.is_quit = true;
        editor.is_quit_one = true;
    } else if (key == 111 || key == 15) {
        only_window();
    } else if (key == 119 || key == 23 || key == 87) {
        if (count > 0) {
            // CTRL-W 3 w: window number 3 (the last when there are fewer)
            int nth = count - 1;
            if (nth >= order.size()) {
                nth = order.size() - 1;
            }
            focus_window(order[nth]);
        } else if (key == 87) {
            cycle_window(-1);
        } else {
            cycle_window(1);
        }
    } else if (key == 112 || key == 16) {
        if (win_index(previous_win) >= 0) {
            focus_window(previous_win);
        }
    } else if (key == 116 || key == 20) {
        focus_window(order[0]);
    } else if (key == 98 || key == 2) {
        focus_window(order[order.size() - 1]);
    } else if (key == 104 || key == 8 || key == 106 || key == 10 || key == 107 || key == 11 || key == 108 || key == 12) {
        int toward = MED_window.GO_LEFT;
        if (key == 106 || key == 10) {
            toward = MED_window.GO_DOWN;
        } else if (key == 107 || key == 11) {
            toward = MED_window.GO_UP;
        } else if (key == 108 || key == 12) {
            toward = MED_window.GO_RIGHT;
        }
        for (int step in 0 .. steps) {
            move_window(toward);
        }
    } else if (key == 43) {
        resize_window(steps, false, false);
    } else if (key == 45) {
        resize_window(0 - steps, false, false);
    } else if (key == 62) {
        resize_window(steps, true, false);
    } else if (key == 60) {
        resize_window(0 - steps, true, false);
    } else if (key == 95) {
        if (count > 0) {
            resize_window(count, false, true);
        } else {
            resize_window(1000, false, true);
        }
    } else if (key == 124) {
        if (count > 0) {
            resize_window(count, true, true);
        } else {
            resize_window(1000, true, true);
        }
    } else if (key == 84) {
        window_to_page();
    } else if (key == 61) {
        layout_in(screen_rect());
        MED_window.equalize(layout, current_win);
    } else if (key == 72 || key == 74 || key == 75 || key == 76) {
        int direction = MED_window.GO_LEFT;
        if (key == 74) {
            direction = MED_window.GO_DOWN;
        } else if (key == 75) {
            direction = MED_window.GO_UP;
        } else if (key == 76) {
            direction = MED_window.GO_RIGHT;
        }
        layout = MED_window.moved_to_edge(layout, current_win, direction);
    } else if (key == 114 || key == 82) {
        if (!MED_window.did_rotate(layout, current_win, key == 114)) {
            notice = "E443: Cannot rotate when another window is split";
        }
    } else if (key == 120 || key == 24) {
        int other = MED_window.exchange(layout, current_win);
        if (other > 0) {
            focus_window(other);
        }
    }
}

/// `:resize`, `CTRL-W + - < > _ |`: `amount` more (or fewer) rows, or columns
/// when `is_vertical`; with `is_absolute` exactly that many.
void App.resize_window(int amount, bool is_vertical, bool is_absolute) {
    MED_window.Placed here = MED_window.placed_of(layout_in(screen_rect()), current_win);
    int size = here.height - 1;
    if (is_vertical) {
        size = here.width;
    }
    int wanted = size + amount;
    if (is_absolute) {
        wanted = amount;
    }
    MED_window.did_resize(layout, current_win, wanted, is_vertical);
}

/// The windows of tab page `index` (the live ones for the active page).
List<MED_window.Win> App.page_wins(int index) {
    if (index == page_index || pages.size() == 0) {
        return wins;
    }
    return pages[index].wins;
}

/// How many tab pages there are.
pub int App.page_count() {
    if (pages.size() == 0) {
        return 1;
    }
    return pages.size();
}

/// The tab line labels: window count and `+` when any buffer is changed,
/// then the name of the page's active window's buffer.
List<str> App.tab_labels() {
    save_active();
    List<str> labels = [];
    for (int index in 0 .. page_count()) {
        List<MED_window.Win> in_page = page_wins(index);
        int showing_id = current_id;
        bool is_changed = false;
        for (MED_window.Win win in in_page) {
            int position = index_of(win.buffer_id);
            if (position >= 0 && is_slot_modified(slots[position])) {
                is_changed = true;
            }
        }
        if (index == page_index) {
            showing_id = current_id;
        } else {
            showing_id = pages[index].wins[0].buffer_id;
            for (MED_window.Win win in in_page) {
                if (win.id == pages[index].current_win) {
                    showing_id = win.buffer_id;
                }
            }
        }
        str label = "";
        if (in_page.size() > 1) {
            label = in_page.size().to_str();
        }
        if (is_changed) {
            label = label + "+";
        }
        if (label.size() > 0) {
            label = label + " ";
        }
        int found_at = index_of(showing_id);
        if (found_at >= 0) {
            label = label + slot_name(slots[found_at]);
        }
        labels.push(label);
    }
    return labels;
}

/// Store the live windows into the active page's entry.
void App.save_page() {
    save_active();
    if (pages.size() == 0) {
        pages.push(MED_window.Page(wins: wins, layout: layout, current_win: current_win, previous_win: previous_win));
        page_index = 0;
        return;
    }
    pages[page_index] = MED_window.Page(wins: wins, layout: layout, current_win: current_win, previous_win: previous_win);
}

/// Make tab page `target` (0-based) the active one.
void App.go_page(int target) {
    if (pages.size() == 0 || target == page_index || target < 0 || target >= pages.size()) {
        return;
    }
    save_page();
    MED_window.Page page = pages[target];
    page_index = target;
    wins = page.wins;
    layout = page.layout;
    current_win = -1;
    focus_window(page.current_win);
    previous_win = page.previous_win;
}

/// `:tabnew [file]`: a page after the active one (or at `place`) with one window.
void App.new_page(str arg, int place, bool is_empty) {
    save_page();
    int id = next_win;
    next_win = id + 1;
    int position = page_index + 1;
    if (place >= 0 && place <= pages.size()) {
        position = place;
    }
    pages.insert(position, MED_window.Page(wins: [MED_window.Win(id, current_id, row: editor.row, col: editor.col, view_top: editor.view_top, left_column: left_column)], layout: MED_window.leaf(id), current_win: id));
    if (position <= page_index) {
        page_index = page_index + 1;
    }
    // the new page becomes the active one: its window starts with this buffer
    go_page(position);
    if (arg.trim().size() > 0) {
        edit(arg, false);
    } else if (is_empty) {
        new_buffer();
    }
}

/// `:tabclose [N]`, and `:q` on the last window of a page.
void App.close_page(int target, bool is_forced) {
    if (pages.size() < 2) {
        notice = "E784: Cannot close last tab page";
        return;
    }
    save_page();
    if (!is_forced) {
        for (MED_window.Win win in pages[target].wins) {
            int position = index_of(win.buffer_id);
            if (position < 0 || !is_slot_modified(slots[position])) {
                continue;
            }
            bool is_elsewhere = false;
            for (int other in 0 .. pages.size()) {
                if (other == target) {
                    continue;
                }
                for (MED_window.Win again in pages[other].wins) {
                    if (again.buffer_id == win.buffer_id) {
                        is_elsewhere = true;
                    }
                }
            }
            if (!is_elsewhere) {
                notice = "E37: No write since last change (add ! to override)";
                return;
            }
        }
    }
    if (target == page_index) {
        int next = target + 1;
        if (next >= pages.size()) {
            next = target - 1;
        }
        go_page(next);
        pages.remove_at(target);
        if (next > target) {
            page_index = next - 1;
        } else {
            page_index = next;
        }
    } else {
        pages.remove_at(target);
        if (target < page_index) {
            page_index = page_index - 1;
        }
    }
    if (pages.size() == 1) {
        pages = [];
        page_index = 0;
    }
}

/// `:tabonly`: close every other page.
void App.only_page(bool is_forced) {
    if (pages.size() < 2) {
        notice = "Already only one tab page";
        return;
    }
    int index = pages.size() - 1;
    while (index >= 0) {
        if (pages.size() < 2) {
            return;
        }
        if (index < pages.size() && index != page_index) {
            close_page(index, is_forced);
            if (pages.size() > 1 && index < pages.size() && index != page_index) {
                // refused: a changed buffer
                notice = "E445: Other window contains changes";
                return;
            }
        }
        index = index - 1;
    }
}

/// `:tabmove [N]`.
void App.move_page(str arg) {
    if (pages.size() < 2) {
        return;
    }
    save_page();
    int last = pages.size() - 1;
    int target = last;
    str word = arg.trim();
    if (word.size() > 0) {
        if (word.byte_at(0) == 43 || word.byte_at(0) == 45) {
            int delta = word.substr(1, word.size()).parse_int().or(1);
            if (word.byte_at(0) == 45) {
                delta = 0 - delta;
            }
            target = page_index + delta;
        } else {
            target = word.parse_int().or(last);
        }
    }
    if (target < 0) {
        target = 0;
    }
    if (target > last) {
        target = last;
    }
    MED_window.Page moved = pages[page_index];
    pages.remove_at(page_index);
    pages.insert(target, moved);
    page_index = target;
}

/// The `:tab...` commands; `arg` is the text after the command word.
void App.run_tab_command(str name, str arg, bool is_forced) {
    int count = page_count();
    str word = arg.trim();
    if (name == "tabnew" || name == "tabedit") {
        int place = -1;
        str file = word;
        if (word.starts_with("#")) {
            // `:2tabnew file` arrives as "#2 file": the page goes after page 2
            int space = word.index_of(" ").or(word.size());
            place = word.substr(1, space).parse_int().or(-1);
            file = word.substr(space, word.size()).trim();
        }
        new_page(file, place, true);
    } else if (name == "tabcmd") {
        // `:[N]tab split|vsplit|new|vnew [file]` arrives as "N command file"
        List<str> parts = word.split(" ");
        int place = parts[0].parse_int().or(-1);
        str sub = parts[1];
        str file = parts.slice(2, parts.size()).join(" ").trim();
        new_page(file, place, sub == "new" || sub == "vnew");
    } else if (name == "tabnext") {
        if (word.size() > 0) {
            if (word.byte_at(0) == 43 || word.byte_at(0) == 45) {
                int delta = word.substr(1, word.size()).parse_int().or(1);
                if (word.byte_at(0) == 45) {
                    delta = 0 - delta;
                }
                go_page(((page_index + delta) % count + count) % count);
            } else {
                int number = word.parse_int().or(0);
                if (number < 1 || number > count) {
                    notice = "E475: Invalid argument: " + word;
                } else {
                    go_page(number - 1);
                }
            }
        } else {
            go_page((page_index + 1) % count);
        }
    } else if (name == "tabprevious" || name == "tabNext") {
        int step = 1;
        if (word.size() > 0) {
            step = word.parse_int().or(1);
        }
        go_page(((page_index - step) % count + count) % count);
    } else if (name == "tabfirst" || name == "tabrewind") {
        go_page(0);
    } else if (name == "tablast") {
        go_page(count - 1);
    } else if (name == "tabclose") {
        int target = page_index;
        if (word.size() > 0) {
            target = word.parse_int().or(0) - 1;
            if (target < 0 || target >= count) {
                notice = "E475: Invalid argument: " + word;
                return;
            }
        }
        close_page(target, is_forced);
    } else if (name == "tabonly") {
        only_page(is_forced);
    } else if (name == "tabmove") {
        move_page(word);
    } else if (name == "tabs") {
        save_active();
        List<str> lines = [];
        for (int index in 0 .. count) {
            lines.push("Tab page " + (index + 1).to_str());
            List<MED_window.Win> in_page = page_wins(index);
            for (MED_window.Win win in in_page) {
                int position = index_of(win.buffer_id);
                if (position < 0) {
                    continue;
                }
                str flag = " ";
                if (index == page_index && win.id == current_win) {
                    flag = ">";
                } else if (win.buffer_id == alternate_id && index == page_index) {
                    flag = "#";
                }
                str modified = " ";
                if (is_slot_modified(slots[position])) {
                    modified = "+";
                }
                lines.push(flag + " " + modified + " " + slot_name(slots[position]));
            }
        }
        overlay = lines;
    }
}

/// `:split`, `:vsplit`, `:new`, `:vnew` with an optional file.
void App.run_split(str name, str arg) {
    bool is_vertical = name == "vsplit" || name == "vnew";
    if (!did_split(is_vertical)) {
        return;
    }
    if (arg.trim().size() > 0) {
        edit(arg, false);
    } else if (name == "new" || name == "vnew") {
        new_buffer();
    }
}

/// Whether the active buffer is a directory listing.
bool App.is_in_listing() {
    int position = index_of(current_id);
    return position >= 0 && slots[position].is_listing;
}

/// The directory `:Explore [dir]` shows: `arg`, else the directory of the file.
str App.explore_directory(str arg) {
    if (arg.trim().size() > 0) {
        return arg.trim();
    }
    if (is_in_listing()) {
        return path;
    }
    return parent_directory(path);
}

/// The name the listing cursor should rest on: the file being edited.
str App.current_file_name() {
    if (is_in_listing() || path.size() == 0) {
        return "";
    }
    return base_name(path);
}

/// Show the listing of `directory` (in this window), with the cursor on the
/// line `focus`. The buffer it came from stays loaded, as the alternate.
void App.open_listing(str directory, str focus) {
    str target = plain_directory(directory);
    if (!fs.is_directory(target)) {
        notice = "E344: Can't find directory \"" + target + "\" in cdpath";
        return;
    }
    save_active();
    if (is_in_listing()) {
        reload_listing(target, focus);
        return;
    }
    for (Slot known in slots) {
        if (known.is_listing && known.path == target) {
            activate(known.id);
            reload_listing(target, focus);
            return;
        }
    }
    adopt(listing_slot(next_id, target, focus, is_dotfiles_listed));
}

/// Re-read the listing in the active buffer, now for `directory`.
void App.reload_listing(str directory, str focus) {
    Slot fresh = listing_slot(current_id, directory, focus, is_dotfiles_listed);
    share_state(editor, fresh.editor);
    fresh.editor.view_height = current_text_rows();
    editor = fresh.editor;
    path = directory;
    saved_current = fresh.saved_current;
    left_column = 0;
    save_active();
}

/// `-` in a listing: the directory above, the cursor on where we came from.
void App.go_up_listing() {
    str here = path;
    open_listing(up_directory(here), base_name(here) + "/");
}

/// Enter in a listing: descend into the directory or edit the file.
void App.open_listing_entry() {
    str entry = editor.buffer.line(editor.row);
    if (entry.size() == 0) {
        return;
    }
    if (entry == "../") {
        go_up_listing();
        return;
    }
    str target = child_path(path, entry);
    if (entry.ends_with("/")) {
        open_listing(target, "");
        return;
    }
    int listing_id = current_id;
    edit(target, false);
    if (current_id == listing_id) {
        return;
    }
    save_active();
    for (MED_window.Win win in wins) {
        if (win.buffer_id == listing_id) {
            return;
        }
    }
    delete_buffer(listing_id.to_str(), true);
}

/// Open the command line with `text` typed already.
void App.begin_command(str text) {
    MED_ex.feed(editor, 58);
    for (int code_point in text.chars()) {
        MED_ex.feed(editor, code_point);
    }
}

/// Rename, delete, create in the listing's directory (`:Rename old new`,
/// `:Delete name`, `:Create name`, `:Mkdir name`).
void App.listing_file_command(str name, str arg) {
    if (!is_in_listing()) {
        notice = "E492: Not an editor command: " + name;
        return;
    }
    str given = arg.trim();
    if (given.size() == 0) {
        notice = "E471: Argument required";
        return;
    }
    int row = editor.row;
    if (name == "Rename") {
        int space = given.index_of(" ").or(-1);
        if (space < 0) {
            notice = "E471: Argument required";
            return;
        }
        str old_name = given.substr(0, space);
        str new_name = given.substr(space + 1, given.size()).trim();
        match (fs.rename(child_path(path, old_name), child_path(path, new_name))) {
            case Ok(bool is_renamed): {
                reload_listing(path, new_name);
            }
            case Err(io.Error error): {
                notice = "E141: Could not rename: " + error.to_str();
            }
        }
    } else if (name == "Delete") {
        str target = child_path(path, given.split("/").join(""));
        bool is_directory = fs.is_directory(target);
        if (is_directory) {
            match (fs.rmdir(target)) {
                case Ok(bool is_removed): {
                    reload_listing(path, "");
                }
                case Err(io.Error error): {
                    notice = "E668: Could not remove directory: " + error.to_str();
                }
            }
        } else {
            match (fs.remove(target)) {
                case Ok(bool is_removed): {
                    reload_listing(path, "");
                }
                case Err(io.Error error): {
                    notice = "E141: Could not delete: " + error.to_str();
                }
            }
        }
        editor.row = row;
        editor.clamp();
        editor.want_from_cursor();
    } else if (name == "Mkdir") {
        match (fs.mkdir(child_path(path, given))) {
            case Ok(bool is_made): {
                reload_listing(path, given + "/");
            }
            case Err(io.Error error): {
                notice = "E739: Cannot create directory: " + error.to_str();
            }
        }
    } else if (name == "Create") {
        str target = child_path(path, given);
        if (!fs.is_present(target)) {
            match (io.write(target, "")) {
                case Ok(int count): {
                }
                case Err(io.Error error): {
                    notice = "E212: Can't open file for writing: " + error.to_str();
                    return;
                }
            }
        }
        edit(target, false);
    }
}

/// The text of a listing cannot change: undo whatever the last key did by
/// reading the directory again, as Vim refuses with E21 on a non-modifiable buffer.
void App.keep_listing_read_only() {
    bool is_typing = editor.mode == MED_editor.INSERT || editor.mode == MED_editor.REPLACE;
    if (editor.current == saved_current && !is_typing) {
        return;
    }
    int row = editor.row;
    reload_listing(path, "");
    editor.row = row;
    editor.clamp();
    editor.want_from_cursor();
    notice = "E21: Cannot make changes, 'modifiable' is off";
}

/// The columns the tree takes on a screen `screen_width` wide (0 when closed
/// or when the screen is too narrow to share), not counting its separator.
int App.tree_columns(int screen_width) {
    if (!tree.is_open || screen_width < TREE_MIN_SCREEN) {
        return 0;
    }
    int side = tree.width;
    if (side > screen_width / 2) {
        side = screen_width / 2;
    }
    if (side < 12) {
        side = 12;
    }
    return side;
}

/// How many rows of the sidebar list entries (below its header, above its status).
int App.tree_list_rows() {
    int rows = screen_rect().height - 1 - 2;
    if (rows < 1) {
        return 1;
    }
    return rows;
}

/// The root's name for the sidebar header.
str App.tree_title() {
    str root_text = tree.root;
    if (root_text == ".") {
        root_text = os.env("PWD").or(".");
    }
    str name = MED_tree.name_of(root_text);
    if (name.size() == 0 || name == ".") {
        return root_text;
    }
    return name;
}

/// Open the sidebar (and put the cursor on the current file).
void App.open_tree(bool is_focus) {
    if (!tree.is_open) {
        tree.is_open = true;
        tree.width = editor.option_number("treewidth", 32);
        tree.has_glyphs = editor.is_option_on("treeglyphs", false);
        tree.is_hidden_shown = editor.is_option_on("treehidden", false);
        tree.refresh_status();
    }
    if (path.size() > 0 && !is_in_listing()) {
        if (tree.did_reveal(path)) {
            tree.followed = path;
        }
    }
    if (is_focus) {
        tree.is_focused = true;
    }
}

void App.close_tree() {
    tree.is_open = false;
    tree.is_focused = false;
}

/// The folder an operation on the cursor row works in: the row itself when it
/// is a folder, else the folder of the file; the root when the tree is empty.
str App.tree_target_directory() {
    match (tree.current()) {
        case Some(MED_tree.Entry here): {
            if (here.is_directory) {
                return here.path;
            }
            return MED_tree.parent_of(here.path);
        }
        case None: {
            return tree.root;
        }
    }
}

/// Open `file` from the tree: here (0), in a window below (1) or beside (2).
void App.tree_open(str file, int how) {
    tree.is_focused = false;
    if (how == 1) {
        if (!did_split(false)) {
            return;
        }
    } else if (how == 2) {
        if (!did_split(true)) {
            return;
        }
    }
    edit(file, false);
    if (path == file) {
        tree.followed = file;
    }
}

void App.tree_help() {
    overlay = ["File tree keys", "  j k gg G C-d C-u   move        l <CR> o   open / expand    h   collapse / parent", "  s v t              open in split / vsplit / vsplit    z   collapse all", "  a   add (trailing / makes a folder)    d   delete    r   rename    c   copy to    m   move to", "  y   yank path    x   cut    p   paste    H   toggle hidden    /   filter    <Esc>   clear filter", "  R   refresh    P   preview    i   info    .   set root    u <BS>   up    q   close    ?   this help", "  <C-w>l <C-w>w   back to the editor window    :Neotree reveal|toggle|focus|close|refresh"];
}

/// One key typed in the focused tree. Never quits.
void App.did_tree_key(int key) {
    int count = tree.entries.size();
    int rows = tree_list_rows();
    if (is_tree_pending_g) {
        is_tree_pending_g = false;
        if (key == 103) {
            tree.row = 0;
        }
        return;
    }
    MED_tree.Entry here = MED_tree.Entry("", "", "", 0, false, false);
    bool has_here = false;
    match (tree.current()) {
        case Some(MED_tree.Entry found): {
            here = found;
            has_here = true;
        }
        case None: {
        }
    }
    if (key == 106 || key == MED_key.DOWN || key == 14) {
        tree.row = tree.row + 1;
    } else if (key == 107 || key == MED_key.UP_KEY || key == 16) {
        tree.row = tree.row - 1;
    } else if (key == 103) {
        is_tree_pending_g = true;
        return;
    } else if (key == 71 || key == MED_key.END) {
        tree.row = count - 1;
    } else if (key == MED_key.HOME) {
        tree.row = 0;
    } else if (key == 4) {
        tree.row = tree.row + rows / 2;
    } else if (key == 21) {
        tree.row = tree.row - rows / 2;
    } else if (key == 6 || key == MED_key.PAGE_DOWN) {
        tree.row = tree.row + rows;
    } else if (key == 2 || key == MED_key.PAGE_UP) {
        tree.row = tree.row - rows;
    } else if (key == MED_key.ESC) {
        if (tree.filter.size() > 0) {
            tree.filter = "";
            tree.refresh();
        } else {
            tree.is_focused = false;
        }
    } else if (key == 113) {
        close_tree();
    } else if (key == 63) {
        tree_help();
    } else if (key == 82) {
        tree.refresh_status();
        notice = "Tree refreshed";
    } else if (key == 72) {
        tree.is_hidden_shown = !tree.is_hidden_shown;
        tree.refresh();
    } else if (key == 122) {
        tree.collapse_all();
    } else if (key == 47) {
        begin_command("Neotree filter " + tree.filter);
    } else if (key == 46) {
        if (has_here && here.is_directory) {
            tree.root = here.path;
        } else if (has_here) {
            tree.root = MED_tree.parent_of(here.path);
        }
        tree.row = 0;
        tree.top = 0;
        tree.refresh_status();
    } else if (key == 117 || key == MED_key.BACKSPACE || key == 45) {
        tree.root = up_directory(tree.root);
        tree.row = 0;
        tree.top = 0;
        tree.refresh_status();
    } else if (key == 97) {
        str directory = tree_target_directory();
        str prefill = "";
        if (directory != ".") {
            prefill = directory + "/";
        }
        begin_command("Neotree add " + prefill);
    } else if (!has_here) {
        // nothing under the cursor for the keys below
    } else if (key == 108 || key == MED_key.RIGHT) {
        if (here.is_directory && !here.is_open) {
            tree.toggle(here.path);
        } else if (here.is_directory) {
            tree.row = tree.row + 1;
        } else {
            tree_open(here.path, 0);
        }
    } else if (key == 104 || key == MED_key.LEFT) {
        if (here.is_directory && here.is_open && tree.filter.size() == 0) {
            tree.toggle(here.path);
        } else {
            int above = tree.row - 1;
            while (above >= 0 && !(tree.entries[above].is_directory && tree.entries[above].depth < here.depth)) {
                above = above - 1;
            }
            if (above >= 0) {
                tree.row = above;
            }
        }
    } else if (key == MED_key.CARRIAGE_RETURN || key == 111 || key == 10) {
        if (here.is_directory) {
            tree.toggle(here.path);
        } else {
            tree_open(here.path, 0);
        }
    } else if (key == 115) {
        if (!here.is_directory) {
            tree_open(here.path, 1);
        }
    } else if (key == 118 || key == 116) {
        if (!here.is_directory) {
            tree_open(here.path, 2);
        }
    } else if (key == 100) {
        begin_command("Neotree delete " + here.path);
    } else if (key == 114) {
        tree.rename_from = here.path;
        begin_command("Neotree rename " + here.path);
    } else if (key == 109) {
        tree.rename_from = here.path;
        begin_command("Neotree move " + here.path);
    } else if (key == 99) {
        tree.rename_from = here.path;
        begin_command("Neotree copy " + here.path);
    } else if (key == 121) {
        tree.clipboard = here.path;
        tree.is_cut = false;
        notice = "Copied " + here.name;
    } else if (key == 120) {
        tree.clipboard = here.path;
        tree.is_cut = true;
        notice = "Cut " + here.name;
    } else if (key == 112) {
        run_tree("paste");
    } else if (key == 80) {
        if (here.is_directory) {
            overlay = ["(folder)"];
        } else {
            overlay = read_preview(here.path);
            if (overlay.size() > 20) {
                overlay = overlay.slice(0, 20);
            }
        }
    } else if (key == 105) {
        notice = here.path;
        if (here.status.size() > 0) {
            notice = notice + "  [" + here.status + "]";
        }
    }
    if (tree.row >= tree.entries.size()) {
        tree.row = tree.entries.size() - 1;
    }
    if (tree.row < 0) {
        tree.row = 0;
    }
}

/// `:Neotree [toggle|show|focus|close|reveal|refresh|DIR]` and the prompts the
/// tree keys open (`filter`, `add`, `delete`, `rename`, `move`, `copy`, `paste`).
void App.run_tree(str arg) {
    int space = arg.index_of(" ").or(-1);
    str word = arg;
    str rest = "";
    if (space >= 0) {
        word = arg.substr(0, space);
        rest = arg.substr(space + 1, arg.size()).trim();
    }
    List<str> made = [];
    str failure = "";
    if (word == "" || word == "focus") {
        open_tree(true);
    } else if (word == "toggle") {
        if (tree.is_open) {
            close_tree();
        } else {
            open_tree(true);
        }
    } else if (word == "show") {
        open_tree(false);
    } else if (word == "close") {
        close_tree();
    } else if (word == "reveal") {
        open_tree(true);
        if (path.size() > 0 && !tree.did_reveal(path)) {
            notice = "Not in the tree: " + path;
        }
    } else if (word == "refresh") {
        if (tree.is_open) {
            tree.refresh_status();
        }
    } else if (word == "hidden") {
        tree.is_hidden_shown = !tree.is_hidden_shown;
        tree.refresh();
    } else if (word == "filter") {
        tree.filter = rest;
        tree.row = 0;
        tree.top = 0;
        tree.refresh();
    } else if (word == "add") {
        failure = MED_tree.add(".", rest, made);
        if (failure.size() == 0) {
            tree.refresh_status();
            if (made.size() > 0) {
                tree.did_reveal(made[0]);
                notice = "Created " + made[0];
            }
        }
    } else if (word == "delete") {
        failure = MED_tree.remove_path(rest);
        if (failure.size() == 0) {
            tree.refresh_status();
            notice = "Deleted " + rest;
        }
    } else if (word == "rename" || word == "move") {
        failure = MED_tree.rename_path(tree.rename_from, rest);
        if (failure.size() == 0) {
            notice = "Moved to " + rest;
            if (path == tree.rename_from) {
                path = rest;
                editor.buffer.path = rest;
                save_active();
            }
            tree.refresh_status();
            tree.did_reveal(rest);
        }
    } else if (word == "copy") {
        failure = MED_tree.copy_path(tree.rename_from, rest);
        if (failure.size() == 0) {
            notice = "Copied to " + rest;
            tree.refresh_status();
            tree.did_reveal(rest);
        }
    } else if (word == "paste") {
        failure = tree.paste_into(tree_target_directory(), made);
        if (failure.size() == 0) {
            tree.refresh_status();
            if (made.size() > 0) {
                tree.did_reveal(made[0]);
                notice = "Pasted " + made[0];
            }
        }
    } else if (fs.is_directory(arg)) {
        tree.root = plain_directory(arg);
        tree.row = 0;
        open_tree(true);
        tree.refresh_status();
    } else {
        notice = "E474: Invalid argument: Neotree " + arg;
    }
    if (failure.size() > 0) {
        notice = failure;
    }
}

/// The timer: git status again every few seconds; the tree follows the buffer.
bool App.did_tree_tick(int elapsed_ms) {
    bool did_change = false;
    if (!tree.is_focused && path.size() > 0 && path != tree.followed && !is_in_listing()) {
        tree.followed = path;
        did_change = tree.did_reveal(path);
    }
    tree.status_ms = tree.status_ms + elapsed_ms;
    if (tree.status_ms >= TREE_STATUS_MS && editor.mode == MED_editor.NORMAL) {
        tree.status_ms = 0;
        Map<str, str> before = tree.status;
        tree.refresh_status();
        if (before.size() != tree.status.size()) {
            did_change = true;
        } else {
            for (str name in before.keys()) {
                if (before.get(name).or("") != tree.status.get(name).or("")) {
                    did_change = true;
                }
            }
        }
    }
    return did_change;
}

/// A click or wheel turn in the sidebar's columns.
TUI_app.Action App.handle_tree_mouse(TUI_mouse.Gesture gesture) {
    int rows = tree_list_rows();
    match (gesture.kind) {
        case Press: {
            if (gesture.button != 0) {
                return TUI_app.Action.Continue;
            }
            tree.is_focused = true;
            int offset = tabline_rows();
            int index = tree.top + gesture.y - 1 - offset;
            if (gesture.y >= 1 + offset && gesture.y <= rows + offset && index >= 0 && index < tree.entries.size()) {
                tree.row = index;
                MED_tree.Entry here = tree.entries[index];
                if (here.is_directory) {
                    tree.toggle(here.path);
                } else {
                    tree_open(here.path, 0);
                }
            }
            return TUI_app.Action.Redraw;
        }
        case ScrollUp: {
            tree.row = tree.row - WHEEL_LINES;
            if (tree.row < 0) {
                tree.row = 0;
            }
            return TUI_app.Action.Redraw;
        }
        case ScrollDown: {
            tree.row = tree.row + WHEEL_LINES;
            if (tree.row >= tree.entries.size()) {
                tree.row = tree.entries.size() - 1;
            }
            if (tree.row < 0) {
                tree.row = 0;
            }
            return TUI_app.Action.Redraw;
        }
        case Drag: {
        }
        case Release: {
        }
        case Click: {
        }
        case Hover: {
        }
        case Leave: {
        }
        case ScrollLeft: {
        }
        case ScrollRight: {
        }
    }
    return TUI_app.Action.Continue;
}

/// Draw the sidebar in the columns `tree_columns` reserved.
void App.draw_tree(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    int side = tree_columns(area.width);
    int height = area.height - 1;
    if (height < 3) {
        return;
    }
    int rows = height - 2;
    tree.scroll_to(rows);
    TUI_style.Style plain = theme.look("ui.text");
    TUI_style.Style dim = theme.look("ui.window");
    TUI_style.Style folder = theme.look("ui.tree.directory");
    TUI_style.Style hidden = theme.look("ui.tree.hidden");
    TUI_style.Style header = theme.look("ui.picker.title");
    for (int y in 0 .. height) {
        for (int x in 0 .. side) {
            buffer.set_str(area.x + x, area.y + y, " ", plain);
        }
        buffer.set_str(area.x + side, area.y + y, "|", dim);
    }
    str title = clip_cells(tree_title(), side - 2);
    if (tree.filter.size() > 0) {
        title = clip_cells(tree_title() + " /" + tree.filter, side - 2);
    }
    buffer.set_str(area.x + 1, area.y, title, header);
    for (int line in 0 .. rows) {
        int index = tree.top + line;
        if (index >= tree.entries.size()) {
            break;
        }
        MED_tree.Entry entry = tree.entries[index];
        TUI_style.Style look = plain;
        if (entry.is_directory) {
            look = folder;
        } else if (entry.name.starts_with(".")) {
            look = hidden;
        }
        bool is_selected = index == tree.row;
        if (is_selected) {
            look = plain.with_attrs(TUI_style.BOLD);
            if (tree.is_focused) {
                look = theme.look("ui.menu.selected");
            }
            for (int x in 0 .. side) {
                buffer.set_str(area.x + x, area.y + 1 + line, " ", look);
            }
        }
        str text = clip_cells(entry.label(tree.has_glyphs), side - 3);
        buffer.set_str(area.x, area.y + 1 + line, text, look);
        if (entry.status.size() > 0) {
            str scope = "diff.delta";
            if (entry.status == "A" || entry.status == "?") {
                scope = "diff.plus";
            } else if (entry.status == "D" || entry.status == "!") {
                scope = "diff.minus";
            }
            TUI_style.Style mark = theme.look(scope).with_attrs(TUI_style.BOLD);
            if (is_selected && tree.is_focused) {
                mark = look;
            }
            buffer.set_str(area.x + side - 2, area.y + 1 + line, entry.status, mark);
        }
    }
    str label = "TREE";
    if (tree.is_focused) {
        label = "TREE *";
    }
    TUI_style.Style bar = theme.look("ui.statusline");
    for (int x in 0 .. side) {
        buffer.set_str(area.x + x, area.y + height - 1, " ", bar);
    }
    buffer.set_str(area.x + 1, area.y + height - 1, label, bar);
}

/// Open the picker `name` (files, buffers, grep, commands, help, explore);
/// `arg` is the starting query of grep or the directory of the explorer.
pub void App.open_picker(str name, str arg) {
    overlay = [];
    is_leader = false;
    is_which_key = false;
    preview_path = "";
    is_grep_due = false;
    end_theme_picker(true);
    stop_source();
    if (name == "files") {
        picker = MED_picker.make(MED_picker.KIND_FILES, "Files");
        root = MED_files.project_root();
        load_files();
    } else if (name == "buffers") {
        picker = MED_picker.make(MED_picker.KIND_BUFFERS, "Buffers");
        load_buffers();
    } else if (name == "grep") {
        picker = MED_picker.make(MED_picker.KIND_GREP, "Grep");
        root = MED_files.project_root();
        picker.query = arg.trim();
        run_grep();
    } else if (name == "commands") {
        picker = MED_picker.make(MED_picker.KIND_COMMANDS, "Commands");
        load_commands(false);
    } else if (name == "help") {
        picker = MED_picker.make(MED_picker.KIND_HELP, "Keymap");
        load_commands(true);
    } else if (name == "marks") {
        picker = MED_picker.make(MED_picker.KIND_MARKS, "Marks");
        load_marks();
    } else if (name == "explore") {
        picker = MED_picker.make(MED_picker.KIND_EXPLORE, "Explore");
        picker.directory = parent_directory(path);
        if (arg.trim().size() > 0) {
            picker.directory = arg.trim();
        }
        load_directory();
    } else if (!did_open_list_picker(name, arg)) {
        return;
    }
    has_picker = true;
    picker.is_deferred = true;
    update_preview();
}

/// The frecency store, read on first use.
void App.load_frecency() {
    int days = editor.option_number("finderhalflife", MED_frecency.DEFAULT_HALF_LIFE_DAYS);
    if (days < 1) {
        days = 1;
    }
    if (!is_frecency_loaded) {
        frecency = MED_frecency.load(state_directory, days);
        is_frecency_loaded = true;
    }
    frecency.half_life_days = days;
}

/// Give the path picker the heat and last visit of its files (nothing without a state directory).
void App.apply_frecency() {
    if (state_directory.size() == 0 || !picker.is_path) {
        return;
    }
    load_frecency();
    if (frecency.items.size() == 0) {
        return;
    }
    int now = date.now();
    str prefix = "";
    if (picker.kind == MED_picker.KIND_FILES) {
        prefix = absolute_of(root) + "/";
    }
    List<int> heat = [];
    List<int> stamps = [];
    for (MED_picker.Entry entry in picker.entries) {
        str key = prefix + entry.text;
        if (picker.kind != MED_picker.KIND_FILES) {
            key = absolute_of(entry.path);
        }
        heat.push(frecency.heat(key, now));
        stamps.push(frecency.last(key));
    }
    picker.set_frecency(heat, stamps);
}

/// Count a visit of `file` (an absolute path) for the finder and write the state.
void App.note_visit(str file) {
    if (state_directory.size() == 0) {
        return;
    }
    load_frecency();
    int now = date.now();
    frecency.visit(file, now);
    frecency.save(state_directory, now);
}

void App.load_files() {
    List<str> argv = MED_sources.files_command(picker.is_hidden_shown, picker.is_ignore_used, fs.is_present(fs.join(root, ".git")));
    if (argv.size() > 0 && is_plugin_on("finder")) {
        start_source("files", argv);
        return;
    }
    List<MED_picker.Entry> entries = [];
    for (str relative in MED_files.list_files(root, picker.is_hidden_shown, picker.is_ignore_used)) {
        entries.push(MED_picker.Entry(relative, path: MED_files.path_of(root, relative)));
    }
    picker.set_entries(entries);
    apply_frecency();
}

void App.load_marks() {
    List<MED_picker.Entry> entries = [];
    List<str> listed = MED_listing.marks(editor, "");
    for (int index in 1 .. listed.size()) {
        str line = listed[index];
        // " a      3    0 text": the name is the second character
        if (line.size() > 2) {
            str name = line.substr(1, 2);
            str quoted = name;
            if (name == "'") {
                quoted = "'";
            }
            entries.push(MED_picker.Entry(line.substr(1, line.size()), action: "ex:normal! `" + quoted));
        }
    }
    picker.set_entries(entries);
}

void App.load_buffers() {
    save_active();
    List<MED_picker.Entry> entries = [];
    for (Slot slot in slots) {
        str text = slot.id.to_str() + "  " + slot_name(slot);
        if (is_slot_modified(slot)) {
            text = text + " [+]";
        }
        if (slot.id == current_id) {
            text = text + "  (current)";
        }
        entries.push(MED_picker.Entry(text, id: slot.id));
    }
    picker.set_entries(entries);
}

void App.load_commands(bool is_help) {
    List<MED_picker.Entry> entries = [];
    List<str> seen = [];
    List<MED_keymap.Binding> rows = [];
    for (MED_keymap.Binding row in MED_keymap.enabled(MED_keymap.defaults(), disabled_plugins)) {
        if (row.action.size() > 0) {
            rows.push(row);
        }
    }
    for (MED_keymap.Binding row in MED_keymap.commands()) {
        rows.push(row);
    }
    for (MED_keymap.Binding row in rows) {
        if (!is_help && seen.contains(row.label)) {
            continue;
        }
        seen.push(row.label);
        entries.push(MED_picker.Entry(MED_keymap.entry_text(row, is_help), action: row.action));
    }
    if (is_help) {
        for (MED_keymap.Binding row in MED_keymap.enabled(MED_keymap.prefixes(), disabled_plugins)) {
            entries.push(MED_picker.Entry(MED_keymap.entry_text(row, true)));
        }
        for (MED_keymap.Binding row in MED_keymap.enabled(MED_keymap.notes(), disabled_plugins)) {
            entries.push(MED_picker.Entry(MED_keymap.entry_text(row, true)));
        }
    }
    picker.set_entries(entries);
}

void App.load_directory() {
    List<MED_picker.Entry> entries = [];
    entries.push(MED_picker.Entry("../", path: child_path(picker.directory, "..")));
    for (str name in MED_files.list_directory(picker.directory, picker.is_hidden_shown)) {
        str bare = name;
        if (name.ends_with("/")) {
            bare = name.substr(0, name.size() - 1);
        }
        entries.push(MED_picker.Entry(name, path: child_path(picker.directory, bare)));
    }
    picker.title = "Explore " + picker.directory;
    picker.query = "";
    picker.set_entries(entries);
}

/// Read the files grep searches (again after a toggle).
void App.load_corpus() {
    corpus = MED_grep.load(root, MED_files.list_files(root, picker.is_hidden_shown, picker.is_ignore_used));
}

void App.run_grep() {
    is_grep_due = false;
    List<str> argv = [];
    if (picker.query.size() > 0) {
        argv = MED_sources.grep_command(picker.query, picker.is_fixed, picker.is_hidden_shown, picker.is_ignore_used);
    }
    if (argv.size() > 0) {
        picker.set_entries([]);
        start_source("grep", argv);
        return;
    }
    if (MED_shell.which("rg").is_some()) {
        // an empty prompt lists nothing
        stop_source();
        picker.set_entries([]);
        return;
    }
    if (corpus.paths.size() == 0) {
        load_corpus();
    }
    List<MED_picker.Entry> entries = [];
    for (MED_grep.Hit hit in MED_grep.search(corpus, picker.query, picker.is_fixed)) {
        str text = hit.text.trim().split("\t").join(" ");
        entries.push(MED_picker.Entry(hit.path + ":" + (hit.line + 1).to_str() + ": " + text, path: MED_files.path_of(root, hit.path), line: hit.line, column: hit.column));
    }
    picker.set_entries(entries);
}

/// A toggle changed what the picker lists.
void App.reload_picker() {
    if (picker.kind == MED_picker.KIND_FILES) {
        load_files();
    } else if (picker.kind == MED_picker.KIND_GREP) {
        if (MED_shell.which("rg").is_none()) {
            load_corpus();
        }
        run_grep();
    } else if (picker.kind == MED_picker.KIND_EXPLORE) {
        load_directory();
    }
}

/// The lines previewed for the selection, read again only when the file changes.
void App.update_preview() {
    if (is_theme_picker) {
        preview_selected_theme();
    }
    preview = MED_picker_view.Preview();
    match (picker.current()) {
        case Some(MED_picker.Entry entry): {
            if (picker.kind == MED_picker.KIND_BUFFERS) {
                save_active();
                int position = index_of(entry.id);
                if (position >= 0) {
                    Slot slot = slots[position];
                    preview = MED_picker_view.Preview(title: slot_name(slot), lines: preview_ready(slot.editor.buffer.dump().split("\n")), focus: slot.editor.row);
                }
                return;
            }
            if (picker.kind == MED_picker.KIND_LIST && entry.detail.size() > 0) {
                if (preview_path != "commit:" + entry.detail) {
                    preview_lines = preview_ready(MED_shell.lines(["git", "show", "--stat", "--format=fuller", "--no-color", "-n", "1", entry.detail], root).or([]));
                    preview_path = "commit:" + entry.detail;
                }
                preview = MED_picker_view.Preview(title: entry.detail, lines: preview_lines, focus: -1);
                return;
            }
            bool is_file = picker.kind == MED_picker.KIND_FILES || picker.kind == MED_picker.KIND_GREP || picker.kind == MED_picker.KIND_EXPLORE || picker.kind == MED_picker.KIND_LIST;
            if (!is_file || entry.path.size() == 0 || entry.text.ends_with("/")) {
                return;
            }
            // the file is read again when the selection moved or when it changed on disk
            str stamp = MED_persist.disk_stamp(entry.path);
            if (entry.path != preview_path || stamp != preview_stamp) {
                preview_lines = read_preview(entry.path);
                preview_path = entry.path;
                preview_stamp = stamp;
            }
            int focus = -1;
            if (picker.kind == MED_picker.KIND_GREP || picker.kind == MED_picker.KIND_LIST) {
                focus = entry.line;
            }
            preview = MED_picker_view.Preview(title: entry.path, lines: preview_lines, focus: focus);
        }
        case None: {
        }
    }
}

/// Run an action row: `picker:NAME` or `ex:LINE`. True when the editor should quit.
bool App.should_quit_after_action(str action) {
    if (action.starts_with("picker:")) {
        open_picker(action.substr(7, action.size()), "");
        return false;
    }
    if (action.starts_with("keys:")) {
        MED_ex.feed_keys(editor, MED_key.parse(action.substr(5, action.size())));
        return did_finish();
    }
    if (action.starts_with("git:")) {
        run_git_command(action.substr(4, action.size()));
        return did_finish();
    }
    if (action.starts_with("app:")) {
        run_app_action(action.substr(4, action.size()));
        return did_finish();
    }
    if (action.starts_with("ex:")) {
        MED_ex.feed(editor, 58);
        for (int code_point in action.substr(3, action.size()).chars()) {
            MED_ex.feed(editor, code_point);
        }
        MED_ex.feed(editor, MED_key.CARRIAGE_RETURN);
        return did_finish();
    }
    return false;
}

/// Enter in the picker. True when the editor should quit.
bool App.should_quit_after_accept() {
    match (picker.current()) {
        case Some(MED_picker.Entry entry): {
            int kind = picker.kind;
            if (kind == MED_picker.KIND_EXPLORE && entry.text.ends_with("/")) {
                if (entry.text == "../") {
                    picker.directory = up_directory(picker.directory);
                } else {
                    picker.directory = entry.path;
                }
                load_directory();
                update_preview();
                return false;
            }
            has_picker = false;
            end_theme_picker(false);
            if (kind == MED_picker.KIND_FILES || kind == MED_picker.KIND_EXPLORE) {
                edit(entry.path, false);
            } else if (kind == MED_picker.KIND_BUFFERS) {
                go_buffer(entry.id.to_str());
            } else if (kind == MED_picker.KIND_GREP) {
                edit(entry.path, false);
                editor.row = entry.line;
                editor.col = entry.column;
                editor.clamp();
                editor.want_from_cursor();
            } else if (entry.path.size() > 0) {
                jump_to(entry.path, entry.line, entry.column);
            } else if (entry.action.size() > 0) {
                return should_quit_after_action(entry.action);
            }
        }
        case None: {
            has_picker = false;
            end_theme_picker(true);
        }
    }
    return false;
}

/// CTRL-S / CTRL-V in a picker: a file, buffer or grep hit opens in a new
/// window; the other pickers (and directories) take the key as plain Enter.
bool App.should_quit_after_accept_in_split(bool is_vertical) {
    bool is_target = false;
    match (picker.current()) {
        case Some(MED_picker.Entry entry): {
            int kind = picker.kind;
            is_target = kind == MED_picker.KIND_FILES || kind == MED_picker.KIND_BUFFERS || kind == MED_picker.KIND_GREP || (kind == MED_picker.KIND_EXPLORE && !entry.text.ends_with("/")) || (kind == MED_picker.KIND_LIST && entry.path.size() > 0);
        }
        case None: {
        }
    }
    if (is_target) {
        has_picker = false;
        if (!did_split(is_vertical)) {
            return false;
        }
        has_picker = true;
    }
    return should_quit_after_accept();
}

/// One event while a picker is open.
TUI_app.Action App.handle_picker(term.Event event) {
    List<int> keys = [];
    match (event) {
        case Key(term.Key key): {
            keys = keys_of_key(key);
        }
        case Paste(str text): {
            for (int code_point in text.chars()) {
                if (code_point >= 32) {
                    keys.push(code_point);
                }
            }
        }
        case Mouse(term.Mouse mouse): {
        }
        case Unknown(bytes data): {
        }
    }
    for (int key in keys) {
        if (key == 12) {
            // CTRL-L: something else wrote on the screen; write every cell again
            motion.loop.should_repaint = true;
        }
        match (picker.feed(key)) {
            case Stay: {
            }
            case Accept: {
                if (should_quit_after_accept()) {
                    return TUI_app.Action.Quit;
                }
            }
            case Cancel: {
                has_picker = false;
                end_theme_picker(true);
            }
            case Requery: {
                is_grep_due = true;
                idle_ms = 0;
            }
            case Reload: {
                reload_picker();
            }
            case Up: {
                picker.directory = up_directory(picker.directory);
                load_directory();
            }
            case AcceptSplit: {
                if (should_quit_after_accept_in_split(false)) {
                    return TUI_app.Action.Quit;
                }
            }
            case AcceptVsplit: {
                if (should_quit_after_accept_in_split(true)) {
                    return TUI_app.Action.Quit;
                }
            }
            case Quickfix: {
                send_to_quickfix();
            }
        }
        if (!has_picker) {
            break;
        }
    }
    if (has_picker) {
        picker.refresh();
        update_preview();
    }
    return TUI_app.Action.Redraw;
}

void App.cancel_leader() {
    is_leader = false;
    is_which_key = false;
    leader = "";
}

/// The leader tree with the plugins that are off left out, and the user's own
/// maps under <Space> added (their right-hand side is the label).
List<MED_keymap.Binding> App.leader_table() {
    List<MED_keymap.Binding> table = MED_keymap.enabled(MED_keymap.defaults(), disabled_plugins);
    for (MED_map.Mapping one in editor.maps.table(leader_mode)) {
        if (one.lhs.size() > 1 && one.lhs[0] == MED_key.SPACE) {
            bool is_plain = true;
            for (int key in one.lhs) {
                if (key < 32 || key > 126) {
                    is_plain = false;
                }
            }
            if (is_plain) {
                List<int> rest = one.lhs.slice(1, one.lhs.size());
                table.insert(0, MED_keymap.Binding(str.from_chars(rest), one.rhs_text, "usermap", mode: leader_mode));
            }
        }
    }
    return table;
}

/// One key after <Space>. True when the editor should quit.
bool App.should_quit_after_leader(int key) {
    if (key < 32 || key > 126) {
        cancel_leader();
        return false;
    }
    leader = leader + str.from_chars([key]);
    List<MED_keymap.Binding> table = leader_table();
    int found = MED_keymap.lookup(table, leader, mode: leader_mode);
    if (found == MED_keymap.IS_LEAF) {
        MED_keymap.Binding row = MED_keymap.leaf(table, leader, mode: leader_mode);
        str typed = leader;
        cancel_leader();
        if (row.action == "usermap") {
            // the engine resolves its own mapping
            MED_ex.feed(editor, MED_key.SPACE);
            for (int code in typed.chars()) {
                MED_ex.feed(editor, code);
            }
            return did_finish();
        }
        return should_quit_after_action(row.action);
    }
    if (found == MED_keymap.IS_PREFIX) {
        leader_ms = 0;
        return false;
    }
    notice = "No mapping for <Space>" + leader;
    cancel_leader();
    return false;
}

/// A key while label jump is active: the character to look for, then a label.
void App.handle_jump_key(int key) {
    if (key == MED_key.ESC || key < 32) {
        jump_stage = 0;
        return;
    }
    if (jump_stage == 1) {
        int top = editor.view_top;
        int bottom = top + editor.view_height;
        if (bottom > editor.buffer.line_count()) {
            bottom = editor.buffer.line_count();
        }
        bool is_exact = key >= 65 && key <= 90;
        jump_rows = [];
        jump_columns = [];
        // nearest to the cursor first
        List<int> candidates_row = [];
        List<int> candidates_col = [];
        for (int row in top .. bottom) {
            str line = editor.buffer.line(row);
            for (int offset in MED_text.starts(line)) {
                if (offset >= line.size()) {
                    break;
                }
                int code_point = MED_text.cp_at(line, offset);
                bool is_match = code_point == key;
                if (!is_exact && code_point >= 65 && code_point <= 90 && code_point + 32 == key) {
                    is_match = true;
                }
                if (is_match && !(row == editor.row && offset == editor.col)) {
                    candidates_row.push(row);
                    candidates_col.push(offset);
                }
            }
        }
        List<int> taken = [];
        while (jump_rows.size() < JUMP_LABELS.size() && taken.size() < candidates_row.size()) {
            int best = -1;
            int best_distance = 0;
            for (int index in 0 .. candidates_row.size()) {
                if (taken.contains(index)) {
                    continue;
                }
                int distance = (candidates_row[index] - editor.row) * 1000 + (candidates_col[index] - editor.col);
                if (distance < 0) {
                    distance = 0 - distance;
                }
                if (best < 0 || distance < best_distance) {
                    best = index;
                    best_distance = distance;
                }
            }
            taken.push(best);
            jump_rows.push(candidates_row[best]);
            jump_columns.push(candidates_col[best]);
        }
        if (jump_rows.size() == 0) {
            notice = "Jump: no match on screen";
            jump_stage = 0;
            return;
        }
        if (jump_rows.size() == 1) {
            jump_stage = 2;
            handle_jump_key(97);
            return;
        }
        jump_stage = 2;
        return;
    }
    // stage 2: a label
    int which = JUMP_LABELS.index_of(str.from_chars([key])).or(-1);
    jump_stage = 0;
    if (which >= 0 && which < jump_rows.size()) {
        editor.set_pcmark(MED_buffer.Pos(editor.row, editor.col));
        editor.row = jump_rows[which];
        editor.col = jump_columns[which];
        editor.clamp();
        editor.want_from_cursor();
    }
}

/// The pending keys of an unfinished Normal or Visual command as text, with a
/// count in front dropped: `2d` is "d", CTRL-W is its control character.
str App.prefix_typed() {
    if (editor.mode != MED_editor.NORMAL && editor.mode != MED_editor.VISUAL) {
        return "";
    }
    str out = "";
    bool has_count = false;
    if (is_window_key) {
        return str.from_chars([23]);
    }
    for (int key in editor.pending) {
        if (key >= 32 && key < 127) {
            if (out.size() == 0 && key >= 49 && key <= 57) {
                has_count = true;
                continue;
            }
            if (out.size() == 0 && has_count && key == 48) {
                continue;
            }
            out = out + str.from_chars([key]);
        } else if (key == 23) {
            out = out + str.from_chars([23]);
        }
    }
    return out;
}

/// The rows which-key looks the pending prefix `typed` up in.
List<MED_keymap.Binding> App.prefix_table(str typed) {
    List<MED_keymap.Binding> table = MED_keymap.enabled(MED_keymap.prefixes(), disabled_plugins);
    // the user's own maps that continue the typed prefix
    for (MED_map.Mapping one in editor.maps.table("n")) {
        if (one.lhs.size() > typed.size() && typed.size() > 0 && one.lhs[0] != MED_key.SPACE) {
            bool is_plain = true;
            for (int key in one.lhs) {
                if (key < 32 || key > 126) {
                    if (!(key == 23 && one.lhs.size() > 1)) {
                        is_plain = false;
                    }
                }
            }
            if (is_plain) {
                table.insert(0, MED_keymap.Binding(str.from_chars(one.lhs), one.rhs_text, "usermap", is_full: true));
            }
        }
    }
    if (typed.size() > 0) {
        List<str> operators = ["d", "c", "y", "<", ">", "=", "!", "gu", "gU", "g~", "gq", "gw", "g?", "zf"];
        for (str operator in operators) {
            if (typed == operator) {
                for (MED_keymap.Binding row in MED_keymap.motion_rows(operator)) {
                    table.push(row);
                }
            }
        }
    }
    return table;
}

/// The timer: animation frames, then the app's own work (`tick_work`).
pub TUI_app.Action App.tick(int elapsed_ms) {
    motion.is_app_busy = has_picker || is_leader || is_prefix_help || prefix_ms > 0 || editor.ta_keys.size() > 0 || terms.size() > 0 || servers.size() > 0 || is_lsp_wanted() || tree.is_open || is_grep_due || !source.is_done || is_dragging || editor.mode == MED_editor.CMDLINE || editor.pending.size() > 0;
    bool is_frame_due = motion.did_tick(elapsed_ms);
    if (did_autoscroll(elapsed_ms)) {
        is_frame_due = true;
    }
    TUI_app.Action work = tick_work(elapsed_ms);
    if (is_frame_due) {
        return TUI_app.Action.Redraw;
    }
    return work;
}

/// The timer: which-key after a pending leader waits, and the grep debounce.
TUI_app.Action App.tick_work(int elapsed_ms) {
    if (!ext.is_empty() && did_tick_ext(elapsed_ms)) {
        return TUI_app.Action.Redraw;
    }
    if (is_leader && !is_which_key) {
        leader_ms = leader_ms + elapsed_ms;
        if (leader_ms >= MED_keymap.WHICH_KEY_MS) {
            is_which_key = true;
            return TUI_app.Action.Redraw;
        }
    }
    if (!has_picker && !is_leader && editor.is_option_on("whichkey", true) && MED_plugin.is_on(disabled_plugins, "whichkey") && prefix_typed().size() > 0) {
        if (!is_prefix_help) {
            prefix_ms = prefix_ms + elapsed_ms;
            if (prefix_ms >= MED_keymap.WHICH_KEY_MS && MED_keymap.next_items(prefix_table(prefix_typed()), prefix_typed()).size() > 0) {
                is_prefix_help = true;
                return TUI_app.Action.Redraw;
            }
        }
    } else if (is_prefix_help || prefix_ms > 0) {
        is_prefix_help = false;
        prefix_ms = 0;
        return TUI_app.Action.Redraw;
    }
    if (terms.size() > 0 && did_poll_terminals()) {
        return TUI_app.Action.Redraw;
    }
    if ((servers.size() > 0 || is_lsp_wanted()) && did_tick_lsp(elapsed_ms)) {
        return TUI_app.Action.Redraw;
    }
    if (!has_picker && !source.is_done) {
        stop_source();
    }
    if (has_picker && (!source.is_done || picker.is_dirty)) {
        if (did_poll_source(elapsed_ms)) {
            update_preview();
            return TUI_app.Action.Redraw;
        }
    }
    branch_ms = branch_ms + elapsed_ms;
    if (branch_ms >= GIT_REFRESH_MS || branch.size() == 0 && branch_ms >= 500) {
        branch_ms = 0;
        str fresh_branch = MED_git.branch_of(MED_git.directory_of(path));
        if (fresh_branch != branch) {
            branch = fresh_branch;
            return TUI_app.Action.Redraw;
        }
    }
    if (!has_picker && editor.mode == MED_editor.NORMAL) {
        watch_ms = watch_ms + elapsed_ms;
        if (watch_ms >= WATCH_MS) {
            watch_ms = 0;
            str before = notice;
            check_disk();
            if (notice != before) {
                return TUI_app.Action.Redraw;
            }
        }
    }
    if (!has_picker) {
        str before_save = notice;
        autosave_idle(elapsed_ms);
        if (notice != before_save) {
            return TUI_app.Action.Redraw;
        }
    }
    state_ms = state_ms + elapsed_ms;
    if (state_ms >= STATE_MS) {
        state_ms = 0;
        note_state();
    }
    if (editor.ta_keys.size() > 0 && !has_picker) {
        map_ms = map_ms + elapsed_ms;
        if (map_ms >= MAP_TIMEOUT_MS) {
            map_ms = 0;
            MED_ex.flush_maps(editor);
            did_finish();
            return TUI_app.Action.Redraw;
        }
    }
    if (path.size() > 0 && !has_picker) {
        match (git.get(path)) {
            case Some(GitInfo pending): {
                if (pending.is_dirty && editor.mode == MED_editor.NORMAL) {
                    GitInfo fresh = git_info(path, editor, true);
                    return TUI_app.Action.Redraw;
                }
            }
            case None: {
            }
        }
    }
    git_ms = git_ms + elapsed_ms;
    if (git_ms >= GIT_REFRESH_MS) {
        git_ms = 0;
        if (path.size() > 0 && git.get(path).is_some()) {
            GitInfo before = git_info(path, editor, true);
            bool was_tracked = before.has_base;
            before.is_checked = false;
            git.set(path, before);
            GitInfo after = git_info(path, editor, true);
            if (after.has_base != was_tracked || after.hunks.starts.size() != before.hunks.starts.size()) {
                return TUI_app.Action.Redraw;
            }
        }
    }
    if (tree.is_open) {
        if (did_tree_tick(elapsed_ms)) {
            return TUI_app.Action.Redraw;
        }
    }
    if (has_picker && is_grep_due) {
        idle_ms = idle_ms + elapsed_ms;
        if (idle_ms >= GREP_DEBOUNCE_MS) {
            run_grep();
            update_preview();
            return TUI_app.Action.Redraw;
        }
    }
    return TUI_app.Action.Continue;
}

/// One key for the engine, with the front end's own mappings first. True when
/// the editor should quit.
bool App.should_quit_after(int key) {
    if (is_leader) {
        return should_quit_after_leader(key);
    }
    if (is_terminal_input() && !is_window_key && editor.mode == MED_editor.NORMAL) {
        send_terminal_key(key);
        return false;
    }
    if (jump_stage > 0) {
        handle_jump_key(key);
        return false;
    }
    if (terminal_of(current_id) >= 0 && editor.mode == MED_editor.NORMAL && editor.pending.size() == 0 && (key == 105 || key == 97 || key == 73 || key == 65)) {
        // back into the program
        int found = terminal_of(current_id);
        terms[found].is_input = true;
        return false;
    }
    if (tree.is_open && tree.is_focused && !is_window_key && editor.mode == MED_editor.NORMAL && editor.pending.size() == 0 && key != MED_key.SPACE && key != 58 && key != 23) {
        did_tree_key(key);
        return did_finish();
    }
    if (is_window_key) {
        if (key >= 48 && key <= 57 && (window_count > 0 || key != 48)) {
            // CTRL-W 5 _ : a count between CTRL-W and the command
            window_count = window_count * 10 + (key - 48);
            return false;
        }
        is_window_key = false;
        int typed_count = window_count;
        window_count = 0;
        if (key != MED_key.ESC) {
            window_command(key, typed_count);
        }
        return did_finish();
    }
    if (editor.mode == MED_editor.NORMAL && key == 23 && (editor.pending.size() == 0 || is_count_pending())) {
        // 5 CTRL-W _ : the count typed before CTRL-W
        window_count = 0;
        for (int digit in editor.pending) {
            window_count = window_count * 10 + (digit - 48);
        }
        editor.pending = [];
        is_window_key = true;
        return false;
    }
    if (editor.mode == MED_editor.INSERT && (key == MED_key.NUL || key == (MED_key.MOD_CTRL | 32)) && has_server_here()) {
        // CTRL-Space: language server completion
        run_lsp_command("complete", "");
        return did_finish();
    }
    if (editor.mode == MED_editor.INSERT && key == 19 && has_server_here()) {
        // CTRL-S: signature help for the call under the cursor
        run_lsp_command("signature", "");
        return did_finish();
    }
    if (editor.mode == MED_editor.NORMAL && editor.ta_keys.size() == 0 && has_server_here() && is_lsp_key(key)) {
        if (key == 75 && editor.pending.size() == 0) {
            run_lsp_command("hover", "");
            return did_finish();
        }
        if (key == 100 && editor.pending.size() == 1 && editor.pending[0] == 103) {
            editor.pending = [];
            run_lsp_command("definition", "");
            return did_finish();
        }
    }
    if (is_lsp_gr) {
        // `gr` was held back: grr references, grn rename, gra code action
        is_lsp_gr = false;
        if (key == 114) {
            run_lsp_command("references", "");
            return did_finish();
        }
        if (key == 110) {
            run_lsp_command("rename", "");
            return did_finish();
        }
        if (key == 97) {
            run_lsp_command("action", "");
            return did_finish();
        }
        MED_ex.feed(editor, 103);
        MED_ex.feed(editor, 114);
    } else if (editor.mode == MED_editor.NORMAL && editor.ta_keys.size() == 0 && key == 114 && editor.pending.size() == 1 && editor.pending[0] == 103 && has_server_here()) {
        editor.pending = [];
        is_lsp_gr = true;
        return false;
    }
    if (editor.mode == MED_editor.NORMAL && editor.pending.size() == 1 && (editor.pending[0] == 93 || editor.pending[0] == 91) && editor.ta_keys.size() == 0 && (key == 98 || key == 66 || key == 113 || key == 81 || key == 100 || key == 104 || key == 116)) {
        bool is_forward = editor.pending[0] == 93;
        if (did_bracketed(key, is_forward)) {
            editor.pending = [];
            return did_finish();
        }
    }
    if (editor.mode == MED_editor.NORMAL && key == 99 && editor.pending.size() == 1 && (editor.pending[0] == 93 || editor.pending[0] == 91) && editor.ta_keys.size() == 0) {
        // ]c and [c: the next and previous change against HEAD
        bool is_forward = editor.pending[0] == 93;
        editor.pending = [];
        GitInfo state = git_info(path, editor, true);
        int target = -1;
        if (state.has_base) {
            target = MED_git.next_start(state.hunks, editor.row, is_forward);
        }
        if (target >= 0) {
            editor.set_pcmark(MED_buffer.Pos(editor.row, editor.col));
            editor.row = target;
            editor.col = MED_text.first_nonblank(editor.buffer.line(target));
            editor.clamp();
            editor.want_from_cursor();
        } else {
            editor.is_failed = true;
        }
        return did_finish();
    }
    if ((editor.mode == MED_editor.NORMAL || editor.mode == MED_editor.VISUAL) && key == MED_key.SPACE && editor.pending.size() == 0 && editor.ta_keys.size() == 0) {
        is_leader = true;
        is_which_key = false;
        leader = "";
        leader_ms = 0;
        leader_mode = "n";
        if (editor.mode == MED_editor.VISUAL) {
            leader_mode = "x";
        }
        return false;
    }
    int sent = key;
    if (editor.mode == MED_editor.INSERT && key == 107 && last_key == 106 && !editor.maps.has_prefix("i", 106) && editor.is_option_on("jk_escape", true)) {
        // jk: take back the j and leave Insert mode
        MED_ex.feed(editor, MED_key.BACKSPACE);
        sent = MED_key.ESC;
    } else if (editor.mode == MED_editor.CMDLINE && editor.cmd_type == 58 && editor.cmdline.size() == 0 && key == MED_key.CARRIAGE_RETURN) {
        // Enter on an empty `:` opens the palette
        MED_ex.feed(editor, MED_key.ESC);
        open_picker("commands", "");
        last_key = 0;
        return false;
    }
    last_key = sent;
    if (sent == MED_key.ESC) {
        last_key = 0;
    }
    if (editor.mode == MED_editor.NORMAL && editor.pending.size() == 0 && is_in_listing() && !is_pending_g) {
        if (sent == MED_key.CARRIAGE_RETURN) {
            open_listing_entry();
            return did_finish();
        }
        if (sent == 45) {
            go_up_listing();
            return did_finish();
        }
        str entry_name = editor.buffer.line(editor.row);
        if (sent == 82 && entry_name != "../" && entry_name.size() > 0) {
            // netrw R: rename (the command line comes with the old name)
            begin_command("Rename " + entry_name.split("/").join("") + " ");
            return false;
        }
        if (sent == 68 && entry_name != "../" && entry_name.size() > 0) {
            begin_command("Delete " + entry_name);
            return false;
        }
        if (sent == 37) {
            begin_command("Create ");
            return false;
        }
        if (sent == 100) {
            begin_command("Mkdir ");
            return false;
        }
        if (sent == 103) {
            is_pending_g = true;
            return false;
        }
    }
    if (is_pending_g) {
        is_pending_g = false;
        if (sent == 104 && editor.mode == MED_editor.NORMAL && is_in_listing()) {
            is_dotfiles_listed = !is_dotfiles_listed;
            reload_listing(path, "");
            return false;
        }
        MED_ex.feed(editor, 103);
    }
    MED_ex.feed(editor, sent);
    if (is_in_listing()) {
        keep_listing_read_only();
    }
    if (editor.mode == MED_editor.INSERT && (sent == 40 || sent == 44) && is_signature_trigger(sent)) {
        run_lsp_command("signature", "");
    }
    return did_finish();
}

/// Read the system clipboard into the `+` register when the keys may use it.
void App.refresh_clipboard(List<int> keys) {
    if (!clipboard.is_present) {
        return;
    }
    bool is_wanted = false;
    for (int key in keys) {
        if (key == 112 || key == 80 || key == 43 || key == 42 || key == 18 || key == 34 || key == 58) {
            is_wanted = true;
        }
    }
    if (!is_wanted) {
        return;
    }
    match (MED_clip.paste(clipboard)) {
        case Some(str text): {
            editor.regs.set_clipboard(text);
        }
        case None: {
        }
    }
}

/// Hand a changed `+` register to the system clipboard.
void App.flush_clipboard() {
    if (clipboard.is_present && editor.regs.is_clip_dirty) {
        MED_clip.did_copy(clipboard, editor.regs.clip_text());
        editor.regs.did_flush_clipboard();
    }
}

/// Whether `event` is a bracketed paste arriving in Insert or Replace mode.
bool App.is_paste_in_insert(term.Event event) {
    if (editor.mode != MED_editor.INSERT && editor.mode != MED_editor.REPLACE) {
        return false;
    }
    match (event) {
        case Paste(str text): {
            return true;
        }
        case Key(term.Key key): {
        }
        case Mouse(term.Mouse mouse): {
        }
        case Unknown(bytes data): {
        }
    }
    return false;
}

/// Insert pasted keys as plain typed text, as Vim's bracketed paste does.
bool App.did_quit_after_paste(List<int> keys) {
    bool was_autoindent = editor.is_autoindent;
    str was_pairs = editor.opts.get("autopairs").or("");
    MED_map.Maps was_maps = editor.maps;
    editor.is_autoindent = false;
    editor.opts.set("autopairs", "false");
    editor.maps = MED_map.Maps();
    if (editor.mode == MED_editor.INSERT && editor.textwidth == 0 && keys.size() > 64) {
        // a big paste goes in as one piece
        List<int> body = [];
        for (int key in keys) {
            body.push(key);
        }
        MED_vim.paste_plain(editor, paste_text(body));
    } else {
        for (int key in keys) {
            MED_ex.feed(editor, key);
        }
    }
    editor.is_autoindent = was_autoindent;
    editor.maps = was_maps;
    if (was_pairs == "") {
        editor.opts.remove("autopairs");
    } else {
        editor.opts.set("autopairs", was_pairs);
    }
    return did_finish();
}

/// After an event handled outside the key loop: run the requests and redraw.
TUI_app.Action App.finish_event() {
    if (did_finish()) {
        return TUI_app.Action.Quit;
    }
    return TUI_app.Action.Redraw;
}

/// One event: feed its keys to the engine, then the UI requests.
pub TUI_app.Action App.handle(term.Event event) {
    quiet_ms = 0;
    motion.note_input();
    if (has_picker) {
        return handle_picker(event);
    }
    match (event) {
        case Key(term.Key typed): {
            if (typed.has_modifiers(term.ALT) && !is_leader && !is_window_key) {
                int alt_code = char_of(typed.code);
                if (alt_code == 104 || alt_code == 106 || alt_code == 107 || alt_code == 108) {
                    editor.view_height = current_text_rows();
                    notice = "";
                    if (did_alt_move(alt_code)) {
                        return finish_event();
                    }
                }
            }
        }
        case Paste(str pasted): {
        }
        case Mouse(term.Mouse mouse): {
        }
        case Unknown(bytes data): {
        }
    }
    List<int> keys = keys_of(event);
    if (keys.size() == 0) {
        return TUI_app.Action.Continue;
    }
    notice = "";
    if (overlay.size() > 0) {
        // the listing goes away with the next key; Enter, Space and Esc only dismiss it
        overlay = [];
        if (keys.size() == 1 && (keys[0] == MED_key.CARRIAGE_RETURN || keys[0] == 32 || keys[0] == MED_key.ESC)) {
            return TUI_app.Action.Redraw;
        }
    }
    editor.view_height = current_text_rows();
    editor.file_name = path;
    editor.user_commands = ext_commands;
    note_snippet_context();
    editor.tab_count = page_count();
    editor.tab_current = page_index + 1;
    map_ms = 0;
    prefix_ms = 0;
    is_prefix_help = false;
    if (editor.mode != MED_editor.CMDLINE || editor.comp_items.size() == 0) {
        editor.buffer_names = [];
        for (Slot known in slots) {
            if (!known.is_listing && known.path.size() > 0) {
                editor.buffer_names.push(known.path);
            }
        }
        editor.theme_names = [];
        if (editor.mode == MED_editor.CMDLINE && (editor.cmdline.starts_with("theme ") || editor.cmdline.starts_with("colo"))) {
            editor.theme_names = MED_theme.available(theme_directory);
        }
        editor.extra_commands = ["theme", "Files", "Buffers", "Grep", "Commands", "Explore", "Sexplore", "Vexplore", "Neotree", "NeoTree", "Keys", "Plugins", "PluginEnable", "PluginDisable", "terminal", "Lsp", "Recent", "Symbols", "Todo", "Branches", "Commits", "Changed", "Rename", "Delete", "Create", "Mkdir", "Session", "checktime"];
        for (str one in ext_commands) {
            editor.extra_commands.push(one);
        }
    }
    if (is_paste_in_insert(event)) {
        // typed literally: no autoindent, auto-pairs, mappings or jk, and one undo step
        bool is_quitting = did_quit_after_paste(keys);
        flush_clipboard();
        if (is_quitting) {
            return TUI_app.Action.Quit;
        }
        return TUI_app.Action.Redraw;
    }
    refresh_clipboard(keys);
    for (int key in keys) {
        if (has_picker) {
            // a request opened a picker; the rest of the keys are its
            picker.feed(key);
            continue;
        }
        if (should_quit_after(key)) {
            flush_clipboard();
            return TUI_app.Action.Quit;
        }
    }
    flush_clipboard();
    ext_watch();
    if (has_picker) {
        update_preview();
    }
    return TUI_app.Action.Redraw;
}

/// The byte offset in line `row` of the character shown at display column `spot`.
int App.offset_at(int row, int spot) {
    str line = editor.buffer.line(row);
    int shown_to = 0;
    for (int offset in MED_text.starts(line)) {
        if (offset >= line.size()) {
            break;
        }
        shown_to = shown_to + MED_text.cell_width(line, offset, shown_to, editor.tab);
        if (spot < shown_to) {
            return offset;
        }
    }
    return line.size();
}

/// Put the cursor on the text cell under the pointer; false outside the text.
bool App.did_place_cursor(int screen_x, int screen_y) {
    MED_window.Placed here = MED_window.placed_of(layout_in(screen_rect()), current_win);
    int x_cell = screen_x - here.x;
    int y_cell = screen_y - here.y;
    int rows = here.height - 1;
    if (y_cell < 0 || y_cell >= rows || x_cell < 0) {
        return false;
    }
    int row = motion.top_for_mouse(editor.view_top);
    int remaining = y_cell;
    int part = 0;
    int text_width = here.width - gutter_width();
    bool is_wrap = editor.is_option_on("wrap", true);
    bool is_laid = editor.is_wrap_special();
    while (true) {
        int parts = 1;
        if (is_wrap && text_width > 0) {
            parts = MED_text.wrap_breaks(editor.buffer.line(row), text_width, editor.tab).size();
            if (is_laid) {
                parts = editor.wrap_layout(editor.buffer.line(row)).breaks.size();
            }
        }
        int skipped = 0;
        if (row == editor.view_top && is_wrap) {
            skipped = MED_view.top_skip(editor);
        }
        int visible = parts - skipped;
        if (visible < 1) {
            visible = 1;
        }
        if (remaining < visible || row + 1 >= editor.buffer.line_count()) {
            part = remaining + skipped;
            if (part > parts - 1) {
                part = parts - 1;
            }
            break;
        }
        remaining = remaining - visible;
        row = row + 1;
    }
    if (is_laid && is_wrap && text_width > 0) {
        // 'linebreak' / 'showbreak' / 'breakindent': the pointer is over a virtual column of the laid-out line
        int cell = 0;
        if (x_cell > gutter_width()) {
            cell = x_cell - gutter_width();
        }
        editor.row = row;
        editor.col = editor.wrap_layout(editor.buffer.line(row)).col_for_vcol(part * text_width + cell, false);
        editor.clamp();
        editor.want_from_cursor();
        return true;
    }
    int spot = left_column;
    if (is_wrap && text_width > 0) {
        List<int> breaks = MED_text.wrap_breaks(editor.buffer.line(row), text_width, editor.tab);
        spot = MED_text.display_col(editor.buffer.line(row), breaks[part], editor.tab);
    }
    if (x_cell > gutter_width()) {
        spot = spot + x_cell - gutter_width();
    }
    editor.row = row;
    editor.col = offset_at(row, spot);
    editor.clamp();
    editor.want_from_cursor();
    return true;
}

/// A mouse gesture: a press puts the cursor there, a drag selects, the wheel scrolls.
pub TUI_app.Action App.handle_mouse(TUI_mouse.Routed routed) {
    motion.note_input();
    TUI_mouse.Gesture gesture = routed.gesture;
    if (has_picker) {
        return handle_picker_wheel(gesture);
    }
    if (is_leader) {
        cancel_leader();
    }
    if (editor.mode == MED_editor.CMDLINE || editor.mode == MED_editor.REPLACE) {
        return TUI_app.Action.Continue;
    }
    notice = "";
    overlay = [];
    editor.view_height = current_text_rows();
    int side = tree_columns(screen_rect().width);
    if (side > 0) {
        if (gesture.x <= side) {
            return handle_tree_mouse(gesture);
        }
        match (gesture.kind) {
            case Press: {
                tree.is_focused = false;
            }
            case Drag: {
            }
            case ScrollUp: {
            }
            case ScrollDown: {
            }
            case Release: {
            }
            case Click: {
            }
            case Hover: {
            }
            case Leave: {
            }
            case ScrollLeft: {
            }
            case ScrollRight: {
            }
        }
    }
    if (did_scrollbar(gesture)) {
        return TUI_app.Action.Redraw;
    }
    match (gesture.kind) {
        case Press: {
            if (gesture.button == 0 && pages.size() >= 2 && gesture.y == 0) {
                // the tab line: a click on a label makes that page the active one
                int tab_target = MED_window.tab_at(tab_labels(), screen_rect().width, gesture.x);
                if (tab_target >= 0 && tab_target != page_index) {
                    go_page(tab_target);
                }
                return TUI_app.Action.Redraw;
            }
            if (gesture.button == 0) {
                is_dragging = true;
                edge_total_ms = 0;
                edge_wait_ms = 0;
                drag_x = gesture.x;
                drag_y = gesture.y;
                if (editor.mode == MED_editor.VISUAL) {
                    MED_ex.feed(editor, MED_key.ESC);
                }
                int hit = MED_window.window_at(layout_in(screen_rect()), gesture.x, gesture.y);
                if (hit > 0 && hit != current_win) {
                    focus_window(hit);
                }
                if (did_place_cursor(gesture.x, gesture.y)) {
                    return TUI_app.Action.Redraw;
                }
            }
        }
        case Drag: {
            if (gesture.button == 0) {
                drag_x = gesture.x;
                drag_y = gesture.y;
                if (editor.mode == MED_editor.NORMAL) {
                    MED_ex.feed(editor, VKIND_CHAR);
                }
                if (did_place_cursor(gesture.x, gesture.y)) {
                    return TUI_app.Action.Redraw;
                }
            }
        }
        case ScrollUp: {
            for (int step in 0 .. WHEEL_LINES) {
                MED_ex.feed(editor, 25);
            }
            return TUI_app.Action.Redraw;
        }
        case ScrollDown: {
            for (int step in 0 .. WHEEL_LINES) {
                MED_ex.feed(editor, 5);
            }
            return TUI_app.Action.Redraw;
        }
        case Release: {
            is_dragging = false;
            is_bar_drag = false;
        }
        case Click: {
        }
        case Hover: {
        }
        case Leave: {
        }
        case ScrollLeft: {
        }
        case ScrollRight: {
        }
    }
    return TUI_app.Action.Continue;
}

/// A press or drag on a window's scrollbar column (`:set scrollbar`): the line that
/// row of the track stands for becomes the cursor line, centred. True when the
/// gesture was the scrollbar's.
bool App.did_scrollbar(TUI_mouse.Gesture gesture) {
    if (!editor.is_option_on("scrollbar", false)) {
        return false;
    }
    bool is_down = false;
    match (gesture.kind) {
        case Press: {
            is_down = gesture.button == 0;
        }
        case Drag: {
            is_down = gesture.button == 0 && is_bar_drag;
        }
        case Release: {
        }
        case Click: {
        }
        case Hover: {
        }
        case Leave: {
        }
        case ScrollUp: {
        }
        case ScrollDown: {
        }
        case ScrollLeft: {
        }
        case ScrollRight: {
        }
    }
    if (!is_down) {
        return false;
    }
    for (MED_window.Placed one in layout_in(screen_rect()).windows) {
        int rows = one.height - 1;
        bool is_on_bar = gesture.x == one.x + one.width - 1 && gesture.y >= one.y && gesture.y < one.y + rows;
        bool is_held = is_bar_drag && one.win_id == bar_win;
        if (!is_on_bar && !is_held) {
            continue;
        }
        if (!is_bar_drag) {
            is_bar_drag = true;
            bar_win = one.win_id;
        }
        if (one.win_id != current_win) {
            focus_window(one.win_id);
        }
        int y_cell = gesture.y - one.y;
        if (y_cell < 0) {
            y_cell = 0;
        }
        if (y_cell >= rows) {
            y_cell = rows - 1;
        }
        int target = MED_glide.line_at(y_cell, rows, editor.buffer.line_count());
        editor.view_height = current_text_rows();
        MED_ex.feed(editor, MED_key.ESC);
        for (int digit in (target + 1).to_str().chars()) {
            MED_ex.feed(editor, digit);
        }
        MED_ex.feed(editor, 71);
        MED_ex.feed(editor, 122);
        MED_ex.feed(editor, 122);
        return true;
    }
    return false;
}

/// While a drag-selection sits on the top or bottom row of the text, scroll that
/// way, faster the longer it stays (one line per 120 ms at first, down to one per
/// 25 ms and several lines a step). True when it scrolled.
bool App.did_autoscroll(int elapsed_ms) {
    if (!is_dragging || is_bar_drag || editor.mode != MED_editor.VISUAL || has_picker) {
        return false;
    }
    MED_window.Placed here = MED_window.placed_of(layout_in(screen_rect()), current_win);
    int rows = here.height - 1;
    int direction = 0;
    if (drag_y <= here.y && editor.view_top > 0) {
        direction = -1;
    } else if (drag_y >= here.y + rows - 1 && MED_view.bottom(editor) < editor.buffer.line_count()) {
        direction = 1;
    }
    if (direction == 0) {
        edge_total_ms = 0;
        edge_wait_ms = 0;
        return false;
    }
    edge_total_ms = edge_total_ms + elapsed_ms;
    edge_wait_ms = edge_wait_ms + elapsed_ms;
    int interval = 120 - edge_total_ms / 16;
    if (interval < 25) {
        interval = 25;
    }
    motion.loop.animate_ms = 16;
    if (edge_wait_ms < interval) {
        return false;
    }
    edge_wait_ms = 0;
    editor.view_height = current_text_rows();
    int steps = 1 + edge_total_ms / 800;
    for (int step in 0 .. steps) {
        if (direction > 0) {
            MED_ex.feed(editor, 5);
        } else {
            MED_ex.feed(editor, 25);
        }
    }
    int edge_y = here.y;
    if (direction > 0) {
        edge_y = here.y + rows - 1;
    }
    return did_place_cursor(drag_x, edge_y);
}

str App.mode_name() {
    if (is_terminal_input()) {
        return "TERMINAL";
    }
    if (editor.mode == MED_editor.INSERT) {
        return "INSERT";
    }
    if (editor.mode == MED_editor.REPLACE) {
        return "REPLACE";
    }
    if (editor.mode == MED_editor.CMDLINE) {
        return "COMMAND";
    }
    if (editor.mode == MED_editor.VISUAL) {
        if (editor.is_select) {
            return "SELECT";
        }
        if (editor.vkind == VKIND_CHAR) {
            return "VISUAL";
        }
        if (editor.vkind == VKIND_LINE) {
            return "V-LINE";
        }
        return "V-BLOCK";
    }
    return "NORMAL";
}

/// The theme scope suffix of the mode (`ui.statusline.insert`).
str App.mode_scope() {
    str name = mode_name();
    if (name == "INSERT") {
        return "insert";
    }
    if (name == "REPLACE") {
        return "replace";
    }
    if (name == "COMMAND") {
        return "command";
    }
    if (name == "TERMINAL") {
        return "terminal";
    }
    if (name.starts_with("V") || name == "SELECT") {
        return "visual";
    }
    return "normal";
}

/// The cursor's theme mode (`ui.cursor.primary.select` is Visual).
str App.cursor_mode() {
    if (editor.mode == MED_editor.INSERT || editor.mode == MED_editor.REPLACE) {
        return "insert";
    }
    if (editor.mode == MED_editor.VISUAL) {
        return "select";
    }
    return "normal";
}

/// The columns of the line-number gutter, with its trailing space.
int App.gutter_width() {
    return gutter_of(editor);
}

/// Whether the character at (`row`, `col`), shown from display column `spot`,
/// is inside the Visual selection.
bool App.is_selected(int row, int col, int spot) {
    if (editor.mode != MED_editor.VISUAL) {
        return false;
    }
    MED_buffer.Pos anchor = MED_buffer.Pos(editor.vrow, editor.vcol);
    MED_buffer.Pos cursor = editor.cursor();
    MED_buffer.Pos first = anchor;
    MED_buffer.Pos last = cursor;
    if (anchor.cmp(cursor) > 0) {
        first = cursor;
        last = anchor;
    }
    if (row < first.row || row > last.row) {
        return false;
    }
    if (editor.vkind == VKIND_LINE) {
        return true;
    }
    if (editor.vkind == VKIND_CHAR) {
        MED_buffer.Pos here = MED_buffer.Pos(row, col);
        return here.cmp(first) >= 0 && here.cmp(last) <= 0;
    }
    int anchor_spot = MED_text.display_col(editor.buffer.line(editor.vrow), editor.vcol, editor.tab);
    int cursor_spot = MED_text.display_col(editor.buffer.line(editor.row), editor.col, editor.tab);
    int low = anchor_spot;
    int high = cursor_spot;
    if (anchor_spot > cursor_spot) {
        low = cursor_spot;
        high = anchor_spot;
    }
    return spot >= low && spot <= high;
}

/// The git information of `file` for the buffer `subject` shows, brought up to
/// date (HEAD is read once, the diff again when the text changed).
GitInfo App.git_info(str file, MED_editor.Editor subject, bool is_diff_now) {
    GitInfo info = GitInfo();
    if (file.size() == 0 || !subject.is_option_on("gitsigns", true) || fs.is_directory(file)) {
        return info;
    }
    match (git.get(file)) {
        case Some(GitInfo known): {
            info = known;
        }
        case None: {
        }
    }
    if (!info.is_checked) {
        info.is_checked = true;
        match (MED_git.head_lines(file)) {
            case Some(List<str> lines): {
                info.has_base = true;
                info.base = lines;
            }
            case None: {
                info.has_base = false;
            }
        }
        info.tick = -1;
    }
    if (info.has_base) {
        int tick = subject.current * 1000003 + subject.buffer.line_count();
        if (tick != info.tick) {
            if (info.tick < 0 || is_diff_now) {
                info.tick = tick;
                info.is_dirty = false;
                info.hunks = MED_git.diff(info.base, subject.buffer.lines);
            } else {
                // while typing keep the signs, fitted to the number of rows
                info.is_dirty = true;
                int rows = subject.buffer.line_count();
                while (info.hunks.kinds.size() < rows) {
                    info.hunks.kinds.push(MED_git.NONE);
                }
                while (info.hunks.kinds.size() > rows) {
                    info.hunks.kinds.pop();
                }
            }
        }
    }
    git.set(file, info);
    return info;
}

/// The sign of one row: a mark's letter, else the git change.
void App.draw_sign(TUI_buffer.Buffer buffer, MED_editor.Editor shown, GitInfo state, int row, int x, int y) {
    for (int code in 97 .. 123) {
        match (shown.marks.get(str.from_chars([code]))) {
            case Some(MED_buffer.Pos mark): {
                if (mark.row == row) {
                    buffer.set_str(x, y, str.from_chars([code]), theme.over("ui.gutter", "special").with_attrs(TUI_style.BOLD));
                    return;
                }
            }
            case None: {
            }
        }
    }
    if (row < diagnostic_rows.size() && diagnostic_rows[row] > 0) {
        int severity = diagnostic_rows[row];
        if (severity == 1) {
            buffer.set_str(x, y, "E", theme.over("ui.gutter", "error").with_attrs(TUI_style.BOLD));
        } else if (severity == 2) {
            buffer.set_str(x, y, "W", theme.over("ui.gutter", "warning").with_attrs(TUI_style.BOLD));
        } else {
            buffer.set_str(x, y, "I", theme.over("ui.gutter", "info"));
        }
        return;
    }
    if (state.has_base && row < state.hunks.kinds.size()) {
        int kind = state.hunks.kinds[row];
        if (kind == MED_git.ADDED) {
            buffer.set_str(x, y, "+", theme.over("ui.gutter", "diff.plus"));
        } else if (kind == MED_git.CHANGED) {
            buffer.set_str(x, y, "~", theme.over("ui.gutter", "diff.delta"));
        } else if (kind == MED_git.REMOVED) {
            buffer.set_str(x, y, "_", theme.over("ui.gutter", "diff.minus"));
        }
    }
}

/// The matches of the last search pattern in `row`: start and end byte offsets.
List<int> App.search_spans(MED_editor.Editor subject, MED_regex.Regex regex, int row) {
    List<int> spans = [];
    str line = subject.buffer.line(row);
    int from = 0;
    int guard = 0;
    while (from <= line.size() && guard < 500) {
        guard = guard + 1;
        MED_regex.Match found = regex.search_line(subject.buffer, row, from);
        if (!found.is_ok || found.srow != row) {
            break;
        }
        int stop = line.size();
        if (found.erow == row) {
            stop = found.ecol;
        }
        spans.push(found.scol);
        spans.push(stop);
        if (stop > found.scol) {
            from = stop;
        } else if (found.scol < line.size()) {
            from = MED_text.next_col(line, found.scol);
        } else {
            break;
        }
    }
    return spans;
}

void App.draw_line(TUI_buffer.Buffer buffer, MED_editor.Editor subject, int left, bool is_active, int row, int x_start, int y, int text_width, int from, int stop_at, List<int> spans) {
    str line = subject.buffer.line(row);
    List<int> syntax_classes = MED_hl.classes_of(subject, row, syntax_lang);
    TUI_style.Style plain = theme.text_look(MED_theme.PLAIN);
    TUI_style.Style selected = theme.style("ui.selection");
    TUI_style.Style found = theme.look("search.match");
    bool is_list = subject.is_option_on("list", false);
    ListChars list_chars = ListChars();
    if (is_list) {
        list_chars = parse_listchars(subject.opts.get("listchars").or("tab:> ,trail:-,nbsp:+"));
    }
    TUI_style.Style special = theme.look("ui.virtual.whitespace");
    bool is_cursor_line = is_active && row == subject.row && subject.is_option_on("cursorline", false);
    bool is_cursor_column = is_active && subject.is_option_on("cursorcolumn", false);
    str color_columns = subject.opts.get("colorcolumn").or("");
    int cursor_spot = -1;
    if (is_cursor_column) {
        cursor_spot = MED_text.display_col(subject.buffer.line(subject.row), subject.col, subject.tab);
    }
    if (is_cursor_line) {
        plain = theme.text_look(MED_theme.ON_CURSOR_LINE);
        special = special.merged(TUI_style.Style(background: plain.background));
        for (int cell in 0 .. text_width) {
            buffer.set_str(x_start + cell, y, " ", plain);
        }
    }
    // the cursor column and the colour columns, where the line has no text
    if (is_cursor_column || color_columns.size() > 0) {
        for (int cell in 0 .. text_width) {
            int cell_spot = left + cell;
            bool is_column = cell_spot == cursor_spot;
            bool is_colored = is_color_column(subject, color_columns, cell_spot);
            if (is_column || is_colored) {
                int variant = MED_theme.ON_CURSOR_LINE;
                if (is_colored && !is_column) {
                    variant = MED_theme.ON_RULER;
                }
                buffer.set_str(x_start + cell, y, " ", theme.text_look(variant));
            }
        }
    }
    bool is_guides = is_plugin_on("guides") && subject.is_option_on("indentguides", true) && !is_list;
    int guide_step = subject.shiftwidth;
    if (guide_step <= 0) {
        guide_step = subject.tab;
    }
    if (guide_step <= 0) {
        guide_step = 4;
    }
    int todo_from = -1;
    int todo_to = -1;
    if (is_plugin_on("todo") && subject.is_option_on("todohl", true) && line.size() > 3) {
        MED_picker.Entry todo = MED_sources.todo_in(line);
        if (todo.text.size() > 0) {
            todo_from = todo.column;
            todo_to = todo.column + todo.text.size();
        }
    }
    int trail_from = line.size();
    while (trail_from > 0 && (line.byte_at(trail_from - 1) == 32 || line.byte_at(trail_from - 1) == 9)) {
        trail_from = trail_from - 1;
    }
    int lead_to = MED_text.first_nonblank(line);
    int spot = 0;
    if (from > 0) {
        // a wrapped row: `left` is the display column of `from`
        spot = left;
    }
    int offset = from;
    bool is_laid = subject.is_wrap_special();
    MED_wrapmap.Layout laid = MED_wrapmap.Layout();
    int line_end_spot = MED_text.line_width(line, subject.tab);
    if (is_laid) {
        laid = subject.wrap_layout(line);
        line_end_spot = laid.total();
    }
    while (offset < line.size() && offset < stop_at) {
        int width = MED_text.cell_width(line, offset, spot, subject.tab);
        if (is_laid) {
            // virtual columns of the laid-out line: the heads of continuation rows and grown blanks are in them
            spot = laid.vcol_at(offset);
            width = laid.end_vcol_at(offset) - spot + 1;
        }
        int next = MED_text.next_col(line, offset);
        if (spot >= left && spot + width <= left + text_width) {
            int variant = MED_theme.PLAIN;
            if (is_cursor_line) {
                variant = MED_theme.ON_CURSOR_LINE;
            }
            if (spot == cursor_spot) {
                variant = MED_theme.ON_CURSOR_LINE;
            } else if (is_color_column(subject, color_columns, spot)) {
                variant = MED_theme.ON_RULER;
            }
            TUI_style.Style style = theme.text_look(variant);
            if (offset < syntax_classes.size()) {
                style = theme.class_look(syntax_classes[offset], variant);
            }
            if (offset >= todo_from && offset < todo_to && (offset >= syntax_classes.size() || syntax_classes[offset] == SYN_class.COMMENT)) {
                style = theme.look("ui.todo");
            }
            if (is_in_spans(spans, offset)) {
                style = found;
            }
            if (inc_row >= 0 && is_in_preview(row, offset, line.size())) {
                style = theme.look("search.current");
            }
            if (is_active && is_selected(row, offset, spot)) {
                style = style.merged(selected);
            }
            str text = shown(line, offset, next, width);
            int code_point = MED_text.cp_at(line, offset);
            if (is_guides && code_point == 32 && offset < lead_to && spot % guide_step == 0 && !is_selected(row, offset, spot) && !is_in_spans(spans, offset)) {
                text = "\u{2502}";
                style = theme.look("ui.virtual.indent-guide").merged(TUI_style.Style(background: style.background));
            }
            if (is_list) {
                bool is_marked = false;
                if (code_point == 9) {
                    if (list_chars.tab_first.size() > 0) {
                        text = list_chars.tab_first;
                        if (width > 1) {
                            if (list_chars.tab_last.size() > 0) {
                                text = text + list_chars.tab_fill.repeat(width - 2) + list_chars.tab_last;
                            } else {
                                text = text + list_chars.tab_fill.repeat(width - 1);
                            }
                        }
                        is_marked = true;
                    } else {
                        text = "^I" + " ".repeat(width - 2);
                        if (width < 2) {
                            text = "^";
                        }
                    }
                } else if (code_point == 160 && list_chars.nbsp.size() > 0) {
                    text = list_chars.nbsp;
                    is_marked = true;
                } else if (code_point == 32) {
                    if (offset >= trail_from && list_chars.trail.size() > 0) {
                        text = list_chars.trail;
                        is_marked = true;
                    } else if (offset < lead_to && list_chars.lead.size() > 0) {
                        text = list_chars.lead;
                        is_marked = true;
                    } else if (list_chars.space.size() > 0) {
                        text = list_chars.space;
                        is_marked = true;
                    }
                }
                if (is_marked && !is_selected(row, offset, spot) && !is_in_spans(spans, offset)) {
                    style = theme.look("ui.virtual.whitespace").merged(TUI_style.Style(background: style.background));
                }
            }
            buffer.set_str(x_start + spot - left, y, text, style);
        }
        spot = spot + width;
        offset = next;
        if (spot >= left + text_width && !subject.is_option_on("wrap", true)) {
            break;
        }
    }
    if (stop_at < line.size() && subject.is_option_on("wrap", true) && MED_text.cp_at(line, stop_at) >= 128 && spot - left == text_width - 1 && MED_text.cell_width(line, stop_at, spot, subject.tab) == 2) {
        // a double-width character that does not fit in the last cell goes to the next row, a '>' marks the gap
        buffer.set_str(x_start + text_width - 1, y, ">", theme.look("ui.virtual.whitespace"));
    }
    if (is_list && list_chars.eol.size() > 0 && stop_at >= line.size()) {
        int end_spot = line_end_spot;
        if (end_spot >= left && end_spot < left + text_width) {
            buffer.set_str(x_start + end_spot - left, y, list_chars.eol, special);
        }
    }
    if (hints_for.size() > 0 && stop_at >= line.size()) {
        Map<str, str> by_row = hints.get(hints_for).or({});
        str hint_text = by_row.get(row.to_str()).or("");
        if (hint_text.size() > 0) {
            int end_spot = MED_text.line_width(line, subject.tab) + 1;
            int room = left + text_width - end_spot;
            if (end_spot >= left && room > 0) {
                if (hint_text.size() > room) {
                    hint_text = hint_text.substr(0, room);
                }
                buffer.set_str(x_start + end_spot - left, y, hint_text, theme.look("ui.virtual.inlay-hint"));
            }
        }
    }
}

/// The pending keys of an unfinished command (`2d`), as typed.
str App.pending_text() {
    if (is_leader) {
        return "<Space>" + leader;
    }
    if (is_window_key) {
        return "^W";
    }
    str out = "";
    for (int key in editor.pending) {
        if (key >= 32 && key < 127) {
            out = out + str.from_chars([key]);
        } else if (key > 0 && key < 32) {
            out = out + "^" + str.from_chars([key + 64]);
        }
    }
    return out;
}

/// A window's status line at its last row: (the mode of the active one,) name
/// and modified flag on the left; position on the right.
void App.draw_status(TUI_buffer.Buffer buffer, MED_window.Placed frame, MED_editor.Editor subject, str file, bool is_changed, bool is_active) {
    TUI_style.Style bar = theme.look("ui.statusline.inactive");
    TUI_style.Style strong = bar;
    if (is_active) {
        bar = theme.look("ui.statusline");
        strong = theme.over("ui.statusline", "ui.statusline." + mode_scope());
    }
    int y = frame.y + frame.height - 1;
    buffer.fill(TUI_geometry.Rect(frame.x, y, frame.width, 1), " ", bar);
    str name = file;
    if (name.size() == 0) {
        name = "[No Name]";
    }
    if (is_changed) {
        name = name + " [+]";
    }
    int used = 0;
    if (is_active) {
        used = buffer.set_str(frame.x, y, " " + mode_name() + " ", strong);
    }
    buffer.set_str(frame.x + used, y, " " + name, bar, max: frame.width - used);
    int vcol = MED_text.display_col(subject.buffer.line(subject.row), subject.col, subject.tab);
    int count = subject.buffer.line_count();
    int percent = (subject.row + 1) * 100 / count;
    str where = (subject.row + 1).to_str() + ":" + (vcol + 1).to_str() + "  " + percent.to_str() + "% ";
    if (is_plugin_on("statusline")) {
        str lang = SYN_detect.language_of(file, subject.buffer.line(0));
        if (lang.size() > 0) {
            where = lang + "  " + where;
        }
        str middle = "";
        if (is_active && branch.size() > 0) {
            middle = "  " + branch;
            match (git.get(file)) {
                case Some(GitInfo known): {
                    int added = 0;
                    int changed = 0;
                    int removed = 0;
                    for (int kind in known.hunks.kinds) {
                        if (kind == MED_git.ADDED) {
                            added = added + 1;
                        } else if (kind == MED_git.CHANGED) {
                            changed = changed + 1;
                        } else if (kind == MED_git.REMOVED) {
                            removed = removed + 1;
                        }
                    }
                    if (known.has_base && added + changed + removed > 0) {
                        middle = middle + " +" + added.to_str() + " ~" + changed.to_str() + " -" + removed.to_str();
                    }
                }
                case None: {
                }
            }
        }
        if (is_active && diagnostics.size() > 0) {
            List<int> counts = diagnostic_counts();
            if (counts[0] + counts[1] > 0) {
                middle = middle + "  E:" + counts[0].to_str() + " W:" + counts[1].to_str();
            }
        }
        if (is_active && servers.size() > 0) {
            str busy = lsp_status_text();
            if (busy.size() > 0) {
                middle = middle + "  " + busy;
            }
        }
        if (is_active && ext.segment_texts.size() > 0 && ext.segments().size() > 0) {
            middle = middle + "  " + ext.segments();
        }
        int middle_x = frame.x + used + name.size() + 2;
        if (middle.size() > 0 && middle_x + middle.size() + where.size() < frame.x + frame.width) {
            buffer.set_str(middle_x, y, middle, bar);
        }
    }
    int where_x = frame.x + frame.width - where.size();
    if (where_x > frame.x + used + name.size() + 2) {
        buffer.set_str(where_x, y, where, bar);
    }
}

/// The command line (while typing `:` or `/`) or the message.
void App.draw_message(TUI_buffer.Buffer buffer, TUI_geometry.Rect area, int y) {
    TUI_style.Style plain = theme.look("ui.text");
    TUI_style.Style alert = theme.look("error").with_attrs(TUI_style.BOLD);
    if (editor.mode == MED_editor.CMDLINE) {
        buffer.set_str(area.x, y, str.from_chars([editor.cmd_type]) + editor.cmdline, plain, max: area.width);
        return;
    }
    str text = notice;
    if (text.size() == 0) {
        text = editor.message;
    }
    text = first_line(text);
    TUI_style.Style style = plain;
    if (is_error_text(text)) {
        style = alert;
    }
    buffer.set_str(area.x, y, text, style, max: area.width);
    str right = pending_text();
    if (editor.macro_reg.size() > 0) {
        right = "recording @" + editor.macro_reg + " " + right;
    }
    if (right.size() > 0 && text.size() + right.size() + 2 < area.width) {
        buffer.set_str(area.x + area.width - right.size() - 1, y, right, plain);
    }
}

/// The listing over the bottom of the text window, with Vim's prompt.
void App.draw_overlay(TUI_buffer.Buffer buffer, TUI_geometry.Rect area, int rows) {
    TUI_style.Style plain = theme.look("ui.popup");
    TUI_style.Style prompt = theme.over("ui.popup", "ui.prompt");
    List<str> lines = overlay.slice(0, overlay.size());
    int shown_lines = lines.size() + 1;
    if (shown_lines > rows) {
        shown_lines = rows;
    }
    int top = area.y + rows - shown_lines;
    for (int position in 0 .. shown_lines) {
        buffer.fill(TUI_geometry.Rect(area.x, top + position, area.width, 1), " ", plain);
        if (position < shown_lines - 1) {
            buffer.set_str(area.x, top + position, lines[position], plain, max: area.width);
        } else {
            buffer.set_str(area.x, top + position, "Press ENTER or type command to continue", prompt, max: area.width);
        }
    }
}

/// Draw window `frame` (the active one when `is_active`): the line numbers, the
/// text and the status line. Another window shows its own cursor and view, which
/// are lent to the buffer's editor for the drawing.
void App.draw_window(TUI_buffer.Buffer buffer, MED_window.Placed frame, bool is_active) {
    int rows = frame.height - 1;
    if (rows < 1) {
        rows = 1;
    }
    MED_editor.Editor subject = editor;
    str file = path;
    if (is_in_listing() || terminal_of(current_id) >= 0) {
        file = slot_name(slots[index_of(current_id)]);
    }
    bool is_changed = is_modified();
    int left = left_column;
    MED_window.Win win = wins[win_index(frame.win_id)];
    int kept_row = subject.row;
    int kept_col = subject.col;
    int kept_top = subject.view_top;
    int kept_height = subject.view_height;
    int kept_left = subject.view_left;
    if (!is_active) {
        Slot slot = slots[index_of(win.buffer_id)];
        subject = slot.editor;
        file = slot.path;
        if (slot.is_listing) {
            file = slot_name(slot);
        }
        is_changed = is_slot_modified(slot);
        left = win.left_column;
        kept_left = subject.view_left;
        subject.view_left = win.left_column;
        kept_row = subject.row;
        kept_col = subject.col;
        kept_top = subject.view_top;
        kept_height = subject.view_height;
        subject.row = win.row;
        subject.col = win.col;
        subject.view_top = win.view_top;
        subject.clamp();
    }
    subject.view_height = rows;
    syntax_lang = MED_hl.language(subject);
    hints_for = "";
    if (is_hints_on && hints.size() > 0 && file.size() > 0) {
        hints_for = absolute_of(file);
    }
    GitInfo git_state = git_info(file, subject, false);
    subject.sign_columns = 0;
    diagnostic_rows = diagnostic_rows_of(file, subject.buffer.line_count());
    if (git_state.has_base || has_marks(subject) || diagnostic_rows.size() > 0 || (servers.size() > 0 && file.size() > 0 && subject.is_option_on("lsp", true))) {
        // (a running language server reserves the column before its first diagnostic)
        subject.sign_columns = 1;
    }
    // the gutter only grows: a diagnostic clearing does not shift the text back
    if (subject.sign_columns > 0) {
        subject.is_sign_floor = true;
    } else if (subject.is_sign_floor) {
        subject.sign_columns = 1;
    }
    int gutter = gutter_of(subject);
    int text_width = frame.width - gutter;
    if (text_width < 1) {
        text_width = 1;
    }
    subject.view_width = text_width;
    subject.view_gutter = gutter;
    // 'incsearch': while a / or ? is typed the window shows the first match
    int preview_row = -1;
    int preview_col = 0;
    int preview_end_row = 0;
    int preview_end_col = 0;
    str preview_pattern = "";
    int saved_row = subject.row;
    int saved_col = subject.col;
    int saved_top = subject.view_top;
    if (is_active && editor.mode == MED_editor.CMDLINE && (editor.cmd_type == 47 || editor.cmd_type == 63) && subject.is_option_on("incsearch", true) && editor.cmdline.size() > 0) {
        int stop = MED_search.skip_regexp(editor.cmdline, editor.cmd_type);
        preview_pattern = editor.cmdline.substr(0, stop);
        if (preview_pattern.size() > 0) {
            MED_regex.Regex typed_regex = MED_search.compile_with(subject, preview_pattern, false);
            if (typed_regex.is_ok) {
                int direction = 1;
                if (editor.cmd_type == 63) {
                    direction = -1;
                }
                MED_search.Hit hit = MED_search.searchit(subject, typed_regex, subject.row, subject.col, direction, 1, false, false, false);
                if (hit.is_ok) {
                    preview_row = hit.srow;
                    preview_col = hit.scol;
                    preview_end_row = hit.erow;
                    preview_end_col = hit.ecol;
                    subject.row = hit.srow;
                    subject.col = hit.scol;
                }
            }
        }
    }
    MED_view.update(subject);
    // motion: while a scroll runs, draw from a top line part-way to the engine's
    int motion_top = subject.view_top;
    int motion_row = subject.row;
    int motion_col = subject.col;
    bool is_motion = is_active && motion.did_shift(subject, current_win * 100003 + current_id, rows);
    bool is_wrap = subject.is_option_on("wrap", true);
    int cursor_spot = MED_text.display_col(subject.buffer.line(subject.row), subject.col, subject.tab);
    if (is_wrap && subject.is_wrap_special()) {
        cursor_spot = subject.wrap_layout(subject.buffer.line(subject.row)).vcol_at(subject.col);
    }
    left = subject.view_left;
    TUI_style.Style dim = theme.look("ui.linenr");
    TUI_style.Style filler = theme.look("ui.virtual.whitespace");
    TUI_style.Style current = theme.over("ui.linenr", "ui.linenr.selected");
    TUI_style.Style gutter_style = theme.look("ui.gutter");
    MED_regex.Regex regex = MED_regex.compile("", false, false, "");
    bool is_highlight = false;
    if (preview_pattern.size() > 0) {
        regex = MED_search.compile_with(subject, preview_pattern, false);
        is_highlight = regex.is_ok;
    } else if (subject.is_option_on("hlsearch", true) && !subject.is_no_hl) {
        str pattern = MED_search.last_pattern(subject);
        if (pattern.size() > 0) {
            regex = MED_search.compile_with(subject, pattern, subject.is_search_no_scs);
            is_highlight = regex.is_ok;
        }
    }
    inc_row = preview_row;
    inc_col = preview_col;
    inc_end_row = preview_end_row;
    inc_end_col = preview_end_col;
    int screen_row = 0;
    int row = subject.view_top;
    int cursor_screen_row = 0;
    int cursor_screen_x = 0;
    while (screen_row < rows) {
        int y = frame.y + screen_row;
        if (row >= subject.buffer.line_count()) {
            buffer.set_str(frame.x, y, "~", filler);
            screen_row = screen_row + 1;
            continue;
        }
        int closed_end = subject.fold_end_of(row);
        if (closed_end >= 0) {
            // a closed fold is one row: its text, then dots
            int closed_start = subject.fold_start_of(row);
            if (subject.row >= closed_start && subject.row <= closed_end) {
                cursor_screen_row = screen_row;
                cursor_screen_x = 0;
            }
            TUI_style.Style folded = theme.look("ui.text.inactive");
            if (subject.is_option_on("number", false) || subject.is_option_on("relativenumber", false)) {
                buffer.set_str(frame.x + subject.sign_columns, y, number_text(subject, closed_start, gutter), dim);
            }
            str text = MED_fold.text_of(subject, closed_start, closed_end);
            int used = 0;
            for (int offset in MED_text.starts(text)) {
                if (offset >= text.size()) {
                    break;
                }
                int next_offset = MED_text.next_col(text, offset);
                int cells = MED_text.cell_width(text, offset, used, subject.tab);
                if (used + cells > text_width) {
                    break;
                }
                buffer.set_str(frame.x + gutter + used, y, text.substr(offset, next_offset), folded);
                used = used + cells;
            }
            while (used < text_width) {
                buffer.set_str(frame.x + gutter + used, y, str.from_chars([183]), folded);
                used = used + 1;
            }
            screen_row = screen_row + 1;
            row = closed_end + 1;
            continue;
        }
        str line = subject.buffer.line(row);
        List<int> breaks = [0];
        if (is_wrap) {
            breaks = MED_text.wrap_breaks(line, text_width, subject.tab);
        }
        List<int> spans = [];
        if (is_highlight) {
            spans = search_spans(subject, regex, row);
        }
        int total = breaks.size();
        List<int> break_spots = [0];
        int line_cells = 0;
        bool is_laid = is_wrap && subject.is_wrap_special();
        MED_wrapmap.Layout laid = MED_wrapmap.Layout();
        if (is_laid) {
            // 'linebreak' / 'showbreak' / 'breakindent': rows start at multiples of the width in virtual columns
            laid = subject.wrap_layout(line);
            breaks = laid.breaks;
            total = breaks.size();
            line_cells = laid.total();
            break_spots = [];
            for (int part in 0 .. total) {
                break_spots.push(part * text_width);
            }
        } else if (is_wrap) {
            List<int> wanted = breaks.slice(0, breaks.size());
            wanted.push(line.size());
            List<int> found_spots = MED_text.spots_of(line, wanted, subject.tab);
            line_cells = found_spots[found_spots.size() - 1];
            break_spots = found_spots.slice(0, found_spots.size() - 1);
        }
        if (is_wrap && subject.row == row && subject.col >= line.size() && subject.mode != MED_editor.NORMAL && subject.mode != MED_editor.VISUAL) {
            // the cursor after the last character may need a row of its own
            if (line_cells - break_spots[total - 1] >= text_width) {
                total = total + 1;
            }
        }
        int first_part = 0;
        if (is_wrap && row == subject.view_top) {
            first_part = MED_view.top_skip(subject);
            if (first_part > total - 1) {
                first_part = total - 1;
            }
        }
        int visible = total - first_part;
        if (row == subject.row) {
            int cursor_part = 0;
            for (int part in 0 .. breaks.size()) {
                if (breaks[part] <= subject.col) {
                    cursor_part = part;
                }
            }
            int base = left;
            if (is_wrap) {
                base = break_spots[cursor_part];
                if (total > breaks.size() && subject.col >= line.size()) {
                    cursor_part = breaks.size();
                    base = line_cells;
                }
            }
            cursor_screen_row = screen_row + cursor_part - first_part;
            cursor_screen_x = cursor_spot - base;
        }
        for (int part in first_part .. total) {
            int shown_part = part - first_part;
            if (screen_row + shown_part >= rows) {
                break;
            }
            int part_y = y + shown_part;
            if (subject.sign_columns > 0) {
                buffer.set_str(frame.x, part_y, " ", gutter_style);
            }
            if (part == 0) {
                buffer.set_str(frame.x + subject.sign_columns, part_y, number_text(subject, row, gutter), dim);
                if (row == subject.row) {
                    buffer.set_str(frame.x + subject.sign_columns, part_y, number_text(subject, row, gutter), current);
                }
                if (subject.sign_columns > 0) {
                    draw_sign(buffer, subject, git_state, row, frame.x, part_y);
                }
            }
            int from = 0;
            int stop_at = line.size();
            int base = left;
            if (is_wrap) {
                if (part < breaks.size()) {
                    from = breaks[part];
                    base = break_spots[part];
                }
                if (part + 1 < breaks.size()) {
                    stop_at = breaks[part + 1];
                }
                if (part >= breaks.size()) {
                    from = line.size();
                    base = line_cells;
                }
            }
            if (is_laid && part > 0 && part < breaks.size() && laid.head > 0) {
                // the head of a continuation row: the 'breakindent' blanks, then the 'showbreak' string
                str mark = subject.wrap_settings().showbreak;
                int mark_at = laid.head - MED_text.line_width(mark, subject.tab);
                if (mark_at < 0) {
                    mark_at = 0;
                }
                buffer.set_str(frame.x + gutter + mark_at, part_y, mark, filler);
            }
            draw_line(buffer, subject, base, is_active, row, frame.x + gutter, part_y, text_width, from, stop_at, spans);
            if (shown_part == 0 && first_part > 0) {
                buffer.set_str(frame.x + gutter, part_y, "<<<", filler);
            }
        }
        if (screen_row > 0 && screen_row + visible > rows && is_wrap) {
            // a last line that does not fit: what fits, then "@@@" (display=lastline)
            buffer.set_str(frame.x + gutter, frame.y + rows - 1, "@@@", filler);
        }
        screen_row = screen_row + visible;
        row = row + 1;
    }
    inc_row = -1;
    if (subject.is_option_on("scrollbar", false)) {
        motion.draw_scrollbar(buffer, subject, frame.x + frame.width - 1, frame.y, rows);
    }
    if (is_active) {
        motion.place(frame.x + gutter, frame.y, text_width, rows, motion_top, left);
    }
    if (is_motion) {
        subject.view_top = motion_top;
        subject.row = motion_row;
        subject.col = motion_col;
    }
    if (preview_row >= 0) {
        // the preview was only a look: the cursor and the view stay put
        subject.row = saved_row;
        subject.col = saved_col;
        subject.view_top = saved_top;
    }
    draw_status(buffer, frame, subject, file, is_changed, is_active);
    if (is_active) {
        left_column = left;
        cursor_x = frame.x + gutter + cursor_screen_x;
        cursor_y = frame.y + cursor_screen_row;
    } else {
        win.row = subject.row;
        win.col = subject.col;
        win.view_top = subject.view_top;
        win.left_column = subject.view_left;
        subject.view_left = kept_left;
        subject.row = kept_row;
        subject.col = kept_col;
        subject.view_top = kept_top;
        subject.view_height = kept_height;
    }
}

/// The matches of a Tab completion in the row above the command line (Vim's
/// 'wildmenu'), the chosen one reversed.
void App.draw_wildmenu(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    int y = area.y + area.height - 2;
    if (y < area.y) {
        return;
    }
    TUI_style.Style bar = theme.look("ui.menu");
    TUI_style.Style chosen = theme.look("ui.menu.selected");
    for (int x in 0 .. area.width) {
        buffer.set_str(area.x + x, y, " ", bar);
    }
    // start at the first item that lets the chosen one fit
    int first = 0;
    int used = 0;
    int shown_index = editor.comp_index;
    if (shown_index < 0) {
        shown_index = 0;
    }
    for (int index in 0 .. editor.comp_items.size()) {
        used = used + MED_text.line_width(editor.comp_items[index], 4) + 2;
        if (index == shown_index) {
            break;
        }
    }
    while (used > area.width - 2 && first < shown_index) {
        used = used - MED_text.line_width(editor.comp_items[first], 4) - 2;
        first = first + 1;
    }
    int menu_x = 0;
    for (int index in first .. editor.comp_items.size()) {
        str item = editor.comp_items[index];
        int width = MED_text.line_width(item, 4);
        if (menu_x + width > area.width) {
            break;
        }
        TUI_style.Style look = bar;
        if (index == editor.comp_index) {
            look = chosen;
        }
        buffer.set_str(area.x + menu_x, y, item, look);
        menu_x = menu_x + width + 2;
    }
}

/// Draw the whole screen.
pub void App.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect full) {
    follow_background();
    if (!MED_theme.is_empty(theme.base)) {
        buffer.fill(full, " ", theme.base);
    }
    save_active();
    int top = tabline_rows();
    TUI_geometry.Rect area = full;
    if (top > 0) {
        draw_tabline(buffer, full);
        area = TUI_geometry.Rect(full.x, full.y + top, full.width, full.height - top);
    }
    MED_window.Layout placed = layout_in(area);
    for (MED_window.Placed one in placed.windows) {
        draw_window(buffer, one, one.win_id == current_win);
    }
    motion.use_theme(theme, editor.opts.get("background").or("dark") != "light");
    motion.finish(buffer, editor);
    if (tree.is_open && tree_columns(area.width) > 0) {
        draw_tree(buffer, area);
    }
    TUI_style.Style dim = theme.look("ui.window");
    for (MED_window.Placed bar in placed.separators) {
        for (int offset in 0 .. bar.height) {
            buffer.set_str(bar.x, bar.y + offset, "|", dim);
        }
    }
    int rows = area.height - FOOTER_ROWS;
    if (rows < 1) {
        rows = 1;
    }
    if (editor.mode == MED_editor.CMDLINE && editor.comp_items.size() > 1) {
        draw_wildmenu(buffer, area);
    }
    if (overlay.size() > 0) {
        draw_overlay(buffer, area, rows);
    }
    int popup_kind = 0;
    if ((is_leader && is_which_key) || jump_stage == 2 || (is_prefix_help && !is_leader)) {
        popup_kind = 1;
    }
    if (has_picker) {
        popup_kind = 2;
    }
    motion.before_popup(buffer, popup_kind, editor);
    if (is_leader && is_which_key) {
        TUI_menu.WhichKey menu = TUI_menu.WhichKey("<Space>" + leader, MED_keymap.next_items(leader_table(), leader, mode: leader_mode), style: theme.look("ui.which-key"), title_style: theme.over("ui.which-key", "ui.which-key.title"));
        menu.render(buffer, TUI_geometry.Rect(area.x, area.y, area.width, rows));
    } else if (jump_stage == 2) {
        List<TUI_menu.Item> items = [];
        for (int index in 0 .. jump_rows.size()) {
            str line_text = editor.buffer.line(jump_rows[index]).trim();
            items.push(TUI_menu.Item(jump_label(index), (jump_rows[index] + 1).to_str() + ":" + (jump_columns[index] + 1).to_str() + "  " + line_text));
        }
        TUI_menu.WhichKey menu = TUI_menu.WhichKey("jump", items, style: theme.look("ui.which-key"), title_style: theme.over("ui.which-key", "ui.which-key.title"));
        menu.render(buffer, TUI_geometry.Rect(area.x, area.y, area.width, rows));
    } else if (is_prefix_help && !is_leader) {
        str typed = prefix_typed();
        List<TUI_menu.Item> items = MED_keymap.next_items(prefix_table(typed), typed);
        if (items.size() > 0) {
            TUI_menu.WhichKey menu = TUI_menu.WhichKey(MED_keymap.shown_keys(typed), items, style: theme.look("ui.which-key"), title_style: theme.over("ui.which-key", "ui.which-key.title"));
            menu.render(buffer, TUI_geometry.Rect(area.x, area.y, area.width, rows));
        }
    }
    if (!has_picker) {
        preview.is_pane = false;
    }
    if (has_picker) {
        picker.is_score_shown = editor.is_option_on("finderscore", true);
        picker.scroll_to(MED_picker_view.list_rows(area));
        if (preview.focus >= 0) {
            preview.first = preview.focus - MED_picker_view.list_rows(area) / 3;
            if (preview.first < 0) {
                preview.first = 0;
            }
        }
        MED_picker_view.render(buffer, area, picker, preview, theme);
    }
    motion.after_popup(buffer, editor);
    int message_y = area.y + area.height - 1;
    draw_message(buffer, area, message_y);
    TUI_style.Style cursor_style = motion.cursor_style(theme.cursor(cursor_mode()));
    motion.hide_cursor();
    if (overlay.size() > 0 || has_picker || is_leader) {
        return;
    }
    if (editor.mode == MED_editor.CMDLINE) {
        int command_x = area.x + 1 + MED_text.line_width(editor.cmdline.substr(0, editor.cmd_position), editor.tab);
        if (command_x < area.x + area.width) {
            if (editor.is_option_on("cursorshape", true)) {
                motion.show_cursor(command_x, message_y, 6);
            } else {
                buffer.set_style(command_x, message_y, cursor_style);
            }
        }
    } else if (!(tree.is_open && tree.is_focused)) {
        int shape = motion.shape_for(editor);
        if (shape > 0) {
            motion.show_cursor(cursor_x, cursor_y, shape);
        } else {
            buffer.set_style(cursor_x, cursor_y, cursor_style);
        }
    }
}

/// The mouse wheel moves the picker's selection; nothing else is handled.
TUI_app.Action App.handle_picker_wheel(TUI_mouse.Gesture gesture) {
    match (gesture.kind) {
        case ScrollUp: {
            picker.feed(MED_key.UP_KEY);
        }
        case ScrollDown: {
            picker.feed(MED_key.DOWN);
        }
        case Press: {
            return TUI_app.Action.Continue;
        }
        case Drag: {
            return TUI_app.Action.Continue;
        }
        case Release: {
            return TUI_app.Action.Continue;
        }
        case Click: {
            return TUI_app.Action.Continue;
        }
        case Hover: {
            return TUI_app.Action.Continue;
        }
        case Leave: {
            return TUI_app.Action.Continue;
        }
        case ScrollLeft: {
            return TUI_app.Action.Continue;
        }
        case ScrollRight: {
            return TUI_app.Action.Continue;
        }
    }
    update_preview();
    return TUI_app.Action.Redraw;
}

/// Run ex lines from `text` (a keymap file or `:source`): blank lines and `"`
/// comments are skipped, a leading `:` is dropped. The first failure stops the
/// run; the result is its message, or "" when every line ran.
pub str App.run_script(str text, str label) {
    int number = 0;
    for (str raw in text.split("\n")) {
        number = number + 1;
        str line = raw.trim();
        if (line.size() == 0 || line.starts_with("\"")) {
            continue;
        }
        while (line.starts_with(":")) {
            line = line.substr(1, line.size()).trim();
        }
        if (line.size() == 0) {
            continue;
        }
        if (!MED_ex.did_run_line(editor, line)) {
            return label + " line " + number.to_str() + ": " + editor.message;
        }
    }
    return "";
}

/// `:source FILE`: run the file's ex lines.
void App.source_file(str name) {
    if (name.size() == 0) {
        notice = "E471: Argument required";
        return;
    }
    str file = expand_home(name);
    if (!fs.is_present(file) || fs.is_directory(file)) {
        notice = "E484: Can't open file " + name;
        return;
    }
    match (io.read(file)) {
        case Ok(str content): {
            str failure = run_script(content, name);
            editor.message = "";
            notice = failure;
        }
        case Err(io.Error error): {
            notice = "E484: Can't open file " + name;
        }
    }
}

/// Load the keymap file into the active buffer's editor (the maps follow to
/// the others). A missing file is not an error unless it was asked for by name.
pub void App.load_keymap(str file, bool is_required) {
    if (file.size() == 0) {
        return;
    }
    if (!fs.is_present(file)) {
        if (is_required) {
            notice = "E484: Can't open file " + file;
        }
        return;
    }
    match (io.read(file)) {
        case Ok(str content): {
            str failure = run_script(content, file);
            editor.message = "";
            notice = failure;
            // the file's :theme / :colorscheme lines take effect before the first frame
            // (their "theme: NAME" is not news at startup; an error is)
            run_requests();
            if (notice.starts_with("theme: ")) {
                notice = failure;
            }
        }
        case Err(io.Error error): {
            notice = "E484: Can't open file " + file;
        }
    }
}

/// Whether (row, offset) is inside the match 'incsearch' shows.
bool App.is_in_preview(int row, int offset, int size) {
    if (row < inc_row || row > inc_end_row) {
        return false;
    }
    if (row == inc_row && offset < inc_col) {
        return false;
    }
    if (row == inc_end_row && offset >= inc_end_col) {
        return false;
    }
    return true;
}

/// Stop the child that fills the picker.
void App.stop_source() {
    source.stop();
    source_kind = "";
    picker.is_loading = false;
}

/// Start `argv` (in the project root) as the source of the open picker.
void App.start_source(str kind, List<str> argv) {
    source.stop();
    picker.set_entries([]);
    source = MED_shell.start(argv, root);
    source_kind = kind;
    source_ms = 0;
    picker.is_loading = !source.is_done;
}

/// Take what the running source has delivered. True when the list changed.
bool App.did_poll_source(int elapsed_ms) {
    bool is_changed = false;
    source_ms = source_ms + elapsed_ms;
    if (!source.is_done) {
        List<str> got = source.poll(20000);
        List<MED_picker.Entry> batch = [];
        for (str line in got) {
            if (line.size() == 0) {
                continue;
            }
            if (source_kind == "files") {
                str relative = line;
                if (relative.starts_with("./")) {
                    relative = relative.substr(2, relative.size());
                }
                batch.push(MED_picker.Entry(relative, path: MED_files.path_of(root, relative)));
            } else {
                MED_picker.Entry parsed = MED_sources.parse_grep_line(line);
                if (parsed.path.size() > 0) {
                    batch.push(MED_picker.Entry(parsed.text, path: MED_files.path_of(root, parsed.path), line: parsed.line, column: parsed.column));
                }
            }
        }
        if (batch.size() > 0) {
            picker.append(batch);
            is_changed = true;
        }
        if (source.is_done) {
            picker.is_loading = false;
            is_changed = true;
            if (source_kind == "files") {
                apply_frecency();
            }
        }
    }
    if (picker.is_dirty && (source.is_done || source_ms >= 150)) {
        picker.refilter();
        source_ms = 0;
        is_changed = true;
    }
    return is_changed;
}

/// Open buffer `file` at a 0-based line and byte column.
void App.jump_to(str file, int line, int column) {
    edit(file, false);
    editor.row = line;
    editor.col = column;
    editor.clamp();
    editor.want_from_cursor();
}

/// The absolute form of the project root.
str App.absolute_root() {
    match (fs.realpath(root)) {
        case Ok(str real): {
            return real;
        }
        case Err(io.Error error): {
            return root;
        }
    }
}

/// The path to open for an absolute `file` (relative to the project root when
/// it is below it, so the buffer is the one a picker would open).
str App.openable(str file) {
    str base = absolute_root();
    if (file.starts_with(base + "/")) {
        return MED_files.path_of(root, file.substr(base.size() + 1, file.size()));
    }
    return file;
}

str App.absolute_of(str file) {
    if (file.size() == 0 || file.starts_with("/")) {
        return file;
    }
    match (fs.realpath(file)) {
        case Ok(str real): {
            return real;
        }
        case Err(io.Error error): {
            return "";
        }
    }
}

/// The word under the cursor ("" when there is none).
str App.word_under_cursor() {
    str line = editor.buffer.line(editor.row);
    int from = editor.col;
    if (from >= line.size()) {
        return "";
    }
    while (from > 0 && is_word_byte(line.byte_at(from - 1))) {
        from = from - 1;
    }
    int stop = editor.col;
    while (stop < line.size() && is_word_byte(line.byte_at(stop))) {
        stop = stop + 1;
    }
    return line.substr(from, stop);
}

/// Open a picker that lists entries given by the front end (`KIND_LIST`).
/// False when the name is not one of them (or the picker is opened elsewhere).
bool App.did_open_list_picker(str name, str arg) {
    List<MED_picker.Entry> entries = [];
    str title = "";
    root = MED_files.project_root();
    str lang = server_language_of(path, editor.buffer.line(0));
    if (name == "recent") {
        title = "Recent";
        entries = recent_entries();
    } else if (name == "lines") {
        title = "Lines";
        entries = MED_sources.line_entries(editor.buffer.lines, path);
    } else if (name == "quickfix") {
        title = "Quickfix";
        for (MED_picker.Entry one in quickfix_list) {
            entries.push(one);
        }
    } else if (name == "symbols") {
        title = "Symbols";
        entries = MED_sources.symbol_entries(editor.buffer.lines, path, lang);
    } else if (name == "todos") {
        title = "TODO";
        List<str> argv = MED_sources.grep_command("\\b(TODO|FIXME|HACK|XXX|NOTE|WARN|PERF|BUG)\\b", false, false, true);
        picker = MED_picker.make(MED_picker.KIND_LIST, title);
        if (argv.size() > 0) {
            start_source("grep", argv);
            return true;
        }
        entries = MED_sources.todo_entries(editor.buffer.lines, path);
    } else if (name == "word") {
        str word = word_under_cursor();
        if (word.size() == 0) {
            notice = "No word under the cursor";
            return false;
        }
        open_picker("grep", word);
        return false;
    } else if (name == "options") {
        title = "Options";
        for (str option in MED_option.names()) {
            MED_option.Spec spec = MED_option.find(option);
            str value = MED_ex.option_text(editor, spec);
            str action = "ex:set " + option + "?";
            if (spec.kind == "bool") {
                action = "ex:set " + option + "!";
            }
            entries.push(MED_picker.Entry(option + " = " + value, action: action));
        }
    } else if (name == "themes") {
        title = "Themes";
        for (str known in MED_theme.available(theme_directory)) {
            str shown_name = known;
            if (known == theme.name) {
                shown_name = known + "  (current)";
            }
            entries.push(MED_picker.Entry(shown_name, action: "ex:theme " + known));
        }
        is_theme_picker = true;
        theme_before = theme.name;
    } else if (name == "plugins") {
        title = "Plugins (Enter toggles)";
        for (MED_plugin.Plugin one in MED_plugin.all()) {
            str state = "on ";
            str action = "ex:PluginDisable " + one.name;
            if (disabled_plugins.contains(one.name)) {
                state = "off";
                action = "ex:PluginEnable " + one.name;
            }
            entries.push(MED_picker.Entry(state + "  " + one.name + "  " + one.summary, action: action));
        }
    } else if (name == "harpoon") {
        title = "Harpoon";
        load_harpoon();
        for (int index in 0 .. harpoon.size()) {
            entries.push(MED_picker.Entry((index + 1).to_str() + "  " + harpoon_label(harpoon[index]), path: openable(harpoon[index])));
        }
    } else if (name == "branches" || name == "remotes") {
        title = "Branches";
        bool is_remote = name == "remotes";
        List<str> argv = ["git", "branch", "--format=%(HEAD)%(refname:short)"];
        if (is_remote) {
            title = "Remote branches";
            argv = ["git", "branch", "-r", "--format= %(refname:short)"];
        }
        match (MED_shell.lines(argv, root)) {
            case Some(List<str> lines): {
                entries = MED_sources.parse_branches(lines, is_remote);
            }
            case None: {
                notice = "Not a git repository (or git is not installed)";
                return false;
            }
        }
    } else if (name == "commits") {
        title = "Commits";
        match (MED_shell.lines(["git", "log", "--pretty=format:%h%x09%s%x09%an%x09%ar", "-n", "500"], root)) {
            case Some(List<str> lines): {
                entries = MED_sources.parse_commits(lines);
            }
            case None: {
                notice = "Not a git repository (or git is not installed)";
                return false;
            }
        }
    } else if (name == "changed") {
        title = "Changed files";
        str top = MED_shell.output(["git", "rev-parse", "--show-toplevel"], root).or("").trim();
        match (MED_shell.output(["git", "status", "--porcelain=v1", "-z", "--untracked-files=all"], root)) {
            case Some(str text): {
                str relative_top = top;
                if (top.size() == 0) {
                    notice = "Not a git repository (or git is not installed)";
                    return false;
                }
                entries = MED_sources.parse_status(text, relative_top);
            }
            case None: {
                notice = "Not a git repository (or git is not installed)";
                return false;
            }
        }
        // the entries hold absolute paths; open them as the project would
        List<MED_picker.Entry> mapped = [];
        for (MED_picker.Entry one in entries) {
            mapped.push(MED_picker.Entry(one.text, path: openable(one.path)));
        }
        entries = mapped;
    } else if (name == "diagnostics" || name == "buffer_diagnostics") {
        title = "Diagnostics";
        entries = diagnostic_entries(name == "buffer_diagnostics");
        if (entries.size() == 0) {
            notice = "No diagnostics";
            return false;
        }
    } else {
        notice = "Not supported yet: " + name;
        return false;
    }
    picker = MED_picker.make(MED_picker.KIND_LIST, title);
    picker.is_path = name == "recent";
    picker.set_entries(entries);
    picker.is_deferred = true;
    apply_frecency();
    if (is_theme_picker) {
        picker.is_side = true;
        for (int rank in 0 .. picker.shown.size()) {
            if (picker.entries[picker.shown[rank]].action == "ex:theme " + theme.name) {
                picker.selected = rank;
            }
        }
    }
    return true;
}

/// CTRL-Q in a picker: the marked (or all) entries with a position become the
/// quickfix list, and the list opens.
void App.send_to_quickfix() {
    List<MED_picker.Entry> kept = [];
    for (MED_picker.Entry one in picker.chosen()) {
        if (one.path.size() > 0) {
            kept.push(one);
        }
    }
    if (kept.size() == 0) {
        notice = "Nothing with a position to send to the quickfix list";
        return;
    }
    quickfix_list = kept;
    quickfix_index = -1;
    stop_source();
    open_picker("quickfix", "");
    notice = quickfix_list.size().to_str() + " entries in the quickfix list";
}

/// `]q` `[q` `:cnext` `:cprevious` `:cfirst` `:clast` (`how`: 1 next, -1
/// previous, 0 first, 2 last).
void App.go_quickfix(int how) {
    if (quickfix_list.size() == 0) {
        notice = "E42: No Errors";
        return;
    }
    if (how == 1) {
        quickfix_index = quickfix_index + 1;
        if (quickfix_index >= quickfix_list.size()) {
            quickfix_index = 0;
        }
    } else if (how == -1) {
        quickfix_index = quickfix_index - 1;
        if (quickfix_index < 0) {
            quickfix_index = quickfix_list.size() - 1;
        }
    } else if (how == 0) {
        quickfix_index = 0;
    } else {
        quickfix_index = quickfix_list.size() - 1;
    }
    MED_picker.Entry one = quickfix_list[quickfix_index];
    jump_to(one.path, one.line, one.column);
    notice = "(" + (quickfix_index + 1).to_str() + " of " + quickfix_list.size().to_str() + ") " + one.text;
}

/// Recent files below the project root, newest first.
List<MED_picker.Entry> App.recent_entries() {
    List<MED_picker.Entry> out = [];
    if (recent.size() == 0) {
        recent = MED_state.read_lines(state_directory, "recent");
    }
    str base = absolute_root();
    for (str file in recent) {
        if (!file.starts_with(base + "/") || !fs.is_file(file)) {
            continue;
        }
        str relative = file.substr(base.size() + 1, file.size());
        out.push(MED_picker.Entry(relative, path: MED_files.path_of(root, relative)));
    }
    return out;
}

/// Bring the recent list and the cursor positions up to date (every STATE_MS).
pub void App.note_state() {
    if (state_directory.size() == 0 || !is_plugin_on("session") || path.size() == 0 || is_in_listing()) {
        return;
    }
    str file = absolute_of(path);
    if (file.size() == 0 || !fs.is_file(file)) {
        return;
    }
    if (file != noted_path) {
        noted_path = file;
        if (recent.size() == 0) {
            recent = MED_state.read_lines(state_directory, "recent");
        }
        recent = MED_state.mru_add(recent, file, 200);
        MED_state.write_lines(state_directory, "recent", recent);
        note_visit(file);
        noted_row = -1;
    }
    if (editor.row != noted_row) {
        noted_row = editor.row;
        remember_position();
    }
}

/// Load the saved undo history of the active buffer ('undofile'), when its text is the one it was saved for.
pub void App.restore_undo() {
    if (state_directory.size() == 0 || path.size() == 0 || is_in_listing() || !editor.is_option_on("undofile", false)) {
        return;
    }
    if (MED_persist.did_restore_undo(state_directory, absolute_of(path), editor)) {
        saved_current = editor.current;
    }
}

/// Write the undo history of `slot` after its file was written ('undofile').
void App.save_undo(Slot slot) {
    if (state_directory.size() == 0 || slot.path.size() == 0 || slot.is_listing || !slot.editor.is_option_on("undofile", false)) {
        return;
    }
    MED_persist.save_undo(state_directory, absolute_of(slot.path), slot.editor);
}

/// Write down where the cursor of the active buffer is.
pub void App.remember_position() {
    if (state_directory.size() == 0 || !is_plugin_on("session") || path.size() == 0 || is_in_listing()) {
        return;
    }
    str file = absolute_of(path);
    if (file.size() == 0 || !fs.is_file(file)) {
        return;
    }
    if (positions.size() == 0) {
        positions = MED_state.read_lines(state_directory, "positions");
    }
    positions = MED_state.position_set(positions, file, editor.row, editor.col);
    MED_state.write_lines(state_directory, "positions", positions);
}

/// Put the cursor where the file was left (the first file of the session, or
/// one that was just opened with `:e`).
pub void App.restore_position() {
    if (state_directory.size() == 0 || !is_plugin_on("session") || path.size() == 0 || is_in_listing()) {
        return;
    }
    str file = absolute_of(path);
    if (file.size() == 0) {
        return;
    }
    if (positions.size() == 0) {
        positions = MED_state.read_lines(state_directory, "positions");
    }
    List<int> spot = MED_state.position_of(positions, file);
    if (spot[0] >= 0 && spot[0] < editor.buffer.line_count()) {
        editor.row = spot[0];
        editor.col = spot[1];
        editor.clamp();
        editor.want_from_cursor();
    }
}

str App.harpoon_file() {
    return "harpoon-" + MED_state.project_key(absolute_root());
}

void App.load_harpoon() {
    harpoon = MED_state.read_lines(state_directory, harpoon_file());
}

str App.harpoon_label(str file) {
    str base = absolute_root();
    if (file.starts_with(base + "/")) {
        return file.substr(base.size() + 1, file.size());
    }
    return file;
}

/// A harpoon action: add, remove, next, prev, or `harpoon N`.
void App.run_harpoon(str action, str arg) {
    if (state_directory.size() == 0) {
        notice = "Harpoon needs a state directory (HOME is not set)";
        return;
    }
    load_harpoon();
    str file = absolute_of(path);
    if (action == "harpoon_add") {
        if (file.size() == 0 || !fs.is_file(file)) {
            notice = "Harpoon: this buffer has no file";
            return;
        }
        if (harpoon.contains(file)) {
            notice = "Harpoon: already pinned (" + (harpoon.index_of(file).or(0) + 1).to_str() + ")";
            return;
        }
        harpoon.push(file);
        MED_state.write_lines(state_directory, harpoon_file(), harpoon);
        notice = "Harpoon: pinned as " + harpoon.size().to_str();
        return;
    }
    if (action == "harpoon_remove") {
        List<str> kept = [];
        for (str one in harpoon) {
            if (one != file) {
                kept.push(one);
            }
        }
        harpoon = kept;
        MED_state.write_lines(state_directory, harpoon_file(), harpoon);
        notice = "Harpoon: removed";
        return;
    }
    if (harpoon.size() == 0) {
        notice = "Harpoon: nothing pinned (<Space>ha)";
        return;
    }
    int target = 0;
    if (action == "harpoon_next" || action == "harpoon_prev") {
        int here = harpoon.index_of(file).or(-1);
        if (here < 0) {
            here = harpoon_index;
        }
        if (action == "harpoon_next") {
            target = here + 1;
        } else {
            target = here - 1;
        }
        if (target >= harpoon.size()) {
            target = 0;
        }
        if (target < 0) {
            target = harpoon.size() - 1;
        }
    } else {
        target = arg.parse_int().or(1) - 1;
        if (target < 0 || target >= harpoon.size()) {
            notice = "Harpoon: no file " + arg;
            return;
        }
    }
    harpoon_index = target;
    edit(openable(harpoon[target]), false);
    notice = "Harpoon " + (target + 1).to_str() + "/" + harpoon.size().to_str() + ": " + harpoon_label(harpoon[target]);
}

/// The directory of the current file for git commands.
str App.file_directory() {
    return MED_git.directory_of(path);
}

/// Replace `count` rows from `first` with `lines` as one undoable change.
void App.replace_rows(int first, int count, List<str> lines) {
    int total = editor.buffer.line_count();
    str text = lines.join("\n");
    editor.open_block();
    if (count > 0 && lines.size() > 0) {
        int last = first + count - 1;
        editor.change(MED_buffer.Pos(first, 0), MED_buffer.Pos(last, editor.buffer.line(last).size()), text);
    } else if (count == 0) {
        if (first >= total) {
            int end_row = total - 1;
            editor.change(MED_buffer.Pos(end_row, editor.buffer.line(end_row).size()), MED_buffer.Pos(end_row, editor.buffer.line(end_row).size()), "\n" + text);
        } else {
            editor.change(MED_buffer.Pos(first, 0), MED_buffer.Pos(first, 0), text + "\n");
        }
    } else {
        // delete the rows
        int last = first + count - 1;
        if (last + 1 < total) {
            editor.change(MED_buffer.Pos(first, 0), MED_buffer.Pos(last + 1, 0), "");
        } else if (first > 0) {
            editor.change(MED_buffer.Pos(first - 1, editor.buffer.line(first - 1).size()), MED_buffer.Pos(last, editor.buffer.line(last).size()), "");
        } else {
            editor.change(MED_buffer.Pos(0, 0), MED_buffer.Pos(last, editor.buffer.line(last).size()), "");
        }
    }
    editor.end_block();
}

/// `<Space>gs` `gr` `gp` `gB` and friends.
void App.run_git_action(str action) {
    if (path.size() == 0 || is_in_listing()) {
        notice = "No file";
        return;
    }
    if (action == "signs") {
        bool is_on = editor.is_option_on("gitsigns", true);
        editor.opts.set("gitsigns", bool_text(!is_on));
        return;
    }
    GitInfo info = git_info(path, editor, true);
    if (action == "blame") {
        str name = MED_git.name_of(path);
        int line = editor.row + 1;
        match (MED_shell.output(["git", "-C", file_directory(), "blame", "-L", line.to_str() + "," + line.to_str(), "--date=relative", "--", name], "")) {
            case Some(str text): {
                notice = text.trim();
            }
            case None: {
                notice = "Not committed yet";
            }
        }
        return;
    }
    if (!info.has_base) {
        notice = "This file is not tracked by git";
        return;
    }
    int index = MED_git.hunk_at(info.hunks, editor.row);
    if (index < 0) {
        notice = "No hunk at the cursor";
        return;
    }
    if (action == "hunk_preview") {
        overlay = MED_git.hunk_preview(info.hunks, index, info.base, editor.buffer.lines);
        return;
    }
    if (action == "hunk_reset") {
        List<str> old = [];
        for (int offset in 0 .. info.hunks.base_counts[index]) {
            old.push(info.base[info.hunks.base_froms[index] + offset]);
        }
        replace_rows(info.hunks.froms[index], info.hunks.counts[index], old);
        notice = "Hunk reset";
        return;
    }
    if (action == "hunk_stage") {
        str directory = file_directory();
        str prefix = MED_shell.output(["git", "-C", directory, "rev-parse", "--show-prefix"], "").or("").trim();
        str relative = prefix + MED_git.name_of(path);
        str patch = MED_git.hunk_patch(info.hunks, index, info.base, editor.buffer.lines, relative);
        MED_shell.Ran ran = MED_shell.run(["git", "-C", directory, "apply", "--cached", "--unidiff-zero", "-"], directory, patch);
        if (ran.code == 0) {
            info.is_checked = false;
            git.set(path, info);
            notice = "Hunk staged";
        } else {
            notice = "Stage failed: " + first_line(ran.errors);
        }
        return;
    }
}

/// `git:checkout BRANCH`, `git:checkout_remote REMOTE/BRANCH`, `git:show HASH`.
void App.run_git_command(str spec) {
    int space = spec.index_of(" ").or(spec.size());
    str action = spec.substr(0, space);
    str arg = spec.substr(space + 1, spec.size()).trim();
    root = MED_files.project_root();
    if (action == "checkout") {
        MED_shell.Ran ran = MED_shell.run(["git", "checkout", arg], root, "");
        if (ran.code == 0) {
            notice = "Switched to " + arg + " (use :e! to reload changed files)";
        } else {
            notice = first_line(ran.errors);
        }
    } else if (action == "checkout_remote") {
        MED_shell.Ran ran = MED_shell.run(["git", "checkout", "--track", arg], root, "");
        if (ran.code == 0) {
            notice = "Checked out " + arg;
        } else {
            notice = first_line(ran.errors);
        }
    } else if (action == "show") {
        match (MED_shell.lines(["git", "show", "--no-color", "--stat", "--patch", arg], root)) {
            case Some(List<str> lines): {
                open_scratch("git-" + arg, lines);
            }
            case None: {
                notice = "git show failed";
            }
        }
    }
}

/// A new unnamed buffer holding `lines`, shown as unmodified.
void App.open_scratch(str title, List<str> lines) {
    new_buffer();
    editor.buffer.lines = lines;
    editor.buffer.dirty_row = 0;
    if (editor.buffer.lines.size() == 0) {
        editor.buffer.lines = [""];
    }
    editor.row = 0;
    editor.col = 0;
    editor.init_marks();
    saved_current = editor.current;
    editor.message = title;
    notice = title;
}

/// `[b ]b [B ]B [q ]q [Q ]Q [t ]t [h ]h [d ]d` (the second key `key`). False
/// when it is not one of them.
bool App.did_bracketed(int key, bool is_forward) {
    if (!is_plugin_on("bracketed")) {
        return false;
    }
    int step = -1;
    if (is_forward) {
        step = 1;
    }
    if (key == 98) {
        go_relative(step, false);
        return true;
    }
    if (key == 66) {
        go_relative(step, true);
        return true;
    }
    if (key == 113) {
        go_quickfix(step);
        return true;
    }
    if (key == 81) {
        if (is_forward) {
            go_quickfix(2);
        } else {
            go_quickfix(0);
        }
        return true;
    }
    if (key == 100) {
        go_diagnostic(is_forward);
        return true;
    }
    if (key == 104) {
        GitInfo state = git_info(path, editor, true);
        int target = -1;
        if (state.has_base) {
            target = MED_git.next_start(state.hunks, editor.row, is_forward);
        }
        if (target >= 0) {
            editor.set_pcmark(MED_buffer.Pos(editor.row, editor.col));
            editor.row = target;
            editor.col = MED_text.first_nonblank(editor.buffer.line(target));
            editor.clamp();
            editor.want_from_cursor();
        } else {
            editor.is_failed = true;
        }
        return true;
    }
    if (key == 116) {
        int total = editor.buffer.line_count();
        int row = editor.row;
        for (int steps in 0 .. total) {
            row = row + step;
            if (row >= total) {
                row = 0;
            }
            if (row < 0) {
                row = total - 1;
            }
            if (MED_sources.todo_in(editor.buffer.line(row)).text.size() > 0) {
                editor.set_pcmark(MED_buffer.Pos(editor.row, editor.col));
                editor.row = row;
                editor.col = MED_sources.todo_in(editor.buffer.line(row)).column;
                editor.clamp();
                editor.want_from_cursor();
                return true;
            }
        }
        notice = "No TODO comments";
        return true;
    }
    return false;
}

/// Alt-j / Alt-k / Alt-h / Alt-l: move or shift the line or the selection
/// (the `move` plugin). True when the key was one of them.
bool App.did_alt_move(int code_point) {
    if (!is_plugin_on("move") || editor.pending.size() > 0 || editor.ta_keys.size() > 0) {
        return false;
    }
    bool is_visual = editor.mode == MED_editor.VISUAL;
    if (editor.mode != MED_editor.NORMAL && !is_visual) {
        return false;
    }
    str keys = "";
    if (code_point == 106) {
        keys = ":m +1\r";
        if (is_visual) {
            keys = ":m '>+1\rgv";
        }
    } else if (code_point == 107) {
        keys = ":m -2\r";
        if (is_visual) {
            keys = ":m '<-2\rgv";
        }
    } else if (code_point == 104) {
        keys = "<<";
        if (is_visual) {
            keys = "<gv";
        }
    } else if (code_point == 108) {
        keys = ">>";
        if (is_visual) {
            keys = ">gv";
        }
    } else {
        return false;
    }
    for (int code in keys.chars()) {
        MED_ex.feed(editor, code);
    }
    return true;
}

/// Where the terminal of buffer `id` is in `terms`, or -1.
int App.terminal_of(int id) {
    for (int position in 0 .. terms.size()) {
        if (terms[position].buffer_id == id) {
            return position;
        }
    }
    return -1;
}

/// Whether the active buffer is a terminal that takes the keys.
bool App.is_terminal_input() {
    int found = terminal_of(current_id);
    return found >= 0 && terms[found].is_input && terms[found].is_alive;
}

/// `:terminal [command]`: a shell (or `sh -c command`) on a pty in a new buffer.
void App.start_terminal(str command) {
    if (!is_plugin_on("terminal")) {
        notice = "The terminal plugin is off (:PluginEnable terminal)";
        return;
    }
    List<str> argv = [os.env("SHELL").or("sh")];
    str title = argv[0];
    if (command.size() > 0) {
        argv = ["sh", "-c", command];
        title = command;
    }
    TUI_geometry.Rect area = screen_rect();
    int rows = current_text_rows();
    int columns = area.width;
    if (columns < 20) {
        columns = 80;
    }
    match (proc.start_pty(argv, rows: rows, columns: columns)) {
        case Ok(proc.Pty pty): {
            new_buffer();
            Slot slot = slots[index_of(current_id)];
            slot.title = "term://" + title;
            Term fresh = Term(current_id);
            fresh.ptys.push(pty);
            terms.push(fresh);
            editor.buffer.lines = [""];
            editor.buffer.dirty_row = 0;
            editor.row = 0;
            editor.col = 0;
            saved_current = editor.current;
            notice = "";
        }
        case Err(proc.Error error): {
            notice = "terminal: " + error.to_str();
        }
    }
}

/// A typed key in a terminal pane: CTRL-\ CTRL-N leaves to Normal mode, every
/// other key goes to the program.
void App.send_terminal_key(int key) {
    int found = terminal_of(current_id);
    if (found < 0) {
        return;
    }
    if (terms[found].is_leaving) {
        terms[found].is_leaving = false;
        if (key == 14) {
            terms[found].is_input = false;
            return;
        }
        write_terminal(found, [28]);
    } else if (key == 28) {
        terms[found].is_leaving = true;
        return;
    }
    write_terminal(found, terminal_bytes(key));
}

void App.write_terminal(int found, bytes data) {
    if (data.size() == 0 || terms[found].ptys.size() == 0) {
        return;
    }
    Result<int, io.Error> written = terms[found].ptys[0].master.write(data);
}

/// Read what the terminals printed. True when a screen changed.
bool App.did_poll_terminals() {
    bool is_changed = false;
    for (int position in 0 .. terms.size()) {
        Term term_state = terms[position];
        if (!term_state.is_alive || term_state.ptys.size() == 0) {
            continue;
        }
        int rounds = 0;
        bool is_read = false;
        while (rounds < 8) {
            rounds = rounds + 1;
            term_state.ptys[0].master.set_deadline_ns(timer.monotonic_ns() + 20000);
            match (term_state.ptys[0].master.read(65536)) {
                case Ok(bytes data): {
                    if (data.size() == 0) {
                        term_state.is_alive = false;
                        break;
                    }
                    term_state.pending.extend(data);
                    is_read = true;
                }
                case Err(io.Error error): {
                    break;
                }
            }
        }
        if (is_read) {
            str text = decode_terminal(term_state.pending);
            int used = text.to_bytes().size();
            if (used > 0) {
                term_state.pending.drop_front(used);
                term_state.screen.feed(text);
            } else if (term_state.pending.size() > 8) {
                term_state.pending = [];
            }
            is_changed = true;
        }
        if (!term_state.is_alive) {
            int code = 0;
            match (term_state.ptys[0].wait()) {
                case Ok(os.ExitStatus status): {
                    if (!status.is_success()) {
                        code = 1;
                    }
                }
                case Err(proc.Error error): {
                    code = 1;
                }
            }
            term_state.screen.feed("\r\n[Process exited " + code.to_str() + "]");
            term_state.is_input = false;
            is_changed = true;
        }
        if (is_changed) {
            show_terminal(position);
        }
    }
    return is_changed;
}

/// Copy a terminal's screen into its buffer and put the cursor on its cursor.
void App.show_terminal(int position) {
    Term term_state = terms[position];
    int slot_position = index_of(term_state.buffer_id);
    if (slot_position < 0) {
        return;
    }
    Slot slot = slots[slot_position];
    List<str> lines = term_state.screen.lines.slice(0, term_state.screen.lines.size());
    slot.editor.buffer.lines = lines;
    slot.editor.buffer.dirty_row = 0;
    slot.editor.buffer.tick = slot.editor.buffer.tick + 1;
    int row = term_state.screen.row;
    if (row >= lines.size()) {
        row = lines.size() - 1;
    }
    List<int> cells = lines[row].chars();
    int column = term_state.screen.col;
    if (column > cells.size()) {
        column = cells.size();
    }
    slot.editor.row = row;
    slot.editor.col = str.from_chars(cells.slice(0, column)).size();
    if (slot.editor.col >= lines[row].size() && lines[row].size() > 0) {
        slot.editor.col = lines[row].size();
    }
}

/// The command to run for `lang` (empty when none is configured or installed).
List<str> App.server_command(str lang) {
    str custom = server_commands.get(lang).or("");
    if (custom.size() > 0) {
        List<str> argv = [];
        for (str word in custom.split(" ")) {
            if (word.size() > 0) {
                argv.push(word);
            }
        }
        if (argv.size() > 0 && MED_shell.which(argv[0]).is_some()) {
            return argv;
        }
        return [];
    }
    for (List<str> candidate in default_servers(lang)) {
        if (MED_shell.which(candidate[0]).is_some()) {
            return candidate;
        }
        // not on PATH: Neovim's mason keeps its servers in one directory
        str home = os.env("HOME").or("");
        if (home.size() > 0) {
            str mason = home + "/.local/share/nvim/mason/bin/" + candidate[0];
            if (fs.is_file(mason)) {
                List<str> resolved = [mason];
                for (int index in 1 .. candidate.size()) {
                    resolved.push(candidate[index]);
                }
                return resolved;
            }
        }
    }
    return [];
}

/// The language of the active buffer ("" for a scratch buffer or a directory).
str App.language_here() {
    if (path.size() == 0 || is_in_listing() || terminal_of(current_id) >= 0) {
        return "";
    }
    return server_language_of(path, editor.buffer.line(0));
}

/// The language the language server of the active buffer serves: the
/// highlighter's, else one the LSP layer knows by extension (lua).
str App.lsp_language_here() {
    str lang = language_here();
    if (lang.size() > 0) {
        return lang;
    }
    if (path.size() == 0 || is_in_listing() || terminal_of(current_id) >= 0) {
        return "";
    }
    return MED_lsp.language_of_extension(path);
}

/// "LSP: ..." for the status line while the server of this buffer reports
/// progress ("" when idle or there is none).
str App.lsp_status_text() {
    int found = server_for(lsp_language_here());
    if (found < 0 || servers[found].is_dead) {
        return "";
    }
    if (!servers[found].is_ready) {
        return "LSP: starting";
    }
    str busy = servers[found].progress;
    if (busy.size() == 0) {
        return "";
    }
    if (busy.size() > 28) {
        busy = busy.substr(0, 28);
    }
    return "LSP: " + busy;
}

/// Where the server of `lang` is in `servers`, or -1.
int App.server_for(str lang) {
    for (int position in 0 .. servers.size()) {
        if (server_languages[position] == lang) {
            return position;
        }
    }
    return -1;
}

/// A server is running and ready for the active buffer.
bool App.has_server_here() {
    if (servers.size() == 0 || !is_plugin_on("lsp")) {
        return false;
    }
    int found = server_for(lsp_language_here());
    return found >= 0 && !servers[found].is_dead;
}

/// A server could be started for the active buffer (checked on the tick).
bool App.is_lsp_wanted() {
    if (!is_plugin_on("lsp") || !editor.is_option_on("lsp", true)) {
        return false;
    }
    str lang = lsp_language_here();
    if (lang.size() == 0 || server_for(lang) >= 0 || lsp_failed_for == lang) {
        return false;
    }
    if (server_command(lang).size() == 0) {
        // not configured or not installed: do not look again every tick
        lsp_failed_for = lang;
        return false;
    }
    return true;
}

/// Start the server for the active buffer's language.
void App.start_server(str lang) {
    List<str> argv = server_command(lang);
    if (argv.size() == 0) {
        lsp_failed_for = lang;
        return;
    }
    str base = absolute_root();
    MED_lsp.Server fresh = MED_lsp.start(argv[0], argv, base);
    if (fresh.is_dead) {
        lsp_failed_for = lang;
        notice = "LSP: could not start " + argv[0];
        return;
    }
    int dead = server_for(lang);
    if (dead >= 0) {
        // a stopped server of this language is replaced, not listed twice
        servers[dead].stop();
        servers[dead] = fresh;
        return;
    }
    servers.push(fresh);
    server_languages.push(lang);
}

/// The path key of buffer slot `slot` (absolute), "" when it has no file.
str App.slot_key(Slot slot) {
    if (slot.path.size() == 0 || slot.is_listing || slot.title.size() > 0) {
        return "";
    }
    return absolute_of(slot.path);
}

/// The slot with absolute path `file`, or -1.
int App.slot_with_path(str file) {
    for (int position in 0 .. slots.size()) {
        if (slot_key(slots[position]) == file) {
            return position;
        }
    }
    return -1;
}

str App.text_of_slot(Slot slot) {
    return slot.editor.buffer.lines.join("\n") + "\n";
}

/// One tick of language server work: start, poll, sync. True when the screen
/// changed.
bool App.did_tick_lsp(int elapsed_ms) {
    bool is_changed = false;
    str lang_here = lsp_language_here();
    if (lang_here.size() > 0 && server_for(lang_here) < 0 && is_lsp_wanted()) {
        start_server(lang_here);
    }
    lsp_quiet_ms = lsp_quiet_ms + elapsed_ms;
    for (int position in 0 .. servers.size()) {
        MED_lsp.Server server = servers[position];
        if (server.is_dead) {
            continue;
        }
        for (MED_lsp.Message message in server.poll()) {
            if (did_handle_server_message(position, message)) {
                is_changed = true;
            }
        }
        if (!server.is_ready || lsp_quiet_ms < 250) {
            continue;
        }
        if (is_hints_on && server_languages[position] == lang_here && server.can_do("inlayHintProvider") && path.size() > 0) {
            int hint_tick = editor.buffer.tick;
            if ((hint_tick != hints_tick || editor.view_top != hints_top) && server.versions.contains(absolute_of(path)) && editor.mode != MED_editor.INSERT) {
                hints_tick = hint_tick;
                hints_top = editor.view_top;
                int first = editor.view_top;
                int last = editor.view_top + editor.view_height + 1;
                if (last > editor.buffer.line_count()) {
                    last = editor.buffer.line_count();
                }
                json.Value range = MED_lsp.object(["start", "end"], [MED_lsp.position_value(first, 0), MED_lsp.position_value(last, 0)]);
                lsp_flush_document();
                lsp_request("textDocument/inlayHint", "hints", MED_lsp.object(["textDocument", "range"], [MED_lsp.object(["uri"], [MED_lsp.text(MED_lsp.uri_of(absolute_of(path)))]), range]));
            }
        }
        // open and change: full-text sync of every buffer of this language
        str lang = server_languages[position];
        for (int index in 0 .. slots.size()) {
            Slot slot = slots[index];
            str key = slot_key(slot);
            if (key.size() == 0) {
                continue;
            }
            str slot_lang = server_language_of(slot.path, slot.editor.buffer.line(0));
            if (slot_lang.size() == 0) {
                slot_lang = MED_lsp.language_of_extension(slot.path);
            }
            if (slot_lang != lang) {
                continue;
            }
            int stamp = slot.editor.buffer.tick;
            str ticks_key = lang + "|" + key;
            if (!server.versions.contains(key)) {
                server.versions.set(key, 1);
                lsp_ticks.set(ticks_key, stamp);
                server.notify("textDocument/didOpen", MED_lsp.object(["textDocument"], [MED_lsp.object(["uri", "languageId", "version", "text"], [MED_lsp.text(MED_lsp.uri_of(key)), MED_lsp.text(MED_lsp.language_id_of(key, lang)), MED_lsp.number(1), MED_lsp.text(text_of_slot(slot))])]));
            } else if (lsp_ticks.get(ticks_key).or(-1) != stamp && slot.editor.mode != MED_editor.INSERT) {
                int version = server.versions.get(key).or(1) + 1;
                server.versions.set(key, version);
                lsp_ticks.set(ticks_key, stamp);
                server.notify("textDocument/didChange", MED_lsp.object(["textDocument", "contentChanges"], [MED_lsp.object(["uri", "version"], [MED_lsp.text(MED_lsp.uri_of(key)), MED_lsp.number(version)]), json.Value.Array([MED_lsp.object(["text"], [MED_lsp.text(text_of_slot(slot))])])]));
            }
        }
    }
    return is_changed;
}

/// Send the active buffer's current text to its server now (didChange), as
/// completion needs the text up to the cursor.
void App.lsp_flush_document() {
    int found = server_for(lsp_language_here());
    if (found < 0 || servers[found].is_dead || !servers[found].is_ready) {
        return;
    }
    MED_lsp.Server server = servers[found];
    str key = absolute_of(path);
    if (!server.versions.contains(key)) {
        return;
    }
    int version = server.versions.get(key).or(1) + 1;
    server.versions.set(key, version);
    lsp_ticks.set(lsp_language_here() + "|" + key, editor.buffer.tick);
    server.notify("textDocument/didChange", MED_lsp.object(["textDocument", "contentChanges"], [MED_lsp.object(["uri", "version"], [MED_lsp.text(MED_lsp.uri_of(key)), MED_lsp.number(version)]), json.Value.Array([MED_lsp.object(["text"], [MED_lsp.text(editor.buffer.lines.join("\n") + "\n")])])]));
}

/// Whether the server of this buffer asks for signature help after typing `code`.
bool App.is_signature_trigger(int code) {
    int found = server_for(lsp_language_here());
    if (found < 0 || servers[found].is_dead || !servers[found].is_ready) {
        return false;
    }
    json.Value provider = MED_lsp.member(servers[found].capabilities, "signatureHelpProvider");
    for (json.Value one in MED_lsp.items_of(MED_lsp.member(provider, "triggerCharacters"))) {
        if (MED_lsp.text_of(one) == str.from_chars([code])) {
            return true;
        }
    }
    return false;
}

/// Tell the servers a document was closed (its buffer was deleted); it is
/// opened again, with a new version, if it comes back.
void App.lsp_did_close(str key) {
    if (key.size() == 0) {
        return;
    }
    for (int position in 0 .. servers.size()) {
        MED_lsp.Server server = servers[position];
        if (!server.is_dead && server.versions.contains(key)) {
            server.notify("textDocument/didClose", MED_lsp.object(["textDocument"], [MED_lsp.object(["uri"], [MED_lsp.text(MED_lsp.uri_of(key))])]));
            server.versions.remove(key);
            lsp_ticks.remove(server_languages[position] + "|" + key);
        }
    }
    diagnostics.remove(key);
    hints.remove(key);
}

/// Tell the servers a file was saved.
void App.lsp_did_save(str file) {
    str key = absolute_of(file);
    for (int position in 0 .. servers.size()) {
        if (!servers[position].is_dead && servers[position].versions.contains(key)) {
            servers[position].notify("textDocument/didSave", MED_lsp.object(["textDocument"], [MED_lsp.object(["uri"], [MED_lsp.text(MED_lsp.uri_of(key))])]));
        }
    }
}

/// One message from server `position`. True when something visible changed.
bool App.did_handle_server_message(int position, MED_lsp.Message message) {
    MED_lsp.Server server = servers[position];
    if (message.kind == "response") {
        if (message.id == server.initialize_id) {
            if (!message.is_error) {
                server.is_ready = true;
                server.capabilities = MED_lsp.member(message.body, "capabilities");
                server.notify("initialized", MED_lsp.object([], []));
                lsp_quiet_ms = 1000;
            } else {
                notice = "LSP: " + server.name + ": " + message.error_text;
                server.stop();
            }
            return true;
        }
        str key = server.name + "#" + message.id.to_str();
        str purpose = lsp_pending.get(key).or("");
        if (purpose.size() == 0) {
            return false;
        }
        lsp_pending.remove(key);
        if (message.is_error) {
            if (message.error_code == -32801 || message.error_code == -32800) {
                notice = "LSP: the server was busy, try again";
            } else {
                notice = "LSP: " + message.error_text;
            }
            return true;
        }
        handle_lsp_result(purpose, message.body);
        return true;
    }
    if (message.kind == "notification") {
        if (message.method == "textDocument/publishDiagnostics") {
            str file = MED_lsp.path_of(MED_lsp.text_of(MED_lsp.member(message.body, "uri")));
            if (file.size() == 0) {
                return false;
            }
            int sent_version = MED_lsp.int_of(MED_lsp.member(message.body, "version"), -1);
            if (sent_version >= 0 && sent_version < server.versions.get(file).or(0)) {
                // computed for text that has since changed: a newer set follows
                return false;
            }
            List<MED_lsp.Diagnostic> raw = MED_lsp.diagnostics_of(message.body);
            List<MED_lsp.Diagnostic> fixed = [];
            int found = slot_with_path(file);
            for (MED_lsp.Diagnostic one in raw) {
                int col = one.col;
                int end_col = one.end_col;
                if (found >= 0) {
                    Slot slot = slots[found];
                    if (one.row < slot.editor.buffer.line_count()) {
                        col = MED_lsp.byte_of(slot.editor.buffer.line(one.row), one.col);
                    }
                    if (one.end_row < slot.editor.buffer.line_count()) {
                        end_col = MED_lsp.byte_of(slot.editor.buffer.line(one.end_row), one.end_col);
                    }
                }
                fixed.push(MED_lsp.Diagnostic(one.row, col, one.end_row, end_col, one.severity, one.message));
            }
            diagnostics.set(file, fixed);
            return true;
        }
        if (message.method == "window/showMessage") {
            notice = MED_lsp.text_of(MED_lsp.member(message.body, "message"));
            return true;
        }
        if (message.method == "$/progress") {
            return did_note_progress(server, message.body);
        }
        return false;
    }
    if (message.kind == "request") {
        if (message.method == "workspace/applyEdit") {
            List<MED_lsp.FileEdits> files = MED_lsp.workspace_edits(MED_lsp.member(message.body, "edit"));
            apply_workspace_edits(files);
            server.respond_to(message, MED_lsp.object(["applied"], [json.Value.Bool(true)]));
            return true;
        }
        if (message.method == "workspace/configuration") {
            // one answer per requested item; null means "no setting, use your default"
            List<json.Value> answers = [];
            for (json.Value item in MED_lsp.items_of(MED_lsp.member(message.body, "items"))) {
                answers.push(json.Value.Null);
            }
            server.respond_to(message, json.Value.Array(answers));
            return false;
        }
        if (message.method == "workspace/workspaceFolders") {
            json.Value folder = MED_lsp.object(["uri", "name"], [MED_lsp.text(MED_lsp.uri_of(server.root)), MED_lsp.text(server.root)]);
            server.respond_to(message, json.Value.Array([folder]));
            return false;
        }
        if (message.method == "window/workDoneProgress/create") {
            str token = MED_lsp.text_of(MED_lsp.member(message.body, "token"));
            if (token.size() == 0) {
                token = MED_lsp.int_of(MED_lsp.member(message.body, "token"), 0).to_str();
            }
            server.tokens.set(token, "");
            server.respond_to(message, json.Value.Null);
            return false;
        }
        // client/registerCapability, client/unregisterCapability,
        // window/showMessageRequest, window/showDocument and anything else:
        // every request gets an answer or the server waits for ever
        server.respond_to(message, json.Value.Null);
    }
    return false;
}

/// A `$/progress` notification: keep what the server is busy with. True when
/// the status line text changed.
bool App.did_note_progress(MED_lsp.Server server, json.Value body) {
    str token = MED_lsp.text_of(MED_lsp.member(body, "token"));
    if (token.size() == 0) {
        token = MED_lsp.int_of(MED_lsp.member(body, "token"), 0).to_str();
    }
    json.Value value = MED_lsp.member(body, "value");
    str kind = MED_lsp.text_of(MED_lsp.member(value, "kind"));
    str before = server.progress;
    if (kind == "end") {
        server.tokens.remove(token);
        server.progress = "";
        for (str other in server.tokens.keys()) {
            if (server.tokens.get(other).or("").size() > 0) {
                server.progress = server.tokens.get(other).or("");
            }
        }
        return before != server.progress;
    }
    str title = MED_lsp.text_of(MED_lsp.member(value, "title"));
    if (title.size() == 0) {
        title = server.tokens.get(token).or("");
    }
    str detail = MED_lsp.text_of(MED_lsp.member(value, "message"));
    str progress_text = title;
    if (detail.size() > 0) {
        progress_text = progress_text + " " + detail;
    }
    int percentage = MED_lsp.int_of(MED_lsp.member(value, "percentage"), -1);
    if (percentage >= 0) {
        progress_text = progress_text + " " + percentage.to_str() + "%";
    }
    if (kind == "begin" || kind == "report") {
        server.tokens.set(token, progress_text);
        server.progress = progress_text;
    }
    return before != server.progress;
}

/// Send a request for the active buffer; remember what it was for.
void App.lsp_request(str method, str purpose, json.Value parameters) {
    int found = server_for(lsp_language_here());
    if (found < 0 || servers[found].is_dead || !servers[found].is_ready) {
        notice = "LSP: no language server is ready for this buffer";
        return;
    }
    int id = servers[found].request(method, parameters);
    lsp_pending.set(servers[found].name + "#" + id.to_str(), purpose + "|" + absolute_of(path));
}

/// The cursor as a TextDocumentPositionSettings value.
json.Value App.lsp_position_parameters() {
    int units = MED_lsp.units_of(editor.buffer.line(editor.row), editor.col);
    return MED_lsp.object(["textDocument", "position"], [MED_lsp.object(["uri"], [MED_lsp.text(MED_lsp.uri_of(absolute_of(path)))]), MED_lsp.position_value(editor.row, units)]);
}

/// `:Lsp SUBCOMMAND ...` and the `app:lsp_*` actions.
void App.run_lsp_command(str sub, str arg) {
    if (!is_plugin_on("lsp")) {
        notice = "The lsp plugin is off (:PluginEnable lsp)";
        return;
    }
    if (sub == "info") {
        List<str> lines = ["Language servers:"];
        if (servers.size() == 0) {
            lines.push("  none running");
        }
        for (int position in 0 .. servers.size()) {
            str state = "ready";
            if (servers[position].is_dead) {
                state = "stopped";
            } else if (!servers[position].is_ready) {
                state = "starting";
            }
            str extra = "";
            if (servers[position].progress.size() > 0) {
                extra = ", " + servers[position].progress;
            }
            lines.push("  " + server_languages[position] + ": " + servers[position].name + " (" + state + extra + ")");
            if (servers[position].is_dead && servers[position].log.size() > 0) {
                List<str> log_lines = servers[position].log.trim().split("\n");
                int first = log_lines.size() - 3;
                if (first < 0) {
                    first = 0;
                }
                for (int index in first .. log_lines.size()) {
                    lines.push("      " + log_lines[index]);
                }
            }
        }
        overlay = lines;
        return;
    }
    if (sub == "server") {
        int space = arg.index_of(" ").or(-1);
        if (space < 0) {
            notice = "E471: Argument required (:Lsp server LANGUAGE COMMAND...)";
            return;
        }
        server_commands.set(arg.substr(0, space), arg.substr(space + 1, arg.size()).trim());
        lsp_failed_for = "";
        return;
    }
    if (sub == "start") {
        lsp_failed_for = "";
        str lang = lsp_language_here();
        if (lang.size() == 0) {
            notice = "LSP: no language for this buffer";
        } else if (server_for(lang) >= 0 && !servers[server_for(lang)].is_dead) {
            notice = "LSP: already running";
        } else {
            start_server(lang);
        }
        return;
    }
    if (sub == "stop") {
        for (int position in 0 .. servers.size()) {
            servers[position].stop();
        }
        servers = [];
        server_languages = [];
        diagnostics = {};
        lsp_pending = {};
        lsp_ticks = {};
        return;
    }
    if (!has_server_here()) {
        notice = "LSP: no language server for this buffer (:Lsp info)";
        return;
    }
    str needed = lsp_capability_for(sub);
    int active = server_for(lsp_language_here());
    if (needed.size() > 0 && active >= 0 && !servers[active].can_do(needed)) {
        notice = "LSP: " + servers[active].name + " does not support " + sub;
        return;
    }
    if (sub == "hover") {
        lsp_request("textDocument/hover", "hover", lsp_position_parameters());
    } else if (sub == "signature") {
        lsp_flush_document();
        lsp_request("textDocument/signatureHelp", "signature", lsp_position_parameters());
    } else if (sub == "hints") {
        if (arg == "on") {
            is_hints_on = true;
        } else if (arg == "off") {
            is_hints_on = false;
        } else {
            is_hints_on = !is_hints_on;
        }
        hints_tick = -1;
        if (is_hints_on) {
            notice = "LSP: inlay hints on";
        } else {
            hints = {};
            notice = "LSP: inlay hints off";
        }
    } else if (sub == "definition") {
        lsp_request("textDocument/definition", "definition", lsp_position_parameters());
    } else if (sub == "references") {
        json.Value parameters = lsp_position_parameters();
        json.Value context = MED_lsp.object(["includeDeclaration"], [json.Value.Bool(true)]);
        lsp_request("textDocument/references", "references", MED_lsp.object(["textDocument", "position", "context"], [MED_lsp.member(parameters, "textDocument"), MED_lsp.member(parameters, "position"), context]));
    } else if (sub == "rename") {
        if (arg.size() == 0) {
            begin_command("Lsp rename ");
            return;
        }
        json.Value parameters = lsp_position_parameters();
        lsp_request("textDocument/rename", "rename", MED_lsp.object(["textDocument", "position", "newName"], [MED_lsp.member(parameters, "textDocument"), MED_lsp.member(parameters, "position"), MED_lsp.text(arg)]));
    } else if (sub == "format") {
        json.Value options = MED_lsp.object(["tabSize", "insertSpaces"], [MED_lsp.number(editor.tab), json.Value.Bool(editor.is_expandtab)]);
        lsp_request("textDocument/formatting", "format", MED_lsp.object(["textDocument", "options"], [MED_lsp.object(["uri"], [MED_lsp.text(MED_lsp.uri_of(absolute_of(path)))]), options]));
    } else if (sub == "action") {
        int units = MED_lsp.units_of(editor.buffer.line(editor.row), editor.col);
        json.Value spot = MED_lsp.position_value(editor.row, units);
        json.Value range = MED_lsp.object(["start", "end"], [spot, spot]);
        // the diagnostics on this line go along: quick fixes are offered for them
        List<json.Value> here = [];
        for (MED_lsp.Diagnostic one in diagnostics.get(absolute_of(path)).or([])) {
            if (one.row == editor.row) {
                int start_units = MED_lsp.units_of(editor.buffer.line(one.row), one.col);
                int end_units = start_units;
                if (one.end_row < editor.buffer.line_count()) {
                    end_units = MED_lsp.units_of(editor.buffer.line(one.end_row), one.end_col);
                }
                json.Value one_range = MED_lsp.object(["start", "end"], [MED_lsp.position_value(one.row, start_units), MED_lsp.position_value(one.end_row, end_units)]);
                here.push(MED_lsp.object(["range", "severity", "message"], [one_range, MED_lsp.number(one.severity), MED_lsp.text(one.message)]));
            }
        }
        lsp_request("textDocument/codeAction", "action", MED_lsp.object(["textDocument", "range", "context"], [MED_lsp.object(["uri"], [MED_lsp.text(MED_lsp.uri_of(absolute_of(path)))]), range, MED_lsp.object(["diagnostics"], [json.Value.Array(here)])]));
    } else if (sub == "complete") {
        if (arg.size() > 0) {
            accept_completion(arg.parse_int().or(-1));
            return;
        }
        int word_start = editor.col;
        str line_text = editor.buffer.line(editor.row);
        while (word_start > 0 && is_completion_byte(line_text.byte_at(word_start - 1))) {
            word_start = word_start - 1;
        }
        lsp_completion_row = editor.row;
        lsp_completion_byte = word_start;
        // Insert mode holds back didChange: the server must see what was typed
        lsp_flush_document();
        json.Value parameters = lsp_position_parameters();
        lsp_request("textDocument/completion", "complete", MED_lsp.object(["textDocument", "position", "context"], [MED_lsp.member(parameters, "textDocument"), MED_lsp.member(parameters, "position"), MED_lsp.object(["triggerKind"], [MED_lsp.number(1)])]));
    } else if (sub.starts_with("apply")) {
        int which = arg.parse_int().or(-1);
        if (which >= 0 && which < lsp_actions.size()) {
            run_code_action(lsp_actions[which]);
        }
    } else {
        notice = "E474: Unknown :Lsp subcommand: " + sub;
    }
}

/// The answer to request `purpose|file` is `result`.
void App.handle_lsp_result(str purpose_and_file, json.Value result) {
    int bar = purpose_and_file.index_of("|").or(purpose_and_file.size());
    str purpose = purpose_and_file.substr(0, bar);
    str file = purpose_and_file.substr(bar + 1, purpose_and_file.size());
    if (purpose == "hover") {
        str text_value = MED_lsp.hover_text(result).trim();
        if (text_value.size() == 0) {
            notice = "LSP: no hover information";
            return;
        }
        List<str> lines = [];
        for (str line in text_value.split("\n")) {
            if (!line.starts_with("```")) {
                lines.push(line);
            }
        }
        overlay = lines;
    } else if (purpose == "signature") {
        List<str> lines = MED_lsp.signature_lines(result);
        if (lines.size() == 0) {
            notice = "LSP: no signature help";
            return;
        }
        overlay = lines;
    } else if (purpose == "hints") {
        Map<str, str> by_row = {};
        int found_slot = slot_with_path(file);
        for (json.Value hint in MED_lsp.items_of(result)) {
            json.Value spot = MED_lsp.member(hint, "position");
            int row = MED_lsp.int_of(MED_lsp.member(spot, "line"), -1);
            str label = MED_lsp.inlay_label(hint).trim();
            if (row < 0 || label.size() == 0) {
                continue;
            }
            if (found_slot >= 0 && row >= slots[found_slot].editor.buffer.line_count()) {
                continue;
            }
            by_row.set(row.to_str(), by_row.get(row.to_str()).or("") + " " + label);
        }
        hints.set(file, by_row);
    } else if (purpose == "definition" || purpose == "references") {
        List<MED_lsp.Place> places = MED_lsp.places_of(result);
        if (places.size() == 0) {
            notice = "LSP: nothing found";
            return;
        }
        if (places.size() == 1 && purpose == "definition") {
            jump_to_place(places[0]);
            return;
        }
        List<MED_picker.Entry> entries = [];
        for (MED_lsp.Place one in places) {
            entries.push(place_entry(one));
        }
        root = MED_files.project_root();
        picker = MED_picker.make(MED_picker.KIND_LIST, "References");
        if (purpose == "definition") {
            picker.title = "Definitions";
        }
        picker.set_entries(entries);
        has_picker = true;
        update_preview();
    } else if (purpose == "rename") {
        List<MED_lsp.FileEdits> files = MED_lsp.workspace_edits(result);
        int count = apply_workspace_edits(files);
        notice = "Renamed in " + files.size().to_str() + " file(s), " + count.to_str() + " edit(s)";
    } else if (purpose == "format") {
        List<MED_lsp.TextEdit> edits = MED_lsp.edits_of(result);
        if (edits.size() == 0) {
            notice = "LSP: nothing to format";
            return;
        }
        did_apply_file_edits(file, edits);
        notice = "Formatted";
    } else if (purpose == "complete") {
        json.Value list = result;
        if (!MED_lsp.is_null(MED_lsp.member(result, "items"))) {
            list = MED_lsp.member(result, "items");
        }
        lsp_completions = [];
        List<MED_picker.Entry> entries = [];
        // by the server's sortText (label when it has none), stable
        List<str> sort_keys = [];
        List<json.Value> sorted = [];
        for (json.Value item in MED_lsp.items_of(list)) {
            str label = MED_lsp.text_of(MED_lsp.member(item, "label"));
            if (label.size() == 0 || sorted.size() >= 5000) {
                continue;
            }
            str sort_key = MED_lsp.text_of(MED_lsp.member(item, "sortText"));
            if (sort_key.size() == 0) {
                sort_key = label;
            }
            int low = 0;
            int high = sort_keys.size();
            while (low < high) {
                int middle = (low + high) / 2;
                if (MED_lsp.is_before(sort_key, sort_keys[middle])) {
                    high = middle;
                } else {
                    low = middle + 1;
                }
            }
            sort_keys.insert(low, sort_key);
            sorted.insert(low, item);
        }
        for (json.Value item in sorted) {
            str label = MED_lsp.text_of(MED_lsp.member(item, "label"));
            str detail = MED_lsp.text_of(MED_lsp.member(item, "detail"));
            if (detail.size() > 0) {
                label = label + "  " + detail;
            }
            entries.push(MED_picker.Entry(label, action: "app:lsp_complete " + lsp_completions.size().to_str()));
            lsp_completions.push(item);
        }
        if (entries.size() == 0) {
            notice = "LSP: no completions";
            return;
        }
        picker = MED_picker.make(MED_picker.KIND_LIST, "Completion");
        picker.set_entries(entries);
        // servers send everything that fits; the typed prefix narrows it here
        str typed = "";
        if (lsp_completion_row < editor.buffer.line_count() && lsp_completion_byte <= editor.col) {
            typed = editor.buffer.line(lsp_completion_row).substr(lsp_completion_byte, editor.col);
        }
        if (typed.size() > 0) {
            picker.query = typed;
            picker.refilter();
            if (picker.shown.size() == 0) {
                picker.query = "";
                picker.refilter();
            }
        }
        has_picker = true;
    } else if (purpose == "resolved_action") {
        run_resolved_action(result);
    } else if (purpose == "action") {
        lsp_actions = [];
        List<MED_picker.Entry> entries = [];
        for (json.Value item in MED_lsp.items_of(result)) {
            str title = MED_lsp.text_of(MED_lsp.member(item, "title"));
            if (title.size() == 0) {
                continue;
            }
            entries.push(MED_picker.Entry(title, action: "app:lsp_apply " + lsp_actions.size().to_str()));
            lsp_actions.push(item);
        }
        if (entries.size() == 0) {
            notice = "LSP: no code actions";
            return;
        }
        picker = MED_picker.make(MED_picker.KIND_LIST, "Code actions");
        picker.set_entries(entries);
        has_picker = true;
    }
}

// ---------------------------------------------------------------- snippets (engine/MED_snippet.m31, MED_snipops.m31)

/// Read the user's snippets: `snippets.json` and `snippets/LANGUAGE.json` (entries that apply to that language) next to
/// the keymap file `file`, in VS Code's snippet format.
pub void App.load_snippets(str file) {
    int slash = -1;
    for (int index in 0 .. file.size()) {
        if (file.byte_at(index) == 47) {
            slash = index;
        }
    }
    if (slash < 0) {
        return;
    }
    str directory = file.substr(0, slash);
    List<MED_snippet.Entry> all = [];
    match (io.read(directory + "/snippets.json")) {
        case Ok(str content): {
            for (MED_snippet.Entry entry in MED_snippet.parse_user_file(content)) {
                all.push(entry);
            }
        }
        case Err(io.Error error): {
        }
    }
    match (fs.listdir(directory + "/snippets")) {
        case Ok(List<str> names): {
            for (str name in names) {
                if (!name.ends_with(".json")) {
                    continue;
                }
                match (io.read(directory + "/snippets/" + name)) {
                    case Ok(str content): {
                        List<MED_snippet.Entry> found = MED_snippet.parse_user_file(content);
                        for (int position in 0 .. found.size()) {
                            MED_snippet.Entry entry = found[position];
                            if (entry.scopes.size() == 0) {
                                entry.scopes = [name.substr(0, name.size() - 5)];
                            }
                            all.push(entry);
                        }
                    }
                    case Err(io.Error error): {
                    }
                }
            }
        }
        case Err(io.Error error): {
        }
    }
    editor.snippets = all;
    for (Slot slot in slots) {
        MED_editor.Editor holder = slot.editor;
        holder.snippets = all;
    }
}

// What a snippet reads from the world: the language, the file, the time.
void App.note_snippet_context() {
    if (editor.snippets.size() > 0) {
        editor.snip_language = MED_hl.language(editor);
    }
    editor.snip_now = date.now();
    if (path.size() == 0 || path.starts_with("/")) {
        editor.snip_path = path;
        return;
    }
    if (snip_cwd.size() == 0) {
        snip_cwd = MED_projconf.absolute_path(".");
    }
    editor.snip_path = snip_cwd + "/" + path;
}

/// Insert completion item `which` in place of the word before the cursor
/// (or over the item's own `textEdit` range), cursor after the text.
void App.accept_completion(int which) {
    if (which < 0 || which >= lsp_completions.size() || lsp_completion_row >= editor.buffer.line_count()) {
        return;
    }
    json.Value item = lsp_completions[which];
    str line_text = editor.buffer.line(lsp_completion_row);
    int from_units = MED_lsp.units_of(line_text, lsp_completion_byte);
    int to_units = MED_lsp.units_of(line_text, editor.col);
    str inserted = MED_lsp.text_of(MED_lsp.member(item, "insertText"));
    if (inserted.size() == 0) {
        inserted = MED_lsp.text_of(MED_lsp.member(item, "label"));
    }
    json.Value edit = MED_lsp.member(item, "textEdit");
    int row_from = lsp_completion_row;
    int row_to = lsp_completion_row;
    if (!MED_lsp.is_null(edit)) {
        json.Value range = MED_lsp.member(edit, "range");
        if (MED_lsp.is_null(range)) {
            range = MED_lsp.member(edit, "replace");
        }
        if (MED_lsp.is_null(range)) {
            range = MED_lsp.member(edit, "insert");
        }
        json.Value start = MED_lsp.member(range, "start");
        json.Value finish = MED_lsp.member(range, "end");
        row_from = MED_lsp.int_of(MED_lsp.member(start, "line"), lsp_completion_row);
        row_to = MED_lsp.int_of(MED_lsp.member(finish, "line"), lsp_completion_row);
        from_units = MED_lsp.int_of(MED_lsp.member(start, "character"), from_units);
        to_units = MED_lsp.int_of(MED_lsp.member(finish, "character"), to_units);
        str edited = MED_lsp.text_of(MED_lsp.member(edit, "newText"));
        if (edited.size() > 0) {
            inserted = edited;
        }
    }
    bool is_snippet = MED_lsp.int_of(MED_lsp.member(item, "insertTextFormat"), 1) == 2;
    str snippet_body = "";
    if (is_snippet) {
        // the snippet engine expands it where the range was (tabstops, placeholders, mirrors)
        snippet_body = inserted;
        inserted = "";
    }
    List<MED_lsp.TextEdit> edits = [MED_lsp.TextEdit(row_from, from_units, row_to, to_units, inserted)];
    for (MED_lsp.TextEdit extra in MED_lsp.edits_of(MED_lsp.member(item, "additionalTextEdits"))) {
        edits.push(extra);
    }
    if (!did_apply_file_edits(absolute_of(path), edits)) {
        return;
    }
    // the cursor goes after the inserted text
    int start_byte = MED_lsp.byte_of(line_text, from_units);
    if (is_snippet) {
        editor.row = row_from;
        editor.col = start_byte;
        editor.clamp();
        MED_vim.expand_snippet(editor, snippet_body);
        return;
    }
    List<str> pieces = inserted.split("\n");
    editor.row = row_from + pieces.size() - 1;
    if (pieces.size() == 1) {
        editor.col = start_byte + inserted.size();
    } else {
        editor.col = pieces[pieces.size() - 1].size();
    }
    editor.clamp();
    editor.want_from_cursor();
}

/// Carry out a code action the user picked: its edit, else its command, else
/// resolve it first (servers send the edit lazily in `data`).
void App.run_code_action(json.Value item) {
    if (!MED_lsp.is_null(MED_lsp.member(item, "edit"))) {
        apply_workspace_edits(MED_lsp.workspace_edits(MED_lsp.member(item, "edit")));
        run_action_command(item);
        return;
    }
    int found = server_for(lsp_language_here());
    if (found >= 0 && !MED_lsp.is_null(MED_lsp.member(item, "data")) && MED_lsp.is_null(MED_lsp.member(item, "command"))) {
        lsp_request("codeAction/resolve", "resolved_action", item);
        return;
    }
    run_action_command(item);
}

/// The result of `codeAction/resolve`.
void App.run_resolved_action(json.Value item) {
    if (!MED_lsp.is_null(MED_lsp.member(item, "edit"))) {
        apply_workspace_edits(MED_lsp.workspace_edits(MED_lsp.member(item, "edit")));
    }
    run_action_command(item);
}

// Send the `command` of a code action (or the action itself, when it is a
// bare Command) as workspace/executeCommand.
void App.run_action_command(json.Value item) {
    json.Value command = MED_lsp.member(item, "command");
    json.Value spec = command;
    if (MED_lsp.text_of(command).size() > 0) {
        // the item is itself a Command: {title, command: "name", arguments}
        spec = item;
    }
    if (MED_lsp.is_null(spec) || MED_lsp.text_of(MED_lsp.member(spec, "command")).size() == 0) {
        return;
    }
    json.Value arguments = MED_lsp.member(spec, "arguments");
    if (MED_lsp.is_null(arguments)) {
        arguments = json.Value.Array([]);
    }
    lsp_request("workspace/executeCommand", "command", MED_lsp.object(["command", "arguments"], [MED_lsp.member(spec, "command"), arguments]));
}

/// The server capability a `:Lsp` subcommand needs ("" for none).
str App.lsp_capability_for(str sub) {
    if (sub == "hover") {
        return "hoverProvider";
    }
    if (sub == "definition") {
        return "definitionProvider";
    }
    if (sub == "references") {
        return "referencesProvider";
    }
    if (sub == "rename") {
        return "renameProvider";
    }
    if (sub == "format") {
        return "documentFormattingProvider";
    }
    if (sub == "action") {
        return "codeActionProvider";
    }
    if (sub == "complete") {
        return "completionProvider";
    }
    if (sub == "signature") {
        return "signatureHelpProvider";
    }
    if (sub == "hints") {
        return "inlayHintProvider";
    }
    return "";
}

/// The text of line `row` of `file` (from an open buffer, else from disk).
str App.line_of_file(str file, int row) {
    int found = slot_with_path(file);
    if (found >= 0) {
        Slot slot = slots[found];
        if (row < slot.editor.buffer.line_count()) {
            return slot.editor.buffer.line(row);
        }
        return "";
    }
    match (io.read(file)) {
        case Ok(str text_value): {
            List<str> lines = text_value.split("\n");
            if (row < lines.size()) {
                return lines[row];
            }
            return "";
        }
        case Err(io.Error error): {
            return "";
        }
    }
}

MED_picker.Entry App.place_entry(MED_lsp.Place one) {
    str line = line_of_file(one.path, one.line);
    int column = MED_lsp.byte_of(line, one.character);
    str base = absolute_root();
    str shown_path = one.path;
    if (shown_path.starts_with(base + "/")) {
        shown_path = shown_path.substr(base.size() + 1, shown_path.size());
    }
    return MED_picker.Entry(shown_path + ":" + (one.line + 1).to_str() + ": " + line.trim(), path: openable(one.path), line: one.line, column: column);
}

void App.jump_to_place(MED_lsp.Place one) {
    str line = line_of_file(one.path, one.line);
    jump_to(openable(one.path), one.line, MED_lsp.byte_of(line, one.character));
}

/// Apply TextEdits to the buffer of `file` (opened hidden when needed) as one
/// undoable change. False when the file could not be read.
bool App.did_apply_file_edits(str file, List<MED_lsp.TextEdit> edits) {
    int found = slot_with_path(file);
    if (found < 0) {
        match (read_slot(next_id, openable(file))) {
            case Ok(Slot fresh): {
                slots.push(fresh);
                next_id = fresh.id + 1;
                found = slots.size() - 1;
            }
            case Err(str message): {
                notice = message;
                return false;
            }
        }
    }
    Slot slot = slots[found];
    List<str> before = slot.editor.buffer.lines;
    List<str> after = MED_lsp.apply_edits(before, edits);
    if (after.join("\n") == before.join("\n")) {
        return true;
    }
    int last = before.size() - 1;
    slot.editor.open_block();
    slot.editor.change(MED_buffer.Pos(0, 0), MED_buffer.Pos(last, before[last].size()), after.join("\n"));
    slot.editor.end_block();
    slot.editor.clamp();
    return true;
}

/// Apply every file's edits; the number of edits applied.
int App.apply_workspace_edits(List<MED_lsp.FileEdits> files) {
    int count = 0;
    for (MED_lsp.FileEdits one in files) {
        if (did_apply_file_edits(one.path, one.edits)) {
            count = count + one.edits.size();
        }
    }
    save_active();
    // the active buffer's editor may have been edited through its slot
    return count;
}

/// The severity of each row of `file` that has a diagnostic (0 for none);
/// empty when the file has no diagnostics.
List<int> App.diagnostic_rows_of(str file, int rows) {
    List<int> out = [];
    if (diagnostics.size() == 0 || file.size() == 0) {
        return out;
    }
    List<MED_lsp.Diagnostic> found = diagnostics.get(absolute_of(file)).or([]);
    if (found.size() == 0) {
        return out;
    }
    for (int row in 0 .. rows) {
        out.push(0);
    }
    for (MED_lsp.Diagnostic one in found) {
        if (one.row < rows && (out[one.row] == 0 || one.severity < out[one.row])) {
            out[one.row] = one.severity;
        }
    }
    return out;
}

/// The diagnostics of the active buffer, as (error, warning) counts.
List<int> App.diagnostic_counts() {
    int errors = 0;
    int warnings = 0;
    if (diagnostics.size() > 0 && path.size() > 0) {
        for (MED_lsp.Diagnostic one in diagnostics.get(absolute_of(path)).or([])) {
            if (one.severity == 1) {
                errors = errors + 1;
            } else if (one.severity == 2) {
                warnings = warnings + 1;
            }
        }
    }
    return [errors, warnings];
}

/// `<Space>ll`: the diagnostics on the cursor line.
void App.show_diagnostic_here() {
    List<str> lines = [];
    if (path.size() > 0) {
        for (MED_lsp.Diagnostic one in diagnostics.get(absolute_of(path)).or([])) {
            if (one.row == editor.row) {
                lines.push(severity_name(one.severity) + ": " + one.message);
            }
        }
    }
    if (lines.size() == 0) {
        notice = "No diagnostics on this line";
    } else if (lines.size() == 1) {
        notice = lines[0];
    } else {
        overlay = lines;
    }
}

/// `]d` `[d` `<Space>]]` `<Space>[[`: the next or previous diagnostic of this
/// buffer (wrapping).
void App.go_diagnostic(bool is_forward) {
    if (path.size() == 0) {
        notice = "No diagnostics";
        return;
    }
    List<MED_lsp.Diagnostic> found = diagnostics.get(absolute_of(path)).or([]);
    if (found.size() == 0) {
        notice = "No diagnostics";
        return;
    }
    int best = -1;
    int wrap = -1;
    for (int index in 0 .. found.size()) {
        MED_lsp.Diagnostic one = found[index];
        bool is_after = one.row > editor.row || (one.row == editor.row && one.col > editor.col);
        bool is_before = one.row < editor.row || (one.row == editor.row && one.col < editor.col);
        if (is_forward) {
            if (is_after && (best < 0 || one.row < found[best].row || (one.row == found[best].row && one.col < found[best].col))) {
                best = index;
            }
            if (wrap < 0 || one.row < found[wrap].row || (one.row == found[wrap].row && one.col < found[wrap].col)) {
                wrap = index;
            }
        } else {
            if (is_before && (best < 0 || one.row > found[best].row || (one.row == found[best].row && one.col > found[best].col))) {
                best = index;
            }
            if (wrap < 0 || one.row > found[wrap].row || (one.row == found[wrap].row && one.col > found[wrap].col)) {
                wrap = index;
            }
        }
    }
    if (best < 0) {
        best = wrap;
    }
    MED_lsp.Diagnostic target = found[best];
    editor.set_pcmark(MED_buffer.Pos(editor.row, editor.col));
    editor.row = target.row;
    editor.col = target.col;
    editor.clamp();
    editor.want_from_cursor();
    notice = severity_name(target.severity) + ": " + target.message;
}

/// Diagnostics as picker entries (this buffer's, or every file's).
List<MED_picker.Entry> App.diagnostic_entries(bool is_buffer_only) {
    List<MED_picker.Entry> out = [];
    str here = "";
    if (path.size() > 0) {
        here = absolute_of(path);
    }
    str base = absolute_root();
    for (str file in diagnostics.keys()) {
        if (is_buffer_only && file != here) {
            continue;
        }
        str shown_path = file;
        if (shown_path.starts_with(base + "/")) {
            shown_path = shown_path.substr(base.size() + 1, shown_path.size());
        }
        for (MED_lsp.Diagnostic one in diagnostics.get(file).or([])) {
            out.push(MED_picker.Entry(shown_path + ":" + (one.row + 1).to_str() + ": " + severity_name(one.severity) + ": " + one.message, path: openable(file), line: one.row, column: one.col));
        }
    }
    return out;
}

/// The problems extensions reported since the last call, as one message ("" when none).
str App.ext_problem_text() {
    List<str> taken = ext.take_problems();
    if (taken.size() == 0) {
        return "";
    }
    return taken.join(" | ");
}

/// What handlers that just ran asked for: a message, the finder, their problems.
void App.ext_finish(MED_ext.Ctx context) {
    if (context.notice.size() > 0) {
        notice = context.notice;
    }
    str problem = ext_problem_text();
    if (problem.size() > 0) {
        notice = problem;
    }
    if (context.has_pick) {
        context.has_pick = false;
        overlay = [];
        is_leader = false;
        is_which_key = false;
        preview_path = "";
        is_grep_due = false;
        end_theme_picker(true);
        stop_source();
        picker = MED_picker.make(MED_picker.KIND_LIST, context.pick_title);
        picker.set_entries(context.pick_entries);
        picker.is_deferred = true;
        has_picker = true;
        update_preview();
    }
}

/// Run the handlers of `event` for the buffer in `slot`.
void App.ext_fire_slot(MED_ext.Event event, Slot slot, str file) {
    if (!ext.has_handler(event)) {
        return;
    }
    MED_ext.Ctx context = MED_ext.context(ext, slot.editor, file);
    ext.fire(event, context, MED_ext.Info(file: file, buffer_id: slot.id));
    ext_finish(context);
}

/// `write_slot` with the BufWritePre / BufWritePost events around it.
str App.write_hooked(Slot slot, str target) {
    if (!ext.has_handler(MED_ext.Event.BufWritePre) && !ext.has_handler(MED_ext.Event.BufWritePost)) {
        return write_slot(slot, target);
    }
    str file = target.trim();
    if (file.size() == 0) {
        file = slot.path;
    }
    if (slot.is_listing) {
        return write_slot(slot, target);
    }
    ext_fire_slot(MED_ext.Event.BufWritePre, slot, file);
    str result = write_slot(slot, target);
    if (!result.starts_with("E")) {
        ext_fire_slot(MED_ext.Event.BufWritePost, slot, file);
    }
    str problem = ext_problem_text();
    if (problem.size() > 0) {
        return result + "  " + problem;
    }
    return result;
}

/// Before the keymap file: let the built-in extensions register, then install their commands and key mappings
/// (so the user's keymap file, read next, overrides them).
pub void App.ext_install() {
    MED_ext_enabled.install(ext);
    if (ext.is_empty()) {
        return;
    }
    ext_commands = ext.command_names();
    for (int position in 0 .. slots.size()) {
        slots[position].editor.user_commands = ext_commands;
    }
    editor.user_commands = ext_commands;
    for (str line in ext.map_lines()) {
        MED_ex.did_run_line(editor, line);
    }
    editor.message = "";
}

/// After start-up is complete (keymap file, session, theme): Startup, and BufOpen for the files given on the command line.
pub void App.ext_started() {
    if (ext.is_empty()) {
        return;
    }
    save_active();
    ext_buffer = current_id;
    ext_mode = editor.mode;
    ext_row = editor.row;
    ext_col = editor.col;
    ext_tick = editor.buffer.tick;
    for (Slot slot in slots) {
        if (!slot.is_listing) {
            ext_fire_slot(MED_ext.Event.BufOpen, slot, slot.path);
        }
    }
    if (ext.has_handler(MED_ext.Event.Startup)) {
        MED_ext.Ctx context = MED_ext.context(ext, editor, path);
        ext.fire(MED_ext.Event.Startup, context, MED_ext.Info(file: path, buffer_id: current_id));
        ext_finish(context);
    }
    str problem = ext_problem_text();
    if (problem.size() > 0) {
        notice = problem;
    }
}

/// When the loop has ended: Shutdown, and stop background jobs.
pub void App.ext_stop() {
    if (ext.is_empty()) {
        return;
    }
    if (ext.has_handler(MED_ext.Event.Shutdown)) {
        MED_ext.Ctx context = MED_ext.context(ext, editor, path);
        ext.fire(MED_ext.Event.Shutdown, context, MED_ext.Info(file: path, buffer_id: current_id));
    }
    ext.stop_jobs();
}

/// After an event is handled: ModeChanged, CursorMoved and TextChanged for the active buffer, each at most once.
/// Changes the handlers make are not reported back to them.
void App.ext_watch() {
    if (!ext.has_handler(MED_ext.Event.ModeChanged) && !ext.has_handler(MED_ext.Event.CursorMoved) && !ext.has_handler(MED_ext.Event.TextChanged)) {
        return;
    }
    if (current_id != ext_buffer) {
        // another buffer: its state is the new baseline, not a change
        ext_buffer = current_id;
        ext_mode = editor.mode;
        ext_row = editor.row;
        ext_col = editor.col;
        ext_tick = editor.buffer.tick;
        return;
    }
    bool is_mode = editor.mode != ext_mode;
    bool is_cursor = editor.row != ext_row || editor.col != ext_col;
    bool is_text = editor.buffer.tick != ext_tick;
    if (!is_mode && !is_cursor && !is_text) {
        return;
    }
    MED_ext.Ctx context = MED_ext.context(ext, editor, path);
    MED_ext.Info info = MED_ext.Info(file: path, buffer_id: current_id, mode_before: ext_mode, mode_after: editor.mode, row: editor.row, col: editor.col);
    if (is_mode) {
        ext.fire(MED_ext.Event.ModeChanged, context, info);
    }
    if (is_text) {
        ext.fire(MED_ext.Event.TextChanged, context, info);
    }
    if (is_cursor) {
        ext.fire(MED_ext.Event.CursorMoved, context, info);
    }
    ext_mode = editor.mode;
    ext_row = editor.row;
    ext_col = editor.col;
    ext_tick = editor.buffer.tick;
    ext_finish(context);
}

/// The timer: events that no key caused (a mouse move), jobs, Tick. True when the screen should be redrawn.
bool App.did_tick_ext(int elapsed_ms) {
    ext.tick_ms = ext.tick_ms + elapsed_ms;
    if (ext.tick_ms < MED_ext.TICK_MS) {
        return false;
    }
    int waited = ext.tick_ms;
    ext.tick_ms = 0;
    bool is_changed = false;
    MED_ext.Ctx context = MED_ext.context(ext, editor, path);
    if (ext.is_tick_wanted()) {
        if (ext.did_poll_jobs(context)) {
            is_changed = true;
        }
        if (ext.has_handler(MED_ext.Event.Tick)) {
            ext.fire(MED_ext.Event.Tick, context, MED_ext.Info(file: path, buffer_id: current_id, elapsed_ms: waited));
            is_changed = true;
        }
    }
    ext_finish(context);
    ext_watch();
    return is_changed;
}

// ----------------------------------------------------------------- sessions

/// The session saved for the current directory (an empty one when there is none).
pub MED_session.Session load_project_session(str directory) {
    return MED_session.load(directory, MED_session.file_for("", MED_projconf.absolute_path(".")));
}

// ------------------------------------------------------------------ windows

// ------------------------------------------------------------------ tab pages

// ------------------------------------------------------------------ listings

bool is_completion_byte(int byte) {
    return (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 || byte >= 128;
}

const str JUMP_LABELS = "asdfghjklqwertyuiopzxcvbnm";

str jump_label(int index) {
    return JUMP_LABELS.substr(index, index + 1);
}

/// The text of engine keys that are characters (13 is a line break).
str paste_text(List<int> keys) {
    List<int> codes = [];
    for (int key in keys) {
        if (key == 13) {
            codes.push(10);
        } else {
            codes.push(key);
        }
    }
    return str.from_chars(codes);
}

/// The language a file is served as: what `SYN_detect` says, with TypeScript
/// folded onto JavaScript (one language server handles both).
pub str server_language_of(str path, str first_line) {
    str lang = SYN_detect.language_of(path, first_line);
    if (lang == "typescript") {
        return "javascript";
    }
    return lang;
}

/// Draw the part [`from`, `to`) of a line of `subject` at screen row `y`:
/// cells whose display column is in [`left`, `left` + `text_width`).
/// What 'listchars' (default "tab:> ,trail:-,nbsp:+") draws.
type ListChars {
    pub str tab_first = "";
    pub str tab_fill = "";
    pub str tab_last = "";
    pub str trail = "";
    pub str lead = "";
    pub str space = "";
    pub str nbsp = "";
    pub str eol = "";
}

ListChars parse_listchars(str value) {
    ListChars out = ListChars();
    for (str part in value.split(",")) {
        int colon = part.index_of(":").or(-1);
        if (colon < 0) {
            continue;
        }
        str name = part.substr(0, colon);
        List<str> chars = [];
        for (int code_point in part.substr(colon + 1, part.size()).chars()) {
            chars.push(str.from_chars([code_point]));
        }
        if (chars.size() == 0) {
            continue;
        }
        if (name == "tab" && chars.size() >= 2) {
            out.tab_first = chars[0];
            out.tab_fill = chars[1];
            if (chars.size() >= 3) {
                out.tab_last = chars[2];
            }
        } else if (name == "trail") {
            out.trail = chars[0];
        } else if (name == "lead") {
            out.lead = chars[0];
        } else if (name == "space") {
            out.space = chars[0];
        } else if (name == "nbsp") {
            out.nbsp = chars[0];
        } else if (name == "eol") {
            out.eol = chars[0];
        }
    }
    return out;
}

/// Whether the display columns of colorcolumn include `spot` (a column list
/// of numbers and +N / -N relative to 'textwidth').
bool is_color_column(MED_editor.Editor subject, str columns, int spot) {
    if (columns.size() == 0) {
        return false;
    }
    for (str part in columns.split(",")) {
        str item = part.trim();
        int number = 0;
        if (item.starts_with("+") || item.starts_with("-")) {
            if (subject.textwidth <= 0) {
                continue;
            }
            int delta = item.substr(1, item.size()).parse_int().or(0);
            if (item.starts_with("-")) {
                delta = 0 - delta;
            }
            number = subject.textwidth + delta;
        } else {
            number = item.parse_int().or(0);
        }
        if (number > 0 && number - 1 == spot) {
            return true;
        }
    }
    return false;
}

// ------------------------------------------------------------------ file tree

const int TREE_MIN_SCREEN = 40;
const int TREE_STATUS_MS = 5000;

/// The text of `line` cut to `width` cells.
str clip_cells(str line, int width) {
    int used_cells = 0;
    for (int offset in MED_text.starts(line)) {
        if (offset >= line.size()) {
            break;
        }
        int cells = MED_text.cell_width(line, offset, used_cells, 4);
        if (used_cells + cells > width) {
            return line.substr(0, offset);
        }
        used_cells = used_cells + cells;
    }
    return line;
}

// ------------------------------------------------------------------ pickers

// -------------------------------------------------------------- leader keys

/// Whether the buffer has a lower-case mark (shown in the sign column).
bool has_marks(MED_editor.Editor shown) {
    for (int code in 97 .. 123) {
        if (shown.marks.get(str.from_chars([code])).is_some()) {
            return true;
        }
    }
    return false;
}

bool is_in_spans(List<int> spans, int offset) {
    int index = 0;
    while (index + 1 < spans.size()) {
        if (offset >= spans[index] && offset < spans[index + 1]) {
            return true;
        }
        index = index + 2;
    }
    return false;
}

int gutter_of(MED_editor.Editor shown) {
    bool is_number = shown.is_option_on("number", true);
    bool is_relative = shown.is_option_on("relativenumber", false);
    if (!is_number && !is_relative) {
        return shown.sign_columns;
    }
    int lines = shown.buffer.line_count();
    if (is_relative && !is_number) {
        lines = shown.view_height;
    }
    int digits = lines.to_str().size();
    int least = shown.option_number("numberwidth", 4) - 1;
    if (least < 1) {
        least = 1;
    }
    if (digits < least) {
        digits = least;
    }
    // never narrower than it has been: deleting down below 1000 lines keeps the column
    if (digits < shown.gutter_digits_floor) {
        digits = shown.gutter_digits_floor;
    }
    shown.gutter_digits_floor = digits;
    return digits + 1 + shown.sign_columns;
}

/// The line-number column for buffer line `row`, as wide as `gutter`.
str number_text(MED_editor.Editor shown, int row, int gutter) {
    bool is_number = shown.is_option_on("number", true);
    bool is_relative = shown.is_option_on("relativenumber", false);
    if (gutter - shown.sign_columns == 0) {
        return "";
    }
    int shown_number = row + 1;
    bool is_left = false;
    if (is_relative) {
        int distance = row - shown.row;
        if (distance < 0) {
            distance = 0 - distance;
        }
        if (is_number && distance == 0) {
            is_left = true;
        } else {
            shown_number = distance;
        }
    }
    int width = gutter - shown.sign_columns;
    if (width <= 0) {
        return "";
    }
    str digits = shown_number.to_str();
    if (is_left) {
        return digits + " ".repeat(width - digits.size());
    }
    return " ".repeat(width - 1 - digits.size()) + digits + " ";
}

/// Write `slot`'s text to `target` (its own file when `target` is empty) and
/// say what happened, in Vim's words.
str write_slot(Slot slot, str target) {
    if (slot.is_listing) {
        return "E382: Cannot write, 'buftype' option is set";
    }
    str name = target.trim();
    if (name.size() == 0) {
        name = slot.path;
    }
    if (name.size() == 0) {
        return "E32: No file name";
    }
    if (slot.editor.is_option_on("trimtrailing", false)) {
        MED_projconf.trim_trailing(slot.editor);
    }
    str text = slot.editor.buffer.dump();
    match (io.write(name, text)) {
        case Ok(int count): {
            if (slot.path.size() == 0) {
                slot.path = name;
                slot.editor.buffer.path = name;
            }
            if (name == slot.path) {
                slot.stamp = MED_persist.disk_stamp(name);
                slot.saved_current = slot.editor.current;
                slot.editor.saved_nodes.push(slot.editor.current);
                slot.editor.buffer.is_modified = false;
            }
            return "\"" + name + "\" " + slot.editor.buffer.line_count().to_str() + "L, " + count.to_str() + "B written";
        }
        case Err(io.Error error): {
            return "E212: Can't open file for writing: " + error.to_str();
        }
    }
}

/// Whether the buffer of `slot` differs from its file.
bool is_slot_modified(Slot slot) {
    if (slot.is_listing) {
        return false;
    }
    return slot.editor.current != slot.saved_current;
}

/// How `:ls` and the errors name a buffer.
str slot_name(Slot slot) {
    if (slot.title.size() > 0) {
        return slot.title;
    }
    if (slot.path.size() == 0) {
        return "[No Name]";
    }
    if (slot.is_listing && !slot.path.ends_with("/")) {
        return slot.path + "/";
    }
    return slot.path;
}

/// `directory` without a trailing slash (the root keeps its own).
str plain_directory(str directory) {
    str plain = directory;
    while (plain.size() > 1 && plain.ends_with("/")) {
        plain = plain.substr(0, plain.size() - 1);
    }
    return plain;
}

/// The last part of a path.
str base_name(str file) {
    int spot = last_slash(file);
    if (spot < 0) {
        return file;
    }
    return file.substr(spot + 1, file.size());
}

/// The text of a directory listing: `../`, then folders, then files.
str listing_text(str directory, bool is_hidden_shown) {
    List<str> lines = ["../"];
    for (str name in MED_files.list_directory(directory, is_hidden_shown)) {
        lines.push(name);
    }
    return lines.join("\n") + "\n";
}

/// A listing slot for `directory`, the cursor on the line `focus` (the first
/// entry when there is no such line).
Slot listing_slot(int id, str directory, str focus, bool is_hidden_shown) {
    MED_editor.Editor loaded = MED_editor.new(listing_text(directory, is_hidden_shown));
    loaded.buffer.path = directory;
    int row = 0;
    if (loaded.buffer.line_count() > 1) {
        row = 1;
    }
    for (int index in 0 .. loaded.buffer.line_count()) {
        if (focus.size() > 0 && loaded.buffer.line(index) == focus) {
            row = index;
        }
    }
    loaded.row = row;
    loaded.clamp();
    loaded.want_from_cursor();
    return Slot(id, loaded, directory, is_listing: true);
}

/// What the engine keeps across buffers: registers, search and substitute
/// state, the dot command, histories and the options.
void share_state(MED_editor.Editor from, MED_editor.Editor into) {
    into.regs = from.regs;
    into.search_pattern = from.search_pattern;
    into.search_directory = from.search_directory;
    into.sub_pattern = from.sub_pattern;
    into.sub_replacement = from.sub_replacement;
    into.sub_flags = from.sub_flags;
    into.sub_old = from.sub_old;
    into.is_sub_has = from.is_sub_has;
    into.is_last_is_sub = from.is_last_is_sub;
    into.is_search_no_scs = from.is_search_no_scs;
    into.is_search_off_line = from.is_search_off_line;
    into.is_search_off_end = from.is_search_off_end;
    into.search_off = from.search_off;
    into.search_typed = from.search_typed;
    into.is_no_hl = from.is_no_hl;
    into.hist_ex = from.hist_ex;
    into.hist_search = from.hist_search;
    into.last_macro = from.last_macro;
    into.dot = from.dot;
    into.dot_reg = from.dot_reg;
    into.dot_count = from.dot_count;
    into.dot_body = from.dot_body;
    into.dot_tail = from.dot_tail;
    into.dot_vkind = from.dot_vkind;
    into.dot_vlines = from.dot_vlines;
    into.dot_vcols = from.dot_vcols;
    into.dot_vwant = from.dot_vwant;
    into.find = from.find;
    into.is_hexupper = from.is_hexupper;
    into.tab = from.tab;
    into.snippets = from.snippets;
    into.shiftwidth = from.shiftwidth;
    into.textwidth = from.textwidth;
    into.view_width = from.view_width;
    into.commentstring = from.commentstring;
    into.is_expandtab = from.is_expandtab;
    into.is_autoindent = from.is_autoindent;
    into.is_ignorecase = from.is_ignorecase;
    into.is_smartcase = from.is_smartcase;
    into.is_wrapscan = from.is_wrapscan;
    into.is_joinspaces = from.is_joinspaces;
    into.is_startofline = from.is_startofline;
    into.softtabstop = from.softtabstop;
    into.is_smarttab = from.is_smarttab;
    into.is_shiftround = from.is_shiftround;
    for (str name in from.opts.keys()) {
        into.opts.set(name, from.opts.get(name).or(""));
    }
    into.scroll_opt = from.scroll_opt;
    into.view_height = from.view_height;
    into.maps = from.maps;
}

/// Vim's "file info" message for a buffer just read.
str file_note(str name, MED_editor.Editor loaded) {
    if (name.size() == 0) {
        return "";
    }
    if (fs.is_present(name)) {
        return "\"" + name + "\" " + loaded.buffer.line_count().to_str() + "L, " + loaded.buffer.dump().size().to_str() + "B";
    }
    return "\"" + name + "\" [New]";
}

/// A new slot holding `name` (an empty buffer when the file does not exist yet
/// or `name` is empty); an error for a directory or an unreadable file.
Result<Slot, str> read_slot(int id, str name) {
    str text = "";
    if (name.size() > 0) {
        if (fs.is_directory(name)) {
            return Result<Slot, str>.Err("\"" + name + "\" is a directory");
        }
        if (fs.is_present(name)) {
            match (io.read(name)) {
                case Ok(str content): {
                    text = content;
                }
                case Err(io.Error error): {
                    return Result<Slot, str>.Err("\"" + name + "\": " + error.to_str());
                }
            }
        }
    }
    MED_editor.Editor loaded = MED_editor.new(text);
    loaded.buffer.path = name;
    loaded.commentstring = comment_for(name);
    Slot made = Slot(id, loaded, name);
    made.stamp = MED_persist.disk_stamp(name);
    return Result<Slot, str>.Ok(made);
}

/// The 'commentstring' for a file name ("" when the language is unknown or
/// has no comments): the `syntax` library's comment forms for what
/// `SYN_detect` makes of the name.
pub str comment_for(str name) {
    str lang = SYN_detect.language_of(name, "");
    if (lang == "" || (lang == "markdown" && !name.contains("."))) {
        // no language, or an extensionless README: not worth a comment form
        return "";
    }
    List<str> forms = SYN_structure.comment_forms(lang);
    if (forms[0] != "") {
        return forms[0] + "%s";
    }
    if (forms[1] != "") {
        return forms[1] + " %s " + forms[2];
    }
    return "";
}

// -------------------------------------------------------------- keymap file

str expand_home(str path) {
    if (path == "~" || path.starts_with("~/")) {
        match (os.env("HOME")) {
            case Some(str home): {
                return home + path.substr(1, path.size());
            }
            case None: {
                return path;
            }
        }
    }
    return path;
}

/// Where the keymap file is: $M3_KEYMAP, else $XDG_CONFIG_HOME/m3/keymap.vim,
/// else ~/.config/m3/keymap.vim. When that file is absent and the pre-0.1.0
/// directory (`m3d1tor`, same parent) has one, that file is read instead.
pub str keymap_path() {
    match (os.env("M3_KEYMAP")) {
        case Some(str given): {
            return given;
        }
        case None: {
        }
    }
    str current = keymap_default_path();
    if (current.size() > 0 && !fs.is_file(current)) {
        str legacy = current.substr(0, current.size() - "/m3/keymap.vim".size()) + "/m3d1tor/keymap.vim";
        if (fs.is_file(legacy)) {
            return legacy;
        }
    }
    return current;
}

str keymap_default_path() {
    match (os.env("XDG_CONFIG_HOME")) {
        case Some(str base): {
            if (base.size() > 0) {
                return base + "/m3/keymap.vim";
            }
        }
        case None: {
        }
    }
    match (os.env("HOME")) {
        case Some(str home): {
            return home + "/.config/m3/keymap.vim";
        }
        case None: {
            return "";
        }
    }
}

/// Split "name arg" into its two parts.
List<str> split_request(str request) {
    match (request.index_of(" ")) {
        case Some(int position): {
            return [request.substr(0, position), request.substr(position + 1, request.size())];
        }
        case None: {
            return [request, ""];
        }
    }
}

/// Open `path` (a new empty buffer when the file does not exist; an empty path
/// is a buffer with no name).
pub Result<App, str> open(str path) {
    return open_all([path]);
}

/// Open several files as buffers; the first is shown.
pub Result<App, str> open_all(List<str> paths) {
    App app = App(MED_editor.new(""), "");
    app.next_id = 1;
    bool is_first = true;
    for (str path in paths) {
        match (read_slot(app.next_id, path)) {
            case Ok(Slot slot): {
                if (is_first) {
                    app.slots.push(slot);
                    app.wins.push(MED_window.Win(1, slot.id));
                    app.current_id = slot.id;
                    app.editor = slot.editor;
                    app.path = path;
                    app.next_id = slot.id + 1;
                    app.notice = file_note(path, slot.editor);
                    is_first = false;
                } else {
                    slot.editor.view_height = app.editor.view_height;
                    app.slots.push(slot);
                    app.next_id = slot.id + 1;
                }
            }
            case Err(str message): {
                return Result<App, str>.Err(message);
            }
        }
    }
    if (is_first) {
        return Result<App, str>.Err("no buffer");
    }
    app.did_use_theme(MED_theme.DARK);
    return Result<App, str>.Ok(app);
}

