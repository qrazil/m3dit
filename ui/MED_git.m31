// The git gutter: where the buffer differs from HEAD.
//
// API
// ---
//   MED_git.head_lines(path)       Option<List<str>>: the file as HEAD has it, None when untracked or no repo
//   MED_git.diff(base, current)    Hunks: a sign per buffer row and where each hunk starts
//
// `kinds[row]` is NONE, ADDED, CHANGED, or REMOVED (lines were removed just
// below this row; row 0 also stands for removals above the first line).
// The text in between is compared with a longest common subsequence after the
// common head and tail are cut off; a middle too big for that counts as one
// changed block.

import fs;
import io;
import engine.MED_shell;
import ui.MED_gitlib;

pub const int NONE = 0;
pub const int ADDED = 1;
pub const int CHANGED = 2;
pub const int REMOVED = 3;
/// Rows times lines compared in the middle part before giving up on an exact diff.
const int CELL_LIMIT = 4000000;

pub type Hunks {
    pub List<int> kinds = [];
    /// The first row of every hunk, ascending.
    pub List<int> starts = [];
    /// Per hunk: where its new lines start in the buffer, how many there are,
    /// and where its old lines start in the base and how many there are.
    pub List<int> froms = [];
    pub List<int> counts = [];
    pub List<int> base_froms = [];
    pub List<int> base_counts = [];
}

/// The directory and the file name of `path`.
pub str directory_of(str path) {
    int slash = -1;
    for (int index in 0 .. path.size()) {
        if (path.byte_at(index) == 47) {
            slash = index;
        }
    }
    if (slash < 0) {
        return ".";
    }
    if (slash == 0) {
        return "/";
    }
    return path.substr(0, slash);
}

pub str name_of(str path) {
    int slash = -1;
    for (int index in 0 .. path.size()) {
        if (path.byte_at(index) == 47) {
            slash = index;
        }
    }
    return path.substr(slash + 1, path.size());
}

/// The file as the index has it (what the working tree is compared with), or
/// as the last commit has it when the index has no entry. None when git is
/// missing, the directory is no repository or the file is untracked. Read in
/// process through the m31git library; a repository the library cannot read
/// (a version 4 index, a missing object of a partial clone) goes to `git`.
pub Option<List<str>> head_lines(str path) {
    str directory = directory_of(path);
    str name = name_of(path);
    match (MED_gitlib.base_of(directory, name)) {
        case Lines(List<str> lines): {
            return Option<List<str>>.Some(lines);
        }
        case Untracked: {
            return Option<List<str>>.None;
        }
        case Failed: {
        }
    }
    match (MED_shell.output(["git", "-C", directory, "show", ":./" + name], "")) {
        case Some(str text): {
            return Option<List<str>>.Some(MED_shell.split_lines(text));
        }
        case None: {
        }
    }
    match (MED_shell.output(["git", "-C", directory, "show", "HEAD:./" + name], "")) {
        case Some(str text): {
            return Option<List<str>>.Some(MED_shell.split_lines(text));
        }
        case None: {
            return Option<List<str>>.None;
        }
    }
}

/// The branch HEAD names, read from `.git/HEAD` (no process), looking in
/// `directory` and its parents; "" outside a repository. A detached HEAD is
/// the first eight characters of the commit.
pub str branch_of(str directory) {
    str current = directory;
    if (current.size() == 0) {
        current = ".";
    }
    match (fs.realpath(current)) {
        case Ok(str real): {
            current = real;
        }
        case Err(io.Error error): {
            return "";
        }
    }
    int guard = 0;
    while (guard < 64) {
        guard = guard + 1;
        str head = current + "/.git/HEAD";
        if (fs.is_file(head)) {
            match (io.read(head)) {
                case Ok(str text): {
                    str line = text.trim();
                    if (line.starts_with("ref: refs/heads/")) {
                        return line.substr(16, line.size());
                    }
                    if (line.starts_with("ref: ")) {
                        return line.substr(5, line.size());
                    }
                    if (line.size() >= 8) {
                        return line.substr(0, 8);
                    }
                    return "";
                }
                case Err(io.Error error): {
                    return "";
                }
            }
        }
        if (fs.is_file(current + "/.git")) {
            // a worktree or submodule: `gitdir: PATH`
            match (io.read(current + "/.git")) {
                case Ok(str text): {
                    str line = text.trim();
                    if (line.starts_with("gitdir: ")) {
                        str gitdir = line.substr(8, line.size());
                        if (!gitdir.starts_with("/")) {
                            gitdir = current + "/" + gitdir;
                        }
                        match (io.read(gitdir + "/HEAD")) {
                            case Ok(str inner): {
                                str ref = inner.trim();
                                if (ref.starts_with("ref: refs/heads/")) {
                                    return ref.substr(16, ref.size());
                                }
                                if (ref.size() >= 8) {
                                    return ref.substr(0, 8);
                                }
                            }
                            case Err(io.Error error): {
                            }
                        }
                    }
                }
                case Err(io.Error error): {
                }
            }
            return "";
        }
        if (current == "/") {
            return "";
        }
        int slash = -1;
        for (int index in 0 .. current.size()) {
            if (current.byte_at(index) == 47) {
                slash = index;
            }
        }
        if (slash < 0) {
            return "";
        }
        if (slash == 0) {
            current = "/";
        } else {
            current = current.substr(0, slash);
        }
    }
    return "";
}

/// How much a status letter matters when a folder shows the worst of its files.
pub int status_rank(str letter) {
    if (letter == "!") {
        return 5;
    }
    if (letter == "D") {
        return 4;
    }
    if (letter == "M" || letter == "R") {
        return 3;
    }
    if (letter == "A") {
        return 2;
    }
    if (letter == "?") {
        return 1;
    }
    return 0;
}

/// The status of every changed path below `directory`, keyed by the path
/// relative to it (`git status --porcelain`): M modified, A added, D deleted,
/// R renamed, ? untracked, ! conflicted. Folders carry the worst status of
/// what is inside them. Empty outside a repository.
pub Map<str, str> status_map(str directory) {
    Map<str, str> found = {};
    str text = "";
    match (MED_shell.output(["sh", "-c", "git rev-parse --show-prefix && git status --porcelain=v1 --untracked-files=all"], directory)) {
        case Some(str content): {
            text = content;
        }
        case None: {
            return found;
        }
    }
    List<str> lines = text.split("\n");
    if (lines.size() < 1) {
        return found;
    }
    str prefix = lines[0];
    for (int index in 1 .. lines.size()) {
        str line = lines[index];
        if (line.size() < 4) {
            continue;
        }
        str index_letter = line.substr(0, 1);
        str tree_letter = line.substr(1, 2);
        str name = line.substr(3, line.size());
        int arrow = name.index_of(" -> ").or(-1);
        if (arrow >= 0) {
            name = name.substr(arrow + 4, name.size());
        }
        if (name.starts_with("\"") && name.ends_with("\"") && name.size() >= 2) {
            name = name.substr(1, name.size() - 1);
        }
        str letter = tree_letter;
        if (letter == " ") {
            letter = index_letter;
        }
        if (index_letter == "U" || tree_letter == "U" || (index_letter == "A" && tree_letter == "A") || (index_letter == "D" && tree_letter == "D")) {
            letter = "!";
        }
        if (letter == "C" || letter == "T") {
            letter = "M";
        }
        if (prefix.size() > 0) {
            if (!name.starts_with(prefix)) {
                continue;
            }
            name = name.substr(prefix.size(), name.size());
        }
        // the file and every folder above it
        str walked = name;
        while (true) {
            str old = found.get(walked).or("");
            if (status_rank(letter) > status_rank(old)) {
                found.set(walked, letter);
            }
            int slash = -1;
            for (int offset in 0 .. walked.size()) {
                if (walked.byte_at(offset) == 47) {
                    slash = offset;
                }
            }
            if (slash < 0) {
                break;
            }
            walked = walked.substr(0, slash);
        }
    }
    return found;
}

// Mark the rows [from, to) of `kinds` and say where the hunk starts.
void note_hunk(Hunks hunks, int from, int removed, int added, int base_from) {
    hunks.froms.push(from);
    hunks.counts.push(added);
    hunks.base_froms.push(base_from);
    hunks.base_counts.push(removed);
    if (added == 0) {
        // lines went away: the sign sits on the row above the gap
        int row = from - 1;
        if (row < 0) {
            row = 0;
        }
        if (row < hunks.kinds.size() && hunks.kinds[row] == NONE) {
            hunks.kinds[row] = REMOVED;
        }
        hunks.starts.push(row);
        return;
    }
    for (int offset in 0 .. added) {
        int row = from + offset;
        if (row < hunks.kinds.size()) {
            if (offset < removed) {
                hunks.kinds[row] = CHANGED;
            } else {
                hunks.kinds[row] = ADDED;
            }
        }
    }
    hunks.starts.push(from);
}

/// The differences between `base` (HEAD) and `current`.
pub Hunks diff(List<str> base, List<str> current) {
    Hunks hunks = Hunks();
    for (int row in 0 .. current.size()) {
        hunks.kinds.push(NONE);
    }
    int head = 0;
    while (head < base.size() && head < current.size() && base[head] == current[head]) {
        head = head + 1;
    }
    int tail = 0;
    while (tail < base.size() - head && tail < current.size() - head && base[base.size() - 1 - tail] == current[current.size() - 1 - tail]) {
        tail = tail + 1;
    }
    int base_count = base.size() - head - tail;
    int current_count = current.size() - head - tail;
    if (base_count == 0 && current_count == 0) {
        return hunks;
    }
    if (base_count == 0 || current_count == 0 || base_count * current_count > CELL_LIMIT) {
        note_hunk(hunks, head, base_count, current_count, head);
        return hunks;
    }
    // lengths[row_at][col_at]: the longest common subsequence of base[head+row_at ..] and current[head+col_at ..]
    List<List<int>> lengths = [];
    for (int row_at in 0 .. base_count + 1) {
        List<int> line = [];
        for (int col_at in 0 .. current_count + 1) {
            line.push(0);
        }
        lengths.push(line);
    }
    int row_at = base_count - 1;
    while (row_at >= 0) {
        int col_at = current_count - 1;
        while (col_at >= 0) {
            if (base[head + row_at] == current[head + col_at]) {
                lengths[row_at][col_at] = lengths[row_at + 1][col_at + 1] + 1;
            } else if (lengths[row_at + 1][col_at] >= lengths[row_at][col_at + 1]) {
                lengths[row_at][col_at] = lengths[row_at + 1][col_at];
            } else {
                lengths[row_at][col_at] = lengths[row_at][col_at + 1];
            }
            col_at = col_at - 1;
        }
        row_at = row_at - 1;
    }
    int base_at = 0;
    int current_at = 0;
    int removed = 0;
    int added = 0;
    int hunk_row = head;
    int hunk_base = head;
    while (base_at < base_count || current_at < current_count) {
        bool is_same = base_at < base_count && current_at < current_count && base[head + base_at] == current[head + current_at];
        if (is_same) {
            if (removed > 0 || added > 0) {
                note_hunk(hunks, hunk_row, removed, added, hunk_base);
                removed = 0;
                added = 0;
            }
            base_at = base_at + 1;
            current_at = current_at + 1;
            hunk_row = head + current_at;
            continue;
        }
        if (current_at < current_count && (base_at >= base_count || lengths[base_at][current_at + 1] >= lengths[base_at + 1][current_at])) {
            if (removed == 0 && added == 0) {
                hunk_row = head + current_at;
                hunk_base = head + base_at;
            }
            added = added + 1;
            current_at = current_at + 1;
        } else {
            if (removed == 0 && added == 0) {
                hunk_row = head + current_at;
                hunk_base = head + base_at;
            }
            removed = removed + 1;
            base_at = base_at + 1;
        }
    }
    if (removed > 0 || added > 0) {
        note_hunk(hunks, hunk_row, removed, added, hunk_base);
    }
    return hunks;
}

/// The first hunk start after `row` (or the last one before it, for
/// `is_forward` false); -1 when there is none.
pub int next_start(Hunks hunks, int row, bool is_forward) {
    if (is_forward) {
        for (int start in hunks.starts) {
            if (start > row) {
                return start;
            }
        }
        return -1;
    }
    int found = -1;
    for (int start in hunks.starts) {
        if (start < row) {
            found = start;
        }
    }
    return found;
}

/// The index of the hunk that contains buffer `row` (a removal hunk is the row
/// above the gap and the row below it), or -1.
pub int hunk_at(Hunks hunks, int row) {
    for (int index in 0 .. hunks.froms.size()) {
        int from = hunks.froms[index];
        int count = hunks.counts[index];
        if (count == 0) {
            if (row == from || row == from - 1) {
                return index;
            }
        } else if (row >= from && row < from + count) {
            return index;
        }
    }
    return -1;
}

/// A zero-context unified diff of hunk `index` against `base`, for `git apply
/// --cached --unidiff-zero` (stage) with `relative` the path from the
/// repository root. `current` is the buffer.
pub str hunk_patch(Hunks hunks, int index, List<str> base, List<str> current, str relative) {
    int base_from = hunks.base_froms[index];
    int base_count = hunks.base_counts[index];
    int from = hunks.froms[index];
    int count = hunks.counts[index];
    str old_start = (base_from + 1).to_str();
    if (base_count == 0) {
        old_start = base_from.to_str();
    }
    str new_start = (from + 1).to_str();
    if (count == 0) {
        new_start = from.to_str();
    }
    List<str> out = ["--- a/" + relative, "+++ b/" + relative, "@@ -" + old_start + "," + base_count.to_str() + " +" + new_start + "," + count.to_str() + " @@"];
    for (int offset in 0 .. base_count) {
        out.push("-" + base[base_from + offset]);
    }
    for (int offset in 0 .. count) {
        out.push("+" + current[from + offset]);
    }
    return out.join("\n") + "\n";
}

/// The hunk as diff lines for a preview.
pub List<str> hunk_preview(Hunks hunks, int index, List<str> base, List<str> current) {
    int base_from = hunks.base_froms[index];
    int base_count = hunks.base_counts[index];
    int from = hunks.froms[index];
    int count = hunks.counts[index];
    List<str> out = ["@@ -" + (base_from + 1).to_str() + "," + base_count.to_str() + " +" + (from + 1).to_str() + "," + count.to_str() + " @@"];
    for (int offset in 0 .. base_count) {
        out.push("-" + base[base_from + offset]);
    }
    for (int offset in 0 .. count) {
        out.push("+" + current[from + offset]);
    }
    return out;
}

/// The row of HEAD's file that buffer row `row` is, given the hunks of the buffer against HEAD; -1 for a row
/// the buffer added or changed.
pub int head_row_of(Hunks hunks, int row) {
    int shift = 0;
    for (int index in 0 .. hunks.froms.size()) {
        int from = hunks.froms[index];
        int count = hunks.counts[index];
        if (count > 0 && row >= from && row < from + count) {
            return -1;
        }
        bool is_before = from + count <= row;
        if (count == 0) {
            is_before = from <= row;
        }
        if (is_before) {
            shift = shift + count - hunks.base_counts[index];
        }
    }
    return row - shift;
}

/// `git blame` of buffer row `row`, in process: `^abcdef01 (Author 3 days ago 12) text`, or "Not committed yet"
/// for a row the buffer changed. None when the library cannot answer (the caller then runs `git blame`).
pub Option<str> blame_row(str path, List<str> buffer, int row) {
    str directory = directory_of(path);
    str name = name_of(path);
    List<str> head = [];
    match (MED_gitlib.head_lines_of(directory, name)) {
        case Lines(List<str> lines): {
            head = lines;
        }
        case Untracked: {
            return Option<str>.Some("Not committed yet");
        }
        case Failed: {
            return Option<str>.None;
        }
    }
    int position = head_row_of(diff(head, buffer), row);
    if (position < 0) {
        return Option<str>.Some("Not committed yet");
    }
    match (MED_gitlib.blame_of(directory, name)) {
        case Some(List<MED_gitlib.BlameLine> lines): {
            if (position >= lines.size() || lines.size() != head.size()) {
                return Option<str>.None;
            }
            return Option<str>.Some(MED_gitlib.blame_text(lines[position], position + 1));
        }
        case None: {
            return Option<str>.None;
        }
    }
}

// ---- hunk operations on bytes (stage, unstage), used with the library or for tests ----

/// The index of the hunk whose lines in the BASE contain `row` (a hunk that only adds lines to the other
/// side counts for the row above and below its gap); -1 when none.
pub int hunk_at_base(Hunks hunks, int row) {
    for (int index in 0 .. hunks.base_froms.size()) {
        int from = hunks.base_froms[index];
        int count = hunks.base_counts[index];
        if (count == 0) {
            if (row == from || row == from - 1) {
                return index;
            }
        } else if (row >= from && row < from + count) {
            return index;
        }
    }
    return -1;
}

/// `target` (the lines of a file, each with its terminator) with the base lines of hunk `index` replaced by the
/// hunk's lines in `source`. `hunks` compares `target` as base with `source` as current. A final line that
/// `target` had without a terminator stays without one when the hunk reaches the end.
pub bytes take_hunk(Hunks hunks, int index, List<bytes> target, List<bytes> source) {
    int base_from = hunks.base_froms[index];
    int base_count = hunks.base_counts[index];
    int from = hunks.froms[index];
    int count = hunks.counts[index];
    bytes out = [];
    for (int position in 0 .. base_from) {
        out.extend(target[position]);
    }
    for (int offset in 0 .. count) {
        out.extend(source[from + offset]);
    }
    for (int position in base_from + base_count .. target.size()) {
        out.extend(target[position]);
    }
    return out;
}

/// `lines` (the buffer, no terminators) as bytes with "\n" ended lines, the last one left bare when
/// `is_last_bare`.
pub List<bytes> ended_lines(List<str> lines, bool is_last_bare) {
    List<bytes> out = [];
    for (int position in 0 .. lines.size()) {
        if (is_last_bare && position == lines.size() - 1) {
            out.push(lines[position].to_bytes());
        } else {
            out.push((lines[position] + "\n").to_bytes());
        }
    }
    return out;
}

/// The lines of `content` with their terminators, and the same without them.
pub List<bytes> split_ended(bytes content) {
    return MED_gitlib.split_ended(content);
}

/// Is the last line of `lines` one without a terminator?
pub bool is_last_bare(List<bytes> lines) {
    if (lines.size() == 0) {
        return false;
    }
    bytes last = lines[lines.size() - 1];
    return last.size() == 0 || last[last.size() - 1] != 10;
}

/// The index content after staging hunk `index` of `hunks` (index lines to buffer lines).
pub bytes staged_content(Hunks hunks, int index, bytes index_bytes, List<str> buffer) {
    List<bytes> target = split_ended(index_bytes);
    bool is_bare = is_last_bare(target) && hunks.base_froms[index] + hunks.base_counts[index] == target.size();
    if (is_bare && hunks.base_counts[index] == 0 && hunks.counts[index] > 0) {
        // lines appended after a last line that had no terminator: it needs one now
        target[target.size() - 1].push(10);
    }
    return take_hunk(hunks, index, target, ended_lines(buffer, is_bare));
}

/// The index content after unstaging one hunk: `hunks` compares the index (base) with HEAD (current), and
/// the hunk's lines come from HEAD's bytes.
pub bytes unstaged_content(Hunks hunks, int index, bytes index_bytes, bytes head_bytes) {
    return take_hunk(hunks, index, split_ended(index_bytes), split_ended(head_bytes));
}

/// The index row that buffer row `row` is, given the hunks of the buffer against the index; -1 for a row inside
/// an added or changed block (it has no index row of its own).
pub int index_row_of(Hunks hunks, int row) {
    int shift = 0;
    for (int index in 0 .. hunks.froms.size()) {
        int from = hunks.froms[index];
        int count = hunks.counts[index];
        if (count > 0 && row >= from && row < from + count) {
            return -1;
        }
        bool is_before = from + count <= row;
        if (count == 0) {
            is_before = from <= row;
        }
        if (is_before) {
            shift = shift + hunks.base_counts[index] - count;
        }
    }
    return row + shift;
}

/// Stage hunk `index` of `hunks` (the buffer against the index) in process: "" when done, "!" when the library
/// cannot (the caller runs `git apply`), else why it failed.
pub str stage_hunk(str path, Hunks hunks, int index, List<str> buffer) {
    str directory = directory_of(path);
    match (MED_gitlib.open(directory)) {
        case Some(MED_gitlib.Repo repo): {
            str relative = MED_gitlib.relative_to(repo, directory, name_of(path));
            match (MED_gitlib.index_bytes(repo, relative)) {
                case Some(bytes content): {
                    return MED_gitlib.stage_content(repo, relative, staged_content(hunks, index, content, buffer));
                }
                case None: {
                    return "!";
                }
            }
        }
        case None: {
            return "!";
        }
    }
}

/// Unstage the staged hunk that buffer row `row` is in (`unstaged`: the buffer against the index), in process:
/// "" when done, "!" when the library cannot, else why not.
pub str unstage_hunk_at(str path, Hunks unstaged, int row) {
    str directory = directory_of(path);
    match (MED_gitlib.open(directory)) {
        case Some(MED_gitlib.Repo repo): {
            str relative = MED_gitlib.relative_to(repo, directory, name_of(path));
            int position = index_row_of(unstaged, row);
            if (position < 0) {
                return "No staged hunk at the cursor";
            }
            Option<bytes> staged = MED_gitlib.index_bytes(repo, relative);
            bytes head = [];
            match (MED_gitlib.head_bytes(repo, relative)) {
                case Some(bytes found): {
                    head = found;
                }
                case None: {
                    return "!";
                }
            }
            match (staged) {
                case Some(bytes content): {
                    str index_text = "";
                    str head_text = "";
                    match (content.utf8()) {
                        case Some(str text): {
                            index_text = text;
                        }
                        case None: {
                            return "!";
                        }
                    }
                    match (head.utf8()) {
                        case Some(str text): {
                            head_text = text;
                        }
                        case None: {
                            return "!";
                        }
                    }
                    Hunks against = diff(MED_shell.split_lines(index_text), MED_shell.split_lines(head_text));
                    int index = hunk_at_base(against, position);
                    if (index < 0) {
                        return "No staged hunk at the cursor";
                    }
                    return MED_gitlib.stage_content(repo, relative, unstaged_content(against, index, content, head));
                }
                case None: {
                    return "!";
                }
            }
        }
        case None: {
            return "!";
        }
    }
}

/// The hunks as pairs (first row, row count) in the buffer, for the `ih` / `ah` text objects.
pub List<int> spans(Hunks hunks) {
    List<int> out = [];
    for (int index in 0 .. hunks.froms.size()) {
        out.push(hunks.froms[index]);
        out.push(hunks.counts[index]);
    }
    return out;
}

/// `git show REV` for the preview and `git:show`: through the library, else `git`. Empty when neither can.
pub List<str> show_lines(str directory, str rev) {
    match (MED_gitlib.show_lines(directory, rev)) {
        case Some(List<str> lines): {
            return lines;
        }
        case None: {
        }
    }
    return MED_shell.lines(["git", "show", "--no-color", "--stat", "--patch", rev], directory).or([]);
}
