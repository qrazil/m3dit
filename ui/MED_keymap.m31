// The front end's keymap as data: leader sequences, the prefix help of g z [ ]
// and CTRL-W, the command palette and the `?` help are all built from the same
// rows, and docs/KEYMAP.md is generated from them (scripts/gen_keymap.sh), so
// the documentation cannot drift from what the keys do.
//
// A row is a `Binding`:
//   keys     the keys after <Space> for a leader row, the whole sequence for a
//            prefix row ("" for a palette command that has no key)
//   label    what which-key, the palette and the help show
//   action   `picker:NAME` opens a picker, `ex:LINE` runs an ex line,
//            `keys:NOTATION` feeds keys to the editor, `app:NAME` is a front-end
//            action, `""` marks a group (a prefix such as `f`) or a note
//   plugin   the built-in plugin that owns the row (MED_plugin); rows of a
//            disabled plugin are not shown or run
//   mode     "n" Normal, "x" Visual, "i" Insert
//   source   "vim" a Vim/nvim default (the engine is checked against nvim),
//            "config" mirrors the owner's nvim config, "m3" a built-in extra
//
// A group row only names a prefix: `("f", "+find", "")`. Everything else is a
// leaf. `lookup` says whether what was typed is a leaf, a prefix of more keys,
// or nothing.

import tui.widgets.TUI_menu;
import ui.MED_plugin;

pub type Binding {
    pub str keys;
    pub str label;
    pub str action;
    pub str plugin = "core";
    pub str mode = "n";
    pub str source = "m3";
    /// `keys` is the whole sequence, not relative to <Space>.
    pub bool is_full = false;
}

/// How long (ms) a pending sequence waits before which-key shows.
pub const int WHICH_KEY_MS = 400;
pub const int NO_BINDING = 0;
pub const int IS_PREFIX = 1;
pub const int IS_LEAF = 2;

Binding leaf_row(str source, str plugin, str keys, str label, str action) {
    return Binding(keys, label, action, plugin: plugin, source: source);
}

Binding visual_row(str source, str plugin, str keys, str label, str action) {
    return Binding(keys, label, action, plugin: plugin, mode: "x", source: source);
}

