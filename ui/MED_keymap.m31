    return [Binding("", "Write file", "ex:write"), Binding("", "Write all buffers", "ex:wall"), Binding("", "Write and quit", "ex:wq"), Binding("", "Quit without saving", "ex:quit!"), Binding("", "New empty buffer", "ex:enew"), Binding("", "Undo", "ex:undo"), Binding("", "Redo", "ex:redo"), Binding("", "Show line numbers", "ex:set number"), Binding("", "Hide line numbers", "ex:set nonumber"), Binding("", "Clear search highlight", "ex:nohlsearch"), Binding("", "Reload the file", "ex:edit!"), Binding("", "Sort lines", "ex:sort"), Binding("", "First buffer", "ex:bfirst"), Binding("", "Last buffer", "ex:blast"), Binding("", "New window", "ex:new"), Binding("", "New window on the right", "ex:vnew"), Binding("", "List the built-in plugins", "ex:Plugins"), Binding("", "Pick a colour scheme (theme)", "picker:themes"), Binding("", "Browse every key", "ex:Keys"), Binding("", "Open the quickfix list", "picker:quickfix"), Binding("", "Open a terminal", "ex:terminal")];
}

// One prefix row as text: "SEQUENCE|label". A control key is spelled `^W` and
// is a single character in the sequence.
List<Binding> prefix_data(str plugin, str source, List<str> specs) {
    List<Binding> rows = [];
    for (str spec in specs) {
        int bar = spec.index_of(" :: ").or(spec.size());
        str keys = spec.substr(0, bar).split("^W").join(str.from_chars([23]));
        str label = spec.substr(bar + 4, spec.size());
        rows.push(Binding(keys, label, "", plugin: plugin, source: source, is_full: true));
    }
    return rows;
}

/// The help of the multi-key prefixes of Normal mode: g, z, [, ], CTRL-W and
/// the register / mark prefixes. The engine does the work; these rows only say
/// what each next key is, for which-key and `:Keys`.
pub List<Binding> prefixes() {
    List<Binding> rows = [];
    for (Binding row in prefix_data("core", "vim", ["g :: +goto", "gg :: first line", "ge :: back to end of word", "gE :: back to end of WORD", "gi :: insert where insert stopped", "gI :: insert at column 1", "gJ :: join lines without a space", "gj :: down a screen line", "gk :: up a screen line", "g0 :: start of screen line", "g^ :: first non-blank of screen line", "g$ :: end of screen line", "gm :: middle of screen line", "gM :: middle of the text line", "go :: go to byte", "gp :: put after, cursor after", "gP :: put before, cursor after", "gq :: format lines", "gw :: format, keep cursor", "gu :: lowercase", "gU :: uppercase", "g~ :: swap case", "g? :: rot13", "gv :: reselect visual", "g; :: older change position", "g, :: newer change position", "ga :: ascii of character", "g8 :: utf-8 bytes of character", "gf :: edit file under cursor", "gn :: search match as selection", "gN :: previous match as selection", "g& :: repeat :s on all lines", "g_ :: last non-blank", "g- :: older text state", "g+ :: newer text state", "g* :: search word, no boundaries", "g# :: search word backwards, no boundaries", "gR :: virtual replace mode", "gs :: sleep"])) {
        rows.push(row);
    }
    for (Binding row in prefix_data("comment", "vim", ["gc :: +comment (gc{motion}, gcc)", "gcc :: toggle comment on the line"])) {
        rows.push(row);
    }
    for (Binding row in prefix_data("core", "vim", ["z :: +view and folds", "zt :: cursor line at top", "zz :: cursor line at middle", "zb :: cursor line at bottom", "z<CR> :: top, first non-blank", "z. :: middle, first non-blank", "z- :: bottom, first non-blank", "zh :: scroll right", "zl :: scroll left", "zH :: scroll half screen right", "zL :: scroll half screen left", "zs :: cursor to left edge", "ze :: cursor to right edge", "zf :: create fold", "zF :: fold lines", "zo :: open fold", "zO :: open folds recursively", "zc :: close fold", "zC :: close folds recursively", "za :: toggle fold", "zA :: toggle fold recursively", "zv :: open folds at cursor", "zR :: open all folds", "zM :: close all folds", "zd :: delete fold", "zD :: delete folds recursively", "zE :: eliminate all folds", "zj :: next fold", "zk :: previous fold end", "zn :: folds off", "zN :: folds on", "zi :: toggle fold enable"])) {
        rows.push(row);
    }
    for (Binding row in prefix_data("core", "vim", ["[ :: +previous", "] :: +next", "[[ :: previous section start", "]] :: next section start", "[] :: previous section end", "][ :: next section end", "[{ :: previous unmatched {", "]} :: next unmatched }", "[( :: previous unmatched (", "]) :: next unmatched )", "[' :: previous mark line", "]' :: next mark line", "[` :: previous mark", "]` :: next mark", "[<Space> :: add blank line above", "]<Space> :: add blank line below"])) {
        rows.push(row);
    }
    for (Binding row in prefix_data("bracketed", "m3", ["[b :: previous buffer", "]b :: next buffer", "[B :: first buffer", "]B :: last buffer", "[q :: previous quickfix entry", "]q :: next quickfix entry", "[Q :: first quickfix entry", "]Q :: last quickfix entry", "[t :: previous TODO comment", "]t :: next TODO comment", "[h :: previous git hunk", "]h :: next git hunk", "[c :: previous git change", "]c :: next git change", "[d :: previous diagnostic", "]d :: next diagnostic"])) {
        rows.push(row);
    }
    for (Binding row in prefix_data("core", "vim", ["^W :: +windows", "^Ws :: split below", "^Wv :: split right", "^Wn :: new window", "^Wc :: close window", "^Wq :: quit window", "^Wo :: only this window", "^Ww :: next window", "^WW :: previous window", "^Wp :: last window", "^Wt :: top-left window", "^Wb :: bottom-right window", "^Wh :: window left", "^Wj :: window below", "^Wk :: window above", "^Wl :: window right", "^WH :: move window far left", "^WJ :: move window to the bottom", "^WK :: move window to the top", "^WL :: move window far right", "^Wr :: rotate windows", "^WR :: rotate windows up", "^Wx :: exchange window", "^W= :: equalize sizes", "^W+ :: taller", "^W- :: shorter", "^W< :: narrower", "^W> :: wider", "^W_ :: maximize height", "^W| :: maximize width"])) {
        rows.push(row);
    }
    for (Binding row in prefix_data("core", "vim", ["\" :: +register", "\"\" :: unnamed register", "\"+ :: system clipboard", "\"* :: selection clipboard", "\"_ :: black hole", "\"0 :: last yank", "\"1 :: last delete", "\"a :: named register a (a-z)", "\". :: last inserted text", "\": :: last command line", "\"/ :: last search", "\"% :: file name", "' :: +jump to mark line", "` :: +jump to mark", "m :: +set mark", "q :: +record macro", "@ :: +run macro", "'a :: mark a (a-z, A-Z)", "'' :: previous position", "'[ :: start of changed text", "'] :: end of changed text", "'< :: start of selection", "'> :: end of selection", "'. :: last change", "'^ :: last insert"])) {
        rows.push(row);
    }
    // operators wait for a motion or text object
    for (Binding row in prefix_data("core", "vim", ["d :: +delete", "c :: +change", "y :: +yank", "< :: +dedent", "> :: +indent", "= :: +reindent", "! :: +filter through a command", "dd :: delete line", "cc :: change line", "yy :: yank line", "<< :: dedent line", ">> :: indent line", "== :: reindent line", "!! :: filter line through a command"])) {
        rows.push(row);
    }
    for (Binding row in prefix_data("lsp", "m3", ["K :: hover documentation (language server)", "gd :: go to definition (language server)", "grr :: references (language server)", "grn :: rename symbol (language server)", "gra :: code action (language server)"])) {
        rows.push(row);
    }
    for (Binding row in prefix_data("surround", "vim", ["ys :: +surround add (ys{motion}{char})", "yss :: surround the line", "ds :: surround delete (ds{char})", "cs :: surround change (cs{old}{new})", "yS :: surround add, on own lines"])) {
        rows.push(row);
    }
    return rows;
}

/// The motions that follow an operator, for which-key after `d`, `c`, `y` ...
pub List<Binding> motion_rows(str operator) {
    List<Binding> rows = [];
    List<str> motions = ["w :: word", "W :: WORD", "e :: end of word", "E :: end of WORD", "b :: word back", "B :: WORD back", "$ :: end of line", "0 :: start of line", "^ :: first non-blank", "gg :: first line", "G :: last line", "ip :: paragraph", "ap :: paragraph and blank", "iw :: inner word", "aw :: a word", "i\" :: inside quotes", "a\" :: with quotes", "i( :: inside ( )", "a( :: with ( )", "i{ :: inside { }", "a{ :: with { }", "i[ :: inside [ ]", "it :: inside tag", "at :: with tag", "f :: to character", "t :: until character", "F :: to character back", "T :: until character back", "% :: matching bracket", "{ :: paragraph back", "} :: paragraph forward", "/ :: search forward", "? :: search backward", "n :: next match", "j :: line down", "k :: line up"];
    for (str spec in motions) {
        int bar = spec.index_of(" :: ").or(spec.size());
        rows.push(Binding(operator + spec.substr(0, bar), spec.substr(bar + 4, spec.size()), "", is_full: true));
    }
    return rows;
}

/// The rows that apply with `disabled` plugins left out.
pub List<Binding> enabled(List<Binding> table, List<str> disabled) {
    List<Binding> kept = [];
    for (Binding row in table) {
        if (!disabled.contains(row.plugin)) {
            kept.push(row);
        }
    }
    return kept;
}

/// Notes that the help lists but nothing runs.
pub List<Binding> notes() {
    return [Binding("jk", "Insert mode: leave to Normal mode (:set nojk_escape turns it off)", "", plugin: "core", mode: "i", source: "config", is_full: true), Binding("<Space>", "Normal mode: leader key", "", source: "config", is_full: true), Binding("<C-^>", "Normal mode: alternate buffer", "", source: "vim", is_full: true), Binding("<A-j>/<A-k>", "Normal and Visual: move the line or selection down / up", "", plugin: "move", is_full: true), Binding("<A-h>/<A-l>", "Normal and Visual: shift the line or selection left / right", "", plugin: "move", is_full: true), Binding("<C-q>", "Picker: send the marked (or all) entries to the quickfix list", "", plugin: "finder", is_full: true), Binding("<C-t>", "Picker: mark or unmark the entry", "", plugin: "finder", is_full: true), Binding("<Tab>", "Insert and Select mode: jump to the next snippet tabstop (an active snippet; nvim 0.11's default)", "", mode: "i", source: "vim", is_full: true), Binding("<S-Tab>", "Insert and Select mode: jump to the previous snippet tabstop (Insert mode types a Tab otherwise, as nvim does)", "", mode: "i", source: "vim", is_full: true), Binding("<Tab>", "Insert mode: expand the snippet whose prefix stands before the cursor (snippets.json, VS Code format, next to the keymap file)", "", mode: "i", is_full: true), Binding("Select", "Select mode (after a jump onto a placeholder): a typed character or <CR> replaces it, <BS> and <Del> remove it, <Esc> leaves, <C-g> turns it into Visual mode", "", mode: "i", source: "vim", is_full: true)];
}

/// Whether `typed` names a leaf, a prefix of longer sequences, or nothing.
/// A sequence that is both a leaf and a prefix counts as a leaf. Rows whose
/// mode is not `mode` are not considered.
pub int lookup(List<Binding> table, str typed, str mode = "n") {
    int found = NO_BINDING;
    for (Binding row in table) {
        if (row.mode != mode) {
            continue;
        }
        if (row.keys == typed && row.action.size() > 0) {
            return IS_LEAF;
        }
        if (row.keys.size() > typed.size() && row.keys.starts_with(typed)) {
            found = IS_PREFIX;
        }
    }
    return found;
}

/// The row of the leaf `typed`.
pub Binding leaf(List<Binding> table, str typed, str mode = "n") {
    for (Binding row in table) {
        if (row.mode == mode && row.keys == typed && row.action.size() > 0) {
            return row;
        }
    }
    return Binding(typed, "", "");
}

/// The key notation for display: Space is `<Space>`, a control key `<C-x>`.
pub str shown_key(str key) {
    if (key == " ") {
        return "<Space>";
    }
    if (key.size() == 1 && key.byte_at(0) < 32) {
        if (key.byte_at(0) == 13) {
            return "<CR>";
        }
        return "<C-" + str.from_chars([key.byte_at(0) + 96]) + ">";
    }
    return key;
}

/// A whole sequence for display.
pub str shown_keys(str keys) {
    str out = "";
    for (int code in keys.chars()) {
        out = out + shown_key(str.from_chars([code]));
    }
    return out;
}

/// What each key that can follow `typed` does, for which-key: a leaf shows its
/// label, a group its `+name` (or `+more`).
pub List<TUI_menu.Item> next_items(List<Binding> table, str typed, str mode = "n") {
    List<str> keys = [];
    List<str> labels = [];
    for (Binding row in table) {
        if (row.mode != mode || row.keys.size() <= typed.size() || !row.keys.starts_with(typed)) {
            continue;
        }
        str next = row.keys.substr(typed.size(), typed.size() + 1);
        str label = row.label;
        if (row.keys.size() > typed.size() + 1) {
            label = "+more";
        }
        int position = keys.index_of(next).or(-1);
        if (position < 0) {
            keys.push(next);
            labels.push(label);
        } else if (row.keys.size() == typed.size() + 1 && (row.action.size() > 0 || labels[position] == "+more")) {
            labels[position] = label;
        }
    }
    List<TUI_menu.Item> items = [];
    for (int position in 0 .. keys.size()) {
        items.push(TUI_menu.Item(shown_key(keys[position]), labels[position]));
    }
    return items;
}

/// One line of the palette or help: label and the keys that run it.
pub str entry_text(Binding row, bool is_keys_first) {
    str keys = full_keys(row);
    if (is_keys_first) {
        return keys + "  " + row.label;
    }
    if (keys.size() == 0) {
        return row.label;
    }
    return row.label + "  (" + keys + ")";
}

/// The keys of a row as a user types them: a leader row starts with <Space>.
pub str full_keys(Binding row) {
    if (row.keys.size() == 0) {
        return "";
    }
    if (row.is_full) {
        return shown_keys(row.keys);
    }
    return "<Space>" + shown_keys(row.keys);
}

/// Every key of a mode, one text line each, for `:Keys` and the help picker.
pub List<Binding> all_rows(List<str> disabled) {
    List<Binding> rows = [];
    for (Binding row in enabled(defaults(), disabled)) {
        rows.push(row);
    }
    for (Binding row in enabled(prefixes(), disabled)) {
        rows.push(row);
    }
    for (Binding row in enabled(notes(), disabled)) {
        rows.push(row);
    }
    return rows;
}

/// docs/KEYMAP.md, generated from the tables above.
pub str markdown() {
    List<str> lines = [];
    lines.push("# Keymap");
    lines.push("");
    lines.push("Generated from `ui/MED_keymap.m31` by `scripts/gen_keymap.sh`; do not edit by hand.");
    lines.push("The in-editor listing (`<Space>?`, `:Keys`) is built from the same table.");
    lines.push("");
    lines.push("Source column: `vim` is a Vim / Neovim default that the engine is checked against (nvim parity),");
    lines.push("`config` mirrors the owner's Neovim config, `m3` is specific to this editor.");
    lines.push("A plugin can be switched off with `:PluginDisable NAME`; its rows then disappear everywhere.");
    lines.push("");
    lines.push("## Leader (`<Space>`)");
    lines.push("");
    lines.push("| keys | mode | action | plugin | source |");
    lines.push("|---|---|---|---|---|");
    for (Binding row in defaults()) {
        lines.push(table_line(row));
    }
    lines.push("");
    lines.push("## Prefixes (g, z, [, ], CTRL-W, registers, marks, operators)");
    lines.push("");
    lines.push("| keys | mode | action | plugin | source |");
    lines.push("|---|---|---|---|---|");
    for (Binding row in prefixes()) {
        lines.push(table_line(row));
    }
    lines.push("");
    lines.push("## Other");
    lines.push("");
    lines.push("| keys | mode | action | plugin | source |");
    lines.push("|---|---|---|---|---|");
    for (Binding row in notes()) {
        lines.push(table_line(row));
    }
    lines.push("");
    lines.push("## Built-in plugins");
    lines.push("");
    lines.push("| plugin | what it does |");
    lines.push("|---|---|");
    for (MED_plugin.Plugin one in MED_plugin.all()) {
        lines.push("| " + one.name + " | " + one.summary + " |");
    }
    return lines.join("\n");
}

str table_line(Binding row) {
    str keys = full_keys(row).split("|").join("\\|");
    str mode = "Normal";
    if (row.mode == "x") {
        mode = "Visual";
    } else if (row.mode == "i") {
        mode = "Insert";
    }
    str action = row.label.split("|").join("\\|");
    return "| `" + keys + "` | " + mode + " | " + action + " | " + row.plugin + " | " + row.source + " |";
}
