/// The character for the digraph `first` `second`, or -1.
pub int lookup(int first, int second) {
    int found = find(first, second);
    if (found < 0) {
        found = find(second, first);
    }
    return found;
}

int find(int first, int second) {
    for (str chunk in TABLE) {
        int offset = 0;
        while (offset + 7 <= chunk.size()) {
            if (chunk.byte_at(offset) == first && chunk.byte_at(offset + 1) == second) {
                int code = 0;
                int digit = 2;
                while (digit < 7) {
                    code = code * 10 + chunk.byte_at(offset + digit) - 48;
                    digit = digit + 1;
                }
                return code;
            }
            offset = offset + 7;
        }
    }
    return -1;
}
