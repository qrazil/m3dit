/* Small integer helpers the language does not ship.
 *
 * API */
// ---
/*   MED_num.smaller(a, b), MED_num.larger(a, b)
 *   MED_num.clamp(value, low, high) */

/// The smaller of two ints.
pub int smaller(int left, int right) {
    if (left < right) {
        return left;
    }
    return right;
}

/// The larger of two ints.
pub int larger(int left, int right) {
    if (left > right) {
        return left;
    }
    return right;
}

/// `value` limited to `low .. high` (inclusive); `low` wins if the range is empty.
pub int clamp(int value, int low, int high) {
    if (value > high) {
        return larger(high, low);
    }
    if (value < low) {
        return low;
    }
    return value;
}
