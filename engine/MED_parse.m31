// Parsing a pending normal-mode key list into a command, statelessly.
//
// API
// ---
//   MED_parse.parse(keys, visual)  -> Parsed
//
// `keys` is everything typed since the last completed command. The result's
// `status` is COMPLETE (run it), NEED_MORE (wait for another key) or INVALID
// (drop the keys). Nothing here touches the buffer: the grammar is
//
//   ["x] [count] ( operator [count] ( motion | text-object | same-key ) | motion | command )
//
// so `d3w`, `3dw`, `"a2d2w` and `dd` / `g~~` all parse here, with the two
// counts multiplied as Vim does.

import engine.MED_key;

pub const int INVALID = 0;
pub const int NEED_MORE = 1;
pub const int COMPLETE = 2;
/// What the keys are.
pub const int K_MOTION = 1;
pub const int K_OP = 2;
pub const int K_CMD = 3;
pub const int K_OBJECT = 4;

pub type Parsed {
    pub int status = NEED_MORE;
    pub int kind = 0;
    /// The register named with `"`, or "".
    pub str reg = "";
    /// The (multiplied) count, 0 when none was typed.
    pub int count = 0;
    /// The operator name ("d", "g~" ...) for K_OP.
    pub str operator = "";
    /// The motion / object / command keys (without count and register).
    pub List<int> keys = [];
    /// The operator was doubled (`dd`, `g~~`): a line-wise operation.
    pub bool is_doubled = false;
    /// Forced motion type: 118 (v), 86 (V), 22 (CTRL-V), or 0.
    pub int force = 0;
    pub int consumed = 0;
    /// The command without its count and register, for dot-repeat.
    pub List<int> body = [];
}

Parsed outcome(int status) {
    Parsed parsed = Parsed();
    parsed.status = status;
    return parsed;
}

const List<int> ONE_KEY_MOTIONS = [104, 108, 106, 107, 48, 94, 36, 119, 87, 98, 66, 101, 69, 123, 125, 40, 41, 37, 71, 72, 77, 76, 124, 95, 45, 43, 110, 78, 59, 44, 42, 35, 8, 127, 32, 13, 10, 14, 16, 15, 9, 63232, 63233, 63234, 63235, 63236, 63237, 47, 63];
const str OBJECT_CHARS = "wWsp()b{}B[]<>\"'`th";

bool is_in_list(List<int> list, int key) {
    for (int item in list) {
        if (item == key) {
            return true;
        }
    }
    return false;
}

bool is_digit(int key) {
    return key >= 48 && key <= 57;
}

pub bool is_valid_register(int key) {
    if (key >= 48 && key <= 57) {
        return true;
    }
    if (key >= 97 && key <= 122) {
        return true;
    }
    if (key >= 65 && key <= 90) {
        return true;
    }
    return key == 45 || key == 95 || key == 34 || key == 46 || key == 58 || key == 47 || key == 37 || key == 43 || key == 42 || key == 61;
}

// Length of the motion at keys[j], 0 when more keys are needed, -1 if the
// keys are not a motion.
int motion_length(List<int> keys, int other_index, bool is_with_objects) {
    int count = keys.size();
    if (other_index >= count) {
        return 0;
    }
    int key = keys[other_index];
    if (key == 102 || key == 70 || key == 116 || key == 84 || key == 39 || key == 96) {
        if (other_index + 1 >= count) {
            return 0;
        }
        return 2;
    }
    if (key == 103) {
        if (other_index + 1 >= count) {
            return 0;
        }
        int second = keys[other_index + 1];
        if (second == 103 || second == 101 || second == 69 || second == 95 || second == 106 || second == 107 || second == 48 || second == 94 || second == 36 || second == 109 || second == 77 || second == 111 || second == 42 || second == 35 || second == 59 || second == 44 || second == 110 || second == 78) {
            return 2;
        }
        if (second == 39 || second == 96) {
            if (other_index + 2 >= count) {
                return 0;
            }
            return 3;
        }
        return -1;
    }
    if (key == 91 || key == 93) {
        if (other_index + 1 >= count) {
            return 0;
        }
        int second = keys[other_index + 1];
        if (second == 40 || second == 123 || second == 41 || second == 125 || second == 91 || second == 93 || second == 39 || second == 96 || second == 122) {
            return 2;
        }
        return -1;
    }
    if (is_with_objects && (key == 105 || key == 97)) {
        if (other_index + 1 >= count) {
            return 0;
        }
        int second = keys[other_index + 1];
        if (second < 128 && OBJECT_CHARS.index_of(str.from_chars([second])).is_some()) {
            return 2;
        }
        return -1;
    }
    if (is_in_list(ONE_KEY_MOTIONS, key)) {
        return 1;
    }
    return -1;
}

// Operator at keys[j]: returns its name and key length, or length 0 for more
// needed, -1 for none.
pub type OpAt {
    pub str name = "";
    pub int length = -1;
}

pub OpAt op_at(List<int> keys, int other_index) {
    OpAt op_at_value = OpAt();
    int count = keys.size();
    if (other_index >= count) {
        op_at_value.length = 0;
        return op_at_value;
    }
    int key = keys[other_index];
    if (key == 121 && other_index + 1 < count && (keys[other_index + 1] == 115 || keys[other_index + 1] == 83)) {
        // ys and yS: surround
        op_at_value.name = "y" + str.from_chars([keys[other_index + 1]]);
        op_at_value.length = 2;
        return op_at_value;
    }
    if (key == 100 || key == 99 || key == 121 || key == 60 || key == 62 || key == 61 || key == 33) {
        op_at_value.name = str.from_chars([key]);
        op_at_value.length = 1;
        return op_at_value;
    }
    if (key == 103) {
        if (other_index + 1 >= count) {
            op_at_value.length = 0;
            return op_at_value;
        }
        int second = keys[other_index + 1];
        if (second == 126 || second == 117 || second == 85 || second == 63 || second == 113 || second == 119 || second == 64 || second == 99) {
            op_at_value.name = "g" + str.from_chars([second]);
            op_at_value.length = 2;
            return op_at_value;
        }
        return op_at_value;
    }
    if (key == 122) {
        if (other_index + 1 >= count) {
            op_at_value.length = 0;
            return op_at_value;
        }
        if (keys[other_index + 1] == 102) {
            op_at_value.name = "zf";
            op_at_value.length = 2;
            return op_at_value;
        }
    }
    return op_at_value;
}

// Length of the simple command at keys[j] including its argument key, 0 for
// more needed, -1 for unknown.
int cmd_length(List<int> keys, int other_index) {
    int count = keys.size();
    int key = keys[other_index];
    if (key == 114 || key == 109 || key == 113 || key == 64) {
        if (other_index + 1 >= count) {
            return 0;
        }
        if (key == 114 && keys[other_index + 1] == 22) {
            if (other_index + 2 >= count) {
                return 0;
            }
            return 3;
        }
        return 2;
    }
    if (key == 103 || key == 122 || key == 90 || key == 23) {
        if (other_index + 1 >= count) {
            return 0;
        }
        return 2;
    }
    if ((key == 91 || key == 93) && other_index + 1 < count && (keys[other_index + 1] == 112 || keys[other_index + 1] == 80)) {
        // ]p [p ]P [P: put with the indent of the current line
        return 2;
    }
    return 1;
}

/// Parse `keys`. `is_visual` is true while a Visual selection is active (then
/// operators apply at once and `index` / `a` start text objects).
pub Parsed parse(List<int> keys, bool is_visual) {
    int amount = keys.size();
    int index = 0;
    int count = 0;
    bool has_count = false;
    Parsed result = Parsed();
    while (true) {
        if (index >= amount) {
            return outcome(NEED_MORE);
        }
        int key = keys[index];
        if (key == 34) {
            if (index + 1 >= amount) {
                return outcome(NEED_MORE);
            }
            if (!is_valid_register(keys[index + 1])) {
                return outcome(INVALID);
            }
            result.reg = str.from_chars([keys[index + 1]]);
            index = index + 2;
            continue;
        }
        if ((key >= 49 && key <= 57) || (key == 48 && has_count)) {
            count = count * 10 + (key - 48);
            has_count = true;
            if (count > 99999999) {
                count = 99999999;
            }
            index = index + 1;
            continue;
        }
        break;
    }
    int key = keys[index];
    if (is_visual) {
        int length = motion_length(keys, index, true);
        if (length == 0) {
            return outcome(NEED_MORE);
        }
        if (length > 0) {
            result.status = COMPLETE;
            result.count = count;
            result.keys = keys.slice(index, index + length);
            result.consumed = index + length;
            result.body = result.keys;
            if (key == 105 || key == 97) {
                result.kind = K_OBJECT;
            } else {
                result.kind = K_MOTION;
            }
            return result;
        }
        int clen = cmd_length(keys, index);
        if (clen == 0) {
            return outcome(NEED_MORE);
        }
        result.status = COMPLETE;
        result.kind = K_CMD;
        result.count = count;
        result.keys = keys.slice(index, index + clen);
        result.body = result.keys;
        result.consumed = index + clen;
        return result;
    }
    OpAt op_at_value = op_at(keys, index);
    if (op_at_value.length == 0) {
        return outcome(NEED_MORE);
    }
    if (op_at_value.length > 0) {
        int other_index = index + op_at_value.length;
        int count2 = 0;
        bool has_count2 = false;
        while (true) {
            if (other_index >= amount) {
                return outcome(NEED_MORE);
            }
            int marker = keys[other_index];
            if (marker == 118 || marker == 86 || marker == 22) {
                result.force = marker;
                other_index = other_index + 1;
                continue;
            }
            if ((marker >= 49 && marker <= 57) || (marker == 48 && has_count2)) {
                count2 = count2 * 10 + (marker - 48);
                has_count2 = true;
                if (count2 > 99999999) {
                    count2 = 99999999;
                }
                other_index = other_index + 1;
                continue;
            }
            break;
        }
        int mstart = other_index;
        int total = count;
        if (has_count2) {
            if (has_count) {
                total = count * count2;
            } else {
                total = count2;
            }
        }
        result.count = total;
        result.kind = K_OP;
        result.operator = op_at_value.name;
        int marker = keys[other_index];
        bool is_doubled = false;
        if (op_at_value.length == 1 && marker == keys[index]) {
            is_doubled = true;
            other_index = other_index + 1;
        } else if (op_at_value.length == 2) {
            if (marker == keys[index + 1] || (op_at_value.name == "yS" && marker == 115)) {
                is_doubled = true;
                other_index = other_index + 1;
            } else if (marker == 103) {
                if (other_index + 1 >= amount) {
                    return outcome(NEED_MORE);
                }
                if (keys[other_index + 1] == keys[index + 1]) {
                    is_doubled = true;
                    other_index = other_index + 2;
                }
            }
        }
        if (is_doubled) {
            result.is_doubled = true;
            result.status = COMPLETE;
            result.consumed = other_index;
            result.body = keys.slice(index, index + op_at_value.length);
            if (result.force != 0) {
                result.body.push(result.force);
            }
            for (int key_code in keys.slice(mstart, other_index)) {
                result.body.push(key_code);
            }
            return result;
        }
        int length = motion_length(keys, other_index, true);
        if (length == 0) {
            return outcome(NEED_MORE);
        }
        if (length < 0) {
            return outcome(INVALID);
        }
        result.keys = keys.slice(other_index, other_index + length);
        result.status = COMPLETE;
        result.consumed = other_index + length;
        result.body = keys.slice(index, index + op_at_value.length);
        if (result.force != 0) {
            result.body.push(result.force);
        }
        for (int key_code in keys.slice(other_index, other_index + length)) {
            result.body.push(key_code);
        }
        return result;
    }
    int length = motion_length(keys, index, false);
    if (length == 0) {
        return outcome(NEED_MORE);
    }
    if (length > 0) {
        result.status = COMPLETE;
        result.kind = K_MOTION;
        result.count = count;
        result.keys = keys.slice(index, index + length);
        result.body = result.keys;
        result.consumed = index + length;
        return result;
    }
    int clen = cmd_length(keys, index);
    if (clen == 0) {
        return outcome(NEED_MORE);
    }
    result.status = COMPLETE;
    result.kind = K_CMD;
    result.count = count;
    result.keys = keys.slice(index, index + clen);
    result.body = result.keys;
    result.consumed = index + clen;
    return result;
}
