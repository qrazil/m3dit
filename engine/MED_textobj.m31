// Text objects (`iw aw iW aW ip ap i" a" i( a( ...`), ported from Vim's
// textobject.c and checked against nvim.
//
// API
// ---
//   MED_textobj.select(buf, cursor, vis, vstart, vmode, obj, include, count) -> Sel
//
// Every object works in operator-pending mode and in Visual mode. In
// operator-pending mode (`vis` false) the result is the range `start`..`end`
// with `inclusive` and `linewise` set. In Visual mode `start` is the new
// Visual anchor, `end` the new cursor, and `vmode` the mode the selection
// must switch to (-1 keeps the current one).

import engine.MED_buffer;
import engine.MED_motion;
import engine.MED_text;

pub type Sel {
    pub bool is_ok = true;
    pub MED_buffer.Pos start = MED_buffer.Pos(0, 0);
    pub MED_buffer.Pos end = MED_buffer.Pos(0, 0);
    pub bool is_linewise = false;
    pub bool is_inclusive = false;
    pub int vmode = -1;
    pub bool is_jump = false;
    /// A failed object that still moved the cursor (to `end`), as Vim's does.
    pub bool is_moved = false;
}

Sel failed_at(MED_motion.Cur cursor) {
    Sel sel = Sel();
    sel.is_ok = false;
    sel.is_moved = true;
    sel.end = MED_buffer.Pos(cursor.row, cursor.col);
    return sel;
}

Sel failed() {
    Sel sel = Sel();
    sel.is_ok = false;
    return sel;
}

MED_buffer.Pos position_of(MED_motion.Cur cursor) {
    return MED_buffer.Pos(cursor.row, cursor.col);
}

bool is_before(MED_buffer.Pos position, MED_buffer.Pos position_value) {
    return position.cmp(position_value) < 0;
}

// ------------------------------------------------------------------- words

Sel current_word(MED_buffer.Buffer buffer, MED_buffer.Pos cursor, bool is_visible, MED_buffer.Pos vstart, int count, bool is_include, bool is_big) {
    MED_motion.Cur cursor_value = MED_motion.Cur(buffer, cursor.row, cursor.col);
    MED_buffer.Pos start = MED_buffer.Pos(vstart.row, vstart.col);
    MED_buffer.Pos position = MED_buffer.Pos(vstart.row, vstart.col);
    bool is_include_white = false;
    bool is_inclusive = true;
    int left = count;
    if (!is_visible || cursor.eq(vstart)) {
        cursor_value.back_in_line(is_big);
        MED_buffer.Pos start_position = position_of(cursor_value);
        if ((cursor_value.cls(is_big) == 0) == is_include) {
            if (!MED_motion.did_end_word(cursor_value, 1, is_big, true, true)) {
                return failed_at(cursor_value);
            }
        } else {
            MED_motion.did_fwd_word(cursor_value, 1, is_big, true);
            if (cursor_value.col == 0) {
                cursor_value.decl();
            } else {
                cursor_value.did_oneleft();
            }
            if (is_include) {
                is_include_white = true;
            }
        }
        start = start_position;
        position = start_position;
        left = left - 1;
    }
    while (left > 0) {
        is_inclusive = true;
        if (is_visible && is_before(position_of(cursor_value), position)) {
            if (cursor_value.decl() == -1) {
                return failed_at(cursor_value);
            }
            if (is_include != (cursor_value.cls(is_big) != 0)) {
                if (!MED_motion.did_bck_word(cursor_value, 1, is_big, true)) {
                    return failed_at(cursor_value);
                }
            } else {
                if (!MED_motion.did_bckend_word(cursor_value, 1, is_big, true)) {
                    return failed_at(cursor_value);
                }
                cursor_value.incl();
            }
        } else {
            if (cursor_value.incl() == -1) {
                return failed_at(cursor_value);
            }
            if (is_include != (cursor_value.cls(is_big) == 0)) {
                if (!MED_motion.did_fwd_word(cursor_value, 1, is_big, true) && left > 1) {
                    return failed_at(cursor_value);
                }
                if (!cursor_value.did_oneleft()) {
                    is_inclusive = false;
                }
            } else if (!MED_motion.did_end_word(cursor_value, 1, is_big, true, true)) {
                return failed_at(cursor_value);
            }
        }
        left = left - 1;
    }
    if (is_include_white && (cursor_value.cls(is_big) != 0 || (cursor_value.col == 0 && !is_inclusive))) {
        MED_motion.Cur cursor_item = MED_motion.Cur(buffer, position.row, position.col);
        if (cursor_item.did_oneleft()) {
            cursor_item.back_in_line(is_big);
            if (cursor_item.cls(is_big) == 0 && cursor_item.col > 0) {
                start = position_of(cursor_item);
                if (!is_visible) {
                    position = start;
                }
            }
        }
    }
    Sel sel = Sel();
    sel.start = start;
    sel.end = position_of(cursor_value);
    sel.is_inclusive = is_inclusive;
    if (is_visible) {
        sel.vmode = 118;
    }
    return sel;
}

// ------------------------------------------------------------------ blocks

// Number of backslashes right before `col`.
int backslashes(str line, int col) {
    int count = 0;
    int spot = col;
    while (spot > 0 && line.byte_at(spot - 1) == 92) {
        count = count + 1;
        spot = spot - 1;
    }
    return count;
}

/// Vim's findmatchlimit for a bracket with the quotes ignored (the 'cpo'
/// "%" flag): starting just past `pos`, the first `findc` not matched by an
/// `initc` met on the way. `is_backwards` picks the direction.
pub Sel find_unmatched(MED_buffer.Buffer buffer, MED_buffer.Pos from, int initc, int findc, bool is_backwards) {
    int row = from.row;
    int col = from.col;
    int count = 0;
    int escaped = backslashes(buffer.line(row), col) % 2;
    while (true) {
        str line = buffer.line(row);
        if (is_backwards) {
            if (col == 0) {
                if (row == 0) {
                    return failed();
                }
                row = row - 1;
                col = buffer.line_size(row);
                continue;
            }
            col = MED_text.previous_col(line, col);
        } else if (col >= line.size()) {
            if (row + 1 >= buffer.line_count()) {
                return failed();
            }
            row = row + 1;
            col = 0;
        } else {
            col = MED_text.next_col(line, col);
        }
        line = buffer.line(row);
        if (col >= line.size()) {
            continue;
        }
        int char_code = line.byte_at(col);
        if (char_code == initc || char_code == findc) {
            if (backslashes(line, col) % 2 == escaped) {
                if (char_code == initc) {
                    count = count + 1;
                } else {
                    if (count == 0) {
                        Sel sel = Sel();
                        sel.start = MED_buffer.Pos(row, col);
                        return sel;
                    }
                    count = count - 1;
                }
            }
        }
    }
}

// findmatch(NULL, what): `what` is a bracket, the search is for its pair in
// the direction implied (an opener searches back, a closer forward).
Sel findmatch(MED_buffer.Buffer buffer, MED_buffer.Pos from, int what) {
    if (what == 40) {
        return find_unmatched(buffer, from, 41, 40, true);
    }
    if (what == 123) {
        return find_unmatched(buffer, from, 125, 123, true);
    }
    if (what == 91) {
        return find_unmatched(buffer, from, 93, 91, true);
    }
    if (what == 60) {
        return find_unmatched(buffer, from, 62, 60, true);
    }
    if (what == 41) {
        return find_unmatched(buffer, from, 40, 41, false);
    }
    if (what == 125) {
        return find_unmatched(buffer, from, 123, 125, false);
    }
    if (what == 93) {
        return find_unmatched(buffer, from, 91, 93, false);
    }
    return find_unmatched(buffer, from, 60, 62, false);
}

bool is_in_indent(str line, int col) {
    int count = 0;
    while (count < line.size() && (line.byte_at(count) == 32 || line.byte_at(count) == 9)) {
        count = count + 1;
    }
    return count >= col + 1;
}

Sel current_block(MED_buffer.Buffer buffer, MED_buffer.Pos cursor, bool is_visible, MED_buffer.Pos vstart, int count, bool is_include, int what, int other) {
    MED_motion.Cur cursor_value = MED_motion.Cur(buffer, cursor.row, cursor.col);
    MED_buffer.Pos old_start = MED_buffer.Pos(cursor.row, cursor.col);
    MED_buffer.Pos old_end = MED_buffer.Pos(cursor.row, cursor.col);
    if (!is_visible || cursor.eq(vstart)) {
        if (what == 123) {
            while (is_in_indent(buffer.line(cursor_value.row), cursor_value.col)) {
                if (cursor_value.inc() != 0) {
                    break;
                }
            }
        }
        if (cursor_value.char_code() == what) {
            cursor_value.col = cursor_value.col + 1;
        }
    } else if (is_before(vstart, cursor)) {
        old_start = MED_buffer.Pos(vstart.row, vstart.col);
        cursor_value.row = vstart.row;
        cursor_value.col = vstart.col;
    } else {
        old_end = MED_buffer.Pos(vstart.row, vstart.col);
    }
    MED_buffer.Pos start_position = position_of(cursor_value);
    Sel found = findmatch(buffer, position_of(cursor_value), what);
    int left = count;
    if (found.is_ok) {
        while (left > 0) {
            left = left - 1;
            found = findmatch(buffer, position_of(cursor_value), what);
            if (!found.is_ok) {
                break;
            }
            cursor_value.row = found.start.row;
            cursor_value.col = found.start.col;
            start_position = found.start;
        }
    } else {
        while (left > 0) {
            left = left - 1;
            found = find_unmatched(buffer, position_of(cursor_value), other, what, false);
            if (!found.is_ok) {
                break;
            }
            cursor_value.row = found.start.row;
            cursor_value.col = found.start.col;
            start_position = found.start;
        }
    }
    if (!found.is_ok) {
        return failed();
    }
    Sel end_found = findmatch(buffer, position_of(cursor_value), other);
    if (!end_found.is_ok) {
        return failed();
    }
    cursor_value.row = end_found.start.row;
    cursor_value.col = end_found.start.col;
    bool is_sol = false;
    while (!is_include) {
        MED_motion.Cur cursor_item = MED_motion.Cur(buffer, start_position.row, start_position.col);
        cursor_item.incl();
        start_position = position_of(cursor_item);
        is_sol = cursor_value.col == 0;
        cursor_value.decl();
        while (is_in_indent(buffer.line(cursor_value.row), cursor_value.col)) {
            is_sol = true;
            if (cursor_value.decl() != 0) {
                break;
            }
        }
        if (is_visible && !is_before(start_position, old_start) && !is_before(old_end, position_of(cursor_value)) && !start_position.eq(position_of(cursor_value))) {
            cursor_value.row = old_start.row;
            cursor_value.col = old_start.col;
            cursor_value.decl();
            found = findmatch(buffer, position_of(cursor_value), what);
            if (!found.is_ok) {
                return failed();
            }
            start_position = found.start;
            end_found = findmatch(buffer, found.start, other);
            if (!end_found.is_ok) {
                return failed();
            }
            cursor_value.row = end_found.start.row;
            cursor_value.col = end_found.start.col;
        } else {
            break;
        }
    }
    Sel sel = Sel();
    sel.is_jump = true;
    sel.start = start_position;
    if (is_visible) {
        if (is_sol && cursor_value.char_code() != 0) {
            cursor_value.inc();
        }
        sel.end = position_of(cursor_value);
        sel.vmode = 118;
        return sel;
    }
    if (is_sol) {
        cursor_value.incl();
    } else if (!is_before(position_of(cursor_value), start_position)) {
        sel.is_inclusive = true;
    } else {
        cursor_value.row = start_position.row;
        cursor_value.col = start_position.col;
    }
    sel.end = position_of(cursor_value);
    return sel;
}

// ------------------------------------------------------------------ quotes

// Next quote at or after `col`; an `escape` byte skips the byte after it.
int find_next_quote(str line, int col, int quote, int escape) {
    int spot = col;
    while (spot < line.size()) {
        int char_code = line.byte_at(spot);
        if (escape >= 0 && char_code == escape) {
            spot = spot + 1;
            if (spot >= line.size()) {
                return -1;
            }
        } else if (char_code == quote) {
            return spot;
        }
        spot = MED_text.next_col(line, spot);
    }
    return -1;
}

int find_previous_quote(str line, int col, int quote, int escape) {
    int spot = col;
    while (spot > 0) {
        spot = MED_text.previous_col(line, spot);
        int count = 0;
        if (escape >= 0) {
            while (spot - count > 0 && line.byte_at(spot - count - 1) == escape) {
                count = count + 1;
            }
        }
        if (count % 2 == 1) {
            spot = spot - count;
        } else if (line.byte_at(spot) == quote) {
            break;
        }
    }
    return spot;
}

int byte_or_nul(str line, int col) {
    if (col < 0 || col >= line.size()) {
        return 0;
    }
    return line.byte_at(col);
}

Sel current_quote(MED_buffer.Buffer buffer, MED_buffer.Pos cursor, bool is_visible, MED_buffer.Pos vstart, int count, bool is_include, int quote) {
    str line = buffer.line(cursor.row);
    int col_start = cursor.col;
    int col_end = 0;
    bool is_inclusive = false;
    bool is_visible_empty = true;
    bool is_visible_bef_curs = false;
    bool is_inside_quotes = false;
    bool is_selected_quote = false;
    if (is_visible) {
        if (vstart.row != cursor.row) {
            return failed();
        }
        is_visible_bef_curs = is_before(vstart, cursor);
        is_visible_empty = vstart.eq(cursor);
        if (!is_visible_empty) {
            int index = 0;
            if (is_visible_bef_curs) {
                is_inside_quotes = vstart.col > 0 && byte_or_nul(line, vstart.col - 1) == quote && byte_or_nul(line, cursor.col) != 0 && byte_or_nul(line, cursor.col + 1) == quote;
                index = vstart.col;
                col_end = cursor.col;
            } else {
                is_inside_quotes = cursor.col > 0 && byte_or_nul(line, cursor.col - 1) == quote && byte_or_nul(line, vstart.col) != 0 && byte_or_nul(line, vstart.col + 1) == quote;
                index = cursor.col;
                col_end = vstart.col;
            }
            while (index <= col_end) {
                if (byte_or_nul(line, index) == 0) {
                    break;
                }
                index = index + 1;
                if (byte_or_nul(line, index - 1) == quote) {
                    is_selected_quote = true;
                    break;
                }
            }
        }
    }
    if (!is_visible_empty && byte_or_nul(line, col_start) == quote) {
        if (is_visible_bef_curs) {
            col_start = find_next_quote(line, col_start + 1, quote, -1);
            if (col_start < 0) {
                return failed();
            }
            col_end = find_next_quote(line, col_start + 1, quote, 92);
            if (col_end < 0) {
                col_end = col_start;
                col_start = cursor.col;
            }
        } else {
            col_end = find_previous_quote(line, col_start, quote, -1);
            if (byte_or_nul(line, col_end) != quote) {
                return failed();
            }
            col_start = find_previous_quote(line, col_end, quote, 92);
            if (byte_or_nul(line, col_start) != quote) {
                col_start = col_end;
                col_end = cursor.col;
            }
        }
    } else if (byte_or_nul(line, col_start) == quote || !is_visible_empty) {
        int first_col = col_start;
        if (!is_visible_empty) {
            if (is_visible_bef_curs) {
                first_col = find_next_quote(line, col_start, quote, -1);
            } else {
                first_col = find_previous_quote(line, col_start, quote, -1);
            }
        }
        col_start = 0;
        while (true) {
            col_start = find_next_quote(line, col_start, quote, -1);
            if (col_start < 0 || col_start > first_col) {
                return failed();
            }
            col_end = find_next_quote(line, col_start + 1, quote, 92);
            if (col_end < 0) {
                return failed();
            }
            if (col_start <= first_col && first_col <= col_end) {
                break;
            }
            col_start = col_end + 1;
        }
    } else {
        col_start = find_previous_quote(line, col_start, quote, 92);
        if (byte_or_nul(line, col_start) != quote) {
            col_start = find_next_quote(line, col_start, quote, -1);
            if (col_start < 0) {
                return failed();
            }
        }
        col_end = find_next_quote(line, col_start + 1, quote, 92);
        if (col_end < 0) {
            return failed();
        }
    }
    if (is_include) {
        if (is_white(byte_or_nul(line, col_end + 1))) {
            while (is_white(byte_or_nul(line, col_end + 1))) {
                col_end = col_end + 1;
            }
        } else {
            while (col_start > 0 && is_white(byte_or_nul(line, col_start - 1))) {
                col_start = col_start - 1;
            }
        }
    }
    if (!is_include && count < 2 && (is_visible_empty || !is_inside_quotes)) {
        col_start = col_start + 1;
    }
    Sel sel = Sel();
    MED_buffer.Pos new_visible = MED_buffer.Pos(vstart.row, vstart.col);
    if (is_visible) {
        if (is_visible_empty || (is_visible_bef_curs && !is_selected_quote && (is_inside_quotes || (byte_or_nul(line, vstart.col) != quote && (vstart.col == 0 || byte_or_nul(line, vstart.col - 1) != quote))))) {
            new_visible = MED_buffer.Pos(cursor.row, col_start);
        }
    } else {
        sel.start = MED_buffer.Pos(cursor.row, col_start);
    }
    int end_col = col_end;
    if (is_include || count > 1 || (!is_visible_empty && is_inside_quotes)) {
        if (end_col < line.size()) {
            end_col = MED_text.next_col(line, end_col);
            if (end_col >= line.size()) {
                is_inclusive = true;
            }
        }
    }
    if (is_visible) {
        MED_buffer.Pos current_end = MED_buffer.Pos(cursor.row, end_col);
        if (is_visible_empty || is_visible_bef_curs) {
            if (current_end.col > 0) {
                current_end.col = MED_text.previous_col(line, current_end.col);
            }
        } else {
            if (is_inside_quotes || (!is_selected_quote && byte_or_nul(line, vstart.col) != quote && (byte_or_nul(line, vstart.col) == 0 || byte_or_nul(line, vstart.col + 1) != quote))) {
                int delta = end_col;
                if (delta > 0) {
                    delta = MED_text.previous_col(line, delta);
                }
                new_visible = MED_buffer.Pos(cursor.row, delta);
            }
            current_end = MED_buffer.Pos(cursor.row, col_start);
        }
        sel.start = new_visible;
        sel.end = current_end;
        sel.vmode = 118;
        return sel;
    }
    sel.end = MED_buffer.Pos(cursor.row, end_col);
    sel.is_inclusive = is_inclusive;
    return sel;
}

bool is_white(int char_code) {
    return char_code == 32 || char_code == 9;
}

// -------------------------------------------------------------- paragraphs

bool is_linewhite(MED_buffer.Buffer buffer, int row) {
    str line = buffer.line(row);
    return MED_text.first_nonblank(line) >= line.size();
}

// An empty line or a form feed starts a paragraph (nroff macros are not
// recognised).
bool is_start_ps(MED_buffer.Buffer buffer, int row) {
    str line = buffer.line(row);
    return line.size() == 0 || line.byte_at(0) == 12;
}

Sel current_par(MED_buffer.Buffer buffer, MED_buffer.Pos cursor, bool is_visible, MED_buffer.Pos vstart, int vmode, int count, bool is_include) {
    int last = buffer.line_count() - 1;
    int start_lnum = cursor.row;
    bool is_extend = is_visible && start_lnum != vstart.row;
    if (!is_extend) {
        bool is_white_in_front = is_linewhite(buffer, start_lnum);
        while (start_lnum > 0) {
            if (is_white_in_front) {
                if (!is_linewhite(buffer, start_lnum - 1)) {
                    break;
                }
            } else if (is_linewhite(buffer, start_lnum - 1) || is_start_ps(buffer, start_lnum)) {
                break;
            }
            start_lnum = start_lnum - 1;
        }
        int end_lnum = start_lnum;
        while (end_lnum <= last && is_linewhite(buffer, end_lnum)) {
            end_lnum = end_lnum + 1;
        }
        end_lnum = end_lnum - 1;
        int index = count;
        if (!is_include && is_white_in_front) {
            index = index - 1;
        }
        bool should_white = false;
        while (index > 0) {
            index = index - 1;
            if (end_lnum == last) {
                return failed();
            }
            if (!is_include) {
                should_white = is_linewhite(buffer, end_lnum + 1);
            }
            if (is_include || !should_white) {
                end_lnum = end_lnum + 1;
                while (end_lnum < last && !is_linewhite(buffer, end_lnum + 1) && !is_start_ps(buffer, end_lnum + 1)) {
                    end_lnum = end_lnum + 1;
                }
            }
            if (index == 0 && is_white_in_front && is_include) {
                break;
            }
            if (is_include || should_white) {
                while (end_lnum < last && is_linewhite(buffer, end_lnum + 1)) {
                    end_lnum = end_lnum + 1;
                }
            }
        }
        if (!is_white_in_front && !is_linewhite(buffer, end_lnum) && is_include) {
            while (start_lnum > 0 && is_linewhite(buffer, start_lnum - 1)) {
                start_lnum = start_lnum - 1;
            }
        }
        if (!(is_visible && vmode == 86 && start_lnum == cursor.row)) {
            Sel sel = Sel();
            sel.is_linewise = true;
            sel.start = MED_buffer.Pos(start_lnum, 0);
            sel.end = MED_buffer.Pos(end_lnum, 0);
            if (is_visible) {
                if (vstart.row != start_lnum) {
                    sel.start = MED_buffer.Pos(start_lnum, 0);
                } else {
                    sel.start = MED_buffer.Pos(vstart.row, vstart.col);
                }
                sel.vmode = 86;
            }
            return sel;
        }
    }
    // extend an existing Visual selection by whole paragraphs
    int directory = 1;
    if (start_lnum < vstart.row) {
        directory = -1;
    }
    int edge = last;
    if (directory < 0) {
        edge = 0;
    }
    bool is_failed_ext = false;
    int total = count;
    while (total > 0) {
        total = total - 1;
        if (start_lnum == edge) {
            is_failed_ext = true;
            break;
        }
        int previous_white = -1;
        for (int target in 0 .. 2) {
            start_lnum = start_lnum + directory;
            int start_is_white = 0;
            if (is_linewhite(buffer, start_lnum)) {
                start_is_white = 1;
            }
            if (previous_white == start_is_white) {
                start_lnum = start_lnum - directory;
                break;
            }
            while (true) {
                if (start_lnum == edge) {
                    break;
                }
                bool is_next_white = is_linewhite(buffer, start_lnum + directory);
                if ((start_is_white == 1) != is_next_white) {
                    break;
                }
                if (start_is_white == 0) {
                    int probe = start_lnum;
                    if (directory > 0) {
                        probe = probe + 1;
                    }
                    if (is_start_ps(buffer, probe)) {
                        break;
                    }
                }
                start_lnum = start_lnum + directory;
            }
            if (!is_include) {
                break;
            }
            if (start_lnum == edge) {
                break;
            }
            previous_white = start_is_white;
        }
    }
    Sel sel = Sel();
    sel.is_linewise = true;
    sel.start = MED_buffer.Pos(vstart.row, vstart.col);
    sel.end = MED_buffer.Pos(start_lnum, 0);
    sel.is_ok = !is_failed_ext;
    return sel;
}

// --------------------------------------------------------------- sentences

bool is_white_at(MED_motion.Cur cursor) {
    int char_code = cursor.char_code();
    return char_code == 32 || char_code == 9;
}

void find_first_blank(MED_motion.Cur cursor) {
    while (cursor.decl() != -1) {
        if (!is_white_at(cursor)) {
            cursor.incl();
            break;
        }
    }
}

void findsent_forward(MED_motion.Cur cursor, int count, bool is_at_start) {
    bool is_at_start_sent = is_at_start;
    int left = count;
    while (left > 0) {
        left = left - 1;
        MED_motion.did_findsent(cursor, 1, 1);
        if (is_at_start_sent) {
            find_first_blank(cursor);
        }
        if (left == 0 || is_at_start_sent) {
            cursor.decl();
        }
        is_at_start_sent = !is_at_start_sent;
    }
}

Sel current_sent(MED_buffer.Buffer buffer, MED_buffer.Pos cursor, bool is_visible, MED_buffer.Pos vstart, int count, bool is_include) {
    MED_motion.Cur cursor_value = MED_motion.Cur(buffer, cursor.row, cursor.col);
    MED_buffer.Pos start_position = MED_buffer.Pos(cursor.row, cursor.col);
    MED_motion.Cur position = MED_motion.Cur(buffer, cursor.row, cursor.col);
    MED_motion.did_findsent(cursor_value, 1, 1);
    bool is_extend = is_visible && !start_position.eq(vstart);
    int total = count;
    while (true) {
        if (is_extend) {
            if (is_before(start_position, vstart)) {
                bool is_at_start_sent = true;
                position.decl();
                while (is_before(position_of(position), position_of(cursor_value))) {
                    if (!is_white_at(position)) {
                        is_at_start_sent = false;
                        break;
                    }
                    position.incl();
                }
                if (!is_at_start_sent) {
                    MED_motion.did_findsent(cursor_value, -1, 1);
                    if (position_of(cursor_value).eq(start_position)) {
                        is_at_start_sent = true;
                    } else {
                        MED_motion.did_findsent(cursor_value, 1, 1);
                    }
                }
                if (is_include) {
                    total = total * 2;
                }
                while (total > 0) {
                    total = total - 1;
                    if (is_at_start_sent) {
                        find_first_blank(cursor_value);
                    }
                    if (!is_at_start_sent || (!is_include && !is_white_at(cursor_value))) {
                        MED_motion.did_findsent(cursor_value, -1, 1);
                    }
                    is_at_start_sent = !is_at_start_sent;
                }
            } else {
                position.incl();
                bool is_at_start_sent = true;
                if (!position_of(position).eq(position_of(cursor_value))) {
                    is_at_start_sent = false;
                    while (is_before(position_of(position), position_of(cursor_value))) {
                        if (!is_white_at(position)) {
                            is_at_start_sent = true;
                            break;
                        }
                        position.incl();
                    }
                    if (is_at_start_sent) {
                        MED_motion.did_findsent(cursor_value, -1, 1);
                    } else {
                        cursor_value.row = start_position.row;
                        cursor_value.col = start_position.col;
                    }
                }
                if (is_include) {
                    total = total * 2;
                }
                findsent_forward(cursor_value, total, is_at_start_sent);
            }
            Sel sel = Sel();
            sel.start = vstart;
            sel.end = position_of(cursor_value);
            sel.vmode = 118;
            return sel;
        }
        while (is_white_at(position)) {
            position.incl();
        }
        bool is_start_blank = false;
        if (position_of(position).eq(position_of(cursor_value))) {
            is_start_blank = true;
            MED_motion.Cur cursor_item = MED_motion.Cur(buffer, start_position.row, start_position.col);
            find_first_blank(cursor_item);
            start_position = position_of(cursor_item);
        } else {
            MED_motion.did_findsent(cursor_value, -1, 1);
            start_position = position_of(cursor_value);
        }
        int ncount = 0;
        if (is_include) {
            ncount = total * 2;
        } else {
            ncount = total;
            if (is_start_blank) {
                ncount = ncount - 1;
            }
        }
        if (ncount > 0) {
            findsent_forward(cursor_value, ncount, true);
        } else {
            cursor_value.decl();
        }
        if (is_include) {
            if (is_start_blank) {
                find_first_blank(cursor_value);
                if (is_white_at(cursor_value)) {
                    cursor_value.decl();
                }
            } else if (!is_white_at(cursor_value)) {
                MED_motion.Cur cursor_item = MED_motion.Cur(buffer, start_position.row, start_position.col);
                find_first_blank(cursor_item);
                start_position = position_of(cursor_item);
            }
        }
        if (is_visible) {
            if (start_position.eq(position_of(cursor_value))) {
                is_extend = true;
                position = MED_motion.Cur(buffer, cursor.row, cursor.col);
                continue;
            }
            Sel sel = Sel();
            sel.start = start_position;
            sel.end = position_of(cursor_value);
            sel.vmode = 118;
            return sel;
        }
        Sel sel = Sel();
        sel.is_inclusive = cursor_value.incl() == -1;
        sel.start = start_position;
        sel.end = position_of(cursor_value);
        return sel;
    }
}

// -------------------------------------------------------------------- tags

// The byte at a position; a line break reads as 10 (not on the last line).
int stream_ch(MED_buffer.Buffer buffer, int row, int col) {
    str line = buffer.line(row);
    if (col < line.size()) {
        return line.byte_at(col);
    }
    if (row + 1 < buffer.line_count()) {
        return 10;
    }
    return -1;
}

// The first `>` after (row, col), row -1 when there is none.
MED_buffer.Pos find_gt(MED_buffer.Buffer buffer, int row, int col) {
    int result = row;
    int char_code = col + 1;
    while (result < buffer.line_count()) {
        str line = buffer.line(result);
        while (char_code < line.size()) {
            if (line.byte_at(char_code) == 62) {
                return MED_buffer.Pos(result, char_code);
            }
            char_code = char_code + 1;
        }
        result = result + 1;
        char_code = 0;
    }
    return MED_buffer.Pos(-1, 0);
}

// Whether the `>` at q ends a tag whose whitespace is at (row, p): the char
// before it is not `/` (and, when `is_plain`, not a line break).
bool is_tag_close_ok(MED_buffer.Buffer buffer, int row, int offset, bool is_plain) {
    MED_buffer.Pos position = find_gt(buffer, row, offset);
    if (position.row < 0) {
        return false;
    }
    if (position.col == 0) {
        return !is_plain;
    }
    if (position.row == row && position.col < offset + 2) {
        return false;
    }
    return buffer.line(position.row).byte_at(position.col - 1) != 47;
}

// `<[^ \t>/!]\+\%(\_s\_[^>]\{-}[^/]>\|$\|\_s\=>\)` at (row, col).
bool is_start_tag_at(MED_buffer.Buffer buffer, int row, int col) {
    str line = buffer.line(row);
    if (col >= line.size() || line.byte_at(col) != 60) {
        return false;
    }
    int offset = col + 1;
    int key = 0;
    while (offset < line.size()) {
        int right = line.byte_at(offset);
        if (right == 32 || right == 9 || right == 62 || right == 47 || right == 33) {
            break;
        }
        offset = offset + 1;
        key = key + 1;
    }
    if (key == 0) {
        return false;
    }
    if (offset >= line.size()) {
        return true;
    }
    int char_code = line.byte_at(offset);
    if (char_code == 62) {
        return true;
    }
    if (char_code == 32 || char_code == 9) {
        if (offset + 1 < line.size() && line.byte_at(offset + 1) == 62) {
            return true;
        }
        return is_tag_close_ok(buffer, row, offset, true);
    }
    return false;
}

// `</[^>]*>` at (row, col).
bool is_end_tag_at(MED_buffer.Buffer buffer, int row, int col) {
    str line = buffer.line(row);
    if (col + 1 >= line.size() || line.byte_at(col) != 60 || line.byte_at(col + 1) != 47) {
        return false;
    }
    int offset = col + 2;
    while (offset < line.size()) {
        if (line.byte_at(offset) == 62) {
            return true;
        }
        offset = offset + 1;
    }
    return false;
}

bool is_keyword_at(str line, int col, List<int> keywords) {
    if (col < 0 || col >= line.size()) {
        return false;
    }
    int code_point = MED_text.cp_at(line, col);
    return MED_text.class_in(code_point, keywords) >= 2;
}

// Does `name` (lowercased) sit at `col`, then a word end?
bool is_name_at(str line, int col, str name) {
    int count = name.size();
    if (col + count > line.size()) {
        return false;
    }
    if (line.substr(col, col + count).to_lower() != name) {
        return false;
    }
    return true;
}

// `<name\>\%(\_s\_[^>]\{-}\_[^/]>\|\_s\?>\)\c` at (row, col).
bool is_named_start_at(MED_buffer.Buffer buffer, int row, int col, str name) {
    str line = buffer.line(row);
    if (col >= line.size() || line.byte_at(col) != 60 || !is_name_at(line, col + 1, name)) {
        return false;
    }
    int offset = col + 1 + name.size();
    if (!is_keyword_at(line, MED_text.previous_col(line, offset), buffer.keywords) || is_keyword_at(line, offset, buffer.keywords)) {
        return false;
    }
    if (offset < line.size() && line.byte_at(offset) == 62) {
        return true;
    }
    int char_code = stream_ch(buffer, row, offset);
    if (char_code == 32 || char_code == 9 || char_code == 10) {
        int next_row = row;
        int next_col = offset + 1;
        if (char_code == 10) {
            next_row = row + 1;
            next_col = 0;
        }
        if (next_col < buffer.line_size(next_row) && buffer.line(next_row).byte_at(next_col) == 62) {
            return true;
        }
        return is_tag_close_ok(buffer, row, offset, false);
    }
    return false;
}

bool is_named_end_at(MED_buffer.Buffer buffer, int row, int col, str name) {
    str line = buffer.line(row);
    if (col + 1 >= line.size() || line.byte_at(col) != 60 || line.byte_at(col + 1) != 47) {
        return false;
    }
    if (!is_name_at(line, col + 2, name)) {
        return false;
    }
    int offset = col + 2 + name.size();
    return offset < line.size() && line.byte_at(offset) == 62;
}

// do_searchpair backwards for an unclosed start tag, from `cursor` (excluded).
bool did_search_open_tag(MED_motion.Cur cursor) {
    int nest = 1;
    int row = cursor.row;
    int col = cursor.col;
    while (true) {
        if (col == 0) {
            if (row == 0) {
                return false;
            }
            row = row - 1;
            col = cursor.buffer.line_size(row);
            continue;
        }
        col = MED_text.previous_col(cursor.buffer.line(row), col);
        if (is_end_tag_at(cursor.buffer, row, col)) {
            nest = nest + 1;
        } else if (is_start_tag_at(cursor.buffer, row, col)) {
            nest = nest - 1;
            if (nest == 0) {
                cursor.row = row;
                cursor.col = col;
                return true;
            }
        }
    }
}

// do_searchpair forwards for the end tag matching `name`.
bool did_search_close_tag(MED_motion.Cur cursor, str name) {
    int nest = 1;
    int row = cursor.row;
    int col = cursor.col;
    while (true) {
        str line = cursor.buffer.line(row);
        if (col >= line.size()) {
            if (row + 1 >= cursor.buffer.line_count()) {
                return false;
            }
            row = row + 1;
            col = 0;
        } else {
            col = MED_text.next_col(line, col);
        }
        if (is_named_start_at(cursor.buffer, row, col, name)) {
            nest = nest + 1;
        } else if (is_named_end_at(cursor.buffer, row, col, name)) {
            nest = nest - 1;
            if (nest == 0) {
                cursor.row = row;
                cursor.col = col;
                return true;
            }
        }
    }
}

// Vim's in_html_tag.
bool is_in_html_tag(MED_buffer.Buffer buffer, MED_buffer.Pos position, bool is_end_tag) {
    str line = buffer.line(position.row);
    int offset = position.col;
    while (offset > 0) {
        if (offset < line.size() && line.byte_at(offset) == 60) {
            break;
        }
        offset = MED_text.previous_col(line, offset);
        if (offset < line.size() && line.byte_at(offset) == 62) {
            break;
        }
    }
    if (offset >= line.size() || line.byte_at(offset) != 60) {
        return false;
    }
    int after = 0;
    if (offset + 1 < line.size()) {
        after = line.byte_at(offset + 1);
    }
    if (is_end_tag) {
        return after == 47;
    }
    if (after == 47) {
        return false;
    }
    MED_motion.Cur cursor = MED_motion.Cur(buffer, position.row, offset);
    int line_count_here = 0;
    while (true) {
        if (cursor.inc() < 0) {
            return false;
        }
        int char_code = cursor.char_code();
        if (char_code == 62) {
            break;
        }
        line_count_here = char_code;
    }
    return line_count_here != 47;
}

Sel current_tag(MED_buffer.Buffer buffer, MED_buffer.Pos cursor, bool is_visible, MED_buffer.Pos vstart, int count_arg, bool is_include) {
    MED_motion.Cur cursor_value = MED_motion.Cur(buffer, cursor.row, cursor.col);
    MED_buffer.Pos old_position = MED_buffer.Pos(cursor.row, cursor.col);
    MED_buffer.Pos old_end = MED_buffer.Pos(cursor.row, cursor.col);
    MED_buffer.Pos old_start = MED_buffer.Pos(cursor.row, cursor.col);
    bool should_include = is_include;
    bool is_inclusive = true;
    int count = count_arg;
    if (!is_visible || vstart.eq(cursor)) {
        while (is_in_indent(buffer.line(cursor_value.row), cursor_value.col)) {
            if (cursor_value.inc() != 0) {
                break;
            }
        }
        if (is_in_html_tag(buffer, position_of(cursor_value), false)) {
            while (cursor_value.char_code() != 62) {
                if (cursor_value.inc() < 0) {
                    break;
                }
            }
        } else if (is_in_html_tag(buffer, position_of(cursor_value), true)) {
            while (cursor_value.char_code() != 60) {
                if (cursor_value.dec() < 0) {
                    break;
                }
            }
            cursor_value.dec();
            old_end = position_of(cursor_value);
        }
    } else if (is_before(vstart, cursor)) {
        old_start = MED_buffer.Pos(vstart.row, vstart.col);
        cursor_value.row = vstart.row;
        cursor_value.col = vstart.col;
    } else {
        old_end = MED_buffer.Pos(vstart.row, vstart.col);
    }
    MED_buffer.Pos start_position = position_of(cursor_value);
    MED_buffer.Pos end_position = position_of(cursor_value);
    while (true) {
        for (int total in 0 .. count) {
            if (!did_search_open_tag(cursor_value)) {
                return failed();
            }
        }
        start_position = position_of(cursor_value);
        cursor_value.inc();
        str line = buffer.line(cursor_value.row);
        int stop = cursor_value.col;
        while (stop < line.size() && line.byte_at(stop) != 62 && !is_white(line.byte_at(stop))) {
            stop = MED_text.next_col(line, stop);
        }
        str name = line.substr(cursor_value.col, stop).to_lower();
        if (name.size() == 0) {
            return failed();
        }
        bool is_found = did_search_close_tag(cursor_value, name);
        if (!is_found || is_before(position_of(cursor_value), old_end)) {
            count = 1;
            cursor_value.row = start_position.row;
            cursor_value.col = start_position.col;
            continue;
        }
        if (should_include) {
            while (cursor_value.char_code() != 62) {
                if (cursor_value.inc() < 0) {
                    break;
                }
            }
        } else if (cursor_value.char_code() == 60 && !is_visible && cursor_value.col == 0) {
            is_inclusive = false;
        } else if (cursor_value.char_code() == 60) {
            cursor_value.dec();
        }
        end_position = position_of(cursor_value);
        if (!should_include) {
            cursor_value.row = start_position.row;
            cursor_value.col = start_position.col;
            while (cursor_value.inc() >= 0) {
                if (cursor_value.char_code() == 62) {
                    cursor_value.inc();
                    start_position = position_of(cursor_value);
                    break;
                }
            }
            cursor_value.row = end_position.row;
            cursor_value.col = end_position.col;
            if (is_visible && start_position.eq(old_start) && end_position.eq(old_end)) {
                should_include = true;
                cursor_value.row = old_start.row;
                cursor_value.col = old_start.col;
                count = count_arg;
                continue;
            }
        }
        break;
    }
    Sel sel = Sel();
    sel.start = start_position;
    if (is_visible) {
        if (is_before(end_position, start_position)) {
            sel.end = start_position;
        } else {
            sel.end = end_position;
        }
        sel.vmode = 118;
        sel.is_jump = true;
        return sel;
    }
    sel.is_jump = true;
    if (is_before(end_position, start_position)) {
        sel.end = start_position;
        sel.is_inclusive = false;
    } else {
        sel.end = end_position;
        sel.is_inclusive = is_inclusive;
    }
    return sel;
}

// ------------------------------------------------------------------- entry

// ---- ih ah: the git hunk under the cursor (m3 addition, no Vim equivalent; gitsigns has `ih`) ----

/// `hunks` holds pairs (first row, row count) of the buffer's changes against the index, ascending. `ih` is the
/// hunk's rows; `ah` adds the blank rows right after it. A hunk that only removed lines has no rows, so there
/// is nothing to select and the object fails.
Sel current_hunk(MED_buffer.Buffer buffer, MED_buffer.Pos cursor, bool is_visible, List<int> hunks, bool is_include) {
    int last = buffer.line_count() - 1;
    int pair = 0;
    while (pair + 1 < hunks.size()) {
        int first = hunks[pair];
        int stop = first + hunks[pair + 1] - 1;
        if (hunks[pair + 1] > 0 && cursor.row >= first && cursor.row <= stop) {
            if (is_include) {
                while (stop < last && is_linewhite(buffer, stop + 1)) {
                    stop = stop + 1;
                }
            }
            Sel sel = Sel();
            sel.is_linewise = true;
            sel.start = MED_buffer.Pos(first, 0);
            sel.end = MED_buffer.Pos(stop, 0);
            if (is_visible) {
                sel.vmode = 86;
            }
            return sel;
        }
        pair = pair + 2;
    }
    return failed();
}

/// The object `obj` (`w W p ( ) b { } B [ ] < > " ' `` `` s t`, and h for a git hunk) with `i` or
/// `a`. `vmode` is the Visual mode key (v, V or CTRL-V) when `is_visible`.
pub Sel select(MED_buffer.Buffer buffer, MED_buffer.Pos cursor, bool is_visible, MED_buffer.Pos vstart, int vmode, int obj, bool is_include, int count, List<int> hunks = []) {
    int total = count;
    if (total < 1) {
        total = 1;
    }
    if (obj == 104) {
        return current_hunk(buffer, cursor, is_visible, hunks, is_include);
    }
    if (obj == 119) {
        return current_word(buffer, cursor, is_visible, vstart, total, is_include, false);
    }
    if (obj == 87) {
        return current_word(buffer, cursor, is_visible, vstart, total, is_include, true);
    }
    if (obj == 116) {
        return current_tag(buffer, cursor, is_visible, vstart, total, is_include);
    }
    if (obj == 115) {
        return current_sent(buffer, cursor, is_visible, vstart, total, is_include);
    }
    if (obj == 112) {
        return current_par(buffer, cursor, is_visible, vstart, vmode, total, is_include);
    }
    if (obj == 40 || obj == 41 || obj == 98) {
        return current_block(buffer, cursor, is_visible, vstart, total, is_include, 40, 41);
    }
    if (obj == 123 || obj == 125 || obj == 66) {
        return current_block(buffer, cursor, is_visible, vstart, total, is_include, 123, 125);
    }
    if (obj == 91 || obj == 93) {
        return current_block(buffer, cursor, is_visible, vstart, total, is_include, 91, 93);
    }
    if (obj == 60 || obj == 62) {
        return current_block(buffer, cursor, is_visible, vstart, total, is_include, 60, 62);
    }
    if (obj == 34 || obj == 39 || obj == 96) {
        return current_quote(buffer, cursor, is_visible, vstart, total, is_include, obj);
    }
    return failed();
}
