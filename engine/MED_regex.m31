// Vim regular expressions: a parser for Vim's pattern syntax and a backtracking
// matcher that runs straight over the buffer's lines (so `\n` can cross lines).
//
// Why not the stdlib `regex` module: it has no backreferences, no lookaround,
// no word boundaries, no `\zs`, no lazy repeats and no multi-line matching, all
// of which `/`, `:s` and `:g` need (DESIGN.md G6). This module is the same
// kind of thing written for the editor, in m31 only.
//
// API
// ---
//   MED_regex.compile(pattern, ignorecase, smartcase, tilde)  -> Regex
//   re.ok / re.error                                          compile result
//   re.search_line(buf, row, col)   -> Match   first match in `row` starting at byte col >= col
//   re.match_at(buf, row, col)      -> Match   a match that starts exactly at (row, col)
//   Match.ok  .srow .scol .erow .ecol  (byte columns; the end is exclusive; `\zs`/`\ze` applied)
//   Match.groups                    -> List<str>  [whole, \1 .. \9]
//
// Supported: magic levels `\v \m \M \V`, `\c \C`, `. * \+ \= \? \{n,m} \{-n,m}`,
// `\| \& \( \) \%(`, `^ $ \_^ \_$ \< \> \zs \ze \%^ \%$ \%23l \%23c \%23v`,
// `\1 .. \9`, `\@= \@! \@<= \@<! \@>`, `\%[]`, `[]` collections with
// `[:alpha:]` and `\d123 \x20 €`, the character classes `\s \S \d \D ...`
// and their `\_x` forms, `\n`, `\t \e \r \b`, `\%d123 \%x2a \%u20AC`, `~`.
// `\%V` (the Visual area) and `\%'m` / `\%<'m` / `\%>'m` (marks) look at what the caller put in the Regex
// (MED_search.attach_context).
// Not supported (reported as an error or never matching): `\%#`, `\%.l`, `\z(`, composing-character pattern syntax `\%C`, `\Z`.
//
// A pattern is matched code point by code point; a combining mark never starts
// a match of `.` or a collection and a literal does not match a base character
// that is followed by a mark the pattern does not name (as Vim does).

import engine.MED_buffer;
import engine.MED_case;
import engine.MED_text;

const int OP_CHAR = 1;
const int OP_ANY = 2;
const int OP_CLASS = 3;
const int OP_SET = 4;
const int OP_NL = 5;
const int OP_BOL = 6;
const int OP_EOL = 7;
const int OP_BOW = 8;
const int OP_EOW = 9;
const int OP_ZS = 10;
const int OP_ZE = 11;
const int OP_SAVE = 12;
const int OP_BACKREF = 13;
const int OP_SPLIT = 14;
const int OP_JMP = 15;
const int OP_LOOK = 16;
const int OP_MATCH = 17;
const int OP_GSET = 18;
const int OP_GCHK = 19;
const int OP_BOF = 20;
const int OP_EOF = 21;
const int OP_LNUM = 22;
const int OP_CNUM = 23;
const int OP_VNUM = 24;
const int OP_VIS = 27;
const int OP_MARK = 28;
const int OP_FAIL = 25;
const int OP_SUBEND = 26;
const int N_CHAR = 1;
const int N_ANY = 2;
const int N_CLASS = 3;
const int N_SET = 4;
const int N_NL = 5;
const int N_BOL = 6;
const int N_EOL = 7;
const int N_BOW = 8;
const int N_EOW = 9;
const int N_ZS = 10;
const int N_ZE = 11;
const int N_GROUP = 12;
const int N_CAT = 13;
const int N_ALT = 14;
const int N_REPEAT = 15;
const int N_BACKREF = 16;
const int N_LOOK = 17;
const int N_EMPTY = 18;
const int N_BOF = 19;
const int N_EOF = 20;
const int N_LNUM = 21;
const int N_CNUM = 22;
const int N_VNUM = 23;
const int N_NEVER = 24;
const int N_VIS = 25;
const int N_MARK = 26;
const int LK_AHEAD = 0;
const int LK_NOT_AHEAD = 1;
const int LK_BEHIND = 2;
const int LK_NOT_BEHIND = 3;
const int LK_ATOMIC = 4;
const int STEP_LIMIT = 30000000;
const int SHIFT = 4294967296;

pub type Match {
    pub bool is_ok = false;
    pub int srow = 0;
    pub int scol = 0;
    pub int erow = 0;
    pub int ecol = 0;
    /// The whole match, then \1 .. \9 (empty when a group did not take part).
    pub List<str> groups = [];
    /// The search gave up (too many steps).
    pub bool is_aborted = false;
}

pub type Regex {
    pub bool is_ok = true;
    pub str error = "";
    pub bool is_icase = false;
    pub int ngroups = 0;
    /// Bit n is set once group n has been closed (a back reference needs it).
    pub int ended = 0;
    /// Back references to a group not closed yet (an error unless look-behind applies to them).
    pub List<int> bad_refs = [];
    pub List<int> opcodes = [];
    pub List<int> program_a = [];
    pub List<int> program_b = [];
    pub List<List<int>> set_lo = [];
    pub List<List<int>> set_hi = [];
    pub List<bool> set_neg = [];
    pub List<bool> set_nl = [];
    pub int nguards = 0;
    /// A first literal character every match must start with, or -1.
    pub int first = -1;
    /// What `\%V` and `\%'m` look at; the caller sets them (MED_search.attach_context): the Visual area as
    /// kind (118 v, 86 V, 22 CTRL-V; 0: none), first and last position, the block's display columns,
    /// and the marks by name.
    pub int vis_kind = 0;
    pub int vis_row1 = 0;
    pub int vis_col1 = 0;
    pub int vis_row2 = 0;
    pub int vis_col2 = 0;
    pub int vis_left = 0;
    pub int vis_right = 0;
    pub Map<str, MED_buffer.Pos> marks = {};
    // ---- parser state
    List<int> codes = [];
    int index = 0;
    int magic = 2;
    bool is_at_start = true;
    bool is_previous_at_start = false;
    int previous_ch = -1;
    bool is_previous_mg = false;
    int token = -1;
    bool is_magic = false;
    int length = 0;
    int icase_flag = -1;
    str tilde = "";
    List<int> next_key = [];
    List<int> node_first = [];
    List<int> node_second = [];
    List<int> next_col = [];
    List<List<int>> nkids = [];
}

int Regex.node(int kind, int left, int right, List<int> kids) {
    next_key.push(kind);
    node_first.push(left);
    node_second.push(right);
    next_col.push(0);
    nkids.push(kids);
    return next_key.size() - 1;
}

bool Regex.did_fail(str message) {
    if (is_ok) {
        is_ok = false;
        error = message;
    }
    return false;
}

// Look at the next token without consuming it: `tok`, whether it is magic
// (`mg`) and how many pattern characters it spans (`len`). Vim's peekchr().
void Regex.peek() {
    int count = codes.size();
    if (index >= count) {
        token = -1;
        is_magic = false;
        length = 0;
        return;
    }
    int char_code = codes[index];
    token = char_code;
    is_magic = false;
    length = 1;
    if (char_code == 94) {
        if (magic >= 1 && (is_at_start || magic == 3 || (is_previous_mg && (previous_ch == 40 || previous_ch == 124 || previous_ch == 38 || previous_ch == 110)))) {
            is_magic = true;
        }
    } else if (char_code == 36) {
        if (magic >= 1) {
            int other_index = index + 1;
            bool is_all = magic == 3;
            while (other_index + 1 < count && codes[other_index] == 92 && (codes[other_index + 1] == 99 || codes[other_index + 1] == 67 || codes[other_index + 1] == 109 || codes[other_index + 1] == 77 || codes[other_index + 1] == 118 || codes[other_index + 1] == 86 || codes[other_index + 1] == 90)) {
                if (codes[other_index + 1] == 118) {
                    is_all = true;
                } else if (codes[other_index + 1] == 109 || codes[other_index + 1] == 77 || codes[other_index + 1] == 86) {
                    is_all = false;
                }
                other_index = other_index + 2;
            }
            if (other_index >= count) {
                is_magic = true;
            } else if (codes[other_index] == 92 && other_index + 1 < count && (codes[other_index + 1] == 124 || codes[other_index + 1] == 38 || codes[other_index + 1] == 41 || codes[other_index + 1] == 110)) {
                is_magic = true;
            } else if (is_all && (codes[other_index] == 124 || codes[other_index] == 38 || codes[other_index] == 41)) {
                is_magic = true;
            } else if (magic == 3) {
                is_magic = true;
            }
        }
    } else if (char_code == 42) {
        if (magic >= 2 && !is_at_start && !(is_previous_at_start && is_previous_mg && previous_ch == 94) && !(is_previous_mg && (previous_ch == 40 || previous_ch == 38 || previous_ch == 124))) {
            is_magic = true;
        }
    } else if (char_code == 46 || char_code == 91 || char_code == 126) {
        if (magic >= 2) {
            is_magic = true;
        }
    } else if (char_code == 40 || char_code == 41 || char_code == 123 || char_code == 37 || char_code == 43 || char_code == 61 || char_code == 63 || char_code == 64 || char_code == 38 || char_code == 124 || char_code == 60 || char_code == 62) {
        if (magic == 3) {
            is_magic = true;
        }
    } else if (char_code == 92) {
        if (index + 1 >= count) {
            return;
        }
        int delta = codes[index + 1];
        length = 2;
        if (is_meta(delta)) {
            token = delta;
            if (delta == 42) {
                is_magic = !(magic >= 2);
            } else {
                is_magic = !is_default_magic(magic, delta);
            }
        } else if (delta == 101) {
            token = 27;
        } else if (delta == 116) {
            token = 9;
        } else if (delta == 114) {
            token = 13;
        } else if (delta == 98) {
            token = 8;
        } else if (magic == 0 && (delta == 36 || delta == 94)) {
            token = delta;
            is_magic = true;
        } else {
            token = delta;
        }
    }
}

void Regex.advance() {
    is_previous_at_start = is_at_start;
    is_at_start = false;
    previous_ch = token;
    is_previous_mg = is_magic;
    index = index + length;
}

// Consume a token that changes no parse state (\c \v ...).
void Regex.keepstart() {
    index = index + length;
}

int Regex.raw() {
    if (index >= codes.size()) {
        return -1;
    }
    int char_code = codes[index];
    index = index + 1;
    return char_code;
}

int Regex.number() {
    int value = -1;
    while (index < codes.size() && is_digit(codes[index])) {
        if (value < 0) {
            value = 0;
        }
        value = value * 10 + (codes[index] - 48);
        index = index + 1;
    }
    return value;
}

int Regex.parse_alt(int depth) {
    List<int> branches = [parse_branch(depth)];
    while (is_ok) {
        peek();
        if (is_magic && token == 124) {
            advance();
            branches.push(parse_branch(depth));
        } else {
            break;
        }
    }
    if (branches.size() == 1) {
        return branches[0];
    }
    return node(N_ALT, 0, 0, branches);
}

int Regex.parse_branch(int depth) {
    List<int> parts = [parse_concat(depth)];
    while (is_ok) {
        peek();
        if (is_magic && token == 38) {
            advance();
            parts.push(parse_concat(depth));
        } else {
            break;
        }
    }
    if (parts.size() == 1) {
        return parts[0];
    }
    List<int> kids = [];
    for (int key in 0 .. parts.size() - 1) {
        kids.push(node(N_LOOK, LK_AHEAD, 0, [parts[key]]));
    }
    kids.push(parts[parts.size() - 1]);
    return node(N_CAT, 0, 0, kids);
}

int Regex.parse_concat(int depth) {
    List<int> kids = [];
    while (is_ok) {
        peek();
        if (token == -1) {
            break;
        }
        if (is_magic && (token == 124 || token == 38)) {
            break;
        }
        if (is_magic && token == 41) {
            if (depth == 0) {
                did_fail("E55: Unmatched \\)");
            }
            break;
        }
        if (is_magic && (token == 99 || token == 67 || token == 118 || token == 109 || token == 77 || token == 86 || token == 90)) {
            if (token == 99) {
                icase_flag = 1;
            } else if (token == 67) {
                icase_flag = 0;
            } else if (token == 118) {
                magic = 3;
            } else if (token == 109) {
                magic = 2;
            } else if (token == 77) {
                magic = 1;
            } else if (token == 86) {
                magic = 0;
            }
            keepstart();
            continue;
        }
        int piece = parse_piece(depth);
        if (piece >= 0) {
            kids.push(piece);
        }
    }
    if (kids.size() == 0) {
        return node(N_EMPTY, 0, 0, []);
    }
    if (kids.size() == 1) {
        return kids[0];
    }
    return node(N_CAT, 0, 0, kids);
}

int Regex.parse_piece(int depth) {
    int atom = parse_atom(depth);
    if (!is_ok || atom < 0) {
        return atom;
    }
    for (int once in 0 .. 1) {
        peek();
        if (!is_magic) {
            break;
        }
        int target = token;
        if ((next_key[atom] == N_ZS || next_key[atom] == N_ZE) && (target == 42 || target == 43 || target == 123)) {
            did_fail("E64: Nothing to repeat");
            return -1;
        }
        if (target == 42) {
            advance();
            atom = node(N_REPEAT, 0, -1, [atom]);
            next_col[atom] = 1;
        } else if (target == 43) {
            advance();
            atom = node(N_REPEAT, 1, -1, [atom]);
            next_col[atom] = 1;
        } else if (target == 61 || target == 63) {
            advance();
            atom = node(N_REPEAT, 0, 1, [atom]);
            next_col[atom] = 1;
        } else if (target == 123) {
            advance();
            bool is_lazy = false;
            if (index < codes.size() && codes[index] == 45) {
                is_lazy = true;
                index = index + 1;
            }
            int low = number();
            int high = low;
            if (index < codes.size() && codes[index] == 44) {
                index = index + 1;
                high = number();
            } else if (low < 0) {
                high = -1;
            }
            if (low < 0) {
                low = 0;
            }
            if (index < codes.size() && codes[index] == 92) {
                index = index + 1;
            }
            if (index < codes.size() && codes[index] == 125) {
                index = index + 1;
            } else {
                did_fail("E554: Syntax error in \\{...}");
                return -1;
            }
            if (high >= 0 && low > high) {
                int temp = low;
                low = high;
                high = temp;
            }
            atom = node(N_REPEAT, low, high, [atom]);
            if (is_lazy) {
                next_col[atom] = 0;
            } else {
                next_col[atom] = 1;
            }
        } else if (target == 64) {
            advance();
            int limit = number();
            int kind = -1;
            if (index < codes.size()) {
                int delta = codes[index];
                if (delta == 61) {
                    kind = LK_AHEAD;
                    index = index + 1;
                } else if (delta == 33) {
                    kind = LK_NOT_AHEAD;
                    index = index + 1;
                } else if (delta == 62) {
                    kind = LK_ATOMIC;
                    index = index + 1;
                } else if (delta == 60 && index + 1 < codes.size()) {
                    if (codes[index + 1] == 61) {
                        kind = LK_BEHIND;
                        index = index + 2;
                    } else if (codes[index + 1] == 33) {
                        kind = LK_NOT_BEHIND;
                        index = index + 2;
                    }
                }
            }
            if (kind < 0) {
                did_fail("E59: Invalid character after \\@");
                return -1;
            }
            if (kind == LK_BEHIND || kind == LK_NOT_BEHIND) {
                bad_refs.clear();
            }
            atom = node(N_LOOK, kind, limit, [atom]);
        } else {
            break;
        }
        // A multi cannot follow a multi (Vim's E61 / E62).
        peek();
        if (is_ok && is_magic && (token == 42 || token == 43 || token == 61 || token == 63 || token == 123 || token == 64)) {
            did_fail("E62: Nested multi");
            return -1;
        }
    }
    return atom;
}

// A literal string's nodes, for `~`.
int Regex.literal_nodes(List<int> chars) {
    if (chars.size() == 0) {
        return node(N_EMPTY, 0, 0, []);
    }
    List<int> kids = [];
    for (int char_code in chars) {
        kids.push(node(N_CHAR, char_code, 0, []));
    }
    return node(N_CAT, 0, 0, kids);
}

int Regex.parse_atom(int depth) {
    peek();
    if (token == -1) {
        return node(N_EMPTY, 0, 0, []);
    }
    int target = token;
    if (!is_magic) {
        advance();
        return node(N_CHAR, target, 0, []);
    }
    if (target == 94) {
        advance();
        return node(N_BOL, 0, 0, []);
    }
    if (target == 36) {
        advance();
        return node(N_EOL, 0, 0, []);
    }
    if (target == 46) {
        advance();
        return node(N_ANY, 0, 0, []);
    }
    if (target == 60) {
        advance();
        return node(N_BOW, 0, 0, []);
    }
    if (target == 62) {
        advance();
        return node(N_EOW, 0, 0, []);
    }
    if (target == 126) {
        advance();
        return literal_nodes(tilde.chars());
    }
    if (target == 110) {
        advance();
        return node(N_NL, 0, 0, []);
    }
    if (target == 40) {
        advance();
        if (ngroups >= 9) {
            did_fail("E51: Too many \\(");
            return -1;
        }
        ngroups = ngroups + 1;
        int group_number = ngroups;
        int inner = parse_alt(depth + 1);
        peek();
        if (!(is_magic && token == 41)) {
            did_fail("E54: Unmatched \\(");
            return -1;
        }
        advance();
        ended = ended | (1 << group_number);
        return node(N_GROUP, group_number, 0, [inner]);
    }
    if (target == 37) {
        advance();
        return parse_percent(depth);
    }
    if (target == 91) {
        int save = index;
        advance();
        int set = parse_collection(false);
        if (set >= 0) {
            return set;
        }
        index = save + length;
        return node(N_CHAR, 91, 0, []);
    }
    if (target == 122) {
        advance();
        int delta = raw();
        if (delta == 115) {
            return node(N_ZS, 0, 0, []);
        }
        if (delta == 101) {
            return node(N_ZE, 0, 0, []);
        }
        did_fail("E68: Invalid character after \\z");
        return -1;
    }
    if (target >= 49 && target <= 57) {
        advance();
        int ref = node(N_BACKREF, target - 48, 0, []);
        if ((ended & (1 << (target - 48))) == 0) {
            bad_refs.push(ref);
        }
        return ref;
    }
    if (target == 95) {
        advance();
        int delta = raw();
        if (delta == 94) {
            return node(N_BOL, 0, 0, []);
        }
        if (delta == 36) {
            return node(N_EOL, 0, 0, []);
        }
        if (delta == 46) {
            return node(N_ANY, 1, 0, []);
        }
        if (delta == 91) {
            int set = parse_collection(true);
            if (set < 0) {
                did_fail("E769: Missing ] after \\_[");
                return -1;
            }
            return set;
        }
        if (is_class_letter(delta)) {
            return node(N_CLASS, delta, 1, []);
        }
        did_fail("E63: Invalid use of \\_");
        return -1;
    }
    if (is_class_letter(target)) {
        advance();
        return node(N_CLASS, target, 0, []);
    }
    if (target == 42 || target == 43 || target == 61 || target == 63 || target == 123 || target == 64) {
        did_fail("E64: Nothing to repeat");
        return -1;
    }
    advance();
    return node(N_CHAR, target, 0, []);
}


// Whether the position (row, byte col) is inside the Visual area `\%V` was given.
pub bool Regex.is_in_visual(MED_buffer.Buffer buffer, int row, int col) {
    if (vis_kind == 0 || row < vis_row1 || row > vis_row2) {
        return false;
    }
    if (vis_kind == 86) {
        return true;
    }
    if (vis_kind == 22) {
        int shown = MED_text.display_col(buffer.line(row), col, 8);
        return shown >= vis_left && shown <= vis_right;
    }
    if (row == vis_row1 && col < vis_col1) {
        return false;
    }
    if (row == vis_row2 && col > vis_col2) {
        return false;
    }
    return true;
}

// `\%'m` (cmp 0), `\%<'m` (1) and `\%>'m` (2): the position against mark `name`.
pub bool Regex.is_at_mark(int name, int cmp, int row, int col) {
    Option<MED_buffer.Pos> found = marks.get(str.from_chars([name]));
    match (found) {
        case Some(MED_buffer.Pos place): {
            if (cmp == 1) {
                return row < place.row || (row == place.row && col < place.col);
            }
            if (cmp == 2) {
                return row > place.row || (row == place.row && col > place.col);
            }
            return row == place.row && col == place.col;
        }
        case None: {
            return false;
        }
    }
}

int Regex.hex_digits(int max) {
    int value = -1;
    int count = 0;
    while (count < max && index < codes.size() && is_hex(codes[index])) {
        int delta = codes[index];
        int amount = 0;
        if (is_digit(delta)) {
            amount = delta - 48;
        } else if (delta >= 97) {
            amount = delta - 87;
        } else {
            amount = delta - 55;
        }
        if (value < 0) {
            value = 0;
        }
        value = value * 16 + amount;
        index = index + 1;
        count = count + 1;
    }
    return value;
}

int Regex.parse_percent(int depth) {
    int delta = raw();
    if (delta == 40) {
        int inner = parse_alt(depth + 1);
        peek();
        if (!(is_magic && token == 41)) {
            did_fail("E53: Unmatched \\%(");
            return -1;
        }
        advance();
        return inner;
    }
    if (delta == 94) {
        return node(N_BOF, 0, 0, []);
    }
    if (delta == 36) {
        return node(N_EOF, 0, 0, []);
    }
    if (delta == 100) {
        int value = number();
        if (value < 0) {
            did_fail("E678: Invalid character after \\%[dxouU]");
            return -1;
        }
        return node(N_CHAR, value, 0, []);
    }
    if (delta == 120 || delta == 117 || delta == 85) {
        int maxd = 2;
        if (delta == 117) {
            maxd = 4;
        } else if (delta == 85) {
            maxd = 8;
        }
        int value = hex_digits(maxd);
        if (value < 0) {
            did_fail("E678: Invalid character after \\%[dxouU]");
            return -1;
        }
        return node(N_CHAR, value, 0, []);
    }
    if (delta == 111) {
        int value = 0;
        int count = 0;
        while (count < 4 && index < codes.size() && codes[index] >= 48 && codes[index] <= 55) {
            value = value * 8 + (codes[index] - 48);
            index = index + 1;
            count = count + 1;
        }
        if (count == 0) {
            did_fail("E678: Invalid character after \\%[dxouU]");
            return -1;
        }
        return node(N_CHAR, value, 0, []);
    }
    if (delta == 91) {
        // \%[abc]: a sequence of optional atoms
        List<int> atoms = [];
        while (is_ok && index < codes.size() && codes[index] != 93) {
            int left = parse_atom(depth);
            if (left < 0) {
                return -1;
            }
            atoms.push(left);
        }
        if (index >= codes.size()) {
            did_fail("E69: Missing ] after \\%[");
            return -1;
        }
        index = index + 1;
        if (atoms.size() == 0) {
            did_fail("E70: Empty \\%[]");
            return -1;
        }
        int acc = -1;
        int key = atoms.size() - 1;
        while (key >= 0) {
            List<int> pair = [atoms[key]];
            if (acc >= 0) {
                pair.push(acc);
            }
            int seq = node(N_CAT, 0, 0, pair);
            int opt = node(N_REPEAT, 0, 1, [seq]);
            next_col[opt] = 1;
            acc = opt;
            key = key - 1;
        }
        return acc;
    }
    int cmp = 0;
    if (delta == 60) {
        cmp = 1;
        delta = raw();
    } else if (delta == 62) {
        cmp = 2;
        delta = raw();
    }
    if (delta == 86) {
        return node(N_VIS, 0, 0, []);
    }
    if (delta == 39) {
        // \%'m, \%<'m, \%>'m: at, before or after mark m
        int name = raw();
        if (name < 0) {
            did_fail("E71: Invalid character after \\%");
            return -1;
        }
        return node(N_MARK, name, cmp, []);
    }
    if (delta == 46) {
        did_fail("E71: Invalid character after \\%: unsupported");
        return -1;
    }
    if (delta >= 48 && delta <= 57) {
        index = index - 1;
        int value = number();
        int what = raw();
        if (what == 108) {
            return node(N_LNUM, value, cmp, []);
        }
        if (what == 99) {
            return node(N_CNUM, value, cmp, []);
        }
        if (what == 118) {
            return node(N_VNUM, value, cmp, []);
        }
    }
    did_fail("E71: Invalid character after \\%");
    return -1;
}

void Regex.add_range(List<int> lows, List<int> highs, int left, int right) {
    lows.push(left);
    highs.push(right);
}

// Characters named in `[:name:]`; false when the name is unknown.
bool Regex.is_named_class(List<int> lows, List<int> highs, str name) {
    if (name == "alpha") {
        add_range(lows, highs, 65, 90);
        add_range(lows, highs, 97, 122);
    } else if (name == "digit") {
        add_range(lows, highs, 48, 57);
    } else if (name == "alnum") {
        add_range(lows, highs, 48, 57);
        add_range(lows, highs, 65, 90);
        add_range(lows, highs, 97, 122);
    } else if (name == "lower") {
        // exact (never case-folded), like nvim: ranges are offset by EXACT
        add_range(lows, highs, EXACT + 97, EXACT + 122);
    } else if (name == "upper") {
        add_range(lows, highs, EXACT + 65, EXACT + 90);
    } else if (name == "space") {
        add_range(lows, highs, 9, 13);
        add_range(lows, highs, 32, 32);
    } else if (name == "blank") {
        add_range(lows, highs, 9, 9);
        add_range(lows, highs, 32, 32);
    } else if (name == "punct") {
        add_range(lows, highs, 33, 47);
        add_range(lows, highs, 58, 64);
        add_range(lows, highs, 91, 96);
        add_range(lows, highs, 123, 126);
    } else if (name == "xdigit") {
        add_range(lows, highs, 48, 57);
        add_range(lows, highs, 65, 70);
        add_range(lows, highs, 97, 102);
    } else if (name == "cntrl") {
        add_range(lows, highs, 0, 31);
        add_range(lows, highs, 127, 127);
    } else if (name == "print") {
        add_range(lows, highs, 32, 126);
    } else if (name == "graph") {
        add_range(lows, highs, 33, 126);
    } else if (name == "return") {
        add_range(lows, highs, 13, 13);
    } else if (name == "tab") {
        add_range(lows, highs, 9, 9);
    } else if (name == "escape") {
        add_range(lows, highs, 27, 27);
    } else if (name == "backspace") {
        add_range(lows, highs, 8, 8);
    } else {
        return false;
    }
    return true;
}

// Parse a `[...]` collection; `i` is just after the `[`. Returns the node or
// -1 (and leaves `i` where it was) when the collection is not closed.
int Regex.parse_collection(bool is_newline) {
    int start = index;
    int total = codes.size();
    int other_index = index;
    bool is_negate = false;
    if (other_index < total && codes[other_index] == 94) {
        is_negate = true;
        other_index = other_index + 1;
    }
    List<int> lows = [];
    List<int> highs = [];
    bool has_nl = is_newline;
    bool is_leading = true;
    bool is_closed = false;
    while (other_index < total) {
        int char_code = codes[other_index];
        if (char_code == 93 && !is_leading) {
            is_closed = true;
            other_index = other_index + 1;
            break;
        }
        is_leading = false;
        int left = char_code;
        other_index = other_index + 1;
        if (char_code == 91 && other_index < total && codes[other_index] == 58) {
            int key = other_index + 1;
            List<int> name = [];
            while (key < total && codes[key] != 58 && key < other_index + 12) {
                name.push(codes[key]);
                key = key + 1;
            }
            if (key + 1 < total && codes[key] == 58 && codes[key + 1] == 93) {
                if (is_named_class(lows, highs, str.from_chars(name))) {
                    other_index = key + 2;
                    continue;
                }
            }
        }
        if (char_code == 91 && other_index < total && (codes[other_index] == 61 || codes[other_index] == 46)) {
            int key = other_index + 1;
            if (key + 2 < total && codes[key + 1] == codes[other_index] && codes[key + 2] == 93) {
                left = codes[key];
                other_index = key + 3;
            }
        }
        if (char_code == 92 && other_index < total) {
            int stop = codes[other_index];
            if (stop == 101) {
                left = 27;
                other_index = other_index + 1;
            } else if (stop == 116) {
                left = 9;
                other_index = other_index + 1;
            } else if (stop == 114) {
                left = 13;
                other_index = other_index + 1;
            } else if (stop == 98) {
                left = 8;
                other_index = other_index + 1;
            } else if (stop == 110) {
                has_nl = true;
                other_index = other_index + 1;
                continue;
            } else if (stop == 92 || stop == 93 || stop == 94 || stop == 45) {
                left = stop;
                other_index = other_index + 1;
            } else if (stop == 100 || stop == 111 || stop == 120 || stop == 117 || stop == 85) {
                int save_i = index;
                index = other_index + 1;
                int value = -1;
                if (stop == 100) {
                    value = number();
                } else if (stop == 111) {
                    value = 0;
                    int count = 0;
                    while (count < 4 && index < total && codes[index] >= 48 && codes[index] <= 55) {
                        value = value * 8 + (codes[index] - 48);
                        index = index + 1;
                        count = count + 1;
                    }
                    if (count == 0) {
                        value = -1;
                    }
                } else if (stop == 120) {
                    value = hex_digits(2);
                } else if (stop == 117) {
                    value = hex_digits(4);
                } else {
                    value = hex_digits(8);
                }
                if (value >= 0) {
                    left = value;
                    other_index = index;
                }
                index = save_i;
            }
        }
        // a range a-b ?
        if (other_index + 1 < total && codes[other_index] == 45 && codes[other_index + 1] != 93) {
            int right = codes[other_index + 1];
            int nextj = other_index + 2;
            if (right == 92 && other_index + 2 < total) {
                int stop = codes[other_index + 2];
                if (stop == 101) {
                    right = 27;
                    nextj = other_index + 3;
                } else if (stop == 116) {
                    right = 9;
                    nextj = other_index + 3;
                } else if (stop == 114) {
                    right = 13;
                    nextj = other_index + 3;
                } else if (stop == 98) {
                    right = 8;
                    nextj = other_index + 3;
                } else if (stop == 92 || stop == 93 || stop == 94 || stop == 45) {
                    right = stop;
                    nextj = other_index + 3;
                }
            }
            if (right < left) {
                did_fail("E944: Reverse range in character class");
                return -1;
            }
            add_range(lows, highs, left, right);
            other_index = nextj;
        } else {
            add_range(lows, highs, left, left);
        }
    }
    if (!is_closed) {
        index = start;
        return -1;
    }
    index = other_index;
    // the token state: a collection is an atom
    is_previous_at_start = is_at_start;
    is_at_start = false;
    previous_ch = 91;
    is_previous_mg = true;
    set_lo.push(lows);
    set_hi.push(highs);
    set_neg.push(is_negate);
    set_nl.push(has_nl);
    return node(N_SET, set_lo.size() - 1, 0, []);
}

bool Regex.can_be_empty(int count) {
    int key = next_key[count];
    if (key == N_CHAR || key == N_ANY || key == N_CLASS || key == N_SET || key == N_NL) {
        return false;
    }
    if (key == N_GROUP) {
        return can_be_empty(nkids[count][0]);
    }
    if (key == N_CAT) {
        for (int kid in nkids[count]) {
            if (!can_be_empty(kid)) {
                return false;
            }
        }
        return true;
    }
    if (key == N_ALT) {
        for (int kid in nkids[count]) {
            if (can_be_empty(kid)) {
                return true;
            }
        }
        return false;
    }
    if (key == N_REPEAT) {
        return node_first[count] == 0 || can_be_empty(nkids[count][0]);
    }
    return true;
}

int Regex.emit(int opcode, int left, int right) {
    opcodes.push(opcode);
    program_a.push(left);
    program_b.push(right);
    return opcodes.size() - 1;
}

void Regex.gen(int count) {
    int key = next_key[count];
    if (key == N_CHAR) {
        int char_code = node_first[count];
        if (is_icase) {
            char_code = fold(char_code);
        }
        emit(OP_CHAR, char_code, 0);
    } else if (key == N_ANY) {
        emit(OP_ANY, node_first[count], 0);
    } else if (key == N_CLASS) {
        emit(OP_CLASS, node_first[count], node_second[count]);
    } else if (key == N_SET) {
        emit(OP_SET, node_first[count], 0);
    } else if (key == N_NL) {
        emit(OP_NL, 0, 0);
    } else if (key == N_BOL) {
        emit(OP_BOL, 0, 0);
    } else if (key == N_EOL) {
        emit(OP_EOL, 0, 0);
    } else if (key == N_BOW) {
        emit(OP_BOW, 0, 0);
    } else if (key == N_EOW) {
        emit(OP_EOW, 0, 0);
    } else if (key == N_ZS) {
        emit(OP_ZS, 0, 0);
    } else if (key == N_ZE) {
        emit(OP_ZE, 0, 0);
    } else if (key == N_BOF) {
        emit(OP_BOF, 0, 0);
    } else if (key == N_EOF) {
        emit(OP_EOF, 0, 0);
    } else if (key == N_LNUM) {
        emit(OP_LNUM, node_first[count], node_second[count]);
    } else if (key == N_CNUM) {
        emit(OP_CNUM, node_first[count], node_second[count]);
    } else if (key == N_VNUM) {
        emit(OP_VNUM, node_first[count], node_second[count]);
    } else if (key == N_VIS) {
        emit(OP_VIS, 0, 0);
    } else if (key == N_MARK) {
        emit(OP_MARK, node_first[count], node_second[count]);
    } else if (key == N_NEVER) {
        emit(OP_FAIL, 0, 0);
    } else if (key == N_EMPTY) {
        // nothing
    } else if (key == N_BACKREF) {
        emit(OP_BACKREF, node_first[count], 0);
    } else if (key == N_GROUP) {
        emit(OP_SAVE, node_first[count] * 2, 0);
        gen(nkids[count][0]);
        emit(OP_SAVE, node_first[count] * 2 + 1, 0);
    } else if (key == N_CAT) {
        for (int kid in nkids[count]) {
            gen(kid);
        }
    } else if (key == N_ALT) {
        List<int> kids = nkids[count];
        List<int> jumps = [];
        for (int kid_index in 0 .. kids.size()) {
            if (kid_index < kids.size() - 1) {
                int split = emit(OP_SPLIT, 0, 0);
                program_a[split] = split + 1;
                gen(kids[kid_index]);
                jumps.push(emit(OP_JMP, 0, 0));
                program_b[split] = opcodes.size();
            } else {
                gen(kids[kid_index]);
            }
        }
        for (int other_index in jumps) {
            program_a[other_index] = opcodes.size();
        }
    } else if (key == N_LOOK) {
        int limit = node_second[count];
        if (limit < 0) {
            limit = 0;
        }
        int look = emit(OP_LOOK, node_first[count] + 8 * limit, 0);
        gen(nkids[count][0]);
        emit(OP_SUBEND, 0, 0);
        program_b[look] = opcodes.size();
    } else if (key == N_REPEAT) {
        gen_repeat(count);
    }
}

void Regex.gen_repeat(int count) {
    int low = node_first[count];
    int high = node_second[count];
    bool is_greedy = next_col[count] == 1;
    int body = nkids[count][0];
    bool is_empty = can_be_empty(body);
    if (low > 1000) {
        low = 1000;
    }
    if (high > 1000) {
        high = 1000;
    }
    for (int replacement in 0 .. low) {
        gen(body);
    }
    if (high < 0) {
        int guard = -1;
        if (is_empty) {
            guard = nguards;
            nguards = nguards + 1;
        }
        int split = emit(OP_SPLIT, 0, 0);
        if (guard >= 0) {
            emit(OP_GSET, guard, 0);
        }
        gen(body);
        if (guard >= 0) {
            emit(OP_GCHK, guard, 0);
        }
        emit(OP_JMP, split, 0);
        int after = opcodes.size();
        if (is_greedy) {
            program_a[split] = split + 1;
            program_b[split] = after;
        } else {
            program_a[split] = after;
            program_b[split] = split + 1;
        }
    } else {
        List<int> splits = [];
        for (int replacement in low .. high) {
            int split = emit(OP_SPLIT, 0, 0);
            splits.push(split);
            gen(body);
        }
        int after = opcodes.size();
        for (int split in splits) {
            if (is_greedy) {
                program_a[split] = split + 1;
                program_b[split] = after;
            } else {
                program_a[split] = after;
                program_b[split] = split + 1;
            }
        }
    }
}

Run Regex.runner(MED_buffer.Buffer buffer) {
    Run run = Run(buffer);
    run.nlines = buffer.line_count();
    run.gbase = (ngroups + 1) * 2;
    return run;
}

int Regex.runner_slots() {
    return (ngroups + 1) * 2 + nguards;
}

/// A match starting exactly at (row, col), or `ok == false`.
pub Match Regex.match_at(MED_buffer.Buffer buffer, int row, int col) {
    Run run = runner(buffer);
    int code_index = run.cp_index(row, col);
    if (did_go_start(run, row, code_index)) {
        return run.result(this, row, code_index);
    }
    Match none = Match();
    none.is_aborted = run.is_aborted;
    return none;
}

bool Regex.did_go_start(Run run, int row, int code_index) {
    run.saves = [];
    for (int key in 0 .. runner_slots()) {
        run.saves.push(-1);
    }
    run.stack = [];
    return run.did_run_from(this, 0, row, code_index);
}

/// The first match in `row` that starts at byte column `col` or later.
pub Match Regex.search_line(MED_buffer.Buffer buffer, int row, int col) {
    Run run = runner(buffer);
    run.load(row);
    int count = run.cps.size();
    int code_index = run.cp_index(row, col);
    while (code_index <= count) {
        bool is_try_here = true;
        if (first >= 0) {
            is_try_here = code_index < count && run.cps[code_index] == first;
        }
        if (is_try_here) {
            if (did_go_start(run, row, code_index)) {
                return run.result(this, row, code_index);
            }
            if (run.is_aborted) {
                break;
            }
            run.load(row);
        }
        code_index = code_index + 1;
        while (code_index < count && is_combining(run.cps[code_index])) {
            code_index = code_index + 1;
        }
    }
    Match none = Match();
    none.is_aborted = run.is_aborted;
    return none;
}

const int EXACT = 16777216;

// ------------------------------------------------------------ tiny helpers

bool is_combining(int code_point) {
    if (code_point < 768) {
        return false;
    }
    return (code_point >= 768 && code_point <= 879) || (code_point >= 6832 && code_point <= 6911) || (code_point >= 7616 && code_point <= 7679) || (code_point >= 8400 && code_point <= 8447) || (code_point >= 65024 && code_point <= 65039) || (code_point >= 65056 && code_point <= 65071) || code_point == 8205;
}

int utf8_length(int code_point) {
    if (code_point < 128) {
        return 1;
    }
    if (code_point < 2048) {
        return 2;
    }
    if (code_point < 65536) {
        return 3;
    }
    return 4;
}

bool is_alpha(int char_code) {
    return (char_code >= 65 && char_code <= 90) || (char_code >= 97 && char_code <= 122);
}

bool is_digit(int char_code) {
    return char_code >= 48 && char_code <= 57;
}

bool is_hex(int char_code) {
    return is_digit(char_code) || (char_code >= 97 && char_code <= 102) || (char_code >= 65 && char_code <= 70);
}

int fold(int char_code) {
    return MED_case.lower_cp(char_code);
}

bool is_class_ok(int letter, int char_code, List<int> keywords) {
    bool is_negate = letter >= 65 && letter <= 90;
    int low = letter;
    if (is_negate) {
        low = letter + 32;
    }
    bool is_result = false;
    if (letter == 73 || letter == 75 || letter == 70 || letter == 80) {
        // I K F P: like i k f p without digits
        int base = letter + 32;
        return !is_digit(char_code) && is_class_ok(base, char_code, keywords);
    }
    if (low == 105) {
        is_result = is_alpha(char_code) || is_digit(char_code) || char_code == 95 || (char_code >= 192 && char_code <= 255);
    } else if (low == 107) {
        is_result = MED_text.class_in(char_code, keywords) >= 2 && char_code > 0;
    } else if (low == 102) {
        is_result = is_alpha(char_code) || is_digit(char_code) || char_code == 47 || char_code == 46 || char_code == 45 || char_code == 95 || char_code == 43 || char_code == 44 || char_code == 35 || char_code == 36 || char_code == 37 || char_code == 126 || char_code == 61 || char_code >= 192;
    } else if (low == 112) {
        is_result = (char_code >= 32 && char_code != 127 && char_code < 128) || char_code >= 160;
    } else if (low == 115) {
        is_result = char_code == 32 || char_code == 9;
    } else if (low == 100) {
        is_result = is_digit(char_code);
    } else if (low == 120) {
        is_result = is_hex(char_code);
    } else if (low == 111) {
        is_result = char_code >= 48 && char_code <= 55;
    } else if (low == 119) {
        is_result = is_alpha(char_code) || is_digit(char_code) || char_code == 95;
    } else if (low == 104) {
        is_result = is_alpha(char_code) || char_code == 95;
    } else if (low == 97) {
        is_result = is_alpha(char_code);
    } else if (low == 108) {
        is_result = char_code >= 97 && char_code <= 122;
    } else if (low == 117) {
        is_result = char_code >= 65 && char_code <= 90;
    }
    if (is_negate) {
        return !is_result;
    }
    return is_result;
}

// ------------------------------------------------------------------ parser

bool is_default_magic(int magic, int char_code) {
    if (char_code == 46 || char_code == 91 || char_code == 126 || char_code == 42) {
        return magic >= 2;
    }
    if (char_code == 40 || char_code == 41 || char_code == 123 || char_code == 37 || char_code == 43 || char_code == 61 || char_code == 63 || char_code == 64 || char_code == 38 || char_code == 124 || char_code == 60 || char_code == 62) {
        return magic == 3;
    }
    return false;
}

const str CLASS_LETTERS = "iIkKfFpPsSdDxXoOwWhHaAlLuU";

bool is_class_letter(int char_code) {
    if (char_code < 65 || char_code > 122) {
        return false;
    }
    for (int marker in CLASS_LETTERS.chars()) {
        if (marker == char_code) {
            return true;
        }
    }
    return false;
}

const str META = "%&()*+.123456789<=>?@ACDFIKLMOPSUVWXZ[_acdfhiklmnopsuvwxz{|~";

bool is_meta(int char_code) {
    if (char_code > 126) {
        return false;
    }
    for (int marker in META.chars()) {
        if (marker == char_code) {
            return true;
        }
    }
    return false;
}

// -------------------------------------------------------------- code gen

bool has_upper(List<int> chars) {
    int index = 0;
    int count = chars.size();
    while (index < count) {
        int char_code = chars[index];
        if (char_code == 92) {
            if (index + 2 < count && (chars[index + 1] == 95 || chars[index + 1] == 37)) {
                index = index + 3;
            } else if (index + 1 < count) {
                index = index + 2;
            } else {
                index = index + 1;
            }
        } else if (MED_case.lower_cp(char_code) != char_code) {
            return true;
        } else {
            index = index + 1;
        }
    }
    return false;
}

/// Compile `pattern`. `tilde` is the text `~` stands for (the last
/// substitute string). Check `ok` before use.
pub Regex compile(str pattern, bool is_ignorecase, bool is_smartcase, str tilde) {
    Regex regex = Regex();
    regex.codes = pattern.chars();
    regex.tilde = tilde;
    int root = regex.parse_alt(0);
    if (regex.is_ok) {
        regex.peek();
        if (regex.token != -1) {
            regex.did_fail("E55: Unmatched \\)");
        }
    }
    // nvim reports a reference to a group that is not closed yet, except when
    // a look-behind follows it (nvim's NFA engine accepts that).
    if (regex.is_ok && regex.bad_refs.size() > 0) {
        regex.did_fail("E65: Illegal back reference");
    }
    if (!regex.is_ok) {
        return regex;
    }
    bool is_ignore_case = is_ignorecase;
    if (is_ignorecase && is_smartcase && has_upper(regex.codes)) {
        is_ignore_case = false;
    }
    if (regex.icase_flag == 1) {
        is_ignore_case = true;
    } else if (regex.icase_flag == 0) {
        is_ignore_case = false;
    }
    regex.is_icase = is_ignore_case;
    regex.gen(root);
    regex.emit(OP_MATCH, 0, 0);
    // a leading literal lets the scan skip start positions
    if (regex.opcodes.size() > 0 && regex.opcodes[0] == OP_CHAR && !is_ignore_case) {
        regex.first = regex.program_a[0];
    }
    return regex;
}

// ----------------------------------------------------------------- matcher

type Run {
    pub MED_buffer.Buffer buffer;
    pub int row = -1;
    pub int code_index = 0;
    pub List<int> cps = [];
    pub int nlines = 0;
    pub List<int> saves = [];
    pub List<int> stack = [];
    pub int steps = 0;
    pub bool is_aborted = false;
    pub int end_row = 0;
    pub int end_ci = 0;
    pub int target = -1;
    pub int gbase = 0;
}

void Run.load(int result) {
    if (result == row) {
        return;
    }
    row = result;
    if (result >= nlines || result < 0) {
        cps = [];
    } else {
        cps = buffer.line(result).chars();
    }
}

int Run.current() {
    return pack(row, code_index);
}

void Run.goto_position(int offset) {
    load(offset / SHIFT);
    code_index = offset % SHIFT;
}

// Move over the line break at the end of the line. False when not at one.
bool Run.is_step_nl() {
    if (code_index != cps.size() || row >= nlines) {
        return false;
    }
    load(row + 1);
    code_index = 0;
    return true;
}

// Step over one character and any combining marks after it.
void Run.step_char() {
    code_index = code_index + 1;
    while (code_index < cps.size() && is_combining(cps[code_index])) {
        code_index = code_index + 1;
    }
}

void Run.set_slot(int slot, int value) {
    stack.push(1);
    stack.push(slot);
    stack.push(saves[slot]);
    saves[slot] = value;
}

void Run.unwind(int base) {
    while (stack.size() > base) {
        int y = stack.pop();
        int x = stack.pop();
        int kind = stack.pop();
        if (kind == 1) {
            saves[x] = y;
        }
    }
}

// Drop the choice points above `base`, keep the undo records.
void Run.discard(int base) {
    List<int> keep = [];
    int other_index = base;
    while (other_index < stack.size()) {
        if (stack[other_index] == 1) {
            keep.push(stack[other_index]);
            keep.push(stack[other_index + 1]);
            keep.push(stack[other_index + 2]);
        }
        other_index = other_index + 3;
    }
    while (stack.size() > base) {
        stack.pop();
    }
    for (int value in keep) {
        stack.push(value);
    }
}

List<int> Run.group_cps(int text, int stop) {
    List<int> out = [];
    int result = text / SHIFT;
    int x = text % SHIFT;
    int stop_row = stop / SHIFT;
    int extra = stop % SHIFT;
    while (result < stop_row || (result == stop_row && x < extra)) {
        List<int> line = [];
        if (result < nlines) {
            line = buffer.line(result).chars();
        }
        if (result == stop_row) {
            while (x < extra) {
                out.push(line[x]);
                x = x + 1;
            }
        } else {
            while (x < line.size()) {
                out.push(line[x]);
                x = x + 1;
            }
            out.push(-2);
            result = result + 1;
            x = 0;
        }
    }
    return out;
}

bool Run.did_set_ok(Regex regex, int index, int char_code, bool is_icase) {
    List<int> lows = regex.set_lo[index];
    List<int> highs = regex.set_hi[index];
    bool is_hit = false;
    int alt1 = char_code;
    int alt2 = char_code;
    if (is_icase) {
        alt1 = MED_case.lower_cp(char_code);
        alt2 = MED_case.upper_cp(char_code);
    }
    for (int key in 0 .. lows.size()) {
        if (lows[key] >= EXACT) {
            if (char_code >= lows[key] - EXACT && char_code <= highs[key] - EXACT) {
                is_hit = true;
                break;
            }
        } else if ((char_code >= lows[key] && char_code <= highs[key]) || (alt1 >= lows[key] && alt1 <= highs[key]) || (alt2 >= lows[key] && alt2 <= highs[key])) {
            is_hit = true;
            break;
        }
    }
    return is_hit != regex.set_neg[index];
}

bool Run.is_byte_col_ok(int cmp, int want, int value) {
    if (cmp == 1) {
        return value < want;
    }
    if (cmp == 2) {
        return value > want;
    }
    return value == want;
}

// Run the program from `pc0` at (r0, c0). True at OP_MATCH (or OP_SUBEND whose
// position is `target`); the end is in `end_row`/`end_ci`.
bool Run.did_run_from(Regex regex, int pc0, int start_row, int first_char) {
    int base = stack.size();
    int from_col = pc0;
    load(start_row);
    code_index = first_char;
    while (true) {
        steps = steps + 1;
        if (steps > STEP_LIMIT) {
            is_aborted = true;
            unwind(base);
            return false;
        }
        int opc = regex.opcodes[from_col];
        bool is_good = true;
        if (opc == OP_CHAR) {
            if (code_index < cps.size()) {
                int char_code = cps[code_index];
                if (regex.is_icase) {
                    char_code = fold(char_code);
                }
                if (char_code == regex.program_a[from_col]) {
                    code_index = code_index + 1;
                    if (code_index < cps.size() && is_combining(cps[code_index])) {
                        bool is_named = false;
                        if (from_col + 1 < regex.opcodes.size() && regex.opcodes[from_col + 1] == OP_CHAR && is_combining(regex.program_a[from_col + 1])) {
                            is_named = true;
                        }
                        if (!is_named && !is_combining(regex.program_a[from_col])) {
                            is_good = false;
                        }
                    }
                } else {
                    is_good = false;
                }
            } else {
                is_good = false;
            }
            from_col = from_col + 1;
        } else if (opc == OP_ANY) {
            if (code_index < cps.size()) {
                step_char();
            } else if (regex.program_a[from_col] == 1 && is_step_nl()) {
                // crossed the line break
            } else {
                is_good = false;
            }
            from_col = from_col + 1;
        } else if (opc == OP_CLASS) {
            if (code_index < cps.size()) {
                if (is_class_ok(regex.program_a[from_col], cps[code_index], buffer.keywords)) {
                    step_char();
                } else {
                    is_good = false;
                }
            } else if (regex.program_b[from_col] == 1 && is_step_nl()) {
                // crossed the line break
            } else {
                is_good = false;
            }
            from_col = from_col + 1;
        } else if (opc == OP_SET) {
            if (code_index < cps.size()) {
                if (did_set_ok(regex, regex.program_a[from_col], cps[code_index], regex.is_icase)) {
                    step_char();
                } else {
                    is_good = false;
                }
            } else if (regex.set_nl[regex.program_a[from_col]] && is_step_nl()) {
                // crossed the line break
            } else {
                is_good = false;
            }
            from_col = from_col + 1;
        } else if (opc == OP_NL) {
            is_good = is_step_nl();
            from_col = from_col + 1;
        } else if (opc == OP_BOL) {
            is_good = code_index == 0;
            from_col = from_col + 1;
        } else if (opc == OP_EOL) {
            is_good = code_index == cps.size();
            from_col = from_col + 1;
        } else if (opc == OP_BOW) {
            if (code_index >= cps.size()) {
                is_good = false;
            } else {
                int cls = MED_text.class_in(cps[code_index], buffer.keywords);
                if (cls <= 1) {
                    is_good = false;
                } else if (code_index > 0 && MED_text.class_in(cps[code_index - 1], buffer.keywords) == cls) {
                    is_good = false;
                }
            }
            from_col = from_col + 1;
        } else if (opc == OP_EOW) {
            if (code_index == 0) {
                is_good = false;
            } else {
                int cls = 0;
                if (code_index < cps.size()) {
                    cls = MED_text.class_in(cps[code_index], buffer.keywords);
                }
                int previous = MED_text.class_in(cps[code_index - 1], buffer.keywords);
                if (cls == previous || previous <= 1) {
                    is_good = false;
                }
            }
            from_col = from_col + 1;
        } else if (opc == OP_ZS) {
            set_slot(0, current());
            from_col = from_col + 1;
        } else if (opc == OP_ZE) {
            set_slot(1, current());
            from_col = from_col + 1;
        } else if (opc == OP_SAVE) {
            set_slot(regex.program_a[from_col], current());
            from_col = from_col + 1;
        } else if (opc == OP_BACKREF) {
            int line_text = -1;
            int stop = -1;
            if (regex.program_a[from_col] <= regex.ngroups) {
                line_text = saves[regex.program_a[from_col] * 2];
                stop = saves[regex.program_a[from_col] * 2 + 1];
            }
            if (line_text >= 0 && stop >= 0) {
                List<int> text = group_cps(line_text, stop);
                for (int want in text) {
                    if (want == -2) {
                        if (!is_step_nl()) {
                            is_good = false;
                            break;
                        }
                    } else if (code_index < cps.size() && (cps[code_index] == want || (regex.is_icase && fold(cps[code_index]) == fold(want)))) {
                        code_index = code_index + 1;
                    } else {
                        is_good = false;
                        break;
                    }
                }
            }
            from_col = from_col + 1;
        } else if (opc == OP_SPLIT) {
            stack.push(0);
            stack.push(regex.program_b[from_col]);
            stack.push(current());
            from_col = regex.program_a[from_col];
        } else if (opc == OP_JMP) {
            from_col = regex.program_a[from_col];
        } else if (opc == OP_GSET) {
            set_slot(gbase + regex.program_a[from_col], current());
            from_col = from_col + 1;
        } else if (opc == OP_GCHK) {
            is_good = saves[gbase + regex.program_a[from_col]] != current();
            from_col = from_col + 1;
        } else if (opc == OP_BOF) {
            is_good = row == 0 && code_index == 0;
            from_col = from_col + 1;
        } else if (opc == OP_EOF) {
            is_good = row == nlines - 1 && code_index == cps.size();
            from_col = from_col + 1;
        } else if (opc == OP_LNUM) {
            is_good = is_byte_col_ok(regex.program_b[from_col], regex.program_a[from_col], row + 1);
            from_col = from_col + 1;
        } else if (opc == OP_CNUM) {
            int nbytes = 0;
            for (int key in 0 .. code_index) {
                nbytes = nbytes + utf8_length(cps[key]);
            }
            is_good = is_byte_col_ok(regex.program_b[from_col], regex.program_a[from_col], nbytes + 1);
            from_col = from_col + 1;
        } else if (opc == OP_VNUM) {
            int nbytes = 0;
            for (int key in 0 .. code_index) {
                nbytes = nbytes + utf8_length(cps[key]);
            }
            is_good = is_byte_col_ok(regex.program_b[from_col], regex.program_a[from_col], MED_text.display_col(buffer.line(row), nbytes, 8) + 1);
            from_col = from_col + 1;
        } else if (opc == OP_VIS) {
            int nbytes = 0;
            for (int key in 0 .. code_index) {
                nbytes = nbytes + utf8_length(cps[key]);
            }
            is_good = regex.is_in_visual(buffer, row, nbytes);
            from_col = from_col + 1;
        } else if (opc == OP_MARK) {
            int nbytes = 0;
            for (int key in 0 .. code_index) {
                nbytes = nbytes + utf8_length(cps[key]);
            }
            is_good = regex.is_at_mark(regex.program_a[from_col], regex.program_b[from_col], row, nbytes);
            from_col = from_col + 1;
        } else if (opc == OP_FAIL) {
            is_good = false;
        } else if (opc == OP_LOOK) {
            int kind = regex.program_a[from_col] % 8;
            int after = regex.program_b[from_col];
            int here = current();
            int saved_target = target;
            int sub_base = stack.size();
            bool is_found = false;
            if (kind == LK_AHEAD || kind == LK_NOT_AHEAD || kind == LK_ATOMIC) {
                target = -1;
                is_found = did_run_from(regex, from_col + 1, row, code_index);
                target = saved_target;
                if (is_found && kind == LK_ATOMIC) {
                    // the match consumed: continue after its end
                    int end_row_value = end_row;
                    int end_col = end_ci;
                    discard(sub_base);
                    load(end_row_value);
                    code_index = end_col;
                } else {
                    goto_position(here);
                    if (is_found) {
                        if (kind == LK_NOT_AHEAD) {
                            unwind(sub_base);
                        } else {
                            discard(sub_base);
                        }
                    }
                }
            } else {
                int here_row = here / SHIFT;
                int here_col = here % SHIFT;
                int limit = regex.program_a[from_col] / 8;
                target = here;
                int line_text = here_col;
                while (line_text >= 0 && !is_found) {
                    if (limit > 0 && here_col - line_text > limit) {
                        break;
                    }
                    is_found = did_run_from(regex, from_col + 1, here_row, line_text);
                    if (!is_found) {
                        line_text = line_text - 1;
                    }
                }
                if (!is_found && here_row > 0 && !is_aborted) {
                    load(here_row - 1);
                    int plen = cps.size();
                    int other_start = plen;
                    while (other_start >= 0 && !is_found) {
                        is_found = did_run_from(regex, from_col + 1, here_row - 1, other_start);
                        if (!is_found) {
                            other_start = other_start - 1;
                        }
                    }
                }
                target = saved_target;
                goto_position(here);
                if (is_found) {
                    if (kind == LK_NOT_BEHIND) {
                        unwind(sub_base);
                    } else {
                        discard(sub_base);
                    }
                }
            }
            if (is_aborted) {
                unwind(base);
                return false;
            }
            if (kind == LK_NOT_AHEAD || kind == LK_NOT_BEHIND) {
                is_good = !is_found;
            } else {
                is_good = is_found;
            }
            from_col = after;
        } else if (opc == OP_SUBEND) {
            if (target >= 0 && current() != target) {
                is_good = false;
            } else {
                end_row = row;
                end_ci = code_index;
                discard(base);
                return true;
            }
        } else if (opc == OP_MATCH) {
            end_row = row;
            end_ci = code_index;
            discard(base);
            return true;
        }
        if (!is_good) {
            bool is_resumed = false;
            while (stack.size() > base) {
                int y = stack.pop();
                int x = stack.pop();
                int kind = stack.pop();
                if (kind == 1) {
                    saves[x] = y;
                } else {
                    from_col = x;
                    goto_position(y);
                    is_resumed = true;
                    break;
                }
            }
            if (!is_resumed) {
                return false;
            }
        }
    }
}

int Run.bytes_to(int result, int x) {
    if (result >= nlines) {
        return 0;
    }
    List<int> line = buffer.line(result).chars();
    int total = 0;
    int lim = x;
    if (lim > line.size()) {
        lim = line.size();
    }
    for (int key in 0 .. lim) {
        total = total + utf8_length(line[key]);
    }
    return total;
}

int Run.cp_index(int result, int bytecol) {
    if (result >= nlines) {
        return 0;
    }
    List<int> line = buffer.line(result).chars();
    int total = 0;
    int key = 0;
    while (key < line.size() && total < bytecol) {
        total = total + utf8_length(line[key]);
        key = key + 1;
    }
    return key;
}

str Run.text_between(int line_text, int stop) {
    List<int> text = group_cps(line_text, stop);
    List<int> out = [];
    for (int value in text) {
        if (value == -2) {
            out.push(10);
        } else {
            out.push(value);
        }
    }
    return str.from_chars(out);
}

Match Run.result(Regex regex, int srow, int sci) {
    Match match_value = Match();
    match_value.is_ok = true;
    int start = pack(srow, sci);
    int stop = pack(end_row, end_ci);
    if (saves[0] >= 0) {
        start = saves[0];
    }
    if (saves[1] >= 0) {
        stop = saves[1];
    }
    if (stop < start) {
        stop = start;
    }
    match_value.srow = start / SHIFT;
    match_value.erow = stop / SHIFT;
    match_value.scol = bytes_to(match_value.srow, start % SHIFT);
    match_value.ecol = bytes_to(match_value.erow, stop % SHIFT);
    match_value.groups.push(text_between(start, stop));
    for (int group in 1 .. 10) {
        if (group <= regex.ngroups && saves[group * 2] >= 0 && saves[group * 2 + 1] >= 0) {
            match_value.groups.push(text_between(saves[group * 2], saves[group * 2 + 1]));
        } else {
            match_value.groups.push("");
        }
    }
    return match_value;
}

int pack(int row, int code_index) {
    return row * SHIFT + code_index;
}

// ---------------------------------------------------------------- results
