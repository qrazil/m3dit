// The window onto the buffer: which lines are shown, and the commands that
// move it (CTRL-E CTRL-Y CTRL-D CTRL-U CTRL-F CTRL-B and the z family).
//
// This follows Vim's update_topline, scroll_cursor_halfway and pagescroll,
// with lines that wrap ('wrap' and `view_width`) and with 'scrolloff' 0. The editor keeps `view_top` and `view_height`; the UI sets
// the height and calls `update` after each key so the cursor stays visible.

import engine.MED_autofold;
import engine.MED_editor;
import engine.MED_motion;
import engine.MED_num;
import engine.MED_text;
import engine.MED_buffer;
import engine.MED_screen;

/// The screen rows buffer line `row` takes (1 when lines do not wrap).
pub int rows_of(MED_editor.Editor editor, int row) {
    if (editor.folds.size() > 0) {
        // a closed fold is one row and its other lines have none
        int fold_start = editor.fold_start_of(row);
        if (fold_start >= 0) {
            if (fold_start == row) {
                return 1;
            }
            return 0;
        }
    }
    if (!editor.is_option_on("wrap", true) || editor.view_width < 1) {
        return 1;
    }
    if (editor.is_wrap_special()) {
        return editor.wrap_layout(editor.buffer.line(row)).breaks.size();
    }
    return MED_text.wrap_breaks(editor.buffer.line(row), editor.view_width, editor.tab).size();
}

/// The rows of the top line that are scrolled off the top of the window.
pub int top_skip(MED_editor.Editor editor) {
    if (editor.view_skip > 0 && editor.view_skip_line == editor.view_top) {
        return editor.view_skip;
    }
    return 0;
}

// The rows line `row` shows in the window (the top line may be cut).
int shown_rows(MED_editor.Editor editor, int row) {
    int rows = rows_of(editor, row);
    if (row == editor.view_top) {
        rows = rows - top_skip(editor);
        if (rows < 1) {
            rows = 1;
        }
    }
    return rows;
}

/// Vim's w_botline (0-based): the first line that is not completely shown,
/// or the line count when the window reaches the end of the buffer.
pub int bottom(MED_editor.Editor editor) {
    int used = 0;
    int row = editor.view_top;
    int count = editor.buffer.line_count();
    while (row < count) {
        int height = shown_rows(editor, row);
        if (used + height > editor.view_height) {
            if (row == editor.view_top) {
                return row + 1;
            }
            return row;
        }
        used = used + height;
        row = row + 1;
    }
    return count;
}

/// 'scrolloff': the lines kept above and below the cursor (a value past what
/// the window holds centres the cursor line, as in Vim).
pub int margin(MED_editor.Editor editor) {
    int wanted = editor.option_number("scrolloff", 0);
    if (wanted <= 0) {
        return 0;
    }
    return wanted;
}

// The rows of the window the lines shown completely leave free (w_empty_rows).
pub int empty_rows(MED_editor.Editor editor) {
    int used = 0;
    int row = editor.view_top;
    int count = editor.buffer.line_count();
    while (row < count) {
        int height = shown_rows(editor, row);
        if (used + height > editor.view_height) {
            break;
        }
        used = used + height;
        row = row + 1;
    }
    return editor.view_height - used;
}

// Put the cursor on `row`, its column from the wanted column.
void to_row(MED_editor.Editor editor, int row) {
    editor.row = row;
    editor.col = editor.col_for_want(row, editor.want, editor.mode == MED_editor.VISUAL);
}

/// Vim's scroll_cursor_halfway: put the cursor line in the middle. `is_at_end`
/// (zz) counts the empty rows past the end of the buffer as used;
/// `is_prefer_above` (scrolling down to the cursor) puts the extra row above it.
pub void center(MED_editor.Editor editor, bool is_at_end, bool is_prefer_above) {
    int last = editor.buffer.line_count() - 1;
    int row = editor.row;
    int used = rows_of(editor, row);
    int above = 0;
    int below = 0;
    int below_row = row;
    int top = row;
    while (top > 0) {
        bool is_add_below = below <= above;
        if (is_prefer_above) {
            is_add_below = below < above;
        }
        if (is_add_below) {
            if (below_row < last) {
                below_row = below_row + 1;
                used = used + rows_of(editor, below_row);
                if (used > editor.view_height) {
                    break;
                }
                below = below + 1;
            } else {
                below = below + 1;
                if (is_at_end) {
                    used = used + 1;
                }
            }
        }
        bool is_add_above = below > above;
        if (is_prefer_above) {
            is_add_above = below >= above;
        }
        if (is_add_above) {
            used = used + rows_of(editor, top - 1);
            if (used > editor.view_height) {
                break;
            }
            above = above + 1;
            top = top - 1;
        }
    }
    editor.view_top = top;
}

// Vim's scroll_cursor_bot: scroll just far enough to put the cursor line at
// the bottom with 'scrolloff' lines below it, or centre it when that would
// take a screenful. `is_set_topbot` (zb) starts from a window that ends at the
// cursor line instead of the current one.
void scroll_to_bottom(MED_editor.Editor editor, int min_scroll, bool is_set_topbot) {
    int last = editor.buffer.line_count() - 1;
    int height = editor.view_height;
    int cursor_row = editor.row;
    int used = rows_of(editor, cursor_row);
    int keep = margin(editor);
    int bottom_row = 0;
    int empty = 0;
    if (is_set_topbot) {
        int fitted = 0;
        int top = cursor_row + 1;
        while (top > 0) {
            int one = rows_of(editor, top - 1);
            if (fitted + one > height) {
                break;
            }
            fitted = fitted + one;
            top = top - 1;
        }
        editor.view_top = top;
        editor.view_skip = 0;
        bottom_row = cursor_row + 1;
        empty = height - fitted;
        if (empty < 0) {
            empty = 0;
        }
    } else {
        bottom_row = bottom(editor);
        empty = empty_rows(editor);
    }
    int scrolled = 0;
    int extra = 0;
    if (cursor_row >= bottom_row) {
        scrolled = used;
        if (cursor_row == bottom_row) {
            scrolled = scrolled - empty;
        }
    }
    int above = cursor_row;
    int below = cursor_row;
    while (above > 0) {
        if ((((scrolled <= 0 || scrolled >= min_scroll) && extra >= keep) || below >= last) && above <= bottom_row) {
            break;
        }
        above = above - 1;
        used = used + rows_of(editor, above);
        if (used > height) {
            break;
        }
        if (above >= bottom_row) {
            scrolled = scrolled + rows_of(editor, above);
            if (above == bottom_row) {
                scrolled = scrolled - empty;
            }
        }
        if (below < last) {
            below = below + 1;
            used = used + rows_of(editor, below);
            if (used > height) {
                break;
            }
            if (extra < keep || scrolled < min_scroll) {
                extra = extra + rows_of(editor, below);
                if (below >= bottom_row) {
                    scrolled = scrolled + rows_of(editor, below);
                    if (below == bottom_row) {
                        scrolled = scrolled - empty;
                    }
                }
            }
        }
    }
    int lines = 0;
    if (scrolled <= 0) {
        lines = 0;
    } else if (used > height) {
        lines = used;
    } else {
        int covered = 0;
        int walk = editor.view_top - 1;
        while (covered < scrolled && walk < bottom_row) {
            walk = walk + 1;
            covered = covered + rows_of(editor, walk);
            lines = lines + 1;
        }
        if (covered < scrolled) {
            lines = 9999;
        }
    }
    if (lines >= height && lines > min_scroll) {
        center(editor, false, true);
    } else {
        editor.view_top = editor.view_top + lines;
    }
}

// Vim's scroll_cursor_top: put the cursor line near the top with 'scrolloff'
// lines above it (zt). `is_always` moves the window down as well as up.
void scroll_to_top(MED_editor.Editor editor, int min_scroll, bool is_always) {
    int height = editor.view_height;
    int keep = margin(editor);
    int count = editor.buffer.line_count();
    int used = rows_of(editor, editor.row);
    int scrolled = 0;
    if (editor.row < editor.view_top) {
        scrolled = used;
    }
    int top = editor.row - 1;
    int bot = editor.row + 1;
    int new_top = editor.row;
    int extra = 0;
    while (top >= 0) {
        int one = rows_of(editor, top);
        used = used + one;
        if (extra + one <= keep && bot < count) {
            used = used + rows_of(editor, bot);
        }
        if (used > height) {
            break;
        }
        if (top < editor.view_top) {
            scrolled = scrolled + one;
        }
        if ((new_top >= editor.view_top || scrolled > min_scroll) && extra >= keep) {
            break;
        }
        extra = extra + one;
        new_top = top;
        top = top - 1;
        bot = bot + 1;
    }
    if (used > height) {
        center(editor, false, false);
    } else if (new_top < editor.view_top || is_always) {
        editor.view_top = new_top;
        editor.view_skip = 0;
    }
}

// With 'wrap' a line can take several rows: scroll further until the cursor
// line is in the window.
void fit_wrapped(MED_editor.Editor editor) {
    if (!editor.is_option_on("wrap", true) || editor.view_width < 1) {
        return;
    }
    int used = 0;
    for (int row in editor.view_top .. editor.row + 1) {
        used = used + rows_of(editor, row);
    }
    while (used > editor.view_height && editor.view_top < editor.row) {
        used = used - rows_of(editor, editor.view_top);
        editor.view_top = editor.view_top + 1;
    }
}

/// Vim's curs_columns for 'nowrap': scroll sideways until the cursor is in
/// the window, with 'sidescrolloff' columns to spare and 'sidescroll' columns
/// per step (0, or a far jump: the cursor goes to the middle).
pub void horizontal(MED_editor.Editor editor) {
    if (editor.is_option_on("wrap", true)) {
        editor.view_left = 0;
        return;
    }
    int width = editor.view_width;
    if (width < 1) {
        return;
    }
    str line = editor.buffer.line(editor.row);
    int start = MED_text.display_col(line, editor.col, editor.tab);
    int cells = 1;
    if (editor.col < line.size()) {
        cells = MED_text.cell_width(line, editor.col, start, editor.tab);
    }
    int end = start + cells - 1;
    int cursor_virtual = start;
    if (editor.col < line.size() && line.byte_at(editor.col) == 9 && editor.mode != MED_editor.INSERT && !editor.is_option_on("list", false)) {
        cursor_virtual = end;
    }
    int side = editor.option_number("sidescrolloff", 0);
    int step = editor.option_number("sidescroll", 1);
    int off_left = start - editor.view_left - side;
    int off_right = end - (editor.view_left + width - side) + 1;
    if (off_left >= 0 && off_right <= 0) {
        return;
    }
    int diff = off_right;
    if (off_left < 0) {
        diff = 0 - off_left;
    }
    int target = 0;
    if (step == 0 || diff >= width / 2 || off_right >= off_left) {
        target = cursor_virtual - width / 2;
    } else {
        if (diff < step) {
            diff = step;
        }
        if (off_left < 0) {
            target = editor.view_left - diff;
        } else {
            target = editor.view_left + diff;
        }
    }
    if (target < 0) {
        target = 0;
    }
    editor.view_left = target;
}

/// Vim's update_topline: scroll just enough to show the cursor line, or
/// centre it when it is far away.
pub void update(MED_editor.Editor editor) {
    MED_autofold.sync(editor);
    if (editor.folds.size() > 0 && !editor.is_fold_off) {
        // the cursor is on the first line of a closed fold as far as the window
        // is concerned, and the window starts at one
        int saved_row = editor.row;
        int start = editor.fold_start_of(editor.row);
        if (start >= 0) {
            editor.row = start;
        }
        int top_start = editor.fold_start_of(editor.view_top);
        if (top_start >= 0) {
            editor.view_top = top_start;
        }
        update_view(editor);
        editor.row = saved_row;
        return;
    }
    update_view(editor);
}

void update_view(MED_editor.Editor editor) {
    horizontal(editor);
    if (editor.view_valid_row >= 0) {
        if (editor.row == editor.view_valid_row && editor.current == editor.view_valid_text && editor.view_height == editor.view_valid_height && editor.view_width == editor.view_valid_width) {
            return;
        }
        editor.view_valid_row = -1;
    }
    int before = editor.view_top;
    update_lines(editor);
    fit_wrapped(editor);
    if (editor.view_top != before) {
        editor.view_skip = 0;
    }
    if (top_skip(editor) > 0 && editor.row == editor.view_top && editor.view_width > 0) {
        // the cursor is above the visible part of the top line: show it
        int cursor_part = editor.cursor_vcol() / editor.view_width;
        if (cursor_part < editor.view_skip) {
            editor.view_skip = cursor_part;
        }
    }
    mark_valid(editor);
}

// The cursor on the top line must be on a row that shows (nvim's scrollup
// with 'smoothscroll'): the wanted column moves into the visible rows.
void show_cursor_in_top(MED_editor.Editor editor) {
    int skip = top_skip(editor);
    if (skip == 0 || editor.row != editor.view_top || editor.view_width < 1) {
        return;
    }
    int width = editor.view_width;
    int marker = 0;
    if (editor.view_gutter < 3) {
        marker = 3 - editor.view_gutter;
    }
    int skipcol = skip * width;
    int vcol = editor.cursor_vcol();
    if (vcol < skipcol + marker) {
        int target = vcol;
        if (target < width) {
            target = target + width;
        }
        while (target < skipcol + marker) {
            target = target + width;
        }
        editor.want = target;
        editor.col = editor.col_for_want(editor.row, target, editor.mode == MED_editor.VISUAL);
    }
}

void update_lines(MED_editor.Editor editor) {
    int count = editor.buffer.line_count();
    int height = editor.view_height;
    int keep = margin(editor);
    if (editor.view_top > count - 1) {
        editor.view_top = count - 1;
    }
    if (editor.view_top < 0) {
        editor.view_top = 0;
    }
    if (editor.view_top > 0 && editor.row < editor.view_top + keep) {
        // above the window, or inside the 'scrolloff' lines at its top
        int half = height / 2 - 1;
        if (half < 2) {
            half = 2;
        }
        int behind = editor.view_top + keep - editor.row;
        if (behind > count - editor.row) {
            behind = count - editor.row;
        }
        if (behind >= half) {
            center(editor, false, false);
        } else {
            scroll_to_top(editor, 1, false);
        }
        return;
    }
    if (editor.row < editor.view_top) {
        editor.view_top = editor.row;
        return;
    }
    int bottom_row = bottom(editor);
    if (bottom_row < count && editor.row >= bottom_row - keep) {
        int beyond = editor.row - bottom_row + 1 + keep;
        if (beyond <= height + 1) {
            scroll_to_bottom(editor, 1, false);
        } else {
            center(editor, false, false);
        }
    }
}

/// Vim's cursor_correct for the row `row`: the row moved inside the window
/// by the 'scrolloff' lines (fewer at the start and end of the buffer).
pub int corrected_row(MED_editor.Editor editor, int row) {
    int keep = editor.option_number("scrolloff", 0);
    int count = editor.buffer.line_count();
    int bottom_row = bottom(editor);
    int height = editor.view_height;
    int above_wanted = keep;
    int below_wanted = keep;
    if (editor.view_top == 0) {
        above_wanted = 0;
        if (below_wanted > height / 2) {
            below_wanted = height / 2;
        }
    }
    if (bottom_row >= count) {
        below_wanted = 0;
        if (above_wanted > (height - 1) / 2) {
            above_wanted = (height - 1) / 2;
        }
    }
    if (row >= editor.view_top + above_wanted && row < bottom_row - below_wanted) {
        return row;
    }
    int top = editor.view_top;
    int bot = bottom_row - 1;
    int above = 0;
    int below = 0;
    while ((above < above_wanted || below < below_wanted) && top < bot) {
        if (below < below_wanted && (below <= above || above >= above_wanted)) {
            below = below + rows_of(editor, bot);
            bot = bot - 1;
        } else {
            above = above + rows_of(editor, top);
            top = top + 1;
        }
    }
    if (top == bot || bot < 0) {
        return top;
    }
    if (top > bot) {
        return bot;
    }
    int result = row;
    if (row < top && editor.view_top > 0) {
        result = top;
    }
    if (row > bot && bottom_row < count) {
        result = bot;
    }
    return result;
}

// The window position is right for the cursor as it is (Vim's VALID_TOPLINE):
// it is checked again only when the cursor line, the text or the window size
// changes.
void mark_valid(MED_editor.Editor editor) {
    editor.view_valid_row = editor.row;
    editor.view_valid_text = editor.current;
    editor.view_valid_height = editor.view_height;
    editor.view_valid_width = editor.view_width;
}

/// Move the cursor inside the 'scrolloff' margins of the window.
pub void cursor_correct(MED_editor.Editor editor) {
    if (editor.option_number("scrolloff", 0) <= 0) {
        return;
    }
    int row = corrected_row(editor, editor.row);
    if (row != editor.row) {
        to_row(editor, row);
    }
    mark_valid(editor);
}

/// Scroll the window `count` lines (up: the text moves up, CTRL-E). Returns
/// whether it moved. The cursor is not touched.
pub bool did_scroll_window(MED_editor.Editor editor, bool is_upward, int count) {
    int before = editor.view_top;
    if (editor.folds.size() > 0 && !editor.is_fold_off) {
        // a closed fold is one line to scroll over
        for (int step in 0 .. count) {
            if (is_upward) {
                int fold_end = editor.fold_end_of(editor.view_top);
                int next = editor.view_top + 1;
                if (fold_end >= 0) {
                    next = fold_end + 1;
                }
                editor.view_top = MED_num.smaller(next, editor.buffer.line_count() - 1);
            } else {
                int previous = MED_num.larger(editor.view_top - 1, 0);
                int fold_start = editor.fold_start_of(previous);
                if (fold_start >= 0) {
                    previous = fold_start;
                }
                editor.view_top = previous;
            }
        }
        return editor.view_top != before;
    }
    if (is_upward) {
        editor.view_top = MED_num.smaller(editor.view_top + count, editor.buffer.line_count() - 1);
    } else {
        editor.view_top = MED_num.larger(editor.view_top - count, 0);
    }
    return editor.view_top != before;
}

// Keep the cursor in the window after it scrolled (Vim's scrollup/scrolldown).
void pull_cursor(MED_editor.Editor editor) {
    int row = editor.row;
    if (row < editor.view_top) {
        row = editor.view_top;
    }
    int last = bottom(editor) - 1;
    if (row > last) {
        row = last;
    }
    if (row != editor.row) {
        to_row(editor, row);
    }
    cursor_correct(editor);
}

/// CTRL-E (up) and CTRL-Y.
pub void scroll_line(MED_editor.Editor editor, bool is_upward, int count) {
    did_scroll_window(editor, is_upward, count);
    pull_cursor(editor);
}

// A line's height, or a huge number past the buffer (MAXCOL).
int height_or_far(MED_editor.Editor editor, int row) {
    if (row < 0 || row >= editor.buffer.line_count()) {
        return 1000000000;
    }
    return rows_of(editor, row);
}

// Rows CTRL-F / CTRL-B scroll for one count (Vim's get_scroll_overlap).
int overlap(MED_editor.Editor editor, bool is_forward) {
    int height = editor.view_height;
    int min_height = height - 2;
    int bottom_row = bottom(editor);
    if ((!is_forward && editor.view_top == 0) || (is_forward && bottom_row >= editor.buffer.line_count())) {
        return min_height + 2;
    }
    int step = 1;
    int probe = editor.view_top - 1;
    if (is_forward) {
        step = -1;
        probe = bottom_row;
    }
    int first = rows_of(editor, probe);
    if (first > min_height) {
        return min_height + 2;
    }
    probe = probe + step;
    int second = height_or_far(editor, probe);
    if (second + first > min_height) {
        return min_height + 2;
    }
    probe = probe + step;
    int third = height_or_far(editor, probe);
    if (third + second > min_height) {
        return min_height + 2;
    }
    probe = probe + step;
    int fourth = height_or_far(editor, probe);
    if (fourth + third + second > min_height || third + second + first > min_height) {
        return min_height + 1;
    }
    return min_height;
}

// nvim's scroll_with_sms: scroll the window `count` screen rows, then
// continue to a line boundary. Returns the rows the cursor should follow
// (`cursor_rows` is adjusted like curscount) through `editor.page_rows`.
bool did_scroll_rows(MED_editor.Editor editor, bool is_forward, int count, int cursor_rows) {
    int start = editor.view_top;
    int last = editor.buffer.line_count() - 1;
    int start_sub = top_skip(editor);
    int line = start;
    int sub = start_sub;
    int steps = count;
    while (steps > 0) {
        if (is_forward) {
            if (sub + 1 < rows_of(editor, line)) {
                sub = sub + 1;
            } else if (line < last) {
                line = line + 1;
                sub = 0;
            } else {
                break;
            }
        } else if (sub > 0) {
            sub = sub - 1;
        } else if (line > 0) {
            line = line - 1;
            sub = rows_of(editor, line) - 1;
        } else {
            break;
        }
        steps = steps - 1;
    }
    int adjust = cursor_rows;
    if (sub > 0) {
        // the cursor follows the partly shown top line: its wanted column
        // moves into the rows that show (this sticks, as in nvim)
        editor.view_top = line;
        editor.view_skip = sub;
        editor.view_skip_line = line;
        if (editor.row < line) {
            to_row(editor, line);
        }
        show_cursor_in_top(editor);
    }
    if (sub > 0 && line < last) {
        // a partly shown line at the top: go on to a line boundary, the other
        // way when the top line already changed (as much as nvim does)
        int moved_lines = line - start;
        if (moved_lines < 0) {
            moved_lines = 0 - moved_lines;
        }
        int limit = 0;
        if (!is_forward) {
            limit = 1;
        }
        if (moved_lines > limit) {
            if (is_forward) {
                adjust = adjust - sub;
            } else {
                adjust = adjust - (rows_of(editor, line) - sub);
                line = line + 1;
            }
        } else if (is_forward) {
            adjust = adjust + (rows_of(editor, line) - sub);
            line = line + 1;
        } else {
            adjust = adjust + sub;
        }
        sub = 0;
    }
    editor.page_rows = adjust;
    editor.view_top = line;
    editor.view_skip = sub;
    editor.view_skip_line = line;
    return line != start || sub != start_sub;
}

/// CTRL-D, CTRL-U (`is_half`) and CTRL-F, CTRL-B (Vim's pagescroll). Returns
/// false when nothing moved.
pub bool did_page(MED_editor.Editor editor, bool is_forward, int count0, bool is_half) {
    int height = editor.view_height;
    int last = editor.buffer.line_count() - 1;
    int previous_row = editor.row;
    int previous_col = editor.col;
    bool is_moved = false;
    if (is_half) {
        if (count0 > 0) {
            editor.scroll_opt = MED_num.smaller(height, count0);
        }
        int amount = height / 2;
        if (amount == 0) {
            amount = 1;
        }
        if (editor.scroll_opt > 0) {
            amount = editor.scroll_opt;
        }
        int count = MED_num.smaller(height, amount);
        int cursor_count = count;
        if (is_forward && editor.view_top + 1 + height + count > last + 1) {
            int rows = rows_of(editor, editor.view_top);
            if (rows - count < height && editor.view_top < last) {
                int walk = editor.view_top + 1;
                int added = 0;
                while (walk <= last && added < height + count) {
                    added = added + rows_of(editor, walk);
                    walk = walk + 1;
                }
                rows = rows + added;
            }
            if (rows < height + count) {
                count = rows - height;
            }
        }
        if (count > 0) {
            int kept_row = editor.row;
            int kept_col = editor.col;
            int kept_want = editor.want;
            is_moved = did_scroll_rows(editor, is_forward, count, cursor_count);
            cursor_count = editor.page_rows;
            editor.row = kept_row;
            editor.col = kept_col;
            editor.want = kept_want;
        }
        if (MED_screen.is_wrapping(editor)) {
            int saved_want = editor.want;
            MED_screen.Outcome moved = MED_screen.move(editor, is_forward, cursor_count, false);
            editor.row = moved.row;
            editor.col = moved.col;
            editor.want = moved.want;
            if (moved.want < 0 && saved_want >= 0) {
                editor.want = moved.want;
            }
        } else {
            int row = 0;
            if (is_forward) {
                row = MED_num.smaller(previous_row + cursor_count, last);
            } else {
                row = MED_num.larger(previous_row - cursor_count, 0);
            }
            to_row(editor, row);
        }
    } else {
        int count = MED_num.larger(count0, 1) * overlap(editor, is_forward);
        is_moved = did_scroll_rows(editor, is_forward, count, count);
        if (is_moved) {
            if (is_forward) {
                to_row(editor, editor.view_top);
            } else {
                to_row(editor, bottom(editor) - 1);
            }
            show_cursor_in_top(editor);
        }
    }
    cursor_correct(editor);
    return is_moved || editor.row != previous_row || editor.col != previous_col;
}

// ----------------------------------------------------------------- z family

// Vim's leftcol_changed: after the window scrolled sideways, move the cursor
// into the columns that show (inside the 'sidescrolloff' margins).
void keep_cursor_in_columns(MED_editor.Editor editor) {
    int side = editor.option_number("sidescrolloff", 0);
    int last_column = editor.view_left + editor.view_width - 1;
    str line = editor.buffer.line(editor.row);
    bool is_visual = editor.mode == MED_editor.VISUAL;
    int start = MED_text.display_col(line, editor.col, editor.tab);
    int cells = 1;
    if (editor.col < line.size()) {
        cells = MED_text.cell_width(line, editor.col, start, editor.tab);
    }
    int end = start + cells - 1;
    int virtual_col = start;
    if (editor.col < line.size() && line.byte_at(editor.col) == 9 && !editor.is_option_on("list", false)) {
        virtual_col = end;
    }
    if (virtual_col > last_column - side) {
        editor.col = MED_motion.col_for_want(line, last_column - side, editor.tab, is_visual);
    } else if (virtual_col < editor.view_left + side) {
        editor.col = MED_motion.col_for_want(line, editor.view_left + side, editor.tab, is_visual);
    }
    start = MED_text.display_col(line, editor.col, editor.tab);
    cells = 1;
    if (editor.col < line.size()) {
        cells = MED_text.cell_width(line, editor.col, start, editor.tab);
    }
    end = start + cells - 1;
    if (end > last_column) {
        editor.col = MED_motion.col_for_want(line, start - 1, editor.tab, is_visual);
    } else if (start < editor.view_left) {
        int next = MED_motion.col_for_want(line, end + 1, editor.tab, is_visual);
        if (MED_text.display_col(line, next, editor.tab) > end) {
            editor.col = next;
        } else {
            editor.view_left = start;
        }
    }
    editor.want_from_cursor();
}

// zh zl zH zL zs ze while lines do not wrap.
void scroll_sideways(MED_editor.Editor editor, int key, int count) {
    int amount = MED_num.larger(count, 1);
    int width = editor.view_width;
    int side = editor.option_number("sidescrolloff", 0);
    str line = editor.buffer.line(editor.row);
    int start = MED_text.display_col(line, editor.col, editor.tab);
    int cells = 1;
    if (editor.col < line.size()) {
        cells = MED_text.cell_width(line, editor.col, start, editor.tab);
    }
    int end = start + cells - 1;
    int before = editor.view_left;
    if (key == 108) {
        editor.view_left = editor.view_left + amount;
    } else if (key == 104) {
        editor.view_left = MED_num.larger(editor.view_left - amount, 0);
    } else if (key == 76) {
        editor.view_left = editor.view_left + (width / 2) * amount;
    } else if (key == 72) {
        editor.view_left = MED_num.larger(editor.view_left - (width / 2) * amount, 0);
    } else if (key == 115) {
        int target = start;
        if (target > side) {
            target = target - side;
        } else {
            target = 0;
        }
        editor.view_left = target;
    } else {
        int target = end;
        if (target + side < width) {
            target = 0;
        } else {
            target = target + side - width + 1;
        }
        editor.view_left = target;
    }
    if ((key == 108 || key == 104 || key == 76 || key == 72) && editor.view_left != before) {
        keep_cursor_in_columns(editor);
    }
}

/// zt z<CR> zz z. zb z-. `target` is the line to go to first (0: stay).
/// Returns false for a key that is not one of these.
pub bool did_z_command(MED_editor.Editor editor, int key, int target) {
    bool is_known = key == 116 || key == 13 || key == 122 || key == 46 || key == 98 || key == 45;
    if (key == 104 || key == 108 || key == 115 || key == 101 || key == 72 || key == 76) {
        // horizontal scrolling does nothing while lines wrap
        if (!editor.is_option_on("wrap", true)) {
            scroll_sideways(editor, key, target);
        }
        return true;
    }
    if (!is_known) {
        return false;
    }
    if (target > 0 && target - 1 != editor.row) {
        editor.set_pcmark(MED_buffer.Pos(editor.row, editor.col));
        to_row(editor, MED_num.smaller(target - 1, editor.buffer.line_count() - 1));
    }
    if (key == 13 || key == 46 || key == 45) {
        str line = editor.buffer.line(editor.row);
        editor.col = MED_text.first_nonblank(line);
        if (editor.col >= line.size() && line.size() > 0) {
            editor.col = MED_text.last_col(line);
        }
        editor.want_from_cursor();
    }
    if (key == 116 || key == 13) {
        scroll_to_top(editor, 0, true);
    } else if (key == 122 || key == 46) {
        center(editor, true, false);
    } else {
        scroll_to_bottom(editor, 0, true);
    }
    return true;
}
