// the rest of nvim's portable options (stored only, with nvim's own defaults; docs/OPTIONS.md says which ones act)

/// Every option name, in table order.
pub List<str> names() {
    List<str> out = [];
    for (str entry in SPECS) {
        out.push(entry.split(":")[0]);
    }
    return out;
}

/// The option that `word` names (full or short name); Spec.name is "" when there is none.
pub Spec find(str word) {
    for (str entry in SPECS) {
        List<str> parts = entry.split(":");
        if (parts[0] == word || parts[1] == word) {
            Spec found = Spec();
            found.name = parts[0];
            found.short = parts[1];
            found.kind = parts[2];
            found.default = parts.slice(3, parts.size()).join(":");
            return found;
        }
    }
    return Spec();
}
