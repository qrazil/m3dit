// Cursor motions as pure functions of the buffer, ported from Vim's
// semantics (textobject.c, search.c, normal.c) and checked against nvim.
//
// API
// ---
//   MED_motion.Motion              where a motion lands and how an operator should treat it
//   MED_motion.Cur                 a movable position with Vim's inc/dec stepping
//   MED_motion.fwd_word / bck_word / end_word / bckend_word      w b e ge (and W B E gE)
//   MED_motion.paragraph(buf, row, dir, count)                  { and }
//   MED_motion.find_char(...)                                    f F t T ; ,
//   MED_motion.match_pair(buf, row, col)                         %
//   MED_motion.col_for_want(line, want, tab, one_more)           j/k column choice
//
// A `Cur` can stand on the position one past the last character (`col ==
// line.size()`), which Vim calls the NUL; `inc` and `dec` report whether a
// step stayed in the line (0), reached the NUL (2) or crossed a line (1), or
// failed at the buffer's edge (-1). Word motions are built on those.

import engine.MED_buffer;
import engine.MED_text;

/// The result of a motion. `want` is the desired display column for later
/// vertical moves: -2 means "the column the cursor landed on", -3 "unchanged",
/// -1 "end of line".
pub type Motion {
    pub bool is_ok = true;
    pub int row = 0;
    pub int col = 0;
    pub bool is_linewise = false;
    pub bool is_inclusive = false;
    pub int want = -2;
    pub bool is_jump = false;
    /// Vim's CA_NO_ADJ_OP_END: do not apply the end-at-column-0 adjustment.
    pub bool is_no_adj = false;
    /// The motion moved as far as it could and then failed (Vim beeps but
    /// keeps the cursor where it got to).
    pub bool is_beep = false;
    /// A failed motion that still moved the cursor to `row`, `col`.
    pub bool is_moved = false;
}

pub Motion failed() {
    Motion motion = Motion();
    motion.is_ok = false;
    return motion;
}

pub type Cur {
    pub MED_buffer.Buffer buffer;
    pub int row;
    pub int col;
}

/// Step one character forward. 0 inside the line, 2 onto the NUL, 1 onto the
/// next line, -1 at the end of the buffer.
pub int Cur.inc() {
    str line = buffer.line(row);
    if (col < line.size()) {
        col = MED_text.next_col(line, col);
        if (col < line.size()) {
            return 0;
        }
        return 2;
    }
    if (row + 1 < buffer.line_count()) {
        row = row + 1;
        col = 0;
        return 1;
    }
    return -1;
}

/// Step one character back. 0 inside the line, 1 onto the NUL of the previous
/// line, -1 at the start of the buffer.
pub int Cur.dec() {
    if (col > 0) {
        col = MED_text.previous_col(buffer.line(row), col);
        return 0;
    }
    if (row > 0) {
        row = row - 1;
        col = buffer.line_size(row);
        return 1;
    }
    return -1;
}

/// Character class at the cursor: 0 blank (or NUL), else the word class; a
/// WORD motion folds every non-blank to 1.
pub int Cur.cls(bool is_big) {
    str line = buffer.line(row);
    if (col >= line.size()) {
        return 0;
    }
    int code_point = MED_text.cp_at(line, col);
    if (code_point == 32 || code_point == 9) {
        return 0;
    }
    int char_class = MED_text.class_in(code_point, buffer.keywords);
    if (char_class != 0 && is_big) {
        return 1;
    }
    return char_class;
}

pub bool Cur.is_empty_line() {
    return col == 0 && buffer.line_size(row) == 0;
}

/// Vim's `incl`: like `inc` but never rests on the NUL of a non-empty line.
pub int Cur.incl() {
    int result = inc();
    if (result >= 1 && col > 0) {
        result = inc();
    }
    return result;
}

/// Vim's `decl`: like `dec` but skips the NUL when crossing a line.
pub int Cur.decl() {
    int result = dec();
    if (result == 1 && col > 0) {
        result = dec();
    }
    return result;
}

/// Vim's `oneleft`: false at column 0.
pub bool Cur.did_oneleft() {
    if (col == 0) {
        return false;
    }
    col = MED_text.previous_col(buffer.line(row), col);
    return true;
}

/// The code point under the cursor, 0 on the NUL.
pub int Cur.char_code() {
    int code_point = MED_text.cp_at(buffer.line(row), col);
    if (code_point < 0) {
        return 0;
    }
    return code_point;
}

/// Vim's `back_in_line`: back to the start of the run of one class.
pub void Cur.back_in_line(bool is_big) {
    int sclass = cls(is_big);
    while (col > 0) {
        dec();
        if (cls(is_big) != sclass) {
            inc();
            break;
        }
    }
}

bool did_skip_chars(Cur cursor, int cclass, int directory, bool is_big) {
    while (cursor.cls(is_big) == cclass) {
        int moved = 0;
        if (directory > 0) {
            moved = cursor.inc();
        } else {
            moved = cursor.dec();
        }
        if (moved == -1) {
            return true;
        }
    }
    return false;
}

/// `w` / `W`. `is_eol` is true under an operator: the move stops at the end of
/// the line it would leave.
pub bool did_fwd_word(Cur cursor, int count, bool is_big, bool is_eol) {
    int left = count;
    while (left > 0) {
        left = left - 1;
        int sclass = cursor.cls(is_big);
        bool is_last_line = cursor.row == cursor.buffer.line_count() - 1;
        int index = cursor.inc();
        if (index == -1 || (index >= 1 && is_last_line)) {
            return false;
        }
        if (index >= 1 && is_eol && left == 0) {
            return true;
        }
        if (sclass != 0) {
            while (cursor.cls(is_big) == sclass) {
                index = cursor.inc();
                if (index == -1 || (index >= 1 && is_eol && left == 0)) {
                    return true;
                }
            }
        }
        while (cursor.cls(is_big) == 0) {
            if (cursor.is_empty_line()) {
                break;
            }
            index = cursor.inc();
            if (index == -1 || (index >= 1 && is_eol && left == 0)) {
                return true;
            }
        }
    }
    return true;
}

/// `b` / `B`.
pub bool did_bck_word(Cur cursor, int count, bool is_big, bool is_stop_flag) {
    bool is_stop = is_stop_flag;
    int left = count;
    while (left > 0) {
        left = left - 1;
        int sclass = cursor.cls(is_big);
        if (cursor.dec() == -1) {
            return false;
        }
        bool is_finished = false;
        if (!is_stop || sclass == cursor.cls(is_big) || sclass == 0) {
            while (cursor.cls(is_big) == 0) {
                if (cursor.is_empty_line()) {
                    is_finished = true;
                    break;
                }
                if (cursor.dec() == -1) {
                    return true;
                }
            }
            if (!is_finished) {
                if (did_skip_chars(cursor, cursor.cls(is_big), -1, is_big)) {
                    return true;
                }
            }
        }
        if (!is_finished) {
            cursor.inc();
        }
        is_stop = false;
    }
    return true;
}

/// `e` / `E` (and the `cw` form with `is_stop`).
pub bool did_end_word(Cur cursor, int count, bool is_big, bool is_stop_flag, bool is_empty) {
    bool is_stop = is_stop_flag;
    int left = count;
    while (left > 0) {
        left = left - 1;
        int sclass = cursor.cls(is_big);
        if (cursor.inc() == -1) {
            return false;
        }
        bool is_finished = false;
        if (cursor.cls(is_big) == sclass && sclass != 0) {
            if (did_skip_chars(cursor, sclass, 1, is_big)) {
                return false;
            }
        } else if (!is_stop || sclass == 0) {
            while (cursor.cls(is_big) == 0) {
                if (is_empty && cursor.is_empty_line()) {
                    is_finished = true;
                    break;
                }
                if (cursor.inc() == -1) {
                    return false;
                }
            }
            if (!is_finished) {
                if (did_skip_chars(cursor, cursor.cls(is_big), 1, is_big)) {
                    return false;
                }
            }
        }
        if (!is_finished) {
            cursor.dec();
        }
        is_stop = false;
    }
    return true;
}

/// `ge` / `gE`.
pub bool did_bckend_word(Cur cursor, int count, bool is_big, bool is_eol) {
    int left = count;
    while (left > 0) {
        left = left - 1;
        int sclass = cursor.cls(is_big);
        int index = cursor.dec();
        if (index == -1) {
            return false;
        }
        if (is_eol && index == 1) {
            return true;
        }
        if (sclass != 0) {
            while (cursor.cls(is_big) == sclass) {
                index = cursor.dec();
                if (index == -1 || (is_eol && index == 1)) {
                    return true;
                }
            }
        }
        while (cursor.cls(is_big) == 0) {
            if (cursor.is_empty_line()) {
                break;
            }
            index = cursor.dec();
            if (index == -1 || (is_eol && index == 1)) {
                return true;
            }
        }
    }
    return true;
}

/// Whether `line` is an nroff macro line (`.SH`) whose name is one of the pairs of `macros` ('paragraphs' or
/// 'sections'; a pair with a space or one letter names a one-letter macro), Vim's inmacro.
pub bool is_macro_line(str line, str macros) {
    if (line.size() < 2 || line.byte_at(0) != 46 || macros.size() == 0) {
        return false;
    }
    int first = line.byte_at(1);
    int second = 32;
    if (line.size() > 2) {
        second = line.byte_at(2);
    }
    int at = 0;
    while (at < macros.size()) {
        int want_first = macros.byte_at(at);
        int want_second = 32;
        if (at + 1 < macros.size()) {
            want_second = macros.byte_at(at + 1);
        }
        if (want_first == first && (want_second == second || (want_second == 32 && (line.size() == 2 || second == 32)))) {
            return true;
        }
        at = at + 2;
    }
    return false;
}

pub bool is_starts_paragraph(MED_buffer.Buffer buffer, int row, bool is_both, str macros = "") {
    str line = buffer.line(row);
    if (line.size() == 0) {
        return true;
    }
    int first = line.byte_at(0);
    return first == 12 || (is_both && first == 125) || (first == 46 && is_macro_line(line, macros));
}

/// `{` (dir -1) and `}` (dir 1). Returns the row, or -1 when it cannot move.
/// `last_line_end` is set when the motion ended on the last line's last
/// character (then it is inclusive).
pub Motion paragraph(MED_buffer.Buffer buffer, int row, int directory, int count, str macros = "") {
    int curr = row;
    int left = count;
    while (left > 0) {
        left = left - 1;
        bool did_skip = false;
        bool is_first = true;
        while (true) {
            if (buffer.line_size(curr) != 0) {
                did_skip = true;
            }
            if (!is_first && did_skip && is_starts_paragraph(buffer, curr, false, macros: macros)) {
                break;
            }
            curr = curr + directory;
            if (curr < 0 || curr >= buffer.line_count()) {
                if (left > 0) {
                    return failed();
                }
                curr = curr - directory;
                break;
            }
            is_first = false;
        }
    }
    Motion motion = Motion();
    motion.row = curr;
    motion.is_jump = true;
    motion.col = 0;
    if (curr == buffer.line_count() - 1 && directory > 0) {
        str line = buffer.line(curr);
        if (line.size() != 0) {
            motion.col = MED_text.last_col(line);
            motion.is_inclusive = true;
        }
    }
    return motion;
}

/// The column covering display column `want` (Vim's coladvance). `want` -1
/// means the end of the line. `is_one_more` lets the cursor stand on the NUL.
pub int col_for_want(str line, int want, int tab, bool is_one_more) {
    int size = line.size();
    if (size == 0) {
        return 0;
    }
    if (want < 0) {
        if (is_one_more) {
            return size;
        }
        return MED_text.last_col(line);
    }
    int spot = 0;
    int col = 0;
    while (col < size) {
        int width = MED_text.cell_width(line, col, spot, tab);
        if (want < spot + width) {
            return col;
        }
        spot = spot + width;
        col = MED_text.next_col(line, col);
    }
    if (is_one_more) {
        return size;
    }
    return MED_text.last_col(line);
}

/// `f F t T` search on one line. `directory` 1 or -1; `is_until` for t/T; `is_stop` false
/// lets a repeated `;` skip a match right next to the cursor.
pub Motion find_char(str line, int col, int target, int directory, bool is_until, int count, bool is_stop_flag) {
    bool is_stop = is_stop_flag;
    int left = count;
    int spot = col;
    int length = line.size();
    while (left > 0) {
        left = left - 1;
        while (true) {
            if (directory > 0) {
                spot = MED_text.next_col(line, spot);
                if (spot >= length) {
                    return failed();
                }
            } else {
                if (spot == 0) {
                    return failed();
                }
                spot = MED_text.previous_col(line, spot);
            }
            if (MED_text.cp_at(line, spot) == target && is_stop) {
                break;
            }
            is_stop = true;
        }
    }
    if (is_until) {
        if (directory > 0) {
            spot = MED_text.previous_col(line, spot);
        } else {
            // Vim steps one code point past the match (maybe into a cluster;
            // the cursor snaps to the cluster start, an operator does not)
            spot = spot + str.from_chars([MED_text.cp_at(line, spot)]).size();
        }
    }
    Motion motion = Motion();
    motion.col = spot;
    motion.is_inclusive = directory > 0;
    return motion;
}

// ---------------------------------------------------------------- sentences

bool is_white_ch(int char_code) {
    return char_code == 32 || char_code == 9;
}

bool is_in_set(str set, int char_code) {
    if (char_code == 0) {
        return false;
    }
    return set.index_of(str.from_chars([char_code])).is_some();
}

bool is_para_start(MED_buffer.Buffer buffer, int row) {
    str line = buffer.line(row);
    return line.size() == 0 || line.byte_at(0) == 12;
}

/// Vim's `findsent`: `(` (dir -1) and `)` (dir 1). Moves `current` on success.
pub bool did_findsent(Cur current, int directory, int count) {
    Cur position = Cur(current.buffer, current.row, current.col);
    bool is_noskip = false;
    int left = count;
    while (left > 0) {
        left = left - 1;
        bool is_found = false;
        if (position.char_code() == 0) {
            while (true) {
                int result = 0;
                if (directory > 0) {
                    result = position.incl();
                } else {
                    result = position.decl();
                }
                if (result == -1) {
                    break;
                }
                if (position.char_code() != 0) {
                    break;
                }
            }
            if (directory > 0) {
                is_found = true;
            }
        } else if (directory > 0 && position.col == 0 && is_para_start(position.buffer, position.row)) {
            if (position.row == position.buffer.line_count() - 1) {
                return false;
            }
            position.row = position.row + 1;
            is_found = true;
        } else if (directory < 0) {
            position.decl();
        }
        if (!is_found) {
            bool is_found_dot = false;
            while (true) {
                int char_code = position.char_code();
                if (!(is_white_ch(char_code) || is_in_set(".!?)]\"'", char_code))) {
                    break;
                }
                Cur tpos = Cur(position.buffer, position.row, position.col);
                if (tpos.decl() == -1 || (tpos.buffer.line_size(tpos.row) == 0 && directory > 0)) {
                    break;
                }
                if (is_found_dot) {
                    break;
                }
                if (is_in_set(".!?", char_code)) {
                    is_found_dot = true;
                }
                if (is_in_set(")]\"'", char_code) && !is_in_set(".!?)]\"'", tpos.char_code())) {
                    break;
                }
                position.decl();
            }
            int startrow = position.row;
            while (true) {
                int char_code = position.char_code();
                if (char_code == 0 || (position.col == 0 && is_para_start(position.buffer, position.row))) {
                    if (directory < 0 && position.row != startrow) {
                        position.row = position.row + 1;
                        position.col = 0;
                    }
                    break;
                }
                if (char_code == 46 || char_code == 33 || char_code == 63) {
                    Cur tpos = Cur(position.buffer, position.row, position.col);
                    int current_col = 0;
                    while (true) {
                        current_col = tpos.inc();
                        if (current_col == -1) {
                            break;
                        }
                        if (!is_in_set(")]\"'", tpos.char_code())) {
                            break;
                        }
                    }
                    int char_value = tpos.char_code();
                    if (current_col == -1 || char_value == 32 || char_value == 9 || char_value == 0) {
                        position.row = tpos.row;
                        position.col = tpos.col;
                        if (position.char_code() == 0) {
                            position.inc();
                        }
                        break;
                    }
                }
                int stepped = 0;
                if (directory > 0) {
                    stepped = position.incl();
                } else {
                    stepped = position.decl();
                }
                if (stepped == -1) {
                    if (left > 0) {
                        return false;
                    }
                    is_noskip = true;
                    break;
                }
            }
        }
        while (!is_noskip && is_white_ch(position.char_code())) {
            if (position.incl() == -1) {
                break;
            }
        }
    }
    current.row = position.row;
    current.col = position.col;
    return true;
}
