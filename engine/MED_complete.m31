/* Command-line completion (Tab on `:`): ex command names, option names,
 * file names, directory names and buffer names, in Vim's order (ASCII).
 *
 * API */
// ---
/*   MED_complete.complete(line, position, buffers, extra, themes)  -> Result
 *
 * `line` is the whole command line, `position` the cursor byte offset,
 * `buffers` the buffer names `:b` completes, `extra` more command names (the
 * front end's own) and `themes` the names `:theme` completes. `Result.start` is where the word being completed
 * begins in `line`; `Result.items` replace `line[start:position]`. */

import fs;
import io;
import os;
import engine.MED_complete_data;

pub type Completion {
    pub List<str> items = [];
    pub int start = 0;
}

/* Whether `word` is an abbreviation of the command `full` of at least
 * `shortest` letters (Vim's rule for command names). */
bool is_name_of(str word, str full, int shortest) {
    return word.size() >= shortest && full.starts_with(word);
}

bool is_set_command(str word) {
    return is_name_of(word, "set", 2) || is_name_of(word, "setlocal", 4) || is_name_of(word, "setglobal", 4);
}

bool is_buffer_command(str word) {
    return is_name_of(word, "buffer", 1) || is_name_of(word, "bdelete", 2) || is_name_of(word, "bwipeout", 2) || is_name_of(word, "bunload", 3) || is_name_of(word, "sbuffer", 2);
}

bool is_directory_command(str word) {
    return is_name_of(word, "cd", 2) || is_name_of(word, "chdir", 3) || is_name_of(word, "lcd", 2) || is_name_of(word, "lchdir", 3) || is_name_of(word, "tcd", 3);
}

bool is_file_command(str word) {
    if (is_name_of(word, "edit", 1) || is_name_of(word, "write", 1) || is_name_of(word, "read", 1) || is_name_of(word, "split", 2) || is_name_of(word, "vsplit", 2)) {
        return true;
    }
    if (is_name_of(word, "new", 3) || is_name_of(word, "vnew", 3) || is_name_of(word, "sview", 2) || is_name_of(word, "source", 2) || is_name_of(word, "saveas", 3)) {
        return true;
    }
    if (is_name_of(word, "update", 2) || is_name_of(word, "wq", 2) || is_name_of(word, "xit", 1) || is_name_of(word, "view", 3)) {
        return true;
    }
    return word == "Explore" || word == "Sexplore" || word == "Vexplore" || word == "Rename" || word == "Delete" || word == "Create" || word == "Mkdir";
}

bool is_letter(int code) {
    return (code >= 65 && code <= 90) || (code >= 97 && code <= 122);
}

// Where the command name starts: past blanks, `:` and the range.
int command_start(str line, int limit) {
    int index = 0;
    while (index < limit) {
        int code = line.byte_at(index);
        if (code == 32 || code == 9 || code == 58) {
            index = index + 1;
        } else if ((code >= 48 && code <= 57) || code == 46 || code == 36 || code == 37 || code == 44 || code == 59 || code == 43 || code == 45) {
            index = index + 1;
        } else if (code == 39 && index + 1 < limit) {
            index = index + 2;
        } else if (code == 47 || code == 63) {
            // a pattern range: up to the closing delimiter
            int stop_at = index + 1;
            while (stop_at < limit && line.byte_at(stop_at) != code) {
                if (line.byte_at(stop_at) == 92) {
                    stop_at = stop_at + 1;
                }
                stop_at = stop_at + 1;
            }
            index = stop_at + 1;
        } else {
            break;
        }
    }
    if (index > limit) {
        return limit;
    }
    return index;
}

// Whether `first` sorts after `second`, byte by byte (strcmp).
bool is_after(str first, str second) {
    int count = first.size();
    if (second.size() < count) {
        count = second.size();
    }
    for (int index in 0 .. count) {
        int one = first.byte_at(index);
        int two = second.byte_at(index);
        if (one != two) {
            return one > two;
        }
    }
    return first.size() > second.size();
}

// Whether `first` sorts after `second` ignoring ASCII case (file names on macOS).
bool is_after_folded(str first, str second) {
    int count = first.size();
    if (second.size() < count) {
        count = second.size();
    }
    for (int index in 0 .. count) {
        int one = first.byte_at(index);
        int two = second.byte_at(index);
        if (one >= 65 && one <= 90) {
            one = one + 32;
        }
        if (two >= 65 && two <= 90) {
            two = two + 32;
        }
        if (one != two) {
            return one > two;
        }
    }
    if (first.size() != second.size()) {
        return first.size() > second.size();
    }
    return is_after(first, second);
}

/* File names are sorted without regard to case where the file system does not
 * tell the cases apart (macOS), as Vim does. */
bool is_case_blind_files() {
    return fs.is_directory("/System/Library");
}

List<str> sorted_files(List<str> items) {
    if (!is_case_blind_files()) {
        return sorted(items);
    }
    List<str> copy = [];
    for (str item in items) {
        copy.push(item);
    }
    for (int index in 1 .. copy.size()) {
        str held = copy[index];
        int back = index - 1;
        while (back >= 0 && is_after_folded(copy[back], held)) {
            copy[back + 1] = copy[back];
            back = back - 1;
        }
        copy[back + 1] = held;
    }
    return copy;
}

List<str> sorted(List<str> items) {
    List<str> copy = [];
    for (str item in items) {
        copy.push(item);
    }
    // insertion sort: the lists are short once filtered
    for (int index in 1 .. copy.size()) {
        str held = copy[index];
        int back = index - 1;
        while (back >= 0 && is_after(copy[back], held)) {
            copy[back + 1] = copy[back];
            back = back - 1;
        }
        copy[back + 1] = held;
    }
    return copy;
}

List<str> unique_sorted(List<str> items) {
    List<str> out = [];
    for (str item in sorted(items)) {
        if (out.size() == 0 || out[out.size() - 1] != item) {
            out.push(item);
        }
    }
    return out;
}

List<str> command_matches(str prefix, List<str> extra) {
    List<str> found = [];
    for (str name in MED_complete_data.COMMANDS) {
        if (name.starts_with(prefix)) {
            found.push(name);
        }
    }
    for (str name in extra) {
        if (name.starts_with(prefix)) {
            found.push(name);
        }
    }
    return unique_sorted(found);
}

/* Option names completing `prefix`, in the order of Vim's option table: a name
 * or its short name that starts with it, then the `no` and `inv` forms of the
 * boolean ones. */
List<str> option_matches(str prefix) {
    List<str> found = [];
    List<str> names = MED_complete_data.OPTIONS;
    List<str> shorts = MED_complete_data.OPTION_SHORT_NAMES;
    for (int index in 0 .. names.size()) {
        str name = names[index];
        str short_name = "";
        if (index < shorts.size()) {
            short_name = shorts[index];
        }
        if (name.starts_with(prefix) || (short_name != "" && short_name.starts_with(prefix))) {
            found.push(name);
        }
        if (is_in(MED_complete_data.BOOL_OPTIONS, name)) {
            if (prefix.starts_with("no") && (("no" + name).starts_with(prefix) || (short_name != "" && ("no" + short_name).starts_with(prefix)))) {
                found.push("no" + name);
            }
            if (prefix.starts_with("inv") && (("inv" + name).starts_with(prefix) || (short_name != "" && ("inv" + short_name).starts_with(prefix)))) {
                found.push("inv" + name);
            }
        }
    }
    return found;
}

bool is_in(List<str> items, str wanted) {
    for (str item in items) {
        if (item == wanted) {
            return true;
        }
    }
    return false;
}

str escaped(str name) {
    return name.split("\\").join("\\\\").split(" ").join("\\ ");
}

List<str> path_matches(str given, bool is_directories_only) {
    str word = given;
    if (word == "~") {
        return [os.env("HOME").or("") + "/"];
    }
    if (word.starts_with("$")) {
        // $NAME at the start is replaced by its value
        int stop = 1;
        while (stop < word.size() && (is_letter(word.byte_at(stop)) || word.byte_at(stop) == 95 || (word.byte_at(stop) >= 48 && word.byte_at(stop) <= 57))) {
            stop = stop + 1;
        }
        str value = os.env(word.substr(1, stop)).or("");
        if (value != "") {
            word = value + word.substr(stop, word.size());
        }
    }
    str directory_part = "";
    str base = word;
    int slash = -1;
    for (int index in 0 .. word.size()) {
        if (word.byte_at(index) == 47) {
            slash = index;
        }
    }
    if (slash >= 0) {
        directory_part = word.substr(0, slash + 1);
        base = word.substr(slash + 1, word.size());
    }
    str actual = directory_part;
    if (actual.starts_with("~")) {
        actual = os.env("HOME").or("") + actual.substr(1, actual.size());
    }
    if (actual == "") {
        actual = ".";
    }
    List<str> found = [];
    if (base == "." && is_directories_only) {
        found.push(directory_part + "../");
        found.push(directory_part + "./");
    } else if (base == ".") {
        found.push(directory_part + "./");
        found.push(directory_part + "../");
    } else if (base == "..") {
        found.push(directory_part + "../");
        return found;
    }
    match (fs.listdir(actual)) {
        case Ok(List<str> names): {
            for (str name in names) {
                bool is_prefix = name.starts_with(base);
                if (!is_prefix && is_case_blind_files()) {
                    is_prefix = name.to_lower().starts_with(base.to_lower());
                }
                if (!is_prefix) {
                    continue;
                }
                if (name.starts_with(".") && !base.starts_with(".")) {
                    continue;
                }
                str full = fs.join(actual, name);
                bool is_directory = fs.is_directory(full);
                if (is_directories_only && !is_directory) {
                    continue;
                }
                if (is_directory) {
                    found.push(directory_part + escaped(name) + "/");
                } else {
                    found.push(directory_part + escaped(name));
                }
            }
        }
        case Err(io.Error error): {
        }
    }
    List<str> names_only = [];
    List<str> specials = [];
    for (str item in found) {
        if (item.ends_with("./") && (base == "." || base == "..") && specials.size() < 2 && (item == directory_part + "./" || item == directory_part + "../")) {
            specials.push(item);
        } else {
            names_only.push(item);
        }
    }
    /* a directory sorts by its name, not by the "/" after it ("next" before
     * "next-2"): the slash is swapped for a byte below every name character */
    List<str> keyed = [];
    for (str item in names_only) {
        if (item.ends_with("/")) {
            keyed.push(item.substr(0, item.size() - 1) + "\x01");
        } else {
            keyed.push(item);
        }
    }
    for (str item in sorted_files(keyed)) {
        if (item.ends_with("\x01")) {
            specials.push(item.substr(0, item.size() - 1) + "/");
        } else {
            specials.push(item);
        }
    }
    return specials;
}

List<str> buffer_matches(str word, List<str> buffers) {
    List<str> found = [];
    for (str name in buffers) {
        if (name.contains(word)) {
            found.push(name);
        }
    }
    return found;
}

pub Completion complete(str line, int position, List<str> buffers, List<str> extra, List<str> themes = []) {
    Completion result = Completion();
    int limit = position;
    if (limit > line.size()) {
        limit = line.size();
    }
    int start = command_start(line, limit);
    int index = start;
    while (index < limit && is_letter(line.byte_at(index))) {
        index = index + 1;
    }
    if (index >= limit) {
        // still typing the command name
        str prefix = line.substr(start, limit);
        if (prefix.size() == 0 && start > 0 && line.byte_at(start - 1) != 58 && line.byte_at(start - 1) != 32) {
            // a range with no command yet
        }
        result.start = start;
        result.items = command_matches(prefix, extra);
        return result;
    }
    str word = line.substr(start, index);
    int after = index;
    if (after < limit && line.byte_at(after) == 33) {
        after = after + 1;
    }
    if (after >= limit || (line.byte_at(after) != 32 && line.byte_at(after) != 9)) {
        return result;
    }
    // the argument being typed: from the last unescaped blank
    int arg_start = limit;
    while (arg_start > after) {
        int code = line.byte_at(arg_start - 1);
        if ((code == 32 || code == 9) && !(arg_start - 2 >= 0 && line.byte_at(arg_start - 2) == 92)) {
            break;
        }
        arg_start = arg_start - 1;
    }
    str argument = line.substr(arg_start, limit);
    result.start = arg_start;
    if (is_set_command(word)) {
        if (argument.contains("=") || argument.contains(":")) {
            return result;
        }
        result.items = option_matches(argument);
    } else if (is_buffer_command(word)) {
        result.items = buffer_matches(argument, buffers);
    } else if (is_directory_command(word)) {
        result.items = path_matches(argument, true);
    } else if (is_file_command(word)) {
        result.items = path_matches(argument, false);
    } else if (word == "Neotree" || word == "NeoTree") {
        List<str> subcommands = ["add", "close", "copy", "delete", "filter", "focus", "hidden", "move", "paste", "refresh", "rename", "reveal", "show", "toggle"];
        for (str name in subcommands) {
            if (name.starts_with(argument)) {
                result.items.push(name);
            }
        }
    } else if (word == "theme" || is_name_of(word, "colorscheme", 4)) {
        for (str name in themes) {
            if (name.starts_with(argument)) {
                result.items.push(name);
            }
        }
    } else if (is_name_of(word, "syntax", 2)) {
        List<str> subcommands = ["clear", "enable", "off", "on"];
        for (str name in subcommands) {
            if (name.starts_with(argument)) {
                result.items.push(name);
            }
        }
    }
    return result;
}
