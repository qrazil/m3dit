// The editor state a Vim-style session needs, and the primitives that edit
// it: transactions, the undo tree, cursor clamping. No key handling here.
//
// API
// ---
//   MED_editor.Editor                the whole state (buffer, cursor, mode, registers, undo tree ...)
//   MED_editor.new(text)             an Editor holding file text
//   editor.change(from, to, text)    the one edit entry point (records into the open undo block)
//   editor.end_block()               close the undo block (one per command / insert session)
//   editor.undo() / editor.redo()    walk the undo tree; the cursor lands where Vim puts it
//   editor.clamp()                   keep the cursor on a valid cell for the current mode
//   editor.want_from_cursor()        remember the cursor's display column for j / k
//
// Undo is a tree: each node holds the edits of one block and the cursor Vim
// would restore. `redo_child` of a node is the branch redo follows.

import engine.MED_buffer;
import engine.MED_register;
import engine.MED_text;
import engine.MED_wrapmap;
import engine.MED_snippet;
import engine.MED_num;
import engine.MED_motion;
import engine.MED_map;
import engine.MED_regex;
import syntax.core.SYN_highlight;
import engine.MED_semtok;

pub const int NORMAL = 0;
pub const int INSERT = 1;
pub const int REPLACE = 2;
pub const int VISUAL = 3;
pub const int CMDLINE = 4;

pub type Node {
    pub int seq;
    pub int parent;
    pub List<MED_buffer.Edit> edits;
    pub MED_buffer.Pos before;
    pub int redo_child = -1;
    /// The lowercase marks as they were before the change; undo and redo swap them with the current ones (Vim's uh_namedm).
    pub Map<str, MED_buffer.Pos> namedm = {};
}

/// The last f/F/t/T so `;` and `,` can repeat it.
pub type FindState {
    pub int target = -1;
    pub int directory = 1;
    pub bool is_until = false;
}

/// The rest of a macro that was stopped because it ran an ex command: the keys
/// still to run in the current round, the whole macro and the rounds after it.
pub type Resume {
    pub List<int> keys;
    pub List<int> full;
    pub int again = 0;
}

/// The state of a `:s` that asks before each replacement (`:s///c`): the loop
/// of the substitution, suspended at a prompt and resumed by the answer key.
/// A manual fold: the rows `start` ..= `end`. Folds nest by containment; of
/// two with the same rows the earlier one in `Editor.folds` is the outer one.
pub type Fold {
    pub int start = 0;
    pub int end = 0;
    pub bool is_closed = true;
    /// Follows 'foldlevel' (nobody opened or closed it by hand): see MED_autofold.
    pub bool is_level = false;
}

pub type SubRun {
    /// The commands after a `|` that follow a prompting `:s///c`: they run
    /// when it is answered.
    pub str rest = "";
    pub bool is_active = false;
    pub bool is_hold = false;
    pub bool is_quit = false;
    pub bool is_ask = false;
    pub MED_regex.Regex regex = MED_regex.Regex();
    pub MED_regex.Match match_value = MED_regex.Match();
    pub str pattern = "";
    pub str sub = "";
    pub int first_line = 0;
    pub int line2 = 0;
    pub bool should_all = false;
    pub bool should_count = false;
    pub bool should_error = true;
    pub bool is_endcolumn = false;
    pub bool is_multi = false;
    pub MED_buffer.Pos old_cursor = MED_buffer.Pos(0, 0);
    pub int nsubs = 0;
    pub bool is_got_match = false;
    pub bool is_uline_set = false;
    pub int lnum = 0;
    pub int base = 0;
    pub int nmatch = 0;
    pub int srel = 0;
    pub int erel = 0;
    pub int previous_matchcol = 0;
    pub int copycol = 0;
    pub int matchcol = 0;
    pub bool is_new_has = false;
    pub str new_start = "";
    pub bool did_sub = false;
    pub int nmatch_tl = 0;
    pub bool is_skip_match = false;
    pub int sub_row = 0;
    /// The first line a substitution changed (-1: none yet).
    pub int first_changed = -1;
    pub str sub_first = "";
    pub bool is_have_first = false;
}

pub type Editor {
    pub MED_buffer.Buffer buffer;
    pub int row = 0;
    pub int col = 0;
    /// Desired display column for vertical moves; -1 is "end of line".
    pub int want = 0;
    /// Vim's `w_set_curswant`: `want` is stale and is recomputed from the cursor before the next key.
    pub bool needs_stale = false;
    pub int mode = NORMAL;
    /// Visual: 118 (v), 86 (V) or 22 (CTRL-V); 0 when not selecting.
    pub int vkind = 0;
    pub int vrow = 0;
    pub int vcol = 0;
    pub MED_register.Registers regs = MED_register.Registers();
    pub List<Node> nodes = [];
    pub int current = 0;
    pub List<MED_buffer.Edit> block = [];
    pub bool is_block_open = false;
    pub MED_buffer.Pos block_before = MED_buffer.Pos(0, 0);
    pub Map<str, MED_buffer.Pos> block_namedm = {};
    pub int tab = 8;
    /// The window: first buffer line shown and number of lines it shows. The
    /// UI keeps these current; H, M and L (and CTRL-D etc.) use them.
    pub int view_top = 0;
    pub int view_height = 22;
    /// CTRL-D / CTRL-U distance; 0 means half the window.
    pub int scroll_opt = 0;
    /// Screen rows the cursor follows after CTRL-D / CTRL-U scrolled (curscount).
    pub int page_rows = 0;
    pub int shiftwidth = 8;
    /// 'textwidth' (0: the window width, at most 79, for `gq`) and the window's width.
    pub int textwidth = 0;
    pub int view_width = 80;
    /// Columns taken by the line-number column (0 without one).
    pub int view_gutter = 0;
    /// Columns of signs (git changes, marks) left of the line numbers.
    pub int sign_columns = 0;
    /// The widest line-number column and the sign column this buffer has shown: the
    /// gutter only grows, so deleting lines or a diagnostic clearing does not shift
    /// the text back (the front end's, not a Vim option).
    pub int gutter_digits_floor = 0;
    pub bool is_sign_floor = false;
    /// Screen rows of line `view_skip_line` that are scrolled off the top (nvim's
    /// 'smoothscroll' skipcol, left when CTRL-F stops in the last line).
    /// The cursor row for which `view_top` is known to be right (Vim's
    /// VALID_TOPLINE, set by cursor_correct); -1 when it must be checked.
    pub int view_valid_row = -1;
    /// Syntax highlighting: the language in use and the state each line starts
    /// in, cached by the `syntax` library (see MED_hl).
    pub SYN_highlight.Highlighter syn = SYN_highlight.Highlighter();
    /// Semantic tokens from a language server, painted over `syn`'s classes (engine/MED_semtok.m31).
    pub MED_semtok.Tokens sem = MED_semtok.Tokens();
    pub int view_valid_text = 0;
    pub int view_valid_height = 0;
    pub int view_valid_width = 0;
    pub int view_skip = 0;
    /// The first display column shown while lines do not wrap (Vim's leftcol).
    pub int view_left = 0;
    pub int view_skip_line = -1;
    /// The file name of the buffer (for `%` in `:!`, `:r`; kept by the front end).
    pub str file_name = "";
    /// The last `:!` command, for `!` in the next one.
    pub str last_shell = "";
    /// 'commentstring': `gc` wraps a line in this, `%s` standing for the text.
    pub str commentstring = "";
    pub bool is_expandtab = false;
    pub bool is_autoindent = true;
    pub bool is_ignorecase = false;
    pub bool is_smartcase = false;
    pub bool is_wrapscan = true;
    pub bool is_joinspaces = false;
    pub bool is_startofline = false;
    /// 'softtabstop' (negative: the shiftwidth), 'smarttab' and 'shiftround'.
    pub int softtabstop = 0;
    pub bool is_smarttab = true;
    pub bool is_shiftround = false;
    /// A space was typed in this insert (<BS> then deletes one space, not a 'softtabstop').
    pub bool did_space = false;
    /// The key typed before the current one in this insert (for `0 CTRL-D`).
    pub int ins_previous = 0;
    /// Every other option that was set, by full name, as text (see MED_option).
    pub Map<str, str> opts = {};
    pub List<int> pending = [];
    pub FindState find = FindState();
    pub Map<str, MED_buffer.Pos> marks = {};
    /// The jump list and the change list live in `marks` (as "~jN" and "~cN") so
    /// that edits move them like any mark; these are their lengths and the
    /// window's position in each.
    pub int jump_length = 0;
    pub int jump_index = 0;
    pub int change_length = 0;
    pub int change_index = 0;
    /// A new undo block started and no change list entry was made for it yet.
    pub bool is_new_change = false;
    /// Set by a command that failed (Vim would beep and flush macro input).
    pub bool is_failed = false;
    pub str message = "";
    pub bool is_quit = false;
    pub bool is_force_quit = false;
    /// The quit asked for closes one window (:q :wq :x ZZ ZQ), not the editor (:qa).
    pub bool is_quit_one = false;
    /// Keys of the command being typed, and the last repeatable change.
    pub List<int> cmd_keys = [];
    /// Pairs (first row, row count) of the buffer's git hunks, set by the front end for the `ih` / `ah` objects.
    pub List<int> hunk_spans = [];
    pub List<int> dot = [];
    pub bool is_changed_cmd = false;
    /// Executing dot or a macro: a failing command aborts the rest.
    pub bool is_replaying = false;
    /// How many times keys were replayed (macro, dot, :normal, :g): the front end
    /// compares it between frames to know a frame follows a replay.
    pub int replay_runs = 0;
    /// How many yanks happened, and the last one's range (for the yank flash).
    pub int yank_serial = 0;
    pub MED_buffer.Pos yank_start = MED_buffer.Pos(0, 0);
    pub MED_buffer.Pos yank_end = MED_buffer.Pos(0, 0);
    pub bool is_yank_lines = false;
    pub str macro_reg = "";
    pub List<int> macro_keys = [];
    /// The last command took a character argument (f, t, r ...): see `feed_key`.
    pub bool is_char_done = false;
    pub str last_macro = "";
    /// Insert session.
    pub int ins_cmd = 0;
    pub int ins_count = 1;
    pub List<int> ins_keys = [];
    pub str ins_text = "";
    pub bool did_ai = false;
    /// Vim's Insstart_orig: where backspacing with CTRL-W / CTRL-U stops.
    pub MED_buffer.Pos ins_start = MED_buffer.Pos(0, 0);
    /// The display width of that line when the insert began (Insstart_textlen).
    pub int ins_textlen = 0;
    /// Vim's Insstart, which becomes the '[ mark when the insert ends.
    pub MED_buffer.Pos ins_mark = MED_buffer.Pos(0, 0);
    /// The insert start an arrow key leaves pending (Vim's Insstart), taken
    /// over by `ins_start` at the next key unless `ins_hold`.
    pub MED_buffer.Pos ins_next = MED_buffer.Pos(0, 0);
    pub bool is_ins_next_set = false;
    pub bool is_ins_hold = false;
    /// Whether anything was typed in this insert yet.
    pub bool is_ins_dirty = false;
    pub List<str> replaced = [];
    /// Search.
    pub str search_pattern = "";
    pub int search_directory = 1;
    pub str sub_pattern = "";
    pub str sub_replacement = "";
    /// The pattern `n` and an empty `//` use is the substitute one (Vim's last_idx).
    pub bool is_last_is_sub = false;
    /// The search pattern was made by `*`: 'smartcase' does not apply to it.
    pub bool is_search_no_scs = false;
    /// <C-a> remembers whether the last hex number it changed used capitals.
    pub bool is_hexupper = false;
    /// The pattern about to be searched came from `*` (sets `search_no_scs`).
    pub bool is_search_no_scs_next = false;
    /// The last search offset: line offset, `e` offset and the number.
    pub bool is_search_off_line = false;
    pub bool is_search_off_end = false;
    pub int search_off = 0;
    /// What was typed after `/` or `?` (pattern, offset, `;` searches).
    pub str search_typed = "";
    /// The line `U` restores: its row, its text before the latest run of
    /// single-line changes and the cursor column then (Vim's b_u_line_*).
    pub int uline_row = -1;
    pub str uline_text = "";
    pub int uline_col = 0;
    pub bool is_uline_off = false;
    /// 'hlsearch' is suppressed until the next search (:noh).
    pub bool is_no_hl = false;
    /// Last Visual selection, for gv.
    pub int last_vkind = 0;
    pub MED_buffer.Pos last_vstart = MED_buffer.Pos(0, 0);
    pub MED_buffer.Pos last_vend = MED_buffer.Pos(0, 0);
    pub int last_vwant = 0;
    /// Command line (ex or search) being typed.
    pub str cmdline = "";
    pub int cmd_type = 58;
    /// Command-line histories (typed `:` lines, typed search patterns), oldest
    /// first, and the browsing state of the line being typed.
    pub List<str> hist_ex = [];
    /// Command-line completion (Tab): the matches, the one shown (-1: the typed
    /// text), where the word starts, what was typed there, and the buffer names
    /// `:b` and the front end's own command names it may use.
    pub List<str> comp_items = [];
    pub int comp_index = -1;
    pub int comp_start = 0;
    pub str comp_typed = "";
    pub str comp_tail = "";
    pub List<str> buffer_names = [];
    pub List<str> extra_commands = [];
    /// Ex commands extensions defined (`:Name args` becomes the request "Name args" for the front end). Empty unless
    /// an extension is built in (docs/EXTENSIONS.md).
    pub List<str> user_commands = [];
    /// The theme names `:theme` and `:colorscheme` complete (set by the front end).
    pub List<str> theme_names = [];
    pub List<str> hist_search = [];
    pub int hist_at = -1;
    pub str hist_prefix = "";
    /// What was typed before browsing began; Down past the newest entry restores it.
    pub str hist_typed = "";
    pub List<int> cmd_saved = [];
    /// The cursor in `cmdline`, as a byte offset.
    pub int cmd_position = 0;
    /// A command-line key waiting for its argument: 22 CTRL-V, 18 CTRL-R, 19 CTRL-R CTRL-R.
    pub int cmd_wait = 0;
    /// The first key of a CTRL-K digraph.
    pub int dig_first = 0;
    /// The `=` prompt of CTRL-R =: where it was opened from (0 none, 1 command line, 2 Insert)
    /// and what the line it replaced held.
    pub int expr_from = 0;
    pub str expr_line = "";
    pub int expr_position = 0;
    pub int expr_type = 58;
    pub int expr_hist_at = -1;
    pub str expr_hist_prefix = "";
    /// The key that ended a CTRL-V number is not part of it.
    pub bool is_lit_reuse = false;
    pub str ex_line = "";
    pub int mode_before_cmd = 0;
    /// Insert mode waiting for the key after CTRL-R / CTRL-V.
    pub int ins_wait = 0;
    /// Surround (MED_surround): the command being collected ("ys", "yS", "ds",
    /// "cs", "cS", "vS", "vgS"), what was typed so far, and what it names.
    pub str sur_command = "";
    pub int sur_stage = 0;
    pub List<int> sur_keys = [];
    pub str sur_kind = "";
    pub str sur_old = "";
    pub str sur_new = "";
    pub str sur_input = "";
    pub str sur_last_deleted = "";
    /// `:let` variables ("i" + digits or "s" + text), what `\=` and `:echo` read.
    pub Map<str, str> vars = {};
    /// `:iabbrev` / `:abbreviate` (Insert mode): left-hand sides and right-hand sides, in definition order.
    pub List<str> abbr_lhs = [];
    pub List<str> abbr_rhs = [];
    /// Where each applies: "i" Insert, "c" command line, "!" both.
    pub List<str> abbr_mode = [];
    pub bool is_abbr_busy = false;
    pub int sur_count = 1;
    pub int sur_lines = 0;
    pub bool is_sur_prepared = false;
    pub bool was_sur_startofline = false;
    pub bool is_sur_special = false;
    pub bool is_sur_orig_empty = true;
    pub MED_register.Reg sur_orig = MED_register.Reg([], MED_register.CHAR);
    pub str sur_keeper = "";
    pub str sur_okeeper = "";
    pub str sur_removed = "";
    pub str sur_regtype = "";
    pub str sur_pcmd = "";
    pub int sur_oldlnum = 0;
    /// Auto pairs: the row <CR> opened between a pair (-1: none), and set
    /// while the keys of a decision are being typed.
    pub int ap_return_row = -1;
    pub bool is_autopair_busy = false;
    /// Keyword completion (CTRL-N / CTRL-P) in progress: the items (the first
    /// is the typed text), the shown one, where the word starts, and what
    /// `ins_text` / `ins_keys` held when it began.
    pub bool is_completing = false;
    /// An arrow key moved the cursor in this insert and nothing was typed since.
    pub bool is_ins_moved = false;
    /// Virtual Replace mode (gR): replaces screen cells, and the number of
    /// lines the buffer had when it began.
    pub bool is_virtual = false;
    pub int virtual_lines = 0;
    pub List<str> completion_items = [];
    pub int completion_index = 0;
    pub int completion_col = 0;
    pub str completion_text = "";
    pub int completion_keys = 0;
    /// State of a CTRL-V number being typed (Vim's get_literal).
    pub bool is_lit_hex = false;
    pub bool is_lit_octal = false;
    pub int lit_uni = 0;
    pub int lit_cc = 0;
    pub int lit_i = 0;
    /// An arrow key was used and nothing typed since (Vim's arrow_used).
    pub bool is_ins_arrow = false;
    /// Insert-mode CTRL-O: the mode to come back to (105 insert, 82 replace) once
    /// the next Normal command is done, 0 when not waiting for that.
    pub int restart_edit = 0;
    pub bool is_restart_skip = false;
    pub bool is_ins_at_eol = false;
    pub int o_lnum = 0;
    pub bool is_ins_ctrl_o = false;
    /// The insert was restarted by CTRL-O and nothing was typed yet.
    pub bool is_ins_restart = false;
    /// Replaying the dot register (its keys are not recorded again).
    pub bool is_in_dot = false;
    /// A `/` or `?` whose pattern was just typed: the motion may run.
    pub bool is_search_ready = false;
    /// `"=` was answered (the value is in register `=`): do not ask again.
    pub bool is_expr_ready = false;
    pub str dot_reg = "";
    pub int dot_count = 0;
    pub List<int> dot_body = [];
    pub List<int> dot_tail = [];
    /// Visual redo for `.` after a Visual operator: kind, line count, column count.
    pub int dot_vkind = 0;
    pub int dot_vlines = 0;
    pub int dot_vcols = 0;
    pub int dot_vwant = 0;
    /// Redoing a Visual operation: block width comes from `dot_vcols`.
    pub bool is_visible_redo = false;
    /// A block-wise I, A or c in progress: what was typed on the first line is
    /// copied to the others when the insert ends. `blk_op` is 73, 65, 99 or 0.
    pub int blk_op = 0;
    pub int blk_top = 0;
    pub int blk_bottom = 0;
    pub int blk_sv = 0;
    pub int blk_ev = 0;
    pub bool is_blk_eol = false;
    pub int blk_col = 0;
    pub int blk_tail = 0;
    pub int blk_start_col = 0;
    pub int blk_pre_length = 0;
    pub int blk_ind_col = 0;
    pub int blk_ind_vcol = 0;
    pub int blk_current_col = 0;
    /// The `:map` tables (the UI shares one set between buffers).
    pub MED_map.Maps maps = MED_map.Maps();
    /// Keys waiting to be resolved against the maps, and where each came from
    /// (see MED_ex: 0 typed, 1 mapped, 2 mapped without remapping).
    pub List<int> ta_keys = [];
    pub List<int> ta_flags = [];
    /// The key being fed came out of a mapping (it is not typed).
    pub bool is_map_key = false;
    /// Ex command lines typed (or replayed) and not yet run: MED_ex runs them,
    /// because only it can call into the ex executor.
    pub List<str> ex_queue = [];
    /// Macros stopped for an ex command, first to continue first.
    pub List<Resume> resume = [];
    pub List<int> park = [];
    pub bool is_park_set = false;
    /// Lines `:g` has marked and not run yet (rows, ascending).
    pub List<int> gmarks = [];
    pub bool is_gmarks_on = false;
    pub bool is_global_busy = false;
    /// 'smartindent': the line just opened got an extra level (Vim's did_si), and
    /// the indent a `#` line left (it goes back after the next <CR>).
    pub bool did_si = false;
    pub bool can_si = false;
    pub bool is_no_si = false;
    pub bool can_si_back = false;
    /// `O` above a line starting with `}` gave the new line one level more.
    pub bool has_si_extra = false;
    pub int si_hash_indent = 0;
    /// The snippet being filled in (MED_snippet, driven by MED_snipops), whether the Visual selection is Select mode (a
    /// typed key replaces it), the snippets the user defined and the language they are filtered by, and the time the
    /// CURRENT_* variables read.
    pub MED_snippet.Session snip = MED_snippet.Session();
    pub bool is_select = false;
    pub List<MED_snippet.Entry> snippets = [];
    pub str snip_language = "";
    pub int snip_now = 0;
    /// The absolute path of the file, for $TM_FILEPATH and $TM_DIRECTORY.
    pub str snip_path = "";
    /// How many tab pages there are and which is active (1-based), for ranges such as `:2tabnew` and `:$tab split`.
    pub int tab_count = 1;
    pub int tab_current = 1;
    /// Manual folds, and whether folding is on at all (zn / zN / zi).
    pub List<Fold> folds = [];
    pub bool is_fold_off = false;
    /// The method, options and text the fold list was computed for, and the 'foldlevel' it follows (MED_autofold).
    pub str fold_method = "manual";
    pub str fold_sig = "";
    pub int fold_tick = -1;
    pub int fold_fdl = 0;
    /// A `:g` command is waiting for the answer to a `:s///c` prompt: the
    /// command to go on with, and whether the answer quit the whole `:g`.
    pub bool is_global_waiting = false;
    pub str global_cmd = "";
    pub bool is_need_beginline = false;
    /// Nesting of ex lines (`:normal`, `:g`): 0 when typed.
    pub int ex_depth = 0;
    /// The flags of the last `:s`, for `:&&`.
    pub str sub_flags = "";
    /// What the UI layer has to do: "write", "write NAME", "edit NAME", ...
    pub List<str> requests = [];
    /// While above 0 (inside an ex line) `end_block` keeps the block open.
    pub int block_hold = 0;
    /// A `:s///c` waiting for the answer to its prompt.
    pub SubRun sub_run = SubRun();
    /// How many of the `block_hold`s belong to running macros (`@a` is one undo step).
    pub int macro_holds = 0;
    /// Undo-tree states (node seq) at which the buffer was written, oldest first.
    pub List<int> saved_nodes = [];
    /// Set while a typed `:` line runs when Vim would not remember it in the `:` register.
    pub bool is_colon_skip = false;
    /// The raw text of the last `:s` replacement (before `~` is expanded).
    pub str sub_old = "";
    pub bool is_sub_has = false;
    /// Set while a caller adjusts the marks itself (`:s` line breaks).
    pub bool is_adjust_off = false;
    /// Set while a step is saved for undo without a change to note (a
    /// `:sort` that moved nothing): `.` and the change list stay.
    pub bool is_change_unnoted = false;
    /// Whole lines are being deleted (the Visual marks then stay on the line
    /// that took their place).
    bool is_line_delete = false;
}

/// The effective 'shiftwidth': 0 stands for 'tabstop'.
pub int Editor.shift_size() {
    if (shiftwidth <= 0) {
        return tab;
    }
    return shiftwidth;
}

/// The effective 'softtabstop': negative stands for the shiftwidth.
pub int Editor.soft_width() {
    if (softtabstop < 0) {
        return shift_size();
    }
    return softtabstop;
}

/// Whether the boolean option `name` is on (for options kept in `opts`).
pub bool Editor.is_option_on(str name, bool is_default) {
    str text = opts.get(name).or("");
    if (text == "") {
        return is_default;
    }
    return text == "true";
}

/// The number option `name` (for options kept in `opts`).
pub int Editor.option_number(str name, int default_value) {
    str text = opts.get(name).or("");
    if (text == "") {
        return default_value;
    }
    return text.parse_int().or(default_value);
}

pub bool Editor.did_in_visual() {
    return mode == VISUAL;
}

pub MED_buffer.Pos Editor.cursor() {
    return MED_buffer.Pos(row, col);
}

pub void Editor.set_cursor(MED_buffer.Pos position) {
    row = position.row;
    col = position.col;
}

/// Start the undo block now, remembering the cursor as it is (what Vim's
/// u_save() sees when an ex command positions the cursor "for undo").
pub void Editor.open_block() {
    if (!is_block_open) {
        is_block_open = true;
        is_new_change = true;
        block = [];
        block_before = MED_buffer.Pos(row, col);
        block_namedm = snapshot_named();
    }
}

/// Put the `.` mark (and the newest change list entry) where nvim's own
/// bookkeeping of a whole-line change leaves it: the first line it touched,
/// column 0 (put, join, line delete, shift, :copy, :move, :s, undo ...).
pub void Editor.override_change(MED_buffer.Pos place) {
    marks.set(".", place);
    if (change_length > 0) {
        marks.set(change_name(change_length - 1), place);
    }
}

/// The single entry point for changing text. The first change of a block
/// remembers the cursor, which is what undo restores.
pub MED_buffer.Edit Editor.change(MED_buffer.Pos from, MED_buffer.Pos position, str replacement) {
    if (!is_block_open) {
        is_block_open = true;
        is_new_change = true;
        block = [];
        block_before = MED_buffer.Pos(row, col);
        block_namedm = snapshot_named();
    }
    if (!is_change_unnoted && (from.row != position.row || from.col != position.col || replacement != "")) {
        note_change(from);
    }
    if (!is_uline_off && from.row == position.row && uline_row != from.row && !replacement.index_of("\n").is_some()) {
        // u_save() of a single line remembers it for `U`
        uline_row = from.row;
        uline_text = buffer.line(from.row);
        uline_col = 0;
        if (row == from.row) {
            uline_col = col;
        }
    }
    MED_buffer.Edit edit = buffer.splice(from, position, replacement);
    block.push(edit);
    if (!is_adjust_off) {
        adjust_lines(from, position, replacement);
    }
    if (snip.is_active) {
        snip.adjust(from.row, from.col, position.row, position.col, replacement);
    }
    return edit;
}

/// The first row of the outermost closed fold that holds `row`, or -1.
pub int Editor.fold_start_of(int row) {
    if (is_fold_off || folds.size() == 0) {
        return -1;
    }
    int found = -1;
    int found_end = -1;
    int minlines = option_number("foldminlines", 1);
    for (Fold fold in folds) {
        if (fold.is_closed && fold.start <= row && row <= fold.end && fold.end - fold.start + 1 > minlines) {
            if (found < 0 || fold.start < found || (fold.start == found && fold.end > found_end)) {
                found = fold.start;
                found_end = fold.end;
            }
        }
    }
    return found;
}

/// The last row of the outermost closed fold that holds `row`, or -1.
pub int Editor.fold_end_of(int row) {
    if (is_fold_off || folds.size() == 0) {
        return -1;
    }
    int found = -1;
    int found_start = -1;
    int minlines = option_number("foldminlines", 1);
    for (Fold fold in folds) {
        if (fold.is_closed && fold.start <= row && row <= fold.end && fold.end - fold.start + 1 > minlines) {
            if (found < 0 || fold.start < found_start || (fold.start == found_start && fold.end > found)) {
                found = fold.end;
                found_start = fold.start;
            }
        }
    }
    return found;
}

// Folds follow the lines (Vim's foldMarkAdjust): deleted lines shrink or
// remove them, inserted lines inside one grow it.
void Editor.fold_adjust(int left, int new_delete, int new_insert) {
    if (folds.size() == 0) {
        return;
    }
    List<Fold> kept = [];
    for (Fold fold in folds) {
        int start = fold.start;
        int end = fold.end;
        bool is_gone = false;
        if (new_delete > 0) {
            int last_deleted = left + new_delete - 1;
            if (end < left) {
            } else if (start > last_deleted) {
                start = start - new_delete;
                end = end - new_delete;
            } else if (start >= left && end <= last_deleted) {
                is_gone = true;
            } else if (start < left && end > last_deleted) {
                end = end - new_delete;
            } else if (start < left) {
                end = left - 1;
            } else {
                start = left;
                end = end - new_delete;
            }
        }
        if (!is_gone && new_insert > 0) {
            if (end < left) {
            } else if (start >= left) {
                start = start + new_insert;
                end = end + new_insert;
            } else {
                end = end + new_insert;
            }
        }
        if (!is_gone) {
            kept.push(Fold(start: start, end: end, is_closed: fold.is_closed, is_level: fold.is_level));
        }
    }
    folds = kept;
}

/// Lines `a ..< a + nd` were deleted and `new_insert` lines inserted at `a + nd`
/// (Vim's mark_adjust()): move or drop the marks that sit below.
pub void Editor.mark_adjust(int left, int new_delete, int new_insert) {
    fold_adjust(left, new_delete, new_insert);
    if (is_gmarks_on && gmarks.size() > 0) {
        List<int> kept = [];
        for (int marker in gmarks) {
            if (marker >= left && marker < left + new_delete) {
                continue;
            }
            if (marker >= left + new_delete) {
                kept.push(marker + new_insert - new_delete);
            } else {
                kept.push(marker);
            }
        }
        gmarks = kept;
    }
    List<str> names = [];
    for (str name in marks.keys()) {
        names.push(name);
    }
    for (str name in names) {
        if (name == "[" || name == "]") {
            continue;
        }
        MED_buffer.Pos position = marks.get(name).or(MED_buffer.Pos(-1, 0));
        if (position.row < 0) {
            continue;
        }
        int char_code = name.byte_at(0);
        bool is_letter = (char_code >= 97 && char_code <= 122) || (char_code >= 65 && char_code <= 90);
        if (position.row >= left && position.row < left + new_delete) {
            if (is_letter) {
                marks.remove(name);
            } else if (name == "'" || name == "'prev") {
                // a deleted previous-context mark is line 0 (checkpcmark() may
                // bring the one before it back)
                marks.set(name, MED_buffer.Pos(-1, 0));
            } else if ((name == "<" || name == ">") && is_line_delete) {
                // the Visual marks stay on the first line that took the place
                marks.set(name, MED_buffer.Pos(left, position.col));
            } else {
                int result = left;
                if (result > 0) {
                    result = result - 1;
                }
                marks.set(name, MED_buffer.Pos(result, position.col));
            }
        } else if (position.row >= left + new_delete) {
            marks.set(name, MED_buffer.Pos(position.row + new_insert - new_delete, position.col));
        }
    }
}

// Work out which whole lines a character edit deleted or inserted the way Vim's
// line operations would have, and adjust the marks for it.
void Editor.adjust_lines(MED_buffer.Pos from, MED_buffer.Pos position, str replacement) {
    int removed = position.row - from.row;
    int added = 0;
    for (int i in 0 .. replacement.size()) {
        if (replacement.byte_at(i) == 10) {
            added = added + 1;
        }
    }
    if (removed == 0 && added == 0) {
        return;
    }
    if (replacement == "" && from.col == 0 && position.col == 0 && removed > 0) {
        is_line_delete = true;
        mark_adjust(from.row, removed, 0);
        is_line_delete = false;
    } else if (removed == 0 && from.col == 0 && added > 0 && replacement.ends_with("\n")) {
        mark_adjust(from.row, 0, added);
    } else if (added > removed) {
        mark_adjust(from.row + 1, 0, added - removed);
    } else if (removed > added) {
        mark_adjust(from.row + 1, removed - added, 0);
    }
}

/// `U`: swap the saved line with the current text of that line.
pub bool Editor.did_undo_line() {
    if (uline_row < 0 || uline_row >= buffer.line_count()) {
        return false;
    }
    int spot = uline_row;
    str old = buffer.line(spot);
    str saved_text = uline_text;
    int saved_col = uline_col;
    is_uline_off = true;
    change(MED_buffer.Pos(spot, 0), MED_buffer.Pos(spot, old.size()), saved_text);
    is_uline_off = false;
    uline_text = old;
    if (row == spot) {
        uline_col = col;
    }
    row = spot;
    col = saved_col;
    clamp();
    want_from_cursor();
    return true;
}

/// Let go of the holds of finished macros; the undo block closes in Normal mode.
pub void Editor.release_macro_holds() {
    if (macro_holds == 0) {
        return;
    }
    block_hold = block_hold - macro_holds;
    macro_holds = 0;
    if (block_hold == 0 && mode == NORMAL) {
        end_block();
    }
}

/// Close the open block even inside an ex line (undo and redo need that).
pub void Editor.close_block() {
    int hold = block_hold;
    block_hold = 0;
    end_block();
    block_hold = hold;
}

/// A node that changes nothing: Vim saves the line for undo before it finds out
/// a put has nothing to put, so `u` then undoes that empty step.
pub void Editor.noop_node() {
    if (block_hold > 0) {
        return;
    }
    close_block();
    int seq = nodes.size();
    List<MED_buffer.Edit> none = [];
    Node node = Node(seq, current, none, MED_buffer.Pos(row, col));
    node.namedm = snapshot_named();
    nodes.push(node);
    nodes[current].redo_child = seq;
    current = seq;
}

/// Close the open undo block, if any, as one node of the tree.
pub void Editor.end_block() {
    if (block_hold > 0) {
        return;
    }
    if (!is_block_open) {
        return;
    }
    is_block_open = false;
    if (block.size() == 0) {
        return;
    }
    int seq = nodes.size();
    Node node = Node(seq, current, block, block_before);
    node.namedm = block_namedm;
    nodes.push(node);
    nodes[current].redo_child = seq;
    current = seq;
    block = [];
}

Landing Editor.apply_edit(MED_buffer.Edit edit, bool is_forward) {
    str from_text = edit.inserted;
    str to_text = edit.removed;
    if (is_forward) {
        from_text = edit.removed;
        to_text = edit.inserted;
    }
    int oldsize = line_span(from_text);
    int newsize = line_span(to_text);
    List<str> old_lines = [];
    for (int i in 0 .. oldsize) {
        old_lines.push(buffer.line(edit.from.row + i));
    }
    MED_buffer.Pos end = MED_buffer.advance(edit.from, from_text);
    buffer.tick = buffer.tick + 1;
    buffer.is_modified = true;
    buffer.splice(edit.from, end, to_text);
    int differ = 0;
    int limit = MED_num.smaller(oldsize, newsize);
    while (differ < limit && old_lines[differ] == buffer.line(edit.from.row + differ)) {
        differ = differ + 1;
    }
    Landing landing = Landing();
    landing.top = edit.from.row;
    landing.first = differ;
    landing.newsize = newsize;
    // Vim's undo entries hold whole lines: a pure line insertion or deletion
    // spans one line fewer than the character edit does.
    landing.mtop = landing.top;
    landing.mnew = newsize;
    if (from_text == "" || to_text == "") {
        str moved = from_text + to_text;
        if (moved.starts_with("\n")) {
            // a line break at the start of a line opened a line above it (O),
            // one at the end of a line a line below it (o)
            bool is_above = false;
            if (edit.from.col == 0) {
                if (from_text == "") {
                    is_above = old_lines[0].size() > 0;
                } else {
                    is_above = old_lines[0].size() == 0 && old_lines.size() > 1 && old_lines[1].size() > 0;
                }
            }
            landing.mtop = landing.top + 1;
            if (is_above) {
                landing.mtop = landing.top;
            }
            landing.mnew = newsize - 1;
        } else if (moved.ends_with("\n") && edit.from.col == 0) {
            landing.mnew = newsize - 1;
        }
    }
    int moldsize = oldsize - (newsize - landing.mnew);
    if (moldsize != landing.mnew) {
        // u_undoredo(): the marks on the replaced lines go, the ones below move
        mark_adjust(landing.mtop, moldsize, landing.mnew);
    }
    return landing;
}

// '[ and '] after undo / redo: the first and last line the block touched.
void Editor.set_undo_marks(List<Landing> landings, int old_lines) {
    int start = old_lines;
    int end = 0;
    for (Landing landing in landings) {
        if (landing.mtop + 1 < start) {
            start = landing.mtop + 1;
        }
        if (landing.mnew == 0) {
            if (landing.mtop + 1 > end) {
                end = landing.mtop + 1;
            }
        } else if (landing.mtop + landing.mnew > end) {
            end = landing.mtop + landing.mnew;
        }
    }
    if (start > buffer.line_count()) {
        start = buffer.line_count();
    }
    if (end > buffer.line_count()) {
        end = buffer.line_count();
    }
    if (end < 1) {
        end = 1;
    }
    marks.set("[", MED_buffer.Pos(start - 1, 0));
    marks.set("]", MED_buffer.Pos(end - 1, 0));
}

// Vim's cursor placement after undo / redo of one block.
void Editor.land(Node node, List<Landing> landings, bool is_undoing, int old_lines) {
    set_undo_marks(landings, old_lines);
    int newlnum = 1000000000;
    int cursor_row = row;
    bool is_set_row = false;
    int saved = node.before.row + 1;
    int index = 0;
    for (Landing landing in landings) {
        index = index + 1;
        int vfirst = landing.first - (landing.mtop - landing.top);
        if (vfirst < 0) {
            vfirst = 0;
        }
        if (landing.mtop < newlnum) {
            if (saved >= landing.mtop && saved <= landing.mtop + landing.mnew + 1) {
                cursor_row = node.before.row;
                is_set_row = true;
                newlnum = cursor_row;
            } else if (vfirst == landing.mnew && newlnum == 1000000000 && index == landings.size()) {
                newlnum = landing.mtop;
                cursor_row = newlnum;
                is_set_row = true;
            } else if (vfirst < landing.mnew) {
                newlnum = landing.mtop + vfirst;
                cursor_row = newlnum;
                is_set_row = true;
            }
        }
    }
    if (landings.size() > 0) {
        // the `.` mark: where the last entry processed changed lines
        override_change(MED_buffer.Pos(landings[landings.size() - 1].mtop, 0));
    }
    int lnum = cursor_row + 1;
    if (!is_set_row) {
        lnum = row + 1;
        if (!is_undoing && landings.size() == 0) {
            // redoing an empty step (a failed put) moves to where it was made
            lnum = node.before.row + 1;
        }
    }
    int clamped = lnum;
    if (clamped > buffer.line_count()) {
        clamped = buffer.line_count();
    }
    if (node.before.row + 1 + 1 == clamped && clamped > 1) {
        // off by one line after the clamp (a moved block): Vim ends on the line it began on
        lnum = clamped - 1;
    } else if (node.before.row + 1 + 1 == lnum && lnum > 1) {
        lnum = lnum - 1;
    }
    if (lnum <= buffer.line_count()) {
        row = lnum - 1;
        if (node.before.row + 1 == lnum) {
            col = node.before.col;
        } else if (is_startofline) {
            col = MED_text.first_nonblank(buffer.line(row));
        } else {
            col = col_for_want(row, want, false);
        }
    } else {
        row = buffer.line_count() - 1;
    }
    clamp();
    want_from_cursor();
}

// The lowercase marks, a copy.
Map<str, MED_buffer.Pos> Editor.snapshot_named() {
    Map<str, MED_buffer.Pos> copy = {};
    for (str name in marks.keys()) {
        if (name.size() == 1) {
            int code = name.byte_at(0);
            if (code >= 97 && code <= 122) {
                copy.set(name, marks.get(name).or(MED_buffer.Pos(-1, 0)));
            }
        }
    }
    return copy;
}

// After undoing or redoing `node`: its marks come back, and it keeps the ones
// that were set before (Vim's u_undoredo()).
void Editor.swap_named(Node node, Map<str, MED_buffer.Pos> before) {
    for (str name in node.namedm.keys()) {
        MED_buffer.Pos saved = node.namedm.get(name).or(MED_buffer.Pos(-1, 0));
        if (saved.row >= 0) {
            marks.set(name, saved);
        }
    }
    Map<str, MED_buffer.Pos> kept = {};
    for (str name in before.keys()) {
        MED_buffer.Pos old = before.get(name).or(MED_buffer.Pos(-1, 0));
        if (old.row >= 0) {
            kept.set(name, old);
        }
    }
    node.namedm = kept;
}

/// Undo one block. False when already at the oldest change.
pub bool Editor.did_undo() {
    close_block();
    snip = MED_snippet.Session();
    if (current == 0) {
        return false;
    }
    Node node = nodes[current];
    int old_lines = buffer.line_count();
    Map<str, MED_buffer.Pos> before = snapshot_named();
    List<Landing> landings = [];
    int index = node.edits.size() - 1;
    while (index >= 0) {
        landings.push(apply_edit(node.edits[index], false));
        index = index - 1;
    }
    land(node, landings, true, old_lines);
    swap_named(node, before);
    current = node.parent;
    nodes[current].redo_child = node.seq;
    return true;
}

/// Redo along the branch last undone. False when there is nothing to redo.
pub bool Editor.did_redo() {
    close_block();
    snip = MED_snippet.Session();
    int child = nodes[current].redo_child;
    if (child < 0) {
        return false;
    }
    Node node = nodes[child];
    int old_lines = buffer.line_count();
    Map<str, MED_buffer.Pos> before = snapshot_named();
    List<Landing> landings = [];
    for (MED_buffer.Edit edit in node.edits) {
        landings.push(apply_edit(edit, true));
    }
    land(node, landings, false, old_lines);
    swap_named(node, before);
    current = child;
    return true;
}

/// Go to the text state after change `target` (0: the original text), through
/// the undo and redo steps between here and there (`:undo N`, `g-`, `g+`).
pub bool Editor.did_undo_to(int target) {
    close_block();
    if (target < 0 || target >= nodes.size()) {
        return false;
    }
    List<int> chain = [];
    int count = target;
    while (count != 0) {
        chain.push(count);
        count = nodes[count].parent;
    }
    chain.push(0);
    int spot = -1;
    while (spot < 0) {
        for (int i in 0 .. chain.size()) {
            if (chain[i] == current) {
                spot = i;
                break;
            }
        }
        if (spot < 0) {
            if (!did_undo()) {
                return false;
            }
        }
    }
    int key = spot - 1;
    while (key >= 0) {
        nodes[current].redo_child = chain[key];
        if (!did_redo()) {
            return false;
        }
        key = key - 1;
    }
    return true;
}

/// True when 'wrap' is on and 'linebreak', 'showbreak' or 'breakindent' changes where text lands (MED_wrapmap).
pub bool Editor.is_wrap_special() {
    if (view_width < 1 || !is_option_on("wrap", true)) {
        return false;
    }
    if (is_option_on("linebreak", false) || is_option_on("breakindent", false)) {
        return true;
    }
    str text = opts.get("showbreak").or("");
    return text.size() > 0;
}

/// The window and the options a MED_wrapmap layout depends on.
pub MED_wrapmap.Settings Editor.wrap_settings() {
    MED_wrapmap.Settings settings = MED_wrapmap.Settings();
    settings.width = view_width;
    settings.tab = tab;
    settings.is_linebreak = is_option_on("linebreak", false);
    settings.is_breakindent = is_option_on("breakindent", false);
    settings.breakat = opts.get("breakat").or(" \t!@*-+;:,./?");
    settings.showbreak = opts.get("showbreak").or("");
    settings.breakindentopt = opts.get("breakindentopt").or("");
    return settings;
}

/// How `line` lies in the window under 'linebreak', 'showbreak' and 'breakindent'.
pub MED_wrapmap.Layout Editor.wrap_layout(str line) {
    return MED_wrapmap.build(wrap_settings(), line);
}

/// The vcol where the cluster at byte `line_col` of line `line_row` starts.
pub int Editor.vcol_at(int line_row, int line_col) {
    if (is_wrap_special()) {
        return wrap_layout(buffer.line(line_row)).vcol_at(line_col);
    }
    return MED_text.display_col(buffer.line(line_row), line_col, tab);
}

/// The column of line `line_row` covering vcol `want` (Vim's coladvance); `want` -1 is the end of the line.
pub int Editor.col_for_want(int line_row, int want, bool is_one_more) {
    if (is_wrap_special()) {
        return wrap_layout(buffer.line(line_row)).col_for_vcol(want, is_one_more);
    }
    return MED_motion.col_for_want(buffer.line(line_row), want, tab, is_one_more);
}

/// The display column the cursor is drawn at (the end cell of a Tab in
/// normal mode, as Vim does).
pub int Editor.cursor_vcol() {
    str line = buffer.line(row);
    if (is_wrap_special()) {
        MED_wrapmap.Layout layout = wrap_layout(line);
        if (col < line.size() && line.byte_at(col) == 9 && mode != INSERT && mode != REPLACE) {
            bool is_at_end = true;
            if (mode == VISUAL) {
                is_at_end = row > vrow || (row == vrow && col > vcol);
            }
            if (is_at_end) {
                return layout.end_vcol_at(col);
            }
        }
        return layout.vcol_at(col);
    }
    int start = MED_text.display_col(line, col, tab);
    if (col < line.size() && line.byte_at(col) == 9 && mode != INSERT && mode != REPLACE) {
        bool is_at_end = true;
        if (mode == VISUAL) {
            is_at_end = row > vrow || (row == vrow && col > vcol);
        }
        if (is_at_end) {
            return start + MED_text.cell_width(line, col, start, tab) - 1;
        }
    }
    return start;
}

pub void Editor.want_from_cursor() {
    want = cursor_vcol();
}

/// Keep the cursor on a valid cell: inside the buffer, on a grapheme start,
/// and (outside insert and visual) on a character rather than the NUL.
pub void Editor.clamp() {
    if (row >= buffer.line_count()) {
        row = buffer.line_count() - 1;
        // nvim's check_cursor_lnum(): a closed fold at the end of the file takes the cursor to its first line
        int fold_first = fold_start_of(row);
        if (fold_first >= 0) {
            row = fold_first;
        }
    }
    if (row < 0) {
        row = 0;
    }
    str line = buffer.line(row);
    if (col < 0) {
        col = 0;
    }
    if (mode == INSERT || mode == REPLACE || mode == CMDLINE) {
        if (col > line.size()) {
            col = line.size();
        }
        col = MED_text.snap(line, col);
        return;
    }
    if (mode == VISUAL) {
        if (col > line.size()) {
            col = line.size();
        }
        col = MED_text.snap(line, col);
        return;
    }
    if (col >= line.size()) {
        col = MED_text.last_col(line);
    }
    col = MED_text.snap(line, col);
}

/// Loading a buffer sets '[ and '] to its first and last line.
pub void Editor.init_marks() {
    marks.set("[", MED_buffer.Pos(0, 0));
    marks.set("]", MED_buffer.Pos(buffer.line_count() - 1, 0));
    marks.set("'", MED_buffer.Pos(0, 0));
    marks.set("'prev", MED_buffer.Pos(-1, 0));
}

MED_buffer.Pos Editor.entry(str name) {
    return marks.get(name).or(MED_buffer.Pos(0, 0));
}

/// Vim's setpcmark(): the previous-context mark becomes `position`, which is
/// also added to the jump list; does nothing in `:global`.
pub void Editor.set_pcmark(MED_buffer.Pos position) {
    if (is_global_busy) {
        return;
    }
    marks.set("'prev", marks.get("'").or(MED_buffer.Pos(-1, 0)));
    marks.set("'", position);
    if (jump_length >= LIST_SIZE) {
        for (int index in 1 .. jump_length) {
            marks.set(jump_name(index - 1), entry(jump_name(index)));
        }
        marks.remove(jump_name(jump_length - 1));
        jump_length = jump_length - 1;
    }
    marks.set(jump_name(jump_length), position);
    jump_length = jump_length + 1;
    jump_index = jump_length;
}

/// Vim's cleanup_jumplist(): of several entries on one line only the last
/// stays; when the window is past the last entry and that one is on the
/// cursor line, it goes too (`is_move`).
void Editor.clean_jumps(bool is_move) {
    List<MED_buffer.Pos> kept = [];
    int new_index = jump_index;
    for (int from in 0 .. jump_length) {
        if (jump_index == from) {
            new_index = kept.size();
        }
        bool is_duplicate = false;
        for (int later in from + 1 .. jump_length) {
            if (entry(jump_name(later)).row == entry(jump_name(from)).row) {
                is_duplicate = true;
                break;
            }
        }
        if (!is_duplicate) {
            kept.push(entry(jump_name(from)));
        }
    }
    if (jump_index == jump_length) {
        new_index = kept.size();
    }
    if (is_move && kept.size() > 0 && new_index == kept.size() && kept[kept.size() - 1].row == row) {
        kept.pop();
        new_index = new_index - 1;
    }
    for (int index in 0 .. jump_length) {
        marks.remove(jump_name(index));
    }
    for (int index in 0 .. kept.size()) {
        marks.set(jump_name(index), kept[index]);
    }
    jump_length = kept.size();
    jump_index = new_index;
}

/// Vim's movemark(): the jump list entry `count` steps from the window's
/// position (negative is older), or None.
pub Option<MED_buffer.Pos> Editor.move_jump(int count) {
    clean_jumps(true);
    if (jump_length == 0) {
        return Option<MED_buffer.Pos>.None;
    }
    if (jump_index + count < 0 || jump_index + count >= jump_length) {
        return Option<MED_buffer.Pos>.None;
    }
    if (jump_index == jump_length) {
        set_pcmark(MED_buffer.Pos(row, col));
        jump_index = jump_index - 1;
        if (jump_index + count < 0) {
            return Option<MED_buffer.Pos>.None;
        }
    }
    jump_index = jump_index + count;
    return Option<MED_buffer.Pos>.Some(entry(jump_name(jump_index)));
}

/// Vim's changed_common() bookkeeping: the position of the last change is the
/// `.` mark, and a change far enough from the last entry starts a new change
/// list entry.
pub void Editor.note_change(MED_buffer.Pos from) {
    marks.set(".", from);
    if (is_new_change || change_length == 0) {
        bool should_add = false;
        if (change_length == 0) {
            should_add = true;
        } else {
            MED_buffer.Pos last = entry(change_name(change_length - 1));
            if (last.row != from.row) {
                should_add = true;
            } else {
                should_add = last.col + 79 < from.col || from.col + 79 < last.col;
            }
        }
        if (should_add) {
            is_new_change = false;
            if (change_length == LIST_SIZE) {
                for (int index in 1 .. change_length) {
                    marks.set(change_name(index - 1), entry(change_name(index)));
                }
            } else {
                change_length = change_length + 1;
            }
        }
    }
    marks.set(change_name(change_length - 1), from);
    change_index = change_length;
}

/// Vim's movechangelist(): the change list entry `count` steps on, or None.
pub Option<MED_buffer.Pos> Editor.move_change(int count) {
    if (change_length == 0) {
        return Option<MED_buffer.Pos>.None;
    }
    int target = change_index;
    if (target + count < 0) {
        if (target == 0) {
            return Option<MED_buffer.Pos>.None;
        }
        target = 0;
    } else if (target + count >= change_length) {
        if (target == change_length - 1) {
            return Option<MED_buffer.Pos>.None;
        }
        target = change_length - 1;
    } else {
        target = target + count;
    }
    change_index = target;
    return Option<MED_buffer.Pos>.Some(entry(change_name(target)));
}

/// Vim's mark_col_adjust() for a join: a mark on joined line `row + 1 + i` moves
/// to `row`, its column shifted by `shift[i]` (the whitespace that was removed
/// from the front of that line counts as column 0 of the text).
pub void Editor.join_marks(int row_in, List<int> shift, List<int> removed) {
    List<str> names = [];
    for (str name in marks.keys()) {
        names.push(name);
    }
    for (str name in names) {
        if (name == "[" || name == "]") {
            continue;
        }
        MED_buffer.Pos position = marks.get(name).or(MED_buffer.Pos(-1, 0));
        int index = position.row - row_in - 1;
        if (position.row < 0 || index < 0 || index >= shift.size()) {
            continue;
        }
        int char_code = position.col;
        if (char_code < removed[index]) {
            char_code = removed[index];
        }
        marks.set(name, MED_buffer.Pos(row_in, char_code + shift[index]));
    }
}

/// Vim's checkpcmark(), at the end of a normal command: the mark before the
/// current one comes back when the cursor ended up on the current one or the
/// current one was deleted.
pub void Editor.check_pcmark() {
    MED_buffer.Pos previous = marks.get("'prev").or(MED_buffer.Pos(-1, 0));
    MED_buffer.Pos position = marks.get("'").or(MED_buffer.Pos(-1, 0));
    if (previous.row >= 0 && (position.row < 0 || (position.row == row && position.col == col))) {
        marks.set("'", previous);
    }
    marks.set("'prev", MED_buffer.Pos(-1, 0));
}

const int LIST_SIZE = 100;

pub str jump_name(int index) {
    return "~j" + index.to_str();
}

pub str change_name(int index) {
    return "~c" + index.to_str();
}

pub Editor new(str text) {
    Editor editor = Editor(MED_buffer.load(text));
    editor.nodes.push(Node(0, -1, [], MED_buffer.Pos(0, 0)));
    editor.init_marks();
    return editor;
}

// How many lines the text spans.
int line_span(str text) {
    int count = 1;
    for (int i in 0 .. text.size()) {
        if (text.byte_at(i) == 10) {
            count = count + 1;
        }
    }
    return count;
}

// Apply one edit in the given direction and report whether it changed the
// first-changed-line bookkeeping Vim's cursor placement uses. `top` is the
// 1-based line above the change.
pub type Landing {
    pub int top = 0;
    pub int first = 0;
    pub int newsize = 0;
    /// `top` and `newsize` as Vim's whole-line undo entries count them.
    pub int mtop = 0;
    pub int mnew = 0;
    pub bool is_first_changed_found = false;
}
