/* Auto pairs: typing an opening bracket or quote inserts the closing one,
 * typing the closing one steps over it, <BS> inside an empty pair deletes
 * both, <Space> pads and <CR> between brackets opens a line.
 *
 * A port of the decisions of jiangmiao/auto-pairs 2.0.0 with its default
 * pairs ( [ { ' " ` and the ``` """ ''' triples, checked against the plugin
 * itself (tests/oracles/corpus/91_autopairs.txt). Pure text work: the
 * functions get the text around the cursor and return the keys the plugin
 * would have inserted; MED_vim types those keys.
 *
 * API */
// ---
/*   MED_autopair.on_key(key, before, after, line_rest, row_is_return)
 *   MED_autopair.on_backspace(before, after)
 *   MED_autopair.on_space(before, after)
 *   MED_autopair.is_return_pair(previous_line, line_rest) */

/// The keys of a decision, and what else is to happen first.
pub type Decision {
    /// The plugin returned something else than the key: type `keys`.
    pub bool is_handled = false;
    pub List<int> keys = [];
    /** Jump over a closing pair on a later line: delete the blank line the
     * last <CR> made (when `is_blank_line_delete`), search for `search` and
     * step over it. */
    pub bool is_search = false;
    pub str search = "";
    pub bool is_blank_line_delete = false;
}

/// Key codes the plugin's results use.
pub const int BACKSPACE = 127;
pub const int DELETE = 63240;
pub const int LEFT = 63234;
pub const int RIGHT = 63235;
/// <C-G>U before <Left> / <Right>: the cursor moves without ending the insert.
pub const int CTRL_G = 7;
pub const int CHAR_U = 85;

type Pair {
    str open = "";
    str close = "";
    bool is_multiline = true;
    str key = "";
}

// The pairs, longest open first (the plugin sorts them that way).
List<Pair> pairs() {
    List<Pair> found = [];
    found.push(make("```", "```", false, "`"));
    found.push(make("\"\"\"", "\"\"\"", false, "\""));
    found.push(make("'''", "'''", false, "'"));
    found.push(make("(", ")", true, ")"));
    found.push(make("[", "]", true, "]"));
    found.push(make("{", "}", true, "}"));
    found.push(make("'", "'", false, "'"));
    found.push(make("\"", "\"", false, "\""));
    found.push(make("`", "`", false, "`"));
    return found;
}

Pair make(str open, str close, bool is_multiline, str key) {
    Pair made = Pair();
    made.open = open;
    made.close = close;
    made.is_multiline = is_multiline;
    made.key = key;
    return made;
}

bool is_word_byte(int code) {
    return (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95;
}

// Number of characters (the plugin's s:ulen).
int length_of(str text) {
    return text.chars().size();
}

/* Whether `text` ends with the opening of `pair`; the single quote only
 * opens after the start of the text or a non-word character. */
bool is_open_end(str text, Pair pair) {
    if (!text.ends_with(pair.open)) {
        return false;
    }
    if (pair.open == "'") {
        int before = text.size() - 1;
        if (before > 0 && is_word_byte(text.byte_at(before - 1))) {
            return false;
        }
    }
    return true;
}

/* `^\s*` then `close`: the text after the optional blanks, or "" if it does
 * not start with the close. */
str close_after_blanks(str text, str close) {
    int index = 0;
    while (index < text.size() && (text.byte_at(index) == 32 || text.byte_at(index) == 9)) {
        index = index + 1;
    }
    if (text.substr(index, text.size()).starts_with(close)) {
        return close;
    }
    return "";
}

// How many blanks `^\s*` skips.
int blanks_before(str text) {
    int index = 0;
    while (index < text.size() && (text.byte_at(index) == 32 || text.byte_at(index) == 9)) {
        index = index + 1;
    }
    return index;
}

void push_repeated(List<int> keys, int key, int count) {
    for (int i in 0 .. count) {
        keys.push(key);
    }
}

void push_left(List<int> keys, int count) {
    for (int i in 0 .. count) {
        keys.push(CTRL_G);
        keys.push(CHAR_U);
        keys.push(LEFT);
    }
}

void push_right(List<int> keys, int count) {
    for (int i in 0 .. count) {
        keys.push(CTRL_G);
        keys.push(CHAR_U);
        keys.push(RIGHT);
    }
}

str drop_last_char(str text) {
    List<int> codes = text.chars();
    if (codes.size() == 0) {
        return text;
    }
    codes.pop();
    return str.from_chars(codes);
}

str last_char(str text) {
    List<int> codes = text.chars();
    if (codes.size() == 0) {
        return "";
    }
    return str.from_chars([codes[codes.size() - 1]]);
}

/** AutoPairsInsert(key). `before` is the line up to the cursor, `after` the
 * rest of the line and the following lines up to a non-blank one (joined with
 * a space), `line_rest` the rest of the line only. `is_return_row` says the
 * cursor is on the line the last <CR> opened between a pair. */
pub Decision on_key(int key, str before_text, str after, str line_rest_in, bool is_return_row, bool is_row_blank) {
    Decision decision = Decision();
    str key_text = str.from_chars([key]);
    str before = before_text;
    str line_rest = line_rest_in;
    if (before.ends_with("\\")) {
        return decision;
    }
    List<Pair> list = pairs();
    for (Pair pair in list) {
        if (!is_open_end(before + key_text, pair)) {
            continue;
        }
        str together = before + key_text;
        str target = together.substr(0, together.size() - pair.open.size());
        if (pair.open == "'" && target.size() > 0 && last_char(target) != "" && is_word_byte(target.byte_at(target.size() - 1))) {
            continue;
        }
        str next_close = close_after_blanks(line_rest, pair.close);
        str open_pair = pair.open;
        if (open_pair.size() == 1 && next_close == open_pair) {
            break;
        }
        List<int> backspaces = [];
        List<int> deletes = [];
        str scan = before;
        str rest = line_rest;
        while (scan.size() > target.size()) {
            bool is_found = false;
            for (Pair inner in list) {
                if (!is_open_end(scan, inner)) {
                    continue;
                }
                str cut = scan.substr(0, scan.size() - inner.open.size());
                if (cut.size() < target.size()) {
                    continue;
                }
                if (inner.close != "" && rest.starts_with(inner.close)) {
                    is_found = true;
                    scan = cut;
                    rest = rest.substr(inner.close.size(), rest.size());
                    push_repeated(backspaces, BACKSPACE, length_of(inner.open));
                    push_repeated(deletes, DELETE, length_of(inner.close));
                    break;
                }
            }
            if (!is_found) {
                scan = drop_last_char(scan);
                backspaces.push(BACKSPACE);
            }
        }
        List<int> keys = [];
        for (int code in backspaces) {
            keys.push(code);
        }
        for (int code in deletes) {
            keys.push(code);
        }
        for (int code in open_pair.chars()) {
            keys.push(code);
        }
        for (int code in pair.close.chars()) {
            keys.push(code);
        }
        push_left(keys, length_of(pair.close));
        decision.is_handled = true;
        decision.keys = keys;
        return decision;
    }
    for (Pair pair in list) {
        if (pair.close == "") {
            continue;
        }
        if (pair.key != key_text) {
            continue;
        }
        str same_line = close_after_blanks(line_rest, pair.close);
        if (same_line != "") {
            int blanks = blanks_before(line_rest);
            List<int> keys = [];
            // blank text between the pair: remove the space the plugin put there
            bool is_blank_pair = blanks > 0 && is_before_ending_open(before, pair);
            if (is_blank_pair) {
                keys.push(DELETE);
                push_right(keys, blanks - 1 + length_of(pair.close));
            } else {
                push_right(keys, blanks + length_of(pair.close));
            }
            decision.is_handled = true;
            decision.keys = keys;
            return decision;
        }
        str later = close_after_blanks(after, pair.close);
        if (later != "") {
            if (pair.is_multiline) {
                decision.is_handled = true;
                decision.is_search = true;
                decision.search = later;
                decision.is_blank_line_delete = is_return_row && is_row_blank;
                decision.keys = [RIGHT];
                return decision;
            }
            break;
        }
    }
    return decision;
}

/* `before =~ open . '\s*$'`: the text before the cursor ends with the open
 * pair and blanks. */
bool is_before_ending_open(str before, Pair pair) {
    int stop = before.size();
    while (stop > 0 && (before.byte_at(stop - 1) == 32 || before.byte_at(stop - 1) == 9)) {
        stop = stop - 1;
    }
    return before.substr(0, stop).ends_with(pair.open);
}

/// AutoPairsDelete(): the keys for <BS>; empty means a plain <BS>.
pub List<int> on_backspace(str before, str after) {
    List<int> keys = [];
    for (Pair pair in pairs()) {
        if (pair.close == "") {
            continue;
        }
        // open followed by at most one blank at the end of `before`
        str head = before;
        bool has_blank = false;
        if (head.ends_with(" ")) {
            str without = head.substr(0, head.size() - 1);
            if (is_open_end(without, pair)) {
                head = without;
                has_blank = true;
            }
        }
        if (!has_blank && !is_open_end(head, pair)) {
            continue;
        }
        int blanks = blanks_before(after);
        str closing = close_after_blanks(after, pair.close);
        if (closing == "") {
            continue;
        }
        if (has_blank) {
            if (after.byte_at(0) == 32) {
                keys.push(BACKSPACE);
                keys.push(DELETE);
            } else {
                keys.push(BACKSPACE);
            }
            return keys;
        }
        push_repeated(keys, BACKSPACE, length_of(pair.open));
        push_repeated(keys, DELETE, blanks + length_of(pair.close));
        return keys;
    }
    return keys;
}

/// AutoPairsSpace(): the keys for <Space>; empty means a plain space.
pub List<int> on_space(str before, str after) {
    List<int> keys = [];
    for (Pair pair in pairs()) {
        if (pair.close == "") {
            continue;
        }
        if (before.ends_with(pair.open) && after.starts_with(pair.close)) {
            keys.push(32);
            if (pair.close != "'" && pair.close != "\"" && pair.close != "`") {
                keys.push(32);
                keys.push(CTRL_G);
                keys.push(CHAR_U);
                keys.push(LEFT);
            }
            return keys;
        }
    }
    return keys;
}

/** AutoPairsReturn(): whether the line before ends with an open pair and the
 * rest of this line starts with its close. */
pub bool is_return_pair(str previous_line, str line_rest) {
    for (Pair pair in pairs()) {
        if (pair.close == "") {
            continue;
        }
        int stop = previous_line.size();
        while (stop > 0 && (previous_line.byte_at(stop - 1) == 32 || previous_line.byte_at(stop - 1) == 9)) {
            stop = stop - 1;
        }
        if (previous_line.substr(0, stop).ends_with(pair.open) && close_after_blanks(line_rest, pair.close) != "") {
            return true;
        }
    }
    return false;
}
