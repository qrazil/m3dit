// The Vim command layer: motions, operators, insert mode, Visual mode and
// dot-repeat on top of `MED_editor`. `feed(ed, key)` is the whole interface.
//
// API
// ---
//   MED_vim.feed(ed, key)           process one key in whatever mode `ed` is in
//   MED_vim.feed_keys(ed, keys)     many keys, in order
//
// Behaviour is checked against nvim (`tests/oracles/`): each command below
// follows the corresponding Vim source routine named in its comment.

import engine.MED_buffer;
import engine.MED_complete;
import engine.MED_autofold;
import engine.MED_fold;
import engine.MED_editor;
import engine.MED_motion;
import engine.MED_num;
import engine.MED_parse;
import engine.MED_register;
import engine.MED_text;
import engine.MED_textobj;
import engine.MED_key;
import engine.MED_case;
import engine.MED_view;
import engine.MED_search;
import engine.MED_nrfmt;
import engine.MED_expr;
import engine.MED_digraph;
import engine.MED_screen;
import engine.MED_autopair;

void fail(MED_editor.Editor editor) {
    editor.is_failed = true;
}

int count1(int count) {
    if (count < 1) {
        return 1;
    }
    return count;
}

MED_motion.Motion motion_at(MED_editor.Editor editor) {
    MED_motion.Motion motion = MED_motion.Motion();
    motion.row = editor.row;
    motion.col = editor.col;
    return motion;
}

bool is_visual(MED_editor.Editor editor) {
    return editor.mode == MED_editor.VISUAL;
}

// The column of the cursor line that `want` selects.
pub int col_by_want(MED_editor.Editor editor, int row, int want) {
    return MED_motion.col_for_want(editor.buffer.line(row), want, editor.tab, is_visual(editor));
}

// Vim's `beginline(BL_WHITE | BL_FIX)`: the first non-blank, but never the NUL.
pub int first_nonblank_fix(str line) {
    int col = MED_text.first_nonblank(line);
    if (col >= line.size() && line.size() > 0) {
        return MED_text.last_col(line);
    }
    return col;
}

// Whether 'whichwrap' (default "b,s") has the flag `flag`.
bool has_whichwrap(MED_editor.Editor editor, str flag) {
    str flags = "b,s";
    match (editor.opts.get("whichwrap")) {
        case Some(str value): {
            flags = value;
        }
        case None: {
        }
    }
    for (str item in flags.split(",")) {
        if (item == flag) {
            return true;
        }
    }
    return false;
}

MED_motion.Motion move_left(MED_editor.Editor editor, int key, int count, str operator) {
    MED_motion.Motion motion = motion_at(editor);
    bool is_wrap = ((key == 127 || key == 8) && has_whichwrap(editor, "b")) || (key == 104 && has_whichwrap(editor, "h")) || (key == 63234 && has_whichwrap(editor, "<"));
    bool is_moved = false;
    int total = count1(count);
    while (total > 0) {
        if (motion.col > 0) {
            motion.col = MED_text.previous_col(editor.buffer.line(motion.row), motion.col);
            is_moved = true;
        } else if (is_wrap && motion.row > 0) {
            motion.row = motion.row - 1;
            str line = editor.buffer.line(motion.row);
            motion.col = MED_motion.col_for_want(line, -1, editor.tab, is_visual(editor));
            is_moved = true;
            if ((operator == "d" || operator == "c") && line.size() > 0) {
                if (motion.col < line.size()) {
                    motion.col = MED_text.next_col(line, motion.col);
                }
                motion.is_no_adj = true;
            }
        } else {
            if (operator == "" && !is_moved) {
                motion.is_ok = false;
            }
            break;
        }
        total = total - 1;
    }
    return motion;
}

MED_motion.Motion move_right(MED_editor.Editor editor, int key, int count, str operator) {
    MED_motion.Motion motion = motion_at(editor);
    bool is_wrap = (key == 32 && has_whichwrap(editor, "s")) || (key == 108 && has_whichwrap(editor, "l")) || (key == 63235 && has_whichwrap(editor, ">"));
    bool is_visual_value = is_visual(editor);
    bool is_moved = false;
    int total = count1(count);
    while (total > 0) {
        str line = editor.buffer.line(motion.row);
        bool is_stuck = false;
        if (is_visual_value) {
            is_stuck = motion.col >= line.size();
        } else {
            is_stuck = motion.col >= line.size() || MED_text.next_col(line, motion.col) >= line.size();
        }
        if (is_stuck) {
            if (is_wrap && motion.row + 1 < editor.buffer.line_count()) {
                if (operator != "" && !motion.is_inclusive && line.size() > 0) {
                    motion.is_inclusive = true;
                } else {
                    motion.row = motion.row + 1;
                    motion.col = 0;
                    motion.is_inclusive = false;
                }
                is_moved = true;
                total = total - 1;
                continue;
            }
            if (operator == "") {
                if (!is_moved) {
                    motion.is_ok = false;
                }
            } else if (line.size() > 0) {
                motion.is_inclusive = true;
            }
            break;
        }
        motion.col = MED_text.next_col(line, motion.col);
        is_moved = true;
        total = total - 1;
    }
    return motion;
}

MED_motion.Motion move_vertical(MED_editor.Editor editor, int delta) {
    MED_motion.Motion motion = motion_at(editor);
    motion.is_linewise = true;
    motion.want = -3;
    int last = editor.buffer.line_count() - 1;
    if (delta > 0) {
        int from = editor.row;
        int fold_end = editor.fold_end_of(from);
        if (fold_end >= 0) {
            from = fold_end;
        }
        if (from >= last) {
            motion.is_ok = false;
            return motion;
        }
        if (from + delta >= last) {
            motion.row = last;
        } else if (editor.folds.size() > 0) {
            // each sequence of folded lines counts as one line
            int walk = from;
            int steps = delta;
            while (steps > 0) {
                steps = steps - 1;
                int closed_end = editor.fold_end_of(walk);
                if (closed_end >= 0) {
                    walk = closed_end + 1;
                } else {
                    walk = walk + 1;
                }
                if (walk >= last) {
                    break;
                }
            }
            motion.row = MED_num.smaller(walk, last);
        } else {
            motion.row = from + delta;
        }
    } else {
        int count_up = 0 - delta;
        if (editor.row <= 0) {
            motion.is_ok = false;
            return motion;
        }
        if (count_up >= editor.row) {
            motion.row = 0;
        } else if (editor.folds.size() > 0) {
            int walk = editor.row;
            int start = editor.fold_start_of(walk);
            if (start >= 0) {
                walk = start;
            }
            int steps = count_up;
            while (steps > 0) {
                steps = steps - 1;
                walk = walk - 1;
                if (walk <= 0) {
                    break;
                }
                int fold_start = editor.fold_start_of(walk);
                if (fold_start >= 0) {
                    walk = fold_start;
                }
            }
            motion.row = MED_num.larger(walk, 0);
        } else {
            motion.row = editor.row - count_up;
        }
    }
    motion.col = col_by_want(editor, motion.row, editor.want);
    return motion;
}

// Cursor on the NUL after a word motion moves back onto the last character.
void adjust_cursor(MED_editor.Editor editor, MED_motion.Motion motion) {
    str line = editor.buffer.line(motion.row);
    if (motion.col > 0 && motion.col >= line.size() && !is_visual(editor)) {
        motion.col = MED_text.last_col(line);
        motion.is_inclusive = true;
    }
}

MED_motion.Motion word_motion(MED_editor.Editor editor, int key, int count, str operator) {
    MED_motion.Motion motion = motion_at(editor);
    MED_motion.Cur cursor = MED_motion.Cur(editor.buffer, editor.row, editor.col);
    bool is_big = key == 87 || key == 66 || key == 69;
    bool is_ok = true;
    if (key == 119 || key == 87) {
        bool is_word_end = false;
        bool is_flag = false;
        if (operator == "c") {
            str line = editor.buffer.line(editor.row);
            if (editor.col < line.size()) {
                int code_point = MED_text.cp_at(line, editor.col);
                if (code_point != 32 && code_point != 9) {
                    motion.is_inclusive = true;
                    is_word_end = true;
                    is_flag = true;
                }
            }
        }
        if (editor.folds.size() > 0 && !editor.is_fold_off && !is_word_end) {
            // a word motion in a closed fold starts from its last character
            for (int step in 0 .. count1(count)) {
                int fold_end = editor.fold_end_of(cursor.row);
                if (fold_end >= 0) {
                    cursor.row = fold_end;
                    cursor.col = MED_text.last_col(editor.buffer.line(fold_end));
                }
                is_ok = MED_motion.did_fwd_word(cursor, 1, is_big, operator != "" && step == count1(count) - 1);
                if (!is_ok) {
                    break;
                }
            }
        } else if (is_word_end) {
            is_ok = MED_motion.did_end_word(cursor, count1(count), is_big, is_flag, false);
        } else {
            is_ok = MED_motion.did_fwd_word(cursor, count1(count), is_big, operator != "");
        }
    } else if (key == 98 || key == 66) {
        if (editor.folds.size() > 0 && !editor.is_fold_off) {
            // ... and backwards from its first character
            for (int step in 0 .. count1(count)) {
                int fold_start = editor.fold_start_of(cursor.row);
                if (fold_start >= 0) {
                    cursor.row = fold_start;
                    cursor.col = 0;
                }
                is_ok = MED_motion.did_bck_word(cursor, 1, is_big, false);
                if (!is_ok) {
                    break;
                }
            }
        } else {
            is_ok = MED_motion.did_bck_word(cursor, count1(count), is_big, false);
        }
    } else {
        if (editor.folds.size() > 0 && !editor.is_fold_off) {
            for (int step in 0 .. count1(count)) {
                int fold_end = editor.fold_end_of(cursor.row);
                if (fold_end >= 0) {
                    cursor.row = fold_end;
                    cursor.col = MED_text.last_col(editor.buffer.line(fold_end));
                }
                is_ok = MED_motion.did_end_word(cursor, 1, is_big, false, false);
                if (!is_ok) {
                    break;
                }
            }
        } else {
            is_ok = MED_motion.did_end_word(cursor, count1(count), is_big, false, false);
        }
        motion.is_inclusive = true;
    }
    motion.row = cursor.row;
    motion.col = cursor.col;
    if (editor.row < cursor.row || (editor.row == cursor.row && editor.col < cursor.col)) {
        adjust_cursor(editor, motion);
    }
    if (!is_ok && operator == "") {
        motion.is_beep = true;
    } else if (!is_ok && (key == 98 || key == 66)) {
        // `b` always cancels the operator when it cannot go all the way
        motion.is_ok = false;
        motion.is_moved = true;
    }
    return motion;
}

// Vim's nv_lineop: where the cursor lands on the last line of `_`, `dd`, `yy`...
int lineop_col(MED_editor.Editor editor, str operator, int row, bool is_moved) {
    if (operator == "d" || operator == "<" || operator == ">") {
        return col_by_want(editor, row, editor.want);
    }
    if (operator == "y") {
        if (is_moved) {
            return col_by_want(editor, row, editor.want);
        }
        return editor.col;
    }
    return first_nonblank_fix(editor.buffer.line(row));
}

// Place `motion` on a line number given as a 1-based count or the default.
MED_motion.Motion goto_line(MED_editor.Editor editor, int count, int default_row) {
    MED_motion.Motion motion = MED_motion.Motion();
    int row = default_row;
    if (count != 0) {
        row = count - 1;
    }
    row = MED_num.clamp(row, 0, editor.buffer.line_count() - 1);
    motion.row = row;
    motion.is_linewise = true;
    motion.is_jump = true;
    motion.want = -3;
    if (editor.is_startofline) {
        motion.col = first_nonblank_fix(editor.buffer.line(row));
        motion.want = -2;
    } else {
        motion.col = col_by_want(editor, row, editor.want);
    }
    return motion;
}

// g0 g^ g$ gm on a wrapped line: the screen row the cursor is on.
MED_motion.Motion screen_line_motion(MED_editor.Editor editor, int second, int count) {
    MED_motion.Motion motion = motion_at(editor);
    str line = editor.buffer.line(editor.row);
    int width = editor.view_width;
    int vcol = editor.cursor_vcol();
    if (second == 36) {
        motion.is_inclusive = true;
        motion.want = -1;
        if (count1(count) > 1) {
            MED_screen.Outcome moved = MED_screen.move(editor, true, count1(count) - 1, true);
            motion.row = moved.row;
            motion.col = moved.col;
            if (!moved.is_ok) {
                motion.is_ok = false;
                motion.is_moved = true;
            }
            return motion;
        }
        int target = width - 1;
        if (!MED_screen.is_wrapping(editor)) {
            target = editor.view_left + width - 1;
        } else if (vcol >= width) {
            target = target + ((vcol - width) / width + 1) * width;
        }
        int col = MED_motion.col_for_want(line, target, editor.tab, is_visual(editor));
        if (col > 0 && MED_text.display_col(line, col, editor.tab) > target) {
            col = MED_text.previous_col(line, col);
        }
        motion.col = col;
        // "stick in this column" (update_curswant_force)
        motion.want = MED_text.display_col(line, col, editor.tab);
        if (col < line.size() && line.byte_at(col) == 9) {
            motion.want = motion.want + MED_text.cell_width(line, col, motion.want, editor.tab) - 1;
        }
        return motion;
    }
    int start = 0;
    if (!MED_screen.is_wrapping(editor)) {
        // lines do not wrap: the screen line starts at the first column shown
        start = editor.view_left;
    } else if (vcol >= width) {
        start = vcol / width * width;
    }
    if (second == 109) {
        start = start + width / 2;
    }
    int col = MED_motion.col_for_want(line, start, editor.tab, is_visual(editor));
    if (second == 94) {
        while (col < line.size() && (line.byte_at(col) == 32 || line.byte_at(col) == 9) && MED_text.next_col(line, col) < line.size()) {
            col = MED_text.next_col(line, col);
        }
    }
    motion.col = col;
    motion.want = -2;
    return motion;
}

// H, M and L: a line of the window.
MED_motion.Motion view_motion(MED_editor.Editor editor, int key, int count, str operator) {
    int total = editor.buffer.line_count();
    int bottom_row = MED_view.bottom(editor);
    int row = editor.view_top;
    if (key == 76) {
        // the last line shown, `count` - 1 lines up
        row = bottom_row - 1;
        if (count1(count) - 1 >= bottom_row) {
            row = 0;
        } else {
            row = row - (count1(count) - 1);
        }
    } else if (key == 77) {
        int half = (editor.view_height - MED_view.empty_rows(editor) + 1) / 2;
        int used = 0;
        int step = 0;
        while (editor.view_top + step + 1 < total) {
            used = used + MED_view.rows_of(editor, editor.view_top + step);
            if (used >= half) {
                break;
            }
            step = step + 1;
        }
        if (step > 0 && used > editor.view_height) {
            step = step - 1;
        }
        row = editor.view_top + step;
    } else {
        row = editor.view_top + count1(count) - 1;
    }
    row = MED_num.smaller(row, total - 1);
    // cursor_correct(): stay inside the window
    if (row < editor.view_top) {
        row = editor.view_top;
    }
    if (row > bottom_row - 1 && bottom_row > editor.view_top) {
        row = bottom_row - 1;
    }
    if (operator == "" && editor.option_number("scrolloff", 0) > 0) {
        row = MED_view.corrected_row(editor, row);
    }
    return goto_line(editor, row + 1, 0);
}

MED_motion.Motion char_find(MED_editor.Editor editor, int key, int target, int count, bool is_repeat, bool is_reverse) {
    int directory = 1;
    bool is_until = false;
    int goal = target;
    bool is_stop = true;
    if (is_repeat) {
        if (editor.find.target < 0) {
            return MED_motion.failed();
        }
        goal = editor.find.target;
        directory = editor.find.directory;
        if (is_reverse) {
            directory = -directory;
        }
        is_until = editor.find.is_until;
        if (count1(count) == 1 && is_until) {
            is_stop = false;
        }
    } else {
        if (key == 70 || key == 84) {
            directory = -1;
        }
        is_until = key == 116 || key == 84;
        editor.find.target = target;
        editor.find.directory = directory;
        editor.find.is_until = is_until;
    }
    MED_motion.Motion motion = MED_motion.find_char(editor.buffer.line(editor.row), editor.col, goal, directory, is_until, count1(count), is_stop);
    motion.row = editor.row;
    return motion;
}

MED_motion.Motion line_end(MED_editor.Editor editor, int count) {
    MED_motion.Motion motion = motion_at(editor);
    motion.is_inclusive = true;
    motion.want = -1;
    int total = count1(count) - 1;
    if (total > 0) {
        if (editor.row >= editor.buffer.line_count() - 1) {
            // Vim sets the wanted column before it finds it cannot go down
            editor.want = -1;
            motion.is_ok = false;
            return motion;
        }
        motion.row = MED_num.smaller(editor.row + total, editor.buffer.line_count() - 1);
    }
    motion.col = MED_motion.col_for_want(editor.buffer.line(motion.row), -1, editor.tab, is_visual(editor));
    return motion;
}

// A finished search as a motion.
MED_motion.Motion search_result(MED_editor.Editor editor, MED_search.Outcome outcome) {
    if (!outcome.is_ok) {
        editor.message = outcome.error;
        // a search, failed or not, makes the wanted column follow the cursor
        editor.want_from_cursor();
        return MED_motion.failed();
    }
    MED_motion.Motion motion = motion_at(editor);
    motion.row = outcome.row;
    motion.col = outcome.col;
    motion.is_jump = true;
    motion.is_inclusive = outcome.is_inclusive;
    int size = editor.buffer.line_size(motion.row);
    if (motion.col > 0 && motion.col >= size) {
        // `/$` lands after the last character: check_cursor() pulls it back
        motion.col = MED_text.last_col(editor.buffer.line(motion.row));
    }
    motion.is_linewise = outcome.kind == 2;
    return motion;
}

// The position of mark `name`, if it is set.
pub Option<MED_buffer.Pos> mark_position(MED_editor.Editor editor, int name) {
    str key = str.from_chars([name]);
    if (name == 96) {
        key = "'";
    }
    Option<MED_buffer.Pos> found = editor.marks.get(key);
    match (found) {
        case Some(MED_buffer.Pos position): {
            if (position.row >= editor.buffer.line_count() || position.row < 0) {
                return Option<MED_buffer.Pos>.None;
            }
            return found;
        }
        case None: {
            if (key == "'") {
                return Option<MED_buffer.Pos>.Some(MED_buffer.Pos(0, 0));
            }
            return found;
        }
    }
}

// `'x` `` `x `` g'x g`x
MED_motion.Motion mark_motion(MED_editor.Editor editor, int cmd, int name, bool is_linewise, bool is_jumps) {
    Option<MED_buffer.Pos> found = mark_position(editor, name);
    match (found) {
        case Some(MED_buffer.Pos position): {
            if (position.row >= editor.buffer.line_count()) {
                editor.message = "E19: Mark has invalid line number";
                return MED_motion.failed();
            }
            MED_motion.Motion motion = motion_at(editor);
            motion.row = position.row;
            motion.col = position.col;
            motion.is_jump = is_jumps;
            if (is_linewise) {
                motion.is_linewise = true;
                motion.col = first_nonblank_fix(editor.buffer.line(position.row));
            } else if (motion.col > editor.buffer.line_size(position.row)) {
                motion.col = editor.buffer.line_size(position.row);
            }
            return motion;
        }
        case None: {
            editor.message = "E20: Mark not set";
            return MED_motion.failed();
        }
    }
}

// `%`: the matching bracket, or with a count that percent of the file.
MED_motion.Motion percent_motion(MED_editor.Editor editor, int count) {
    MED_motion.Motion motion = motion_at(editor);
    motion.is_inclusive = true;
    motion.is_jump = true;
    if (count > 0) {
        if (count > 100) {
            return MED_motion.failed();
        }
        motion.is_linewise = true;
        int total = editor.buffer.line_count();
        int lnum = (total * count + 99) / 100;
        if (lnum < 1) {
            lnum = 1;
        }
        if (lnum > total) {
            lnum = total;
        }
        motion.row = lnum - 1;
        motion.is_inclusive = false;
        if (editor.is_startofline) {
            motion.col = first_nonblank_fix(editor.buffer.line(motion.row));
        } else {
            motion.col = col_by_want(editor, motion.row, editor.want);
            motion.want = -3;
        }
        return motion;
    }
    MED_buffer.Pos position = MED_search.findmatch(editor.buffer, editor.row, editor.col, 0, 0);
    if (position.row < 0) {
        return MED_motion.failed();
    }
    motion.row = position.row;
    motion.col = position.col;
    return motion;
}

// `]'` `['` `]\`` `[\``: the next / previous lowercase mark (nvim's
// getnextmark). With the line forms a mark on the cursor line does not count;
// when there is none the cursor stays (a line form still goes to the first
// non-blank).
MED_motion.Motion next_mark_motion(MED_editor.Editor editor, bool is_forward, bool is_linewise, int count) {
    int row = editor.row;
    int col = editor.col;
    for (int step in 0 .. count1(count)) {
        int from_col = col;
        if (is_linewise && is_forward) {
            from_col = 1000000000;
        } else if (is_linewise) {
            from_col = 0;
        }
        bool is_found = false;
        int best_row = 0;
        int best_col = 0;
        for (int code in 97 .. 123) {
            match (editor.marks.get(str.from_chars([code]))) {
                case Some(MED_buffer.Pos mark): {
                    bool is_after = mark.row > row || (mark.row == row && mark.col > from_col);
                    bool is_before = mark.row < row || (mark.row == row && mark.col < from_col);
                    bool is_wanted = is_after;
                    if (!is_forward) {
                        is_wanted = is_before;
                    }
                    if (is_wanted) {
                        bool is_better = !is_found;
                        if (is_found && is_forward) {
                            is_better = mark.row < best_row || (mark.row == best_row && mark.col < best_col);
                        } else if (is_found) {
                            is_better = mark.row > best_row || (mark.row == best_row && mark.col > best_col);
                        }
                        if (is_better) {
                            is_found = true;
                            best_row = mark.row;
                            best_col = mark.col;
                        }
                    }
                }
                case None: {
                }
            }
        }
        if (!is_found) {
            break;
        }
        row = best_row;
        col = best_col;
    }
    MED_motion.Motion motion = motion_at(editor);
    motion.row = row;
    motion.col = col;
    motion.is_jump = true;
    if (is_linewise) {
        motion.is_linewise = true;
        motion.col = first_nonblank_fix(editor.buffer.line(row));
    } else if (motion.col > editor.buffer.line_size(row)) {
        motion.col = editor.buffer.line_size(row);
    }
    return motion;
}

// `[(` `[{` `])` `]}`
MED_motion.Motion bracket_motion(MED_editor.Editor editor, int first, int second, int count) {
    if (second == 122) {
        // `[z` / `]z`: the start / end of the open fold around the cursor
        MED_motion.Motion fold_motion = motion_at(editor);
        MED_editor.Editor probe = editor;
        int saved_row = editor.row;
        int saved_col = editor.col;
        bool is_moved = MED_autofold.did_move_to(probe, false, first == 93, count1(count));
        fold_motion.row = editor.row;
        fold_motion.col = editor.col;
        editor.row = saved_row;
        editor.col = saved_col;
        if (!is_moved) {
            return MED_motion.failed();
        }
        fold_motion.is_jump = true;
        return fold_motion;
    }
    if (second == 39 || second == 96) {
        return next_mark_motion(editor, first == 93, second == 39, count);
    }
    MED_motion.Motion motion = motion_at(editor);
    int directory = 1;
    if (first == 91) {
        directory = -1;
    }
    int row = editor.row;
    int col = editor.col;
    bool is_any = false;
    for (int i in 0 .. count1(count)) {
        MED_buffer.Pos position = MED_search.findmatch(editor.buffer, row, col, second, directory);
        if (position.row < 0) {
            break;
        }
        row = position.row;
        col = position.col;
        is_any = true;
    }
    if (!is_any) {
        return MED_motion.failed();
    }
    motion.row = row;
    motion.col = col;
    motion.is_jump = true;
    return motion;
}

// `{` and `}` with closed folds (nvim's findpar): a closed fold under the cursor counts as one line, so the motion
// starts beyond it.
MED_motion.Motion paragraph_in_folds(MED_editor.Editor editor, int directory, int count) {
    int curr = editor.row;
    int left = count;
    int last = editor.buffer.line_count() - 1;
    while (left > 0) {
        left = left - 1;
        bool did_skip = false;
        bool is_first = true;
        while (true) {
            if (curr >= 0 && curr <= last && editor.buffer.line_size(curr) != 0) {
                did_skip = true;
            }
            bool is_fold_skipped = false;
            if (is_first) {
                int fold_first = editor.fold_start_of(curr);
                if (fold_first >= 0) {
                    int fold_last = editor.fold_end_of(curr);
                    if (directory > 0) {
                        curr = fold_last + directory;
                    } else {
                        curr = fold_first + directory;
                    }
                    is_fold_skipped = true;
                }
            }
            if (!is_first && did_skip && curr >= 0 && curr <= last && MED_motion.is_starts_paragraph(editor.buffer, curr, false)) {
                break;
            }
            if (is_fold_skipped) {
                curr = curr - directory;
            }
            curr = curr + directory;
            if (curr < 0 || curr > last) {
                if (left > 0) {
                    return MED_motion.failed();
                }
                curr = curr - directory;
                break;
            }
            is_first = false;
        }
    }
    MED_motion.Motion motion = MED_motion.Motion();
    motion.row = curr;
    motion.is_jump = true;
    motion.col = 0;
    if (curr == last && directory > 0) {
        str line = editor.buffer.line(curr);
        if (line.size() != 0) {
            motion.col = MED_text.last_col(line);
            motion.is_inclusive = true;
        }
    }
    return motion;
}

// `[[` `]]` `[]` `][`: the previous / next line that starts with `{` or `}`.
MED_motion.Motion section_motion(MED_editor.Editor editor, int first, int second, int count) {
    int directory = 1;
    if (first == 91) {
        directory = -1;
    }
    int what = 123;
    if (first != second) {
        what = 125;
    }
    int curr = editor.row;
    int left = count1(count);
    while (left > 0) {
        left = left - 1;
        bool did_skip = false;
        bool is_at_first = true;
        while (true) {
            str line = editor.buffer.line(curr);
            if (line.size() != 0) {
                did_skip = true;
            }
            if (!is_at_first && did_skip && line.size() > 0 && (line.byte_at(0) == what || line.byte_at(0) == 12)) {
                break;
            }
            curr = curr + directory;
            if (curr < 0 || curr >= editor.buffer.line_count()) {
                if (left > 0) {
                    return MED_motion.failed();
                }
                curr = curr - directory;
                break;
            }
            is_at_first = false;
        }
    }
    MED_motion.Motion motion = motion_at(editor);
    motion.row = curr;
    motion.col = 0;
    motion.is_jump = true;
    if (curr == editor.buffer.line_count() - 1 && what != 125 && directory > 0) {
        str line = editor.buffer.line(curr);
        if (line.size() != 0) {
            motion.col = MED_text.last_col(line);
            motion.is_inclusive = true;
        }
    }
    return motion;
}

// `n` and `N`.
bool is_gn_keys(List<int> keys) {
    return keys.size() == 2 && keys[0] == 103 && (keys[1] == 110 || keys[1] == 78);
}

// `gn` / `gN` in Normal mode (start Visual) or Visual mode (extend it).
void gn_command(MED_editor.Editor editor, int count, bool is_forward, bool is_visual) {
    MED_search.Area area = MED_search.current_search(editor, count1(count), is_forward, is_visual, editor.vrow, editor.vcol);
    if (!area.is_ok) {
        editor.message = area.error;
        editor.is_failed = true;
        return;
    }
    pcmark(editor, MED_buffer.Pos(editor.row, editor.col));
    if (!is_visual) {
        editor.mode = MED_editor.VISUAL;
        editor.vkind = 118;
    }
    editor.vrow = area.arow;
    editor.vcol = area.acol;
    editor.row = area.crow;
    editor.col = area.ccol;
    editor.want_from_cursor();
}

// The text of the Visual area, one string per line (Vim's getregion()).
List<str> visual_chunks(MED_editor.Editor editor) {
    List<str> chunks = [];
    MED_buffer.Pos from = MED_buffer.Pos(editor.vrow, editor.vcol);
    MED_buffer.Pos finish = MED_buffer.Pos(editor.row, editor.col);
    if (is_position_before(finish, from)) {
        MED_buffer.Pos swap = from;
        from = finish;
        finish = swap;
    }
    if (editor.vkind == 86) {
        for (int row in from.row .. finish.row + 1) {
            chunks.push(editor.buffer.line(row));
        }
    } else if (editor.vkind == 22) {
        Oap area = visual_oap(editor, "y", "");
        for (int row in area.start.row .. area.end.row + 1) {
            BlockCut cut = block_cut(editor, editor.buffer.line(row), area.left_vcol, area.right_vcol, area.is_eol);
            chunks.push(cut.text);
        }
    } else {
        Oap area = Oap();
        area.start = from;
        area.end = finish;
        area.is_inclusive = true;
        str text = editor.buffer.text(from, exclusive_end(editor, area));
        chunks = text.split("\n");
    }
    return chunks;
}

// Visual `*` and `#`: search for the selected text (nvim's default mapping).
void visual_star(MED_editor.Editor editor, bool is_forward, int count) {
    List<str> chunks = visual_chunks(editor);
    List<str> escaped = [];
    for (str chunk in chunks) {
        escaped.push(chunk.split("\\").join("\\\\"));
    }
    str body = escaped.join("\\n");
    int vrow = editor.vrow;
    int vcol = editor.vcol;
    int kind = editor.vkind;
    int steps = count1(count);
    if (!is_forward) {
        bool is_after = editor.row > vrow;
        if (kind == 118 && editor.row == vrow && editor.col > vcol) {
            is_after = true;
        }
        if (kind == 86 && editor.col != 0) {
            is_after = true;
        }
        if (kind == 22 && editor.col > vcol) {
            is_after = true;
        }
        if (is_after) {
            steps = steps + 1;
        }
    }
    leave_visual(editor);
    if (body == "") {
        editor.message = "E348: No string under cursor";
        return;
    }
    MED_search.set_last_pattern(editor, "\\V" + body, false);
    editor.is_search_no_scs = false;
    editor.hist_search.push("\\V" + body);
    editor.search_directory = 1;
    if (!is_forward) {
        editor.search_directory = -1;
    }
    MED_motion.Motion motion = next_match(editor, false, steps);
    if (motion.is_ok) {
        apply_motion(editor, motion);
    } else {
        editor.is_failed = true;
    }
}

MED_motion.Motion next_match(MED_editor.Editor editor, bool is_reverse, int count) {
    MED_search.Outcome outcome = MED_search.search_command(editor, 0, "", count1(count), is_reverse, false);
    if (outcome.is_ok && !outcome.is_wrapped && outcome.row == editor.row && outcome.col == editor.col) {
        // stuck on the cursor (an offset on the buffer's last character): once more
        outcome = MED_search.search_command(editor, 0, "", count1(count) + 1, is_reverse, false);
    }
    return search_result(editor, outcome);
}

/// Execute the motion `keys` from the cursor. `operator` is the pending operator
/// name ("" for none). The result says where it lands and how an operator
/// should treat the range.
pub MED_motion.Motion run_motion(MED_editor.Editor editor, List<int> keys, int count, str operator) {
    MED_motion.Motion motion = run_motion_raw(editor, keys, count, operator);
    if (!motion.is_ok && did_sets_curswant(keys)) {
        // these motions ask for the wanted column to follow the cursor even
        // when they fail (Vim's w_set_curswant)
        editor.want_from_cursor();
    }
    return motion;
}

bool did_sets_curswant(List<int> keys) {
    int key = keys[0];
    if (key == 119 || key == 87 || key == 98 || key == 66 || key == 101 || key == 69) {
        return true;
    }
    if (key == 40 || key == 41 || key == 123 || key == 125) {
        return true;
    }
    return key == 103 && keys.size() > 1 && (keys[1] == 101 || keys[1] == 69);
}

// A jump list or change list entry as a motion (nv_cursormark without a flag).
MED_motion.Motion list_motion(MED_editor.Editor editor, Option<MED_buffer.Pos> found) {
    match (found) {
        case Some(MED_buffer.Pos position): {
            MED_motion.Motion motion = motion_at(editor);
            motion.row = MED_num.smaller(MED_num.larger(position.row, 0), editor.buffer.line_count() - 1);
            motion.col = position.col;
            motion.want = -2;
            return motion;
        }
        case None: {
            return MED_motion.failed();
        }
    }
}

MED_motion.Motion run_motion_raw(MED_editor.Editor editor, List<int> keys, int count, str operator) {
    int key = keys[0];
    MED_motion.Motion motion = motion_at(editor);
    if (key == 104 || key == 8 || key == 127 || key == 63234) {
        return move_left(editor, key, count, operator);
    }
    if (key == 108 || key == 32 || key == 63235) {
        return move_right(editor, key, count, operator);
    }
    if (key == 106 || key == 10 || key == 14 || key == 63233) {
        return move_vertical(editor, count1(count));
    }
    if (key == 107 || key == 16 || key == 63232) {
        return move_vertical(editor, 0 - count1(count));
    }
    if (key == 43 || key == 13) {
        MED_motion.Motion motion_value = move_vertical(editor, count1(count));
        if (motion_value.is_ok) {
            motion_value.col = first_nonblank_fix(editor.buffer.line(motion_value.row));
            motion_value.want = -2;
        }
        return motion_value;
    }
    if (key == 45) {
        MED_motion.Motion motion_value = move_vertical(editor, 0 - count1(count));
        if (motion_value.is_ok) {
            motion_value.col = first_nonblank_fix(editor.buffer.line(motion_value.row));
            motion_value.want = -2;
        }
        return motion_value;
    }
    if (key == 95) {
        MED_motion.Motion motion_value = motion_at(editor);
        motion_value.is_linewise = true;
        int amount = count1(count) - 1;
        if (amount > 0) {
            if (editor.row >= editor.buffer.line_count() - 1) {
                motion_value.is_ok = false;
                return motion_value;
            }
            motion_value.row = MED_num.smaller(editor.row + amount, editor.buffer.line_count() - 1);
        }
        motion_value.col = lineop_col(editor, operator, motion_value.row, amount > 0);
        return motion_value;
    }
    if (key == 48 || key == 63236) {
        motion.col = 0;
        return motion;
    }
    if (key == 94) {
        motion.col = first_nonblank_fix(editor.buffer.line(editor.row));
        return motion;
    }
    if (key == 36 || key == 63237) {
        return line_end(editor, count);
    }
    if (key == 124) {
        motion.col = col_by_want(editor, editor.row, count1(count) - 1);
        motion.want = count1(count) - 1;
        return motion;
    }
    if (key == 119 || key == 87 || key == 98 || key == 66 || key == 101 || key == 69) {
        return word_motion(editor, key, count, operator);
    }
    if (key == 71) {
        return goto_line(editor, count, editor.buffer.line_count() - 1);
    }
    if (key == 72 || key == 77 || key == 76) {
        return view_motion(editor, key, count, operator);
    }
    if (key == 123 || key == 125) {
        int directory = 1;
        if (key == 123) {
            directory = -1;
        }
        if (editor.folds.size() > 0 && !editor.is_fold_off) {
            return paragraph_in_folds(editor, directory, count1(count));
        }
        MED_motion.Motion motion_item = MED_motion.paragraph(editor.buffer, editor.row, directory, count1(count));
        return motion_item;
    }
    if (key == 40 || key == 41) {
        int sdir = 1;
        if (key == 40) {
            sdir = -1;
        }
        MED_motion.Cur cursor = MED_motion.Cur(editor.buffer, editor.row, editor.col);
        if (!MED_motion.did_findsent(cursor, sdir, count1(count))) {
            return MED_motion.failed();
        }
        motion.row = cursor.row;
        motion.col = cursor.col;
        motion.is_jump = true;
        if (cursor.col > 0 && cursor.char_code() == 0) {
            motion.col = MED_text.previous_col(editor.buffer.line(cursor.row), cursor.col);
            motion.is_inclusive = true;
        }
        return motion;
    }
    if (key == 102 || key == 70 || key == 116 || key == 84) {
        return char_find(editor, key, keys[1], count, false, false);
    }
    if (key == 59) {
        return char_find(editor, key, 0, count, true, false);
    }
    if (key == 44) {
        return char_find(editor, key, 0, count, true, true);
    }
    if (key == 47 || key == 63) {
        return search_result(editor, MED_search.search_command(editor, key, editor.search_typed, count1(count), false, true));
    }
    if (key == 110 || key == 78) {
        return next_match(editor, key == 78, count);
    }
    if (key == 42 || key == 35) {
        return search_result(editor, MED_search.star(editor, key, true, count1(count)));
    }
    if (key == 37) {
        return percent_motion(editor, count);
    }
    if (key == 39 || key == 96) {
        return mark_motion(editor, key, keys[1], key == 39, true);
    }
    if (key == 91 || key == 93) {
        int second = keys[1];
        if (second == 91 || second == 93) {
            return section_motion(editor, key, second, count);
        }
        return bracket_motion(editor, key, second, count);
    }
    if (key == 15 || key == 9) {
        // CTRL-O / CTRL-I: older / newer jump list entry
        int steps = count1(count);
        if (key == 15) {
            steps = 0 - steps;
        }
        return list_motion(editor, editor.move_jump(steps));
    }
    if (key == 103) {
        int second = keys[1];
        if (second == 103) {
            return goto_line(editor, count, 0);
        }
        if (second == 59 || second == 44) {
            // g; / g,: older / newer change list entry
            int steps = count1(count);
            if (second == 59) {
                steps = 0 - steps;
            }
            return list_motion(editor, editor.move_change(steps));
        }
        if (second == 42 || second == 35) {
            return search_result(editor, MED_search.star(editor, second, false, count1(count)));
        }
        if (second == 39 || second == 96) {
            return mark_motion(editor, second, keys[2], second == 39, false);
        }
        if (second == 101 || second == 69) {
            MED_motion.Cur cursor_value = MED_motion.Cur(editor.buffer, editor.row, editor.col);
            bool is_ok = MED_motion.did_bckend_word(cursor_value, count1(count), second == 69, false);
            motion.row = cursor_value.row;
            motion.col = cursor_value.col;
            motion.is_inclusive = true;
            if (!is_ok) {
                if (operator == "") {
                    motion.is_beep = true;
                } else {
                    motion.is_ok = false;
                    motion.is_moved = true;
                }
            }
            return motion;
        }
        if (second == 95) {
            MED_motion.Motion motion_other = line_end(editor, count);
            if (!motion_other.is_ok) {
                return motion_other;
            }
            str line = editor.buffer.line(motion_other.row);
            int col = motion_other.col;
            if (col > 0 && col >= line.size()) {
                col = MED_text.last_col(line);
            }
            while (col > 0 && (line.byte_at(col) == 32 || line.byte_at(col) == 9)) {
                col = MED_text.previous_col(line, col);
            }
            motion_other.col = col;
            motion_other.want = -2;
            return motion_other;
        }
        if (second == 106 || second == 107) {
            // a screen-line move: charwise
            int delta = count1(count);
            if (!MED_screen.is_wrapping(editor)) {
                if (second == 107) {
                    delta = 0 - delta;
                }
                MED_motion.Motion motion_value = move_vertical(editor, delta);
                motion_value.is_linewise = false;
                return motion_value;
            }
            MED_screen.Outcome moved = MED_screen.move(editor, second == 106, delta, false);
            motion.row = moved.row;
            motion.col = moved.col;
            motion.want = moved.want;
            motion.is_inclusive = editor.want < 0;
            if (!moved.is_ok) {
                if (operator == "") {
                    motion.is_beep = true;
                } else {
                    motion.is_ok = false;
                    motion.is_moved = true;
                }
            }
            return motion;
        }
        if (editor.view_width > 0 && (second == 48 || second == 94 || second == 36 || second == 109)) {
            return screen_line_motion(editor, second, count);
        }
        if (second == 48 || second == 94 || second == 36) {
            List<int> single = [second];
            return run_motion(editor, single, 0, operator);
        }
        if (second == 109 || second == 77) {
            // gm: half a screen in; gM: `count` percent of the line's width
            str line = editor.buffer.line(editor.row);
            int target = editor.view_width / 2;
            if (second == 77) {
                int total = MED_text.line_width(line, editor.tab);
                if (count > 0 && count <= 100) {
                    target = total * count / 100;
                } else {
                    target = total / 2;
                }
            }
            motion.col = MED_text.col_at_display(line, target, editor.tab);
            motion.want = -2;
            return motion;
        }
        if (second == 111) {
            // go: byte `count` (1-based) of the buffer, newlines counting one
            int left = count1(count) - 1;
            int row = 0;
            while (row < editor.buffer.line_count() - 1 && left > editor.buffer.line_size(row)) {
                left = left - editor.buffer.line_size(row) - 1;
                row = row + 1;
            }
            int col = left;
            int size = editor.buffer.line_size(row);
            if (col > size) {
                col = size;
            }
            if (col > 0 && col >= size) {
                col = MED_text.last_col(editor.buffer.line(row));
            } else if (col > 0) {
                col = MED_text.snap(editor.buffer.line(row), col);
            }
            motion.row = row;
            motion.col = col;
            motion.is_jump = true;
            return motion;
        }
        return MED_motion.failed();
    }
    return MED_motion.failed();
}

// ---------------------------------------------------------------- operators

/// An operator's target: what do_pending_operator hands to op_delete & co.
const int NO_WANT = -3;

type Oap {
    str operator = "";
    str reg = "";
    MED_buffer.Pos start = MED_buffer.Pos(0, 0);
    MED_buffer.Pos end = MED_buffer.Pos(0, 0);
    bool is_linewise = false;
    bool is_inclusive = false;
    bool is_empty = false;
    bool is_reg_one = false;
    /// An exclusive motion that ended in column 0 was pulled back a line (Vim's end_adjusted).
    bool is_end_adjusted = false;
    /// The wanted column before the motion ran (Vim's old_col); NO_WANT when not recorded.
    int old_want = NO_WANT;
    int line_count = 1;
    bool is_visual = false;
    int amount = 1;
    int force = 0;
    bool is_object = false;
    bool is_block = false;
    int left_vcol = 0;
    int right_vcol = 0;
    bool is_eol = false;
    int rlines = 1;
    int rvcol = 0;
    /// The cursor before the motion ran (Vim's cursor_start); -1 when not recorded.
    int cursor_row = -1;
    int cursor_col = 0;
}

MED_buffer.Pos copy_position(MED_buffer.Pos position) {
    return MED_buffer.Pos(position.row, position.col);
}

// Where the operated text ends (exclusive) for a charwise range.
MED_buffer.Pos exclusive_end(MED_editor.Editor editor, Oap oap) {
    MED_buffer.Pos position = copy_position(oap.end);
    if (oap.is_inclusive) {
        str line = editor.buffer.line(position.row);
        if (position.col < line.size()) {
            position.col = MED_text.next_col(line, position.col);
        }
    }
    return position;
}

// A no-op edit so the undo block exists (Vim's u_save_cursor on an empty region).
void touch(MED_editor.Editor editor) {
    if (editor.buffer.is_empty) {
        return;
    }
    MED_buffer.Pos position = MED_buffer.Pos(editor.row, editor.col);
    editor.change(position, position, "");
}

// The '[ and '] marks.
void set_op_marks(MED_editor.Editor editor, MED_buffer.Pos position, MED_buffer.Pos position_value) {
    editor.marks.set("[", copy_position(position));
    editor.marks.set("]", copy_position(position_value));
}

// Vim's dec(): one character back, wrapping to the end of the previous line.
MED_buffer.Pos dec_position(MED_editor.Editor editor, MED_buffer.Pos position) {
    if (position.col > 0) {
        return MED_buffer.Pos(position.row, MED_text.previous_col(editor.buffer.line(position.row), MED_num.smaller(position.col, editor.buffer.line_size(position.row))));
    }
    if (position.row > 0) {
        return MED_buffer.Pos(position.row - 1, editor.buffer.line_size(position.row - 1));
    }
    return copy_position(position);
}

// The register content for the range.
MED_register.Reg range_reg(MED_editor.Editor editor, Oap oap) {
    if (oap.is_linewise) {
        List<str> lines = [];
        for (int row in oap.start.row .. oap.end.row + 1) {
            lines.push(editor.buffer.line(row));
        }
        return MED_register.Reg(lines, MED_register.LINE);
    }
    str text = editor.buffer.text(oap.start, exclusive_end(editor, oap));
    return MED_register.Reg(text.split("\n"), MED_register.CHAR);
}

bool is_in_indent(str line, int col) {
    int index = 0;
    while (index < col && index < line.size()) {
        int right = line.byte_at(index);
        if (right != 32 && right != 9) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// Delete `rows` whole lines starting at `first`, leaving at least one line.
void delete_lines(MED_editor.Editor editor, int first, int last) {
    int count = editor.buffer.line_count();
    if (first == 0 && last == count - 1) {
        editor.change(MED_buffer.Pos(0, 0), MED_buffer.Pos(last, editor.buffer.line_size(last)), "");
        editor.buffer.is_empty = true;
    } else if (last == count - 1) {
        editor.change(MED_buffer.Pos(first - 1, editor.buffer.line_size(first - 1)), MED_buffer.Pos(last, editor.buffer.line_size(last)), "");
    } else {
        editor.change(MED_buffer.Pos(first, 0), MED_buffer.Pos(last + 1, 0), "");
    }
    // deleting lines forgets the line "U" would restore
    editor.uline_row = -1;
    editor.override_change(MED_buffer.Pos(first, 0));
}

// Vim's op_yank: the register write for a yank.
void op_yank(MED_editor.Editor editor, Oap oap) {
    editor.regs.yank(oap.reg, range_reg(editor, oap));
    if (oap.is_linewise) {
        set_op_marks(editor, MED_buffer.Pos(oap.start.row, 0), MED_buffer.Pos(oap.end.row, MAXCOL));
        note_yank(editor, oap.start, oap.end, true);
    } else if (oap.is_inclusive || oap.is_block) {
        set_op_marks(editor, oap.start, oap.end);
        note_yank(editor, oap.start, oap.end, false);
    } else {
        set_op_marks(editor, oap.start, dec_position(editor, oap.end));
        note_yank(editor, oap.start, dec_position(editor, oap.end), false);
    }
}

// Tell the front end a yank happened and over what: the first and last
// character yanked (the yank flash).
void note_yank(MED_editor.Editor editor, MED_buffer.Pos first, MED_buffer.Pos last, bool is_lines) {
    editor.yank_serial = editor.yank_serial + 1;
    editor.yank_start = first;
    editor.yank_end = last;
    editor.is_yank_lines = is_lines;
}

// Vim's op_delete (also the first half of op_change). Returns false if the
// operation did not happen.
bool did_op_delete(MED_editor.Editor editor, Oap oap) {
    MED_buffer.Buffer buffer = editor.buffer;
    if (buffer.is_empty && oap.is_linewise) {
        return true;
    }
    if (oap.is_empty) {
        touch(editor);
        return true;
    }
    bool is_delete = oap.operator == "d";
    if (!oap.is_linewise && !oap.is_visual && oap.line_count > 1 && oap.force == 0 && is_delete) {
        str end_line = buffer.line(oap.end.row);
        int at_end = oap.end.col;
        if (at_end < end_line.size() && oap.is_inclusive) {
            at_end = MED_text.next_col(end_line, at_end);
        }
        int rest = at_end;
        while (rest < end_line.size() && (end_line.byte_at(rest) == 32 || end_line.byte_at(rest) == 9)) {
            rest = rest + 1;
        }
        if (rest >= end_line.size() && is_in_indent(buffer.line(oap.start.row), oap.start.col)) {
            oap.is_linewise = true;
        }
    }
    if (!oap.is_linewise && oap.line_count == 1 && is_delete && buffer.line_size(oap.start.row) == 0) {
        return true;
    }
    MED_register.Reg reg = range_reg(editor, oap);
    bool is_shift = oap.is_linewise || oap.line_count > 1 || oap.is_reg_one;
    bool is_small = !oap.is_linewise && oap.line_count == 1;
    editor.regs.delete(oap.reg, reg, is_shift, is_small);
    editor.row = oap.start.row;
    editor.col = oap.start.col;
    if (oap.is_linewise) {
        if (oap.operator == "c") {
            if (oap.end.row > oap.start.row) {
                delete_lines(editor, oap.start.row + 1, oap.end.row);
            }
            str line = buffer.line(oap.start.row);
            int keep = 0;
            if (editor.is_autoindent) {
                keep = MED_text.first_nonblank(line);
                editor.did_ai = true;
            }
            editor.change(MED_buffer.Pos(oap.start.row, keep), MED_buffer.Pos(oap.start.row, line.size()), "");
            editor.row = oap.start.row;
            editor.col = keep;
            if (oap.end.row > oap.start.row) {
                // after the lines went, Vim's "U" line is the emptied one
                editor.uline_row = oap.start.row;
                editor.uline_text = buffer.line(oap.start.row);
                editor.uline_col = keep;
            }
        } else {
            delete_lines(editor, oap.start.row, oap.end.row);
            editor.row = MED_num.smaller(oap.start.row, buffer.line_count() - 1);
            if (oap.is_end_adjusted) {
                editor.col = first_nonblank_fix(buffer.line(editor.row));
            } else if (oap.old_want != NO_WANT) {
                editor.col = col_by_want(editor, editor.row, oap.old_want);
            } else {
                editor.col = col_by_want(editor, editor.row, editor.want);
            }
        }
    } else {
        MED_buffer.Pos position = exclusive_end(editor, oap);
        editor.change(oap.start, position, "");
        if (position.row > oap.start.row) {
            // a character-wise delete over lines ends in a join of two lines
            editor.override_change(MED_buffer.Pos(oap.start.row + 1, 0));
        }
        editor.row = oap.start.row;
        editor.col = oap.start.col;
        if (oap.operator != "c") {
            str line = buffer.line(editor.row);
            if (editor.col > 0 && editor.col >= line.size()) {
                editor.col = MED_text.last_col(line);
            }
        }
    }
    set_op_marks(editor, oap.start, oap.start);
    return true;
}

// The indent (screen columns) of a line and its length in bytes.
pub int indent_width(MED_editor.Editor editor, str line) {
    int spot = 0;
    int index = 0;
    while (index < line.size()) {
        int right = line.byte_at(index);
        if (right == 32) {
            spot = spot + 1;
        } else if (right == 9) {
            spot = spot + editor.tab - (spot % editor.tab);
        } else {
            break;
        }
        index = index + 1;
    }
    return spot;
}

// Replace a line's indent by one of `width` columns (tabs first unless 'expandtab').
pub str with_indent(MED_editor.Editor editor, str line, int width) {
    int skip = MED_text.first_nonblank(line);
    str rest = line.substr(skip, line.size());
    if (editor.is_expandtab) {
        return " ".repeat(width) + rest;
    }
    return "\t".repeat(width / editor.tab) + " ".repeat(width % editor.tab) + rest;
}

// Vim's shift_line(): the indent `width` becomes after shifting `amount`
// 'shiftwidth's, rounded to a multiple with 'shiftround'.
int shifted_width(MED_editor.Editor editor, int width, bool is_left, int amount, bool is_round) {
    int unit = editor.shift_size();
    if (!is_round) {
        if (is_left) {
            return MED_num.larger(width - unit * amount, 0);
        }
        return width + unit * amount;
    }
    int steps = width / unit;
    int times = amount;
    if (is_left) {
        if (width % unit != 0) {
            times = times - 1;
        }
        steps = MED_num.larger(steps - times, 0);
    } else {
        steps = steps + times;
    }
    return steps * unit;
}

// Vim's op_shift for `>` and `<` over whole lines.
void op_shift(MED_editor.Editor editor, Oap oap) {
    touch(editor);
    bool is_saved_off = editor.is_uline_off;
    if (oap.end.row > oap.start.row) {
        editor.is_uline_off = true;
    }
    for (int row in oap.start.row .. oap.end.row + 1) {
        str line = editor.buffer.line(row);
        if (line.size() == 0) {
            continue;
        }
        int width = shifted_width(editor, indent_width(editor, line), oap.operator == "<", oap.amount, editor.is_shiftround);
        str replaced = with_indent(editor, line, width);
        if (replaced != line) {
            editor.change(MED_buffer.Pos(row, 0), MED_buffer.Pos(row, line.size()), replaced);
        }
    }
    editor.is_uline_off = is_saved_off;
    int end_length = editor.buffer.line_size(oap.end.row);
    if (end_length > 0) {
        end_length = end_length - 1;
    }
    editor.override_change(MED_buffer.Pos(oap.start.row, 0));
    set_op_marks(editor, oap.start, MED_buffer.Pos(oap.end.row, end_length));
    // beginline(BL_SOL | BL_FIX) with 'nostartofline': back to the wanted column
    editor.row = oap.start.row;
    if (editor.is_startofline) {
        editor.col = first_nonblank_fix(editor.buffer.line(editor.row));
        editor.want_from_cursor();
    } else {
        editor.col = col_by_want(editor, editor.row, editor.want);
    }
}

// The indent (columns) Vim's C indenter gives `row` in text without a language:
// the new indent of the nearest non-blank line above, one level deeper after a
// line that ends in `{`, and a line starting with `}` lines up with the line
// that holds its `{`. (Full cindent is not modelled.)
int reindent_width(MED_editor.Editor editor, int row) {
    int above = row - 1;
    while (above >= 0 && is_blank_line(editor.buffer.line(above))) {
        above = above - 1;
    }
    if (above < 0) {
        return 0;
    }
    str current = editor.buffer.line(row);
    str current_text = current.substr(MED_text.first_nonblank(current), current.size());
    if (current_text.starts_with("}")) {
        int depth = 1;
        int scan = above;
        while (scan >= 0) {
            str text = editor.buffer.line(scan);
            int index = text.size() - 1;
            while (index >= 0) {
                int char_code = text.byte_at(index);
                if (char_code == 125) {
                    depth = depth + 1;
                } else if (char_code == 123) {
                    depth = depth - 1;
                    if (depth == 0) {
                        return indent_width(editor, text);
                    }
                }
                index = index - 1;
            }
            scan = scan - 1;
        }
        return 0;
    }
    str previous = editor.buffer.line(above);
    int width = indent_width(editor, previous);
    int last = previous.size() - 1;
    while (last >= 0 && (previous.byte_at(last) == 32 || previous.byte_at(last) == 9)) {
        last = last - 1;
    }
    if (last >= 0 && previous.byte_at(last) == 123) {
        return width + editor.shift_size();
    }
    return width;
}

// Vim's op_reindent for `=` (get_c_indent without a language).
void op_reindent(MED_editor.Editor editor, Oap oap) {
    touch(editor);
    bool is_saved_off = editor.is_uline_off;
    if (oap.end.row > oap.start.row) {
        editor.is_uline_off = true;
    }
    for (int row in oap.start.row .. oap.end.row + 1) {
        str line = editor.buffer.line(row);
        str replaced = "";
        if (!is_blank_line(line)) {
            replaced = with_indent(editor, line, reindent_width(editor, row));
        }
        if (replaced != line) {
            editor.change(MED_buffer.Pos(row, 0), MED_buffer.Pos(row, line.size()), replaced);
        }
    }
    editor.is_uline_off = is_saved_off;
    int end_length = editor.buffer.line_size(oap.end.row);
    if (end_length > 0) {
        end_length = end_length - 1;
    }
    set_op_marks(editor, oap.start, MED_buffer.Pos(oap.end.row, end_length));
    editor.row = oap.start.row;
    editor.col = col_by_want(editor, editor.row, editor.want);
}

// ------------------------------------------------------------------- gq, gw

// 'textwidth' for formatting (Vim's comp_textwidth): 0 means the window width
// less one, at most 79.
int format_width(MED_editor.Editor editor) {
    int width = editor.textwidth;
    if (width <= 0) {
        width = editor.view_width - 1;
        if (width > 79) {
            width = 79;
        }
    }
    return MED_num.larger(width, 1);
}

/// The comment leader of a line (Vim's get_leader_len): `length` bytes with
/// the blanks before and after it, 0 when the line has none; `is_first` for
/// the `f` flag (only the first line of a paragraph has it).
type Leader {
    pub int length = 0;
    pub bool is_first = false;
}

str default_comments() {
    return "s1:/*,mb:*,ex:*/,://,b:#,:%,:XCOMM,n:>,fb:-,fb:" + str.from_chars([8226]);
}

// Single-piece and middle leaders of 'comments' (three-piece starts and
// ends are not modelled).
Leader comment_leader(MED_editor.Editor editor, str line) {
    Leader found = Leader();
    str parts = default_comments();
    match (editor.opts.get("comments")) {
        case Some(str value): {
            parts = value;
        }
        case None: {
        }
    }
    int index = 0;
    while (index < line.size() && is_white_byte(line.byte_at(index))) {
        index = index + 1;
    }
    bool is_matched = false;
    while (index < line.size()) {
        bool is_found = false;
        bool is_nested = false;
        for (str part in parts.split(",")) {
            int colon = part.index_of(":").or(-1);
            if (colon < 0) {
                continue;
            }
            str flags = part.substr(0, colon);
            str text = part.substr(colon + 1, part.size());
            if (flags.contains("s") || flags.contains("e") || text.size() == 0) {
                continue;
            }
            if (is_matched && !flags.contains("n")) {
                continue;
            }
            if (!line.substr(index, line.size()).starts_with(text)) {
                continue;
            }
            int after = index + text.size();
            if (flags.contains("b") && after < line.size() && !is_white_byte(line.byte_at(after))) {
                continue;
            }
            index = after;
            is_found = true;
            is_matched = true;
            is_nested = flags.contains("n");
            found.is_first = flags.contains("f");
            break;
        }
        if (!is_found) {
            break;
        }
        while (index < line.size() && is_white_byte(line.byte_at(index))) {
            index = index + 1;
        }
        found.length = index;
        if (!is_nested) {
            break;
        }
    }
    if (!is_matched) {
        found.length = 0;
    }
    return found;
}

// Vim's same_leader: whether line `next` continues the paragraph of `line`.
bool is_same_leader(str line, Leader first, str next, Leader second) {
    if (first.length == 0) {
        return second.length == 0;
    }
    if (first.is_first) {
        return second.length == 0;
    }
    int index1 = 0;
    while (index1 < line.size() && is_white_byte(line.byte_at(index1))) {
        index1 = index1 + 1;
    }
    int index2 = 0;
    while (index2 < second.length) {
        int byte = next.byte_at(index2);
        if (!is_white_byte(byte)) {
            if (index1 >= line.size() || line.byte_at(index1) != byte) {
                break;
            }
            index1 = index1 + 1;
        } else {
            while (index1 < line.size() && is_white_byte(line.byte_at(index1))) {
                index1 = index1 + 1;
            }
        }
        if (index1 > first.length) {
            break;
        }
        index2 = index2 + 1;
    }
    return index2 == second.length && index1 == first.length;
}

// Break `line` into lines of at most `width` columns at blanks (Vim's
// internal_format): the break is the last blank run that starts within the
// width, or the first one when there is none. `indent` starts every new line.
List<str> wrap_line(MED_editor.Editor editor, str text, int width, str indent, int lead_length) {
    List<str> out = [];
    str line = text;
    while (true) {
        str trimmed = strip_right(line);
        if (trimmed == "") {
            out.push(line);
            return out;
        }
        int end_col = MED_text.last_col(trimmed);
        int virt = MED_text.display_col(trimmed, end_col, editor.tab) + MED_text.cell_width(trimmed, end_col, MED_text.display_col(trimmed, end_col, editor.tab), editor.tab);
        if (virt <= width) {
            out.push(line);
            return out;
        }
        int wantcol = MED_motion.col_for_want(line, width, editor.tab, true);
        int cursor_col = end_col;
        int found = 0;
        while (true) {
            if (is_white_byte(line.byte_at(cursor_col))) {
                while (cursor_col > 0 && is_white_byte(line.byte_at(cursor_col))) {
                    cursor_col = MED_text.previous_col(line, cursor_col);
                }
                if (cursor_col == 0 && is_white_byte(line.byte_at(cursor_col))) {
                    break;
                }
                if (cursor_col < lead_length) {
                    break;
                }
                cursor_col = MED_text.next_col(line, cursor_col);
                found = cursor_col;
                if (found <= wantcol) {
                    break;
                }
            }
            if (cursor_col == 0) {
                break;
            }
            cursor_col = MED_text.previous_col(line, cursor_col);
        }
        if (found == 0) {
            out.push(line);
            return out;
        }
        int rest_at = found;
        while (rest_at < line.size() && is_white_byte(line.byte_at(rest_at))) {
            rest_at = rest_at + 1;
        }
        out.push(line.substr(0, found));
        line = indent + line.substr(rest_at, line.size());
    }
}

// The lines of one paragraph joined (do_join with a space) and wrapped. The
// comment leader of the first line starts every new line ('f' leaders become
// blanks of the same width); the leaders of the joined lines are dropped.
List<str> format_paragraph(MED_editor.Editor editor, List<str> lines, int width) {
    bool is_comments = has_format_flag(editor, "q");
    Leader lead = Leader();
    if (is_comments) {
        lead = comment_leader(editor, lines[0]);
    }
    str joined = lines[0];
    for (int index in 1 .. lines.size()) {
        str next = lines[index];
        if (is_comments) {
            Leader next_lead = comment_leader(editor, next);
            if (next_lead.length > 0) {
                next = next.substr(next_lead.length, next.size());
            }
        }
        next = next.substr(leading_space(next), next.size());
        bool is_space = joined != "" && next != "" && !next.starts_with(")");
        if (is_space && (joined.ends_with("\t") || joined.ends_with(" "))) {
            is_space = false;
        }
        if (is_space) {
            joined = joined + " ";
        }
        joined = joined + next;
    }
    str indent = "";
    if (lead.length > 0) {
        indent = lines[0].substr(0, lead.length);
        if (lead.is_first) {
            indent = " ".repeat(MED_text.line_width(indent, editor.tab));
        }
    } else if (editor.is_autoindent) {
        indent = make_indent(editor, indent_width(editor, lines[0]));
    }
    if (lead.length == 0 && lines.size() > 1 && has_format_flag(editor, "2") && comment_leader(editor, lines[1]).length == 0 && !is_blank_line(lines[1])) {
        indent = make_indent(editor, indent_width(editor, lines[1]));
    }
    return wrap_line(editor, joined, width, indent, lead.length);
}

// The Nth non-blank character of rows `from`..`to`, as a count (for `gw`).
int nonblank_before(MED_editor.Editor editor, int from, int row, int col) {
    int total = 0;
    for (int index in from .. row + 1) {
        str line = editor.buffer.line(index);
        int stop = line.size();
        if (index == row) {
            stop = MED_num.smaller(col, line.size());
        }
        int scan = 0;
        while (scan < stop) {
            if (!is_white_byte(line.byte_at(scan))) {
                total = total + 1;
            }
            scan = MED_text.next_col(line, scan);
        }
    }
    return total;
}

// Format one paragraph into `out` and note where nvim's `.` mark ends up. format_lines() joins the lines of a
// paragraph one by one (each do_join leaves `.` at column 0 of the line after the joined one) and then splits the
// long line at 'textwidth' (each break leaves `.` at the end of the line it cut). So the last change is the last
// break when there was one, else the last join. A lone line that needs nothing changes nothing.
void format_into(MED_editor.Editor editor, List<str> paragraph, int width, List<str> out, int first, MED_buffer.Pos dot_spot) {
    int start = out.size();
    List<str> formatted = format_paragraph(editor, paragraph, width);
    for (str line in formatted) {
        out.push(line);
    }
    if (formatted.size() > 1) {
        dot_spot.row = first + start + formatted.size() - 2;
        dot_spot.col = formatted[formatted.size() - 2].size();
    } else if (paragraph.size() > 1) {
        dot_spot.row = first + start + 1;
        dot_spot.col = 0;
    }
}

// `gq` and `gw`: reformat the lines of the area to 'textwidth'.
void op_format(MED_editor.Editor editor, Oap oap, bool is_keep_cursor) {
    touch(editor);
    int width = format_width(editor);
    MED_buffer.Pos saved = MED_buffer.Pos(editor.row, editor.col);
    if (oap.cursor_row >= 0) {
        saved = MED_buffer.Pos(oap.cursor_row, oap.cursor_col);
    }
    int first = oap.start.row;
    int last = oap.end.row;
    int keep_count = nonblank_before(editor, first, saved.row, saved.col);
    List<str> before_lines = [];
    for (int row_before in first .. last + 1) {
        before_lines.push(editor.buffer.line(row_before));
    }
    bool is_cursor_inside = saved.row >= first && saved.row <= last;
    List<str> out = [];
    List<str> paragraph = [];
    // where nvim leaves the `.` mark: its last changed_lines() call (see format_into)
    MED_buffer.Pos dot_spot = MED_buffer.Pos(-1, 0);
    bool is_comments = has_format_flag(editor, "q");
    for (int row in first .. last + 1) {
        str line = editor.buffer.line(row);
        Leader lead = Leader();
        if (is_comments) {
            lead = comment_leader(editor, line);
        }
        bool is_blank = is_blank_line(line) || (lead.length > 0 && is_blank_line(line.substr(lead.length, line.size())));
        if (is_blank) {
            if (paragraph.size() > 0) {
                format_into(editor, paragraph, width, out, first, dot_spot);
                paragraph = [];
            }
            out.push(line);
        } else {
            if (paragraph.size() > 0) {
                str previous = paragraph[paragraph.size() - 1];
                Leader previous_lead = Leader();
                if (is_comments) {
                    previous_lead = comment_leader(editor, previous);
                }
                if (!is_same_leader(previous, previous_lead, line, lead)) {
                    format_into(editor, paragraph, width, out, first, dot_spot);
                    paragraph = [];
                }
            }
            paragraph.push(line);
        }
    }
    if (paragraph.size() > 0) {
        format_into(editor, paragraph, width, out, first, dot_spot);
    }
    bool is_same = out.size() == last - first + 1;
    if (is_same) {
        for (int index in 0 .. out.size()) {
            if (out[index] != editor.buffer.line(first + index)) {
                is_same = false;
                break;
            }
        }
    }
    if (!is_same) {
        editor.change(MED_buffer.Pos(first, 0), MED_buffer.Pos(last, editor.buffer.line_size(last)), out.join("\n"));
    }
    if (dot_spot.row >= 0) {
        editor.override_change(dot_spot);
    }
    int end_row = first + out.size() - 1;
    if (oap.is_end_adjusted && end_row < editor.buffer.line_count() - 1) {
        end_row = end_row + 1;
    }
    editor.row = end_row;
    editor.col = first_nonblank_fix(editor.buffer.line(end_row));
    set_op_marks(editor, MED_buffer.Pos(first, 0), MED_buffer.Pos(editor.row, editor.col));
    if (is_keep_cursor) {
        // put the cursor back on the same character
        int row = first;
        int seen = 0;
        int target_col = 0;
        int stop_row = first + out.size();
        bool is_found = false;
        if (is_same && is_cursor_inside) {
            // nothing changed: the cursor stays where it was (nvim restores the saved position)
            editor.row = saved.row;
            editor.col = saved.col;
        } else if (!is_cursor_inside) {
            row = saved.row;
            if (saved.row > last) {
                row = saved.row + (out.size() - (last - first + 1));
            }
            editor.row = MED_num.smaller(row, editor.buffer.line_count() - 1);
            editor.col = saved.col;
        } else {
            // a cursor on blank text stays that far after the last word before it
            // (nvim keeps the saved position through a join)
            int white_gap = 0;
            bool is_on_white = false;
            if (keep_count > 0 && saved.row >= first && saved.row <= last) {
                str was = before_lines[saved.row - first];
                if (saved.col >= was.size() || is_white_byte(was.byte_at(saved.col))) {
                    is_on_white = true;
                    int back = saved.col;
                    while (back > 0 && back <= was.size() && is_white_byte(was.byte_at(back - 1))) {
                        back = back - 1;
                        white_gap = white_gap + 1;
                    }
                }
            }
            while (row < stop_row && !is_found) {
                str line = editor.buffer.line(row);
                int scan = 0;
                while (scan < line.size()) {
                    if (!is_white_byte(line.byte_at(scan))) {
                        if (is_on_white && seen == keep_count - 1) {
                            is_found = true;
                            target_col = MED_text.next_col(line, scan) + white_gap;
                            break;
                        }
                        if (!is_on_white && seen == keep_count) {
                            is_found = true;
                            target_col = scan;
                            break;
                        }
                        seen = seen + 1;
                    }
                    scan = MED_text.next_col(line, scan);
                }
                if (!is_found) {
                    row = row + 1;
                }
            }
            if (!is_found) {
                row = stop_row - 1;
                target_col = editor.buffer.line_size(row);
            }
            editor.row = row;
            editor.col = target_col;
        }
    }
    editor.clamp();
}

int rot13(int code_point) {
    if (code_point >= 97 && code_point <= 122) {
        return 97 + (code_point - 97 + 13) % 26;
    }
    if (code_point >= 65 && code_point <= 90) {
        return 65 + (code_point - 65 + 13) % 26;
    }
    return code_point;
}

str map_case(str text, str operator) {
    List<int> out = [];
    for (int code_point in text.chars()) {
        int mapped = code_point;
        if (operator == "g?") {
            mapped = rot13(code_point);
        } else if (code_point < 128) {
            bool is_lower = code_point >= 97 && code_point <= 122;
            bool is_upper = code_point >= 65 && code_point <= 90;
            if (operator == "gU" || (operator == "g~" && is_lower)) {
                if (is_lower) {
                    mapped = code_point - 32;
                }
            } else if (operator == "gu" || (operator == "g~" && is_upper)) {
                if (is_upper) {
                    mapped = code_point + 32;
                }
            }
        } else {
            str one = str.from_chars([code_point]);
            str upward = MED_case.upper(one);
            str low = MED_case.lower(one);
            if (operator == "gU") {
                mapped = upward.chars()[0];
            } else if (operator == "gu") {
                mapped = low.chars()[0];
            } else if (operator == "g~") {
                if (upward != one) {
                    mapped = upward.chars()[0];
                } else {
                    mapped = low.chars()[0];
                }
            }
        }
        out.push(mapped);
    }
    return str.from_chars(out);
}

// Vim's op_tilde: g~ gu gU g? over a range.
void op_case(MED_editor.Editor editor, Oap oap) {
    touch(editor);
    MED_buffer.Pos from = copy_position(oap.start);
    MED_buffer.Pos position = exclusive_end(editor, oap);
    if (!oap.is_linewise && !oap.is_inclusive && oap.start.row == oap.end.row && oap.start.col == oap.end.col) {
        // Vim's op_tilde steps the end back one position first: at the very
        // start of the buffer that leaves one character, at column 0 of a later
        // line it ends on the previous line and the whole start line changes,
        // anywhere else nothing.
        str here = editor.buffer.line(from.row);
        if (from.row == 0 && from.col == 0) {
            if (here.size() > 0) {
                position = MED_buffer.Pos(from.row, MED_text.next_col(here, 0));
            }
        } else if (from.col == 0) {
            position = MED_buffer.Pos(from.row, here.size());
        }
    }
    if (oap.is_linewise) {
        from = MED_buffer.Pos(oap.start.row, 0);
        position = MED_buffer.Pos(oap.end.row, editor.buffer.line_size(oap.end.row));
    }
    str text = editor.buffer.text(from, position);
    str mapped = map_case(text, oap.operator);
    if (mapped != text) {
        editor.change(from, position, mapped);
    }
    if (oap.is_linewise) {
        int end_length = editor.buffer.line_size(oap.end.row);
        if (end_length > 0) {
            end_length = end_length - 1;
        }
        set_op_marks(editor, MED_buffer.Pos(oap.start.row, 0), MED_buffer.Pos(oap.end.row, end_length));
    } else if (oap.is_inclusive) {
        set_op_marks(editor, oap.start, oap.end);
    } else {
        set_op_marks(editor, oap.start, dec_position(editor, oap.end));
    }
    editor.row = oap.start.row;
    editor.col = oap.start.col;
    if (oap.is_linewise && !oap.is_visual) {
        editor.col = oap.start.col;
    }
}

// Vim's do_join: join `count` lines starting at `row`.
pub bool did_do_join(MED_editor.Editor editor, int row, int count, bool is_insert_space) {
    if (row + count > editor.buffer.line_count()) {
        return false;
    }
    str acc = editor.buffer.line(row);
    int sum_col = 0;
    int join_col = 0;
    List<int> mark_shift = [];
    List<int> mark_removed = [];
    for (int target in 1 .. count) {
        str curr = editor.buffer.line(row + target);
        int spaces = 0;
        int removed_ws = 0;
        if (is_insert_space) {
            int skip = 0;
            while (skip < curr.size() && (curr.byte_at(skip) == 32 || curr.byte_at(skip) == 9)) {
                skip = skip + 1;
            }
            removed_ws = skip;
            curr = curr.substr(skip, curr.size());
            if (curr.size() > 0 && curr.byte_at(0) != 41 && acc.size() > 0) {
                int last = acc.byte_at(acc.size() - 1);
                if (last != 9) {
                    if (last != 32) {
                        spaces = 1;
                        if (editor.is_joinspaces && (last == 46 || last == 33 || last == 63)) {
                            spaces = 2;
                        }
                    }
                }
            }
        }
        join_col = acc.size();
        mark_shift.push(join_col + spaces - removed_ws);
        mark_removed.push(removed_ws);
        acc = acc + " ".repeat(spaces) + curr;
        sum_col = join_col;
    }
    editor.join_marks(row, mark_shift, mark_removed);
    str first = editor.buffer.line(row);
    int last_row = row + count - 1;
    editor.change(MED_buffer.Pos(row, 0), MED_buffer.Pos(last_row, editor.buffer.line_size(last_row)), acc);
    int end_col = acc.size();
    if (end_col > 0) {
        end_col = end_col - 1;
    }
    set_op_marks(editor, MED_buffer.Pos(row, first.size()), MED_buffer.Pos(row, end_col));
    editor.override_change(MED_buffer.Pos(row + 1, 0));
    editor.row = row;
    editor.col = join_col;
    return true;
}

const int PUT_LINE = 1;
const int PUT_LINE_SPLIT = 2;
const int PUT_LINE_FORWARD = 4;
const int PUT_FIXINDENT = 8;

// Vim's do_put. `directory` 1 for p / gp, -1 for P / gP; `is_cursor_end` for gp / gP.
bool did_do_put(MED_editor.Editor editor, str regname, int directory, int count, bool is_cursor_end) {
    Option<MED_register.Reg> found = editor.regs.get(regname);
    match (found) {
        case None: {
            editor.message = "E353: Nothing in register " + regname;
            editor.noop_node();
            set_op_marks(editor, MED_buffer.Pos(editor.row, editor.col), MED_buffer.Pos(editor.row, editor.col));
            return false;
        }
        case Some(MED_register.Reg reg): {
            return did_put_reg(editor, reg, directory, count, is_cursor_end, 0, 0);
        }
    }
}

// Put a block-wise register: each line goes into the same columns of the
// lines below the cursor.
bool did_put_block(MED_editor.Editor editor, MED_register.Reg reg, int directory, int count, bool is_cursor_end) {
    int total = count1(count);
    MED_buffer.Buffer buffer = editor.buffer;
    str current = buffer.line(editor.row);
    int curcol = editor.col;
    int col = 0;
    if (directory > 0 && curcol < current.size()) {
        col = MED_text.display_col(current, curcol, editor.tab) + MED_text.cell_width(current, curcol, MED_text.display_col(current, curcol, editor.tab), editor.tab);
        curcol = MED_text.next_col(current, curcol);
    } else {
        col = MED_text.display_col(current, curcol, editor.tab);
    }
    int row0 = editor.row;
    int cursor_col = curcol;
    int cursor_col0 = curcol;
    int last_textcol = 0;
    int last_totlen = 0;
    for (int i in 0 .. reg.lines.size()) {
        int row = row0 + i;
        if (row >= buffer.line_count()) {
            int last_row = buffer.line_count() - 1;
            editor.change(MED_buffer.Pos(last_row, buffer.line_size(last_row)), MED_buffer.Pos(last_row, buffer.line_size(last_row)), "\n");
        }
        str old = buffer.line(row);
        int spot = 0;
        int vcol = 0;
        int incr = 0;
        while (vcol < col && spot < old.size()) {
            incr = MED_text.cell_width(old, spot, vcol, editor.tab);
            vcol = vcol + incr;
            spot = MED_text.next_col(old, spot);
        }
        int textcol = spot;
        bool is_shortline = vcol < col || (vcol == col && spot >= old.size());
        int startspaces = 0;
        int endspaces = 0;
        int delcount = 0;
        if (vcol < col) {
            startspaces = col - vcol;
        } else if (vcol > col) {
            endspaces = vcol - col;
            startspaces = incr - endspaces;
            textcol = MED_text.previous_col(old, spot);
            delcount = spot - textcol;
            if (old.byte_at(textcol) != 9) {
                delcount = 0;
                endspaces = 0;
                textcol = spot;
            }
        }
        str yank = reg.lines[i];
        int spaces = reg.width - MED_text.line_width(yank, editor.tab);
        if (spaces < 0) {
            spaces = 0;
        }
        int totlen = total * (yank.size() + spaces) + startspaces + endspaces;
        List<str> pieces = [old.substr(0, textcol), " ".repeat(startspaces)];
        for (int j in 0 .. total) {
            pieces.push(yank);
            if ((j < total - 1 || !is_shortline) && spaces > 0) {
                pieces.push(" ".repeat(spaces));
            } else {
                totlen = totlen - spaces;
            }
        }
        pieces.push(" ".repeat(endspaces));
        pieces.push(old.substr(textcol + delcount, old.size()));
        editor.change(MED_buffer.Pos(row, 0), MED_buffer.Pos(row, old.size()), pieces.join(""));
        if (i == 0) {
            cursor_col = cursor_col + startspaces;
        }
        last_textcol = textcol;
        last_totlen = totlen;
    }
    set_op_marks(editor, MED_buffer.Pos(row0, cursor_col0), MED_buffer.Pos(row0 + reg.lines.size() - 1, last_textcol + last_totlen - 1));
    if (is_cursor_end) {
        editor.row = row0 + reg.lines.size() - 1;
        editor.col = MED_num.smaller(last_textcol + last_totlen, buffer.line_size(editor.row));
    } else {
        editor.row = row0;
        editor.col = cursor_col;
    }
    editor.clamp();
    return true;
}

// PUT_FIXINDENT: the put lines keep their relative indent, the first one
// getting `orig_indent`; empty lines get none.
void fix_put_indent(MED_editor.Editor editor, int first_row, int last_row, int orig_indent) {
    int diff = 0;
    bool is_first = true;
    for (int row in first_row .. last_row + 1) {
        str line = editor.buffer.line(row);
        int width = 0;
        if (line.size() == 0) {
            width = 0;
        } else if (is_first) {
            diff = orig_indent - indent_width(editor, line);
            width = orig_indent;
            is_first = false;
        } else {
            width = MED_num.larger(indent_width(editor, line) + diff, 0);
        }
        str fixed = with_indent(editor, line, width);
        if (fixed != line) {
            editor.change(MED_buffer.Pos(row, 0), MED_buffer.Pos(row, line.size()), fixed);
        }
    }
}

// Vim's do_put with its flags (PUT_LINE and friends, used by Visual `p`).
// `vi_row` is the row the Visual end was on, for PUT_LINE_FORWARD.
bool did_put_reg(MED_editor.Editor editor, MED_register.Reg reg0, int dir0, int count, bool is_cursor_end, int flags, int vi_row) {
    MED_register.Reg reg = reg0;
    int directory = dir0;
    int amount = count1(count);
    set_op_marks(editor, MED_buffer.Pos(editor.row, editor.col), MED_buffer.Pos(editor.row, editor.col));
    MED_buffer.Buffer buffer = editor.buffer;
    if (reg.kind == MED_register.BLOCK && (flags & PUT_LINE) == 0) {
        return did_put_block(editor, reg, directory, count, is_cursor_end);
    }
    bool was_line = reg.kind == MED_register.LINE;
    if (was_line) {
        if ((flags & PUT_LINE_SPLIT) != 0) {
            str current = buffer.line(editor.row);
            int spot = editor.col;
            if (directory > 0 && spot < current.size()) {
                spot = MED_text.next_col(current, spot);
            }
            editor.change(MED_buffer.Pos(editor.row, spot), MED_buffer.Pos(editor.row, spot), "\n");
            directory = 1;
        }
        if ((flags & PUT_LINE_FORWARD) != 0) {
            editor.row = MED_num.smaller(vi_row, buffer.line_count() - 1);
            directory = 1;
        }
    }
    if ((flags & PUT_LINE) != 0) {
        reg = MED_register.Reg(reg.lines, MED_register.LINE);
    }
    if (reg.kind == MED_register.LINE) {
        // a closed fold counts as one line: put below its last line or above its first
        if (directory > 0) {
            int fold_end = editor.fold_end_of(editor.row);
            if (fold_end >= 0) {
                editor.row = fold_end;
            }
        } else {
            int fold_start = editor.fold_start_of(editor.row);
            if (fold_start >= 0) {
                editor.row = fold_start;
            }
        }
        int orig_indent = indent_width(editor, buffer.line(editor.row));
        str body = reg.lines.join("\n");
        List<str> parts = [];
        for (int i in 0 .. amount) {
            parts.push(body);
        }
        str text = parts.join("\n");
        int first_row = 0;
        if (directory > 0) {
            editor.change(MED_buffer.Pos(editor.row, buffer.line_size(editor.row)), MED_buffer.Pos(editor.row, buffer.line_size(editor.row)), "\n" + text);
            first_row = editor.row + 1;
        } else {
            editor.change(MED_buffer.Pos(editor.row, 0), MED_buffer.Pos(editor.row, 0), text + "\n");
            first_row = editor.row;
        }
        int total = reg.lines.size() * amount;
        int last_put = first_row + total - 1;
        if ((flags & PUT_FIXINDENT) != 0) {
            fix_put_indent(editor, first_row, last_put, orig_indent);
        }
        editor.override_change(MED_buffer.Pos(first_row, 0));
        int last_length = buffer.line_size(last_put);
        if (last_length > 0) {
            last_length = last_length - 1;
        }
        set_op_marks(editor, MED_buffer.Pos(first_row, 0), MED_buffer.Pos(last_put, last_length));
        if (is_cursor_end) {
            int after = first_row + total;
            if (after >= buffer.line_count()) {
                editor.row = buffer.line_count() - 1;
                editor.col = 0;
                editor.row = MED_num.smaller(after, buffer.line_count() - 1);
                editor.col = 0;
            } else {
                editor.row = after;
                editor.col = 0;
            }
        } else {
            editor.row = first_row;
            editor.col = first_nonblank_fix(buffer.line(first_row));
        }
        return true;
    }
    str line = buffer.line(editor.row);
    int spot = editor.col;
    if (directory > 0 && line.size() > 0) {
        spot = MED_text.next_col(line, editor.col);
    }
    if (line.size() == 0) {
        spot = 0;
    }
    str body = reg.lines.join("\n");
    List<str> parts = [];
    for (int i in 0 .. amount) {
        parts.push(body);
    }
    str text = parts.join("");
    MED_buffer.Pos start = MED_buffer.Pos(editor.row, spot);
    editor.change(start, start, text);
    MED_buffer.Pos end = MED_buffer.advance(start, text);
    if (text.size() > 0) {
        if (end.col == 0 && end.row > start.row) {
            // the text ended with a line break: `] is the start of the rest
            set_op_marks(editor, start, end);
        } else {
            set_op_marks(editor, start, dec_position(editor, end));
        }
    }
    if (reg.lines.size() > 1 || text.index_of("\n").is_some()) {
        if (is_cursor_end) {
            editor.row = end.row;
            editor.col = end.col;
        } else {
            editor.row = start.row;
            editor.col = start.col;
        }
    } else if (is_cursor_end) {
        editor.row = end.row;
        editor.col = end.col;
    } else if (text.size() == 0) {
        // Putting nothing leaves the cursor alone.
    } else {
        editor.row = end.row;
        editor.col = MED_text.previous_col(buffer.line(end.row), end.col);
    }
    return true;
}

// ------------------------------------------------------------ cursor helpers

bool is_position_before(MED_buffer.Pos position, MED_buffer.Pos position_value) {
    return position.row < position_value.row || (position.row == position_value.row && position.col < position_value.col);
}

// Make a motion's landing the cursor.
void apply_motion(MED_editor.Editor editor, MED_motion.Motion motion) {
    if (motion.is_jump) {
        pcmark(editor, MED_buffer.Pos(editor.row, editor.col));
    }
    editor.row = motion.row;
    editor.col = motion.col;
    editor.clamp();
    if (motion.want == -2) {
        editor.want_from_cursor();
    } else if (motion.want != -3) {
        editor.want = motion.want;
    }
}

const List<int> REG_ONE_MOTIONS = [37, 40, 41, 96, 47, 63, 110, 78, 123, 125, 42, 35];

// ---------------------------------------------------------------- operators

/// A text-object / motion range handed to the operator code.
type Range {
    bool is_ok = true;
    MED_buffer.Pos start = MED_buffer.Pos(0, 0);
    MED_buffer.Pos end = MED_buffer.Pos(0, 0);
    bool is_linewise = false;
    bool is_inclusive = false;
    bool is_no_adj = false;
}

Range object_range(MED_editor.Editor editor, List<int> keys, int count) {
    Range range = Range();
    if (keys.size() < 2) {
        range.is_ok = false;
        return range;
    }
    MED_buffer.Pos cursor = MED_buffer.Pos(editor.row, editor.col);
    MED_textobj.Sel sel = MED_textobj.select(editor.buffer, cursor, false, cursor, 0, keys[1], keys[0] == 97, count);
    if (!sel.is_ok) {
        if (sel.is_moved) {
            editor.row = sel.end.row;
            editor.col = sel.end.col;
            editor.clamp();
        }
        // nv_object() asks for the wanted column to follow the cursor either way
        editor.want_from_cursor();
        range.is_ok = false;
        return range;
    }
    range.start = sel.start;
    range.end = sel.end;
    range.is_linewise = sel.is_linewise;
    range.is_inclusive = sel.is_inclusive;
    if (sel.is_jump) {
        pcmark(editor, cursor);
    }
    return range;
}

// Vim's do_pending_operator for a normal-mode operator: find the range,
// then run the operator on it. Returns false when the command failed.
bool did_operate(MED_editor.Editor editor, str operator, str reg, int count, List<int> keys, bool is_doubled, int force) {
    Oap oap = Oap();
    oap.operator = operator;
    oap.reg = reg;
    oap.force = force;
    oap.old_want = editor.want;
    oap.cursor_row = editor.row;
    oap.cursor_col = editor.col;
    MED_buffer.Pos cursor = MED_buffer.Pos(editor.row, editor.col);
    MED_buffer.Pos start = copy_position(cursor);
    MED_buffer.Pos end = copy_position(cursor);
    bool is_linewise = false;
    bool is_inclusive = false;
    bool is_no_adj = false;
    int last = editor.buffer.line_count() - 1;
    if (is_doubled) {
        int total = count1(count);
        if (total > 1 && editor.row >= last) {
            return false;
        }
        int end_row = MED_num.smaller(editor.row + total - 1, last);
        if (total > 1 && editor.folds.size() > 0 && !editor.is_fold_off) {
            // nvim's nv_lineop moves with cursor_down: a closed fold counts as one line
            MED_motion.Motion down = move_vertical(editor, total - 1);
            if (!down.is_ok) {
                return false;
            }
            end_row = down.row;
        }
        end = MED_buffer.Pos(end_row, lineop_col(editor, operator, end_row, total > 1));
        is_linewise = true;
    } else if (keys[0] == 105 || keys[0] == 97) {
        Range range = object_range(editor, keys, count);
        if (!range.is_ok) {
            return false;
        }
        start = range.start;
        end = range.end;
        is_linewise = range.is_linewise;
        is_inclusive = range.is_inclusive;
        oap.is_object = true;
    } else if (is_gn_keys(keys)) {
        MED_search.Area area = MED_search.current_search(editor, count1(count), keys[1] == 110, false, 0, 0);
        if (!area.is_ok) {
            editor.message = area.error;
            return false;
        }
        pcmark(editor, copy_position(cursor));
        start = MED_buffer.Pos(area.arow, area.acol);
        end = MED_buffer.Pos(area.crow, area.ccol);
        is_inclusive = true;
        if (is_position_before(end, start)) {
            MED_buffer.Pos swap = start;
            start = end;
            end = swap;
        }
        if (end.col >= editor.buffer.line_size(end.row)) {
            // the area ends on the line break: it is part of the text
            is_inclusive = false;
            if (end.row < last) {
                end = MED_buffer.Pos(end.row + 1, 0);
            }
        }
        is_no_adj = true;
        // the area is Visual: '< and '> remember it
        editor.vrow = start.row;
        editor.vcol = start.col;
        editor.row = end.row;
        editor.col = end.col;
        save_visual(editor, 118);
        editor.row = cursor.row;
        editor.col = cursor.col;
    } else {
        MED_motion.Motion motion = run_motion(editor, keys, count, operator);
        if (!motion.is_ok) {
            if (motion.is_moved) {
                editor.row = motion.row;
                editor.col = motion.col;
                editor.clamp();
                editor.want_from_cursor();
            }
            return false;
        }
        end = MED_buffer.Pos(motion.row, motion.col);
        is_linewise = motion.is_linewise;
        is_inclusive = motion.is_inclusive;
        is_no_adj = motion.is_no_adj;
        if (motion.want >= 0 || motion.want == -1) {
            // `|` and `$` set the wanted column outright; j/k leave it stale
            editor.want = motion.want;
            oap.is_object = true;
        } else if (motion.want == -2) {
            oap.is_object = true;
        }
        if (motion.is_jump) {
            pcmark(editor, copy_position(cursor));
        }
        if (REG_ONE_MOTIONS.contains(keys[0])) {
            oap.is_reg_one = true;
        }
        if (keys[0] == 103 && keys.size() > 1 && (keys[1] == 39 || keys[1] == 42 || keys[1] == 35)) {
            oap.is_reg_one = true;
        }
    }
    if (force == 118) {
        if (is_linewise) {
            is_inclusive = false;
        } else {
            is_inclusive = !is_inclusive;
        }
        is_linewise = false;
    } else if (force == 86) {
        is_linewise = true;
    }
    bool is_forward = is_position_before(start, end);
    if (is_position_before(end, start)) {
        MED_buffer.Pos swap = start;
        start = end;
        end = swap;
    }
    if (editor.folds.size() > 0 && !editor.is_fold_off) {
        // closed folds are taken whole
        if (is_forward) {
            int fold_start = editor.fold_start_of(start.row);
            if (fold_start >= 0) {
                start = MED_buffer.Pos(fold_start, 0);
            }
            if (end.col > 0 || is_inclusive || is_linewise) {
                int fold_end = editor.fold_end_of(end.row);
                if (fold_end >= 0) {
                    end = MED_buffer.Pos(fold_end, editor.buffer.line_size(fold_end));
                }
            }
        } else if (is_linewise) {
            int fold_start = editor.fold_start_of(start.row);
            if (fold_start >= 0) {
                start = MED_buffer.Pos(fold_start, 0);
            }
            int fold_end = editor.fold_end_of(end.row);
            if (fold_end >= 0) {
                end = MED_buffer.Pos(fold_end, editor.buffer.line_size(fold_end));
            }
        }
    }
    oap.start = start;
    oap.end = end;
    oap.is_linewise = is_linewise;
    oap.is_inclusive = is_inclusive;
    oap.line_count = end.row - start.row + 1;
    if (!is_linewise && !is_inclusive && !is_no_adj && end.col == 0 && oap.line_count > 1) {
        oap.line_count = oap.line_count - 1;
        oap.is_end_adjusted = true;
        end = MED_buffer.Pos(end.row - 1, 0);
        if (is_in_indent(editor.buffer.line(start.row), start.col)) {
            oap.is_linewise = true;
        } else {
            int size = editor.buffer.line_size(end.row);
            end.col = size;
            if (size > 0) {
                end.col = MED_text.last_col(editor.buffer.line(end.row));
                oap.is_inclusive = true;
            }
        }
        oap.end = end;
    }
    if (!oap.is_linewise) {
        bool is_at_nul = start.eq(end) && editor.buffer.line_size(start.row) <= start.col;
        oap.is_empty = start.eq(end) && (!oap.is_inclusive || (operator == "y" && is_at_nul));
    }
    editor.row = start.row;
    editor.col = start.col;
    return did_run_op(editor, oap);
}

// ------------------------------------------------------------------ comment

// `gc`: toggle line comments. This follows Neovim's vim._comment: the lines
// are commented unless every non-blank line already is; the comment leader
// goes at the smallest indent; blank lines get the bare, trimmed leader.

bool is_space_byte(int value) {
    return value == 32 || (value >= 9 && value <= 13);
}

int leading_space(str line) {
    int offset = 0;
    while (offset < line.size() && is_space_byte(line.byte_at(offset))) {
        offset = offset + 1;
    }
    return offset;
}

str strip_right(str text) {
    int stop = text.size();
    while (stop > 0 && is_space_byte(text.byte_at(stop - 1))) {
        stop = stop - 1;
    }
    return text.substr(0, stop);
}

str strip_both(str text) {
    str right = strip_right(text);
    return right.substr(leading_space(right), right.size());
}

bool is_blank_line(str line) {
    return leading_space(line) == line.size();
}

// `^%s-LEFT.*RIGHT%s-$` with the trimmed parts.
bool is_comment_line(str line, str left, str right) {
    int offset = leading_space(line);
    str after = line.substr(offset, line.size());
    if (!after.starts_with(left)) {
        return false;
    }
    return strip_right(after.substr(left.size(), after.size())).ends_with(right);
}

type Uncommented {
    bool is_ok = false;
    str indent = "";
    str body = "";
    str trail = "";
}

// `^(%s*)LEFT(.*)RIGHT(%s-)$`
Uncommented match_comment(str line, str left, str right) {
    Uncommented found = Uncommented();
    int indent_end = leading_space(line);
    while (indent_end >= 0) {
        str after = line.substr(indent_end, line.size());
        if (after.starts_with(left)) {
            str rest = after.substr(left.size(), after.size());
            int offset = rest.size() - right.size();
            while (offset >= 0) {
                if (rest.substr(offset, offset + right.size()) == right && is_blank_line(rest.substr(offset + right.size(), rest.size()))) {
                    found.is_ok = true;
                    found.indent = line.substr(0, indent_end);
                    found.body = rest.substr(0, offset);
                    found.trail = rest.substr(offset + right.size(), rest.size());
                    return found;
                }
                offset = offset - 1;
            }
        }
        indent_end = indent_end - 1;
    }
    return found;
}

str uncomment_line(str line, str left, str right) {
    Uncommented found = match_comment(line, left, right);
    if (!found.is_ok) {
        found = match_comment(line, strip_both(left), strip_both(right));
    }
    if (!found.is_ok) {
        return line;
    }
    if (is_blank_line(found.body)) {
        return found.body;
    }
    return found.indent + found.body + found.trail;
}

// The rows first..last toggled; false when 'commentstring' cannot be used.
bool did_toggle_comment(MED_editor.Editor editor, int first, int last) {
    if (!editor.is_option_on("comment", true)) {
        return false;
    }
    str spec = editor.commentstring;
    if (spec == "") {
        editor.message = "Option 'commentstring' is empty.";
        return true;
    }
    int offset = spec.index_of("%s").or(-1);
    if (offset < 0) {
        editor.message = "E5108: Lua: \"" + spec + "\" is not a valid 'commentstring'.";
        return false;
    }
    str left = spec.substr(0, offset);
    str right = spec.substr(offset + 2, spec.size());
    str left_trimmed = strip_both(left);
    str right_trimmed = strip_both(right);
    bool is_commented = true;
    int min_indent = -1;
    str indent = "";
    for (int row in first .. last + 1) {
        str line = editor.buffer.line(row);
        int width = leading_space(line);
        if (width < line.size()) {
            if (min_indent < 0 || width < min_indent) {
                min_indent = width;
                indent = line.substr(0, width);
            }
            if (is_commented) {
                is_commented = is_comment_line(line, left_trimmed, right_trimmed);
            }
        }
    }
    bool is_changed = false;
    for (int row in first .. last + 1) {
        str line = editor.buffer.line(row);
        str made = line;
        if (is_commented) {
            made = uncomment_line(line, left, right);
        } else if (is_blank_line(line)) {
            made = indent + left_trimmed + right_trimmed;
        } else {
            made = indent + left + line.substr(indent.size(), line.size()) + right;
        }
        if (made != line) {
            editor.change(MED_buffer.Pos(row, 0), MED_buffer.Pos(row, line.size()), made);
            is_changed = true;
        }
    }
    if (!is_changed) {
        touch(editor);
    }
    return true;
}

bool did_op_comment(MED_editor.Editor editor, Oap oap) {
    bool is_ok = did_toggle_comment(editor, oap.start.row, oap.end.row);
    set_op_marks(editor, MED_buffer.Pos(oap.start.row, 0), MED_buffer.Pos(oap.end.row, 0));
    editor.row = oap.start.row;
    editor.col = oap.start.col;
    editor.clamp();
    editor.want_from_cursor();
    return is_ok;
}

// The operator itself, with the cursor already on the start of the range.
bool did_run_op(MED_editor.Editor editor, Oap oap) {
    str operator = oap.operator;
    if (operator == "d") {
        did_op_delete(editor, oap);
        if (oap.is_linewise && editor.is_global_busy) {
            editor.want_from_cursor();
        } else {
            // Vim sets w_set_curswant: the wanted column is recomputed lazily
            editor.needs_stale = true;
        }
    } else if (operator == "c") {
        // Vim skips the delete in an empty buffer (ML_EMPTY)
        if (!editor.buffer.is_empty) {
            did_op_delete(editor, oap);
        }
        start_insert(editor, 99, 1, false);
        editor.clamp();
        editor.ins_start = MED_buffer.Pos(editor.row, editor.col);
        editor.ins_textlen = MED_text.line_width(editor.buffer.line(editor.row), editor.tab);
        editor.ins_mark = editor.ins_start;
        return true;
    } else if (operator == "y") {
        op_yank(editor, oap);
        if (oap.is_linewise) {
            editor.row = oap.start.row;
            editor.col = oap.start.col;
        }
        editor.clamp();
        if (oap.is_object) {
            editor.want_from_cursor();
        }
    } else if (operator == "<" || operator == ">") {
        op_shift(editor, oap);
        editor.want_from_cursor();
    } else if (operator == "=") {
        op_reindent(editor, oap);
        editor.want_from_cursor();
    } else if (operator == "g~" || operator == "gu" || operator == "gU" || operator == "g?") {
        op_case(editor, oap);
        editor.clamp();
        editor.want_from_cursor();
    } else if (operator == "gq" || operator == "gw") {
        op_format(editor, oap, operator == "gw");
        editor.want_from_cursor();
    } else if (operator == "zf") {
        MED_fold.create(editor, oap.start.row, oap.end.row);
        editor.row = oap.start.row;
        editor.col = oap.start.col;
        editor.clamp();
        editor.want_from_cursor();
    } else if (operator == "!") {
        // op_colon: the command line is typed for the user, `:.,.+N!`
        str range = ".";
        if (oap.end.row != oap.start.row) {
            if (oap.end.row == editor.buffer.line_count() - 1) {
                range = ".,$";
            } else {
                range = ".,.+" + (oap.line_count - 1).to_str();
            }
        }
        enter_cmdline(editor, 58, []);
        set_cmdline(editor, range + "!");
        return true;
    } else if (operator == "gc") {
        return did_op_comment(editor, oap);
    } else if (operator == "ys" || operator == "yS") {
        return did_op_surround(editor, oap);
    } else {
        return false;
    }
    editor.clamp();
    return true;
}

// ----------------------------------------------------------------- surround

// `ys` / `yS`: the motion's text is remembered through the `[` `]` marks and
// the surroundings are typed next (see `sur_feed`).
bool did_op_surround(MED_editor.Editor editor, Oap oap) {
    if (!editor.is_option_on("surround", true)) {
        return false;
    }
    if (oap.is_linewise) {
        set_op_marks(editor, MED_buffer.Pos(oap.start.row, 0), MED_buffer.Pos(oap.end.row, MAXCOL));
        editor.sur_kind = "line";
    } else {
        MED_buffer.Pos last = oap.end;
        if (!oap.is_inclusive) {
            // decl(): back one character, skipping the line break
            last = dec_position(editor, oap.end);
            if (last.row < oap.end.row && last.col > 0) {
                last = MED_buffer.Pos(last.row, MED_text.previous_col(editor.buffer.line(last.row), last.col));
            }
        }
        set_op_marks(editor, oap.start, last);
        editor.sur_kind = "char";
    }
    editor.sur_command = oap.operator;
    editor.sur_stage = 1;
    editor.sur_keys = [];
    editor.sur_old = "";
    editor.sur_new = "";
    editor.sur_input = "";
    editor.row = oap.start.row;
    editor.col = oap.start.col;
    return true;
}

// The surround command has all its input: it runs from the ex queue.
void sur_finish(MED_editor.Editor editor) {
    editor.sur_stage = 0;
    if (!editor.is_in_dot) {
        editor.dot_tail = editor.sur_keys;
    }
    editor.ex_queue.push("\x04surround");
}

void sur_cancel(MED_editor.Editor editor) {
    editor.sur_stage = 0;
    editor.sur_command = "";
    editor.is_failed = true;
}

// What a replacement character asks for next: 1 a tag, 2 a function name, 3 a
// LaTeX environment, 0 nothing.
int sur_prompt_kind(str symbol) {
    str base = symbol;
    if (base.size() == 2 && base.byte_at(0) == 32) {
        base = base.substr(1, 2);
    }
    if (base == "t" || base == "T" || base == "<" || base == "\x14") {
        return 1;
    }
    if (base == "f" || base == "F" || base == "\x06") {
        return 2;
    }
    if (base == "l" || base == "\\") {
        return 3;
    }
    return 0;
}

// One key of the surround command being typed.
void sur_feed(MED_editor.Editor editor, int key) {
    int stage = editor.sur_stage;
    if (stage == 4 || stage == 5) {
        // a target: digits, then a character (a space takes the next one too)
        if (key == 27 || key == 3 || key == 0) {
            sur_cancel(editor);
            return;
        }
        editor.sur_keys.push(key);
        if (stage == 4 && key >= 48 && key <= 57) {
            editor.sur_old = editor.sur_old + str.from_chars([key]);
            return;
        }
        if (stage == 4 && key == 32) {
            editor.sur_old = editor.sur_old + " ";
            editor.sur_stage = 5;
            return;
        }
        editor.sur_old = editor.sur_old + str.from_chars([key]);
        if (editor.sur_command == "ds") {
            sur_finish(editor);
        } else {
            editor.sur_stage = 1;
        }
        return;
    }
    if (stage == 1 || stage == 2) {
        if (key == 27 || key == 3) {
            sur_cancel(editor);
            return;
        }
        editor.sur_keys.push(key);
        if (stage == 1 && key == 32) {
            editor.sur_new = " ";
            editor.sur_stage = 2;
            return;
        }
        editor.sur_new = editor.sur_new + str.from_chars([key]);
        int kind = sur_prompt_kind(editor.sur_new);
        if (kind == 0) {
            sur_finish(editor);
            return;
        }
        editor.sur_input = "";
        if (editor.sur_command == "cs" || editor.sur_command == "cS") {
            // the prompt only comes when there is something to change: take
            // the surroundings out first (`\x04surround-begin`)
            editor.sur_stage = 7;
            editor.ex_queue.push("\x04surround-begin");
            return;
        }
        if (kind == 1 && (editor.sur_new == "T" || editor.sur_new == " T")) {
            // 'T' offers the tag that was deleted last
            str tag = editor.sur_last_deleted;
            int open = tag.index_of("<").or(-1);
            int tag_end = tag.index_of(">").or(-1);
            if (open >= 0 && tag_end > open) {
                editor.sur_input = tag.substr(open + 1, tag_end);
            }
        }
        editor.sur_stage = 3;
        return;
    }
    if (stage == 3) {
        if (key == 27 || key == 3) {
            editor.sur_keys.push(key);
            editor.sur_input = "";
            sur_finish(editor);
            return;
        }
        editor.sur_keys.push(key);
        if (key == 13 || key == 10) {
            sur_finish(editor);
            return;
        }
        if (key == 62 && sur_prompt_kind(editor.sur_new) == 1) {
            editor.sur_input = editor.sur_input + ">";
            sur_finish(editor);
            return;
        }
        if (key == 127 || key == 8) {
            if (editor.sur_input.size() > 0) {
                editor.sur_input = editor.sur_input.substr(0, editor.sur_input.size() - 1);
            }
            return;
        }
        if (key >= 32 && key < 63232) {
            editor.sur_input = editor.sur_input + str.from_chars([key]);
        }
        return;
    }
}

// `ds` / `cs` / `cS` after the `d` or `c` was typed: `pending` holds a count
// and register prefix, then the operator key.
bool did_begin_surround_command(MED_editor.Editor editor, int key) {
    if (!editor.is_option_on("surround", true) || editor.mode != MED_editor.NORMAL) {
        return false;
    }
    int size = editor.pending.size();
    if (size == 0 || (key != 115 && key != 83)) {
        return false;
    }
    int last = editor.pending[size - 1];
    if (last != 100 && last != 99) {
        return false;
    }
    if (key == 83 && last == 100) {
        return false;
    }
    int count = 0;
    int index = 0;
    while (index < size - 1) {
        int code = editor.pending[index];
        if (code == 34 && index + 1 < size - 1) {
            index = index + 2;
        } else if (code >= 48 && code <= 57) {
            count = count * 10 + (code - 48);
            index = index + 1;
        } else {
            return false;
        }
    }
    str command = "ds";
    if (last == 99) {
        command = "cs";
        if (key == 83) {
            command = "cS";
        }
    }
    MED_parse.Parsed parsed = MED_parse.Parsed();
    parsed.count = count;
    parsed.body = [last, key];
    record_dot(editor, parsed);
    editor.pending = [];
    editor.sur_command = command;
    editor.sur_stage = 4;
    editor.sur_keys = [];
    editor.sur_old = "";
    editor.sur_new = "";
    editor.sur_input = "";
    editor.sur_count = count1(count);
    return true;
}

// Visual `S` and `gS`.
void visual_surround(MED_editor.Editor editor, MED_parse.Parsed parsed, bool is_g) {
    if (!editor.is_option_on("surround", true)) {
        editor.is_failed = true;
        return;
    }
    int kind = editor.vkind;
    Oap area = visual_oap(editor, "y", parsed.reg);
    List<int> body = [83];
    if (is_g) {
        body = [103, 83];
    }
    record_visual_dot(editor, area, kind, parsed.count, body);
    leave_visual(editor);
    editor.sur_command = "vS";
    if (is_g) {
        editor.sur_command = "vgS";
    }
    editor.sur_kind = "v";
    if (kind == 86) {
        editor.sur_kind = "V";
    } else if (kind == 22) {
        editor.sur_kind = "b";
    }
    editor.sur_stage = 1;
    editor.sur_keys = [];
    editor.sur_old = "";
    editor.sur_new = "";
    editor.sur_input = "";
}

// -------------------------------------------------------------- insert mode

// Whitespace for an indent of `width` columns.
// The indent of the line a split creates: the line's own, cut short when the
// cursor is inside the indent (Vim's open_line).
int split_indent(MED_editor.Editor editor, str line, int col) {
    int width = indent_width(editor, line);
    int vcol = MED_text.display_col(line, col, editor.tab);
    if (vcol < width) {
        return vcol;
    }
    return width;
}

// Whether 'smartindent' is on (and no C indenting is).
bool is_smartindent(MED_editor.Editor editor) {
    return editor.is_option_on("smartindent", false) && !editor.is_option_on("cindent", false);
}

// Whether `text` starts with one of 'cinwords' (if, else, while, do, for, switch).
bool is_starting_with_cinword(MED_editor.Editor editor, str text) {
    str words = "if,else,while,do,for,switch";
    match (editor.opts.get("cinwords")) {
        case Some(str value): {
            words = value;
        }
        case None: {
        }
    }
    int start = MED_text.first_nonblank(text);
    for (str word in words.split(",")) {
        if (word.size() == 0 || !text.substr(start, text.size()).starts_with(word)) {
            continue;
        }
        int after = start + word.size();
        if (after >= text.size()) {
            return true;
        }
        int next = text.byte_at(after);
        bool is_word_char = (next >= 48 && next <= 57) || (next >= 65 && next <= 90) || (next >= 97 && next <= 122) || next == 95;
        if (!is_word_char) {
            return true;
        }
    }
    return false;
}

// The row of the `(` that matches the `)` at (row, col), or -1.
int matching_open_row(MED_editor.Editor editor, int row, int col, int open_char, int close_char) {
    int depth = 1;
    int scan_row = row;
    int scan_col = col - 1;
    while (scan_row >= 0) {
        str line = editor.buffer.line(scan_row);
        if (scan_col >= line.size()) {
            scan_col = line.size() - 1;
        }
        while (scan_col >= 0) {
            int code_point = line.byte_at(scan_col);
            if (code_point == close_char) {
                depth = depth + 1;
            } else if (code_point == open_char) {
                depth = depth - 1;
                if (depth == 0) {
                    return scan_row;
                }
            }
            scan_col = scan_col - 1;
        }
        scan_row = scan_row - 1;
        if (scan_row >= 0) {
            scan_col = editor.buffer.line_size(scan_row) - 1;
        }
    }
    return -1;
}

// 'smartindent' for a line opened after the text `before` (what precedes the
// cursor): the indent width it gets, from `base` (the autoindent). Sets
// `did_si` when a level was added.
int smart_width(MED_editor.Editor editor, str before, int base, int row, str after) {
    editor.did_si = false;
    editor.can_si = false;
    editor.is_no_si = false;
    editor.can_si_back = false;
    if (!is_smartindent(editor)) {
        return base;
    }
    editor.can_si = true;
    int last = before.size() - 1;
    while (last > 0 && is_white_byte(before.byte_at(last))) {
        last = last - 1;
    }
    if (last < 0 || before.size() == 0) {
        return base;
    }
    int last_char = before.byte_at(last);
    int width = base;
    int look = last;
    if (last_char == 123 || last_char == 59) {
        if (look > 0) {
            look = look - 1;
        }
        while (look > 0 && is_white_byte(before.byte_at(look))) {
            look = look - 1;
        }
    }
    if (before.byte_at(look) == 41) {
        int open_row = matching_open_row(editor, row, look, 40, 41);
        if (open_row >= 0) {
            width = indent_width(editor, editor.buffer.line(open_row));
        }
    }
    bool is_more = false;
    if (last_char == 123) {
        is_more = true;
        editor.is_no_si = true;
    } else if (last_char != 59 && last_char != 125 && is_starting_with_cinword(editor, before)) {
        is_more = true;
    }
    if (is_more) {
        int step = editor.shift_size();
        if (editor.is_shiftround && step > 0) {
            width = width - width % step;
        }
        width = width + step;
        editor.did_si = true;
    }
    return width;
}

str make_indent(MED_editor.Editor editor, int width) {
    if (editor.is_expandtab) {
        return " ".repeat(width);
    }
    return "\t".repeat(width / editor.tab) + " ".repeat(width % editor.tab);
}

bool is_white_byte(int right) {
    return right == 32 || right == 9;
}

void start_insert(MED_editor.Editor editor, int cmd, int count, bool is_replace) {
    if (editor.folds.size() > 0) {
        // typing in a closed fold opens it
        MED_fold.open_at(editor, editor.row);
    }
    editor.mode = MED_editor.INSERT;
    if (is_replace) {
        editor.mode = MED_editor.REPLACE;
    }
    editor.ins_cmd = cmd;
    editor.is_completing = false;
    editor.is_ins_moved = false;
    editor.is_virtual = false;
    editor.ins_count = count1(count);
    editor.ins_keys = [];
    editor.ins_text = "";
    editor.did_space = false;
    editor.ins_previous = 0;
    editor.ins_start = MED_buffer.Pos(editor.row, editor.col);
    editor.ins_textlen = MED_text.line_width(editor.buffer.line(editor.row), editor.tab);
    editor.ins_mark = editor.ins_start;
    editor.replaced = [];
    editor.ins_wait = 0;
    editor.is_ins_arrow = false;
    editor.restart_edit = 0;
    editor.is_ins_restart = false;
    editor.is_ins_next_set = false;
    editor.is_ins_hold = false;
    editor.is_ins_dirty = false;
    editor.vkind = 0;
    if (count1(count) == 1) {
        editor.want_from_cursor();
    }
}

// Type one printable character (or a literal control character).
// Whether 'formatoptions' (default "tcqj") has the flag `flag`.
bool has_format_flag(MED_editor.Editor editor, str flag) {
    str flags = "tcqj";
    match (editor.opts.get("formatoptions")) {
        case Some(str value): {
            flags = value;
        }
        case None: {
        }
    }
    return flags.contains(flag);
}

// Vim's internal_format for one typed non-blank character: while the cursor
// column plus the character is past 'textwidth', break the line at the last
// blank run that starts within the width (or the first one), and carry what
// follows to a new line with the same indent ('autoindent').
void ins_auto_wrap(MED_editor.Editor editor, int code_point) {
    int width = editor.textwidth;
    str typed = str.from_chars([code_point]);
    bool is_comments = has_format_flag(editor, "c");
    bool is_text = has_format_flag(editor, "t");
    bool is_no_leader = false;
    int guard = 0;
    while (guard < 50) {
        guard = guard + 1;
        if (editor.row == editor.ins_start.row && editor.ins_textlen > width && has_format_flag(editor, "l")) {
            // 'l': a line already longer than 'textwidth' when the insert began stays
            return;
        }
        str line = editor.buffer.line(editor.row);
        int cursor = editor.col;
        int vcol = MED_text.display_col(line, cursor, editor.tab);
        int next_vcol = vcol + MED_text.cell_width(typed, 0, vcol, editor.tab);
        if (next_vcol <= width) {
            return;
        }
        Leader lead = Leader();
        if (is_comments && !is_no_leader) {
            lead = comment_leader(editor, line);
        }
        if (lead.length == 0) {
            is_no_leader = true;
        }
        if (lead.length == 0 && !is_text) {
            return;
        }
        int wantcol = MED_motion.col_for_want(line, width, editor.tab, true);
        int found = 0;
        int end_found = 0;
        int scan = cursor;
        while (true) {
            if (scan < cursor && is_white_byte(line.byte_at(scan))) {
                int end_col = scan;
                while (scan > 0 && is_white_byte(line.byte_at(scan))) {
                    scan = MED_text.previous_col(line, scan);
                }
                if (scan == 0 && is_white_byte(line.byte_at(scan))) {
                    break;
                }
                if (scan < lead.length) {
                    break;
                }
                scan = MED_text.next_col(line, scan);
                found = scan;
                end_found = end_col + 1;
                if (found <= wantcol) {
                    break;
                }
            }
            if (scan == 0) {
                break;
            }
            scan = MED_text.previous_col(line, scan);
        }
        if (found == 0) {
            return;
        }
        str indent = "";
        if (lead.length > 0 && !is_no_leader) {
            indent = line.substr(0, lead.length);
            if (lead.is_first) {
                indent = " ".repeat(MED_text.line_width(indent, editor.tab));
            }
        } else if (editor.is_autoindent) {
            indent = line.substr(0, MED_text.first_nonblank(line));
        }
        if (editor.is_autoindent) {
            // the blanks the break skips go on past the cursor: what 'autoindent' leaves
            // of a space under the cursor is deleted with them (with 'noautoindent' Vim
            // protects it)
            while (end_found < line.size() && is_white_byte(line.byte_at(end_found))) {
                end_found = end_found + 1;
            }
        }
        editor.change(MED_buffer.Pos(editor.row, found), MED_buffer.Pos(editor.row, end_found), "\n" + indent);
        editor.row = editor.row + 1;
        editor.col = indent.size() + MED_num.larger(cursor - end_found, 0);
    }
}

// Vim's ins_try_si: smart indenting when `{`, `}` or `#` is typed.
void si_before_char(MED_editor.Editor editor, int code_point) {
    str line = editor.buffer.line(editor.row);
    bool is_at_indent = editor.col > 0 && is_in_indent_before(line, editor.col);
    bool is_back = code_point == 123 && editor.can_si_back && editor.has_si_extra && editor.col > 0;
    if (code_point == 123 && ((editor.did_si && !editor.is_no_si) || is_back) && editor.col > 0) {
        // `{` after a line that asked for an extra level: back one level
        int width = indent_width(editor, line);
        int step = editor.shift_size();
        if (width >= step) {
            str rest = line.substr(editor.col, line.size());
            int cursor_at = editor.col;
            str fresh = make_indent(editor, width - step);
            editor.change(MED_buffer.Pos(editor.row, 0), MED_buffer.Pos(editor.row, cursor_at), fresh);
            editor.col = fresh.size();
        }
    } else if (code_point == 125 && is_at_indent && editor.can_si) {
        int open_row = matching_open_row(editor, editor.row, editor.col, 123, 125);
        if (open_row >= 0) {
            str open_line = editor.buffer.line(open_row);
            int brace = open_line.index_of("{").or(-1);
            int width = indent_width(editor, open_line);
            if (brace > 0) {
                int look = brace - 1;
                while (look > 0 && is_white_byte(open_line.byte_at(look))) {
                    look = look - 1;
                }
                if (open_line.byte_at(look) == 41) {
                    int paren_row = matching_open_row(editor, open_row, look, 40, 41);
                    if (paren_row >= 0) {
                        width = indent_width(editor, editor.buffer.line(paren_row));
                    }
                }
            }
            str fresh = make_indent(editor, width);
            editor.change(MED_buffer.Pos(editor.row, 0), MED_buffer.Pos(editor.row, editor.col), fresh);
            editor.col = fresh.size();
        } else {
            // no `{` to line up with: one level back
            int width = indent_width(editor, line) - editor.shift_size();
            if (width < 0) {
                width = 0;
            }
            str fresh = make_indent(editor, width);
            editor.change(MED_buffer.Pos(editor.row, 0), MED_buffer.Pos(editor.row, editor.col), fresh);
            editor.col = fresh.size();
        }
    } else if (code_point == 35 && is_at_indent && editor.can_si) {
        // a `#` goes to column 0 and the next line comes back to this indent
        editor.si_hash_indent = indent_width(editor, line);
        editor.change(MED_buffer.Pos(editor.row, 0), MED_buffer.Pos(editor.row, editor.col), "");
        editor.col = 0;
    }
}

void ins_char(MED_editor.Editor editor, int code_point) {
    if (is_smartindent(editor) && editor.mode == MED_editor.INSERT) {
        si_before_char(editor, code_point);
        editor.did_si = false;
        editor.can_si = false;
        editor.is_no_si = false;
        editor.can_si_back = false;
        editor.has_si_extra = false;
    }
    if ((editor.mode == MED_editor.INSERT || (editor.mode == MED_editor.REPLACE && editor.col >= editor.buffer.line_size(editor.row))) && editor.textwidth > 0 && code_point != 32 && code_point != 9 && (has_format_flag(editor, "t") || has_format_flag(editor, "c"))) {
        ins_auto_wrap(editor, code_point);
    }
    str text = str.from_chars([code_point]);
    str line = editor.buffer.line(editor.row);
    MED_buffer.Pos position = MED_buffer.Pos(editor.row, editor.col);
    if (editor.mode == MED_editor.REPLACE && editor.is_virtual) {
        // Virtual Replace: the new character covers screen cells; whole
        // characters under them go (a TAB that reaches further stays)
        int vcol = MED_text.display_col(line, editor.col, editor.tab);
        int width = MED_text.cell_width(text, 0, vcol, editor.tab);
        if (code_point == 9) {
            width = editor.tab - (vcol % editor.tab);
        }
        int new_vcol = vcol + width;
        int spot = vcol;
        int stop = editor.col;
        int extra = 0;
        while (stop < line.size() && spot < new_vcol) {
            spot = spot + MED_text.cell_width(line, stop, spot, editor.tab);
            if (spot > new_vcol && line.byte_at(stop) == 9) {
                break;
            }
            stop = MED_text.next_col(line, stop);
            if (spot > new_vcol) {
                extra = spot - new_vcol;
            }
        }
        editor.replaced.push(line.substr(editor.col, stop));
        editor.change(position, MED_buffer.Pos(editor.row, stop), text + " ".repeat(extra));
        editor.col = editor.col + text.size();
        editor.did_ai = false;
        editor.ins_text = editor.ins_text + text;
        return;
    }
    if (editor.mode == MED_editor.REPLACE && editor.col < line.size()) {
        int next = MED_text.next_col(line, editor.col);
        editor.replaced.push(line.substr(editor.col, next));
        editor.change(position, MED_buffer.Pos(editor.row, next), text);
    } else {
        if (editor.mode == MED_editor.REPLACE) {
            editor.replaced.push("");
        }
        editor.change(position, position, text);
    }
    editor.col = editor.col + text.size();
    editor.did_ai = false;
    editor.ins_text = editor.ins_text + text;
}

// <CR> in insert mode: Vim's open_line for the cursor's line.
void ins_cr(MED_editor.Editor editor) {
    // a typed line break forgets the "U" line and nothing typed after it is saved
    editor.uline_row = -1;
    editor.is_uline_off = true;
    str line = editor.buffer.line(editor.row);
    int cut = editor.col;
    int skip = editor.col;
    str indent = "";
    bool is_trunc = false;
    if (editor.is_autoindent || is_smartindent(editor)) {
        int base_width = split_indent(editor, line, editor.col);
        if (editor.si_hash_indent > 0) {
            // a `#` line was put at column 0: the next line goes back to its indent
            base_width = editor.si_hash_indent;
            editor.si_hash_indent = 0;
        }
        base_width = smart_width(editor, line.substr(0, editor.col), base_width, editor.row, line.substr(editor.col, line.size()));
        indent = make_indent(editor, base_width);
        if (editor.did_ai) {
            is_trunc = true;
        }
        while (editor.is_autoindent && skip < line.size() && is_white_byte(line.byte_at(skip))) {
            skip = skip + 1;
        }
        if (is_trunc) {
            while (cut > 0 && is_white_byte(line.byte_at(cut - 1))) {
                cut = cut - 1;
            }
        }
    }
    if (editor.mode == MED_editor.REPLACE && editor.is_virtual) {
        // Virtual Replace: the rest of the line goes and replacing goes on
        // at the start of the next line
        int size = line.size();
        editor.replaced.push("\x01" + line.substr(cut, size));
        editor.change(MED_buffer.Pos(editor.row, cut), MED_buffer.Pos(editor.row, size), "");
        if (editor.row + 1 >= editor.buffer.line_count()) {
            editor.change(MED_buffer.Pos(editor.row, cut), MED_buffer.Pos(editor.row, cut), "\n");
        }
        editor.row = editor.row + 1;
        editor.col = 0;
        str typed = editor.ins_text;
        for (int code_point in indent.chars()) {
            ins_char(editor, code_point);
        }
        editor.did_ai = editor.is_autoindent;
        editor.ins_text = typed + "\n";
        return;
    }
    editor.change(MED_buffer.Pos(editor.row, cut), MED_buffer.Pos(editor.row, skip), "\n" + indent);
    editor.row = editor.row + 1;
    editor.col = indent.size();
    editor.did_ai = editor.is_autoindent || is_smartindent(editor);
    editor.ins_text = editor.ins_text + "\n";
    if (editor.mode == MED_editor.REPLACE) {
        editor.replaced.push("\n");
    }
}

// Whether a code point is a "word" character for CTRL-W in insert mode.
bool is_wordc(int code_point, List<int> keywords) {
    return MED_text.class_in(code_point, keywords) >= 2;
}

bool is_space_cp(int code_point) {
    return code_point == 32 || code_point == 9;
}

// CTRL-H / <BS> (mode 0), CTRL-W (1) and CTRL-U (2).
// Whether everything before `col` is blank (Vim's inindent).
bool is_in_indent_before(str line, int col) {
    for (int i in 0 .. col) {
        if (!is_white_byte(line.byte_at(i))) {
            return false;
        }
    }
    return col > 0;
}

bool did_ins_bs(MED_editor.Editor editor, int mode) {
    if (editor.row == 0 && editor.col == 0) {
        return false;
    }
    if (editor.col == 0 && editor.mode == MED_editor.REPLACE && editor.row <= editor.ins_start.row) {
        // Replace mode on the line the replacing started on: only move
        int back = editor.buffer.line_size(editor.row - 1);
        if (editor.ins_start.row == editor.row) {
            editor.ins_start = MED_buffer.Pos(editor.row - 1, back);
        }
        editor.row = editor.row - 1;
        editor.col = back;
        return true;
    }
    if (editor.col == 0 && editor.mode == MED_editor.REPLACE && editor.is_virtual && editor.replaced.size() > 0) {
        str marker = editor.replaced.pop();
        int back = editor.buffer.line_size(editor.row - 1);
        if (editor.row >= editor.virtual_lines) {
            editor.change(MED_buffer.Pos(editor.row - 1, back), MED_buffer.Pos(editor.row, editor.buffer.line_size(editor.row)), "");
        }
        editor.row = editor.row - 1;
        editor.col = back;
        if (marker.starts_with("\x01")) {
            MED_buffer.Pos here = MED_buffer.Pos(editor.row, back);
            editor.change(here, here, marker.substr(1, marker.size()));
        }
        return true;
    }
    if (editor.col == 0) {
        int size = editor.buffer.line_size(editor.row - 1);
        editor.change(MED_buffer.Pos(editor.row - 1, size), MED_buffer.Pos(editor.row, 0), "");
        if (editor.ins_start.row == editor.row) {
            editor.ins_start = MED_buffer.Pos(editor.row - 1, size + editor.ins_start.col);
        }
        editor.row = editor.row - 1;
        editor.col = size;
        if (editor.mode == MED_editor.REPLACE && editor.replaced.size() > 0) {
            editor.replaced.pop();
        }
        return true;
    }
    int mincol = 0;
    str line = editor.buffer.line(editor.row);
    int step = 0;
    bool is_replace = editor.mode == MED_editor.REPLACE && !editor.is_virtual;
    if (mode == 0 && (editor.mode == MED_editor.INSERT || is_replace)) {
        if (editor.is_smarttab && is_in_indent_before(line, editor.col)) {
            step = editor.shift_size();
        } else if (editor.soft_width() != 0 && editor.col > 0) {
            int before_byte = line.byte_at(editor.col - 1);
            if (before_byte == 9 || (before_byte == 32 && !editor.did_space)) {
                step = editor.soft_width();
            }
        }
    }
    if (step > 0) {
        // 'smarttab' in the indent and 'softtabstop' elsewhere: <BS> steps back one
        // 'shiftwidth' or 'softtabstop' (Vim's ins_bs). In Replace mode the
        // characters that were replaced come back; plain text is only passed.
        int vcol = MED_text.display_col(line, editor.col, editor.tab);
        int start_vcol = vcol;
        int want = ((vcol - 1) / step) * step;
        while (vcol > want && editor.col > 0 && is_white_byte(line.byte_at(editor.col - 1))) {
            int previous = MED_text.previous_col(line, editor.col);
            if (is_replace) {
                if (editor.replaced.size() > 0) {
                    str back = editor.replaced.pop();
                    editor.change(MED_buffer.Pos(editor.row, previous), MED_buffer.Pos(editor.row, editor.col), back);
                }
            } else {
                editor.change(MED_buffer.Pos(editor.row, previous), MED_buffer.Pos(editor.row, editor.col), "");
            }
            editor.col = previous;
            line = editor.buffer.line(editor.row);
            vcol = MED_text.display_col(line, editor.col, editor.tab);
        }
        if (vcol < want && !is_replace) {
            editor.change(MED_buffer.Pos(editor.row, editor.col), MED_buffer.Pos(editor.row, editor.col), " ".repeat(want - vcol));
            editor.col = editor.col + want - vcol;
            vcol = want;
        }
        if (vcol >= start_vcol && editor.col > 0) {
            int previous = MED_text.previous_col(line, editor.col);
            if (is_replace) {
                if (editor.replaced.size() > 0) {
                    str back = editor.replaced.pop();
                    editor.change(MED_buffer.Pos(editor.row, previous), MED_buffer.Pos(editor.row, editor.col), back);
                }
            } else {
                editor.change(MED_buffer.Pos(editor.row, previous), MED_buffer.Pos(editor.row, editor.col), "");
            }
            editor.col = previous;
        }
        if (editor.row == editor.ins_start.row && editor.col < editor.ins_start.col) {
            editor.ins_start = MED_buffer.Pos(editor.row, editor.col);
            editor.ins_textlen = MED_text.line_width(editor.buffer.line(editor.row), editor.tab);
        }
        editor.did_ai = false;
        return true;
    }
    if (mode == 2 && editor.is_autoindent) {
        int fnb = MED_text.first_nonblank(line);
        if (fnb < editor.col) {
            mincol = fnb;
        }
    }
    int state = mode;
    bool is_word = false;
    int cclass = 0;
    int previous_class = 0;
    if (editor.col < line.size()) {
        cclass = MED_text.class_at_in(line, editor.col, editor.buffer.keywords);
    }
    while (true) {
        line = editor.buffer.line(editor.row);
        int previous = MED_text.previous_col(line, editor.col);
        int code_point = MED_text.cp_at(line, previous);
        previous_class = cclass;
        cclass = MED_text.class_at_in(line, previous, editor.buffer.keywords);
        if (state == 1 && !is_space_cp(code_point)) {
            state = 3;
            is_word = is_wordc(code_point, editor.buffer.keywords);
        } else if (state == 3 && (is_space_cp(code_point) || is_wordc(code_point, editor.buffer.keywords) != is_word || previous_class != cclass)) {
            break;
        }
        if (editor.mode == MED_editor.REPLACE) {
            if (editor.replaced.size() > 0) {
                str back = editor.replaced.pop();
                editor.change(MED_buffer.Pos(editor.row, previous), MED_buffer.Pos(editor.row, editor.col), back);
            }
        } else {
            editor.change(MED_buffer.Pos(editor.row, previous), MED_buffer.Pos(editor.row, editor.col), "");
        }
        editor.col = previous;
        if (mode == 0) {
            break;
        }
        if (!(editor.col > mincol && !(editor.row == editor.ins_start.row && editor.col == editor.ins_start.col))) {
            break;
        }
    }
    if (editor.row == editor.ins_start.row && editor.col < editor.ins_start.col) {
        editor.ins_start = MED_buffer.Pos(editor.row, editor.col);
        editor.ins_textlen = MED_text.line_width(editor.buffer.line(editor.row), editor.tab);
    }
    editor.did_ai = false;
    return true;
}

// <Del> in insert mode.
bool did_ins_del(MED_editor.Editor editor) {
    str line = editor.buffer.line(editor.row);
    if (editor.col < line.size()) {
        int next = MED_text.next_col(line, editor.col);
        editor.change(MED_buffer.Pos(editor.row, editor.col), MED_buffer.Pos(editor.row, next), "");
        return true;
    }
    if (editor.row + 1 >= editor.buffer.line_count()) {
        return false;
    }
    editor.change(MED_buffer.Pos(editor.row, editor.col), MED_buffer.Pos(editor.row + 1, 0), "");
    return true;
}

// Remove the whitespace an auto-indent left behind (Vim's stop_insert).
void strip_autoindent(MED_editor.Editor editor) {
    int row = editor.row;
    int col = editor.col;
    int orig_row = editor.row;
    int orig_col = editor.col;
    str line = editor.buffer.line(row);
    if (col > line.size()) {
        col = line.size();
    }
    int current_col = -1;
    while (true) {
        line = editor.buffer.line(row);
        if (col >= line.size() && col > 0) {
            col = MED_text.previous_col(line, col);
        }
        if (col >= line.size()) {
            current_col = 0;
            break;
        }
        current_col = line.byte_at(col);
        if (!is_white_byte(current_col)) {
            break;
        }
        editor.change(MED_buffer.Pos(row, col), MED_buffer.Pos(row, col + 1), "");
    }
    line = editor.buffer.line(row);
    if (current_col != 0 && MED_text.next_col(line, col) >= line.size()) {
        col = line.size();
    }
    editor.row = row;
    if (orig_col < col && orig_row == row) {
        col = orig_col;
    }
    editor.col = col;
}

// <Esc>: repeat the insert for a count, tidy up, and go back to normal mode.
void finish_insert(MED_editor.Editor editor) {
    int count = editor.ins_count;
    if (editor.is_ins_arrow) {
        count = 1;
    }
    bool is_untouched = editor.is_ins_arrow && editor.is_ins_restart;
    bool is_arrow_only = editor.is_ins_arrow;
    editor.is_ins_arrow = false;
    editor.ins_count = 1;
    str typed_text = editor.ins_text;
    if (count > 1 && !editor.is_failed) {
        List<int> typed = editor.ins_keys;
        int replays = count - 1;
        bool is_saved = editor.is_replaying;
        for (int i in 0 .. replays) {
            if (editor.ins_cmd == 111 || editor.ins_cmd == 79) {
                ins_cr_open(editor);
            }
            for (int key in typed) {
                insert_key_raw(editor, key);
            }
        }
        editor.is_replaying = is_saved;
    }
    bool was_autoindent = editor.did_ai;
    int want_at_esc = 0;
    if (editor.did_ai) {
        want_at_esc = MED_text.display_col(editor.buffer.line(editor.row), editor.col, editor.tab);
        strip_autoindent(editor);
    }
    editor.is_uline_off = false;
    str line = editor.buffer.line(editor.row);
    editor.marks.set("^", MED_buffer.Pos(editor.row, editor.col));
    if (!is_untouched) {
        set_op_marks(editor, editor.ins_mark, MED_buffer.Pos(editor.row, editor.col));
    }
    if (editor.is_ins_ctrl_o) {
        editor.is_ins_at_eol = editor.col >= line.size();
        editor.o_lnum = editor.row;
    }
    // CTRL-O at the end of the line before anything was typed: the wanted
    // column stays that of the end of the line
    bool is_eol_kept = editor.is_ins_ctrl_o && !editor.is_ins_dirty && !editor.is_ins_restart && editor.col > 0 && editor.col >= line.size();
    if (is_eol_kept) {
        editor.want_from_cursor();
    }
    if (editor.col > 0 && (!editor.is_ins_ctrl_o || editor.col >= line.size())) {
        editor.col = MED_text.previous_col(line, editor.col);
    }
    editor.mode = MED_editor.NORMAL;
    if (editor.blk_op != 0) {
        block_insert_end(editor);
    }
    if (!is_untouched && !is_arrow_only) {
        editor.regs.set_special(".", typed_text);
    }
    if (!editor.is_in_dot && !is_untouched && !is_arrow_only) {
        List<int> tail = editor.ins_keys.slice(0, editor.ins_keys.size());
        tail.push(27);
        editor.dot_tail = tail;
    }
    editor.ins_keys = [];
    editor.end_block();
    editor.clamp();
    if (was_autoindent && editor.col == 0 && want_at_esc > 0 && !is_eol_kept) {
        // the autoindent went and the cursor stayed in column 0 (so Vim does not
        // look at the cursor again): up and down still use the column it had
        editor.want = want_at_esc;
    } else if (!is_eol_kept) {
        editor.want_from_cursor();
    }
}

// `o` / `O` repeats start with a line break.
void ins_cr_open(MED_editor.Editor editor) {
    ins_cr(editor);
}

// One key in insert mode without the bookkeeping of `ins_keys`.
void insert_key_raw(MED_editor.Editor editor, int key) {
    if (key == 13 || key == 10) {
        ins_cr(editor);
    } else if (key == 127 || key == 8) {
        did_ins_bs(editor, 0);
    } else if (key == 23) {
        did_ins_bs(editor, 1);
    } else if (key == 21) {
        did_ins_bs(editor, 2);
    } else if (key == 63240) {
        did_ins_del(editor);
    } else if (key == 9) {
        ins_tab(editor);
    } else if (key == 20 || key == 4) {
        ins_shift(editor, key, editor.ins_previous);
    } else if (key >= 32 && key < 63232) {
        if (key == 32) {
            editor.did_space = true;
        }
        ins_char(editor, key);
    }
    editor.ins_previous = key;
}

// CTRL-T / CTRL-D in insert mode (Vim's ins_shift and change_indent): shift
// the line's indent and keep the cursor on the same character.
void ins_shift(MED_editor.Editor editor, int key, int last_key) {
    stop_arrow(editor);
    str line = editor.buffer.line(editor.row);
    bool is_clear = key == 4 && (last_key == 48 || last_key == 94) && editor.col > 0;
    if (is_clear) {
        int before = editor.col - 1;
        editor.change(MED_buffer.Pos(editor.row, before), MED_buffer.Pos(editor.row, editor.col), "");
        editor.col = before;
        line = editor.buffer.line(editor.row);
    }
    int old_indent = indent_width(editor, line);
    int first = 0;
    while (first < line.size() && is_white_byte(line.byte_at(first))) {
        first = first + 1;
    }
    int offset = editor.col - first;
    int cursor_vcol = MED_text.display_col(line, editor.col, editor.tab);
    int new_indent = 0;
    if (!is_clear) {
        new_indent = shifted_width(editor, old_indent, key == 4, 1, true);
    }
    str fresh = make_indent(editor, new_indent);
    editor.change(MED_buffer.Pos(editor.row, 0), MED_buffer.Pos(editor.row, first), fresh);
    int new_first = fresh.size();
    int insstart_less = first - new_first;
    if (offset >= 0) {
        if (offset == 0) {
            insstart_less = 1000000000;
        }
        editor.col = new_first + offset;
    } else {
        // the cursor was inside the indent: keep its distance from the text
        int target = new_indent - (old_indent - cursor_vcol);
        if (target < 0) {
            target = 0;
        }
        str now = editor.buffer.line(editor.row);
        int spot = 0;
        int walker = 0;
        while (walker < new_first && spot < target) {
            spot = spot + MED_text.cell_width(now, walker, spot, editor.tab);
            walker = walker + 1;
        }
        editor.col = walker;
        insstart_less = 1000000000;
    }
    if (editor.row == editor.ins_start.row && editor.ins_start.col != 0) {
        if (editor.ins_start.col <= insstart_less) {
            editor.ins_start = MED_buffer.Pos(editor.row, 0);
        } else {
            editor.ins_start = MED_buffer.Pos(editor.row, editor.ins_start.col - insstart_less);
        }
    }
    if (editor.did_ai && !is_blank_line(editor.buffer.line(editor.row))) {
        editor.did_ai = false;
    }
    editor.ins_text = editor.ins_text + str.from_chars([key]);
}

// The cursor is in the indent (Vim's inindent(0)): only blanks before it.
bool is_cursor_in_indent(MED_editor.Editor editor) {
    return is_in_indent_before(editor.buffer.line(editor.row), editor.col) || editor.col == 0;
}

// <Tab> in insert mode (Vim's ins_tab): a tab, or spaces to the next
// 'shiftwidth' / 'softtabstop' / 'tabstop', turned into tabs when 'expandtab' is off.
void ins_tab(MED_editor.Editor editor) {
    bool is_indent = is_cursor_in_indent(editor);
    int soft = editor.soft_width();
    bool is_special_sta = editor.is_smarttab && is_indent;
    if (!editor.is_expandtab && !(is_special_sta && editor.tab != editor.shift_size()) && soft == 0) {
        ins_char(editor, 9);
        return;
    }
    str typed = editor.ins_text;
    editor.did_ai = false;
    int width = editor.tab;
    if (is_special_sta) {
        width = editor.shift_size();
    } else if (soft != 0) {
        width = soft;
    }
    str line = editor.buffer.line(editor.row);
    int cursor_vcol = MED_text.display_col(line, editor.col, editor.tab);
    int count = width - (cursor_vcol % width);
    bool is_replace = editor.mode == MED_editor.REPLACE;
    ins_char(editor, 32);
    for (int i in 1 .. count) {
        MED_buffer.Pos here = MED_buffer.Pos(editor.row, editor.col);
        editor.change(here, here, " ");
        editor.col = editor.col + 1;
        if (is_replace) {
            editor.replaced.push("");
        }
    }
    editor.ins_text = typed + "\t";
    if (editor.is_expandtab || is_replace || !(soft > 0 || is_special_sta)) {
        return;
    }
    // turn the blanks before the cursor into as many tabs as fit
    line = editor.buffer.line(editor.row);
    int first = editor.col;
    while (first > 0 && is_white_byte(line.byte_at(first - 1))) {
        first = first - 1;
    }
    int vcol = MED_text.display_col(line, first, editor.tab);
    int want = MED_text.display_col(line, editor.col, editor.tab);
    int tabs = 0;
    while (vcol + editor.tab - (vcol % editor.tab) <= want) {
        vcol = vcol + editor.tab - (vcol % editor.tab);
        tabs = tabs + 1;
    }
    str run = "\t".repeat(tabs) + " ".repeat(want - vcol);
    if (run == line.substr(first, editor.col)) {
        return;
    }
    editor.change(MED_buffer.Pos(editor.row, first), MED_buffer.Pos(editor.row, editor.col), run);
    editor.col = first + run.size();
    if (editor.row == editor.ins_start.row && first < editor.ins_start.col) {
        editor.ins_start = MED_buffer.Pos(editor.row, first);
    }
}

// Move the cursor with an arrow key: that ends the undo block and the
// insert restarts as a fresh `i`.
void ins_move(MED_editor.Editor editor, int key) {
    str line = editor.buffer.line(editor.row);
    // 'whichwrap' is "b,s": no wrapping in insert mode, and a move that cannot
    // happen is only a beep (it does not count as an arrow key).
    if (key == 63234 && editor.col == 0 && !(has_whichwrap(editor, "[") && editor.row > 0)) {
        return;
    }
    if (key == 63235 && editor.col >= line.size() && !(has_whichwrap(editor, "]") && editor.row + 1 < editor.buffer.line_count())) {
        return;
    }
    if (key == 63232 && editor.row == 0) {
        return;
    }
    if (key == 63233 && editor.row + 1 >= editor.buffer.line_count()) {
        return;
    }
    // Vim's stop_insert() only removes the autoindent when the cursor leaves
    // the line, which Up and Down do and the sideways keys do not.
    if (editor.did_ai && (key == 63232 || key == 63233)) {
        strip_autoindent(editor);
        line = editor.buffer.line(editor.row);
    }
    editor.is_uline_off = false;
    editor.end_block();
    if (!editor.is_ins_arrow && editor.ins_text.size() > 0 && !editor.is_in_dot) {
        // stop_insert(): what was typed so far is the last inserted text
        // and, with the command, what `.` repeats
        editor.regs.set_special(".", editor.ins_text);
        List<int> typed_so_far = editor.ins_keys.slice(0, editor.ins_keys.size());
        typed_so_far.push(27);
        editor.dot_tail = typed_so_far;
    }
    if (key == 63234) {
        if (editor.col == 0) {
            editor.row = editor.row - 1;
            editor.col = editor.buffer.line_size(editor.row);
            editor.want = -1;
        } else {
            editor.col = MED_text.previous_col(line, editor.col);
        }
    } else if (key == 63235) {
        if (editor.col >= line.size()) {
            editor.row = editor.row + 1;
            editor.col = 0;
        } else {
            editor.col = MED_text.next_col(line, editor.col);
        }
    } else if (key == 63232 || key == 63233) {
        // up and down use the wanted column, which typing and sideways moves
        // update but opening a line does not
        if (key == 63232) {
            editor.row = editor.row - 1;
        } else {
            editor.row = editor.row + 1;
        }
        if (editor.want < 0) {
            editor.col = editor.buffer.line_size(editor.row);
        } else {
            editor.col = MED_motion.col_for_want(editor.buffer.line(editor.row), editor.want, editor.tab, true);
        }
    } else if (key == 63236) {
        editor.col = 0;
    } else if (key == 63237) {
        editor.col = line.size();
    } else if (key == 63238 || key == 63239) {
        int wanted = editor.want;
        MED_view.did_page(editor, key == 63239, 1, false);
        editor.want = wanted;
        if (wanted < 0) {
            editor.col = editor.buffer.line_size(editor.row);
        } else {
            editor.col = MED_motion.col_for_want(editor.buffer.line(editor.row), wanted, editor.tab, true);
        }
    }
    if (key != 63232 && key != 63233 && key != 63238 && key != 63239) {
        if (!(key == 63234 && editor.want == -1)) {
            editor.want_from_cursor();
        }
    }
    if (key == 63237) {
        editor.want = -1;
    }
    editor.did_ai = false;
    editor.did_space = false;
    editor.ins_previous = 0;
    editor.ins_keys = [];
    editor.ins_text = "";
    editor.is_ins_arrow = true;
    editor.ins_count = 1;
    editor.ins_cmd = 105;
    // what `.` repeats changes only when something is typed after the arrow
    editor.is_ins_moved = true;
}

// CTRL-R: type a register's text as if it were typed. `kind` 0 is CTRL-R,
// 1 CTRL-R CTRL-R (literally), 2 CTRL-R CTRL-O (no auto-indent, a line-wise
// register goes above the line), 3 CTRL-R CTRL-P (as 2, fixing the indent).
void ins_register(MED_editor.Editor editor, str name, int kind) {
    Option<MED_register.Reg> found = editor.regs.get(name);
    if (kind >= 2) {
        editor.ins_text = editor.ins_text + "\x12" + str.from_chars([kind + 13]) + name;
        editor.ins_keys.push(18);
        editor.ins_keys.push(kind + 13);
        editor.ins_keys.push(name.byte_at(0));
        match (found) {
            case None: {
            }
            case Some(MED_register.Reg reg): {
                int flags = 0;
                if (kind == 3) {
                    flags = PUT_FIXINDENT;
                }
                did_put_reg(editor, reg, -1, 1, true, flags, 0);
                if (reg.kind == MED_register.LINE) {
                    editor.col = 0;
                }
            }
        }
        return;
    }
    match (found) {
        case None: {
        }
        case Some(MED_register.Reg reg): {
            int text_size = editor.ins_text.size();
            int keys_size = editor.ins_keys.size();
            ins_text_typed(editor, reg.text(), kind == 1);
            if (name == "-") {
                // the small delete register is recorded by name, not by text
                editor.ins_text = editor.ins_text.substr(0, text_size) + "\x12-";
                while (editor.ins_keys.size() > keys_size) {
                    editor.ins_keys.pop();
                }
                editor.ins_keys.push(18);
                editor.ins_keys.push(45);
            }
        }
    }
}

// Insert `text` as if typed (a newline starts a line, <Esc> leaves Insert
// mode and what follows is typed in Normal mode). With `is_literal` control
// characters other than <Tab> are inserted as themselves.
void ins_text_typed(MED_editor.Editor editor, str text, bool is_literal) {
    for (int code_point in text.chars()) {
        bool is_insert = editor.mode == MED_editor.INSERT || editor.mode == MED_editor.REPLACE;
        if (!is_insert) {
            feed_key(editor, code_point);
        } else if (code_point == 10) {
            insert_key(editor, 13);
        } else if (is_literal && ((code_point < 32 && code_point != 9) || code_point == 127)) {
            editor.ins_keys.push(code_point);
            ins_char(editor, code_point);
        } else {
            insert_key(editor, code_point);
        }
    }
}

// Insert `text` as if typed.
void ins_text(MED_editor.Editor editor, str text) {
    ins_text_typed(editor, text, false);
}

/// A pasted text typed in one go (Insert mode, 'textwidth' 0): no autoindent,
/// no pairs, tabs as they are; `.` repeats it. The text uses "\n" for line
/// breaks. The same as typing every character, only faster.
pub void paste_plain(MED_editor.Editor editor, str body) {
    stop_arrow(editor);
    if (body.size() == 0) {
        return;
    }
    MED_buffer.Pos at_cursor = MED_buffer.Pos(editor.row, editor.col);
    editor.change(at_cursor, at_cursor, body);
    int breaks = 0;
    int last_break = -1;
    for (int index in 0 .. body.size()) {
        if (body.byte_at(index) == 10) {
            breaks = breaks + 1;
            last_break = index;
        }
    }
    if (breaks > 0) {
        editor.row = editor.row + breaks;
        editor.col = body.size() - last_break - 1;
    } else {
        editor.col = editor.col + body.size();
    }
    editor.did_ai = false;
    editor.did_space = false;
    editor.ins_previous = 0;
    editor.ins_text = editor.ins_text + body;
    for (int code_point in body.chars()) {
        if (code_point == 10) {
            editor.ins_keys.push(13);
        } else {
            editor.ins_keys.push(code_point);
        }
    }
}

// Typing after an arrow key starts a fresh insert (Vim's stop_arrow): only
// now does the insert start move to the cursor.
void stop_arrow(MED_editor.Editor editor) {
    if (editor.is_ins_arrow) {
        if (editor.is_ins_restart) {
            editor.is_ins_restart = false;
            if (!editor.is_in_dot) {
                editor.dot_body = [105];
                editor.dot_count = 0;
                editor.dot_tail = [];
            }
        }
        if (editor.is_ins_moved) {
            editor.is_ins_moved = false;
            if (!editor.is_in_dot) {
                editor.dot_body = [105];
                editor.dot_count = 0;
                editor.dot_tail = [];
            }
        }
        editor.ins_next = MED_buffer.Pos(editor.row, editor.col);
        editor.is_ins_next_set = true;
        if (editor.col > editor.ins_start.col && editor.is_ins_dirty) {
            // moved right of the original start after typing: keep that start
            editor.is_ins_hold = true;
        }
        editor.is_ins_arrow = false;
    }
    editor.is_ins_dirty = true;
}

int hex_value(int char_code) {
    if (char_code >= 48 && char_code <= 57) {
        return char_code - 48;
    }
    if (char_code >= 97 && char_code <= 102) {
        return char_code - 87;
    }
    if (char_code >= 65 && char_code <= 70) {
        return char_code - 55;
    }
    return -1;
}

// One key after CTRL-V (Vim's get_literal): a decimal, octal (o), hex (x), or
// Unicode (u, U) number, or the key itself. Returns the character once it is
// complete and -1 while more keys are needed; `is_lit_reuse` is set when the
// last key ended a number and has to be handled again.
int literal_step(MED_editor.Editor editor, int next_col) {
    bool is_done = false;
    bool is_reuse = false;
    if (next_col == 120 || next_col == 88) {
        editor.is_lit_hex = true;
    } else if (next_col == 111 || next_col == 79) {
        editor.is_lit_octal = true;
    } else if (next_col == 117 || next_col == 85) {
        editor.lit_uni = next_col;
    } else if (editor.is_lit_hex || editor.lit_uni != 0) {
        int digit = hex_value(next_col);
        if (digit < 0) {
            is_done = true;
        } else {
            editor.lit_cc = editor.lit_cc * 16 + digit;
            editor.lit_i = editor.lit_i + 1;
        }
    } else if (editor.is_lit_octal) {
        if (next_col < 48 || next_col > 55) {
            is_done = true;
        } else {
            editor.lit_cc = editor.lit_cc * 8 + next_col - 48;
            editor.lit_i = editor.lit_i + 1;
        }
    } else if (next_col < 48 || next_col > 57) {
        is_done = true;
    } else {
        editor.lit_cc = editor.lit_cc * 10 + next_col - 48;
        editor.lit_i = editor.lit_i + 1;
    }
    if (!is_done) {
        if (editor.lit_cc > 255 && editor.lit_uni == 0) {
            editor.lit_cc = 255;
        }
        if (editor.lit_cc > 1114111) {
            editor.lit_cc = 65533;
        }
        if (editor.is_lit_hex) {
            is_done = editor.lit_i >= 2;
        } else if (editor.lit_uni != 0) {
            is_done = (editor.lit_uni == 117 && editor.lit_i >= 4) || (editor.lit_uni == 85 && editor.lit_i >= 8);
        } else {
            is_done = editor.lit_i >= 3;
        }
        if (!is_done) {
            return -1;
        }
    } else if (editor.lit_i > 0) {
        is_reuse = true;
    }
    int current_col = editor.lit_cc;
    if (editor.lit_i == 0) {
        current_col = next_col;
    }
    if (current_col == 0) {
        current_col = 10;
    }
    editor.is_lit_hex = false;
    editor.is_lit_octal = false;
    editor.lit_uni = 0;
    editor.lit_cc = 0;
    editor.lit_i = 0;
    editor.is_lit_reuse = is_reuse;
    return current_col;
}

void ins_literal_key(MED_editor.Editor editor, int next_col) {
    if (next_col >= 63232 && next_col <= 63400 && editor.lit_i == 0 && !editor.is_lit_hex && !editor.is_lit_octal && editor.lit_uni == 0) {
        // a key with no character of its own is inserted by name
        editor.ins_wait = 0;
        editor.ins_text = editor.ins_text + "\x16";
        for (int code_point in MED_key.name(next_col).chars()) {
            ins_char(editor, code_point);
        }
        return;
    }
    int current_col = literal_step(editor, next_col);
    if (current_col < 0) {
        return;
    }
    editor.ins_wait = 0;
    editor.ins_text = editor.ins_text + "\x16";
    ins_char(editor, current_col);
    if (editor.is_lit_reuse) {
        editor.ins_keys.pop();
        insert_key(editor, next_col);
    }
}

// ------------------------------------------------- keyword completion

// Every keyword (at least two characters) in the buffer: rows, columns, words.
type Occurrence {
    pub int row = 0;
    pub int col = 0;
    pub str word = "";
}

List<Occurrence> keyword_occurrences(MED_editor.Editor editor) {
    List<Occurrence> found = [];
    for (int row in 0 .. editor.buffer.line_count()) {
        str line = editor.buffer.line(row);
        int index = 0;
        while (index < line.size()) {
            int code_point = MED_text.cp_at(line, index);
            if (!is_wordc(code_point, editor.buffer.keywords)) {
                index = MED_text.next_col(line, index);
                continue;
            }
            int start = index;
            int length = 0;
            while (index < line.size() && is_wordc(MED_text.cp_at(line, index), editor.buffer.keywords)) {
                index = MED_text.next_col(line, index);
                length = length + 1;
            }
            if (length >= 2) {
                Occurrence item = Occurrence();
                item.row = row;
                item.col = start;
                item.word = line.substr(start, index);
                found.push(item);
            }
        }
    }
    return found;
}

bool is_occurrence_before(Occurrence item, int row, int col) {
    return item.row < row || (item.row == row && item.col < col);
}

// Begin CTRL-N / CTRL-P completion at the cursor; false when there is
// nothing to complete with.
bool did_start_completion(MED_editor.Editor editor, bool is_forward) {
    str line = editor.buffer.line(editor.row);
    int start = editor.col;
    while (start > 0) {
        int before = MED_text.previous_col(line, start);
        if (!is_wordc(MED_text.cp_at(line, before), editor.buffer.keywords)) {
            break;
        }
        start = before;
    }
    str base = line.substr(start, editor.col);
    List<Occurrence> all = keyword_occurrences(editor);
    List<Occurrence> ordered = [];
    List<Occurrence> after = [];
    List<Occurrence> earlier = [];
    for (Occurrence item in all) {
        if (is_occurrence_before(item, editor.row, start)) {
            earlier.push(item);
        } else if (!is_occurrence_before(item, editor.row, editor.col)) {
            after.push(item);
        }
    }
    if (is_forward) {
        for (Occurrence item in after) {
            ordered.push(item);
        }
        for (Occurrence item in earlier) {
            ordered.push(item);
        }
    } else {
        int index = earlier.size();
        while (index > 0) {
            index = index - 1;
            ordered.push(earlier[index]);
        }
        index = after.size();
        while (index > 0) {
            index = index - 1;
            ordered.push(after[index]);
        }
    }
    List<str> items = [base];
    List<str> seen = [];
    for (Occurrence item in ordered) {
        if (!item.word.starts_with(base)) {
            continue;
        }
        bool is_seen = false;
        for (str known in seen) {
            if (known == item.word) {
                is_seen = true;
                break;
            }
        }
        if (is_seen) {
            continue;
        }
        seen.push(item.word);
        items.push(item.word);
    }
    if (items.size() == 1) {
        return false;
    }
    if (!is_forward) {
        // the list is kept in forward order: the nearest match before the
        // cursor is the last item
        List<str> reversed = [base];
        int index = items.size();
        while (index > 1) {
            index = index - 1;
            reversed.push(items[index]);
        }
        items = reversed;
    }
    editor.is_completing = true;
    editor.completion_items = items;
    editor.completion_index = 0;
    editor.completion_col = start;
    editor.completion_text = editor.ins_text;
    editor.completion_keys = editor.ins_keys.size();
    return true;
}

// Show the next (`step` 1) or previous (-1) item.
void cycle_completion(MED_editor.Editor editor, int step) {
    int count = editor.completion_items.size();
    int index = (editor.completion_index + step + count) % count;
    editor.completion_index = index;
    str word = editor.completion_items[index];
    editor.change(MED_buffer.Pos(editor.row, editor.completion_col), MED_buffer.Pos(editor.row, editor.col), word);
    editor.col = editor.completion_col + word.size();
    editor.did_ai = false;
}

// Leave completion keeping what is shown (`is_keep`) or the typed text.
void end_completion(MED_editor.Editor editor, bool is_keep) {
    if (!editor.is_completing) {
        return;
    }
    if (!is_keep && editor.completion_index != 0) {
        editor.completion_index = 0;
        str word = editor.completion_items[0];
        editor.change(MED_buffer.Pos(editor.row, editor.completion_col), MED_buffer.Pos(editor.row, editor.col), word);
        editor.col = editor.completion_col + word.size();
    }
    editor.is_completing = false;
    str base = editor.completion_items[0];
    str word = editor.completion_items[editor.completion_index];
    str added = word.substr(base.size(), word.size());
    editor.ins_text = editor.completion_text + added;
    for (int code_point in added.chars()) {
        editor.ins_keys.push(code_point);
    }
}

// -------------------------------------------------------------- auto pairs

// The rest of the line and the lines after it up to a non-blank one, joined
// with spaces (the plugin's `after`).
str text_after_cursor(MED_editor.Editor editor) {
    str line = editor.buffer.line(editor.row);
    str after = line.substr(editor.col, line.size());
    int row = editor.row + 1;
    while (row < editor.buffer.line_count()) {
        str next_line = editor.buffer.line(row);
        after = after + " " + next_line;
        if (!is_blank_line(next_line)) {
            break;
        }
        row = row + 1;
    }
    return after;
}

void type_keys(MED_editor.Editor editor, List<int> keys) {
    bool was_busy = editor.is_autopair_busy;
    editor.is_autopair_busy = true;
    for (int code in keys) {
        insert_key(editor, code);
    }
    editor.is_autopair_busy = was_busy;
}

// The keys the auto-pairs plugin would have typed for `key`; true when it
// took the key over.
bool did_autopair_key(MED_editor.Editor editor, int key) {
    if (editor.mode != MED_editor.INSERT || editor.is_autopair_busy || editor.ins_wait != 0 || editor.is_completing || editor.is_in_dot) {
        return false;
    }
    if (!editor.is_option_on("autopairs", true)) {
        return false;
    }
    str line = editor.buffer.line(editor.row);
    str before = line.substr(0, editor.col);
    str rest = line.substr(editor.col, line.size());
    if (key == 127 || key == 8) {
        List<int> keys = MED_autopair.on_backspace(before, text_after_cursor(editor));
        if (keys.size() == 0) {
            return false;
        }
        type_keys(editor, keys);
        return true;
    }
    if (key == 32) {
        List<int> keys = MED_autopair.on_space(before, text_after_cursor(editor));
        if (keys.size() == 0) {
            return false;
        }
        type_keys(editor, keys);
        return true;
    }
    if (key == 13 || key == 10) {
        return false;
    }
    bool is_pair_key = key == 40 || key == 41 || key == 91 || key == 93 || key == 123 || key == 125 || key == 39 || key == 34 || key == 96;
    if (!is_pair_key) {
        return false;
    }
    MED_autopair.Decision decision = MED_autopair.on_key(key, before, text_after_cursor(editor), rest, editor.ap_return_row == editor.row, is_blank_line(line));
    if (!decision.is_handled) {
        return false;
    }
    if (decision.is_search) {
        stop_arrow(editor);
        if (decision.is_blank_line_delete && editor.row > 0) {
            // normal! ddk$
            editor.regs.delete("", MED_register.Reg([editor.buffer.line(editor.row)], MED_register.LINE), true, false);
            // the `dd` leaves nothing for `.` to insert
            editor.regs.set_special(".", "");
            editor.change(MED_buffer.Pos(editor.row - 1, editor.buffer.line_size(editor.row - 1)), MED_buffer.Pos(editor.row, editor.buffer.line_size(editor.row)), "");
            editor.row = editor.row - 1;
            editor.col = MED_text.last_col(editor.buffer.line(editor.row));
        }
        // search(m, 'We'): the end of the next match after the cursor
        int row = editor.row;
        int col = editor.col;
        bool is_found = false;
        while (row < editor.buffer.line_count() && !is_found) {
            str here = editor.buffer.line(row);
            int from = 0;
            if (row == editor.row) {
                from = MED_num.smaller(editor.col + 1, here.size());
                if (editor.col >= here.size()) {
                    from = here.size();
                }
            }
            int found_at = here.substr(from, here.size()).index_of(decision.search).or(-1);
            if (found_at >= 0) {
                col = from + found_at + decision.search.size() - 1;
                is_found = true;
            } else {
                row = row + 1;
            }
        }
        if (is_found) {
            editor.row = row;
            editor.col = col;
            type_keys(editor, [63235]);
        }
        editor.want_from_cursor();
        return true;
    }
    type_keys(editor, decision.keys);
    return true;
}

// After <CR>: a pair that was split in two lines opens the line between.
bool did_autopair_return(MED_editor.Editor editor) {
    if (editor.mode != MED_editor.INSERT || editor.is_autopair_busy || editor.is_in_dot || !editor.is_option_on("autopairs", true)) {
        return false;
    }
    editor.ap_return_row = -1;
    if (editor.row == 0) {
        return false;
    }
    str previous = editor.buffer.line(editor.row - 1);
    str line = editor.buffer.line(editor.row);
    str rest = line.substr(editor.col, line.size());
    if (!MED_autopair.is_return_pair(previous, rest)) {
        return false;
    }
    editor.ap_return_row = editor.row;
    bool was_busy = editor.is_autopair_busy;
    editor.is_autopair_busy = true;
    List<int> keys = [];
    int window_row = editor.row - editor.view_top + 1;
    if (window_row * 3 >= editor.view_height * 2) {
        keys.push(122);
        keys.push(122);
    }
    keys.push(27);
    keys.push(61);
    keys.push(107);
    keys.push(111);
    for (int code in keys) {
        feed(editor, code);
    }
    editor.is_autopair_busy = was_busy;
    return true;
}

// CTRL-Y / CTRL-E: the character of the line above / below at the cursor's
// screen column, or 0.
int copy_char(MED_editor.Editor editor, int step) {
    int target = editor.row + step;
    if (target < 0 || target >= editor.buffer.line_count()) {
        return 0;
    }
    str line = editor.buffer.line(target);
    int want_col = editor.cursor_vcol();
    int spot = 0;
    int index = 0;
    int previous = 0;
    while (spot < want_col && index < line.size()) {
        previous = index;
        spot = spot + MED_text.cell_width(line, index, spot, editor.tab);
        index = MED_text.next_col(line, index);
    }
    if (spot > want_col) {
        index = previous;
    }
    if (index >= line.size()) {
        return 0;
    }
    return MED_text.cp_at(line, index);
}

bool is_alnum_code(int code_point) {
    return (code_point >= 48 && code_point <= 57) || (code_point >= 65 && code_point <= 90) || (code_point >= 97 && code_point <= 122);
}

// Vim's check_abbr(): typing a non-keyword character (not <Tab>) or <Esc>, <CR>, CTRL-]
// after an Insert-mode abbreviation replaces it by its right-hand side, as if
// the left-hand side had been backspaced and the right-hand side typed (so `.`
// and a count repeat the expanded text). A full-id abbreviation (all keyword
// characters) needs a non-keyword before it or the start of the typed text; an
// end-id one (ends in a keyword character) matches anywhere; one that ends in
// a non-keyword character only expands on <Esc>, <CR> and CTRL-] (what nvim
// does; the probes are in corpus 104).
bool did_abbreviate(MED_editor.Editor editor, int key) {
    if (editor.abbr_lhs.size() == 0 || editor.is_abbr_busy || editor.is_in_dot) {
        return false;
    }
    bool is_end = key == 27 || key == 13 || key == 10 || key == 29;
    if (!is_end) {
        if (key < 32 || key == 127 || key >= 63232 || MED_text.class_in(key, editor.buffer.keywords) == 2) {
            return false;
        }
    }
    int limit = 0;
    if (editor.row == editor.ins_start.row && editor.ins_start.col <= editor.col) {
        limit = editor.ins_start.col;
    }
    str line = editor.buffer.line(editor.row);
    if (editor.col <= limit || editor.col > line.size()) {
        return false;
    }
    int index = abbreviation_at(editor, line.substr(limit, editor.col).chars(), is_end, "i");
    if (index < 0) {
        return false;
    }
    editor.is_abbr_busy = true;
    for (int count in 0 .. editor.abbr_lhs[index].chars().size()) {
        insert_key(editor, 8);
    }
    for (int code in MED_key.parse(editor.abbr_rhs[index], leader: "")) {
        insert_key(editor, code);
    }
    editor.is_abbr_busy = false;
    return true;
}

// The abbreviation (for `mode`, "i" or "c") whose left-hand side ends the
// typed text `before`, or -1.
int abbreviation_at(MED_editor.Editor editor, List<int> before, bool is_end, str mode) {
    int total = before.size();
    for (int index in 0 .. editor.abbr_lhs.size()) {
        if (editor.abbr_mode[index] != mode && editor.abbr_mode[index] != "!") {
            continue;
        }
        List<int> left = editor.abbr_lhs[index].chars();
        int length = left.size();
        if (length == 0 || length > total) {
            continue;
        }
        bool is_match = true;
        for (int offset in 0 .. length) {
            if (before[total - length + offset] != left[offset]) {
                is_match = false;
                break;
            }
        }
        if (!is_match) {
            continue;
        }
        bool is_last_word = MED_text.class_in(left[length - 1], editor.buffer.keywords) == 2;
        bool is_all_word = true;
        for (int code in left) {
            if (MED_text.class_in(code, editor.buffer.keywords) != 2) {
                is_all_word = false;
            }
        }
        if (is_all_word && length < total && MED_text.class_in(before[total - length - 1], editor.buffer.keywords) == 2) {
            continue;
        }
        if (!is_all_word && length < total && MED_text.class_in(before[total - length - 1], editor.buffer.keywords) == 1) {
            // an end-id or non-id one is not recognized after punctuation
            continue;
        }
        if (!is_last_word && !is_end) {
            continue;
        }
        return index;
    }
    return -1;
}

// Whether the command line is an `:unabbreviate`, `:iunabbrev` or `:cunabbrev`,
// whose argument is not expanded.
bool is_unabbreviate_line(str line) {
    int index = 0;
    while (index < line.size() && (line.byte_at(index) == 32 || line.byte_at(index) == 58)) {
        index = index + 1;
    }
    int start = index;
    while (index < line.size() && ((line.byte_at(index) >= 97 && line.byte_at(index) <= 122) || (line.byte_at(index) >= 65 && line.byte_at(index) <= 90))) {
        index = index + 1;
    }
    str word = line.substr(start, index);
    if (word.size() >= 3 && "unabbreviate".starts_with(word)) {
        return true;
    }
    if (word.size() >= 4 && ("iunabbrev".starts_with(word) || "cunabbrev".starts_with(word))) {
        return true;
    }
    return false;
}

// The command line's abbreviations: typing a non-keyword character, <CR> or
// CTRL-] after a left-hand side replaces it by the right-hand side.
bool did_cmd_abbreviate(MED_editor.Editor editor, int key) {
    if (editor.abbr_lhs.size() == 0 || editor.is_abbr_busy || editor.is_in_dot) {
        return false;
    }
    bool is_end = key == 13 || key == 10 || key == 29;
    if (!is_end) {
        if (key < 32 || key == 127 || key >= 63232 || MED_text.class_in(key, editor.buffer.keywords) == 2) {
            return false;
        }
    }
    if (editor.cmd_position == 0 || editor.cmd_position > editor.cmdline.size()) {
        return false;
    }
    if (editor.cmd_type == 58 && is_unabbreviate_line(editor.cmdline)) {
        return false;
    }
    int index = abbreviation_at(editor, editor.cmdline.substr(0, editor.cmd_position).chars(), true, "c");
    if (index < 0) {
        return false;
    }
    int length = editor.abbr_lhs[index].size();
    str rhs = str.from_chars(MED_key.parse(editor.abbr_rhs[index], leader: ""));
    cmd_delete(editor, editor.cmd_position - length, editor.cmd_position);
    cmd_insert(editor, rhs);
    return true;
}

void insert_key(MED_editor.Editor editor, int key) {
    if (editor.is_ins_next_set) {
        if (!editor.is_ins_hold) {
            editor.ins_start = editor.ins_next;
            editor.ins_mark = editor.ins_start;
        }
        editor.is_ins_next_set = false;
    }
    if (editor.ins_wait == 11) {
        editor.dig_first = key;
        editor.ins_wait = 12;
        if (key == 27) {
            editor.ins_wait = 0;
        }
        return;
    }
    if (editor.ins_wait == 12) {
        editor.ins_wait = 0;
        if (key != 27) {
            stop_arrow(editor);
            int made = digraph_of(editor.dig_first, key);
            editor.ins_keys.push(22);
            editor.ins_keys.push(made);
            editor.ins_text = editor.ins_text + "\x16";
            ins_char(editor, made);
        }
        return;
    }
    if (editor.ins_wait == 18) {
        editor.ins_wait = 0;
        if (key == 61) {
            expr_open(editor, 2);
            return;
        }
        if (key == 18 || key == 15 || key == 16) {
            if (key == 18) {
                editor.ins_wait = 19;
            } else if (key == 15) {
                editor.ins_wait = 20;
            } else {
                editor.ins_wait = 21;
            }
            return;
        }
        stop_arrow(editor);
        ins_register(editor, str.from_chars([key]), 0);
        return;
    }
    if (editor.ins_wait >= 19 && editor.ins_wait <= 21) {
        int kind = editor.ins_wait - 18;
        editor.ins_wait = 0;
        if (key == 27) {
            return;
        }
        stop_arrow(editor);
        ins_register(editor, str.from_chars([key]), kind);
        return;
    }
    if (editor.ins_wait == 8) {
        // CTRL-G U {Left, Right}: the cursor moves and the insert goes on
        editor.ins_wait = 0;
        if (key == 63234 || key == 63235) {
            str line_here = editor.buffer.line(editor.row);
            editor.ins_keys.push(key);
            if (key == 63234) {
                editor.ins_text = editor.ins_text + "\x07U" + str.from_chars([128]) + "kl";
            } else {
                editor.ins_text = editor.ins_text + "\x07U" + str.from_chars([128]) + "kr";
            }
            if (key == 63234 && editor.col > 0) {
                editor.col = MED_text.previous_col(line_here, editor.col);
            } else if (key == 63235 && editor.col < line_here.size()) {
                editor.col = MED_text.next_col(line_here, editor.col);
            }
            editor.want_from_cursor();
        } else {
            insert_key(editor, key);
        }
        return;
    }
    if (editor.ins_wait == 7) {
        // CTRL-G u starts a new undoable change, CTRL-G j / k move down / up
        editor.ins_wait = 0;
        if (key == 85) {
            editor.ins_wait = 8;
            editor.ins_keys.push(7);
            editor.ins_keys.push(85);
            return;
        }
        if (key == 117) {
            editor.close_block();
        } else if (key == 106 || key == 10 || key == 63233) {
            ins_move(editor, 63233);
        } else if (key == 107 || key == 11 || key == 63232) {
            ins_move(editor, 63232);
        }
        return;
    }
    if (editor.ins_wait == 22) {
        stop_arrow(editor);
        editor.ins_keys.push(key);
        ins_literal_key(editor, key);
        return;
    }
    if (editor.is_completing) {
        if (key == 14 || key == 16) {
            if (key == 14) {
                cycle_completion(editor, 1);
            } else {
                cycle_completion(editor, -1);
            }
            return;
        }
        if (key == 25) {
            end_completion(editor, true);
            return;
        }
        if (key == 5) {
            end_completion(editor, false);
            return;
        }
        end_completion(editor, true);
    }
    if (editor.ins_wait == 24) {
        editor.ins_wait = 0;
        if (key == 14 || key == 16) {
            stop_arrow(editor);
            if (did_start_completion(editor, key == 14)) {
                if (key == 14) {
                    cycle_completion(editor, 1);
                } else {
                    cycle_completion(editor, -1);
                }
            } else {
                editor.ins_wait = 24;
            }
            return;
        }
        if (key == 5 || key == 25) {
            return;
        }
    }
    if (key == 24) {
        editor.ins_wait = 24;
        return;
    }
    if (key == 14 || key == 16) {
        stop_arrow(editor);
        if (did_start_completion(editor, key == 14)) {
            if (key == 14) {
                cycle_completion(editor, 1);
            } else {
                cycle_completion(editor, -1);
            }
        } else {
            editor.ins_wait = 24;
        }
        return;
    }
    if (key != 3) {
        did_abbreviate(editor, key);
    }
    if (key == 27 || key == 3) {
        finish_insert(editor);
        return;
    }
    if (key == 15) {
        // CTRL-O: one Normal mode command, then back to inserting
        int back = 105;
        if (editor.mode == MED_editor.REPLACE) {
            back = 82;
        }
        editor.is_ins_ctrl_o = true;
        editor.ins_count = 1;
        finish_insert(editor);
        editor.is_ins_ctrl_o = false;
        editor.restart_edit = back;
        editor.is_restart_skip = true;
        return;
    }
    if (key == 7) {
        editor.ins_wait = 7;
        return;
    }
    if (key == 18) {
        editor.ins_wait = 18;
        return;
    }
    if (key == 11) {
        editor.ins_wait = 11;
        return;
    }
    if (key == 22 || key == 17) {
        editor.ins_wait = 22;
        editor.ins_keys.push(22);
        return;
    }
    if (key >= 63232 && key <= 63239) {
        ins_move(editor, key);
        return;
    }
    if (key == 1 || key == 0) {
        stop_arrow(editor);
        Option<MED_register.Reg> last = editor.regs.get(".");
        match (last) {
            case None: {
            }
            case Some(MED_register.Reg reg): {
                ins_text(editor, reg.text());
            }
        }
        if (key == 0) {
            finish_insert(editor);
        }
        return;
    }
    if (did_autopair_key(editor, key)) {
        return;
    }
    if (key == 5 || key == 25) {
        int copied = 0;
        if (key == 5) {
            copied = copy_char(editor, 1);
        } else {
            copied = copy_char(editor, -1);
        }
        if (copied > 0) {
            stop_arrow(editor);
            if (copied < 256 && !is_alnum_code(copied)) {
                editor.ins_keys.push(22);
                editor.ins_text = editor.ins_text + "\x16";
            }
            editor.ins_keys.push(copied);
            ins_char(editor, copied);
            editor.ins_previous = key;
        }
        return;
    }
    if ((key == 127 || key == 8 || key == 23 || key == 21) && editor.row == 0 && editor.col == 0) {
        // nothing to delete: Vim beeps before it starts a new insert
        return;
    }
    stop_arrow(editor);
    editor.ins_keys.push(key);
    if (key == 13 || key == 10) {
        ins_cr(editor);
        if (did_autopair_return(editor)) {
            return;
        }
    } else if (key == 127 || key == 8) {
        if (!did_ins_bs(editor, 0)) {
            editor.ins_keys.pop();
        } else if (key == 127) {
            // nvim keeps <BS> in the `.` register as its key bytes (here U+0080 + "kb")
            editor.ins_text = editor.ins_text + str.from_chars([128]) + "kb";
        } else {
            editor.ins_text = editor.ins_text + "\x08";
        }
    } else if (key == 23) {
        // CTRL-W and CTRL-U start a new undoable change
        editor.close_block();
        if (did_ins_bs(editor, 1)) {
            editor.ins_text = editor.ins_text + "\x17";
        } else {
            editor.ins_keys.pop();
        }
    } else if (key == 21) {
        editor.close_block();
        if (did_ins_bs(editor, 2)) {
            editor.ins_text = editor.ins_text + "\x15";
        } else {
            editor.ins_keys.pop();
        }
    } else if (key == 63240) {
        if (did_ins_del(editor)) {
            editor.ins_text = editor.ins_text + str.from_chars([128]) + "kD";
        }
    } else if (key == 9) {
        ins_tab(editor);
    } else if (key == 20 || key == 4) {
        ins_shift(editor, key, editor.ins_previous);
    } else if (key >= 32 && key < 63232) {
        if (key == 32) {
            editor.did_space = true;
        }
        ins_char(editor, key);
    } else {
        editor.ins_keys.pop();
    }
    editor.ins_previous = key;
    if (editor.ins_count <= 1) {
        editor.want_from_cursor();
    }
}

// ------------------------------------------------------------------ commands

// A changing command: remember it for `.`.
void record_dot(MED_editor.Editor editor, MED_parse.Parsed parsed) {
    if (editor.is_in_dot) {
        return;
    }
    editor.dot_reg = parsed.reg;
    editor.dot_count = parsed.count;
    editor.dot_body = parsed.body;
    if (editor.is_search_ready && editor.dot_body.size() > 0) {
        // `d/foo<CR>`: the pattern was typed on the command line, repeat it
        int last = editor.dot_body[editor.dot_body.size() - 1];
        if (last == 47 || last == 63) {
            List<int> body = editor.dot_body.slice(0, editor.dot_body.size());
            for (int code_point in editor.search_typed.chars()) {
                body.push(code_point);
            }
            body.push(13);
            editor.dot_body = body;
        }
    }
    editor.dot_tail = [];
    editor.dot_vkind = 0;
}

List<int> count_keys(int count) {
    List<int> out = [];
    if (count > 0) {
        for (int code_point in count.to_str().chars()) {
            out.push(code_point);
        }
    }
    return out;
}

// Run `keys` as if typed. A failing command stops the rest (macros, dot). A
// command that queued an ex line also stops it: the keys after it are parked in
// `ed.park` and MED_ex continues them once the ex line has run.
pub bool did_replay(MED_editor.Editor editor, List<int> keys) {
    editor.replay_runs = editor.replay_runs + 1;
    bool is_saved = editor.is_replaying;
    editor.is_replaying = true;
    bool is_ok = true;
    int spot = 0;
    for (int key in keys) {
        editor.is_failed = false;
        spot = spot + 1;
        feed(editor, key);
        if (editor.is_failed) {
            is_ok = false;
            break;
        }
        if (editor.ex_queue.size() > 0) {
            editor.park = keys.slice(spot, keys.size());
            editor.is_park_set = true;
            break;
        }
    }
    editor.is_replaying = is_saved;
    if (!is_ok) {
        editor.pending = [];
        editor.is_failed = true;
    }
    return is_ok;
}

// Run `first`, then `again` more rounds of `full`; park the rest when an ex line interrupts.
pub void run_keys(MED_editor.Editor editor, List<int> first, List<int> full, int again) {
    List<int> keys = first;
    int left = again;
    while (true) {
        if (!did_replay(editor, keys)) {
            return;
        }
        if (editor.is_park_set) {
            editor.is_park_set = false;
            if (editor.park.size() > 0 || left > 0) {
                MED_editor.Resume resume = MED_editor.Resume(editor.park, full);
                resume.again = left;
                editor.resume.push(resume);
            }
            editor.park = [];
            return;
        }
        if (left == 0) {
            return;
        }
        left = left - 1;
        keys = full;
    }
}

// Execute the register's text as typed keys, `count` times.
void run_macro(MED_editor.Editor editor, str name, int count) {
    str reg_name = name;
    if (name == "@") {
        reg_name = editor.last_macro;
        if (reg_name == "") {
            editor.is_failed = true;
            return;
        }
    }
    if (reg_name == ":") {
        editor.last_macro = ":";
        if (editor.regs.last_command == "") {
            editor.message = "E30: No previous command line";
            editor.is_failed = true;
            return;
        }
        for (int i in 0 .. count1(count)) {
            editor.ex_queue.push(editor.regs.last_command);
        }
        return;
    }
    Option<MED_register.Reg> found = editor.regs.get(reg_name);
    match (found) {
        case None: {
            editor.is_failed = true;
        }
        case Some(MED_register.Reg reg): {
            editor.last_macro = reg_name;
            List<int> keys = MED_key.decode(reg.text());
            editor.block_hold = editor.block_hold + 1;
            editor.macro_holds = editor.macro_holds + 1;
            run_keys(editor, keys, keys, count1(count) - 1);
            if (editor.ex_queue.size() == 0 && editor.resume.size() == 0) {
                editor.block_hold = editor.block_hold - 1;
                editor.macro_holds = editor.macro_holds - 1;
                if (editor.block_hold == 0 && editor.mode == MED_editor.NORMAL) {
                    editor.end_block();
                }
            }
        }
    }
}

void dot_repeat(MED_editor.Editor editor, int count) {
    if (editor.dot_body.size() == 0) {
        editor.is_failed = true;
        return;
    }
    int total = editor.dot_count;
    if (count > 0) {
        total = count;
        editor.dot_count = count;
    }
    if (editor.dot_reg.size() == 1) {
        int code = editor.dot_reg.byte_at(0);
        if (code >= 49 && code <= 56) {
            editor.dot_reg = str.from_chars([code + 1]);
        }
    }
    if (editor.dot_vkind != 0) {
        setup_visual_redo(editor);
    }
    List<int> keys = [];
    if (editor.dot_reg != "") {
        keys.push(34);
        keys.push(editor.dot_reg.byte_at(0));
    }
    if (editor.dot_vkind == 0) {
        for (int key in count_keys(total)) {
            keys.push(key);
        }
    } else if (editor.dot_count > 0) {
        for (int key in count_keys(editor.dot_count)) {
            keys.push(key);
        }
    }
    for (int key in editor.dot_body) {
        keys.push(key);
    }
    for (int key in editor.dot_tail) {
        keys.push(key);
    }
    bool is_saved = editor.is_in_dot;
    editor.is_in_dot = true;
    bool is_ok = did_replay(editor, keys);
    editor.is_in_dot = is_saved;
    if (!is_ok) {
        editor.is_failed = true;
    }
}

// setpcmark(): does nothing inside `:global`.
void pcmark(MED_editor.Editor editor, MED_buffer.Pos position) {
    editor.set_pcmark(position);
}

pub bool did_mark_name_ok(str mode_text) {
    if (mode_text.size() != 1) {
        return false;
    }
    int key = mode_text.byte_at(0);
    return (key >= 97 && key <= 122) || (key >= 65 && key <= 90) || key == 39 || key == 96 || key == 91 || key == 93 || key == 60 || key == 62;
}

void set_mark(MED_editor.Editor editor, int key) {
    bool is_valid = (key >= 97 && key <= 122) || (key >= 65 && key <= 90) || key == 39 || key == 96 || key == 91 || key == 93 || key == 60 || key == 62;
    if (!is_valid) {
        editor.is_failed = true;
        return;
    }
    str name = str.from_chars([key]);
    if (key == 96) {
        name = "'";
    }
    editor.marks.set(name, MED_buffer.Pos(editor.row, editor.col));
}

// `x`, `D`, `s` ... : a one-key synonym for an operator and a motion.
bool is_synonym(MED_editor.Editor editor, MED_parse.Parsed parsed, str operator, List<int> motion, bool is_doubled) {
    record_dot(editor, parsed);
    return did_operate(editor, operator, parsed.reg, parsed.count, motion, is_doubled, 0);
}

// `~`: swap the case of `count` characters and step over them.
bool did_cmd_tilde(MED_editor.Editor editor, int count) {
    str line = editor.buffer.line(editor.row);
    if (line.size() == 0) {
        return false;
    }
    int remaining = count1(count);
    int first_row = editor.row;
    int first_col = editor.col;
    bool is_changed = false;
    while (remaining > 0) {
        line = editor.buffer.line(editor.row);
        int end = editor.col;
        while (remaining > 0 && end < line.size()) {
            end = MED_text.next_col(line, end);
            remaining = remaining - 1;
        }
        str text = line.substr(editor.col, end);
        str mapped = map_case(text, "g~");
        int shown = end;
        if (shown >= line.size()) {
            shown = MED_text.last_col(line);
        }
        if (shown > 0) {
            shown = MED_text.previous_col(line, shown);
        }
        if (mapped != text) {
            editor.change(MED_buffer.Pos(editor.row, editor.col), MED_buffer.Pos(editor.row, end), mapped);
            is_changed = true;
            set_op_marks(editor, MED_buffer.Pos(first_row, first_col), MED_buffer.Pos(editor.row, shown));
        } else if (!is_changed) {
            // Vim saves the line for undo before it finds that nothing changes
            editor.noop_node();
        }
        editor.col = end;
        if (editor.col >= line.size() && has_whichwrap(editor, "~") && editor.row + 1 < editor.buffer.line_count()) {
            editor.row = editor.row + 1;
            editor.col = 0;
            continue;
        }
        break;
    }
    if (editor.restart_edit == 0) {
        editor.clamp();
    }
    editor.want_from_cursor();
    return true;
}

// `r{char}`
bool did_cmd_replace_char(MED_editor.Editor editor, List<int> keys, int count) {
    int key = keys[1];
    if (key == 27) {
        return true;
    }
    str line = editor.buffer.line(editor.row);
    int total = count1(count);
    int end = editor.col;
    int done = 0;
    while (done < total && end < line.size()) {
        end = MED_text.next_col(line, end);
        done = done + 1;
    }
    if (done < total) {
        return false;
    }
    editor.regs.set_special(".", str.from_chars([key]));
    if (key == 13 || key == 10) {
        // Vim deletes the characters, then types <CR><Esc> in insert mode.
        editor.change(MED_buffer.Pos(editor.row, editor.col), MED_buffer.Pos(editor.row, end), "");
        List<int> saved_tail = editor.dot_tail;
        start_insert(editor, 114, 1, false);
        ins_cr(editor);
        finish_insert(editor);
        editor.dot_tail = saved_tail;
        return true;
    }
    int code_point = key;
    if (keys.size() == 3) {
        code_point = keys[2];
    }
    str one = str.from_chars([code_point]);
    editor.change(MED_buffer.Pos(editor.row, editor.col), MED_buffer.Pos(editor.row, end), one.repeat(total));
    set_op_marks(editor, MED_buffer.Pos(editor.row, editor.col), MED_buffer.Pos(editor.row, editor.col + one.size() * (total - 1)));
    editor.col = editor.col + one.size() * (total - 1);
    editor.clamp();
    editor.want_from_cursor();
    return true;
}

// `o` and `O`: open a line (Vim's open_line) and start inserting.
void cmd_open(MED_editor.Editor editor, bool is_below, int count) {
    // open below the last line of a closed fold, above its first line
    if (is_below) {
        int fold_end = editor.fold_end_of(editor.row);
        if (fold_end >= 0) {
            editor.row = fold_end;
        }
    } else {
        int fold_start = editor.fold_start_of(editor.row);
        if (fold_start >= 0) {
            editor.row = fold_start;
        }
    }
    str line = editor.buffer.line(editor.row);
    str indent = "";
    if (editor.is_autoindent || is_smartindent(editor)) {
        int base_width = indent_width(editor, line);
        if (editor.si_hash_indent > 0) {
            base_width = editor.si_hash_indent;
            editor.si_hash_indent = 0;
        }
        if (is_below) {
            base_width = smart_width(editor, line, base_width, editor.row, "");
        } else if (is_smartindent(editor)) {
            // above a line that starts with `}`: one level in
            int first = MED_text.first_nonblank(line);
            editor.has_si_extra = false;
            if (first < line.size() && line.byte_at(first) == 125) {
                base_width = base_width + editor.shift_size();
                editor.has_si_extra = true;
            }
            editor.can_si_back = true;
            editor.can_si = true;
        }
        indent = make_indent(editor, base_width);
    }
    if (is_below) {
        MED_buffer.Pos position = MED_buffer.Pos(editor.row, line.size());
        editor.change(position, position, "\n" + indent);
        editor.row = editor.row + 1;
    } else {
        MED_buffer.Pos position = MED_buffer.Pos(editor.row, 0);
        editor.change(position, position, indent + "\n");
    }
    editor.col = indent.size();
    int cmd = 111;
    if (!is_below) {
        cmd = 79;
    }
    start_insert(editor, cmd, count, false);
    // edit() is told "startln": the insert starts at the line's column 0
    editor.ins_start = MED_buffer.Pos(editor.row, 0);
    editor.ins_textlen = MED_text.line_width(editor.buffer.line(editor.row), editor.tab);
    editor.ins_mark = editor.ins_start;
    editor.did_ai = editor.is_autoindent || is_smartindent(editor);
}

bool did_cmd_join(MED_editor.Editor editor, int count, bool is_spaces) {
    int total = count;
    if (total <= 1) {
        total = 2;
    }
    if (editor.row + total > editor.buffer.line_count()) {
        if (total <= 2) {
            return false;
        }
        total = editor.buffer.line_count() - editor.row;
    }
    did_do_join(editor, editor.row, total, is_spaces);
    editor.clamp();
    editor.want_from_cursor();
    return true;
}

pub void cmd_undo(MED_editor.Editor editor, int count, bool is_redo) {
    bool is_any = false;
    for (int i in 0 .. count1(count)) {
        bool is_ok = false;
        if (is_redo) {
            is_ok = editor.did_redo();
        } else {
            is_ok = editor.did_undo();
        }
        if (!is_ok) {
            break;
        }
        is_any = true;
    }
    if (!is_any) {
        editor.is_failed = true;
    }
}

// g- and g+: step through the undo states in the order they were made.
bool did_cmd_undo_time(MED_editor.Editor editor, int count, bool is_forward) {
    editor.close_block();
    int total = count1(count);
    int target = editor.current - total;
    if (is_forward) {
        target = editor.current + total;
    }
    if (target < 0) {
        target = 0;
    }
    if (target > editor.nodes.size() - 1) {
        target = editor.nodes.size() - 1;
    }
    if (target == editor.current) {
        return false;
    }
    return editor.did_undo_to(target);
}

void enter_cmdline(MED_editor.Editor editor, int kind, List<int> saved) {
    editor.mode_before_cmd = editor.mode;
    editor.cmd_type = kind;
    set_cmdline(editor, "");
    editor.cmd_wait = 0;
    editor.hist_at = -1;
    editor.hist_prefix = "";
    editor.cmd_saved = saved;
    editor.mode = MED_editor.CMDLINE;
}

// A normal-mode command that is not an operator or a motion.
bool is_view_key(int key) {
    return key == 122 || key == 5 || key == 25 || key == 4 || key == 21 || key == 6 || key == 2;
}

// The window commands: CTRL-E CTRL-Y CTRL-D CTRL-U CTRL-F CTRL-B and z.
bool did_view_cmd(MED_editor.Editor editor, MED_parse.Parsed parsed) {
    int key = parsed.keys[0];
    int count = parsed.count;
    if (key == 122) {
        if (parsed.keys[1] == 70) {
            // zF: a fold of `count` lines from the cursor line (zfzf)
            int total = count;
            if (total < 1) {
                total = 1;
            }
            int last_row = editor.buffer.line_count() - 1;
            if (total > 1 && editor.row >= last_row) {
                return false;
            }
            MED_fold.create(editor, editor.row, MED_num.smaller(editor.row + total - 1, last_row));
            if (total == 1) {
                editor.col = MED_num.smaller(editor.col, first_nonblank_fix(editor.buffer.line(editor.row)));
            }
            editor.want_from_cursor();
            return true;
        }
        if (MED_fold.did_z_command(editor, parsed.keys[1], count)) {
            return true;
        }
        return MED_view.did_z_command(editor, parsed.keys[1], count);
    }
    if (key == 5 || key == 25) {
        MED_view.scroll_line(editor, key == 5, count1(count));
        return true;
    }
    if (key == 4 || key == 21) {
        if ((key == 21 && editor.row == 0) || (key == 4 && editor.row == editor.buffer.line_count() - 1)) {
            return false;
        }
        return MED_view.did_page(editor, key == 4, count, true);
    }
    return MED_view.did_page(editor, key == 6, count, false);
}

void run_cmd(MED_editor.Editor editor, MED_parse.Parsed parsed, List<int> typed) {
    int key = parsed.keys[0];
    int count = parsed.count;
    bool is_ok = true;
    if (key == 120) {
        is_ok = is_synonym(editor, parsed, "d", [108], false);
    } else if (key == 88) {
        is_ok = is_synonym(editor, parsed, "d", [104], false);
    } else if (key == 68) {
        is_ok = is_synonym(editor, parsed, "d", [36], false);
    } else if (key == 67) {
        is_ok = is_synonym(editor, parsed, "c", [36], false);
    } else if (key == 115) {
        is_ok = is_synonym(editor, parsed, "c", [108], false);
    } else if (key == 83) {
        is_ok = is_synonym(editor, parsed, "c", [99], true);
    } else if (key == 89) {
        is_ok = did_operate(editor, "y", parsed.reg, parsed.count, [36], false, 0);
    } else if (key == 112 || key == 80) {
        record_dot(editor, parsed);
        int directory = 1;
        if (key == 80) {
            directory = -1;
        }
        is_ok = did_do_put(editor, parsed.reg, directory, count, false);
        editor.clamp();
        editor.want_from_cursor();
    } else if ((key == 93 || key == 91) && parsed.keys.size() == 2 && (parsed.keys[1] == 112 || parsed.keys[1] == 80)) {
        // ]p [p ]P [P: put and fix the indent to the current line
        record_dot(editor, parsed);
        int directory = -1;
        if (key == 93 && parsed.keys[1] == 112) {
            directory = 1;
        }
        Option<MED_register.Reg> found = editor.regs.get(parsed.reg);
        match (found) {
            case None: {
                editor.message = "E353: Nothing in register " + parsed.reg;
                editor.noop_node();
                is_ok = false;
            }
            case Some(MED_register.Reg reg): {
                is_ok = did_put_reg(editor, reg, directory, count, false, PUT_FIXINDENT, 0);
            }
        }
        editor.clamp();
        editor.want_from_cursor();
    } else if (key == 117) {
        int undo_tick = editor.buffer.tick;
        cmd_undo(editor, count, false);
        if (editor.folds.size() > 0 && !editor.is_replaying && editor.buffer.tick != undo_tick) {
            MED_fold.open_at(editor, editor.row);
        }
    } else if (key == 85) {
        if (!editor.did_undo_line()) {
            editor.is_failed = true;
        }
        editor.end_block();
    } else if (key == 18) {
        int redo_tick = editor.buffer.tick;
        cmd_undo(editor, count, true);
        if (editor.folds.size() > 0 && !editor.is_replaying && editor.buffer.tick != redo_tick) {
            MED_fold.open_at(editor, editor.row);
        }
    } else if (key == 46) {
        dot_repeat(editor, count);
    } else if (key == 105 || key == 97 || key == 73 || key == 65) {
        record_dot(editor, parsed);
        str line = editor.buffer.line(editor.row);
        if (key == 97 && line.size() > 0) {
            editor.col = MED_text.next_col(line, editor.col);
        } else if (key == 65) {
            editor.col = line.size();
        } else if (key == 73) {
            editor.col = MED_text.first_nonblank(line);
        }
        start_insert(editor, key, count, false);
    } else if (key == 111 || key == 79) {
        record_dot(editor, parsed);
        cmd_open(editor, key == 111, count);
    } else if (key == 82) {
        record_dot(editor, parsed);
        start_insert(editor, 82, count, true);
    } else if (key == 74) {
        record_dot(editor, parsed);
        is_ok = did_cmd_join(editor, count, true);
    } else if (key == 126) {
        record_dot(editor, parsed);
        is_ok = did_cmd_tilde(editor, count);
    } else if (key == 1 || key == 24) {
        record_dot(editor, parsed);
        is_ok = did_cmd_addsub(editor, key == 24, count);
    } else if (key == 114) {
        record_dot(editor, parsed);
        is_ok = did_cmd_replace_char(editor, parsed.keys, count);
    } else if (key == 109) {
        set_mark(editor, parsed.keys[1]);
    } else if (key == 113) {
        int name = parsed.keys[1];
        if (MED_parse.is_valid_register(name) && ((name >= 97 && name <= 122) || (name >= 65 && name <= 90) || (name >= 48 && name <= 57) || name == 34)) {
            editor.macro_reg = str.from_chars([name]);
            editor.macro_keys = [];
        } else {
            is_ok = false;
        }
    } else if (key == 64) {
        run_macro(editor, str.from_chars([parsed.keys[1]]), count);
    } else if (key == 118 || key == 86 || key == 22) {
        enter_visual(editor, key);
        if (count > 1 && editor.dot_vkind == 0) {
            // With a count, select that many characters or lines.
            int step = 108;
            if (key == 86) {
                step = 106;
            }
            MED_motion.Motion motion = run_motion(editor, [step], count - 1, "");
            if (motion.is_ok) {
                apply_motion(editor, motion);
            }
        }
    } else if (key == 58 || key == 47 || key == 63) {
        enter_cmdline(editor, key, typed);
        if (key == 58 && count > 0) {
            if (count == 1) {
                set_cmdline(editor, ".");
            } else {
                set_cmdline(editor, ".,.+" + (count - 1).to_str());
            }
        }
    } else if (key == 38) {
        editor.ex_queue.push("&&");
    } else if (key == 103) {
        is_ok = did_run_g(editor, parsed, typed);
    } else if (key == 90) {
        int second = parsed.keys[1];
        if (second == 90 || second == 81) {
            if (second == 90) {
                // ZZ is :x: the UI layer writes the file
                editor.requests.push("update ");
            }
            editor.is_quit = true;
            editor.is_quit_one = true;
            editor.is_force_quit = second == 81;
        } else {
            is_ok = false;
        }
    } else if (key == 27) {
        editor.pending = [];
    } else if (is_view_key(key)) {
        is_ok = did_view_cmd(editor, parsed);
    } else if (key == 12 || key == 7) {
        editor.pending = [];
    } else if (key == 30) {
        // CTRL-^: the alternate buffer, or buffer COUNT: the UI layer switches
        if (count > 0) {
            editor.requests.push("buffer " + count.to_str());
        } else {
            editor.requests.push("buffer #");
        }
    } else {
        is_ok = false;
    }
    if (!is_ok) {
        editor.is_failed = true;
    }
}

bool did_run_g(MED_editor.Editor editor, MED_parse.Parsed parsed, List<int> typed) {
    int second = parsed.keys[1];
    int count = parsed.count;
    if (second == 45 || second == 43) {
        return did_cmd_undo_time(editor, count, second == 43);
    }
    if (second == 74) {
        record_dot(editor, parsed);
        return did_cmd_join(editor, count, false);
    }
    if (second == 112 || second == 80) {
        record_dot(editor, parsed);
        int directory = 1;
        if (second == 80) {
            directory = -1;
        }
        bool is_ok = did_do_put(editor, parsed.reg, directory, count, true);
        editor.clamp();
        editor.want_from_cursor();
        return is_ok;
    }
    if (second == 82) {
        // gR: Virtual Replace mode, handled like Replace mode
        record_dot(editor, parsed);
        start_insert(editor, 82, count, true);
        editor.is_virtual = true;
        editor.virtual_lines = editor.buffer.line_count();
        return true;
    }
    if (second == 73) {
        record_dot(editor, parsed);
        editor.col = 0;
        start_insert(editor, 73, count, false);
        return true;
    }
    if (second == 105) {
        record_dot(editor, parsed);
        Option<MED_buffer.Pos> mark = editor.marks.get("^");
        match (mark) {
            case Some(MED_buffer.Pos position): {
                editor.row = MED_num.smaller(position.row, editor.buffer.line_count() - 1);
                editor.col = MED_num.smaller(position.col, editor.buffer.line_size(editor.row));
            }
            case None: {
            }
        }
        start_insert(editor, 105, count, false);
        return true;
    }
    if (second == 118) {
        return did_reselect(editor);
    }
    if (second == 38) {
        editor.ex_queue.push("%s//~/&");
        return true;
    }
    if (second == 116 || second == 84) {
        // gt / gT: the next / previous tab page, or page COUNT (gt)
        str word = "tabnext";
        if (second == 84) {
            word = "tabprevious";
        }
        if (count > 0) {
            word = word + " " + count.to_str();
        }
        editor.requests.push(word);
        return true;
    }
    return true;
}

// ------------------------------------------------------------------ mapping

/// The table the next key is looked up in when mappings apply: "n", "x", "o"
/// (an operator waits for its motion), "i" (Insert and Replace) or "c" (command
/// line). "" when the next key is an argument of a command (`r`, `f`, `m`, `q`,
/// the key after `g` or `z`, a text-object kind, CTRL-V in Insert...), which
/// Vim never maps.
pub str map_mode(MED_editor.Editor editor) {
    if (editor.sub_run.is_active) {
        return "";
    }
    if (editor.mode == MED_editor.INSERT || editor.mode == MED_editor.REPLACE) {
        if (editor.ins_wait != 0) {
            return "";
        }
        return "i";
    }
    if (editor.mode == MED_editor.CMDLINE) {
        return "c";
    }
    bool has_selection = editor.mode == MED_editor.VISUAL;
    str base = "n";
    if (has_selection) {
        base = "x";
    }
    List<int> keys = editor.pending;
    int amount = keys.size();
    int index = 0;
    while (index < amount) {
        int key = keys[index];
        if (key == 34) {
            if (index + 1 >= amount) {
                return "";
            }
            index = index + 2;
        } else if (key >= 49 && key <= 57) {
            index = index + 1;
            while (index < amount && keys[index] >= 48 && keys[index] <= 57) {
                index = index + 1;
            }
        } else {
            break;
        }
    }
    if (index >= amount) {
        return base;
    }
    if (has_selection) {
        return "";
    }
    MED_parse.OpAt found = MED_parse.op_at(keys, index);
    if (found.length <= 0) {
        return "";
    }
    index = index + found.length;
    while (index < amount) {
        int key = keys[index];
        if (key == 118 || key == 86 || key == 22 || (key >= 48 && key <= 57)) {
            index = index + 1;
        } else {
            break;
        }
    }
    if (index >= amount) {
        return "o";
    }
    return "";
}

// ---------------------------------------------------------------------- feed

/// Process one key in whatever mode `editor` is in.
pub void feed(MED_editor.Editor editor, int key) {
    MED_autofold.sync(editor);
    editor.is_restart_skip = false;
    int tick_before = editor.buffer.tick;
    feed_key(editor, key);
    try_restart(editor);
    if (editor.buffer.tick != tick_before && editor.mode == MED_editor.NORMAL && editor.folds.size() > 0 && editor.row == editor.buffer.line_count() - 1) {
        // lines were deleted below the cursor: nvim's check_cursor_lnum() puts the cursor on the first line of a
        // closed fold that ends the buffer
        int fold_first = editor.fold_start_of(editor.row);
        if (fold_first >= 0) {
            editor.row = fold_first;
            editor.clamp();
        }
    }
    MED_view.update(editor);
}

// Back to Insert mode after the Normal command that CTRL-O allowed (Vim's
// edit() with restart_edit).
pub void try_restart(MED_editor.Editor editor) {
    if (editor.restart_edit == 0 || editor.is_restart_skip || editor.mode != MED_editor.NORMAL || editor.pending.size() > 0) {
        return;
    }
    if (editor.ex_queue.size() > 0 || editor.resume.size() > 0) {
        return;
    }
    bool is_replace = editor.restart_edit == 82;
    str line = editor.buffer.line(editor.row);
    bool is_beyond = false;
    if (editor.col < line.size()) {
        is_beyond = editor.want < 0 || editor.want > MED_text.display_col(line, editor.col, editor.tab);
    }
    start_insert(editor, 105, 1, is_replace);
    editor.is_ins_arrow = true;
    editor.is_ins_restart = true;
    // Insstart is the cursor before it moves past the last character, unless the wanted column forces it
    MED_buffer.Pos start = MED_buffer.Pos(editor.row, editor.col);
    if (editor.col < line.size()) {
        if ((editor.is_ins_at_eol && editor.row == editor.o_lnum) || is_beyond) {
            int next_offset = MED_text.next_col(line, editor.col);
            if (next_offset >= line.size()) {
                editor.col = next_offset;
            }
        }
    }
    editor.is_ins_at_eol = false;
    if (is_beyond) {
        // wanted column past the line: Insstart follows the cursor (checked against nvim)
        start = MED_buffer.Pos(editor.row, editor.col);
    }
    editor.ins_start = start;
    editor.ins_mark = start;
}

void feed_key(MED_editor.Editor editor, int key) {
    if (editor.needs_stale) {
        editor.needs_stale = false;
        editor.want_from_cursor();
    }
    if (editor.sur_stage != 0) {
        if (editor.macro_reg != "" && !editor.is_replaying) {
            editor.macro_keys.push(key);
        }
        sur_feed(editor, key);
        return;
    }
    if (editor.macro_reg != "" && !editor.is_replaying) {
        bool is_stop = key == 113 && editor.pending.size() == 0 && (editor.mode == MED_editor.NORMAL || editor.mode == MED_editor.VISUAL);
        if (editor.is_char_done && !is_stop) {
            // nvim records K_IGNORE after the character of f, t, r ... once more keys follow
            editor.macro_keys.push(MED_key.IGNORE);
        }
        editor.macro_keys.push(key);
    }
    editor.is_char_done = false;
    if (editor.mode == MED_editor.INSERT || editor.mode == MED_editor.REPLACE) {
        insert_key(editor, key);
        return;
    }
    if (editor.mode == MED_editor.CMDLINE) {
        cmdline_key(editor, key);
        return;
    }
    if (key == 113 && editor.macro_reg != "" && editor.pending.size() == 0 && (editor.mode == MED_editor.NORMAL || editor.mode == MED_editor.VISUAL)) {
        stop_recording(editor);
        return;
    }
    if (did_begin_surround_command(editor, key)) {
        return;
    }
    int cmd_key = key;
    if (key == 63240 && (editor.pending.size() == 0 || (editor.pending[editor.pending.size() - 1] >= 48 && editor.pending[editor.pending.size() - 1] <= 57))) {
        cmd_key = 120;
    }
    editor.pending.push(cmd_key);
    feed_pending(editor);
}

// `q` while recording: the register gets the keys typed since `q{reg}`.
void stop_recording(MED_editor.Editor editor) {
    if (editor.macro_keys.size() > 0) {
        editor.macro_keys.pop();
    }
    str text = MED_key.encode(editor.macro_keys);
    editor.regs.set_named(editor.macro_reg, MED_register.Reg(text.split("\n"), MED_register.CHAR));
    editor.macro_reg = "";
    editor.macro_keys = [];
}

// Parse what is pending and run it once it is a whole command.
void feed_pending(MED_editor.Editor editor) {
    if (!editor.is_expr_ready && is_expr_register_pending(editor.pending)) {
        // `"=` asks for an expression on the command line before the command
        editor.mode_before_cmd = editor.mode;
        editor.expr_from = 3;
        editor.expr_line = "";
        editor.expr_position = 0;
        editor.expr_type = 58;
        editor.expr_hist_at = -1;
        editor.expr_hist_prefix = "";
        editor.hist_at = -1;
        editor.hist_prefix = "";
        editor.cmd_type = 61;
        editor.cmd_wait = 0;
        editor.cmd_saved = editor.pending;
        editor.pending = [];
        set_cmdline(editor, "");
        editor.mode = MED_editor.CMDLINE;
        return;
    }
    MED_parse.Parsed parsed = MED_parse.parse(editor.pending, editor.mode == MED_editor.VISUAL);
    if (parsed.status == MED_parse.NEED_MORE) {
        return;
    }
    List<int> typed = editor.pending;
    editor.pending = [];
    if (parsed.keys.size() == 2 && (parsed.keys[0] == 102 || parsed.keys[0] == 116 || parsed.keys[0] == 70 || parsed.keys[0] == 84 || parsed.keys[0] == 114)) {
        editor.is_char_done = true;
    }
    if (parsed.keys.size() == 3 && parsed.keys[0] == 103 && parsed.keys[1] == 114) {
        editor.is_char_done = true;
    }
    if (parsed.status == MED_parse.INVALID) {
        if (!(typed.size() > 0 && typed[typed.size() - 1] == 27)) {
            editor.is_failed = true;
        }
        return;
    }
    execute(editor, parsed, typed);
}

// Whether the pending keys are a count and then `"=`.
bool is_expr_register_pending(List<int> keys) {
    int size = keys.size();
    if (size < 2 || keys[size - 2] != 34 || keys[size - 1] != 61) {
        return false;
    }
    int index = 0;
    while (index < size - 2) {
        if (keys[index] >= 48 && keys[index] <= 57) {
            index = index + 1;
        } else if (keys[index] == 34 && index + 1 < size - 2) {
            // an earlier register prefix
            index = index + 2;
        } else {
            return false;
        }
    }
    return true;
}

pub void feed_keys(MED_editor.Editor editor, List<int> keys) {
    for (int key in keys) {
        feed(editor, key);
    }
}

// Run a whole parsed command; Vim's normal_cmd() ends with checkpcmark().
void execute(MED_editor.Editor editor, MED_parse.Parsed parsed, List<int> typed) {
    execute_inner(editor, parsed, typed);
    if (editor.mode != MED_editor.INSERT && editor.mode != MED_editor.REPLACE && editor.mode != MED_editor.CMDLINE) {
        editor.check_pcmark();
    }
}

// The motions that open the closed fold they end in ('foldopen' "hor", "search",
// "percent", "block" and "mark").
bool is_fold_opening_motion(List<int> keys) {
    int key = keys[0];
    List<int> plain = [104, 108, 32, 127, 8, 48, 94, 36, 119, 87, 98, 66, 101, 69, 102, 70, 116, 84, 59, 44, 47, 63, 110, 78, 42, 35, 37, 40, 41, 123, 125, 39, 96];
    for (int one in plain) {
        if (one == key) {
            return true;
        }
    }
    if ((key == 103 || key == 91 || key == 93) && keys.size() > 1) {
        int second = keys[1];
        if (key == 103) {
            return second == 95 || second == 48 || second == 94 || second == 36 || second == 109 || second == 101 || second == 69 || second == 42 || second == 35 || second == 39 || second == 96;
        }
        return second == 91 || second == 93;
    }
    return false;
}

void execute_inner(MED_editor.Editor editor, MED_parse.Parsed parsed, List<int> typed) {
    if (!editor.is_replaying) {
        editor.is_failed = false;
    }
    if (editor.mode == MED_editor.VISUAL) {
        execute_visual(editor, parsed, typed);
        return;
    }
    if (parsed.kind == MED_parse.K_MOTION || parsed.kind == MED_parse.K_OP) {
        if (parsed.keys.size() == 1 && (parsed.keys[0] == 47 || parsed.keys[0] == 63) && !editor.is_search_ready) {
            enter_cmdline(editor, parsed.keys[0], typed);
            return;
        }
    }
    if (parsed.kind == MED_parse.K_MOTION) {
        if (is_gn_keys(parsed.keys)) {
            gn_command(editor, parsed.count, parsed.keys[1] == 110, false);
            return;
        }
        MED_motion.Motion motion = run_motion(editor, parsed.keys, parsed.count, "");
        if (motion.is_ok) {
            apply_motion(editor, motion);
            if (motion.is_beep) {
                editor.is_failed = true;
            } else if (editor.folds.size() > 0 && !editor.is_in_dot && !editor.is_replaying && is_fold_opening_motion(parsed.keys)) {
                // 'foldopen': horizontal moves, searches, % ( ) { } and marks open the fold
                MED_fold.open_at(editor, editor.row);
            }
        } else {
            editor.is_failed = true;
        }
        return;
    }
    if (parsed.kind == MED_parse.K_OP) {
        str s_reg = editor.dot_reg;
        int s_count = editor.dot_count;
        List<int> s_body = editor.dot_body;
        List<int> s_tail = editor.dot_tail;
        int s_vkind = editor.dot_vkind;
        if (parsed.operator != "y" && parsed.operator != "zf") {
            record_dot(editor, parsed);
        }
        List<int> operate_keys = parsed.keys;
        bool is_operate_doubled = parsed.is_doubled;
        if (is_operate_doubled && parsed.operator == "ys") {
            // yss: from the first non-blank to the last one (`^` then `g_`)
            editor.col = first_nonblank_fix(editor.buffer.line(editor.row));
            editor.want_from_cursor();
            operate_keys = [103, 95];
            is_operate_doubled = false;
        } else if (is_operate_doubled && parsed.operator == "yS") {
            operate_keys = [95];
            is_operate_doubled = false;
        }
        if (!is_operate_doubled && parsed.is_doubled && !editor.is_in_dot && (parsed.operator == "ys" || parsed.operator == "yS")) {
            // the plugin maps yss to `^` and g@ g_: `.` repeats the operator
            // and its motion from where the cursor is, without the `^`
            List<int> repeat_body = [121, parsed.operator.byte_at(1)];
            for (int key_code in operate_keys) {
                repeat_body.push(key_code);
            }
            editor.dot_body = repeat_body;
        }
        bool is_ok = did_operate(editor, parsed.operator, parsed.reg, parsed.count, operate_keys, is_operate_doubled, parsed.force);
        if (!is_ok) {
            editor.is_failed = true;
            if (!editor.is_in_dot) {
                editor.dot_reg = s_reg;
                editor.dot_count = s_count;
                editor.dot_body = s_body;
                editor.dot_tail = s_tail;
                editor.dot_vkind = s_vkind;
            }
        }
        if (editor.mode == MED_editor.NORMAL) {
            editor.end_block();
        }
        return;
    }
    run_cmd(editor, parsed, typed);
    if (editor.mode == MED_editor.NORMAL) {
        editor.end_block();
    }
}

// ------------------------------------------------------------------- Visual

const int MAXCOL = 2000000000;

int vcol_start(MED_editor.Editor editor, int row, int col) {
    return MED_text.display_col(editor.buffer.line(row), col, editor.tab);
}

int vcol_end(MED_editor.Editor editor, int row, int col) {
    str line = editor.buffer.line(row);
    int text = MED_text.display_col(line, col, editor.tab);
    if (col >= line.size()) {
        return text;
    }
    return text + MED_text.cell_width(line, col, text, editor.tab) - 1;
}

bool did_op_on_lines(str operator) {
    return operator == "<" || operator == ">" || operator == "J" || operator == "gJ";
}

// Remember the selection for `gv` and the '< '> marks.
void save_visual(MED_editor.Editor editor, int kind) {
    editor.last_vkind = kind;
    editor.last_vstart = MED_buffer.Pos(editor.vrow, editor.vcol);
    editor.last_vend = MED_buffer.Pos(editor.row, editor.col);
    editor.last_vwant = editor.want;
    MED_buffer.Pos position = MED_buffer.Pos(editor.vrow, editor.vcol);
    MED_buffer.Pos position_value = MED_buffer.Pos(editor.row, editor.col);
    if (is_position_before(position_value, position)) {
        MED_buffer.Pos position_item = position;
        position = position_value;
        position_value = position_item;
    }
    if (kind == 86) {
        position = MED_buffer.Pos(position.row, 0);
        position_value = MED_buffer.Pos(position_value.row, MAXCOL);
    }
    editor.marks.set("<", position);
    editor.marks.set(">", position_value);
}

// Leave Visual mode, the cursor stays (but never on the NUL).
void leave_visual(MED_editor.Editor editor) {
    save_visual(editor, editor.vkind);
    editor.mode = MED_editor.NORMAL;
    editor.vkind = 0;
    str line = editor.buffer.line(editor.row);
    if (editor.col > 0 && editor.col >= line.size()) {
        editor.col = MED_text.last_col(line);
    }
    editor.clamp();
}

// `.` after a Visual operator: select an area of the same size at the cursor.
void setup_visual_redo(MED_editor.Editor editor) {
    int kind = editor.dot_vkind;
    editor.mode = MED_editor.VISUAL;
    editor.vkind = kind;
    editor.vrow = editor.row;
    editor.vcol = editor.col;
    int last = editor.buffer.line_count() - 1;
    int end_row = MED_num.smaller(editor.row + editor.dot_vlines - 1, last);
    int vcols = editor.dot_vcols;
    editor.row = end_row;
    if (kind == 118) {
        int want = vcols;
        if (vcols < MAXCOL && editor.dot_vlines <= 1) {
            want = vcol_start(editor, editor.vrow, editor.vcol) + vcols - 1;
        }
        if (vcols >= MAXCOL) {
            want = -1;
        }
        editor.want = want;
        editor.col = MED_motion.col_for_want(editor.buffer.line(end_row), want, editor.tab, true);
    } else if (vcols >= MAXCOL) {
        editor.want = -1;
        editor.col = MED_motion.col_for_want(editor.buffer.line(end_row), -1, editor.tab, true);
    } else {
        editor.col = MED_num.smaller(editor.col, editor.buffer.line_size(end_row));
    }
    editor.is_visible_redo = true;
}

void enter_visual(MED_editor.Editor editor, int kind) {
    editor.mode = MED_editor.VISUAL;
    editor.vkind = kind;
    editor.vrow = editor.row;
    editor.vcol = editor.col;
}

// `gv`: select the previous area again (swapping with the current one).
bool did_reselect(MED_editor.Editor editor) {
    if (editor.last_vkind == 0) {
        return false;
    }
    int kind = editor.last_vkind;
    MED_buffer.Pos position = editor.last_vstart;
    MED_buffer.Pos position_value = editor.last_vend;
    int want = editor.last_vwant;
    if (editor.mode == MED_editor.VISUAL) {
        save_visual(editor, editor.vkind);
    }
    editor.mode = MED_editor.VISUAL;
    editor.vkind = kind;
    int last = editor.buffer.line_count() - 1;
    editor.vrow = MED_num.smaller(position.row, last);
    editor.vcol = MED_num.smaller(position.col, editor.buffer.line_size(editor.vrow));
    editor.row = MED_num.smaller(position_value.row, last);
    editor.col = MED_num.smaller(position_value.col, editor.buffer.line_size(editor.row));
    editor.want = want;
    editor.clamp();
    return true;
}

// The selection as an operator target (Vim's do_pending_operator with
// VIsual_active).
Oap visual_oap(MED_editor.Editor editor, str operator, str reg) {
    Oap oap = Oap();
    oap.operator = operator;
    oap.reg = reg;
    oap.is_visual = true;
    oap.cursor_row = editor.row;
    oap.cursor_col = editor.col;
    MED_buffer.Pos position = MED_buffer.Pos(editor.vrow, editor.vcol);
    MED_buffer.Pos position_value = MED_buffer.Pos(editor.row, editor.col);
    if (editor.vkind == 22) {
        return block_oap(editor, oap);
    }
    if (editor.vkind == 86 && !editor.is_visible_redo) {
        // a redo (`.`) keeps the column the cursor was at: undo returns there
        position = MED_buffer.Pos(position.row, 0);
    }
    if (editor.folds.size() > 0 && !editor.is_fold_off) {
        // a selection that starts in a closed fold takes the whole fold at its
        // start, and all of it when it stays inside that fold
        bool is_ahead = !is_position_before(position_value, position);
        MED_buffer.Pos low = position;
        MED_buffer.Pos high = position_value;
        if (!is_ahead) {
            low = position_value;
            high = position;
        }
        int low_start = editor.fold_start_of(low.row);
        int high_end = editor.fold_end_of(high.row);
        if (low_start >= 0) {
            int low_end = editor.fold_end_of(low.row);
            low = MED_buffer.Pos(low_start, 0);
            if (high_end >= 0 && high_end == low_end) {
                high = MED_buffer.Pos(high_end, editor.buffer.line_size(high_end));
            }
        }
        if (is_ahead) {
            position = low;
            position_value = high;
        } else {
            position_value = low;
            position = high;
        }
    }
    if (is_position_before(position, position_value)) {
        oap.start = position;
        oap.end = position_value;
    } else {
        oap.start = position_value;
        oap.end = position;
    }
    position = oap.start;
    position_value = oap.end;
    oap.line_count = position_value.row - position.row + 1;
    oap.rlines = oap.line_count;
    oap.rvcol = MAXCOL;
    if (editor.want != -1) {
        int end_vcol = vcol_end(editor, position_value.row, position_value.col);
        if (oap.line_count <= 1) {
            oap.rvcol = end_vcol - vcol_start(editor, position.row, position.col) + 1;
        } else {
            oap.rvcol = end_vcol;
        }
    }
    oap.is_inclusive = true;
    if (editor.vkind == 86) {
        oap.is_linewise = true;
        return oap;
    }
    str line = editor.buffer.line(position_value.row);
    if (position_value.col >= line.size()) {
        oap.is_inclusive = false;
        if (!did_op_on_lines(operator) && position_value.row < editor.buffer.line_count() - 1) {
            oap.end = MED_buffer.Pos(position_value.row + 1, 0);
            oap.line_count = oap.line_count + 1;
        }
    }
    bool is_at_nul = oap.end.col >= editor.buffer.line_size(oap.end.row);
    oap.is_empty = oap.start.eq(oap.end) && (!oap.is_inclusive || (operator == "y" && is_at_nul));
    return oap;
}

// The corners of a block selection.
Oap block_oap(MED_editor.Editor editor, Oap oap) {
    int top = MED_num.smaller(editor.vrow, editor.row);
    int bottom = MED_num.larger(editor.vrow, editor.row);
    int start_a = vcol_start(editor, editor.vrow, editor.vcol);
    int end_a = vcol_end(editor, editor.vrow, editor.vcol);
    int start_b = vcol_start(editor, editor.row, editor.col);
    int end_b = vcol_end(editor, editor.row, editor.col);
    int left_vcol = MED_num.smaller(start_a, start_b);
    int right_vcol = MED_num.larger(end_a, end_b);
    bool is_eol = editor.want == -1;
    if (editor.is_visible_redo) {
        left_vcol = start_a;
        is_eol = editor.dot_vcols >= MAXCOL;
        right_vcol = left_vcol + editor.dot_vcols - 1;
    }
    if (is_eol) {
        right_vcol = 0;
        for (int row in top .. bottom + 1) {
            right_vcol = MED_num.larger(right_vcol, MED_text.line_width(editor.buffer.line(row), editor.tab));
        }
    }
    oap.is_block = true;
    oap.left_vcol = left_vcol;
    oap.right_vcol = right_vcol;
    oap.is_eol = is_eol;
    oap.is_inclusive = true;
    oap.line_count = bottom - top + 1;
    oap.rlines = oap.line_count;
    oap.rvcol = right_vcol - left_vcol + 1;
    if (is_eol) {
        oap.rvcol = MAXCOL;
    }
    oap.start = MED_buffer.Pos(top, MED_motion.col_for_want(editor.buffer.line(top), left_vcol, editor.tab, true));
    oap.end = MED_buffer.Pos(bottom, MED_motion.col_for_want(editor.buffer.line(bottom), right_vcol, editor.tab, true));
    return oap;
}

/// How one line meets a block: the bytes of the characters it overlaps, the
/// columns of a split character that fall outside the block, and the text a
/// yank takes (a split character becomes spaces).
type BlockCut {
    bool is_too_short = false;
    bool is_ends_inside = false;
    int from = 0;
    int target_position = 0;
    int pre = 0;
    int post = 0;
    int last_width = 0;
    str text = "";
}

BlockCut block_cut(MED_editor.Editor editor, str line, int left_vcol, int right_vcol, bool is_eol) {
    BlockCut block_cut_value = BlockCut();
    int position = 0;
    int vcol = 0;
    bool is_found = false;
    List<str> parts = [];
    while (position < line.size()) {
        int next = MED_text.next_col(line, position);
        int width = MED_text.cell_width(line, position, vcol, editor.tab);
        int first_char = vcol;
        int second_char = vcol + width - 1;
        if (!is_eol && first_char > right_vcol) {
            break;
        }
        if (second_char >= left_vcol) {
            if (!is_found) {
                is_found = true;
                block_cut_value.from = position;
                if (first_char < left_vcol) {
                    block_cut_value.pre = left_vcol - first_char;
                }
            }
            block_cut_value.target_position = next;
            block_cut_value.post = 0;
            if (!is_eol && second_char > right_vcol) {
                block_cut_value.post = second_char - right_vcol;
            }
            if (first_char >= left_vcol && (is_eol || second_char <= right_vcol)) {
                parts.push(line.substr(position, next));
            } else {
                int low = MED_num.larger(first_char, left_vcol);
                int high = second_char;
                if (!is_eol) {
                    high = MED_num.smaller(second_char, right_vcol);
                }
                parts.push(" ".repeat(high - low + 1));
            }
        }
        vcol = vcol + width;
        position = next;
    }
    block_cut_value.last_width = MED_text.line_width(line, editor.tab);
    if (!is_found) {
        block_cut_value.is_too_short = true;
        block_cut_value.from = line.size();
        block_cut_value.target_position = line.size();
    }
    block_cut_value.is_ends_inside = !is_eol && block_cut_value.last_width <= right_vcol;
    block_cut_value.text = parts.join("");
    return block_cut_value;
}

MED_register.Reg block_reg(MED_editor.Editor editor, Oap oap) {
    List<str> lines = [];
    for (int row in oap.start.row .. oap.end.row + 1) {
        // Vim's op_yank: block_prep for a yank, so short lines are padded
        BlockPrep prepared = block_prep(editor, "", oap.left_vcol, oap.right_vcol, row, false);
        str line = editor.buffer.line(row);
        str text = line.substr(prepared.textcol, prepared.textcol + prepared.textlen);
        lines.push(" ".repeat(prepared.startspaces) + text + " ".repeat(prepared.endspaces));
    }
    MED_register.Reg reg = MED_register.Reg(lines, MED_register.BLOCK);
    if (oap.is_eol) {
        reg.width = 1;
        if (oap.right_vcol - oap.left_vcol > 0) {
            reg.width = oap.right_vcol - oap.left_vcol;
        }
    } else {
        reg.width = oap.right_vcol - oap.left_vcol + 1;
    }
    return reg;
}

void block_delete(MED_editor.Editor editor, Oap oap) {
    MED_register.Reg reg = block_reg(editor, oap);
    editor.regs.delete(oap.reg, reg, oap.line_count > 1, oap.line_count == 1);
    int first_col = oap.start.col;
    touch_at(editor, oap.start);
    for (int row in oap.start.row .. oap.end.row + 1) {
        BlockCut block_cut_value = block_cut(editor, editor.buffer.line(row), oap.left_vcol, oap.right_vcol, oap.is_eol);
        if (block_cut_value.is_too_short || block_cut_value.target_position <= block_cut_value.from) {
            continue;
        }
        if (row == oap.start.row) {
            first_col = block_cut_value.from + block_cut_value.pre;
        }
        editor.change(MED_buffer.Pos(row, block_cut_value.from), MED_buffer.Pos(row, block_cut_value.target_position), " ".repeat(block_cut_value.pre + block_cut_value.post));
    }
    editor.override_change(MED_buffer.Pos(oap.start.row, first_col));
    editor.row = oap.start.row;
    editor.col = first_col;
}

void block_case(MED_editor.Editor editor, Oap oap) {
    touch_at(editor, oap.start);
    for (int row in oap.start.row .. oap.end.row + 1) {
        str line = editor.buffer.line(row);
        BlockCut block_cut_value = block_cut(editor, line, oap.left_vcol, oap.right_vcol, oap.is_eol);
        if (block_cut_value.is_too_short || block_cut_value.target_position <= block_cut_value.from) {
            continue;
        }
        str text = line.substr(block_cut_value.from, block_cut_value.target_position);
        str mapped = map_case(text, oap.operator);
        if (mapped != text) {
            editor.change(MED_buffer.Pos(row, block_cut_value.from), MED_buffer.Pos(row, block_cut_value.target_position), mapped);
        }
    }
    editor.row = oap.start.row;
    editor.col = oap.start.col;
}

// `r{char}` over a block.
void block_replace(MED_editor.Editor editor, Oap oap, int code_point) {
    str character = str.from_chars([code_point]);
    int char_width = MED_text.cell_width(character, 0, 0, editor.tab);
    touch_at(editor, oap.start);
    for (int row in oap.start.row .. oap.end.row + 1) {
        str line = editor.buffer.line(row);
        BlockCut block_cut_value = block_cut(editor, line, oap.left_vcol, oap.right_vcol, oap.is_eol);
        if (block_cut_value.is_too_short) {
            continue;
        }
        int numc = oap.right_vcol - oap.left_vcol + 1;
        bool is_short_end = oap.is_eol || block_cut_value.last_width <= oap.right_vcol;
        if (is_short_end) {
            numc = block_cut_value.last_width - oap.left_vcol;
        }
        int post = block_cut_value.post;
        if (char_width > 1) {
            if (numc % 2 == 1 && !is_short_end) {
                post = post + 1;
            }
            numc = numc / 2;
        }
        str fresh = " ".repeat(block_cut_value.pre) + character.repeat(numc) + " ".repeat(post);
        editor.change(MED_buffer.Pos(row, block_cut_value.from), MED_buffer.Pos(row, block_cut_value.target_position), fresh);
    }
    editor.row = oap.start.row;
    editor.col = oap.start.col;
}

bool is_blank_byte(int right) {
    return right == 32 || right == 9;
}

// Vim's shift_block for one line.
void block_shift_line(MED_editor.Editor editor, Oap oap, int row, bool is_left) {
    str line = editor.buffer.line(row);
    if (line.size() == 0) {
        return;
    }
    BlockCut block_cut_value = block_cut(editor, line, oap.left_vcol, oap.right_vcol, oap.is_eol);
    if (block_cut_value.is_too_short || (!is_left && false)) {
        return;
    }
    int total = oap.amount * editor.shift_size();
    int from = block_cut_value.from;
    if (block_cut_value.pre > 0) {
        // the block starts inside a character: continue after it
        from = block_cut_value.target_position;
        if (from > line.size()) {
            from = line.size();
        }
    }
    int start_vcol = MED_text.display_col(line, from, editor.tab);
    if (!is_left) {
        int pre_c = 0;
        int back = from;
        while (back > 0 && is_blank_byte(line.byte_at(back - 1))) {
            back = back - 1;
            pre_c = pre_c + 1;
        }
        int ws_vcol = MED_text.display_col(line, back, editor.tab);
        total = total + (start_vcol - ws_vcol);
        int offset = from;
        int vcol = start_vcol;
        while (offset < line.size() && is_blank_byte(line.byte_at(offset))) {
            int width = MED_text.cell_width(line, offset, vcol, editor.tab);
            total = total + width;
            vcol = vcol + width;
            offset = offset + 1;
        }
        int tabs = 0;
        int spaces = total;
        if (!editor.is_expandtab) {
            int end_col = ws_vcol + total;
            tabs = end_col / editor.tab - ws_vcol / editor.tab;
            if (tabs == 0) {
                spaces = end_col - ws_vcol;
            } else {
                spaces = end_col % editor.tab;
            }
        }
        str fresh = line.substr(0, back) + "\t".repeat(tabs) + " ".repeat(spaces) + line.substr(offset, line.size());
        editor.change(MED_buffer.Pos(row, 0), MED_buffer.Pos(row, line.size()), fresh);
        return;
    }
    int walker = from;
    int non_white_col = start_vcol;
    while (walker < line.size() && is_blank_byte(line.byte_at(walker))) {
        non_white_col = non_white_col + MED_text.cell_width(line, walker, non_white_col, editor.tab);
        walker = walker + 1;
    }
    int block_space = non_white_col - oap.left_vcol;
    int shift_amount = MED_num.smaller(block_space, total);
    int dest = non_white_col - shift_amount;
    int verb_end = from;
    int verb_width = start_vcol;
    if (block_cut_value.pre > 0) {
        verb_end = block_cut_value.from;
        verb_width = MED_text.display_col(line, block_cut_value.from, editor.tab);
    }
    while (verb_width < dest && verb_end < line.size()) {
        int incr = MED_text.cell_width(line, verb_end, verb_width, editor.tab);
        if (verb_width + incr > dest) {
            break;
        }
        verb_width = verb_width + incr;
        verb_end = MED_text.next_col(line, verb_end);
    }
    int fill = dest - verb_width;
    str fresh = line.substr(0, verb_end) + " ".repeat(fill) + line.substr(walker, line.size());
    if (fresh != line) {
        editor.change(MED_buffer.Pos(row, 0), MED_buffer.Pos(row, line.size()), fresh);
    }
}

void block_shift(MED_editor.Editor editor, Oap oap) {
    touch_at(editor, oap.start);
    for (int row in oap.start.row .. oap.end.row + 1) {
        block_shift_line(editor, oap, row, oap.operator == "<");
    }
    editor.row = oap.start.row;
    editor.col = oap.start.col;
}

void touch_at(MED_editor.Editor editor, MED_buffer.Pos position) {
    editor.change(position, position, "");
}

// Vim's op_replace for a charwise or linewise Visual area.
void visual_replace(MED_editor.Editor editor, Oap oap, int code_point) {
    touch_at(editor, oap.start);
    str one = str.from_chars([code_point]);
    for (int row in oap.start.row .. oap.end.row + 1) {
        str line = editor.buffer.line(row);
        int first_char = 0;
        int second_char = line.size();
        if (!oap.is_linewise) {
            if (row == oap.start.row) {
                first_char = oap.start.col;
            }
            if (row == oap.end.row) {
                second_char = oap.end.col;
                if (oap.is_inclusive && second_char < line.size()) {
                    second_char = MED_text.next_col(line, second_char);
                }
            }
        }
        if (first_char >= second_char || first_char >= line.size()) {
            continue;
        }
        List<int> starts = [];
        int spot = first_char;
        int count = 0;
        while (spot < second_char && spot < line.size()) {
            spot = MED_text.next_col(line, spot);
            count = count + 1;
        }
        editor.change(MED_buffer.Pos(row, first_char), MED_buffer.Pos(row, spot), one.repeat(count));
    }
    editor.row = oap.start.row;
    editor.col = oap.start.col;
    if (oap.is_linewise) {
        editor.col = 0;
    }
}

// Remember the finished Visual operation for `.`.
void record_visual_dot(MED_editor.Editor editor, Oap oap, int kind, int count, List<int> body) {
    if (editor.is_in_dot) {
        return;
    }
    editor.dot_reg = oap.reg;
    editor.dot_count = count;
    editor.dot_body = body;
    editor.dot_tail = [];
    editor.dot_vkind = kind;
    editor.dot_vlines = oap.rlines;
    editor.dot_vcols = oap.rvcol;
}

// An operator on the Visual area (Vim's do_pending_operator with VIsual_active).
// `kind` is the selection kind the operator acts on (D, X, Y, S turn it into V).
// The operator name for Visual `<C-a>` (1) / `<C-x>` (24), with `is_group` or not.
str nr_op(int key, bool is_group) {
    str name = "nra";
    if (key == 24) {
        name = "nrx";
    }
    if (is_group) {
        return "g" + name;
    }
    return name;
}

// `<C-a>` / `<C-x>`: add to the number at or after the cursor.
bool did_cmd_addsub(MED_editor.Editor editor, bool is_sub, int count) {
    str line = editor.buffer.line(editor.row);
    MED_nrfmt.NrResult nr_result = MED_nrfmt.addsub(line, editor.col, 0, is_sub, count1(count), false, 0, editor.is_hexupper);
    if (!nr_result.is_changed) {
        // Vim saves the line for undo before it looks for a number
        editor.noop_node();
        return false;
    }
    editor.is_hexupper = nr_result.is_hexupper;
    editor.change(MED_buffer.Pos(editor.row, nr_result.from), MED_buffer.Pos(editor.row, nr_result.target_position), nr_result.text);
    editor.col = nr_result.endcol;
    editor.marks.set("[", MED_buffer.Pos(editor.row, nr_result.startcol));
    editor.marks.set("]", MED_buffer.Pos(editor.row, nr_result.endcol));
    // nvim reports the whole line as changed: the `.` mark is at its start
    editor.note_change(MED_buffer.Pos(editor.row, 0));
    editor.clamp();
    editor.want_from_cursor();
    return true;
}

// Visual `<C-a>`, `<C-x>`, `g<C-a>`, `g<C-x>`: every line of the selection.
bool did_visual_addsub(MED_editor.Editor editor, Oap oap, bool is_sub, bool is_progressive) {
    int step = oap.amount;
    int amount = oap.amount;
    int changes = 0;
    MED_buffer.Pos endp = copy_position(oap.end);
    MED_buffer.Pos first = MED_buffer.Pos(0, 0);
    MED_buffer.Pos last = MED_buffer.Pos(0, 0);
    if (!oap.is_block && !oap.is_linewise && !oap.is_inclusive) {
        // Vim steps the end back once, before the first line (and so may drop the last line)
        if (endp.col > 0) {
            endp = MED_buffer.Pos(endp.row, MED_text.previous_col(editor.buffer.line(endp.row), endp.col));
        } else if (endp.row > 0) {
            endp = MED_buffer.Pos(endp.row - 1, editor.buffer.line_size(endp.row - 1));
        }
    }
    int last_row = oap.end.row;
    if (!oap.is_block && !oap.is_linewise) {
        last_row = endp.row;
    }
    for (int row in oap.start.row .. last_row + 1) {
        str line = editor.buffer.line(row);
        int col = 0;
        int length = 0;
        int mode = 1;
        if (oap.is_block) {
            BlockPrep block_prep_value = block_prep(editor, "", oap.left_vcol, oap.right_vcol, row, false);
            col = block_prep_value.textcol;
            length = block_prep_value.textlen;
            if (oap.is_eol) {
                mode = 2;
            }
        } else if (oap.is_linewise) {
            length = line.size();
            mode = 0;
        } else {
            length = line.size();
            if (row == oap.start.row) {
                col = oap.start.col;
                length = length - oap.start.col;
            }
            if (row == endp.row) {
                int ecol = endp.col;
                if (ecol >= line.size()) {
                    ecol = line.size() - 1;
                }
                length = ecol - col + 1;
            }
            if (editor.want == -1 && oap.is_visual) {
                mode = 2;
            }
        }
        MED_nrfmt.NrResult nr_result = MED_nrfmt.addsub(line, col, length, is_sub, amount, true, mode, editor.is_hexupper);
        if (nr_result.is_changed) {
            editor.is_hexupper = nr_result.is_hexupper;
            editor.change(MED_buffer.Pos(row, nr_result.from), MED_buffer.Pos(row, nr_result.target_position), nr_result.text);
            if (changes == 0) {
                first = MED_buffer.Pos(row, nr_result.startcol);
            }
            last = MED_buffer.Pos(row, nr_result.endcol);
            changes = changes + 1;
            if (is_progressive) {
                amount = amount + step;
            }
        }
    }
    if (changes > 0) {
        editor.marks.set("[", first);
        editor.marks.set("]", last);
        editor.note_change(MED_buffer.Pos(oap.start.row, 0));
    } else {
        editor.noop_node();
    }
    editor.row = oap.start.row;
    editor.col = oap.start.col;
    return true;
}

void visual_operator(MED_editor.Editor editor, str operator, str reg, int count, List<int> body, int kind, int shown_kind) {
    int saved_kind = editor.vkind;
    editor.vkind = kind;
    Oap oap = visual_oap(editor, operator, reg);
    editor.vkind = saved_kind;
    editor.is_visible_redo = false;
    oap.amount = count1(count);
    int nchar = 0;
    if (operator == "r") {
        nchar = body[body.size() - 1];
    }
    if (operator != "y") {
        record_visual_dot(editor, oap, kind, count, body);
    }
    // gv remembers the mode the user had, the marks the real selection
    save_visual(editor, shown_kind);
    editor.mode = MED_editor.NORMAL;
    editor.vkind = 0;
    editor.row = oap.start.row;
    editor.col = oap.start.col;
    bool is_ok = true;
    if (operator == "J" || operator == "gJ") {
        int total = MED_num.larger(oap.line_count, 2);
        if (oap.start.row + total > editor.buffer.line_count()) {
            editor.is_failed = true;
        } else {
            did_do_join(editor, oap.start.row, total, operator == "J");
            editor.clamp();
            editor.want_from_cursor();
        }
    } else if (operator == "r") {
        if (oap.is_block) {
            block_replace(editor, oap, nchar);
        } else {
            visual_replace(editor, oap, nchar);
        }
        editor.clamp();
        editor.want_from_cursor();
    } else if (operator.starts_with("nr") || operator.starts_with("gnr")) {
        is_ok = did_visual_addsub(editor, oap, operator.ends_with("x"), operator.starts_with("g"));
        editor.clamp();
        editor.want_from_cursor();
    } else if (oap.is_block) {
        is_ok = did_block_operator(editor, oap);
    } else if (operator == "I" || operator == "A") {
        is_ok = did_visual_insert(editor, oap);
    } else {
        is_ok = did_run_op(editor, oap);
    }
    if (!is_ok) {
        editor.is_failed = true;
    }
    if (operator == "y") {
        editor.want_from_cursor();
    }
    if (editor.mode == MED_editor.NORMAL) {
        editor.end_block();
    }
}

/// Vim's block_def: how one line meets a block, for I, A and c.
type BlockPrep {
    int startspaces = 0;
    int endspaces = 0;
    int textlen = 0;
    int start_vcol = 0;
    int end_vcol = 0;
    bool is_short = false;
    bool is_one_char = false;
    int start_char_vcols = 0;
    int end_char_vcols = 0;
    int textcol = 0;
}

// Vim's block_prep, for the operator `operator` ("I", "A", "c", "r", "<") on the
// block `left_vcol`..`right_vcol`.
BlockPrep block_prep(MED_editor.Editor editor, str operator, int left_vcol, int right_vcol, int row, bool is_del) {
    BlockPrep block_prep_value = BlockPrep();
    str line = editor.buffer.line(row);
    int position = 0;
    int vcol = 0;
    int incr = 0;
    int previous_pstart = 0;
    while (vcol < left_vcol && position < line.size()) {
        incr = MED_text.cell_width(line, position, vcol, editor.tab);
        vcol = vcol + incr;
        previous_pstart = position;
        position = MED_text.next_col(line, position);
    }
    block_prep_value.start_vcol = vcol;
    int pstart = position;
    block_prep_value.start_char_vcols = incr;
    if (block_prep_value.start_vcol < left_vcol) {
        block_prep_value.end_vcol = block_prep_value.start_vcol;
        block_prep_value.is_short = true;
        if (!is_del || operator == "A") {
            block_prep_value.endspaces = right_vcol - left_vcol + 1;
        }
    } else {
        block_prep_value.startspaces = block_prep_value.start_vcol - left_vcol;
        if (is_del && block_prep_value.startspaces != 0) {
            block_prep_value.startspaces = block_prep_value.start_char_vcols - block_prep_value.startspaces;
        }
        int pend = pstart;
        block_prep_value.end_vcol = block_prep_value.start_vcol;
        if (block_prep_value.end_vcol > right_vcol) {
            block_prep_value.is_one_char = true;
            if (operator == "I") {
                block_prep_value.endspaces = block_prep_value.start_char_vcols - block_prep_value.startspaces;
            } else if (operator == "A") {
                block_prep_value.startspaces = block_prep_value.startspaces + right_vcol - left_vcol + 1;
                block_prep_value.endspaces = block_prep_value.start_char_vcols - block_prep_value.startspaces;
            } else {
                block_prep_value.startspaces = right_vcol - left_vcol + 1;
                if (is_del && operator != "<") {
                    block_prep_value.startspaces = block_prep_value.start_char_vcols - (block_prep_value.start_vcol - left_vcol);
                    block_prep_value.endspaces = block_prep_value.end_vcol - right_vcol - 1;
                }
            }
        } else {
            int previous_pend = pend;
            int value = block_prep_value.end_vcol;
            int offset = pend;
            while (value <= right_vcol && offset < line.size()) {
                previous_pend = offset;
                incr = MED_text.cell_width(line, offset, value, editor.tab);
                value = value + incr;
                offset = MED_text.next_col(line, offset);
            }
            block_prep_value.end_vcol = value;
            pend = offset;
            if (block_prep_value.end_vcol <= right_vcol && (!is_del || operator == "A" || operator == "r")) {
                block_prep_value.is_short = true;
                if (operator == "A") {
                    block_prep_value.endspaces = right_vcol - block_prep_value.end_vcol + 1;
                } else {
                    block_prep_value.endspaces = 0;
                }
            } else if (block_prep_value.end_vcol > right_vcol) {
                block_prep_value.endspaces = block_prep_value.end_vcol - right_vcol - 1;
                if (!is_del && block_prep_value.endspaces != 0) {
                    block_prep_value.endspaces = incr - block_prep_value.endspaces;
                    if (pend != pstart) {
                        pend = previous_pend;
                    }
                }
            }
        }
        block_prep_value.end_char_vcols = incr;
        if (is_del && block_prep_value.startspaces != 0) {
            pstart = previous_pstart;
        }
        block_prep_value.textlen = pend - pstart;
    }
    block_prep_value.textcol = pstart;
    return block_prep_value;
}

// Vim's block_insert: copy `text` into every line below `top` of the block.
void block_insert(MED_editor.Editor editor, int top, int bottom, int left_vcol, int right_vcol, bool is_max, bool is_b_insert, str text) {
    str operator = "A";
    if (is_b_insert) {
        operator = "I";
    }
    for (int row in top + 1 .. bottom + 1) {
        BlockPrep block_prep_value = block_prep(editor, operator, left_vcol, right_vcol, row, true);
        if (block_prep_value.is_short && is_b_insert) {
            continue;
        }
        str old = editor.buffer.line(row);
        int ts_value = 0;
        int spaces = 0;
        int offset = 0;
        if (is_b_insert) {
            ts_value = block_prep_value.start_char_vcols;
            spaces = block_prep_value.startspaces;
            offset = block_prep_value.textcol;
        } else {
            ts_value = block_prep_value.end_char_vcols;
            if (!block_prep_value.is_short) {
                if (block_prep_value.endspaces != 0) {
                    spaces = ts_value - block_prep_value.endspaces;
                }
                offset = block_prep_value.textcol + block_prep_value.textlen;
                if (spaces != 0) {
                    offset = offset - 1;
                }
            } else {
                if (!is_max) {
                    spaces = right_vcol - block_prep_value.end_vcol + 1;
                }
                offset = block_prep_value.textcol + block_prep_value.textlen;
            }
        }
        if (spaces < 0) {
            spaces = 0;
        }
        if (offset > old.size()) {
            offset = old.size();
        }
        str rest = old.substr(offset, old.size());
        str post = "";
        if (spaces > 0 && !block_prep_value.is_short && rest.size() > 0 && rest.byte_at(0) == 9) {
            post = " ".repeat(ts_value - spaces);
            rest = rest.substr(1, rest.size());
        }
        editor.change(MED_buffer.Pos(row, 0), MED_buffer.Pos(row, old.size()), old.substr(0, offset) + " ".repeat(spaces) + text + post + rest);
    }
    if (bottom > top) {
        // changed_lines(start + 1, 0, end + 1)
        editor.override_change(MED_buffer.Pos(top + 1, 0));
    }
}

int white_bytes(str line) {
    int index = 0;
    while (index < line.size() && (line.byte_at(index) == 32 || line.byte_at(index) == 9)) {
        index = index + 1;
    }
    return index;
}

// Start of a block-wise I, A or c: remember what the end of the insert needs.
void block_insert_begin(MED_editor.Editor editor, Oap oap, int count) {
    str operator = oap.operator;
    BlockPrep block_prep_value = block_prep(editor, operator, oap.left_vcol, oap.right_vcol, oap.start.row, true);
    str line = editor.buffer.line(oap.start.row);
    int spot = block_prep_value.textcol;
    if (operator == "A") {
        spot = spot + block_prep_value.textlen;
    }
    editor.blk_pre_length = line.size() - MED_num.smaller(spot, line.size());
    editor.blk_ind_col = white_bytes(line);
    editor.blk_ind_vcol = MED_text.line_width(line.substr(0, editor.blk_ind_col), editor.tab);
    editor.blk_col = block_prep_value.textcol;
    editor.blk_tail = block_prep_value.textlen;
    editor.blk_op = 73;
    if (operator == "A") {
        editor.blk_op = 65;
        int col = oap.start.col;
        while (col < line.size() && col < block_prep_value.textcol + block_prep_value.textlen) {
            col = col + 1;
        }
        editor.col = col;
        if (block_prep_value.is_short && !oap.is_eol) {
            editor.change(MED_buffer.Pos(editor.row, col), MED_buffer.Pos(editor.row, col), " ".repeat(block_prep_value.endspaces));
            editor.col = col + block_prep_value.endspaces;
            editor.blk_tail = block_prep_value.textlen + block_prep_value.endspaces;
        }
    }
    editor.blk_top = oap.start.row;
    editor.blk_bottom = oap.end.row;
    editor.blk_sv = oap.left_vcol;
    editor.blk_ev = oap.right_vcol;
    editor.is_blk_eol = oap.is_eol;
    editor.blk_start_col = oap.start.col;
    start_insert(editor, 105, count, false);
    editor.clamp();
    editor.ins_start = MED_buffer.Pos(editor.row, editor.col);
    editor.ins_textlen = MED_text.line_width(editor.buffer.line(editor.row), editor.tab);
    editor.ins_mark = editor.ins_start;
}

// Vim's op_change for a block: delete it, then insert on the first line.
bool did_block_change(MED_editor.Editor editor, Oap oap) {
    int start_col = oap.start.col;
    block_delete(editor, oap);
    editor.clamp();
    str line = editor.buffer.line(editor.row);
    if (start_col > editor.col && line.size() > 0) {
        editor.col = MED_text.next_col(line, editor.col);
    }
    editor.blk_pre_length = line.size();
    editor.blk_ind_col = white_bytes(line);
    editor.blk_ind_vcol = 0;
    editor.blk_col = editor.col;
    editor.blk_op = 99;
    editor.blk_top = oap.start.row;
    editor.blk_bottom = oap.end.row;
    editor.blk_sv = oap.left_vcol;
    editor.blk_ev = oap.right_vcol;
    editor.is_blk_eol = oap.is_eol;
    editor.blk_start_col = oap.start.col;
    start_insert(editor, 99, 1, false);
    editor.clamp();
    editor.ins_start = MED_buffer.Pos(editor.row, editor.col);
    editor.ins_textlen = MED_text.line_width(editor.buffer.line(editor.row), editor.tab);
    editor.ins_mark = editor.ins_start;
    return true;
}

// The insert that began with block_insert_begin / block_change has ended.
void block_insert_end(MED_editor.Editor editor) {
    int op_code = editor.blk_op;
    editor.blk_op = 0;
    int top = editor.blk_top;
    int bottom = editor.blk_bottom;
    if (editor.row != top || (op_code == 99 && top == bottom)) {
        return;
    }
    str line = editor.buffer.line(top);
    if (op_code == 99) {
        int textcol = editor.blk_col;
        int pre_length = editor.blk_pre_length;
        if (textcol > editor.blk_ind_col) {
            int new_indent = white_bytes(line);
            pre_length = pre_length + new_indent - editor.blk_ind_col;
            textcol = textcol + new_indent - editor.blk_ind_col;
        }
        int ins_length = line.size() - pre_length;
        if (ins_length > 0 && textcol + ins_length <= line.size()) {
            str text = line.substr(textcol, textcol + ins_length);
            for (int row in top + 1 .. bottom + 1) {
                BlockPrep block_prep_value = block_prep(editor, "c", editor.blk_sv, editor.blk_ev, row, true);
                if (!block_prep_value.is_short) {
                    str old = editor.buffer.line(row);
                    editor.change(MED_buffer.Pos(row, block_prep_value.textcol), MED_buffer.Pos(row, block_prep_value.textcol), text);
                }
            }
            editor.clamp();
        }
        return;
    }
    bool is_max = editor.is_blk_eol;
    int left_vcol = editor.blk_sv;
    int right_vcol = editor.blk_ev;
    int start_col = editor.blk_start_col;
    int pre_length = editor.blk_pre_length;
    int textcol = editor.blk_col;
    int textlen = editor.blk_tail;
    str mode = "I";
    if (op_code == 65) {
        mode = "A";
    }
    int ind_post = white_bytes(line);
    bool did_indent = false;
    if (editor.ins_start.col > editor.blk_ind_col && ind_post > editor.blk_ind_col) {
        textcol = textcol + ind_post - editor.blk_ind_col;
        did_indent = true;
    }
    if (editor.ins_start.row == top && !is_max && !did_indent) {
        int target = MED_text.display_col(line, MED_num.smaller(editor.ins_start.col, line.size()), editor.tab);
        if (mode == "I" && start_col != editor.ins_start.col) {
            start_col = editor.ins_start.col;
            pre_length = pre_length - (target - left_vcol);
            left_vcol = target;
        } else if (mode == "A" && start_col >= editor.ins_start.col) {
            start_col = editor.ins_start.col;
            pre_length = pre_length + textlen - (target - left_vcol);
            left_vcol = target;
            mode = "I";
        }
    }
    BlockPrep bd2 = block_prep(editor, mode, left_vcol, right_vcol, top, true);
    if (!is_max || bd2.textlen < textlen) {
        if (mode == "A") {
            pre_length = pre_length + bd2.textlen - textlen;
            if (bd2.endspaces != 0) {
                bd2.textlen = bd2.textlen - 1;
            }
        }
        textcol = bd2.textcol;
        textlen = bd2.textlen;
    }
    int add = textcol;
    if (mode == "A") {
        add = add + textlen;
    }
    if (add > line.size()) {
        add = line.size();
    }
    int ins_length = line.size() - add - pre_length;
    if (pre_length >= 0 && ins_length > 0) {
        str text = line.substr(add, add + ins_length);
        block_insert(editor, top, bottom, left_vcol, right_vcol, is_max, mode == "I", text);
        editor.marks.set("]", MED_buffer.Pos(bottom, editor.marks.get("]").or(MED_buffer.Pos(0, 0)).col));
        editor.col = start_col;
        editor.clamp();
    }
}

// I and A on a Visual area that is not a block: insert at the start of the
// first line / after the end.
bool did_visual_insert(MED_editor.Editor editor, Oap oap) {
    if (oap.operator == "I") {
        editor.row = oap.start.row;
        editor.col = oap.start.col;
        if (oap.is_linewise) {
            editor.col = 0;
        }
    } else {
        editor.row = oap.end.row;
        editor.col = oap.end.col;
        editor.clamp();
        str line = editor.buffer.line(editor.row);
        if (line.size() > 0) {
            editor.col = MED_text.next_col(line, editor.col);
        }
    }
    start_insert(editor, 105, oap.amount, false);
    editor.clamp();
    editor.ins_start = MED_buffer.Pos(editor.row, editor.col);
    editor.ins_textlen = MED_text.line_width(editor.buffer.line(editor.row), editor.tab);
    editor.ins_mark = editor.ins_start;
    return true;
}

// Block-wise operators other than r.
bool did_block_operator(MED_editor.Editor editor, Oap oap) {
    str operator = oap.operator;
    if (operator == "y") {
        editor.regs.yank(oap.reg, block_reg(editor, oap));
        set_op_marks(editor, oap.start, oap.end);
        note_yank(editor, oap.start, oap.end, false);
        editor.row = oap.start.row;
        editor.col = oap.start.col;
        editor.clamp();
        editor.want_from_cursor();
        return true;
    }
    if (operator == "d") {
        if (oap.line_count == 1 && editor.buffer.line_size(oap.start.row) == 0) {
            // Vim's "delete in an empty line" check also covers a one-line block.
            touch_at(editor, oap.start);
            editor.row = oap.start.row;
            editor.col = 0;
            return true;
        }
        block_delete(editor, oap);
        set_op_marks(editor, oap.start, MED_buffer.Pos(oap.end.row, oap.start.col));
        editor.clamp();
        editor.want_from_cursor();
        return true;
    }
    if (operator == "c") {
        return did_block_change(editor, oap);
    }
    if (operator == "I" || operator == "A") {
        block_insert_begin(editor, oap, oap.amount);
        return true;
    }
    if (operator == "<" || operator == ">") {
        block_shift(editor, oap);
        editor.clamp();
        editor.want_from_cursor();
        return true;
    }
    if (operator == "gc") {
        return did_op_comment(editor, oap);
    }
    if (operator == "g~" || operator == "gu" || operator == "gU" || operator == "g?") {
        block_case(editor, oap);
        editor.clamp();
        editor.want_from_cursor();
        return true;
    }
    return false;
}

const List<int> BLOCK_OBJECTS = [98, 40, 41, 66, 123, 125, 91, 93, 60, 62, 116];

void visual_object(MED_editor.Editor editor, MED_parse.Parsed parsed) {
    List<int> keys = parsed.keys;
    MED_buffer.Pos cursor = MED_buffer.Pos(editor.row, editor.col);
    MED_buffer.Pos anchor = MED_buffer.Pos(editor.vrow, editor.vcol);
    MED_textobj.Sel sel = MED_textobj.select(editor.buffer, cursor, true, anchor, editor.vkind, keys[1], keys[0] == 97, parsed.count);
    if (!sel.is_ok) {
        if (sel.is_moved) {
            editor.row = sel.end.row;
            editor.col = sel.end.col;
            editor.clamp();
        }
        editor.want_from_cursor();
        editor.is_failed = true;
        return;
    }
    editor.vrow = sel.start.row;
    editor.vcol = sel.start.col;
    editor.row = sel.end.row;
    editor.col = sel.end.col;
    if (sel.vmode >= 0 && !(editor.vkind == 22 && sel.vmode == 118 && !BLOCK_OBJECTS.contains(keys[1]))) {
        editor.vkind = sel.vmode;
    }
    if (sel.is_jump) {
        pcmark(editor, cursor);
    }
    editor.clamp();
    editor.want_from_cursor();
}

void visual_swap(MED_editor.Editor editor, bool is_corner) {
    if (is_corner && editor.vkind == 22) {
        MED_buffer.Pos old = MED_buffer.Pos(editor.row, editor.col);
        int first_start = vcol_start(editor, editor.row, editor.col);
        int first_end = vcol_end(editor, editor.row, editor.col);
        int other_start = vcol_start(editor, editor.vrow, editor.vcol);
        int second_end = vcol_end(editor, editor.vrow, editor.vcol);
        int left = MED_num.smaller(first_start, other_start);
        int right = MED_num.larger(first_end, second_end);
        editor.vrow = editor.vrow;
        editor.vcol = MED_motion.col_for_want(editor.buffer.line(editor.vrow), left, editor.tab, true);
        editor.row = old.row;
        editor.col = MED_motion.col_for_want(editor.buffer.line(old.row), right, editor.tab, true);
        editor.want = right;
        if (editor.col == old.col) {
            editor.vcol = MED_motion.col_for_want(editor.buffer.line(editor.vrow), right, editor.tab, true);
            editor.col = MED_motion.col_for_want(editor.buffer.line(old.row), left, editor.tab, true);
            editor.want = left;
        }
        return;
    }
    int result = editor.row;
    int char_code = editor.col;
    editor.row = editor.vrow;
    editor.col = editor.vcol;
    editor.vrow = result;
    editor.vcol = char_code;
    editor.want_from_cursor();
}

void execute_visual(MED_editor.Editor editor, MED_parse.Parsed parsed, List<int> typed) {
    if (parsed.kind == MED_parse.K_MOTION) {
        if (parsed.keys.size() == 1 && (parsed.keys[0] == 47 || parsed.keys[0] == 63) && !editor.is_search_ready) {
            enter_cmdline(editor, parsed.keys[0], typed);
            return;
        }
        if (is_gn_keys(parsed.keys)) {
            gn_command(editor, parsed.count, parsed.keys[1] == 110, true);
            return;
        }
        if (parsed.keys.size() == 1 && (parsed.keys[0] == 42 || parsed.keys[0] == 35)) {
            visual_star(editor, parsed.keys[0] == 42, parsed.count);
            return;
        }
        MED_motion.Motion motion = run_motion(editor, parsed.keys, parsed.count, "");
        if (motion.is_ok) {
            apply_motion(editor, motion);
            if (motion.is_beep) {
                editor.is_failed = true;
            }
        } else {
            editor.is_failed = true;
        }
        return;
    }
    if (parsed.kind == MED_parse.K_OBJECT) {
        visual_object(editor, parsed);
        return;
    }
    visual_cmd(editor, parsed, typed);
}

// `parsed` / `P` / `gp` / `gP` in Visual mode: the register replaces the selection.
void visual_put(MED_editor.Editor editor, MED_parse.Parsed parsed, bool is_keep, bool is_back, bool is_cursor_end) {
    int kind = editor.vkind;
    str regname = parsed.reg;
    Option<MED_register.Reg> found = editor.regs.get(regname);
    Oap area = visual_oap(editor, "d", regname);
    MED_buffer.Pos op_start = area.start;
    int dir0 = 1;
    if (is_back) {
        dir0 = -1;
    }
    str del_reg = regname;
    if (is_keep) {
        del_reg = "_";
    } else {
        del_reg = "";
    }
    visual_operator(editor, "d", del_reg, 0, [100], kind, kind);
    bool is_empty = editor.buffer.is_empty;
    int directory = -1;
    if ((kind != 86 && editor.col < op_start.col) || (kind == 86 && editor.row < op_start.row)) {
        directory = 1;
    }
    int flags = 0;
    if (kind == 86) {
        flags = PUT_LINE;
    } else if (kind == 118) {
        flags = PUT_LINE_SPLIT;
    } else if (dir0 > 0) {
        flags = PUT_LINE_FORWARD;
    }
    match (found) {
        case None: {
            editor.is_failed = true;
            if (kind == 86) {
                // the delete left the cursor on the first non-blank of the line
                editor.clamp();
                editor.col = first_nonblank_fix(editor.buffer.line(editor.row));
            }
        }
        case Some(MED_register.Reg reg): {
            did_put_reg(editor, reg, directory, parsed.count, is_cursor_end, flags, editor.last_vend.row);
        }
    }
    int last = editor.buffer.line_count() - 1;
    if (is_empty && last > 0 && editor.buffer.line(last) == "") {
        editor.change(MED_buffer.Pos(last - 1, editor.buffer.line_size(last - 1)), MED_buffer.Pos(last, 0), "");
        last = last - 1;
        if (editor.row > last) {
            editor.row = last;
            editor.col = MED_text.last_col(editor.buffer.line(last));
        }
    }
    // after a Visual put `gv` selects the text that was put
    match (editor.marks.get("[")) {
        case Some(MED_buffer.Pos put_start): {
            match (editor.marks.get("]")) {
                case Some(MED_buffer.Pos put_end): {
                    editor.last_vstart = put_start;
                    editor.last_vend = put_end;
                    MED_buffer.Pos from_mark = put_start;
                    MED_buffer.Pos to_mark = put_end;
                    if (kind == 86) {
                        from_mark = MED_buffer.Pos(put_start.row, 0);
                        to_mark = MED_buffer.Pos(put_end.row, MAXCOL);
                    }
                    editor.marks.set("<", from_mark);
                    editor.marks.set(">", to_mark);
                }
                case None: {
                }
            }
        }
        case None: {
        }
    }
    editor.clamp();
    editor.want_from_cursor();
}

void visual_cmd(MED_editor.Editor editor, MED_parse.Parsed parsed, List<int> typed) {
    int key = parsed.keys[0];
    int kind = editor.vkind;
    str reg = parsed.reg;
    if (is_view_key(key)) {
        if (!did_view_cmd(editor, parsed)) {
            editor.is_failed = true;
        }
        return;
    }
    if (key == 27 || key == 3) {
        leave_visual(editor);
    } else if (key == 118 || key == 86 || key == 22) {
        if (kind == key) {
            leave_visual(editor);
        } else {
            editor.vkind = key;
        }
    } else if (key == 111) {
        visual_swap(editor, false);
    } else if (key == 79) {
        visual_swap(editor, true);
    } else if (key == 100 || key == 120 || key == 63240) {
        visual_operator(editor, "d", reg, parsed.count, [100], kind, kind);
    } else if (key == 68 || key == 88) {
        int next_key = 86;
        if (kind == 22) {
            next_key = 22;
            if (key == 68) {
                editor.want = -1;
            }
        }
        visual_operator(editor, "d", reg, parsed.count, [key], next_key, kind);
    } else if (key == 121) {
        visual_operator(editor, "y", reg, parsed.count, [121], kind, kind);
    } else if (key == 89) {
        int next_key = 86;
        if (kind == 22) {
            next_key = 22;
        }
        visual_operator(editor, "y", reg, parsed.count, [89], next_key, kind);
    } else if (key == 99 || key == 115) {
        visual_operator(editor, "c", reg, parsed.count, [key], kind, kind);
    } else if (key == 67) {
        int next_key = 86;
        if (kind == 22) {
            next_key = 22;
            editor.want = -1;
        }
        visual_operator(editor, "c", reg, parsed.count, [key], next_key, kind);
    } else if (key == 73 || key == 65) {
        int next_key = 86;
        if (kind == 22) {
            next_key = 22;
        }
        visual_operator(editor, str.from_chars([key]), reg, parsed.count, [key], next_key, kind);
    } else if (key == 83 && editor.is_option_on("surround", true)) {
        visual_surround(editor, parsed, false);
    } else if (key == 83 || key == 82) {
        visual_operator(editor, "c", reg, parsed.count, [key], 86, kind);
    } else if (key == 60 || key == 62) {
        visual_operator(editor, str.from_chars([key]), reg, parsed.count, [key], kind, kind);
    } else if (key == 61) {
        visual_operator(editor, "=", reg, parsed.count, [key], kind, kind);
    } else if (key == 126) {
        visual_operator(editor, "g~", reg, parsed.count, [key], kind, kind);
    } else if (key == 117) {
        visual_operator(editor, "gu", reg, parsed.count, [key], kind, kind);
    } else if (key == 85) {
        visual_operator(editor, "gU", reg, parsed.count, [key], kind, kind);
    } else if (key == 1 || key == 24) {
        visual_operator(editor, nr_op(key, false), reg, parsed.count, [key], kind, kind);
    } else if (key == 74) {
        visual_operator(editor, "J", reg, parsed.count, [key], kind, kind);
    } else if (key == 114) {
        int code_point = parsed.keys[1];
        if (parsed.keys.size() == 3) {
            code_point = parsed.keys[2];
        }
        if (code_point == 27) {
            leave_visual(editor);
        } else {
            visual_operator(editor, "r", reg, parsed.count, [114, code_point], kind, kind);
        }
    } else if (key == 109) {
        set_mark(editor, parsed.keys[1]);
    } else if (key == 103) {
        int second = parsed.keys[1];
        if (second == 74) {
            visual_operator(editor, "gJ", reg, parsed.count, parsed.keys, kind, kind);
        } else if (second == 126 || second == 117 || second == 85 || second == 63 || second == 99 || second == 113 || second == 119) {
            visual_operator(editor, "g" + str.from_chars([second]), reg, parsed.count, parsed.keys, kind, kind);
        } else if (second == 1 || second == 24) {
            visual_operator(editor, nr_op(second, true), reg, parsed.count, parsed.keys, kind, kind);
        } else if (second == 118) {
            if (!did_reselect(editor)) {
                editor.is_failed = true;
            }
        } else if (second == 112 || second == 80) {
            visual_put(editor, parsed, false, second == 80, true);
        } else if (second == 83 && editor.is_option_on("surround", true)) {
            visual_surround(editor, parsed, true);
        } else {
            editor.is_failed = true;
        }
    } else if (key == 64) {
        // characterwise and blockwise Visual stay active while the register
        // runs (checked against nvim)
        if (editor.vkind == 86) {
            // `{Visual}@r` over lines is `:'<,'>normal @r`
            leave_visual(editor);
            str name = "";
            if (parsed.count > 1) {
                name = parsed.count.to_str();
            }
            editor.ex_queue.push("'<,'>normal " + name + "@" + str.from_chars([parsed.keys[1]]));
        } else {
            run_macro(editor, str.from_chars([parsed.keys[1]]), parsed.count);
        }
    } else if (key == 58 || key == 33) {
        // `:` is an operator in Visual mode: the cursor goes to the start of the area
        // (`!` is the same with the command line ending in the filter bang)
        Oap area = visual_oap(editor, ":", "");
        leave_visual(editor);
        editor.row = area.start.row;
        editor.col = area.start.col;
        enter_cmdline(editor, 58, typed);
        if (key == 33) {
            set_cmdline(editor, "'<,'>!");
        } else {
            set_cmdline(editor, "'<,'>");
        }
    } else if (key == 112 || key == 80) {
        visual_put(editor, parsed, key == 80, key == 80, false);
    } else {
        editor.is_failed = true;
    }
}

// ------------------------------------------------------------- command line

void cmdline_leave(MED_editor.Editor editor) {
    if (editor.cmd_type == 61 && editor.expr_from != 0) {
        expr_restore(editor);
        return;
    }
    editor.mode = editor.mode_before_cmd;
    set_cmdline(editor, "");
    editor.cmd_wait = 0;
}

// Leave the `=` prompt: back to the line (or Insert mode) CTRL-R = was typed in.
void expr_restore(MED_editor.Editor editor) {
    int from = editor.expr_from;
    editor.expr_from = 0;
    editor.cmd_wait = 0;
    editor.cmd_type = editor.expr_type;
    editor.hist_at = editor.expr_hist_at;
    editor.hist_prefix = editor.expr_hist_prefix;
    if (from == 1) {
        editor.cmdline = editor.expr_line;
        editor.cmd_position = editor.expr_position;
        return;
    }
    set_cmdline(editor, "");
    editor.mode = editor.mode_before_cmd;
}

// CTRL-R = : ask for an expression on a line of its own.
void expr_open(MED_editor.Editor editor, int from) {
    editor.expr_from = from;
    editor.expr_line = editor.cmdline;
    editor.expr_position = editor.cmd_position;
    editor.expr_type = editor.cmd_type;
    editor.expr_hist_at = editor.hist_at;
    editor.expr_hist_prefix = editor.hist_prefix;
    editor.hist_at = -1;
    editor.hist_prefix = "";
    editor.cmd_type = 61;
    editor.cmd_wait = 0;
    set_cmdline(editor, "");
    if (from == 2) {
        editor.mode_before_cmd = editor.mode;
        editor.mode = MED_editor.CMDLINE;
    }
}

// The value of the expression typed at the `=` prompt.
str expr_value(MED_editor.Editor editor, str text) {
    MED_expr.Context context = MED_expr.Context();
    context.line_now = editor.row + 1;
    context.line_last = editor.buffer.line_count();
    context.variables = editor.vars;
    MED_expr.Evaluated evaluated = MED_expr.eval(text, context);
    if (!evaluated.is_ok) {
        editor.message = evaluated.error;
        return "";
    }
    return evaluated.text;
}

// Enter at the `=` prompt: the value goes where CTRL-R = was typed.
void expr_finish(MED_editor.Editor editor) {
    int from = editor.expr_from;
    str value = expr_value(editor, editor.cmdline);
    if (from == 3) {
        // `"=expr<CR>`: the value is register `=` for the command that follows
        List<int> saved = editor.cmd_saved;
        expr_restore(editor);
        int kind = MED_register.CHAR;
        List<str> lines = value.split("\n");
        if (value.ends_with("\n")) {
            kind = MED_register.LINE;
            lines.pop();
        }
        editor.regs.set_named("=", MED_register.Reg(lines, kind));
        editor.pending = saved;
        editor.is_expr_ready = true;
        feed_pending(editor);
        editor.is_expr_ready = false;
        return;
    }
    expr_restore(editor);
    if (from == 1) {
        cmd_insert(editor, value.split("\n").join("\r"));
        return;
    }
    stop_arrow(editor);
    ins_text(editor, value);
}

// The command line becomes `text` with the cursor at its end.
void set_cmdline(MED_editor.Editor editor, str text) {
    editor.cmdline = text;
    editor.cmd_position = text.size();
}

List<str> hist_for(MED_editor.Editor editor) {
    if (editor.cmd_type == 58) {
        return editor.hist_ex;
    }
    return editor.hist_search;
}

void hist_add(MED_editor.Editor editor, str line) {
    if (line == "") {
        return;
    }
    List<str> history = hist_for(editor);
    List<str> kept = [];
    for (str piece in history) {
        if (piece != line) {
            kept.push(piece);
        }
    }
    kept.push(line);
    if (editor.cmd_type == 58) {
        editor.hist_ex = kept;
    } else {
        editor.hist_search = kept;
    }
}

// <Up> / <Down>: recall the older / newer history entry that starts with what
// was typed before browsing began.
void hist_browse(MED_editor.Editor editor, bool is_older, bool is_prefix) {
    List<str> history = hist_for(editor);
    if (editor.hist_at < 0) {
        if (!is_older) {
            return;
        }
        editor.hist_prefix = "";
        editor.hist_typed = editor.cmdline;
        if (is_prefix) {
            editor.hist_prefix = editor.cmdline;
        }
        editor.hist_at = history.size();
    }
    int index = editor.hist_at;
    while (true) {
        if (is_older) {
            index = index - 1;
        } else {
            index = index + 1;
        }
        if (index < 0) {
            return;
        }
        if (index >= history.size()) {
            editor.hist_at = -1;
            set_cmdline(editor, editor.hist_typed);
            return;
        }
        if (history[index].starts_with(editor.hist_prefix)) {
            editor.hist_at = index;
            set_cmdline(editor, history[index]);
            return;
        }
    }
}

// Put `text` into the command line at the cursor.
void cmd_insert(MED_editor.Editor editor, str text) {
    str line = editor.cmdline;
    editor.cmdline = line.substr(0, editor.cmd_position) + text + line.substr(editor.cmd_position, line.size());
    editor.cmd_position = editor.cmd_position + text.size();
}

// Delete the bytes `from` .. `to` (exclusive) of the command line.
void cmd_delete(MED_editor.Editor editor, int from, int finish) {
    str line = editor.cmdline;
    editor.cmdline = line.substr(0, from) + line.substr(finish, line.size());
    if (editor.cmd_position > from) {
        editor.cmd_position = from;
    }
}

bool is_cmd_space(str line, int index) {
    int char_code = line.byte_at(index);
    return char_code == 32 || char_code == 9;
}

// The text CTRL-R CTRL-W / CTRL-A / CTRL-L and CTRL-R {register} put on the command line.
str cmd_paste_text(MED_editor.Editor editor, int key) {
    str line = editor.buffer.line(editor.row);
    if (key == 23) {
        List<int> span = MED_search.ident_at(line, editor.col, editor.buffer.keywords);
        if (span[0] < 0) {
            return "";
        }
        return line.substr(span[0], span[1]);
    }
    if (key == 1) {
        int start = editor.col;
        while (start < line.size() && is_cmd_space(line, start)) {
            start = start + 1;
        }
        if (start >= line.size()) {
            return "";
        }
        while (start > 0 && !is_cmd_space(line, start - 1)) {
            start = start - 1;
        }
        int stop = start;
        while (stop < line.size() && !is_cmd_space(line, stop)) {
            stop = stop + 1;
        }
        return line.substr(start, stop);
    }
    if (key == 12) {
        return line;
    }
    if (key == 6 || key == 16) {
        return "";
    }
    str name = str.from_chars([key]);
    Option<MED_register.Reg> found = editor.regs.get(name);
    match (found) {
        case None: {
            return "";
        }
        case Some(MED_register.Reg reg): {
            str text = reg.text();
            if (reg.kind == MED_register.LINE) {
                text = text + "\n";
            }
            return text.split("\n").join("\r");
        }
    }
}

// CTRL-W: the word before the cursor, as Vim's cmdline_erase_chars() takes it.
void cmd_delete_word(MED_editor.Editor editor) {
    str line = editor.cmdline;
    int at_col = editor.cmd_position;
    while (at_col > 0 && is_cmd_space(line, at_col - 1)) {
        at_col = at_col - 1;
    }
    if (at_col > 0) {
        int previous = MED_text.previous_col(line, at_col);
        bool is_word = MED_text.class_at_in(line, previous, editor.buffer.keywords) >= 2;
        while (at_col > 0 && !is_cmd_space(line, at_col - 1)) {
            int before = MED_text.previous_col(line, at_col);
            if ((MED_text.class_at_in(line, before, editor.buffer.keywords) >= 2) != is_word) {
                break;
            }
            at_col = before;
        }
    }
    cmd_delete(editor, at_col, editor.cmd_position);
}

// <S-Left> / <S-Right> and the Ctrl forms: one WORD.
void cmd_word_move(MED_editor.Editor editor, bool is_left) {
    str line = editor.cmdline;
    int at_col = editor.cmd_position;
    if (is_left) {
        while (at_col > 0 && is_cmd_space(line, at_col - 1)) {
            at_col = at_col - 1;
        }
        while (at_col > 0 && !is_cmd_space(line, at_col - 1)) {
            at_col = at_col - 1;
        }
    } else {
        while (at_col < line.size() && !is_cmd_space(line, at_col)) {
            at_col = at_col + 1;
        }
        while (at_col < line.size() && is_cmd_space(line, at_col)) {
            at_col = at_col + 1;
        }
    }
    editor.cmd_position = at_col;
}

// The character CTRL-K `first` `second` gives: the digraph, or `second` when there is none.
int digraph_of(int first, int second) {
    int found = MED_digraph.lookup(first, second);
    if (found < 0) {
        return second;
    }
    return found;
}

// <Tab> / <S-Tab> on the command line: complete the word before the cursor
// ('wildmode' "full": each press shows the next match, then the typed text).
void cmdline_complete(MED_editor.Editor editor, bool is_backward) {
    if (editor.comp_items.size() == 0) {
        MED_complete.Completion found = MED_complete.complete(editor.cmdline, editor.cmd_position, editor.buffer_names, editor.extra_commands, themes: editor.theme_names);
        if (found.items.size() == 0) {
            return;
        }
        editor.comp_items = found.items;
        editor.comp_start = found.start;
        editor.comp_typed = editor.cmdline.substr(found.start, editor.cmd_position);
        editor.comp_index = -1;
        editor.comp_tail = editor.cmdline.substr(editor.cmd_position, editor.cmdline.size());
    }
    int count = editor.comp_items.size();
    int next = 0;
    if (count == 1) {
        next = 0;
    } else if (is_backward) {
        next = editor.comp_index - 1;
        if (next < -1) {
            next = count - 1;
        }
    } else {
        next = editor.comp_index + 1;
        if (next >= count) {
            next = -1;
        }
    }
    editor.comp_index = next;
    str word = editor.comp_typed;
    if (next >= 0) {
        word = editor.comp_items[next];
    }
    str head = editor.cmdline.substr(0, editor.comp_start);
    editor.cmdline = head + word + editor.comp_tail;
    editor.cmd_position = head.size() + word.size();
    if (count == 1 && next == 0 && word.ends_with("/")) {
        // the only match is a directory: the next <Tab> goes into it
        editor.comp_items = [];
        editor.comp_index = -1;
    }
}

void cmdline_key(MED_editor.Editor editor, int key) {
    if (editor.cmd_wait == 11) {
        editor.dig_first = key;
        editor.cmd_wait = 12;
        if (key == 27) {
            editor.cmd_wait = 0;
        }
        return;
    }
    if (editor.cmd_wait == 12) {
        editor.cmd_wait = 0;
        if (key != 27) {
            cmd_insert(editor, str.from_chars([digraph_of(editor.dig_first, key)]));
        }
        return;
    }
    if (key == 11 && editor.cmd_wait == 0) {
        editor.cmd_wait = 11;
        return;
    }
    if (editor.cmd_wait == 22) {
        editor.cmd_wait = 0;
        if (key >= 63232 && key <= 63400 && editor.lit_i == 0 && !editor.is_lit_hex && !editor.is_lit_octal && editor.lit_uni == 0) {
            cmd_insert(editor, MED_key.name(key));
            return;
        }
        int literal = literal_step(editor, key);
        if (literal < 0) {
            editor.cmd_wait = 22;
            return;
        }
        cmd_insert(editor, str.from_chars([literal]));
        if (editor.is_lit_reuse) {
            cmdline_key(editor, key);
        }
        return;
    }
    if (editor.cmd_wait == 18 || editor.cmd_wait == 19) {
        if (editor.cmd_wait == 18 && (key == 18 || key == 15)) {
            editor.cmd_wait = 19;
            return;
        }
        editor.cmd_wait = 0;
        if (key == 27 || key == 3) {
            return;
        }
        if (key == 61 && editor.expr_from == 0) {
            expr_open(editor, 1);
            return;
        }
        cmd_insert(editor, cmd_paste_text(editor, key));
        return;
    }
    int base = key & MED_key.CODE_MASK;
    bool is_modified = (key & (MED_key.MOD_SHIFT | MED_key.MOD_CTRL)) != 0;
    bool is_completion_key = key == 9 || key == (MED_key.MOD_SHIFT | 9) || ((key == 14 || key == 16) && editor.comp_items.size() > 0);
    if (is_completion_key && editor.cmd_type == 58) {
        cmdline_complete(editor, key == (MED_key.MOD_SHIFT | 9) || key == 16);
        return;
    }
    if (editor.comp_items.size() > 0) {
        editor.comp_items = [];
        editor.comp_index = -1;
    }
    if (key == 63232 || key == 63233 || key == 16 || key == 14) {
        hist_browse(editor, key == 63232 || key == 16, key == 63232 || key == 63233);
        return;
    }
    if (base == 63232 || base == 63233 || base == 63238 || base == 63239) {
        hist_browse(editor, base == 63232 || base == 63238, false);
        return;
    }
    if (key == 27 || key == 3) {
        cmdline_leave(editor);
        return;
    }
    if (key == 29) {
        did_cmd_abbreviate(editor, key);
        return;
    }
    if ((key == 13 || key == 10) && !(editor.cmd_type == 61 && editor.expr_from != 0)) {
        did_cmd_abbreviate(editor, key);
    }
    if (key == 13 || key == 10) {
        if (editor.cmd_type == 61 && editor.expr_from != 0) {
            expr_finish(editor);
            return;
        }
        str line = editor.cmdline;
        int kind = editor.cmd_type;
        List<int> saved = editor.cmd_saved;
        hist_add(editor, line);
        cmdline_leave(editor);
        if (kind == 58) {
            // 1: typed (remembered in the `:` register), 2: from a mapping
            int origin = 1;
            if (editor.is_map_key) {
                origin = 2;
            }
            editor.ex_queue.push(str.from_chars([origin]) + line);
        } else {
            editor.search_typed = line;
            editor.is_search_ready = true;
            editor.pending = saved;
            feed_pending(editor);
            editor.is_search_ready = false;
        }
        return;
    }
    if (key == 127 || key == 8 || key == 63240) {
        int stop = editor.cmd_position;
        if (key == 63240 && stop < editor.cmdline.size()) {
            stop = MED_text.next_col(editor.cmdline, stop);
            editor.cmd_position = stop;
        }
        if (editor.cmd_position == 0) {
            if (editor.cmdline.size() == 0) {
                cmdline_leave(editor);
            }
            return;
        }
        cmd_delete(editor, MED_text.previous_col(editor.cmdline, editor.cmd_position), editor.cmd_position);
        return;
    }
    if (key == 23) {
        if (editor.cmd_position == 0) {
            return;
        }
        cmd_delete_word(editor);
        return;
    }
    if (key == 21) {
        cmd_delete(editor, 0, editor.cmd_position);
        return;
    }
    if (key == 2 || key == 63236) {
        editor.cmd_position = 0;
        return;
    }
    if (key == 5 || key == 63237) {
        editor.cmd_position = editor.cmdline.size();
        return;
    }
    if (base == 63234 || base == 63235) {
        if (is_modified) {
            cmd_word_move(editor, base == 63234);
        } else if (base == 63234) {
            if (editor.cmd_position > 0) {
                editor.cmd_position = MED_text.previous_col(editor.cmdline, editor.cmd_position);
            }
        } else if (editor.cmd_position < editor.cmdline.size()) {
            editor.cmd_position = MED_text.next_col(editor.cmdline, editor.cmd_position);
        }
        return;
    }
    if (key == 18) {
        editor.cmd_wait = 18;
        return;
    }
    if (key == 22 || key == 17) {
        editor.cmd_wait = 22;
        return;
    }
    if (MED_key.is_printable(key) || key == 9) {
        if (key != 9 && !(editor.cmd_type == 61)) {
            did_cmd_abbreviate(editor, key);
        }
        cmd_insert(editor, str.from_chars([key]));
    }
}

// ------------------------------------------------------------------ for ex
// What MED_ex needs from this module: line operators with Vim's cursor rules.
// Rows are 0-based and inclusive.

pub int first_nb(MED_editor.Editor editor, int row) {
    return first_nonblank_fix(editor.buffer.line(row));
}

pub void ex_marks(MED_editor.Editor editor, MED_buffer.Pos position, MED_buffer.Pos position_value) {
    set_op_marks(editor, position, position_value);
}

Oap ex_oap(str operator, str reg, int first, int last) {
    Oap oap = Oap();
    oap.operator = operator;
    oap.reg = reg;
    oap.is_linewise = true;
    oap.start = MED_buffer.Pos(first, 0);
    oap.end = MED_buffer.Pos(last, 0);
    oap.line_count = last - first + 1;
    return oap;
}

// :d
pub void ex_delete(MED_editor.Editor editor, int first, int last, str reg) {
    int want = editor.want;
    editor.row = first;
    editor.col = col_by_want(editor, first, want);
    editor.open_block();
    did_op_delete(editor, ex_oap("d", reg, first, last));
    editor.row = MED_num.smaller(editor.row, editor.buffer.line_count() - 1);
    editor.col = first_nonblank_fix(editor.buffer.line(editor.row));
    editor.want = want;
    editor.needs_stale = true;
}

// :y
pub void ex_yank(MED_editor.Editor editor, int first, int last, str reg) {
    op_yank(editor, ex_oap("y", reg, first, last));
}

// :> and :<
pub void ex_shift(MED_editor.Editor editor, int first, int last, bool is_left, int amount) {
    editor.row = first;
    editor.col = col_by_want(editor, first, editor.want);
    int col = editor.col;
    // several lines are saved for undo as one block: no "U" line
    bool is_saved_off = editor.is_uline_off;
    if (last > first) {
        editor.is_uline_off = true;
    }
    for (int row in first .. last + 1) {
        str line = editor.buffer.line(row);
        if (line.size() == 0) {
            continue;
        }
        int width = indent_width(editor, line);
        int delta = editor.shift_size() * amount;
        if (!is_left) {
            width = width + delta;
        } else {
            width = MED_num.larger(width - delta, 0);
        }
        str replaced = with_indent(editor, line, width);
        if (replaced != line) {
            editor.change(MED_buffer.Pos(row, 0), MED_buffer.Pos(row, line.size()), replaced);
            col = MED_text.first_nonblank(replaced);
        }
    }
    editor.is_uline_off = is_saved_off;
    int end_length = editor.buffer.line_size(last);
    if (end_length > 0) {
        end_length = end_length - 1;
    }
    editor.override_change(MED_buffer.Pos(first, 0));
    set_op_marks(editor, MED_buffer.Pos(first, 0), MED_buffer.Pos(last, end_length));
    editor.row = last;
    editor.col = col;
    editor.clamp();
}

// :put after row `row` (-1: above the first line), or above it when `is_above`.
pub bool did_ex_put(MED_editor.Editor editor, str regname, int row, bool is_above) {
    int directory = 1;
    if (row < 0) {
        editor.row = 0;
        directory = -1;
    } else {
        editor.row = row;
        if (is_above) {
            directory = -1;
        }
    }
    editor.clamp();
    Option<MED_register.Reg> found = editor.regs.get(regname);
    if (found.is_none() && (regname == "_" || regname == ".")) {
        // the black hole and an unset "." put one empty line
        found = Option<MED_register.Reg>.Some(MED_register.Reg([""], MED_register.LINE));
    }
    match (found) {
        case None: {
            return false;
        }
        case Some(MED_register.Reg reg): {
            int want = editor.want;
            bool is_ok = did_put_reg(editor, reg, directory, 1, false, PUT_LINE, 0);
            editor.row = editor.marks.get("]").or(MED_buffer.Pos(editor.row, 0)).row;
            editor.col = first_nonblank_fix(editor.buffer.line(editor.row));
            editor.want = want;
            editor.needs_stale = true;
            return is_ok;
        }
    }
}

// `:r` and `:{range}!`: put `lines` below `row` (above row 0 when `is_above`) as
// whole lines. The cursor is left on the last new line (first non-blank) and
// the `[` and `]` marks cover the new lines.
pub bool did_ex_put_lines(MED_editor.Editor editor, List<str> lines, int row, bool is_above) {
    if (lines.size() == 0) {
        return true;
    }
    int directory = 1;
    editor.row = row;
    if (row < 0) {
        editor.row = 0;
    }
    if (is_above) {
        directory = -1;
    }
    editor.clamp();
    int want = editor.want;
    MED_register.Reg reg = MED_register.Reg(lines, MED_register.LINE);
    bool is_ok = did_put_reg(editor, reg, directory, 1, false, PUT_LINE, 0);
    editor.row = editor.marks.get("]").or(MED_buffer.Pos(editor.row, 0)).row;
    editor.col = first_nonblank_fix(editor.buffer.line(editor.row));
    editor.want = want;
    editor.needs_stale = true;
    return is_ok;
}

// :join, `count` lines from `row`.
pub bool did_ex_join(MED_editor.Editor editor, int row, int count, bool is_spaces) {
    int want = editor.want;
    bool is_ok = did_do_join(editor, row, count, is_spaces);
    editor.col = first_nonblank_fix(editor.buffer.line(editor.row));
    editor.want = want;
    editor.needs_stale = true;
    return is_ok;
}
