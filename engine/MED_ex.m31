// Ex command lines: `:s`, `:g`, `:d`, `:normal` and the rest, with Vim's ranges.
//
// API
// ---
//   MED_ex.feed(ed, key)          one key, then whatever ex lines it queued
//   MED_ex.feed_keys(ed, keys)    many keys
//   MED_ex.drain(ed)              run queued ex lines and continue stopped macros
//   MED_ex.run_line(ed, line)     one command line (what follows `:`); false on error
//
// MED_vim cannot call this module (m31 has no import cycles and no function
// values), so a `:` line typed in a key sequence only lands in `ed.ex_queue`.
// Callers that feed keys use `MED_ex.feed` instead of `MED_vim.feed`: it runs
// the queue after every key and continues a macro that an ex line interrupted.
//
// Line numbers are 1-based inside this module (0 is a valid address for `:m0`,
// `:t0`, `:0put`) and the editor's rows are 0-based.
//
// Not supported, by design (see DESIGN.md section 7): `\=` expressions in the
// replacement, `:s///c` confirmation, `:!` filters and `:r`/`:w` on the file
// system (those are requests for the UI layer).

import io;
import engine.MED_editor;
import engine.MED_fold;
import engine.MED_vim;
import engine.MED_buffer;
import engine.MED_search;
import engine.MED_regex;
import engine.MED_text;
import engine.MED_num;
import engine.MED_register;
import engine.MED_key;
import engine.MED_case;
import engine.MED_view;
import engine.MED_map;
import engine.MED_shell;
import engine.MED_expr;
import engine.MED_listing;
import engine.MED_option;
import engine.MED_surround;

// ------------------------------------------------------------------- driver

/// Process one key, then run the ex lines it queued. Mappings apply: the key
/// joins the typeahead and is resolved against the `:map` tables.
pub void feed(MED_editor.Editor editor, int key) {
    if (editor.ta_keys.size() == 0 && !editor.maps.has_any_mapping()) {
        feed_plain(editor, key);
        return;
    }
    editor.ta_keys.push(key);
    editor.ta_flags.push(TYPED);
    pump(editor, false);
}

pub void feed_keys(MED_editor.Editor editor, List<int> keys) {
    for (int key in keys) {
        feed(editor, key);
    }
}

// The key goes to the editor as it is: no mapping.
void feed_plain(MED_editor.Editor editor, int key) {
    if (editor.sub_run.is_active) {
        sub_key(editor, key);
        MED_view.update(editor);
        return;
    }
    MED_vim.feed(editor, key);
    drain(editor);
    // Vim's update_topline() runs after the command, ex lines included
    MED_view.update(editor);
}

/// Where a typeahead key came from: typed, or expanded from a mapping (which
/// may be mapped again, or not for `:noremap`).
const int TYPED = 0;
const int MAPPED = 1;
const int NOREMAP = 2;
const int MAX_EXPANSIONS = 1000;

/// Resolve the typeahead: expand mappings and feed what is left to the editor.
/// A key that begins a longer mapping stays queued until the next key, or
/// until `flush_maps`.
pub void pump(MED_editor.Editor editor, bool is_flush) {
    int expansions = 0;
    while (editor.ta_keys.size() > 0) {
        if (editor.ta_flags[0] != NOREMAP) {
            str mode = MED_vim.map_mode(editor);
            if (mode != "") {
                List<MED_map.Mapping> table = editor.maps.table(mode);
                int found = MED_map.resolve(table, editor.ta_keys, is_flush);
                if (found == MED_map.WAIT) {
                    return;
                }
                if (found >= 0) {
                    expansions = expansions + 1;
                    if (expansions > MAX_EXPANSIONS) {
                        editor.message = "E223: Recursive mapping";
                        editor.is_failed = true;
                        editor.ta_keys = [];
                        editor.ta_flags = [];
                        return;
                    }
                    expand(editor, table[found]);
                    continue;
                }
            }
        }
        int key = editor.ta_keys[0];
        int origin = editor.ta_flags[0];
        editor.ta_keys.remove_at(0);
        editor.ta_flags.remove_at(0);
        if (origin != TYPED && key == MED_key.NOP) {
            continue;
        }
        bool was_failed = editor.is_failed;
        editor.is_failed = false;
        editor.is_map_key = origin != TYPED;
        if (origin == TYPED) {
            if (editor.pending.size() == 0 && (editor.mode == MED_editor.NORMAL || editor.mode == MED_editor.VISUAL)) {
                // a typed key ends the undo block that mapped keys left open
                editor.end_block();
            }
        } else {
            editor.block_hold = editor.block_hold + 1;
        }
        feed_plain(editor, key);
        if (origin != TYPED) {
            editor.block_hold = editor.block_hold - 1;
        }
        editor.is_map_key = false;
        bool is_bad = editor.is_failed;
        editor.is_failed = was_failed || is_bad;
        if (is_bad) {
            // an error flushes what mappings still have queued
            while (editor.ta_keys.size() > 0 && editor.ta_flags[0] != TYPED) {
                editor.ta_keys.remove_at(0);
                editor.ta_flags.remove_at(0);
            }
        }
    }
}

// Replace the keys of `hit`'s left-hand side at the front of the typeahead by its right-hand side.
void expand(MED_editor.Editor editor, MED_map.Mapping hit) {
    int origin = MAPPED;
    if (hit.is_noremap) {
        origin = NOREMAP;
    }
    List<int> keys = [];
    List<int> flags = [];
    for (int key in hit.rhs) {
        keys.push(key);
        flags.push(origin);
    }
    int offset = hit.lhs.size();
    while (offset < editor.ta_keys.size()) {
        keys.push(editor.ta_keys[offset]);
        flags.push(editor.ta_flags[offset]);
        offset = offset + 1;
    }
    editor.ta_keys = keys;
    editor.ta_flags = flags;
}

/// No more keys are coming (end of input, or 'timeoutlen' passed): a pending
/// prefix of a longer mapping is taken for what it is.
pub void flush_maps(MED_editor.Editor editor) {
    pump(editor, true);
}

// -------------------------------------------------------------------- :map

Step run_map(MED_editor.Editor editor, Cmd cmd) {
    str kind = MED_map.kind_of(cmd.name);
    str modes = MED_map.modes_of(cmd.name, cmd.is_bang);
    if (kind == "clear") {
        for (int letter in modes.chars()) {
            MED_map.clear(editor.maps.table(str.from_chars([letter])));
        }
        return done();
    }
    MED_map.Args parsed = MED_map.split_arguments(cmd.arg);
    if (parsed.error != "") {
        return fail(editor, parsed.error);
    }
    if (kind == "unmap") {
        if (parsed.lhs == "") {
            return fail(editor, "E474: Invalid argument");
        }
        List<int> lhs = MED_key.parse(parsed.lhs, leader: editor.maps.leader);
        bool is_removed = false;
        for (int letter in modes.chars()) {
            if (MED_map.did_remove(editor.maps.table(str.from_chars([letter])), lhs)) {
                is_removed = true;
            }
        }
        if (!is_removed) {
            return fail(editor, "E31: No such mapping");
        }
        return done();
    }
    if (parsed.lhs == "" || parsed.rhs == "") {
        // a listing
        List<str> lines = [];
        List<int> prefix = MED_key.parse(parsed.lhs, leader: editor.maps.leader);
        for (int letter in modes.chars()) {
            str mode = str.from_chars([letter]);
            for (str line in MED_map.describe(editor.maps.table(mode), mode, prefix)) {
                lines.push(line);
            }
        }
        if (lines.size() == 0) {
            editor.message = "No mapping found";
        } else {
            editor.message = lines.join("\n");
        }
        return done();
    }
    MED_map.Mapping made = MED_map.make(parsed, !MED_map.is_remapping(cmd.name), editor.maps.leader);
    for (int letter in modes.chars()) {
        MED_map.add(editor.maps.table(str.from_chars([letter])), made);
    }
    return done();
}

// `:let mapleader = " "`; other variables are accepted and ignored.
Step run_let(MED_editor.Editor editor, Cmd cmd) {
    str text = cmd.arg.trim();
    if (text.starts_with("@")) {
        return let_register(editor, text);
    }
    if (text.starts_with("&")) {
        return let_option(editor, text);
    }
    int equals = text.index_of("=").or(-1);
    if (equals < 0) {
        return done();
    }
    str name = text.substr(0, equals).trim();
    str operator = "=";
    if (name.size() > 1 && (name.ends_with(".") || name.ends_with("+") || name.ends_with("-") || name.ends_with("*"))) {
        operator = name.substr(name.size() - 1, name.size());
        name = name.substr(0, name.size() - 1).trim();
    }
    if (name.starts_with("g:")) {
        name = name.substr(2, name.size());
    }
    str value = text.substr(equals + 1, text.size()).trim();
    if (name != "mapleader") {
        return let_variable(editor, name, operator, value);
    }
    if (value.size() < 2) {
        return fail(editor, "E15: Invalid expression: " + value);
    }
    int quote = value.byte_at(0);
    if ((quote != 34 && quote != 39) || value.byte_at(value.size() - 1) != quote) {
        return fail(editor, "E15: Invalid expression: " + value);
    }
    str inner = value.substr(1, value.size() - 1);
    if (quote == 34) {
        // "\<Space>" and friends
        List<int> keys = MED_key.parse(inner.split("\\<").join("<"), leader: "");
        inner = str.from_chars(keys);
    }
    editor.maps.leader = inner;
    return done();
}

// `:abbreviate` (Insert and command line), `:iabbrev` (Insert), `:cabbrev`
// (command line) and the `nore` forms, which are the same here;
// `:unabbreviate`, `:iunabbrev`, `:cunabbrev`; `:abclear`, `:iabclear`,
// `:cabclear`. Without a right-hand side they list.
Step run_abbrev(MED_editor.Editor editor, Cmd cmd) {
    str name = cmd.name;
    str mode = "!";
    if (name.starts_with("i")) {
        mode = "i";
    } else if (name.starts_with("c")) {
        mode = "c";
    }
    if (name.ends_with("clear")) {
        did_abbrev_remove(editor, "", mode);
        return done();
    }
    str text = cmd.arg.trim();
    bool is_more = true;
    while (is_more) {
        is_more = false;
        List<str> flags = ["<buffer>", "<silent>", "<expr>", "<unique>", "<nowait>"];
        for (str flag in flags) {
            if (text.starts_with(flag)) {
                text = text.substr(flag.size(), text.size()).trim();
                is_more = true;
            }
        }
    }
    int split = 0;
    while (split < text.size() && text.byte_at(split) != 32 && text.byte_at(split) != 9) {
        split = split + 1;
    }
    str lhs = text.substr(0, split);
    str rhs = text.substr(split, text.size()).trim();
    if (name.contains("unab")) {
        if (!did_abbrev_remove(editor, lhs, mode)) {
            return fail(editor, "E24: No such abbreviation");
        }
        return done();
    }
    if (lhs == "" || rhs == "") {
        List<str> shown = [];
        int index = editor.abbr_lhs.size() - 1;
        while (index >= 0) {
            str kind = editor.abbr_mode[index];
            bool is_for_mode = mode == "!" || kind == "!" || kind == mode;
            if (is_for_mode && (lhs == "" || editor.abbr_lhs[index].starts_with(lhs))) {
                str pad = "   ";
                if (editor.abbr_lhs[index].size() < 14) {
                    pad = " ".repeat(14 - editor.abbr_lhs[index].size());
                }
                shown.push(kind + "  " + editor.abbr_lhs[index] + pad + editor.abbr_rhs[index]);
            }
            index = index - 1;
        }
        if (shown.size() == 0) {
            return fail(editor, "E24: No abbreviation found");
        }
        editor.message = shown.join("\n");
        return done();
    }
    // the part of an entry for another mode survives
    did_abbrev_remove(editor, lhs, mode);
    editor.abbr_lhs.push(lhs);
    editor.abbr_rhs.push(rhs);
    editor.abbr_mode.push(mode);
    return done();
}

// Remove the abbreviation `lhs` (every one when empty) for `mode` ("!": all);
// an entry for both modes keeps the other mode. False when none matched.
bool did_abbrev_remove(MED_editor.Editor editor, str lhs, str mode) {
    List<str> keep_lhs = [];
    List<str> keep_rhs = [];
    List<str> keep_mode = [];
    bool is_found = false;
    for (int index in 0 .. editor.abbr_lhs.size()) {
        str kind = editor.abbr_mode[index];
        bool is_hit = (lhs == "" || editor.abbr_lhs[index] == lhs) && (mode == "!" || kind == "!" || kind == mode);
        if (!is_hit) {
            keep_lhs.push(editor.abbr_lhs[index]);
            keep_rhs.push(editor.abbr_rhs[index]);
            keep_mode.push(kind);
            continue;
        }
        is_found = true;
        if (kind == "!" && mode != "!") {
            keep_lhs.push(editor.abbr_lhs[index]);
            keep_rhs.push(editor.abbr_rhs[index]);
            if (mode == "i") {
                keep_mode.push("c");
            } else {
                keep_mode.push("i");
            }
        }
    }
    editor.abbr_lhs = keep_lhs;
    editor.abbr_rhs = keep_rhs;
    editor.abbr_mode = keep_mode;
    return is_found;
}

// `:let name = expr`, `+=`, `-=`, `*=`, `.=` on a plain or `g:` variable.
Step let_variable(MED_editor.Editor editor, str name, str operator, str value) {
    if (name == "" || value == "") {
        return fail(editor, "E15: Invalid expression: " + value);
    }
    for (int code in name.chars()) {
        bool is_name = code == 95 || (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122);
        if (!is_name) {
            return done();
        }
    }
    MED_expr.Evaluated made = MED_expr.eval(value, expression_context(editor));
    if (!made.is_ok) {
        return fail(editor, made.error);
    }
    str stored = "s" + made.text;
    if (made.is_integer) {
        stored = "i" + made.text;
    }
    if (operator != "=") {
        str before = editor.vars.get(name).or("");
        if (before == "") {
            return fail(editor, "E121: Undefined variable: " + name);
        }
        if (operator == ".") {
            stored = "s" + before.substr(1, before.size()) + made.text;
        } else {
            MED_expr.Evaluated sum = MED_expr.eval(before.substr(1, before.size()) + " " + operator + " (" + made.text + ")", expression_context(editor));
            if (!sum.is_ok) {
                return fail(editor, sum.error);
            }
            stored = "i" + sum.text;
        }
    }
    editor.vars.set(name, stored);
    return done();
}

// Every register's text, for `@x` in an expression.
MED_expr.Context expression_context(MED_editor.Editor editor) {
    MED_expr.Context context = MED_expr.Context();
    context.line_now = editor.row + 1;
    context.line_last = editor.buffer.line_count();
    context.variables = editor.vars;
    for (int code in 0 .. 128) {
        str name = str.from_chars([code]);
        if (!MED_register.is_valid(name)) {
            continue;
        }
        match (editor.regs.get(name)) {
            case None: {
            }
            case Some(MED_register.Reg reg): {
                context.registers.set(name, reg.text());
            }
        }
    }
    return context;
}

// `:let @a = expr`, `:let @a .= expr`
Step let_register(MED_editor.Editor editor, str text) {
    if (text.size() < 3) {
        return fail(editor, "E15: Invalid expression: " + text);
    }
    str name = text.substr(1, 2);
    str rest = text.substr(2, text.size()).trim();
    bool is_append = false;
    if (rest.starts_with(".=")) {
        is_append = true;
        rest = rest.substr(2, rest.size());
    } else if (rest.starts_with("=")) {
        rest = rest.substr(1, rest.size());
    } else {
        return fail(editor, "E15: Invalid expression: " + text);
    }
    MED_expr.Evaluated value = MED_expr.eval(rest.trim(), expression_context(editor));
    if (!value.is_ok) {
        return fail(editor, value.error);
    }
    str body = value.text;
    if (name == "/") {
        if (is_append) {
            body = editor.regs.last_search + body;
        }
        editor.regs.set_special("/", body);
        editor.search_pattern = body;
        editor.is_last_is_sub = false;
        return done();
    }
    if (!MED_register.is_valid(name) || name == "_" || name == "." || name == ":" || name == "%" || name == "#" || name == "=") {
        return done();
    }
    int kind = MED_register.CHAR;
    List<str> lines = body.split("\n");
    if (body.ends_with("\n")) {
        kind = MED_register.LINE;
        lines.pop();
    }
    if (name == "\"") {
        editor.regs.set_unnamed(MED_register.Reg(lines, kind));
        return done();
    }
    // an upper-case name appends, as `.=` does: the text joins the last line
    // unless it is a whole line, and the register takes the type of the new text
    bool is_upper = name.byte_at(0) >= 65 && name.byte_at(0) <= 90;
    if (is_append || is_upper) {
        match (editor.regs.get(MED_case.lower(name))) {
            case Some(MED_register.Reg old): {
                List<str> merged = [];
                for (str existing in old.lines) {
                    merged.push(existing);
                }
                int from_index = 0;
                if (kind == MED_register.CHAR && old.kind != MED_register.LINE && merged.size() > 0 && lines.size() > 0) {
                    merged[merged.size() - 1] = merged[merged.size() - 1] + lines[0];
                    from_index = 1;
                }
                for (int i in from_index .. lines.size()) {
                    merged.push(lines[i]);
                }
                editor.regs.set_named(MED_case.lower(name), MED_register.Reg(merged, kind));
            }
            case None: {
                editor.regs.set_named(MED_case.lower(name), MED_register.Reg(lines, kind));
            }
        }
    } else {
        editor.regs.set_named(MED_case.lower(name), MED_register.Reg(lines, kind));
    }
    return done();
}

// `:let &tabstop = 4` and friends: the same as `:set`
Step let_option(MED_editor.Editor editor, str text) {
    int equals = text.index_of("=").or(-1);
    if (equals < 0) {
        return fail(editor, "E15: Invalid expression: " + text);
    }
    str name = text.substr(1, equals).trim();
    str operator = "=";
    if (name.ends_with("+") || name.ends_with("-") || name.ends_with("^")) {
        operator = name.substr(name.size() - 1, name.size()) + "=";
        name = name.substr(0, name.size() - 1).trim();
    }
    MED_expr.Evaluated value = MED_expr.eval(text.substr(equals + 1, text.size()).trim(), expression_context(editor));
    if (!value.is_ok) {
        return fail(editor, value.error);
    }
    if (name.starts_with("l:") || name.starts_with("g:")) {
        name = name.substr(2, name.size());
    }
    MED_option.Spec spec = MED_option.find(name);
    if (spec.name == "") {
        return fail(editor, "E355: Unknown option: " + name);
    }
    List<str> command = [];
    command.push("set " + name + operator + value.text.split(" ").join("\\ "));
    if (spec.kind == "bool") {
        command = [];
        if (value.text == "0" || value.text == "") {
            command.push("set no" + name);
        } else {
            command.push("set " + name);
        }
    }
    editor.ex_queue.push(command[0]);
    return done();
}

/// Run queued ex lines; continue macros that were stopped for one.
pub void drain(MED_editor.Editor editor) {
    while (true) {
        if (editor.ex_queue.size() > 0) {
            str line = editor.ex_queue[0];
            editor.ex_queue.remove_at(0);
            if (line == "\x04surround-begin") {
                editor.sur_stage = 0;
                if (MED_surround.did_begin_change(editor)) {
                    str tag_default = "";
                    if (editor.sur_new == "T" || editor.sur_new == " T") {
                        int open = editor.sur_last_deleted.index_of("<").or(-1);
                        int tag_end = editor.sur_last_deleted.index_of(">").or(-1);
                        if (open >= 0 && tag_end > open) {
                            tag_default = editor.sur_last_deleted.substr(open + 1, tag_end);
                        }
                    }
                    editor.sur_input = tag_default;
                    editor.sur_stage = 3;
                } else {
                    editor.sur_stage = 0;
                    editor.sur_command = "";
                }
                continue;
            }
            if (line == "\x04surround") {
                MED_surround.apply(editor);
                if (editor.ex_depth == 0 && editor.mode == MED_editor.NORMAL) {
                    editor.end_block();
                }
                continue;
            }
            bool is_typed = line.size() > 0 && (line.byte_at(0) == 1 || line.byte_at(0) == 2);
            bool is_remembered = line.size() > 0 && line.byte_at(0) == 1;
            if (is_typed) {
                line = line.substr(1, line.size());
            }
            editor.is_colon_skip = false;
            bool is_ok = did_run_isolated(editor, line);
            if (is_remembered && line != "" && !editor.is_colon_skip) {
                // remembered only after it ran, so that `:@:` inside it sees the line before
                editor.regs.set_special(":", line);
            }
            editor.is_colon_skip = false;
            if (editor.ex_depth == 0 && editor.mode == MED_editor.NORMAL) {
                editor.end_block();
            }
            if (is_typed && editor.ex_depth == 0 && editor.ex_queue.size() == 0) {
                editor.check_pcmark();
            }
            if (!is_ok || editor.is_failed) {
                editor.is_failed = true;
                editor.ex_queue = [];
                editor.resume = [];
            }
            continue;
        }
        if (editor.resume.size() > 0) {
            MED_editor.Resume frame = editor.resume[0];
            editor.resume.remove_at(0);
            MED_vim.run_keys(editor, frame.keys, frame.full, frame.again);
            if (editor.is_failed) {
                editor.ex_queue = [];
                editor.resume = [];
            }
            continue;
        }
        editor.release_macro_holds();
        if (editor.ex_depth == 0) {
            MED_vim.try_restart(editor);
        }
        break;
    }
}

// Run one line with its own queue and macro frames, so that a nested `:normal`
// cannot run what belongs to the caller.
bool did_run_isolated(MED_editor.Editor editor, str line) {
    List<str> saved_queue = editor.ex_queue;
    List<MED_editor.Resume> saved_resume = editor.resume;
    int saved_macro_holds = editor.macro_holds;
    editor.macro_holds = 0;
    editor.ex_queue = [];
    editor.resume = [];
    editor.ex_depth = editor.ex_depth + 1;
    editor.block_hold = editor.block_hold + 1;
    bool is_ok = did_run_line(editor, line);
    editor.block_hold = editor.block_hold - 1;
    editor.ex_depth = editor.ex_depth - 1;
    editor.ex_queue = saved_queue;
    editor.resume = saved_resume;
    editor.macro_holds = saved_macro_holds;
    return is_ok;
}

// ------------------------------------------------------------------ helpers

const int MAXLNUM = 2000000000;

bool is_digit(int char_code) {
    return char_code >= 48 && char_code <= 57;
}

bool is_alpha(int char_code) {
    return (char_code >= 97 && char_code <= 122) || (char_code >= 65 && char_code <= 90);
}

bool is_white(int char_code) {
    return char_code == 32 || char_code == 9;
}

int at(str text, int index) {
    if (index < 0 || index >= text.size()) {
        return 0;
    }
    return text.byte_at(index);
}

int skip_white(str text, int index) {
    int offset = index;
    while (offset < text.size() && is_white(text.byte_at(offset))) {
        offset = offset + 1;
    }
    return offset;
}

int skip_digits(str text, int index) {
    int offset = index;
    while (offset < text.size() && is_digit(text.byte_at(offset))) {
        offset = offset + 1;
    }
    return offset;
}

int digits_value(str text, int index, int other_index) {
    int value = 0;
    for (int offset in index .. other_index) {
        value = value * 10 + (text.byte_at(offset) - 48);
        if (value > MAXLNUM) {
            value = MAXLNUM;
        }
    }
    return value;
}

int last_line(MED_editor.Editor editor) {
    return editor.buffer.line_count();
}

/// What one step of a command line leaves: success, and the text of the next
/// command after a `|`.
type Step {
    bool is_ok = true;
    bool is_more = false;
    str rest = "";
}

Step fail(MED_editor.Editor editor, str message) {
    Step step = Step();
    step.is_ok = false;
    editor.message = message;
    return step;
}

Step done() {
    return Step();
}

/// A parsed command: its range, name and argument.
type Cmd {
    int line1 = 1;
    int line2 = 1;
    int addr_count = 0;
    str name = "";
    bool is_bang = false;
    str arg = "";
    str reg = "";
    bool has_reg = false;
    bool is_ok = true;
    str error = "";
    /// Index just after the command name in the line.
    int after = 0;
    bool is_more = false;
    str rest = "";
}

type Addr {
    bool is_ok = true;
    bool is_found = false;
    int line = 0;
    int next = 0;
    str error = "";
}

// Where the pattern of a `/pat/` address (and its offsets) ends: just past what
// do_search() would take for it.
int address_end(str text, int start, int delim) {
    str rest = text.substr(start, text.size());
    int end = MED_search.skip_regexp(rest, delim);
    int offset = end;
    if (at(rest, offset) == delim) {
        offset = offset + 1;
    }
    int first_char = at(rest, offset);
    if (first_char == 43 || first_char == 45 || is_digit(first_char)) {
        // a line offset: the generic offset loop of the address takes it
        return start + offset;
    }
    return start + offset;
}

Addr get_address(MED_editor.Editor editor, str text, int start) {
    Addr addr = Addr();
    int index = skip_white(text, start);
    int lnum = MAXLNUM;
    bool is_again = true;
    while (is_again) {
        is_again = false;
        int char_code = at(text, index);
        if (char_code == 46) {
            index = index + 1;
            lnum = editor.row + 1;
        } else if (char_code == 36) {
            index = index + 1;
            lnum = last_line(editor);
        } else if (char_code == 39) {
            index = index + 1;
            if (index >= text.size()) {
                addr.is_ok = false;
                addr.error = "E20: Mark not set";
                return addr;
            }
            int name = at(text, index);
            index = index + 1;
            Option<MED_buffer.Pos> mark_position = MED_vim.mark_position(editor, name);
            match (mark_position) {
                case Some(MED_buffer.Pos position): {
                    lnum = position.row + 1;
                }
                case None: {
                    addr.is_ok = false;
                    addr.error = "E20: Mark not set";
                    return addr;
                }
            }
        } else if (char_code == 47 || char_code == 63) {
            index = index + 1;
            int save_row = editor.row;
            int save_col = editor.col;
            if (lnum > 0 && lnum != MAXLNUM) {
                editor.row = MED_num.smaller(lnum, last_line(editor)) - 1;
            }
            if (char_code == 47) {
                editor.col = editor.buffer.line_size(editor.row);
            } else {
                editor.col = 0;
            }
            int end = address_end(text, index, char_code);
            str typed = text.substr(index, end);
            MED_search.Outcome out = MED_search.search_command(editor, char_code, typed, 1, false, true);
            editor.row = save_row;
            editor.col = save_col;
            if (!out.is_ok) {
                addr.is_ok = false;
                addr.error = out.error;
                return addr;
            }
            lnum = out.row + 1;
            index = end;
        } else if (char_code == 92) {
            index = index + 1;
            int delta = at(text, index);
            if (delta != 38 && delta != 63 && delta != 47) {
                addr.is_ok = false;
                addr.error = "E10: \\ should be followed by /, ? or &";
                return addr;
            }
            str pattern = editor.search_pattern;
            if (delta == 38) {
                pattern = editor.sub_pattern;
            }
            if (pattern == "") {
                addr.is_ok = false;
                addr.error = "E35: No previous regular expression";
                return addr;
            }
            int row = editor.row;
            if (lnum != MAXLNUM) {
                row = MED_num.smaller(lnum, last_line(editor)) - 1;
            }
            MED_regex.Regex regex = MED_search.compile_with(editor, pattern, false);
            if (!regex.is_ok) {
                addr.is_ok = false;
                addr.error = regex.error;
                return addr;
            }
            int pcol = 0;
            int directory = 1;
            if (delta == 63) {
                directory = -1;
            } else {
                pcol = editor.buffer.line_size(row);
            }
            MED_search.Hit hit = MED_search.searchit(editor, regex, row, pcol, directory, 1, false, false, false);
            if (!hit.is_ok) {
                addr.is_ok = false;
                addr.error = "E486: Pattern not found: " + pattern;
                return addr;
            }
            lnum = hit.row + 1;
            index = index + 1;
        } else if (is_digit(char_code)) {
            int stop = skip_digits(text, index);
            lnum = digits_value(text, index, stop);
            index = stop;
        }
        while (true) {
            index = skip_white(text, index);
            int other_char = at(text, index);
            if (other_char != 45 && other_char != 43 && !is_digit(other_char)) {
                break;
            }
            if (lnum == MAXLNUM) {
                lnum = editor.row + 1;
            }
            int sign = 43;
            if (!is_digit(other_char)) {
                sign = other_char;
                index = index + 1;
            }
            int count = 1;
            if (is_digit(at(text, index))) {
                int stop = skip_digits(text, index);
                count = digits_value(text, index, stop);
                index = stop;
            }
            if (sign == 45) {
                lnum = lnum - count;
            } else {
                lnum = lnum + count;
            }
        }
        int next_col = at(text, index);
        if (next_col == 47 || next_col == 63) {
            is_again = true;
        }
    }
    addr.next = index;
    if (lnum != MAXLNUM) {
        addr.is_found = true;
        addr.line = lnum;
    }
    return addr;
}

/// Parse the range at the start of `text` (after `:` and blanks).
Cmd parse_range(MED_editor.Editor editor, str text, int start) {
    Cmd cmd = Cmd();
    int current = editor.row + 1;
    cmd.line1 = current;
    cmd.line2 = current;
    int index = start;
    bool is_last_missing = true;
    while (true) {
        cmd.line1 = cmd.line2;
        cmd.line2 = editor.row + 1;
        index = skip_white(text, index);
        Addr addr = get_address(editor, text, index);
        if (!addr.is_ok) {
            cmd.is_ok = false;
            cmd.error = addr.error;
            return cmd;
        }
        index = addr.next;
        is_last_missing = !addr.is_found;
        if (!addr.is_found) {
            if (at(text, index) == 37) {
                index = index + 1;
                cmd.line1 = 1;
                cmd.line2 = last_line(editor);
                cmd.addr_count = cmd.addr_count + 1;
                is_last_missing = false;
            } else if (at(text, index) == 42) {
                index = index + 1;
                Option<MED_buffer.Pos> low_position = MED_vim.mark_position(editor, 60);
                Option<MED_buffer.Pos> high_position = MED_vim.mark_position(editor, 62);
                match (low_position) {
                    case Some(MED_buffer.Pos position): {
                        match (high_position) {
                            case Some(MED_buffer.Pos position_value): {
                                cmd.line1 = position.row + 1;
                                cmd.line2 = position_value.row + 1;
                            }
                            case None: {
                                cmd.is_ok = false;
                                cmd.error = "E20: Mark not set";
                                return cmd;
                            }
                        }
                    }
                    case None: {
                        cmd.is_ok = false;
                        cmd.error = "E20: Mark not set";
                        return cmd;
                    }
                }
                cmd.addr_count = cmd.addr_count + 1;
                is_last_missing = false;
            }
        } else {
            cmd.line2 = addr.line;
        }
        cmd.addr_count = cmd.addr_count + 1;
        int sep = at(text, skip_white(text, index));
        if (sep == 59) {
            index = skip_white(text, index);
            if (cmd.line2 > 0) {
                editor.row = MED_num.smaller(cmd.line2, last_line(editor)) - 1;
                editor.clamp();
            }
        } else if (sep != 44) {
            break;
        }
        index = skip_white(text, index) + 1;
    }
    if (cmd.addr_count == 1) {
        cmd.line1 = cmd.line2;
        if (is_last_missing) {
            cmd.addr_count = 0;
        }
    }
    cmd.after = index;
    return cmd;
}

/// The commands the UI layer carries out (they need files, buffers or windows).
bool is_ui_command(str name) {
    List<str> names = ["edit", "enew", "bnext", "bprevious", "bNext", "buffer", "bdelete", "bwipeout", "bunload", "bfirst", "brewind", "blast", "ls", "buffers", "files", "close", "only", "split", "vsplit", "new", "vnew", "wincmd", "resize", "tabnew", "tabedit", "tabnext", "tabprevious", "tabNext", "tabfirst", "tabrewind", "tablast", "tabclose", "tabonly", "tabs", "tabmove", "Rename", "Delete", "Create", "Mkdir", "Files", "Buffers", "Grep", "Commands", "help", "Explore", "Sexplore", "Vexplore", "Neotree", "NeoTree", "Keys", "Plugins", "PluginEnable", "PluginDisable", "terminal", "Lsp", "copen", "cclose", "cnext", "cprevious", "cNext", "cfirst", "clast", "Recent", "Symbols", "Todo", "Branches", "Commits", "Changed", "source", "theme", "colorscheme", "checktime", "Session"];
    for (str known in names) {
        if (known == name) {
            return true;
        }
    }
    return false;
}

// ------------------------------------------------------------ command table

// "full:shortest": a word names the first command whose full name it starts
// and whose shortest form it reaches (Vim's order matters for ambiguity).
List<str> command_table() {
    return ["substitute:1", "delete:1", "move:1", "t:1", "copy:2", "join:1", "global:1", "vglobal:1", "yank:1", "undo:1", "print:1", "put:2", "normal:4", "execute:3", "k:1", "mark:2", "nohlsearch:3", "set:2", "echo:2", "echomsg:5", "redraw:4", "messages:3", "highlight:2", "syntax:2", "filetype:5", "version:2", "history:3", "pwd:2", "setlocal:4", "setglobal:4", "undojoin:5", "redo:3", "read:1", "sort:3", "number:2", "quit:1", "write:1", "wq:2", "delmarks:4", "earlier:2", "later:3", "list:1", "z:1", "update:2", "xit:1", "wall:2", "qall:2", "wqall:3", "xall:2", "registers:3", "display:2", "marks:5", "jumps:2", "changes:7", "startinsert:4", "stopinsert:5", "retab:3", "left:2", "right:2", "center:2", "noautocmd:3", "edit:1", "enew:3", "bnext:2", "bprevious:2", "bNext:2", "buffer:1", "bdelete:2", "bwipeout:2", "bunload:3", "bfirst:2", "brewind:2", "blast:2", "ls:2", "buffers:7", "files:5", "close:3", "only:2", "split:2", "vsplit:2", "new:3", "vnew:3", "wincmd:4", "Rename:3", "Delete:3", "Create:3", "Mkdir:2", "resize:3", "vertical:4", "tabnew:6", "tabedit:4", "tabnext:4", "tabprevious:4", "tabNext:4", "tabfirst:6", "tabrewind:4", "tablast:4", "tabclose:4", "tabonly:4", "tabs:4", "tabmove:4", "Files:1", "Buffers:2", "Grep:1", "Commands:3", "help:1", "Explore:2", "Sexplore:3", "Vexplore:3", "Neotree:7", "NeoTree:7", "Keys:4", "Plugins:7", "PluginEnable:12", "PluginDisable:13", "Recent:6", "Symbols:7", "Todo:4", "Branches:8", "Commits:7", "Changed:7", "colorscheme:4", "theme:5", "checktime:6", "Session:7", "fold:2", "foldopen:5", "foldclose:5", "map:3", "nmap:2", "vmap:2", "xmap:2", "omap:2", "imap:2", "cmap:2", "noremap:2", "nnoremap:2", "vnoremap:2", "xnoremap:2", "onoremap:3", "inoremap:3", "cnoremap:3", "unmap:3", "nunmap:3", "vunmap:2", "xunmap:2", "ounmap:2", "iunmap:2", "cunmap:2", "mapclear:4", "nmapclear:5", "vmapclear:5", "xmapclear:5", "omapclear:5", "imapclear:5", "cmapclear:5", "let:3", "abbreviate:2", "iabbrev:2", "noreabbrev:5", "inoreabbrev:6", "unabbreviate:3", "iunabbrev:4", "abclear:3", "iabclear:4", "cabbrev:2", "cnoreabbrev:5", "cunabbrev:4", "cabclear:4", "abbreviate:2", "iabbrev:2", "noreabbrev:5", "inoreabbrev:6", "unabbreviate:3", "iunabbrev:4", "abclear:3", "iabclear:4", "source:2", "terminal:2", "Lsp:3", "copen:3", "cclose:3", "cnext:2", "cprevious:2", "cNext:3", "cfirst:4", "clast:3", "write!:99"];
}

/// Whether `word` names (or abbreviates) one of the editor's own ex commands; extensions may not take those names.
pub bool is_builtin_command(str word) {
    return resolve(word) != "";
}

str resolve(str word) {
    if (word == "") {
        return "";
    }
    for (str entry in command_table()) {
        int char_code = entry.index_of(":").or(0);
        str full = entry.substr(0, char_code);
        int least = digits_value(entry, char_code + 1, entry.size());
        if (word.size() >= least && word.size() <= full.size() && full.starts_with(word)) {
            return full;
        }
    }
    return "";
}

// A modifier word at the start of a command line (the shortest form is given).
bool is_modifier(str word, str full, int least) {
    return word.size() >= least && word.size() <= full.size() && full.starts_with(word);
}

bool did_takes_bar(str name) {
    return !(name == "global" || name == "vglobal" || name == "normal" || name == "substitute" || name == "&" || name == "~" || name == "&&");
}

bool did_zero_range(str name) {
    return name == "put" || name == "read";
}

str canonical_special(int char_code) {
    if (char_code == 38) {
        return "&";
    }
    if (char_code == 126) {
        return "~";
    }
    if (char_code == 60) {
        return "<";
    }
    if (char_code == 62) {
        return ">";
    }
    if (char_code == 61) {
        return "=";
    }
    if (char_code == 35) {
        return "number";
    }
    if (char_code == 33) {
        return "!";
    }
    if (char_code == 64) {
        return "@";
    }
    if (char_code == 42) {
        return "@";
    }
    return "";
}

type Split {
    str arg = "";
    bool is_more = false;
    str rest = "";
}

// Split `arg` at the first unescaped `|`; a `\|` loses its backslash. With
// `is_comment` a `"` starts a comment that runs to the end.
Split split_bar(str arg, bool is_comment) {
    Split split = Split();
    List<int> out = [];
    List<int> codes = arg.chars();
    int index = 0;
    while (index < codes.size()) {
        int char_code = codes[index];
        if (char_code == 92 && index + 1 < codes.size() && codes[index + 1] == 124) {
            out.push(124);
            index = index + 2;
            continue;
        }
        if (char_code == 22 && index + 1 < codes.size()) {
            out.push(codes[index + 1]);
            index = index + 2;
            continue;
        }
        if (char_code == 124) {
            split.is_more = true;
            split.rest = str.from_chars(codes.slice(index + 1, codes.size()));
            break;
        }
        if (char_code == 34 && is_comment) {
            break;
        }
        out.push(char_code);
        index = index + 1;
    }
    split.arg = str.from_chars(out);
    return split;
}

// Like split_bar() for the commands whose argument is an expression
// (`:execute`, `:echo`): a `|` inside a string belongs to it and a quote
// starts a string, not a comment.
Split split_bar_expr(str arg) {
    Split split = Split();
    List<int> codes = arg.chars();
    int quote = 0;
    int index = 0;
    while (index < codes.size()) {
        int char_code = codes[index];
        if (quote == 34 && char_code == 92 && index + 1 < codes.size()) {
            index = index + 2;
            continue;
        }
        if (quote != 0) {
            if (char_code == quote) {
                if (quote == 39 && index + 1 < codes.size() && codes[index + 1] == 39) {
                    index = index + 2;
                    continue;
                }
                quote = 0;
            }
        } else if (char_code == 34 || char_code == 39) {
            quote = char_code;
        } else if (char_code == 124) {
            split.is_more = true;
            split.rest = str.from_chars(codes.slice(index + 1, codes.size()));
            split.arg = str.from_chars(codes.slice(0, index));
            return split;
        }
        index = index + 1;
    }
    split.arg = arg;
    return split;
}

// ------------------------------------------------------------------ one line

/// Run a command line: commands separated by `|`. False when one of them failed.
pub bool did_run_line(MED_editor.Editor editor, str line) {
    str text = line;
    while (true) {
        Step step = run_one(editor, text);
        if (!step.is_ok) {
            return false;
        }
        if (!step.is_more) {
            return true;
        }
        if (editor.sub_run.is_active) {
            // a `:s///c` prompt is waiting for its answer: the rest follows it
            editor.sub_run.rest = step.rest;
            return true;
        }
        text = step.rest;
    }
}

str register_text(MED_editor.Editor editor, str name) {
    Option<MED_register.Reg> reg_option = editor.regs.get(name);
    match (reg_option) {
        case Some(MED_register.Reg reg): {
            return reg.text();
        }
        case None: {
            return "";
        }
    }
}

Step run_one(MED_editor.Editor editor, str text) {
    int index = 0;
    bool is_keepp = false;
    while (true) {
        while (index < text.size() && (is_white(text.byte_at(index)) || text.byte_at(index) == 58)) {
            index = index + 1;
        }
        int stop = index;
        while (stop < text.size() && is_alpha(text.byte_at(stop))) {
            stop = stop + 1;
        }
        str word = text.substr(index, stop);
        if (word == "") {
            break;
        }
        bool is_marker = false;
        if (is_modifier(word, "silent", 3) || is_modifier(word, "keepjumps", 5) || is_modifier(word, "keepmarks", 5) || is_modifier(word, "keepalt", 5) || is_modifier(word, "lockmarks", 3) || is_modifier(word, "noautocmd", 3)) {
            is_marker = true;
        } else if (is_modifier(word, "keeppatterns", 5)) {
            is_marker = true;
            is_keepp = true;
        }
        if (!is_marker) {
            break;
        }
        index = stop;
        if (at(text, index) == 33) {
            index = index + 1;
        }
    }
    if (at(text, index) == 34) {
        return done();
    }
    Cmd cmd = parse_range(editor, text, index);
    if (!cmd.is_ok) {
        return fail(editor, cmd.error);
    }
    index = cmd.after;
    while (index < text.size() && (is_white(text.byte_at(index)) || text.byte_at(index) == 58)) {
        index = index + 1;
    }
    int char_code = at(text, index);
    if (char_code == 0 || char_code == 124 || char_code == 34) {
        Step step = Step();
        if (char_code == 124) {
            step.is_more = true;
            step.rest = text.substr(index + 1, text.size());
        }
        if (cmd.addr_count > 0) {
            int target = cmd.line2;
            if (target < 0) {
                return fail(editor, "E16: Invalid range");
            }
            if (target > last_line(editor)) {
                target = last_line(editor);
            }
            if (target == 0) {
                target = 1;
            }
            goto_line(editor, target - 1);
        }
        return step;
    }
    // the name
    str name = "";
    int argstart = index;
    int first_char = char_code;
    if (first_char == 107 && !(at(text, index + 1) == 101 && at(text, index + 2) == 101)) {
        name = "k";
        argstart = index + 1;
    } else if (is_alpha(first_char)) {
        int stop = index;
        while (stop < text.size() && is_alpha(text.byte_at(stop))) {
            stop = stop + 1;
        }
        name = resolve(text.substr(index, stop));
        argstart = stop;
        if (name == "" && editor.user_commands.contains(text.substr(index, stop))) {
            name = text.substr(index, stop);
        }
        if (name == "") {
            return fail(editor, "E492: Not an editor command: " + text.substr(index, text.size()));
        }
    } else {
        name = canonical_special(first_char);
        argstart = index + 1;
        if (name == "") {
            return fail(editor, "E492: Not an editor command: " + text.substr(index, text.size()));
        }
        if (first_char == 42) {
            cmd.reg = "*";
        }
    }
    bool is_bang = false;
    if (at(text, argstart) == 33 && (is_ui_command(name) || editor.user_commands.contains(name) || name == "foldopen" || name == "foldclose" || name == "global" || name == "join" || name == "put" || name == "z" || name == "normal" || name == "write" || name == "quit" || name == "sort" || name == "delmarks" || name == "wq" || name == "xit" || name == "update" || name == "qall" || name == "wall" || MED_map.kind_of(name) != "")) {
        is_bang = true;
        argstart = argstart + 1;
    }
    cmd.name = name;
    cmd.is_bang = is_bang;
    str arg = text.substr(argstart, text.size());
    if (name == "&" || name == "~" || name == "substitute" || name == "global" || name == "vglobal") {
        // the pattern and flags are parsed by the command itself
        cmd.arg = arg;
    } else if (name == "normal") {
        cmd.arg = skip_one_white(arg);
    } else if (name == "!" || (name == "read" && skip_one_white(arg).starts_with("!"))) {
        // a `|` belongs to the shell command
        cmd.arg = arg;
    } else if (MED_map.kind_of(name) != "" || name == "let") {
        // a `|` belongs to the right-hand side
        cmd.arg = skip_one_white(arg);
    } else if (name == "execute" || name == "echo" || name == "echomsg") {
        Split split = split_bar_expr(arg);
        cmd.arg = skip_one_white(split.arg);
        cmd.is_more = split.is_more;
        cmd.rest = split.rest;
    } else {
        Split split = split_bar(arg, true);
        cmd.arg = skip_one_white(split.arg);
        cmd.is_more = split.is_more;
        cmd.rest = split.rest;
    }
    // the range
    int count = last_line(editor);
    if (cmd.addr_count > 0) {
        if (cmd.line1 > cmd.line2) {
            if (!editor.is_global_busy) {
                return fail(editor, "E493: Backwards range given");
            }
            int turn = cmd.line1;
            cmd.line1 = cmd.line2;
            cmd.line2 = turn;
        }
        if (cmd.line1 < 0 || cmd.line2 < 0 || cmd.line2 > count || cmd.line1 > count) {
            return fail(editor, "E16: Invalid range");
        }
    }
    if (!did_zero_range(name)) {
        if (cmd.line1 == 0) {
            cmd.line1 = 1;
        }
        if (cmd.line2 == 0) {
            cmd.line2 = 1;
        }
    }
    if (cmd.addr_count == 0 && (name == "global" || name == "vglobal" || name == "sort")) {
        cmd.line1 = 1;
        cmd.line2 = count;
    }
    if (editor.folds.size() > 0 && !editor.is_global_busy && (cmd.addr_count >= 2 || is_whole_fold_command(name))) {
        // a range starts at the first line of a closed fold and ends at its last line
        int fold_start = editor.fold_start_of(cmd.line1 - 1);
        if (fold_start >= 0) {
            cmd.line1 = fold_start + 1;
        }
        int fold_end = editor.fold_end_of(cmd.line2 - 1);
        if (fold_end >= 0) {
            cmd.line2 = fold_end + 1;
        }
    }
    Step result = Step();
    if (is_keepp) {
        str sp_pattern = editor.search_pattern;
        str sb_pattern = editor.sub_pattern;
        bool is_sb_last = editor.is_last_is_sub;
        str slash = register_text(editor, "/");
        result = exec_cmd(editor, cmd);
        editor.search_pattern = sp_pattern;
        editor.sub_pattern = sb_pattern;
        editor.is_last_is_sub = is_sb_last;
        editor.regs.set_special("/", slash);
    } else {
        result = exec_cmd(editor, cmd);
    }
    if (result.is_ok && cmd.is_more) {
        result.is_more = true;
        result.rest = cmd.rest;
    }
    if (!result.is_ok && cmd.is_more && editor.ex_depth == 1) {
        // Vim does not remember a typed line in which a command failed with another one after it
        editor.is_colon_skip = true;
    }
    return result;
}

// The commands whose default range is a closed fold taken whole.
bool is_whole_fold_command(str name) {
    List<str> names = ["delete", "yank", "substitute", "&", "~", ">", "<", "copy", "t", "move", "join", "print", "number", "list", "sort", "retab", "left", "right", "center", "fold", "foldopen", "foldclose", "global", "vglobal"];
    for (str known in names) {
        if (known == name) {
            return true;
        }
    }
    return false;
}

str skip_one_white(str text) {
    int offset = 0;
    while (offset < text.size() && is_white(text.byte_at(offset))) {
        offset = offset + 1;
    }
    return text.substr(offset, text.size());
}

// The cursor on `row` (0-based) as `:N` leaves it: beginline(BL_SOL | BL_FIX).
void goto_line(MED_editor.Editor editor, int row) {
    editor.row = row;
    begin_sol(editor);
}

void begin_sol(MED_editor.Editor editor) {
    if (editor.is_startofline) {
        editor.col = MED_vim.first_nonblank_fix(editor.buffer.line(editor.row));
        editor.needs_stale = true;
    } else {
        editor.col = MED_vim.col_by_want(editor, editor.row, editor.want);
    }
}

void begin_white(MED_editor.Editor editor) {
    editor.col = MED_vim.first_nonblank_fix(editor.buffer.line(editor.row));
    editor.needs_stale = true;
}

void set_pcmark(MED_editor.Editor editor) {
    editor.set_pcmark(MED_buffer.Pos(editor.row, editor.col));
}

// ------------------------------------------------------------------ commands

// The register and count of `:d`, `:y` and friends, then the flags `p # l`.
// Returns an error message, "" when fine.
str reg_count(MED_editor.Editor editor, Cmd cmd, bool needs_reg, bool needs_count) {
    str first_text = cmd.arg;
    if (needs_reg && first_text != "" && !(needs_count && is_digit(at(first_text, 0)))) {
        str text_result = first_text.substr(0, 1);
        bool is_read_only = cmd.name != "put" && (text_result == "." || text_result == ":" || text_result == "/" || text_result == "%" || text_result == "#" || text_result == "=");
        if (MED_register.is_valid(text_result) && !is_read_only) {
            cmd.reg = text_result;
            cmd.has_reg = true;
            first_text = skip_one_white(first_text.substr(1, first_text.size()));
        }
    }
    if (needs_count && is_digit(at(first_text, 0))) {
        int stop = skip_digits(first_text, 0);
        int count = digits_value(first_text, 0, stop);
        if (count <= 0) {
            return "E939: Positive count required";
        }
        cmd.line1 = cmd.line2;
        cmd.line2 = cmd.line2 + count - 1;
        cmd.addr_count = cmd.addr_count + 1;
        if (cmd.line2 > last_line(editor)) {
            cmd.line2 = last_line(editor);
        }
        first_text = skip_one_white(first_text.substr(stop, first_text.size()));
    }
    while (first_text != "" && (at(first_text, 0) == 112 || at(first_text, 0) == 35 || at(first_text, 0) == 108)) {
        first_text = skip_one_white(first_text.substr(1, first_text.size()));
    }
    if (first_text != "") {
        return "E488: Trailing characters: " + first_text;
    }
    return "";
}

Step exec_cmd(MED_editor.Editor editor, Cmd cmd) {
    str name = cmd.name;
    if (MED_map.kind_of(name) != "") {
        return run_map(editor, cmd);
    }
    if (name == "let") {
        return run_let(editor, cmd);
    }
    if (name == "abbreviate" || name == "iabbrev" || name == "noreabbrev" || name == "inoreabbrev" || name == "unabbreviate" || name == "iunabbrev" || name == "abclear" || name == "iabclear" || name == "cabbrev" || name == "cnoreabbrev" || name == "cunabbrev" || name == "cabclear") {
        return run_abbrev(editor, cmd);
    }
    if (name == "delete" || name == "yank") {
        str error = reg_count(editor, cmd, true, true);
        if (error != "") {
            return fail(editor, error);
        }
        if (name == "delete") {
            set_pcmark(editor);
            MED_vim.ex_delete(editor, cmd.line1 - 1, cmd.line2 - 1, cmd.reg);
        } else {
            MED_vim.ex_yank(editor, cmd.line1 - 1, cmd.line2 - 1, cmd.reg);
        }
        return done();
    }
    if (name == ">" || name == "<") {
        int amount = 1;
        int offset = 0;
        int char_code = 60;
        if (name == ">") {
            char_code = 62;
        }
        while (at(cmd.arg, offset) == char_code) {
            amount = amount + 1;
            offset = offset + 1;
        }
        cmd.arg = skip_one_white(cmd.arg.substr(offset, cmd.arg.size()));
        str error = reg_count(editor, cmd, false, true);
        if (error != "") {
            return fail(editor, error);
        }
        set_pcmark(editor);
        editor.row = cmd.line1 - 1;
        begin_sol(editor);
        MED_vim.ex_shift(editor, cmd.line1 - 1, cmd.line2 - 1, name == "<", amount);
        return done();
    }
    if (name == "join") {
        str error = reg_count(editor, cmd, false, true);
        if (error != "") {
            return fail(editor, error);
        }
        editor.row = cmd.line1 - 1;
        editor.clamp();
        if (cmd.line1 == cmd.line2) {
            if (cmd.addr_count >= 2) {
                return done();
            }
            if (cmd.line2 == last_line(editor)) {
                return fail(editor, "");
            }
            cmd.line2 = cmd.line2 + 1;
        }
        editor.row = cmd.line1 - 1;
        if (!MED_vim.did_ex_join(editor, cmd.line1 - 1, cmd.line2 - cmd.line1 + 1, !cmd.is_bang)) {
            return fail(editor, "");
        }
        return done();
    }
    if (name == "put") {
        if (cmd.arg.starts_with("=")) {
            // :put =expr puts the value as lines
            MED_expr.Evaluated made = MED_expr.eval(cmd.arg.substr(1, cmd.arg.size()).trim(), expression_context(editor));
            if (!made.is_ok) {
                return fail(editor, made.error);
            }
            List<str> value_lines = made.text.split("\n");
            if (made.text.ends_with("\n")) {
                value_lines.pop();
            }
            editor.regs.set_named("=", MED_register.Reg(value_lines, MED_register.LINE));
            cmd.reg = "=";
            cmd.has_reg = true;
            cmd.arg = "";
        }
        str error = reg_count(editor, cmd, true, false);
        if (error != "") {
            return fail(editor, error);
        }
        bool is_above = cmd.is_bang;
        int row = cmd.line2 - 1;
        if (cmd.line2 == 0) {
            row = 0;
            is_above = true;
        }
        if (!MED_vim.did_ex_put(editor, cmd.reg, row, is_above)) {
            return fail(editor, "E353: Nothing in register");
        }
        return done();
    }
    if (name == "copy" || name == "t" || name == "move") {
        return cmd_copymove(editor, cmd);
    }
    if (name == "k" || name == "mark") {
        str first_text = cmd.arg;
        if (first_text == "") {
            return fail(editor, "E471: Argument required");
        }
        str mode_text = first_text.substr(0, 1);
        if (first_text.size() > 1 || !MED_vim.did_mark_name_ok(mode_text)) {
            return fail(editor, "E191: Argument must be a letter or forward/backward quote");
        }
        int row = cmd.line2 - 1;
        if (mode_text == "`") {
            mode_text = "'";
        }
        editor.marks.set(mode_text, MED_buffer.Pos(row, MED_vim.first_nonblank_fix(editor.buffer.line(row))));
        return done();
    }
    if (name == "delmarks") {
        return cmd_delmarks(editor, cmd);
    }
    if (name == "nohlsearch") {
        editor.is_no_hl = true;
        return done();
    }
    if (name == "fold") {
        MED_fold.create(editor, cmd.line1 - 1, cmd.line2 - 1);
        return done();
    }
    if (name == "foldopen" || name == "foldclose") {
        if (!MED_fold.did_set_range(editor, cmd.line1 - 1, cmd.line2 - 1, name == "foldclose", cmd.is_bang)) {
            return fail(editor, "E490: No fold found");
        }
        return done();
    }
    if (name == "set" || name == "setlocal" || name == "setglobal") {
        return cmd_set(editor, cmd);
    }
    if (name == "syntax") {
        str word = cmd.arg.trim().split(" ")[0];
        if (word == "on" || word == "enable") {
            editor.opts.set("syntaxenabled", "true");
        } else if (word == "off") {
            editor.opts.set("syntaxenabled", "false");
        }
        return done();
    }
    if ((name == "echo" || name == "echomsg") && cmd.arg.trim() != "") {
        MED_expr.Evaluated shown = MED_expr.eval(cmd.arg.trim(), expression_context(editor));
        if (shown.is_ok) {
            editor.message = shown.text;
        }
        return done();
    }
    if (name == "undojoin" || name == "echo" || name == "echomsg" || name == "redraw" || name == "messages" || name == "highlight" || name == "filetype" || name == "version" || name == "history" || name == "pwd") {
        return done();
    }
    if (name == "left" || name == "right" || name == "center") {
        return cmd_align(editor, cmd);
    }
    if (name == "undo" || name == "redo") {
        if (cmd.arg != "" && name == "undo") {
            return cmd_undo_to(editor, cmd);
        }
        MED_vim.cmd_undo(editor, 1, name == "redo");
        return done();
    }
    if (name == "earlier" || name == "later") {
        return cmd_earlier(editor, cmd);
    }
    if (name == "print" || name == "number" || name == "list") {
        str error = reg_count(editor, cmd, false, true);
        if (error != "") {
            return fail(editor, error);
        }
        goto_line(editor, cmd.line2 - 1);
        return done();
    }
    if (name == "=") {
        return done();
    }
    if (name == "z") {
        return cmd_z(editor, cmd);
    }
    if (name == "substitute" || name == "&" || name == "~") {
        return cmd_sub(editor, cmd);
    }
    if (name == "global" || name == "vglobal") {
        return cmd_global(editor, cmd);
    }
    if (name == "normal") {
        return cmd_normal(editor, cmd);
    }
    if (name == "execute") {
        return cmd_execute(editor, cmd);
    }
    if (name == "sort") {
        return cmd_sort(editor, cmd);
    }
    if (name == "!") {
        return cmd_bang(editor, cmd);
    }
    if (name == "read") {
        return cmd_read(editor, cmd);
    }
    if (name == "@") {
        return cmd_at(editor, cmd);
    }
    if (name == "quit" || name == "qall") {
        if (cmd.is_bang) {
            editor.is_force_quit = true;
        }
        editor.is_quit = true;
        editor.is_quit_one = name == "quit";
        return done();
    }
    if (name == "write") {
        editor.requests.push("write " + cmd.arg);
        return done();
    }
    if (name == "update") {
        editor.requests.push("update " + cmd.arg);
        return done();
    }
    if (name == "wall") {
        editor.requests.push("wall");
        return done();
    }
    if (name == "wq") {
        editor.requests.push("write " + cmd.arg);
        editor.is_quit = true;
        editor.is_quit_one = true;
        return done();
    }
    if (name == "xit") {
        editor.requests.push("update " + cmd.arg);
        editor.is_quit = true;
        editor.is_quit_one = true;
        return done();
    }
    if (name == "wqall" || name == "xall") {
        editor.requests.push("wall");
        editor.is_quit = true;
        return done();
    }
    if (is_ui_command(name)) {
        str bang = "";
        if (cmd.is_bang) {
            bang = "!";
        }
        str ui_arg = cmd.arg;
        if (cmd.addr_count > 0 && ui_arg.trim().size() == 0 && name.starts_with("tab")) {
            ui_arg = cmd.line2.to_str();
        }
        editor.requests.push(name + bang + " " + ui_arg);
        return done();
    }
    if (name == "vertical") {
        // `:vertical resize 30`, `:vertical split`, `:vertical new`
        str rest = cmd.arg.trim();
        int space = rest.index_of(" ").or(rest.size());
        str word = resolve(rest.substr(0, space));
        str tail = rest.substr(space, rest.size()).trim();
        if (word == "resize") {
            editor.requests.push("vresize " + tail);
        } else if (word == "split") {
            editor.requests.push("vsplit " + tail);
        } else if (word == "new") {
            editor.requests.push("vnew " + tail);
        } else {
            return fail(editor, "E492: Not an editor command: vertical " + rest);
        }
        return done();
    }
    if (name == "marks") {
        editor.message = MED_listing.marks(editor, cmd.arg.trim().split(" ").join("")).join("\n");
        return done();
    }
    if (name == "registers" || name == "display") {
        editor.message = MED_listing.registers(editor, cmd.arg.trim().split(" ").join("")).join("\n");
        return done();
    }
    if (name == "jumps") {
        editor.message = MED_listing.jumps(editor).join("\n");
        return done();
    }
    if (name == "changes") {
        editor.message = MED_listing.changes(editor).join("\n");
        return done();
    }
    if (name == "stopinsert") {
        return done();
    }
    if (name == "startinsert") {
        if (editor.mode == MED_editor.NORMAL) {
            if (cmd.is_bang) {
                MED_vim.feed(editor, 65);
            } else {
                MED_vim.feed(editor, 105);
            }
        }
        return done();
    }
    if (editor.user_commands.contains(name)) {
        str user_bang = "";
        if (cmd.is_bang) {
            user_bang = "!";
        }
        editor.requests.push(name + user_bang + " " + cmd.arg);
        return done();
    }
    return fail(editor, "E492: Not an editor command: " + name);
}

// ------------------------------------------------------ copy, move, marks, set

// Insert `lines` after 0-based row `after` (-1: above the first line).
void insert_rows(MED_editor.Editor editor, int after, List<str> lines) {
    str body = lines.join("\n");
    if (after < 0) {
        editor.change(MED_buffer.Pos(0, 0), MED_buffer.Pos(0, 0), body + "\n");
    } else if (after >= editor.buffer.line_count() - 1) {
        int result = editor.buffer.line_count() - 1;
        int count = editor.buffer.line_size(result);
        editor.change(MED_buffer.Pos(result, count), MED_buffer.Pos(result, count), "\n" + body);
    } else {
        editor.change(MED_buffer.Pos(after + 1, 0), MED_buffer.Pos(after + 1, 0), body + "\n");
    }
}

// Delete rows `a ..= b` (never all of them).
void delete_rows(MED_editor.Editor editor, int left, int right) {
    if (right >= editor.buffer.line_count() - 1) {
        editor.change(MED_buffer.Pos(left - 1, editor.buffer.line_size(left - 1)), MED_buffer.Pos(right, editor.buffer.line_size(right)), "");
    } else {
        editor.change(MED_buffer.Pos(left, 0), MED_buffer.Pos(right + 1, 0), "");
    }
}

List<str> rows_text(MED_editor.Editor editor, int left, int right) {
    List<str> out = [];
    for (int result in left .. right + 1) {
        out.push(editor.buffer.line(result));
    }
    return out;
}

// Where row `result` ends up when rows a0 ..= b0 move to after row `delta` - 1.
int moved_row(int result, int first_row, int last_row, int delta) {
    int count = last_row - first_row + 1;
    if (delta > last_row) {
        if (result >= first_row && result <= last_row) {
            return result - first_row + delta - count;
        }
        if (result > last_row && result < delta) {
            return result - count;
        }
        return result;
    }
    if (result >= first_row && result <= last_row) {
        return result - first_row + delta;
    }
    if (result >= delta && result < first_row) {
        return result + count;
    }
    return result;
}

Step cmd_copymove(MED_editor.Editor editor, Cmd cmd) {
    Addr addr = get_address(editor, cmd.arg, 0);
    if (!addr.is_ok) {
        return fail(editor, addr.error);
    }
    if (!addr.is_found || addr.line < 0 || addr.line > last_line(editor)) {
        return fail(editor, "E16: Invalid range");
    }
    str tail = skip_one_white(cmd.arg.substr(addr.next, cmd.arg.size()));
    while (tail != "" && (at(tail, 0) == 112 || at(tail, 0) == 35 || at(tail, 0) == 108)) {
        tail = skip_one_white(tail.substr(1, tail.size()));
    }
    if (tail != "") {
        return fail(editor, "E488: Trailing characters: " + tail);
    }
    int dest = addr.line;
    int first_line = cmd.line1;
    int end_line = cmd.line2;
    int count = end_line - first_line + 1;
    if (cmd.name != "move") {
        List<str> block = rows_text(editor, first_line - 1, end_line - 1);
        insert_rows(editor, dest - 1, block);
        editor.override_change(MED_buffer.Pos(dest, 0));
        editor.marks.set("[", MED_buffer.Pos(dest, 0));
        editor.marks.set("]", MED_buffer.Pos(dest + count - 1, 0));
        editor.row = dest + count - 1;
        begin_sol(editor);
        return done();
    }
    if (dest >= first_line && dest < end_line) {
        return fail(editor, "E134: Cannot move a range of lines into itself");
    }
    int cursor_line = dest;
    if (dest < first_line) {
        cursor_line = dest + count;
    }
    if (dest == first_line - 1 || dest == end_line) {
        editor.row = cursor_line - 1;
        begin_sol(editor);
        return done();
    }
    int first_row = first_line - 1;
    int last_row = end_line - 1;
    Map<str, MED_buffer.Pos> saved = {};
    for (str key_text in editor.marks.keys()) {
        MED_buffer.Pos position = editor.marks.get(key_text).or(MED_buffer.Pos(0, 0));
        saved.set(key_text, MED_buffer.Pos(moved_row(position.row, first_row, last_row, dest), position.col));
    }
    List<int> groups = [];
    for (int marker in editor.gmarks) {
        groups.push(moved_row(marker, first_row, last_row, dest));
    }
    List<str> block = rows_text(editor, first_row, last_row);
    if (dest > last_row) {
        insert_rows(editor, dest - 1, block);
        delete_rows(editor, first_row, last_row);
    } else {
        insert_rows(editor, dest - 1, block);
        delete_rows(editor, first_row + count, last_row + count);
    }
    editor.marks = saved;
    editor.gmarks = groups;
    int first_touched = first_line;
    if (dest + 1 < first_touched) {
        first_touched = dest + 1;
    }
    editor.override_change(MED_buffer.Pos(first_touched - 1, 0));
    int start1 = dest + 1;
    if (dest >= end_line) {
        start1 = dest - count + 1;
    }
    editor.marks.set("[", MED_buffer.Pos(start1 - 1, 0));
    editor.marks.set("]", MED_buffer.Pos(start1 + count - 2, 0));
    editor.row = cursor_line - 1;
    begin_sol(editor);
    return done();
}

Step cmd_delmarks(MED_editor.Editor editor, Cmd cmd) {
    if (cmd.is_bang) {
        if (cmd.arg != "") {
            return fail(editor, "E474: Invalid argument");
        }
        for (int key in 97 .. 123) {
            editor.marks.remove(str.from_chars([key]));
        }
        return done();
    }
    if (cmd.arg == "") {
        return fail(editor, "E471: Argument required");
    }
    List<int> codes = cmd.arg.chars();
    int index = 0;
    while (index < codes.size()) {
        int char_code = codes[index];
        if (is_white(char_code)) {
            index = index + 1;
            continue;
        }
        if (index + 2 < codes.size() && codes[index + 1] == 45) {
            int high = codes[index + 2];
            bool is_lower = char_code >= 97 && char_code <= 122 && high >= 97 && high <= 122;
            bool is_upper = char_code >= 65 && char_code <= 90 && high >= 65 && high <= 90;
            if ((!is_lower && !is_upper) || high < char_code) {
                return fail(editor, "E475: Invalid argument: " + cmd.arg);
            }
            for (int key in char_code .. high + 1) {
                editor.marks.remove(str.from_chars([key]));
            }
            index = index + 3;
            continue;
        }
        if (!(MED_vim.did_mark_name_ok(str.from_chars([char_code])) || char_code == 94 || char_code == 46 || char_code == 34)) {
            return fail(editor, "E475: Invalid argument: " + cmd.arg);
        }
        if (char_code == 96) {
            editor.marks.remove("'");
        } else {
            editor.marks.remove(str.from_chars([char_code]));
        }
        index = index + 1;
    }
    return done();
}

// ---------------------------------------------------------------------- :set

// `:set` words: separated by white space; a backslash keeps a space (or a
// backslash) in the word.
List<str> set_words(str arg) {
    List<str> words = [];
    str word = "";
    List<int> chars = arg.chars();
    int index = 0;
    while (index < chars.size()) {
        int char_code = chars[index];
        if (char_code == 92 && index + 1 < chars.size() && (chars[index + 1] == 32 || chars[index + 1] == 92)) {
            word = word + str.from_chars([chars[index + 1]]);
            index = index + 2;
            continue;
        }
        if (char_code == 32 || char_code == 9) {
            words.push(word);
            word = "";
        } else {
            word = word + str.from_chars([char_code]);
        }
        index = index + 1;
    }
    words.push(word);
    return words;
}

str bool_text(bool is_value) {
    if (is_value) {
        return "true";
    }
    return "false";
}

// The value of an option as text ("true"/"false" for a boolean).
pub str option_text(MED_editor.Editor editor, MED_option.Spec spec) {
    str name = spec.name;
    if (name == "tabstop") {
        return editor.tab.to_str();
    }
    if (name == "shiftwidth") {
        return editor.shiftwidth.to_str();
    }
    if (name == "softtabstop") {
        return editor.softtabstop.to_str();
    }
    if (name == "textwidth") {
        return editor.textwidth.to_str();
    }
    if (name == "commentstring") {
        return editor.commentstring;
    }
    if (name == "expandtab") {
        return bool_text(editor.is_expandtab);
    }
    if (name == "autoindent") {
        return bool_text(editor.is_autoindent);
    }
    if (name == "ignorecase") {
        return bool_text(editor.is_ignorecase);
    }
    if (name == "smartcase") {
        return bool_text(editor.is_smartcase);
    }
    if (name == "wrapscan") {
        return bool_text(editor.is_wrapscan);
    }
    if (name == "joinspaces") {
        return bool_text(editor.is_joinspaces);
    }
    if (name == "startofline") {
        return bool_text(editor.is_startofline);
    }
    if (name == "smarttab") {
        return bool_text(editor.is_smarttab);
    }
    if (name == "shiftround") {
        return bool_text(editor.is_shiftround);
    }
    return editor.opts.get(name).or(spec.default);
}

void option_store(MED_editor.Editor editor, MED_option.Spec spec, str text) {
    str name = spec.name;
    bool is_on = text == "true";
    int count = text.parse_int().or(0);
    if (name == "tabstop") {
        editor.tab = count;
        editor.want_from_cursor();
    } else if (name == "shiftwidth") {
        editor.shiftwidth = count;
    } else if (name == "softtabstop") {
        editor.softtabstop = count;
    } else if (name == "textwidth") {
        editor.textwidth = count;
    } else if (name == "commentstring") {
        editor.commentstring = text;
    } else if (name == "expandtab") {
        editor.is_expandtab = is_on;
    } else if (name == "autoindent") {
        editor.is_autoindent = is_on;
    } else if (name == "ignorecase") {
        editor.is_ignorecase = is_on;
    } else if (name == "smartcase") {
        editor.is_smartcase = is_on;
    } else if (name == "wrapscan") {
        editor.is_wrapscan = is_on;
    } else if (name == "joinspaces") {
        editor.is_joinspaces = is_on;
    } else if (name == "startofline") {
        editor.is_startofline = is_on;
    } else if (name == "smarttab") {
        editor.is_smarttab = is_on;
    } else if (name == "shiftround") {
        editor.is_shiftround = is_on;
    } else if (name == "iskeyword") {
        editor.opts.set(name, text);
        editor.buffer.keywords = MED_text.keyword_table(text);
    } else {
        editor.opts.set(name, text);
        if (name == "clipboard") {
            editor.regs.clip_mode = text;
        }
    }
}

// What `:set name?` shows.
str option_show(MED_editor.Editor editor, MED_option.Spec spec) {
    str text = option_text(editor, spec);
    if (spec.kind == "bool") {
        if (text == "true") {
            return "  " + spec.name;
        }
        return "no" + spec.name;
    }
    return "  " + spec.name + "=" + text;
}

const List<str> COMMA_OPTIONS = ["iskeyword", "isfname", "isident", "isprint", "matchpairs", "nrformats", "whichwrap", "backspace", "clipboard", "display", "virtualedit", "listchars", "fillchars", "wildmode", "completeopt", "switchbuf", "comments", "suffixesadd", "path", "tags", "errorformat", "jumpoptions", "cinoptions", "cinkeys", "indentkeys", "colorcolumn", "cursorlineopt", "spelllang", "wildignore", "belloff", "backupcopy", "diffopt", "foldopen", "foldclose", "sessionoptions", "viewoptions", "wildoptions", "tabclose", "keymodel", "mousemodel", "scrollopt", "selection"];
const List<str> FLAG_OPTIONS = ["formatoptions", "shortmess", "cpoptions", "mouse", "guioptions", "matchpairs_flags"];

bool is_listed(List<str> names, str name) {
    for (str entry in names) {
        if (entry == name) {
            return true;
        }
    }
    return false;
}

// A string option's new value for `=`, `+=` (append), `^=` (prepend) and `-=`;
// comma-separated options add and remove items, flag options characters.
str string_value(str name, str current, str operator, str value) {
    if (operator == "=" || value == "") {
        if (operator == "=") {
            return value;
        }
        return current;
    }
    if (is_listed(COMMA_OPTIONS, name)) {
        List<str> items = [];
        if (current != "") {
            items = current.split(",");
        }
        bool is_there = is_listed(items, value);
        if (operator == "-") {
            List<str> kept = [];
            for (str item in items) {
                if (item != value) {
                    kept.push(item);
                }
            }
            return kept.join(",");
        }
        if (is_there) {
            return current;
        }
        if (current == "") {
            return value;
        }
        if (operator == "^") {
            return value + "," + current;
        }
        return current + "," + value;
    }
    if (is_listed(FLAG_OPTIONS, name)) {
        str result = current;
        if (operator == "-") {
            for (int i in 0 .. value.size()) {
                result = result.split(value.substr(i, i + 1)).join("");
            }
            return result;
        }
        str added = "";
        for (int i in 0 .. value.size()) {
            str one = value.substr(i, i + 1);
            if (!result.contains(one) && !added.contains(one)) {
                added = added + one;
            }
        }
        if (operator == "^") {
            return added + result;
        }
        return result + added;
    }
    if (operator == "+") {
        return current + value;
    }
    if (operator == "^") {
        return value + current;
    }
    if (current == value) {
        return "";
    }
    return current.split(value).join("");
}

str number_error(str name, int count, str token) {
    if (name == "tabstop" && count <= 0) {
        return "E487: Argument must be positive: " + token;
    }
    if (name == "softtabstop" || name == "tabstop") {
        return "";
    }
    if (count < 0 && name != "laststatus" && name != "foldlevel" && name != "undolevels") {
        return "E487: Argument must be positive: " + token;
    }
    return "";
}

Step cmd_set(MED_editor.Editor editor, Cmd cmd) {
    str shown = "";
    for (str token in set_words(cmd.arg)) {
        if (token == "" || token == "all") {
            continue;
        }
        str word = token;
        str operator = "";
        str value = "";
        int equals_at = -1;
        for (int i in 0 .. token.size()) {
            int char_code = token.byte_at(i);
            if (char_code == 61 || char_code == 58) {
                equals_at = i;
                break;
            }
        }
        if (equals_at >= 0) {
            word = token.substr(0, equals_at);
            value = token.substr(equals_at + 1, token.size());
            operator = "=";
            if (word.ends_with("+") || word.ends_with("-") || word.ends_with("^")) {
                operator = word.substr(word.size() - 1, word.size());
                word = word.substr(0, word.size() - 1);
            }
        }
        bool is_query = false;
        bool is_invert = false;
        bool is_negate = false;
        bool is_reset = false;
        if (word.ends_with("?")) {
            is_query = true;
            word = word.substr(0, word.size() - 1);
        } else if (word.ends_with("!")) {
            is_invert = true;
            word = word.substr(0, word.size() - 1);
        } else if (word.ends_with("&")) {
            is_reset = true;
            word = word.substr(0, word.size() - 1);
        }
        MED_option.Spec spec = MED_option.find(word);
        if (spec.name == "" && word.starts_with("no")) {
            spec = MED_option.find(word.substr(2, word.size()));
            is_negate = spec.name != "";
        }
        if (spec.name == "" && word.starts_with("inv")) {
            spec = MED_option.find(word.substr(3, word.size()));
            is_invert = spec.name != "";
        }
        if (spec.name == "") {
            return fail(editor, "E518: Unknown option: " + word);
        }
        if (spec.kind == "bool") {
            if (operator != "" || ((is_negate || is_invert) && is_query)) {
                return fail(editor, "E474: Invalid argument: " + token);
            }
            if (is_query) {
                shown = shown + option_show(editor, spec);
            } else if (is_reset) {
                option_store(editor, spec, spec.default);
            } else if (is_invert) {
                option_store(editor, spec, bool_text(option_text(editor, spec) != "true"));
            } else {
                option_store(editor, spec, bool_text(!is_negate));
            }
            continue;
        }
        if (is_negate || is_invert) {
            return fail(editor, "E474: Invalid argument: " + token);
        }
        if (is_reset) {
            option_store(editor, spec, spec.default);
            continue;
        }
        if (is_query || operator == "") {
            shown = shown + option_show(editor, spec);
            continue;
        }
        if (spec.kind == "str") {
            option_store(editor, spec, string_value(spec.name, option_text(editor, spec), operator, value));
            continue;
        }
        bool is_signed = value.starts_with("-") && value.size() > 1 && skip_digits(value, 1) == value.size();
        if (value == "" || (!is_signed && skip_digits(value, 0) != value.size())) {
            return fail(editor, "E521: Number required after =: " + token);
        }
        int count = value.parse_int().or(0);
        int current = option_text(editor, spec).parse_int().or(0);
        if (operator == "+") {
            count = current + count;
        } else if (operator == "-") {
            count = current - count;
        } else if (operator == "^") {
            count = current * count;
        }
        str error = number_error(spec.name, count, token);
        if (error != "") {
            return fail(editor, error);
        }
        option_store(editor, spec, count.to_str());
    }
    if (shown != "") {
        editor.message = shown;
    }
    return done();
}

// ------------------------------------------------------------- undo and @

Step cmd_undo_to(MED_editor.Editor editor, Cmd cmd) {
    if (skip_digits(cmd.arg, 0) != cmd.arg.size()) {
        return fail(editor, "E474: Invalid argument");
    }
    editor.close_block();
    int count = digits_value(cmd.arg, 0, cmd.arg.size());
    if (count >= editor.nodes.size() || !editor.did_undo_to(count)) {
        return fail(editor, "E830: Undo number " + count.to_str() + " not found");
    }
    return done();
}

// `:[range]z[+-^.=][count]`: the cursor ends on the last line it would print.
Step cmd_z(MED_editor.Editor editor, Cmd cmd) {
    str first_text = cmd.arg;
    int kind = 0;
    int new_insert = 0;
    if (first_text.size() > 0) {
        int key = first_text.byte_at(0);
        if (key == 45 || key == 43 || key == 61 || key == 94 || key == 46) {
            kind = key;
            new_insert = 1;
        }
    }
    int bigness = (editor.view_height / 2) * 2;
    if (cmd.is_bang) {
        bigness = editor.view_height + 1;
    }
    int replacement = 1;
    if (kind == 45 || kind == 43) {
        while (new_insert < first_text.size() && first_text.byte_at(new_insert) == kind) {
            replacement = replacement + 1;
            new_insert = new_insert + 1;
        }
    }
    if (new_insert < first_text.size()) {
        int value = 0;
        for (int j in new_insert .. first_text.size()) {
            int delta = first_text.byte_at(j);
            if (delta < 48 || delta > 57) {
                return fail(editor, "E144: non-numeric argument to :z");
            }
            value = value * 10 + (delta - 48);
        }
        bigness = value;
        if (kind == 61) {
            bigness = bigness + 2;
        }
    }
    int lnum = cmd.line2;
    int start = lnum;
    int end = lnum;
    int curs = lnum;
    if (kind == 45) {
        start = lnum - bigness * replacement + 1;
        end = start + bigness - 1;
        curs = end;
    } else if (kind == 61) {
        curs = lnum;
    } else if (kind == 94) {
        start = lnum - bigness * 2 * replacement;
        end = start + bigness;
        curs = end;
    } else if (kind == 46) {
        end = lnum + (bigness - 1) / 2;
        curs = end;
    } else {
        if (kind == 43) {
            start = lnum + bigness * (replacement - 1) + 1;
        } else if (cmd.addr_count == 0) {
            start = lnum + 1;
        }
        end = start + bigness - 1;
        curs = end;
    }
    int last = editor.buffer.line_count();
    if (curs > last) {
        curs = last;
    }
    if (curs < 1) {
        curs = 1;
    }
    // the column is only touched when the line changes: then it is column 0
    if (curs - 1 != editor.row) {
        editor.row = curs - 1;
        editor.col = 0;
        editor.want_from_cursor();
    }
    return done();
}

Step cmd_earlier(MED_editor.Editor editor, Cmd cmd) {
    int count = 1;
    str first_text = cmd.arg;
    bool is_by_file = false;
    if (first_text != "") {
        int stop = skip_digits(first_text, 0);
        if (stop == first_text.size() - 1 && first_text.byte_at(stop) == 102) {
            is_by_file = true;
        } else if (stop != first_text.size() || stop == 0) {
            return fail(editor, "E475: Invalid argument: " + first_text);
        }
        if (stop > 0) {
            count = digits_value(first_text, 0, stop);
        }
    }
    editor.close_block();
    bool is_back = cmd.name == "earlier";
    int target = editor.current + count;
    if (is_back) {
        target = editor.current - count;
    }
    if (is_by_file) {
        // the Nth write away; no more writes: the original text / the newest state
        target = 0;
        if (!is_back) {
            target = editor.nodes.size() - 1;
        }
        int seen = 0;
        int key = 0;
        if (is_back) {
            key = editor.saved_nodes.size() - 1;
        } else {
            key = 0;
        }
        while (key >= 0 && key < editor.saved_nodes.size()) {
            int width = editor.saved_nodes[key];
            if ((is_back && width < editor.current) || (!is_back && width > editor.current)) {
                seen = seen + 1;
                if (seen == count) {
                    target = width;
                    break;
                }
            }
            if (is_back) {
                key = key - 1;
            } else {
                key = key + 1;
            }
        }
    }
    target = MED_num.clamp(target, 0, editor.nodes.size() - 1);
    if (target != editor.current && !editor.did_undo_to(target)) {
        return fail(editor, "");
    }
    return done();
}

Step cmd_at(MED_editor.Editor editor, Cmd cmd) {
    str name = cmd.arg;
    if (cmd.reg != "") {
        name = cmd.reg;
    }
    if (name == "" || name == "@") {
        // the register last executed with `@` or `:@`
        name = editor.last_macro;
        if (name == "") {
            return fail(editor, "E748: No previously used register");
        }
    }
    if (cmd.addr_count > 0) {
        editor.row = cmd.line2 - 1;
        editor.clamp();
    }
    editor.last_macro = name.substr(0, 1);
    str text = "";
    if (name == ":") {
        text = editor.regs.last_command;
        if (text == "") {
            return fail(editor, "E30: No previous command line");
        }
        editor.is_colon_skip = true;
    } else {
        Option<MED_register.Reg> reg_option = editor.regs.get(name.substr(0, 1));
        match (reg_option) {
            case Some(MED_register.Reg reg): {
                text = reg.lines.join("\n");
            }
            case None: {
                return fail(editor, "E748: No previously used register");
            }
        }
    }
    for (str line in text.split("\n")) {
        if (!did_run_line(editor, line)) {
            return fail(editor, "");
        }
    }
    return done();
}

// ------------------------------------------------------------------- :normal

// Type `keys` as a complete command; an unfinished one is aborted as by <Esc>.
bool did_run_normal(MED_editor.Editor editor, List<int> keys) {
    bool is_saved_replaying = editor.is_replaying;
    editor.replay_runs = editor.replay_runs + 1;
    // an insert that CTRL-O left open is restarted after the whole `:normal`
    int saved_restart = editor.restart_edit;
    bool is_saved_skip = editor.is_restart_skip;
    bool is_saved_eol = editor.is_ins_at_eol;
    int saved_lnum = editor.o_lnum;
    editor.restart_edit = 0;
    editor.is_replaying = true;
    editor.is_failed = false;
    editor.message = "";
    MED_vim.run_keys(editor, keys, keys, 0);
    drain(editor);
    if (editor.mode == MED_editor.CMDLINE) {
        MED_vim.feed(editor, 3);
    } else if (editor.mode == MED_editor.INSERT || editor.mode == MED_editor.REPLACE || editor.pending.size() > 0) {
        MED_vim.feed(editor, 27);
    }
    editor.pending = [];
    editor.is_replaying = is_saved_replaying;
    editor.restart_edit = saved_restart;
    editor.is_restart_skip = is_saved_skip;
    editor.is_ins_at_eol = is_saved_eol;
    editor.o_lnum = saved_lnum;
    editor.is_failed = false;
    // an error message (not just a beep) makes the calling command fail
    return !(editor.message.size() > 3 && editor.message.byte_at(0) == 69 && is_digit(editor.message.byte_at(1)));
}

// Display width of a line up to its last non-blank, and whether the text has a tab.
int line_length(MED_editor.Editor editor, str line) {
    int last = line.size();
    while (last > 0 && is_white(line.byte_at(last - 1))) {
        last = last - 1;
    }
    return MED_text.display_col(line, last, editor.tab);
}

// :left, :right and :center (Vim's ex_align()).
Step cmd_align(MED_editor.Editor editor, Cmd cmd) {
    int width = 0;
    str first_text = cmd.arg;
    if (first_text != "") {
        int stop = skip_digits(first_text, 0);
        if (stop > 0) {
            width = digits_value(first_text, 0, stop);
        }
    }
    int indent = 0;
    if (cmd.name == "left") {
        indent = width;
    } else if (width <= 0) {
        width = 80;
    }
    int old_row = editor.row;
    int old_col = editor.col;
    for (int row in cmd.line1 - 1 .. cmd.line2) {
        str line = editor.buffer.line(row);
        int new_indent = indent;
        if (cmd.name != "left") {
            int length = line_length(editor, line) - MED_vim.indent_width(editor, line);
            if (length <= 0) {
                continue;
            }
            bool has_tab = MED_text.first_nonblank(line) < line.size() && line.substr(MED_text.first_nonblank(line), line.size()).index_of("\t").is_some();
            if (cmd.name == "center") {
                new_indent = (width - length) / 2;
            } else {
                new_indent = width - length;
                if (has_tab) {
                    while (new_indent > 0) {
                        if (line_length(editor, MED_vim.with_indent(editor, line, new_indent)) <= width) {
                            new_indent = new_indent + 1;
                            while (line_length(editor, MED_vim.with_indent(editor, line, new_indent)) <= width) {
                                new_indent = new_indent + 1;
                            }
                            new_indent = new_indent - 1;
                            break;
                        }
                        new_indent = new_indent - 1;
                    }
                }
            }
        }
        if (new_indent < 0) {
            new_indent = 0;
        }
        str replaced = MED_vim.with_indent(editor, line, new_indent);
        if (replaced != line) {
            replace_row(editor, row, replaced);
        }
    }
    editor.row = old_row;
    editor.col = old_col;
    editor.clamp();
    begin_white(editor);
    return done();
}

// `:execute "cmd" 'cmd2' ...`: string literals only; the pieces are joined by a space.
Step cmd_execute(MED_editor.Editor editor, Cmd cmd) {
    str first_text = cmd.arg;
    List<str> parts = [];
    int offset = 0;
    while (offset < first_text.size()) {
        int char_code = first_text.byte_at(offset);
        if (char_code == 32 || char_code == 9) {
            offset = offset + 1;
        } else if (char_code == 39) {
            List<int> out = [];
            offset = offset + 1;
            bool is_closed = false;
            while (offset < first_text.size()) {
                if (first_text.byte_at(offset) == 39) {
                    if (at(first_text, offset + 1) == 39) {
                        out.push(39);
                        offset = offset + 2;
                    } else {
                        offset = offset + 1;
                        is_closed = true;
                        break;
                    }
                } else {
                    out.push(first_text.byte_at(offset));
                    offset = offset + 1;
                }
            }
            if (!is_closed) {
                return fail(editor, "E115: Missing quote: " + first_text);
            }
            parts.push(str.from_chars(out));
        } else if (char_code == 34) {
            List<int> out = [];
            offset = offset + 1;
            bool is_closed = false;
            while (offset < first_text.size()) {
                int delta = first_text.byte_at(offset);
                if (delta == 34) {
                    offset = offset + 1;
                    is_closed = true;
                    break;
                }
                if (delta == 92 && offset + 1 < first_text.size()) {
                    int stop = first_text.byte_at(offset + 1);
                    if (stop == 110) {
                        out.push(10);
                    } else if (stop == 116) {
                        out.push(9);
                    } else if (stop == 114) {
                        out.push(13);
                    } else {
                        out.push(stop);
                    }
                    offset = offset + 2;
                } else {
                    out.push(delta);
                    offset = offset + 1;
                }
            }
            if (!is_closed) {
                return fail(editor, "E114: Missing quote: " + first_text);
            }
            parts.push(str.from_chars(out));
        } else {
            return fail(editor, "E15: Invalid expression: " + first_text);
        }
    }
    if (parts.size() == 0) {
        return done();
    }
    if (!did_run_line(editor, parts.join(" "))) {
        return fail(editor, "");
    }
    return done();
}

Step cmd_normal(MED_editor.Editor editor, Cmd cmd) {
    if (cmd.arg == "") {
        return fail(editor, "E471: Argument required");
    }
    List<int> keys = cmd.arg.chars();
    if (cmd.addr_count == 0) {
        if (!did_run_normal(editor, keys)) {
            return fail(editor, editor.message);
        }
        return done();
    }
    int lnum = cmd.line1;
    bool is_bad = false;
    str error = "";
    while (lnum <= cmd.line2) {
        editor.row = MED_num.smaller(lnum - 1, last_line(editor) - 1);
        editor.col = 0;
        editor.want_from_cursor();
        if (!did_run_normal(editor, keys)) {
            is_bad = true;
            error = editor.message;
        }
        lnum = lnum + 1;
    }
    if (is_bad) {
        return fail(editor, error);
    }
    return done();
}

// ------------------------------------------------------------------- :global

bool is_alnum(int char_code) {
    return is_alpha(char_code) || is_digit(char_code);
}

Step cmd_global(MED_editor.Editor editor, Cmd cmd_value) {
    bool is_invert = cmd_value.is_bang || cmd_value.name == "vglobal";
    if (editor.is_global_busy && (cmd_value.line1 != 1 || cmd_value.line2 != last_line(editor))) {
        return fail(editor, "E147: Cannot do :global recursive with a range");
    }
    str first_text = cmd_value.arg;
    if (first_text == "") {
        return fail(editor, "E471: Argument required");
    }
    str pattern = "";
    str cmd = "";
    int delta = at(first_text, 0);
    if (delta == 92) {
        int stop = at(first_text, 1);
        if (stop == 47 || stop == 63) {
            pattern = editor.search_pattern;
        } else if (stop == 38) {
            pattern = editor.sub_pattern;
        } else {
            return fail(editor, "E10: \\ should be followed by /, ? or &");
        }
        if (pattern == "") {
            return fail(editor, "E35: No previous regular expression");
        }
        cmd = first_text.substr(2, first_text.size());
    } else {
        if (is_alnum(delta) || delta == 34 || delta == 124) {
            return fail(editor, "E146: Regular expressions can't be delimited by letters");
        }
        str rest = first_text.substr(1, first_text.size());
        int end = MED_search.skip_regexp(rest, delta);
        pattern = rest.substr(0, end);
        note_search_history(editor, pattern);
        if (end < rest.size()) {
            cmd = rest.substr(end + 1, rest.size());
        }
        if (pattern == "") {
            pattern = MED_search.last_pattern(editor);
            if (pattern == "") {
                return fail(editor, "E35: No previous regular expression");
            }
        }
    }
    if (!(cmd_value.name == "vglobal" && false)) {
        MED_search.set_last_pattern(editor, pattern, false);
        MED_search.set_last_pattern(editor, pattern, true);
    }
    MED_regex.Regex regex = MED_search.compile_with(editor, pattern, false);
    if (!regex.is_ok) {
        return fail(editor, regex.error);
    }
    if (editor.is_global_busy) {
        MED_regex.Match match_value = regex.search_line(editor.buffer, editor.row, 0);
        if (match_value.is_ok != is_invert) {
            return run_global_cmd(editor, cmd);
        }
        return done();
    }
    List<int> marked = [];
    for (int row in cmd_value.line1 - 1 .. cmd_value.line2) {
        MED_regex.Match match_value = regex.search_line(editor.buffer, row, 0);
        if (match_value.is_ok != is_invert) {
            marked.push(row);
        }
    }
    if (marked.size() == 0) {
        if (is_invert) {
            editor.message = "Pattern found in every line: " + pattern;
        } else {
            editor.message = "Pattern not found: " + pattern;
        }
        return done();
    }
    set_pcmark(editor);
    editor.gmarks = marked;
    editor.is_gmarks_on = true;
    editor.is_global_busy = true;
    editor.is_need_beginline = false;
    // the whole :g is one undoable change, also while a prompt waits for keys
    editor.block_hold = editor.block_hold + 1;
    return global_loop(editor, cmd);
}

// Run `cmd` on the marked lines that are left; stops at a `:s///c` prompt (the
// answer to it, in sub_key, comes back here) or when a command fails.
Step global_loop(MED_editor.Editor editor, str cmd) {
    bool is_ok = true;
    while (editor.gmarks.size() > 0) {
        int best = 0;
        for (int i in 1 .. editor.gmarks.size()) {
            if (editor.gmarks[i] < editor.gmarks[best]) {
                best = i;
            }
        }
        int row = editor.gmarks[best];
        editor.gmarks.remove_at(best);
        if (row >= last_line(editor)) {
            continue;
        }
        editor.row = row;
        editor.col = 0;
        Step step = run_global_cmd(editor, cmd);
        if (!step.is_ok) {
            is_ok = false;
            break;
        }
        if (editor.sub_run.is_active) {
            // a prompt is waiting for a key: go on when it is answered
            editor.is_global_waiting = true;
            editor.global_cmd = cmd;
            return done();
        }
    }
    editor.is_global_waiting = false;
    editor.is_global_busy = false;
    editor.is_gmarks_on = false;
    editor.gmarks = [];
    editor.block_hold = editor.block_hold - 1;
    if (editor.block_hold == 0 && editor.mode == MED_editor.NORMAL) {
        editor.end_block();
    }
    if (editor.is_need_beginline) {
        begin_white(editor);
    } else {
        editor.clamp();
    }
    editor.is_need_beginline = false;
    if (!is_ok) {
        return fail(editor, "");
    }
    return done();
}

Step run_global_cmd(MED_editor.Editor editor, str cmd) {
    str text = cmd;
    if (skip_one_white(text) == "") {
        text = "p";
    }
    if (!did_run_isolated(editor, text)) {
        return fail(editor, "");
    }
    return done();
}

// ----------------------------------------------------------------------- :s

// Vim's regtilde(): `~` in a replacement stands for the previous replacement.
str regtilde(str sub, str previous) {
    List<int> codes = sub.chars();
    List<int> out = [];
    int index = 0;
    while (index < codes.size()) {
        int char_code = codes[index];
        if (char_code == 126) {
            for (int offset in previous.chars()) {
                out.push(offset);
            }
            index = index + 1;
        } else if (char_code == 92 && index + 1 < codes.size()) {
            out.push(char_code);
            out.push(codes[index + 1]);
            index = index + 2;
        } else {
            out.push(char_code);
            index = index + 1;
        }
    }
    return str.from_chars(out);
}

int case_map(int char_code, int mode) {
    if (mode == 1) {
        return MED_case.upper_cp(char_code);
    }
    if (mode == 2) {
        return MED_case.lower_cp(char_code);
    }
    return char_code;
}

/// The text a match is replaced with, before line breaks and backslashes are
/// resolved (Vim's vim_regsub_multi() with REGSUB_BACKSLASH | REGSUB_MAGIC):
/// a CR is a line break, a backslash protects the next character.
str expand_sub(str sub, MED_regex.Match match_value) {
    List<int> codes = sub.chars();
    List<int> out = [];
    int func_one = 0;
    int func_all = 0;
    int index = 0;
    while (index < codes.size()) {
        int char_code = codes[index];
        index = index + 1;
        int no_index = -1;
        if (char_code == 38) {
            no_index = 0;
        } else if (char_code == 92 && index < codes.size()) {
            int delta = codes[index];
            if (delta >= 48 && delta <= 57) {
                no_index = delta - 48;
                index = index + 1;
            } else if (delta == 117 || delta == 85 || delta == 108 || delta == 76 || delta == 101 || delta == 69) {
                index = index + 1;
                if (delta == 117) {
                    func_one = 1;
                } else if (delta == 85) {
                    func_all = 1;
                } else if (delta == 108) {
                    func_one = 2;
                } else if (delta == 76) {
                    func_all = 2;
                } else {
                    func_one = 0;
                    func_all = 0;
                }
                continue;
            }
        }
        if (no_index < 0) {
            int current_col = char_code;
            if (char_code == 92 && index < codes.size()) {
                int delta = codes[index];
                if (delta == 114) {
                    current_col = 13;
                    index = index + 1;
                } else if (delta == 110) {
                    current_col = 0;
                    index = index + 1;
                } else if (delta == 116) {
                    current_col = 9;
                    index = index + 1;
                } else if (delta == 98) {
                    current_col = 8;
                    index = index + 1;
                } else {
                    out.push(92);
                    current_col = delta;
                    index = index + 1;
                }
            }
            if (func_one != 0) {
                current_col = case_map(current_col, func_one);
                func_one = 0;
            } else if (func_all != 0) {
                current_col = case_map(current_col, func_all);
            }
            out.push(current_col);
        } else {
            str text = "";
            if (no_index < match_value.groups.size()) {
                text = match_value.groups[no_index];
            }
            for (int char_value in text.chars()) {
                if (char_value == 10) {
                    out.push(13);
                } else if (char_value == 13 || char_value == 92) {
                    out.push(92);
                    out.push(char_value);
                } else if (func_one != 0) {
                    out.push(case_map(char_value, func_one));
                    func_one = 0;
                } else if (func_all != 0) {
                    out.push(case_map(char_value, func_all));
                } else {
                    out.push(char_value);
                }
            }
        }
    }
    return str.from_chars(out);
}

// The text of a `\=` result as the substitution loop wants it: a NL is a line
// break, a backslash stays a backslash (and a backslash before a NL is a NUL).
str expr_replacement(str text) {
    List<int> codes = text.chars();
    List<int> out = [];
    int index = 0;
    while (index < codes.size()) {
        int char_code = codes[index];
        if (char_code == 92) {
            if (index + 1 < codes.size() && codes[index + 1] == 10) {
                out.push(0);
                index = index + 2;
                continue;
            }
            out.push(92);
        } else if (char_code == 10) {
            char_code = 13;
        }
        out.push(char_code);
        index = index + 1;
    }
    return str.from_chars(out);
}

// A pattern given to :s, :g or :v goes into the search history.
void note_search_history(MED_editor.Editor editor, str pattern) {
    if (pattern == "") {
        return;
    }
    List<str> kept = [];
    for (str piece in editor.hist_search) {
        if (piece != pattern) {
            kept.push(piece);
        }
    }
    kept.push(pattern);
    editor.hist_search = kept;
}

bool is_pattern_multiline(str pattern) {
    return pattern.index_of("\\n").is_some() || pattern.index_of("\\_").is_some();
}

bool has_flag(str flags, str flag) {
    return flags.index_of(flag).is_some();
}

// Replace line `row` (0-based) of the buffer with `text`.
void replace_row(MED_editor.Editor editor, int row, str text) {
    editor.change(MED_buffer.Pos(row, 0), MED_buffer.Pos(row, editor.buffer.line_size(row)), text);
}

// Insert a line above row `row` (0-based); marks below it move, those on `row` stay (Vim's ml_append + mark_adjust).
void append_above(MED_editor.Editor editor, int row, str text) {
    editor.is_adjust_off = true;
    editor.change(MED_buffer.Pos(row, 0), MED_buffer.Pos(row, 0), text + "\n");
    editor.is_adjust_off = false;
    editor.mark_adjust(row + 1, 0, 1);
}

const int MAXCOL = 2147483647;

// The loop of Vim's do_sub(): `line1` and `line2_in` are 1-based, the rest of the
// state is 0-based rows. `sub` is the replacement after `~` was expanded.

// The prompt of `:s///c`: the key that answers it comes back through sub_key().
Step sub_prompt(MED_editor.Editor editor, MED_editor.SubRun run) {
    if (!run.is_hold) {
        run.is_hold = true;
        editor.block_hold = editor.block_hold + 1;
    }
    run.is_active = true;
    editor.sub_run = run;
    editor.message = "replace with " + run.sub + " (y/n/a/q/l/^E/^Y)?";
    return done();
}

// The key answering a `:s///c` prompt.
void sub_key(MED_editor.Editor editor, int key) {
    MED_editor.SubRun run = editor.sub_run;
    if (key == 5 || key == 25) {
        return;
    }
    run.is_active = false;
    Step step = sub_lines(editor, run, key);
    if (!step.is_ok) {
        editor.is_failed = true;
    }
    if (!run.is_active && run.rest != "") {
        str after = run.rest;
        run.rest = "";
        if (!did_run_isolated(editor, after)) {
            editor.is_failed = true;
        }
    }
    if (editor.is_global_waiting && !editor.sub_run.is_active) {
        // the `:g` that ran the substitute goes on with its other lines
        editor.is_global_waiting = false;
        Step rest = global_loop(editor, editor.global_cmd);
        if (!rest.is_ok) {
            editor.is_failed = true;
        }
    }
}

Step sub_lines(MED_editor.Editor editor, MED_editor.SubRun run, int answer) {
    bool is_resuming = answer != 0;
    while (is_resuming || (run.lnum <= run.line2 && run.lnum < editor.buffer.line_count() && !run.is_quit)) {
        bool is_in_match = is_resuming;
        if (!is_resuming) {
            run.match_value = run.regex.search_line(editor.buffer, run.lnum, 0);
            is_in_match = run.match_value.is_ok;
        }
        if (is_in_match) {
            if (!is_resuming) {
                run.base = run.lnum;
                run.nmatch = run.match_value.erow - run.base + 1;
                run.srel = run.match_value.srow - run.base;
                run.erel = run.match_value.erow - run.base;
                run.previous_matchcol = MAXCOL;
                run.copycol = 0;
                run.matchcol = 0;
                run.is_new_has = false;
                run.new_start = "";
                run.did_sub = false;
                run.nmatch_tl = 0;
                run.is_skip_match = false;
                run.sub_row = run.lnum;
                run.sub_first = "";
                run.is_have_first = false;
                if (!run.is_got_match) {
                    set_pcmark(editor);
                    run.is_got_match = true;
                }
            }
            while (true) {
                bool should_again = false;
                bool is_skip = false;
                if (!is_resuming) {
                    if (run.srel > 0) {
                        run.lnum = run.lnum + run.srel;
                        run.sub_row = run.sub_row + run.srel;
                        run.nmatch = run.nmatch - run.srel;
                        run.is_have_first = false;
                    }
                    if (run.lnum >= editor.buffer.line_count()) {
                        break;
                    }
                    if (!run.is_have_first) {
                        run.sub_first = editor.buffer.line(run.sub_row);
                        run.is_have_first = true;
                    }
                    editor.row = run.lnum;
                    if (run.matchcol == run.previous_matchcol && run.erel == 0 && run.matchcol == run.match_value.ecol) {
                        if (run.matchcol >= run.sub_first.size()) {
                            run.is_skip_match = true;
                        } else {
                            run.matchcol = MED_text.next_col(run.sub_first, run.matchcol);
                        }
                        is_skip = true;
                    }
                    if (!is_skip) {
                        run.matchcol = run.match_value.ecol;
                        run.previous_matchcol = run.matchcol;
                        if (run.should_count) {
                            if (run.nmatch > 1) {
                                run.matchcol = run.sub_first.size();
                                run.nmatch = 1;
                                run.is_skip_match = true;
                            }
                            run.nsubs = run.nsubs + 1;
                            run.did_sub = true;
                            is_skip = true;
                        }
                    }
                }
                if (!is_skip && run.is_ask) {
                    if (!is_resuming) {
                        editor.row = run.lnum;
                        editor.col = run.match_value.scol;
                        editor.want_from_cursor();
                        return sub_prompt(editor, run);
                    }
                    is_resuming = false;
                    if (answer == 113 || answer == MED_key.ESC || answer == 3) {
                        run.is_quit = true;
                        is_skip = true;
                    } else if (answer == 110) {
                        if (run.nmatch > 1) {
                            run.matchcol = run.sub_first.size();
                            run.nmatch = 1;
                            run.is_skip_match = true;
                        }
                        is_skip = true;
                    } else if (answer == 108) {
                        run.should_all = false;
                        run.line2 = run.lnum;
                    } else if (answer == 97) {
                        run.is_ask = false;
                    } else if (answer != 121) {
                        return sub_prompt(editor, run);
                    }
                }
                if (!is_skip) {
                    str replacement = "";
                    if (run.sub.starts_with("\\=")) {
                        MED_expr.Context context = MED_expr.Context();
                        context.groups = run.match_value.groups;
                        context.line_now = run.lnum + 1;
                        context.line_last = editor.buffer.line_count();
                        context.variables = editor.vars;
                        MED_expr.Evaluated evaluated = MED_expr.eval(run.sub.substr(2, run.sub.size()), context);
                        if (evaluated.is_ok) {
                            replacement = expr_replacement(evaluated.text);
                        } else {
                            // Vim reports the error and substitutes nothing
                            editor.message = evaluated.error;
                        }
                    } else {
                        replacement = expand_sub(run.sub, run.match_value);
                    }
                    if (run.nmatch > editor.buffer.line_count() - run.sub_row) {
                        run.nmatch = editor.buffer.line_count() - run.sub_row;
                        run.is_skip_match = true;
                    }
                    if (run.nmatch > 1) {
                        run.nmatch_tl = run.nmatch_tl + run.nmatch - 1;
                    }
                    str acc = "";
                    if (run.is_new_has) {
                        acc = run.new_start;
                    }
                    if (run.match_value.scol > run.copycol) {
                        acc = acc + run.sub_first.substr(run.copycol, run.match_value.scol);
                    }
                    run.nsubs = run.nsubs + 1;
                    run.did_sub = true;
                    if (run.first_changed < 0) {
                        run.first_changed = run.lnum;
                    }
                    editor.col = 0;
                    if (run.nmatch > 1) {
                        run.sub_row = run.sub_row + run.nmatch - 1;
                        run.sub_first = editor.buffer.line(run.sub_row);
                        if (run.sub_row <= run.line2) {
                            should_again = true;
                        } else {
                            run.should_all = false;
                        }
                    }
                    run.copycol = run.match_value.ecol;
                    if (run.is_skip_match) {
                        run.sub_first = "";
                        run.copycol = 0;
                    }
                    List<int> codes = replacement.chars();
                    List<int> part = [];
                    int index = 0;
                    while (index < codes.size()) {
                        int char_code = codes[index];
                        if (char_code == 92 && index + 1 < codes.size()) {
                            part.push(codes[index + 1]);
                            index = index + 2;
                        } else if (char_code == 13) {
                            append_above(editor, run.lnum, acc + str.from_chars(part));
                            acc = "";
                            part = [];
                            run.sub_row = run.sub_row + 1;
                            run.lnum = run.lnum + 1;
                            run.line2 = run.line2 + 1;
                            editor.row = run.lnum;
                            index = index + 1;
                        } else {
                            part.push(char_code);
                            index = index + 1;
                        }
                    }
                    run.new_start = acc + str.from_chars(part);
                    run.is_new_has = true;
                }
                // skip:
                bool is_lastone = run.is_skip_match || run.is_quit || run.lnum > run.line2 || !(run.should_all || should_again) || (run.matchcol >= run.sub_first.size() && run.nmatch <= 1 && !run.is_multi);
                run.nmatch = -1;
                bool is_replace_now = is_lastone || run.nmatch_tl > 0;
                if (!is_replace_now) {
                    MED_regex.Match match_item = run.regex.search_line(editor.buffer, run.sub_row, run.matchcol);
                    if (match_item.is_ok) {
                        run.match_value = match_item;
                        run.base = run.sub_row;
                        run.nmatch = run.match_value.erow - run.base + 1;
                        run.srel = run.match_value.srow - run.base;
                        run.erel = run.match_value.erow - run.base;
                    } else {
                        run.nmatch = 0;
                    }
                    is_replace_now = run.nmatch == 0 || run.srel > 0;
                }
                if (is_replace_now) {
                    if (run.is_new_has) {
                        if (run.copycol < run.sub_first.size()) {
                            run.new_start = run.new_start + run.sub_first.substr(run.copycol, run.sub_first.size());
                        }
                        run.matchcol = run.sub_first.size() - run.matchcol;
                        run.previous_matchcol = run.sub_first.size() - run.previous_matchcol;
                        if (!run.is_uline_set && run.nmatch_tl == 0) {
                            run.is_uline_set = true;
                            editor.uline_row = run.lnum;
                            editor.uline_text = editor.buffer.line(run.lnum);
                            editor.uline_col = 0;
                        }
                        replace_row(editor, run.lnum, run.new_start);
                        if (run.nmatch_tl > 0) {
                            delete_rows(editor, run.lnum + 1, run.lnum + run.nmatch_tl);
                            run.line2 = run.line2 - run.nmatch_tl;
                            run.nmatch_tl = 0;
                        }
                        run.sub_row = run.lnum;
                        run.sub_first = run.new_start;
                        run.is_new_has = false;
                        run.matchcol = run.sub_first.size() - run.matchcol;
                        run.previous_matchcol = run.sub_first.size() - run.previous_matchcol;
                        run.copycol = 0;
                    }
                    if (run.nmatch == -1 && !is_lastone) {
                        MED_regex.Match match_other = run.regex.search_line(editor.buffer, run.sub_row, run.matchcol);
                        if (match_other.is_ok) {
                            run.match_value = match_other;
                            run.base = run.sub_row;
                            run.nmatch = run.match_value.erow - run.base + 1;
                            run.srel = run.match_value.srow - run.base;
                            run.erel = run.match_value.erow - run.base;
                        } else {
                            run.nmatch = 0;
                        }
                    }
                    if (run.nmatch <= 0) {
                        if (run.nmatch == -1) {
                            run.lnum = run.lnum - run.srel;
                        }
                        break;
                    }
                }
            }
        }
        run.lnum = run.lnum + 1;
    }
    return sub_finish(editor, run);
}

Step sub_finish(MED_editor.Editor editor, MED_editor.SubRun run) {
    run.is_active = false;
    editor.is_uline_off = false;
    if (run.is_hold) {
        run.is_hold = false;
        editor.block_hold = editor.block_hold - 1;
        if (editor.block_hold == 0 && editor.mode == MED_editor.NORMAL) {
            editor.end_block();
        }
    }
    if (run.should_count) {
        editor.set_cursor(run.old_cursor);
    }
    if (run.nsubs > 0) {
        if (run.first_changed >= 0 && !run.should_count) {
            editor.override_change(MED_buffer.Pos(run.first_changed, 0));
        }
        editor.marks.set("[", MED_buffer.Pos(run.first_line, 0));
        editor.marks.set("]", MED_buffer.Pos(run.line2, 0));
        editor.clamp();
        if (!editor.is_global_busy) {
            if (run.is_ask) {
                editor.clamp();
            } else if (run.is_endcolumn) {
                editor.col = editor.buffer.line_size(editor.row);
                editor.clamp();
                editor.want = -1;
            } else {
                begin_white(editor);
            }
        } else {
            editor.is_need_beginline = true;
        }
    } else if (!editor.is_global_busy) {
        editor.clamp();
        if (!run.is_got_match && run.should_error) {
            return fail(editor, "E486: Pattern not found: " + run.pattern);
        }
    }
    return done();
}

// The end of the replacement text: the first unescaped `delim` (Vim's skip_substitute()).
int skip_substitute(str text, int delim) {
    int offset = 0;
    while (offset < text.size()) {
        int char_code = text.byte_at(offset);
        if (char_code == delim) {
            return offset;
        }
        if (char_code == 92 && offset + 1 < text.size()) {
            offset = offset + 1;
        }
        offset = MED_text.next_col(text, offset);
    }
    return offset;
}

// Which pattern slot an empty pattern means: 0 search, 1 substitute, 2 last used.
str slot_pattern(MED_editor.Editor editor, int which) {
    if (which == 0) {
        return editor.search_pattern;
    }
    if (which == 1) {
        return editor.sub_pattern;
    }
    return MED_search.last_pattern(editor);
}

Step cmd_sub(MED_editor.Editor editor, Cmd cmd_value) {
    str first_text = skip_one_white(cmd_value.arg);
    int which = 1;
    if (cmd_value.name == "~") {
        which = 2;
    }
    str pattern = "";
    str sub = "";
    bool is_new_pattern = false;
    bool is_endcolumn = false;
    str cmd = "";
    if (cmd_value.name == "substitute" && first_text != "" && !is_white(first_text.byte_at(0)) && "0123456789cegriIp|\"".index_of(str.from_chars([first_text.byte_at(0)])).is_none()) {
        int delta = first_text.byte_at(0);
        if (is_alpha(delta)) {
            return fail(editor, "E146: Regular expressions can't be delimited by letters");
        }
        is_new_pattern = true;
        str rest = "";
        if (delta == 92) {
            int stop = at(first_text, 1);
            if (stop != 47 && stop != 63 && stop != 38) {
                return fail(editor, "E10: \\ should be followed by /, ? or &");
            }
            if (stop != 38) {
                which = 0;
            }
            delta = stop;
            rest = first_text.substr(2, first_text.size());
        } else {
            which = 2;
            rest = first_text.substr(1, first_text.size());
            int end = MED_search.skip_regexp(rest, delta);
            pattern = rest.substr(0, end);
            note_search_history(editor, pattern);
            if (end < rest.size()) {
                rest = rest.substr(end + 1, rest.size());
            } else {
                rest = "";
            }
        }
        int sub_end = skip_substitute(rest, delta);
        sub = rest.substr(0, sub_end);
        if (sub_end < rest.size()) {
            cmd = rest.substr(sub_end + 1, rest.size());
        }
        editor.sub_old = sub;
        editor.is_sub_has = true;
    } else {
        if (!editor.is_sub_has) {
            return fail(editor, "E35: No previous regular expression");
        }
        sub = editor.sub_old;
        cmd = first_text;
        is_endcolumn = editor.want == -1;
    }
    // ":%s/\n//" is a join
    bool is_join = false;
    if (pattern == "\\n" && sub == "" && (cmd == "" || (cmd.size() == 1 && "glp#".index_of(cmd).is_some()))) {
        is_join = true;
    }
    if (is_join) {
        editor.row = cmd_value.line1 - 1;
        int count = cmd_value.line2 - cmd_value.line1 + 1;
        if (cmd_value.line2 < last_line(editor)) {
            count = count + 1;
        }
        if (count > 1) {
            MED_vim.did_do_join(editor, cmd_value.line1 - 1, count, false);
        }
        MED_search.set_last_pattern(editor, pattern, true);
        return done();
    }
    // flags
    bool should_all = false;
    bool should_error = true;
    bool should_count = false;
    int do_ic = 0;
    int offset = 0;
    if (at(cmd, 0) == 38) {
        offset = 1;
        str flag = editor.sub_flags;
        should_all = has_flag(flag, "g");
        should_error = !has_flag(flag, "q");
        should_count = has_flag(flag, "n");
        if (has_flag(flag, "i")) {
            do_ic = 1;
        } else if (has_flag(flag, "I")) {
            do_ic = 2;
        }
    }
    bool is_ask = false;
    while (offset < cmd.size()) {
        int char_code = cmd.byte_at(offset);
        if (char_code == 103) {
            should_all = !should_all;
        } else if (char_code == 99) {
            is_ask = !is_ask;
        } else if (char_code == 110) {
            should_count = true;
        } else if (char_code == 101) {
            should_error = !should_error;
        } else if (char_code == 114) {
            which = 2;
        } else if (char_code == 112 || char_code == 35 || char_code == 108) {
            // printing is not shown
        } else if (char_code == 105) {
            do_ic = 1;
        } else if (char_code == 73) {
            do_ic = 2;
        } else {
            break;
        }
        offset = offset + 1;
    }
    if (should_count) {
        is_ask = false;
    }
    str flags = "";
    if (should_all) {
        flags = flags + "g";
    }
    if (!should_error) {
        flags = flags + "q";
    }
    if (should_count) {
        flags = flags + "n";
    }
    if (do_ic == 1) {
        flags = flags + "i";
    } else if (do_ic == 2) {
        flags = flags + "I";
    }
    editor.sub_flags = flags;
    cmd = cmd.substr(offset, cmd.size());
    str text_value = skip_one_white(cmd);
    if (text_value != "" && is_digit(text_value.byte_at(0))) {
        int stop = skip_digits(text_value, 0);
        int total = digits_value(text_value, 0, stop);
        if (total <= 0 && should_error) {
            return fail(editor, "E939: Positive count required");
        }
        cmd_value.line1 = cmd_value.line2;
        cmd_value.line2 = cmd_value.line2 + total - 1;
        if (cmd_value.line2 > last_line(editor)) {
            cmd_value.line2 = last_line(editor);
        }
        text_value = skip_one_white(text_value.substr(stop, text_value.size()));
    }
    if (text_value != "" && text_value.byte_at(0) != 34) {
        if (text_value.byte_at(0) == 124) {
            cmd_value.is_more = true;
            cmd_value.rest = text_value.substr(1, text_value.size());
        } else {
            return fail(editor, "E488: Trailing characters: " + text_value);
        }
    }
    // the pattern
    if (pattern == "") {
        pattern = slot_pattern(editor, which);
        if (pattern == "") {
            return fail(editor, "E35: No previous regular expression");
        }
    }
    MED_search.set_last_pattern(editor, pattern, true);
    MED_regex.Regex regex = MED_regex.Regex();
    if (do_ic == 1) {
        regex = MED_regex.compile(pattern, true, false, editor.sub_replacement);
    } else if (do_ic == 2) {
        regex = MED_regex.compile(pattern, false, false, editor.sub_replacement);
    } else {
        regex = MED_search.compile_with(editor, pattern, false);
    }
    if (!regex.is_ok) {
        return fail(editor, regex.error);
    }
    if (!sub.starts_with("\\=")) {
        sub = regtilde(sub, editor.sub_replacement);
    }
    editor.sub_replacement = sub;
    MED_editor.SubRun run = MED_editor.SubRun();
    run.regex = regex;
    run.pattern = pattern;
    run.sub = sub;
    run.first_line = cmd_value.line1 - 1;
    run.line2 = cmd_value.line2 - 1;
    run.should_all = should_all;
    run.should_count = should_count;
    run.should_error = should_error;
    run.is_endcolumn = is_endcolumn;
    run.is_ask = is_ask;
    run.is_multi = is_pattern_multiline(pattern);
    run.old_cursor = editor.cursor();
    run.lnum = run.first_line;
    editor.is_uline_off = true;
    return sub_lines(editor, run, 0);
}

// ----------------------------------------------------------------------- :sort

str lower_str(str text) {
    List<int> out = [];
    for (int char_code in text.chars()) {
        out.push(MED_case.lower_cp(char_code));
    }
    return str.from_chars(out);
}

type SortNum {
    bool is_number = false;
    int value = 0;
}

type SortCtx {
    List<bool> is_number = [];
    List<int> number = [];
    List<str> key = [];
    bool is_numeric = false;
    /// `:sort f`: the key as a decimal number (sign, exponent of the first digit, digits).
    bool is_flt = false;
    List<int> fsign = [];
    List<int> fexp = [];
    List<str> fdig = [];
}

int cmp_str(str first_text, str second_text) {
    int count = first_text.size();
    if (second_text.size() < count) {
        count = second_text.size();
    }
    for (int i in 0 .. count) {
        int x = first_text.byte_at(i);
        int y = second_text.byte_at(i);
        if (x != y) {
            if (x < y) {
                return -1;
            }
            return 1;
        }
    }
    if (first_text.size() == second_text.size()) {
        return 0;
    }
    if (first_text.size() < second_text.size()) {
        return -1;
    }
    return 1;
}

// Compare two decimal keys: sign first (an empty line, sign -2, sorts before everything), then magnitude.
int flt_cmp(SortCtx sort_context, int index, int other_index) {
    int left = sort_context.fsign[index];
    int right = sort_context.fsign[other_index];
    if (left != right) {
        if (left < right) {
            return -1;
        }
        return 1;
    }
    if (left == 0 || left == -2) {
        return 0;
    }
    int marker = 0;
    if (sort_context.fexp[index] != sort_context.fexp[other_index]) {
        if (sort_context.fexp[index] > sort_context.fexp[other_index]) {
            marker = 1;
        } else {
            marker = -1;
        }
    } else {
        marker = cmp_str(sort_context.fdig[index], sort_context.fdig[other_index]);
    }
    return marker * left;
}

// strtod() as a decimal key: the sign (0 for zero), the exponent of the first
// significant digit and the significant digits without trailing zeros.
SortCtx flt_push(SortCtx sort_context, str key) {
    int offset = 0;
    while (offset < key.size() && (key.byte_at(offset) == 32 || key.byte_at(offset) == 9)) {
        offset = offset + 1;
    }
    if (offset < key.size() && key.byte_at(offset) == 43) {
        offset = offset + 1;
        while (offset < key.size() && (key.byte_at(offset) == 32 || key.byte_at(offset) == 9)) {
            offset = offset + 1;
        }
    }
    if (offset >= key.size()) {
        sort_context.fsign.push(-2);
        sort_context.fexp.push(0);
        sort_context.fdig.push("");
        return sort_context;
    }
    int sign = 1;
    if (key.byte_at(offset) == 45) {
        sign = -1;
        offset = offset + 1;
    } else if (key.byte_at(offset) == 43) {
        offset = offset + 1;
    }
    List<int> digits = [];
    int point = 0;
    bool is_seen_point = false;
    bool is_any = false;
    while (offset < key.size()) {
        int char_code = key.byte_at(offset);
        if (is_digit(char_code)) {
            is_any = true;
            digits.push(char_code);
            if (!is_seen_point) {
                point = point + 1;
            }
        } else if (char_code == 46 && !is_seen_point) {
            is_seen_point = true;
        } else {
            break;
        }
        offset = offset + 1;
    }
    int extra = 0;
    if (is_any && offset < key.size() && (key.byte_at(offset) == 101 || key.byte_at(offset) == 69)) {
        int ahead = offset + 1;
        int esign = 1;
        if (ahead < key.size() && (key.byte_at(ahead) == 43 || key.byte_at(ahead) == 45)) {
            if (key.byte_at(ahead) == 45) {
                esign = -1;
            }
            ahead = ahead + 1;
        }
        if (ahead < key.size() && is_digit(key.byte_at(ahead))) {
            int value = 0;
            while (ahead < key.size() && is_digit(key.byte_at(ahead))) {
                if (value < 100000000) {
                    value = value * 10 + key.byte_at(ahead) - 48;
                }
                ahead = ahead + 1;
            }
            extra = value * esign;
        }
    }
    int lead = 0;
    while (lead < digits.size() && digits[lead] == 48) {
        lead = lead + 1;
    }
    int last = digits.size();
    while (last > lead && digits[last - 1] == 48) {
        last = last - 1;
    }
    if (!is_any || lead == digits.size()) {
        sort_context.fsign.push(0);
        sort_context.fexp.push(0);
        sort_context.fdig.push("");
        return sort_context;
    }
    sort_context.fsign.push(sign);
    sort_context.fexp.push(point - lead + extra);
    sort_context.fdig.push(str.from_chars(digits.slice(lead, last)));
    return sort_context;
}

// Compare lines `index` and `other_index` the way sort_compare() does; equal keys keep the original order.
int sort_cmp(SortCtx sort_context, int index, int other_index) {
    int result = 0;
    if (sort_context.is_flt) {
        result = flt_cmp(sort_context, index, other_index);
    } else if (sort_context.is_numeric) {
        if (sort_context.is_number[index] != sort_context.is_number[other_index]) {
            if (sort_context.is_number[index]) {
                result = 1;
            } else {
                result = -1;
            }
        } else if (sort_context.number[index] != sort_context.number[other_index]) {
            if (sort_context.number[index] > sort_context.number[other_index]) {
                result = 1;
            } else {
                result = -1;
            }
        }
    } else {
        result = cmp_str(sort_context.key[index], sort_context.key[other_index]);
    }
    if (result == 0) {
        if (index < other_index) {
            return -1;
        }
        if (index > other_index) {
            return 1;
        }
    }
    return result;
}

List<int> merge_sort(SortCtx sort_context, List<int> items) {
    if (items.size() <= 1) {
        return items;
    }
    int mid = items.size() / 2;
    List<int> left = merge_sort(sort_context, items.slice(0, mid));
    List<int> right = merge_sort(sort_context, items.slice(mid, items.size()));
    List<int> out = [];
    int index = 0;
    int other_index = 0;
    while (index < left.size() && other_index < right.size()) {
        if (sort_cmp(sort_context, left[index], right[other_index]) <= 0) {
            out.push(left[index]);
            index = index + 1;
        } else {
            out.push(right[other_index]);
            other_index = other_index + 1;
        }
    }
    while (index < left.size()) {
        out.push(left[index]);
        index = index + 1;
    }
    while (other_index < right.size()) {
        out.push(right[other_index]);
        other_index = other_index + 1;
    }
    return out;
}

bool is_hex_digit(int char_code) {
    return is_digit(char_code) || (char_code >= 97 && char_code <= 102) || (char_code >= 65 && char_code <= 70);
}

int hex_value(int char_code) {
    if (char_code >= 97) {
        return char_code - 87;
    }
    if (char_code >= 65) {
        return char_code - 55;
    }
    return char_code - 48;
}

// The number of a ":sort n/x/o/b" key: the first number in `text` (a '-' just before it counts).
SortNum sort_number(str text, int what) {
    SortNum sort_number_value = SortNum();
    int offset = 0;
    while (offset < text.size()) {
        int char_code = text.byte_at(offset);
        bool is_hit = is_digit(char_code);
        if (what == 1) {
            is_hit = is_hex_digit(char_code);
        } else if (what == 3) {
            is_hit = char_code == 48 || char_code == 49;
        }
        if (is_hit) {
            break;
        }
        offset = offset + 1;
    }
    if (offset >= text.size()) {
        return sort_number_value;
    }
    bool is_neg = offset > 0 && text.byte_at(offset - 1) == 45;
    sort_number_value.is_number = true;
    int base = 10;
    if (what == 1) {
        base = 16;
        if (at(text, offset) == 48 && (at(text, offset + 1) == 120 || at(text, offset + 1) == 88) && is_hex_digit(at(text, offset + 2))) {
            offset = offset + 2;
        }
    } else if (what == 2) {
        base = 8;
    } else if (what == 3) {
        base = 2;
        if (at(text, offset) == 48 && (at(text, offset + 1) == 98 || at(text, offset + 1) == 66) && (at(text, offset + 2) == 48 || at(text, offset + 2) == 49)) {
            offset = offset + 2;
        }
    }
    int value = 0;
    while (offset < text.size()) {
        int char_code = text.byte_at(offset);
        int delta = 99;
        if (is_hex_digit(char_code)) {
            delta = hex_value(char_code);
        }
        if (delta >= base) {
            break;
        }
        value = value * base + delta;
        offset = offset + 1;
    }
    if (is_neg) {
        value = 0 - value;
    }
    sort_number_value.value = value;
    return sort_number_value;
}

Step cmd_sort(MED_editor.Editor editor, Cmd cmd) {
    bool is_ignore_case = false;
    bool is_regex_found = false;
    bool is_unique = false;
    bool is_numeric = false;
    bool is_flt = false;
    int what = 0;
    int formats = 0;
    MED_regex.Regex regex = MED_regex.Regex();
    bool is_have_re = false;
    str arg = cmd.arg;
    int offset = 0;
    while (offset < arg.size()) {
        int char_code = arg.byte_at(offset);
        if (is_white(char_code)) {
            offset = offset + 1;
        } else if (char_code == 105) {
            is_ignore_case = true;
            offset = offset + 1;
        } else if (char_code == 108) {
            offset = offset + 1;
        } else if (char_code == 114) {
            is_regex_found = true;
            offset = offset + 1;
        } else if (char_code == 110) {
            is_numeric = true;
            formats = formats + 1;
            offset = offset + 1;
        } else if (char_code == 102) {
            is_flt = true;
            formats = formats + 1;
            offset = offset + 1;
        } else if (char_code == 98) {
            is_numeric = true;
            what = 3;
            formats = formats + 1;
            offset = offset + 1;
        } else if (char_code == 111) {
            is_numeric = true;
            what = 2;
            formats = formats + 1;
            offset = offset + 1;
        } else if (char_code == 120) {
            is_numeric = true;
            what = 1;
            formats = formats + 1;
            offset = offset + 1;
        } else if (char_code == 117) {
            is_unique = true;
            offset = offset + 1;
        } else if (char_code == 34) {
            break;
        } else if (char_code == 124) {
            cmd.is_more = true;
            cmd.rest = arg.substr(offset + 1, arg.size());
            break;
        } else if (!is_alpha(char_code) && !is_have_re) {
            str rest = arg.substr(offset + 1, arg.size());
            int end = MED_search.skip_regexp(rest, char_code);
            str pattern = rest.substr(0, end);
            if (pattern == "") {
                pattern = editor.search_pattern;
                if (pattern == "") {
                    return fail(editor, "E35: No previous regular expression");
                }
            }
            regex = MED_regex.compile(pattern, editor.is_ignorecase, false, editor.sub_replacement);
            if (!regex.is_ok) {
                return fail(editor, regex.error);
            }
            is_have_re = true;
            offset = offset + 1 + end;
            if (end < rest.size()) {
                offset = offset + 1;
            }
        } else {
            return fail(editor, "E474: Invalid argument: " + arg.substr(offset, arg.size()));
        }
    }
    if (formats > 1) {
        return fail(editor, "E474: Invalid argument");
    }
    int count = cmd.line2 - cmd.line1 + 1;
    if (count <= 1) {
        return done();
    }
    SortCtx sort_context = SortCtx();
    sort_context.is_numeric = is_numeric;
    sort_context.is_flt = is_flt;
    List<int> order = [];
    for (int key_code in 0 .. count) {
        int row = cmd.line1 - 1 + key_code;
        str text = editor.buffer.line(row);
        int start_col = 0;
        int end_col = text.size();
        if (is_have_re) {
            MED_regex.Match match_value = regex.search_line(editor.buffer, row, 0);
            if (match_value.is_ok && match_value.srow == row) {
                if (is_regex_found) {
                    start_col = match_value.scol;
                    if (match_value.erow == row) {
                        end_col = match_value.ecol;
                    }
                } else if (match_value.erow == row) {
                    start_col = match_value.ecol;
                } else {
                    start_col = text.size();
                }
            } else {
                end_col = 0;
            }
        }
        str key = "";
        if (end_col > start_col) {
            key = text.substr(start_col, end_col);
        }
        if (is_flt) {
            sort_context = flt_push(sort_context, key);
            sort_context.is_number.push(false);
            sort_context.number.push(0);
            sort_context.key.push(key);
        } else if (is_numeric) {
            SortNum sort_number_value = sort_number(key, what);
            sort_context.is_number.push(sort_number_value.is_number);
            sort_context.number.push(sort_number_value.value);
            sort_context.key.push(key);
        } else {
            if (is_ignore_case) {
                key = lower_str(key);
            }
            sort_context.is_number.push(false);
            sort_context.number.push(0);
            sort_context.key.push(key);
        }
        order.push(key_code);
    }
    order = merge_sort(sort_context, order);
    List<str> out = [];
    str previous = "";
    for (int i in 0 .. count) {
        int key_code = order[i];
        if (cmd.is_bang) {
            key_code = order[count - 1 - i];
        }
        str text = editor.buffer.line(cmd.line1 - 1 + key_code);
        if (is_unique && i > 0) {
            bool is_same = text == previous;
            if (is_ignore_case) {
                is_same = lower_str(text) == lower_str(previous);
            }
            if (is_same) {
                continue;
            }
        }
        previous = text;
        out.push(text);
    }
    int deleted = count - out.size();
    int left = cmd.line1 - 1;
    int right = cmd.line2 - 1;
    bool is_same_order = deleted == 0;
    for (int i in 0 .. out.size()) {
        if (is_same_order && out[i] != editor.buffer.line(left + i)) {
            is_same_order = false;
        }
    }
    // nothing moved: the step is saved for undo but, as in nvim, no change is
    // noted (`.` and the change list stay)
    editor.is_change_unnoted = is_same_order;
    editor.is_adjust_off = true;
    editor.change(MED_buffer.Pos(left, 0), MED_buffer.Pos(right, editor.buffer.line_size(right)), out.join("\n"));
    editor.is_adjust_off = false;
    editor.is_change_unnoted = false;
    if (deleted > 0) {
        editor.mark_adjust(cmd.line2 - deleted - 1, deleted + 1, 1);
    }
    editor.row = left;
    begin_white(editor);
    return done();
}

// ------------------------------------------------------------------ shell: :! and :r

// The shell command with the previous one in place of an unescaped `!` and the
// file name in place of an unescaped `%` (`\!` and `\%` are literal).
str expand_shell(MED_editor.Editor editor, str text) {
    str out = "";
    int index = 0;
    while (index < text.size()) {
        int char_code = text.byte_at(index);
        if (char_code == 92 && index + 1 < text.size() && (text.byte_at(index + 1) == 33 || text.byte_at(index + 1) == 37)) {
            out = out + text.substr(index + 1, index + 2);
            index = index + 2;
            continue;
        }
        if (char_code == 33) {
            out = out + editor.last_shell;
        } else if (char_code == 37) {
            out = out + editor.file_name;
        } else {
            out = out + text.substr(index, index + 1);
        }
        index = index + 1;
    }
    return out;
}

// Run `command` through `sh -c` with standard error folded into the output.
MED_shell.Ran run_shell(str command, str input) {
    return MED_shell.run(["sh", "-c", "exec 2>&1; " + command], "", input, timeout_ms: 120000);
}

// The lines of command output (a final newline ends a line, it does not add one).
List<str> output_lines(str text) {
    return MED_shell.split_lines(text);
}

// `:!cmd` shows the output; `:{range}!cmd` filters the lines through it.
Step cmd_bang(MED_editor.Editor editor, Cmd cmd) {
    str command = expand_shell(editor, cmd.arg);
    if (command.trim().size() == 0) {
        return fail(editor, "E471: Argument required");
    }
    editor.last_shell = command;
    if (cmd.addr_count == 0) {
        MED_shell.Ran ran = run_shell(command, "");
        str shown = ran.text;
        if (shown.ends_with("\n")) {
            shown = shown.substr(0, shown.size() - 1);
        }
        editor.message = shown;
        return done();
    }
    int first = cmd.line1 - 1;
    int last = cmd.line2 - 1;
    List<str> input = [];
    for (int row in first .. last + 1) {
        input.push(editor.buffer.line(row));
    }
    MED_shell.Ran ran = run_shell(command, input.join("\n") + "\n");
    List<str> lines = output_lines(ran.text);
    editor.row = first;
    editor.col = 0;
    editor.open_block();
    if (lines.size() > 0) {
        MED_vim.did_ex_put_lines(editor, lines, last, false);
    }
    // the old lines go (marks inside them with them), the new ones are the range
    MED_vim.ex_delete(editor, first, last, "_");
    int count = lines.size();
    editor.row = first;
    if (editor.row > editor.buffer.line_count() - 1) {
        editor.row = editor.buffer.line_count() - 1;
    }
    if (count > 0) {
        editor.marks.set("[", MED_buffer.Pos(first, 0));
        editor.marks.set("]", MED_buffer.Pos(first + count - 1, 0));
    }
    begin_white(editor);
    editor.want_from_cursor();
    return done();
}

// `:r FILE` and `:r !CMD` put lines below the line (above line 1 for `:0r`).
Step cmd_read(MED_editor.Editor editor, Cmd cmd) {
    str arg = skip_one_white(cmd.arg);
    bool is_command = arg.starts_with("!") || cmd.is_bang;
    List<str> lines = [];
    if (is_command) {
        str command = arg;
        if (command.starts_with("!")) {
            command = command.substr(1, command.size());
        }
        command = expand_shell(editor, command);
        if (command.trim().size() == 0) {
            return fail(editor, "E471: Argument required");
        }
        editor.last_shell = command;
        lines = output_lines(run_shell(command, "").text);
    } else {
        str file = expand_shell(editor, arg);
        if (file.size() == 0) {
            file = editor.file_name;
        }
        if (file.size() == 0) {
            return fail(editor, "E32: No file name");
        }
        match (io.read(file)) {
            case Ok(str text): {
                lines = output_lines(text);
            }
            case Err(io.Error error): {
                return fail(editor, "E484: Can't open file " + file);
            }
        }
    }
    int row = cmd.line2 - 1;
    bool is_above = false;
    if (cmd.line2 == 0) {
        row = 0;
        is_above = true;
    }
    if (lines.size() == 0) {
        return done();
    }
    editor.open_block();
    MED_vim.did_ex_put_lines(editor, lines, row, is_above);
    if (!is_command) {
        // a file leaves the cursor on its first line
        MED_buffer.Pos first = editor.marks.get("[").or(MED_buffer.Pos(editor.row, 0));
        editor.row = first.row;
        begin_white(editor);
        editor.want_from_cursor();
    }
    return done();
}
