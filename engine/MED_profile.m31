/* Key and option profiles: `:Profile NAME` (or the line `Profile NAME` in the keymap file) runs the profile's ex lines.
 *
 *   nvim    the owner's Neovim setup, the parts that are editor behaviour (docs/NVIM-PARITY.md lists every line and
 *           what in the config it stands for). m3's own defaults stay available: a profile is opt-in, `:mapclear`
 *           and `:set` undo it, and a later line of the keymap file wins over it.
 *
 *   MED_profile.names()        the profile names
 *   MED_profile.lines_of(name) the ex lines of a profile ([] when unknown) */

pub List<str> names() {
    return ["minimal", "default", "nvim", "legacy"];
}

pub bool is_known(str name) {
    return names().contains(name);
}

/** The ex lines of a profile, run after its leader tree and the plugins' keys were swapped in (`MED_keymap.defaults`,
 * the `MapSpec.profiles` of the plugins): the non-leader keys and options. */
pub List<str> lines_of(str name) {
    if (name == "nvim") {
        return nvim();
    }
    if (name == "default") {
        return controls();
    }
    if (name == "minimal") {
        return ["set nojk_escape"];
    }
    return ["set jk_escape"];
}

/// The lines that undo the maps of a profile (an `nnoremap LHS RHS` line becomes `nunmap LHS`); options stay.
pub List<str> undo_lines_of(str name) {
    List<str> out = [];
    for (str line in lines_of(name)) {
        List<str> words = line.split(" ");
        if (words.size() >= 3 && (words[0] == "nnoremap" || words[0] == "xnoremap" || words[0] == "inoremap")) {
            out.push(words[0].substr(0, 1) + "unmap " + words[1]);
        }
    }
    return out;
}

/** The non-leader keys of the `default` profile (docs/KEYMAP-REVIEW.md 3.2): window focus and resize, save, Visual shift
 * that keeps the selection, and `jk` in Insert mode (`gK`, signature help, is the front end's, next to `K`). */
List<str> controls() {
    return ["set jk_escape", "nnoremap <C-h> <C-w>h", "nnoremap <C-j> <C-w>j", "nnoremap <C-k> <C-w>k", "nnoremap <C-l> <C-w>l", "nnoremap <C-Up> <Cmd>resize +2<CR>", "nnoremap <C-Down> <Cmd>resize -2<CR>", "nnoremap <C-Left> <Cmd>vertical resize -2<CR>", "nnoremap <C-Right> <Cmd>vertical resize +2<CR>", "nnoremap <C-s> <Cmd>write<CR>", "xnoremap <C-s> <Esc><Cmd>write<CR>", "xnoremap <lt> <lt>gv", "xnoremap > >gv"];
}

List<str> nvim() {
    return ["set tabstop=4 shiftwidth=4 expandtab relativenumber ignorecase smartcase mouse=a smoothscroll", "nnoremap <Space>b <Cmd>Buffers<CR>", "nnoremap <Space>gn :!git checkout -b ", "nnoremap <Space>gr :!git branch -m ", "nnoremap <Space>gdd <Cmd>Git diff<CR>", "nnoremap <Space>gt <Cmd>Git diff<CR>", "nnoremap <Space>a <Cmd>Symbols<CR>", "nnoremap H <lt><lt>", "nnoremap L >>", "nnoremap J :m +1<CR>", "nnoremap K :m -2<CR>", "xnoremap <C-h> <lt>gv", "xnoremap <C-l> >gv", "xnoremap <C-j> :m '>+1<CR>gv", "xnoremap <C-k> :m '<lt>-2<CR>gv", "nnoremap > <Cmd>Hunk next<CR>", "nnoremap <lt> <Cmd>Hunk prev<CR>", "nnoremap - <Cmd>Hunk stage<CR>", "nnoremap _ <Cmd>Hunk reset<CR>", "xnoremap - <Esc><Cmd>Hunk stage<CR>", "xnoremap _ <Esc><Cmd>Hunk reset<CR>", "nnoremap <Space>hu <Cmd>Hunk undo<CR>", "nnoremap <Space>hS <Cmd>Hunk stage-buffer<CR>", "nnoremap <Space>hR <Cmd>Hunk reset-buffer<CR>", "nnoremap <Space>hp <Cmd>Hunk preview-or HarpoonPrev<CR>", "nnoremap <Space>hP <Cmd>HarpoonPrev<CR>", "nnoremap <Space>hb <Cmd>Git line<CR>", "set pumkeys=blink", "set lspformat", "Formatter rust rustfmt --edition 2021 --emit stdout", "Formatter python ruff format --stdin-filename $FILE -", "Formatter lua stylua --stdin-filepath $FILE -", "Formatter javascript prettierd $FILE", "Formatter javascript prettier --stdin-filepath $FILE", "Formatter typescript prettierd $FILE", "Formatter typescript prettier --stdin-filepath $FILE", "Formatter jsx prettierd $FILE", "Formatter jsx prettier --stdin-filepath $FILE", "Formatter tsx prettierd $FILE", "Formatter tsx prettier --stdin-filepath $FILE", "Formatter json prettier --stdin-filepath $FILE", "Formatter jsonc prettier --stdin-filepath $FILE"];
    /* init.lua
     * keymaps.lua
     * mini.move: H J K L move the line in Normal mode, CTRL-H J K L move the selection in Visual mode
     * gitsigns: > and < next and previous hunk, - and _ stage and reset the hunk, <leader>hS stages the buffer
     * blink.cmp: Tab accepts, CTRL-J and CTRL-K move in the popup
     * conform.nvim: formatters by file type, then the language server (lsp_format = fallback) */
}
