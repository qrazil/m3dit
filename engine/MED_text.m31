/* Text helpers for one line: where the grapheme clusters are, how wide a
 * cluster is, and which class a character belongs to for the word motions.
 *
 * API */
// ---
/*   MED_text.is_ascii(line)              -> bool
 *   MED_text.starts(line)                -> List<int>  start offset of every cluster, then line.size()
 *   MED_text.next_col(line, col)         -> int        start of the cluster after the one at `col`
 *   MED_text.prev_col(line, col)         -> int        start of the cluster before `col`
 *   MED_text.last_col(line)              -> int        start of the last cluster (0 for "")
 *   MED_text.snap(line, col)             -> int        the cluster start at or before `col`
 *   MED_text.end_col(line, col)          -> int        end offset of the cluster that starts at `col`
 *   MED_text.cp_at(line, col)            -> int        first code point there, or -1 at the end
 *   MED_text.class_of(cp)                -> int        0 blank, 1 punctuation, 2 word, 3 emoji, 4.. scripts
 *   MED_text.class_at(line, col)         -> int
 *   MED_text.display_col(line, col, tab) -> int        screen column where the cluster at `col` starts
 *   MED_text.cell_width(line, col, at, tab) -> int     width of the cluster at `col` when it starts at screen column `at`
 *   MED_text.col_at_display(line, want, tab) -> int    the cluster start covering screen column `want`
 *   MED_text.line_width(line, tab)       -> int
 *   MED_text.first_nonblank(line)        -> int        offset of the first non-blank, or the end
 *
 * Offsets are bytes, always on a cluster boundary. Lines are all-ASCII most of
 * the time, and then none of this touches the Unicode tables. */

import engine.MED_charclass;
import text.unicode;

/// Whether every byte of `line` is below 0x80.
pub bool is_ascii(str line) {
    int size = line.size();
    for (int i in 0 .. size) {
        if (line.byte_at(i) >= 128) {
            return false;
        }
    }
    return true;
}

/// The start offset of every grapheme cluster of `line`, then `line.size()`.
pub List<int> starts(str line) {
    List<int> result = [];
    if (is_ascii(line)) {
        for (int i in 0 .. line.size()) {
            result.push(i);
        }
        result.push(line.size());
        return result;
    }
    int offset = 0;
    for (str cluster in unicode.graphemes(line)) {
        result.push(offset);
        offset = offset + cluster.size();
    }
    result.push(offset);
    return result;
}

// The byte length of the UTF-8 sequence that starts with `lead`.
int sequence_length(int lead) {
    if (lead < 128) {
        return 1;
    }
    if (lead >= 240) {
        return 4;
    }
    if (lead >= 224) {
        return 3;
    }
    return 2;
}

/// The start of the cluster after the one at `col`, or `line.size()`.
pub int next_col(str line, int col) {
    int size = line.size();
    if (col >= size) {
        return size;
    }
    if (line.byte_at(col) < 128 && (col + 1 >= size || line.byte_at(col + 1) < 128)) {
        return col + 1;
    }
    for (int offset in starts(line)) {
        if (offset > col) {
            return offset;
        }
    }
    return size;
}

/// The start of the cluster before `col`, or 0.
pub int previous_col(str line, int col) {
    if (col <= 0) {
        return 0;
    }
    if (col <= line.size() && line.byte_at(col - 1) < 128 && (col == line.size() || line.byte_at(col) < 128)) {
        return col - 1;
    }
    int found = 0;
    for (int offset in starts(line)) {
        if (offset >= col) {
            break;
        }
        found = offset;
    }
    return found;
}

/// The start of the last cluster, 0 for the empty line.
pub int last_col(str line) {
    int size = line.size();
    if (size == 0) {
        return 0;
    }
    if (line.byte_at(size - 1) < 128 && (size == 1 || line.byte_at(size - 2) < 128)) {
        return size - 1;
    }
    List<int> offsets = starts(line);
    return offsets[offsets.size() - 2];
}

/// The cluster start at or before `col` (`col` itself when it is one).
pub int snap(str line, int col) {
    if (col <= 0) {
        return 0;
    }
    if (col >= line.size()) {
        return line.size();
    }
    int found = 0;
    for (int offset in starts(line)) {
        if (offset > col) {
            break;
        }
        found = offset;
    }
    return found;
}

/// The end offset of the cluster that starts at `col`.
pub int end_col(str line, int col) {
    return next_col(line, col);
}

/// The code point that starts the cluster at `col`, or -1 at the end.
pub int cp_at(str line, int col) {
    int size = line.size();
    if (col >= size) {
        return -1;
    }
    int lead = line.byte_at(col);
    if (lead < 128) {
        return lead;
    }
    int length = sequence_length(lead);
    if (length == 2) {
        return ((lead & 31) << 6) | (line.byte_at(col + 1) & 63);
    }
    if (length == 3) {
        return ((lead & 15) << 12) | ((line.byte_at(col + 1) & 63) << 6) | (line.byte_at(col + 2) & 63);
    }
    return ((lead & 7) << 18) | ((line.byte_at(col + 1) & 63) << 12) | ((line.byte_at(col + 2) & 63) << 6) | (line.byte_at(col + 3) & 63);
}

/** Word class for the word motions (nvim's `utf_class`): 0 blank,
 * 1 punctuation, 2 word, 3 emoji, 4 and up per-script classes. */
pub int class_of(int code_point) {
    if (code_point < 256) {
        if (code_point == 32 || code_point == 9 || code_point == 0 || code_point == 160) {
            return 0;
        }
        if ((code_point >= 48 && code_point <= 57) || (code_point >= 65 && code_point <= 90) || (code_point >= 97 && code_point <= 122) || code_point == 95 || code_point >= 192) {
            return 2;
        }
        return 1;
    }
    List<int> table = MED_charclass.RANGES;
    int low = 0;
    int high = table.size() / 3 - 1;
    while (low <= high) {
        int mid = (low + high) / 2;
        int base = mid * 3;
        if (code_point < table[base]) {
            high = mid - 1;
        } else if (code_point > table[base + 1]) {
            low = mid + 1;
        } else {
            return table[base + 2];
        }
    }
    return 2;
}

/** `class_of` with an 'iskeyword' table (see `keyword_table`): below 256 a
 * character is a word character when the table says so; an empty table is
 * the default value. */
pub int class_in(int code_point, List<int> keywords) {
    if (keywords.size() == 0 || code_point >= 256) {
        return class_of(code_point);
    }
    if (code_point == 32 || code_point == 9 || code_point == 0 || code_point == 160) {
        return 0;
    }
    if (keywords[code_point] == 1) {
        return 2;
    }
    return 1;
}

/// The class of the cluster at `col` with an 'iskeyword' table.
pub int class_at_in(str line, int col, List<int> keywords) {
    int code_point = cp_at(line, col);
    if (code_point < 0) {
        return 0;
    }
    return class_in(code_point, keywords);
}

// One number or character of an 'iskeyword' item; -1 when it is neither.
int keyword_code(str text) {
    if (text.size() == 0) {
        return -1;
    }
    bool is_number = true;
    for (int index in 0 .. text.size()) {
        int byte = text.byte_at(index);
        if (byte < 48 || byte > 57) {
            is_number = false;
        }
    }
    if (is_number && text.size() > 0) {
        return text.parse_int().or(-1);
    }
    if (text.size() == sequence_length(text.byte_at(0))) {
        return cp_at(text, 0);
    }
    return -1;
}

/** Parse an 'iskeyword' value into a table of 256 entries (1: keyword).
 * Items are `@` (letters), `N`, `N-M`, `c`, `c-d` and `^item` to remove. */
pub List<int> keyword_table(str value) {
    List<int> table = [];
    for (int code in 0 .. 256) {
        table.push(0);
    }
    for (str raw in value.split(",")) {
        str item = raw;
        int mark = 1;
        if (item.size() > 1 && item.starts_with("^")) {
            mark = 0;
            item = item.substr(1, item.size());
        }
        int first = -1;
        int last = -1;
        if (item == "@") {
            for (int code in 65 .. 91) {
                table[code] = mark;
            }
            for (int code in 97 .. 123) {
                table[code] = mark;
            }
            continue;
        }
        int dash = -1;
        for (int index in 1 .. item.size()) {
            if (item.byte_at(index) == 45 && index + 1 < item.size()) {
                dash = index;
                break;
            }
        }
        if (dash > 0) {
            str left = item.substr(0, dash);
            str right = item.substr(dash + 1, item.size());
            if (left == "@" && right == "@") {
                first = 64;
                last = 64;
            } else {
                first = keyword_code(left);
                last = keyword_code(right);
            }
        } else {
            first = keyword_code(item);
            last = first;
        }
        if (first < 0 || last < first) {
            continue;
        }
        for (int code in first .. last + 1) {
            if (code < 256) {
                table[code] = mark;
            }
        }
    }
    return table;
}

/// The class of the cluster at `col` (blank at the end of the line).
pub int class_at(str line, int col) {
    int code_point = cp_at(line, col);
    if (code_point < 0) {
        return 0;
    }
    return class_of(code_point);
}

/// The first non-blank (space or tab) offset, or `line.size()`.
pub int first_nonblank(str line) {
    int size = line.size();
    for (int i in 0 .. size) {
        int byte = line.byte_at(i);
        if (byte != 32 && byte != 9) {
            return i;
        }
    }
    return size;
}

/** The first 512 bytes of a line: all that file type detection (a shebang, a modeline) may look at, so a minified
 * one-line file is not scanned whole every time the status line or a tick asks what the language is. */
pub str head(str line) {
    if (line.size() > 512) {
        return line.substr(0, 512);
    }
    return line;
}

/// Width of the cluster at `col` if it starts at screen column `spot`.
pub int cell_width(str line, int col, int spot, int tab) {
    int code_point = cp_at(line, col);
    if (code_point < 0) {
        return 1;
    }
    if (code_point == 9) {
        return tab - (spot % tab);
    }
    if (code_point < 32 || code_point == 127) {
        return 2;
    }
    if (code_point < 128) {
        return 1;
    }
    int end = next_col(line, col);
    int measured = unicode.width(line.substr(col, end));
    if (measured < 1) {
        return 1;
    }
    return measured;
}

/// The screen column where the cluster at `col` starts.
pub int display_col(str line, int col, int tab) {
    int spot = 0;
    int offset = 0;
    if (is_ascii(line)) {
        for (int i in 0 .. col) {
            int byte = line.byte_at(i);
            if (byte == 9) {
                spot = spot + tab - (spot % tab);
            } else if (byte < 32 || byte == 127) {
                spot = spot + 2;
            } else {
                spot = spot + 1;
            }
        }
        return spot;
    }
    List<int> offsets = starts(line);
    for (int offset_value in offsets) {
        if (offset_value >= col) {
            break;
        }
        spot = spot + cell_width(line, offset_value, spot, tab);
        offset = offset_value;
    }
    return spot;
}

/// Total display width of the line.
pub int line_width(str line, int tab) {
    return display_col(line, line.size(), tab);
}

/** The byte offsets where each screen row of `line` starts when it wraps at
 * `width` cells (the first is 0). A character that does not fit starts the
 * next row. */
pub List<int> wrap_breaks(str line, int width, int tab) {
    List<int> breaks = [0];
    if (width <= 0) {
        return breaks;
    }
    // plain printable ASCII: every `width` bytes is a row
    bool is_plain = true;
    for (int index in 0 .. line.size()) {
        int byte = line.byte_at(index);
        if (byte < 32 || byte >= 127) {
            is_plain = false;
            break;
        }
    }
    if (is_plain) {
        int next_break = width;
        while (next_break < line.size()) {
            breaks.push(next_break);
            next_break = next_break + width;
        }
        return breaks;
    }
    int spot = 0;
    int room = 0;
    for (int offset in starts(line)) {
        if (offset >= line.size()) {
            break;
        }
        int cells = cell_width(line, offset, spot, tab);
        if (room + cells > width && room > 0) {
            breaks.push(offset);
            room = 0;
        }
        room = room + cells;
        spot = spot + cells;
    }
    return breaks;
}

/// The display column of each offset in `offsets` (ascending), in one pass.
pub List<int> spots_of(str line, List<int> offsets, int tab) {
    List<int> spots = [];
    int want = 0;
    int spot = 0;
    for (int offset in starts(line)) {
        while (want < offsets.size() && offsets[want] <= offset) {
            if (offsets[want] == offset) {
                spots.push(spot);
            } else {
                spots.push(display_col(line, offsets[want], tab));
            }
            want = want + 1;
        }
        if (want >= offsets.size() || offset >= line.size()) {
            break;
        }
        spot = spot + cell_width(line, offset, spot, tab);
    }
    while (want < offsets.size()) {
        spots.push(spot);
        want = want + 1;
    }
    return spots;
}

/** The cluster start whose cells cover screen column `want`; the last
 * cluster when `want` is past the end (callers decide whether that is
 * allowed), 0 for the empty line. */
pub int col_at_display(str line, int want, int tab) {
    int spot = 0;
    int last = 0;
    for (int offset in starts(line)) {
        if (offset >= line.size()) {
            break;
        }
        int width = cell_width(line, offset, spot, tab);
        if (want < spot + width) {
            return offset;
        }
        spot = spot + width;
        last = offset;
    }
    return last;
}

/// The blanks (spaces and tabs) a line starts with.
pub str leading_white(str line) {
    int stop = 0;
    while (stop < line.size() && (line.byte_at(stop) == 32 || line.byte_at(stop) == 9)) {
        stop = stop + 1;
    }
    return line.substr(0, stop);
}
