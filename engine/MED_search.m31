// Searching the buffer: `/ ? n N * # g* g#`, search offsets, `%` and `[(`.
//
// A port of Vim's searchit(), do_search(), find_ident_under_cursor() and
// findmatchlimit(), checked against nvim.
//
// API
// ---
//   MED_search.compile_last(ed, pat)              compile with the editor's options
//   MED_search.searchit(ed, re, row, col, dir, count, at_start, at_end, no_offset) -> Hit
//   MED_search.search_command(ed, dirc, typed, count, reverse, use_typed) -> Outcome
//   MED_search.star(ed, key, whole_word, count)   `*` `#` `g*` `g#`
//   MED_search.skip_regexp(text, delim)           where the pattern in `text` ends
//   MED_search.findmatch(buf, row, col, initc, dir) -> MED_buffer.Pos (row -1: none)
//   MED_search.set_last_pattern(ed, pat, is_sub)  make `pat` the pattern `n` and `//` use

import engine.MED_editor;
import engine.MED_regex;
import engine.MED_buffer;
import engine.MED_text;

pub type Hit {
    pub bool is_ok = false;
    pub int row = 0;
    pub int col = 0;
    pub int erow = 0;
    pub int ecol = 0;
    /// Where the match starts (`row`/`col` is its last character for a search that ends there).
    pub int srow = 0;
    pub int scol = 0;
    /// The search ran past the end (or start) of the buffer to find this.
    pub bool is_wrapped = false;
    pub str error = "";
}

pub type Outcome {
    pub bool is_ok = false;
    pub int row = 0;
    pub int col = 0;
    /// 2 when a line offset was added (the motion becomes linewise).
    pub int kind = 1;
    pub bool is_inclusive = false;
    pub bool is_wrapped = false;
    pub str error = "";
}

/// The pattern `n` and an empty pattern use.
pub str last_pattern(MED_editor.Editor editor) {
    if (editor.is_last_is_sub) {
        return editor.sub_pattern;
    }
    return editor.search_pattern;
}

pub void set_last_pattern(MED_editor.Editor editor, str pattern, bool is_sub) {
    if (is_sub) {
        editor.sub_pattern = pattern;
    } else {
        editor.search_pattern = pattern;
    }
    editor.is_last_is_sub = is_sub;
    editor.is_no_hl = false;
    editor.regs.set_special("/", pattern);
}

pub MED_regex.Regex compile_with(MED_editor.Editor editor, str pattern, bool is_no_scs) {
    bool is_scs = editor.is_smartcase;
    if (is_no_scs) {
        is_scs = false;
    }
    return attach_context(editor, MED_regex.compile(pattern, editor.is_ignorecase, is_scs, editor.sub_replacement));
}

/// Give `regex` what `\%V` and `\%'m` need: the last Visual area (or the live one) and the marks.
pub MED_regex.Regex attach_context(MED_editor.Editor editor, MED_regex.Regex regex) {
    if (!regex.is_ok) {
        return regex;
    }
    int kind = editor.last_vkind;
    MED_buffer.Pos first = editor.last_vstart;
    MED_buffer.Pos last = editor.last_vend;
    if (editor.mode == MED_editor.VISUAL) {
        kind = editor.vkind;
        first = MED_buffer.Pos(editor.vrow, editor.vcol);
        last = MED_buffer.Pos(editor.row, editor.col);
    }
    if (kind != 0) {
        if (last.row < first.row || (last.row == first.row && last.col < first.col)) {
            MED_buffer.Pos swap = first;
            first = last;
            last = swap;
        }
        regex.visible_kind = kind;
        regex.visible_row1 = first.row;
        regex.visible_col1 = first.col;
        regex.visible_row2 = last.row;
        regex.visible_col2 = last.col;
        if (kind == 22 && first.row < editor.buffer.line_count() && last.row < editor.buffer.line_count()) {
            int one = MED_text.display_col(editor.buffer.line(first.row), first.col, editor.tab);
            int two = MED_text.display_col(editor.buffer.line(last.row), last.col, editor.tab);
            if (editor.vcol_at(editor.last_vstart.row, editor.last_vstart.col) >= 0) {
                one = editor.vcol_at(editor.last_vstart.row, editor.last_vstart.col);
                two = editor.vcol_at(editor.last_vend.row, editor.last_vend.col);
            }
            if (two < one) {
                int hold = one;
                one = two;
                two = hold;
            }
            regex.visible_left = one;
            regex.visible_right = two;
        }
    }
    regex.marks = editor.marks;
    return regex;
}

// ----------------------------------------------------------- pattern ends

int at(str line, int col) {
    if (col < 0 || col >= line.size()) {
        return 0;
    }
    return line.byte_at(col);
}

// After the `[` at `index`: the index just past the closing `]` of a collection,
// or -1 when this `[` does not start one (Vim's skip_anyof()).
int skip_anyof(str text, int index) {
    int offset = index + 1;
    if (at(text, offset) == 94) {
        offset = offset + 1;
    }
    if (at(text, offset) == 93 || at(text, offset) == 45) {
        offset = offset + 1;
    }
    while (offset < text.size() && at(text, offset) != 93) {
        int char_code = at(text, offset);
        if (char_code == 45) {
            offset = offset + 1;
            if (at(text, offset) == 93 || offset >= text.size()) {
                break;
            }
            offset = offset + 1;
        } else if (char_code == 92) {
            int count = at(text, offset + 1);
            if (count != 0 && "]^-n\\nrtebdoxuU".index_of(str.from_chars([count])).is_some()) {
                offset = offset + 2;
            } else {
                offset = offset + 1;
            }
        } else if (char_code == 91) {
            int count = at(text, offset + 1);
            if (count == 58 || count == 61 || count == 46) {
                int ahead = offset + 2;
                while (ahead < text.size() && !(at(text, ahead) == count && at(text, ahead + 1) == 93)) {
                    ahead = ahead + 1;
                }
                if (ahead < text.size()) {
                    offset = ahead + 2;
                } else {
                    offset = offset + 1;
                }
            } else {
                offset = offset + 1;
            }
        } else {
            offset = MED_text.next_col(text, offset);
        }
    }
    if (at(text, offset) == 93) {
        return offset + 1;
    }
    return -1;
}

/// The byte index in `text` where the pattern ends: at the first unescaped
/// `delim` outside a `[]` collection (Vim's skip_regexp()).
pub int skip_regexp(str text, int delim) {
    int offset = 0;
    bool is_magic = true;
    while (offset < text.size()) {
        int char_code = text.byte_at(offset);
        if (char_code == delim) {
            break;
        }
        if ((char_code == 91 && is_magic) || (char_code == 92 && at(text, offset + 1) == 91 && !is_magic)) {
            int from = offset;
            if (char_code == 92) {
                from = offset + 1;
            }
            int end = skip_anyof(text, from);
            if (end > 0) {
                offset = end;
            } else {
                offset = from + 1;
            }
        } else if (char_code == 92 && offset + 1 < text.size()) {
            int count = text.byte_at(offset + 1);
            if (count == 118) {
                is_magic = true;
            } else if (count == 86) {
                is_magic = false;
            }
            offset = offset + 2;
        } else {
            offset = MED_text.next_col(text, offset);
        }
    }
    return offset;
}

// --------------------------------------------------------------- searchit

int line_length(MED_buffer.Buffer buffer, int row) {
    return buffer.line_size(row);
}

/// One search of `regex` from (prow, pcol), `count` times, in direction `directory`
/// (1 or -1). `is_at_start` accepts a match at the start (SEARCH_START),
/// `is_at_end` puts the position on the last character of the match
/// (SEARCH_END), unless `is_no_offset`.
pub Hit searchit(MED_editor.Editor editor, MED_regex.Regex regex, int prow, int pcol, int directory, int count, bool is_at_start, bool is_at_end, bool is_no_offset) {
    MED_buffer.Buffer buffer = editor.buffer;
    int nlines = buffer.line_count();
    Hit hit = Hit();
    int current_row = prow;
    int current_col = pcol;
    bool is_first_match = true;
    int remaining = count;
    if (remaining < 1) {
        remaining = 1;
    }
    while (true) {
        int start_row = current_row;
        int start_col = current_col;
        int sclen = 1;
        if (start_row < nlines && start_col < line_length(buffer, start_row)) {
            sclen = MED_text.next_col(buffer.line(start_row), start_col) - start_col;
        }
        int extra = 0;
        if (directory > 0) {
            if (!is_at_start) {
                extra = sclen;
            }
        } else if (is_at_start) {
            extra = sclen;
        }
        bool is_found = false;
        bool is_first_line = true;
        int lnum = current_row;
        if (directory < 0 && current_col == 0 && !is_at_start) {
            lnum = current_row - 1;
            is_first_line = false;
        }
        int first_row = 0;
        int first_col = 0;
        int fer = 0;
        int fec = 0;
        for (int pass in 0 .. 2) {
            while (lnum >= 0 && lnum < nlines) {
                bool is_stop_check = true;
                MED_regex.Match match_value = regex.search_line(buffer, lnum, 0);
                if (match_value.is_aborted) {
                    hit.error = "E363: Pattern uses more memory than 'maxmempattern'";
                    return hit;
                }
                if (match_value.is_ok) {
                    int match_row = match_value.srow;
                    int match_col = match_value.scol;
                    int end_row = match_value.erow;
                    int end_col = match_value.ecol;
                    bool is_match_ok = true;
                    if (directory > 0 && is_first_line) {
                        while (match_row == lnum) {
                            int length = line_length(buffer, lnum);
                            bool is_before = false;
                            if (is_at_end && is_first_match) {
                                is_before = end_row == lnum && end_col - 1 < start_col + extra;
                            } else {
                                int adj = 0;
                                if (match_col >= length) {
                                    adj = 1;
                                }
                                is_before = match_col - adj < start_col + extra;
                            }
                            if (!is_before) {
                                break;
                            }
                            int matchcol = 0;
                            if (end_row > lnum) {
                                is_match_ok = false;
                                break;
                            }
                            matchcol = end_col;
                            if (matchcol == match_col && matchcol < length) {
                                matchcol = MED_text.next_col(buffer.line(lnum), matchcol);
                            }
                            if (matchcol == 0 && is_at_start) {
                                break;
                            }
                            if (matchcol >= length) {
                                is_match_ok = false;
                                break;
                            }
                            MED_regex.Match match_item = regex.search_line(buffer, lnum, matchcol);
                            if (!match_item.is_ok) {
                                is_match_ok = false;
                                break;
                            }
                            match_row = match_item.srow;
                            match_col = match_item.scol;
                            end_row = match_item.erow;
                            end_col = match_item.ecol;
                        }
                        if (!is_match_ok) {
                            is_stop_check = false;
                        }
                    } else if (directory < 0) {
                        is_match_ok = false;
                        int after_row = 0;
                        int after_col = 0;
                        int aer = 0;
                        int aec = 0;
                        int current_r = match_row;
                        int current_c = match_col;
                        int current_er = end_row;
                        int current_ec = end_col;
                        while (true) {
                            bool is_accept = false;
                            if (pass == 1) {
                                is_accept = true;
                            } else if (is_at_end) {
                                is_accept = current_er < start_row || (current_er == start_row && current_ec - 1 < start_col + extra);
                            } else {
                                is_accept = current_r < start_row || (current_r == start_row && current_c < start_col + extra);
                            }
                            if (!is_accept) {
                                break;
                            }
                            is_match_ok = true;
                            after_row = current_r;
                            after_col = current_c;
                            aer = current_er;
                            aec = current_ec;
                            int matchcol = 0;
                            if (current_er > lnum) {
                                break;
                            }
                            matchcol = current_ec;
                            int rlen = line_length(buffer, current_r);
                            if (matchcol == current_c && matchcol < rlen) {
                                matchcol = MED_text.next_col(buffer.line(current_r), matchcol);
                            }
                            if (matchcol >= rlen) {
                                break;
                            }
                            MED_regex.Match match_item = regex.search_line(buffer, current_r, matchcol);
                            if (!match_item.is_ok) {
                                break;
                            }
                            current_r = match_item.srow;
                            current_c = match_item.scol;
                            current_er = match_item.erow;
                            current_ec = match_item.ecol;
                        }
                        if (is_match_ok) {
                            match_row = after_row;
                            match_col = after_col;
                            end_row = aer;
                            end_col = aec;
                        } else {
                            is_stop_check = false;
                        }
                    }
                    if (is_match_ok) {
                        if (is_at_end && !is_no_offset && !(match_row == end_row && match_col == end_col)) {
                            first_row = end_row;
                            first_col = end_col;
                            if (end_col == 0) {
                                if (first_row > 0) {
                                    first_row = first_row - 1;
                                    first_col = line_length(buffer, first_row);
                                }
                            } else {
                                first_col = MED_text.previous_col(buffer.line(first_row), end_col);
                            }
                        } else {
                            first_row = match_row;
                            first_col = match_col;
                        }
                        hit.erow = end_row;
                        hit.ecol = end_col;
                        hit.srow = match_row;
                        hit.scol = match_col;
                        if (pass == 1) {
                            hit.is_wrapped = true;
                        }
                        is_found = true;
                        is_first_match = false;
                        break;
                    }
                }
                if (is_stop_check && pass == 1 && lnum == start_row) {
                    break;
                }
                lnum = lnum + directory;
                is_first_line = false;
            }
            is_first_line = false;
            if (!editor.is_wrapscan || is_found || pass == 1) {
                break;
            }
            if (directory < 0) {
                lnum = nlines - 1;
            } else {
                lnum = 0;
            }
        }
        if (!is_found) {
            hit.is_ok = false;
            return hit;
        }
        current_row = first_row;
        current_col = first_col;
        remaining = remaining - 1;
        if (remaining <= 0) {
            break;
        }
    }
    hit.is_ok = true;
    hit.row = current_row;
    hit.col = current_col;
    return hit;
}

// ------------------------------------------------------------- do_search

bool is_digit(int char_code) {
    return char_code >= 48 && char_code <= 57;
}

int parse_int_at(str text, int index) {
    int value = 0;
    int offset = index;
    while (offset < text.size() && is_digit(text.byte_at(offset))) {
        value = value * 10 + (text.byte_at(offset) - 48);
        offset = offset + 1;
    }
    return value;
}

// Vim's inc(): one position forward, stopping on the NUL ending a line; 0 for
// a move inside the line, 2 when it reached the NUL, 1 for the next line and
// -1 at the end of the buffer.
pub int inc_position(MED_buffer.Buffer buffer, List<int> position) {
    str line = buffer.line(position[0]);
    if (position[1] < line.size()) {
        position[1] = MED_text.next_col(line, position[1]);
        if (position[1] < line.size()) {
            return 0;
        }
        return 2;
    }
    if (position[0] + 1 < buffer.line_count()) {
        position[0] = position[0] + 1;
        position[1] = 0;
        return 1;
    }
    return -1;
}

// Vim's dec(): 0 inside a line, 1 onto the NUL of the previous line, -1 at the start.
pub int dec_position(MED_buffer.Buffer buffer, List<int> position) {
    if (position[1] > 0) {
        position[1] = MED_text.previous_col(buffer.line(position[0]), position[1]);
        return 0;
    }
    if (position[0] > 0) {
        position[0] = position[0] - 1;
        position[1] = buffer.line_size(position[0]);
        return 1;
    }
    return -1;
}

pub int incl_position(MED_buffer.Buffer buffer, List<int> position) {
    int result = inc_position(buffer, position);
    if (result >= 1 && position[1] > 0) {
        result = inc_position(buffer, position);
    }
    return result;
}

pub int decl_position(MED_buffer.Buffer buffer, List<int> position) {
    int result = dec_position(buffer, position);
    if (result == 1 && position[1] > 0) {
        result = dec_position(buffer, position);
    }
    return result;
}

// Step the position `count` characters forward (`count` > 0, incl()) or back (n < 0,
// decl()). False when the buffer's edge was hit first.
bool did_step_chars(MED_buffer.Buffer buffer, List<int> position, int count) {
    int left = count;
    while (left != 0) {
        int result = 0;
        if (left > 0) {
            result = incl_position(buffer, position);
            left = left - 1;
        } else {
            result = decl_position(buffer, position);
            left = left + 1;
        }
        if (result == -1) {
            return false;
        }
    }
    return true;
}

str unescape_question(str pattern) {
    List<int> codes = pattern.chars();
    List<int> out = [];
    int index = 0;
    while (index < codes.size()) {
        if (codes[index] == 92 && index + 1 < codes.size()) {
            if (codes[index + 1] == 63) {
                out.push(63);
            } else {
                out.push(92);
                out.push(codes[index + 1]);
            }
            index = index + 2;
        } else {
            out.push(codes[index]);
            index = index + 1;
        }
    }
    return str.from_chars(out);
}

/// Run a `/` or `?` command (or `n` / `N`: `is_use_typed` false). `typed` is the
/// text after the `/` as typed on the command line; `dirc` is 47 or 63 (0 for
/// n and N, which use the last direction); `is_reverse` flips it (N).
pub Outcome search_command(MED_editor.Editor editor, int dirc_in, str typed, int count, bool is_reverse, bool is_use_typed) {
    Outcome out = Outcome();
    int dirc = dirc_in;
    if (dirc == 0) {
        dirc = 47;
        if (editor.search_directory < 0) {
            dirc = 63;
        }
    } else {
        editor.search_directory = 1;
        if (dirc == 63) {
            editor.search_directory = -1;
        }
    }
    if (is_reverse) {
        if (dirc == 47) {
            dirc = 63;
        } else {
            dirc = 47;
        }
    }
    if (!is_use_typed && last_pattern(editor) == "" && editor.sub_pattern == "") {
        out.error = "E35: No previous regular expression";
        return out;
    }
    int from_row = editor.row;
    int from_col = editor.col;
    str rest = typed;
    bool is_have_text = is_use_typed && typed != "";
    int count_value = count;
    while (true) {
        int delim = dirc;
        str pattern = "";
        bool is_use_last = true;
        bool is_follow = false;
        str after = "";
        if (is_have_text) {
            int end = skip_regexp(rest, delim);
            pattern = rest.substr(0, end);
            int offset = end;
            if (offset < rest.size() && rest.byte_at(offset) == delim) {
                offset = offset + 1;
            }
            if (delim == 63) {
                pattern = unescape_question(pattern);
            }
            editor.is_search_off_line = false;
            editor.is_search_off_end = false;
            editor.search_off = 0;
            int first_char = at(rest, offset);
            if (first_char == 43 || first_char == 45 || is_digit(first_char)) {
                editor.is_search_off_line = true;
            } else if (first_char == 101 || first_char == 115 || first_char == 98) {
                if (first_char == 101) {
                    editor.is_search_off_end = true;
                }
                offset = offset + 1;
            }
            int second_char = at(rest, offset);
            if (is_digit(second_char) || second_char == 43 || second_char == 45) {
                if (is_digit(second_char) || is_digit(at(rest, offset + 1))) {
                    int sign = 1;
                    int ahead = offset;
                    if (second_char == 45) {
                        sign = -1;
                        ahead = offset + 1;
                    } else if (second_char == 43) {
                        ahead = offset + 1;
                    }
                    editor.search_off = sign * parse_int_at(rest, ahead);
                } else if (second_char == 45) {
                    editor.search_off = -1;
                } else {
                    editor.search_off = 1;
                }
                offset = offset + 1;
                while (offset < rest.size() && is_digit(rest.byte_at(offset))) {
                    offset = offset + 1;
                }
            }
            after = rest.substr(offset, rest.size());
            if (after.size() > 0 && after.byte_at(0) == 59) {
                is_follow = true;
            }
            is_use_last = pattern == "";
        }
        // the pattern to search for
        str pattern_text = "";
        bool is_no_scs = false;
        if (is_use_last) {
            pattern_text = last_pattern(editor);
            if (editor.search_pattern == "" && editor.sub_pattern != "") {
                pattern_text = editor.sub_pattern;
            }
            is_no_scs = editor.is_search_no_scs;
            if (editor.is_last_is_sub) {
                is_no_scs = false;
            }
            if (pattern_text == "") {
                out.error = "E35: No previous regular expression";
                return out;
            }
        } else {
            pattern_text = pattern;
            is_no_scs = editor.is_search_no_scs_next;
            set_last_pattern(editor, pattern_text, false);
            editor.is_search_no_scs = is_no_scs;
        }
        MED_regex.Regex regex = compile_with(editor, pattern_text, is_no_scs);
        if (!regex.is_ok) {
            out.error = regex.error;
            return out;
        }
        // with a character offset, start from where that offset would have come from
        List<int> position = [from_row, from_col];
        bool is_beyond = false;
        if (!editor.is_search_off_line && editor.search_off != 0) {
            int back = 0 - editor.search_off;
            if (!did_step_chars(editor.buffer, position, back)) {
                is_beyond = true;
            }
        }
        Hit hit = Hit();
        int sdir = 1;
        if (dirc == 63) {
            sdir = -1;
        }
        if (is_beyond) {
            // Vim puts the start before the first line (or after the last): the
            // search then begins at that edge
            if (editor.search_off > 0) {
                hit = searchit(editor, regex, 0, 0, sdir, count_value, true, editor.is_search_off_end, false);
            } else {
                hit = searchit(editor, regex, editor.buffer.line_count() - 1, editor.buffer.line_size(editor.buffer.line_count() - 1), sdir, count_value, false, editor.is_search_off_end, false);
            }
        } else {
            hit = searchit(editor, regex, position[0], position[1], sdir, count_value, false, editor.is_search_off_end, false);
        }
        if (!hit.is_ok) {
            if (hit.error != "") {
                out.error = hit.error;
            } else if (!editor.is_wrapscan) {
                if (dirc == 47) {
                    out.error = "E385: Search hit BOTTOM without match for: " + pattern_text;
                } else {
                    out.error = "E384: Search hit TOP without match for: " + pattern_text;
                }
            } else {
                out.error = "E486: Pattern not found: " + pattern_text;
            }
            return out;
        }
        from_row = hit.row;
        from_col = hit.col;
        if (hit.is_wrapped) {
            out.is_wrapped = true;
        }
        out.kind = 1;
        if (editor.is_search_off_line) {
            int target = from_row + editor.search_off;
            if (target < 0) {
                target = 0;
            }
            if (target > editor.buffer.line_count() - 1) {
                target = editor.buffer.line_count() - 1;
            }
            from_row = target;
            from_col = 0;
            out.kind = 2;
        } else if (editor.search_off != 0) {
            List<int> ahead = [from_row, from_col];
            did_step_chars(editor.buffer, ahead, editor.search_off);
            from_row = ahead[0];
            from_col = ahead[1];
        }
        if (!is_follow) {
            break;
        }
        // "/foo/;/bar/": another search from here
        int new_delete = at(after, 1);
        if (new_delete != 47 && new_delete != 63) {
            out.error = "E386: Expected '?' or '/'  after ';'";
            return out;
        }
        dirc = new_delete;
        rest = after.substr(2, after.size());
        is_have_text = true;
        count_value = 1;
    }
    out.is_ok = true;
    out.row = from_row;
    out.col = from_col;
    out.is_inclusive = editor.is_search_off_end;
    return out;
}

// ----------------------------------------------------------------- * and #

/// The identifier (or, failing that, the non-blank text) at or after `col`:
/// start and end byte columns, end exclusive; start -1 when there is none.
pub List<int> ident_at(str line, int col, List<int> keywords) {
    List<int> none = [-1, -1];
    for (int i in 0 .. 2) {
        int char_code = col;
        while (char_code < line.size()) {
            int cls = MED_text.class_at_in(line, char_code, keywords);
            if (cls != 0 && (i == 1 || cls != 1)) {
                break;
            }
            char_code = MED_text.next_col(line, char_code);
        }
        int this_class = MED_text.class_at_in(line, char_code, keywords);
        while (char_code > 0 && this_class != 0) {
            int prevcol = MED_text.previous_col(line, char_code);
            int previous_class = MED_text.class_at_in(line, prevcol, keywords);
            if (this_class != previous_class) {
                break;
            }
            char_code = prevcol;
        }
        if (this_class > 2) {
            this_class = 2;
        }
        if (this_class == 2 || i == 1) {
            if (char_code >= line.size() || (i == 0 && this_class != 2)) {
                if (i == 1) {
                    return none;
                }
                continue;
            }
            // the end
            int start_class = MED_text.class_at_in(line, char_code, keywords);
            int stop = char_code;
            while (stop < line.size()) {
                int cls = MED_text.class_at_in(line, stop, keywords);
                bool is_same = false;
                if (i == 0) {
                    is_same = cls == start_class;
                } else {
                    is_same = cls != 0;
                }
                if (!is_same) {
                    break;
                }
                stop = MED_text.next_col(line, stop);
            }
            return [char_code, stop];
        }
    }
    return none;
}

/// `*` `#` (`is_whole_word`) and `g*` `g#`: search for the word under the cursor.
/// Moves nothing itself; the result is the new position like search_command().
pub Outcome star(MED_editor.Editor editor, int key, bool is_whole_word, int count) {
    Outcome out = Outcome();
    str line = editor.buffer.line(editor.row);
    List<int> span = ident_at(line, editor.col, editor.buffer.keywords);
    if (span[0] < 0) {
        out.error = "E348: No string under cursor";
        return out;
    }
    str word = line.substr(span[0], span[1]);
    str special = "/.*~[^$\\";
    if (key == 35) {
        special = "/?.*~[^$\\";
    }
    List<int> pieces = [];
    bool is_word_start = MED_text.class_at_in(line, span[0], editor.buffer.keywords) >= 2;
    if (is_whole_word && is_word_start) {
        pieces.push(92);
        pieces.push(60);
    }
    for (int code_point in word.chars()) {
        if (code_point < 128 && special.index_of(str.from_chars([code_point])).is_some()) {
            pieces.push(92);
        }
        pieces.push(code_point);
    }
    int last_start = span[0];
    int offset = span[0];
    while (offset < span[1]) {
        last_start = offset;
        offset = MED_text.next_col(line, offset);
    }
    if (is_whole_word && MED_text.class_at_in(line, last_start, editor.buffer.keywords) >= 2) {
        pieces.push(92);
        pieces.push(62);
    }
    str pattern = str.from_chars(pieces);
    int saved_row = editor.row;
    int saved_col = editor.col;
    editor.col = span[0];
    editor.is_search_no_scs_next = true;
    int dirc = 47;
    if (key == 35) {
        dirc = 63;
    }
    Outcome outcome = search_command(editor, dirc, pattern, count, false, true);
    editor.is_search_no_scs_next = false;
    editor.row = saved_row;
    editor.col = saved_col;
    return outcome;
}

// ------------------------------------------------------------ findmatch

// Is there a `char_code` in `line` just before `col` (Vim's check_prevcol())?
bool is_previous_is(str line, int col, int char_code) {
    int code = col - 1;
    if (code > 0) {
        code = MED_text.snap(line, code);
    }
    return code >= 0 && at(line, code) == char_code;
}

int previous_of(str line, int col) {
    int char_code = col - 1;
    if (char_code > 0) {
        char_code = MED_text.snap(line, char_code);
    }
    return char_code;
}

// The matchpairs: [open, close, ...]
const List<int> PAIRS = [40, 41, 123, 125, 91, 93];

/// Where the bracket under or after the cursor (initc 0), or the bracket
/// `initc` searched in direction `directory` (1 forward, -1 backward, 0 as the
/// bracket says; for `[(` and friends), has its partner. Row -1: none.
/// Vim's findmatchlimit() with 'cpoptions' as nvim's default.
pub MED_buffer.Pos findmatch(MED_buffer.Buffer buffer, int row, int col, int initc_in, int directory) {
    MED_buffer.Pos none = MED_buffer.Pos(-1, 0);
    int from_row = row;
    int from_col = col;
    str linep = buffer.line(from_row);
    int initc = initc_in;
    int findc = 0;
    bool is_backwards = false;
    int match_escaped = 0;
    if (initc != 0) {
        // find_mps_values(&initc, &findc, &backwards, true)
        bool is_seen = false;
        for (int key in 0 .. PAIRS.size()) {
            if (PAIRS[key] == initc) {
                // (the assignment is shared by both arms: hoisted for m31 gap G8)
                findc = initc;
                if (key % 2 == 0) {
                    initc = PAIRS[key + 1];
                    is_backwards = true;
                } else {
                    initc = PAIRS[key - 1];
                    is_backwards = false;
                }
                is_seen = true;
                break;
            }
        }
        if (!is_seen) {
            return none;
        }
        if (directory != 0) {
            is_backwards = directory < 0;
        }
    } else {
        if (at(linep, from_col) == 0 && from_col > 0) {
            from_col = previous_of(linep, from_col);
        }
        while (true) {
            int char_code = at(linep, from_col);
            if (char_code == 0 || from_col >= linep.size()) {
                break;
            }
            bool is_hit = false;
            for (int key in 0 .. PAIRS.size()) {
                if (PAIRS[key] == char_code) {
                    initc = char_code;
                    if (key % 2 == 0) {
                        findc = PAIRS[key + 1];
                        is_backwards = false;
                    } else {
                        findc = PAIRS[key - 1];
                        is_backwards = true;
                    }
                    is_hit = true;
                    break;
                }
            }
            if (is_hit) {
                break;
            }
            from_col = MED_text.next_col(linep, from_col);
        }
        if (findc == 0) {
            return none;
        }
        int bslcnt = 0;
        int current_col = from_col;
        while (is_previous_is(linep, current_col, 92)) {
            bslcnt = bslcnt + 1;
            current_col = previous_of(linep, current_col);
        }
        match_escaped = bslcnt % 2;
    }
    int do_quotes = -1;
    int start_in_quotes = 0;
    bool is_inquote = false;
    int count = 0;
    int at_start = 0;
    int nlines = buffer.line_count();
    int guard = 0;
    while (true) {
        guard = guard + 1;
        if (is_backwards) {
            if (from_col == 0) {
                if (from_row == 0) {
                    break;
                }
                from_row = from_row - 1;
                linep = buffer.line(from_row);
                from_col = linep.size();
                do_quotes = -1;
            } else {
                from_col = from_col - 1;
                from_col = MED_text.snap(linep, from_col);
            }
        } else if (from_col >= linep.size()) {
            if (from_row == nlines - 1) {
                break;
            }
            from_row = from_row + 1;
            linep = buffer.line(from_row);
            from_col = 0;
            do_quotes = -1;
        } else {
            from_col = MED_text.next_col(linep, from_col);
        }
        if (do_quotes == -1) {
            at_start = do_quotes;
            int back_count = 0;
            if (is_backwards) {
                back_count = 1;
            }
            do_quotes = 0 - 1;
            int pointer = 0;
            while (pointer < linep.size()) {
                if (pointer == from_col + back_count) {
                    at_start = do_quotes & 1;
                }
                int char_value = linep.byte_at(pointer);
                if (char_value == 34 && (pointer == 0 || at(linep, pointer - 1) != 39 || at(linep, pointer + 1) != 39)) {
                    do_quotes = do_quotes + 1;
                }
                if (char_value == 92 && at(linep, pointer + 1) != 0) {
                    pointer = pointer + 1;
                }
                pointer = pointer + 1;
            }
            do_quotes = do_quotes & 1;
            if (do_quotes == 0) {
                is_inquote = false;
                if (linep.size() > 0 && at(linep, linep.size() - 1) == 92) {
                    do_quotes = 1;
                    if (start_in_quotes == 0) {
                        is_inquote = true;
                        start_in_quotes = 1;
                    } else if (is_backwards) {
                        is_inquote = true;
                    }
                }
                if (from_row > 0) {
                    str previous = buffer.line(from_row - 1);
                    if (previous.size() > 0 && at(previous, previous.size() - 1) == 92) {
                        do_quotes = 1;
                        if (start_in_quotes == 0) {
                            is_inquote = at_start != 0;
                            if (is_inquote) {
                                start_in_quotes = 1;
                            }
                        } else if (!is_backwards) {
                            is_inquote = true;
                        }
                    }
                }
            }
        }
        if (start_in_quotes == 0) {
            start_in_quotes = 2;
        }
        int char_code = at(linep, from_col);
        bool is_handled = false;
        if (from_col >= linep.size()) {
            if (from_col == 0 || at(linep, from_col - 1) != 92) {
                is_inquote = false;
                start_in_quotes = 2;
            }
            is_handled = true;
        } else if (char_code == 34) {
            if (do_quotes != 0) {
                int char_class = from_col - 1;
                while (char_class >= 0 && at(linep, char_class) == 92) {
                    char_class = char_class - 1;
                }
                if (((from_col - 1 - char_class) & 1) == 0) {
                    is_inquote = !is_inquote;
                    start_in_quotes = 2;
                }
            }
            is_handled = true;
        } else if (char_code == 39 && initc != 39 && findc != 39) {
            if (is_backwards) {
                if (from_col > 1) {
                    if (at(linep, from_col - 2) == 39) {
                        from_col = from_col - 2;
                        is_handled = true;
                    } else if (at(linep, from_col - 2) == 92 && from_col > 2 && at(linep, from_col - 3) == 39) {
                        from_col = from_col - 3;
                        is_handled = true;
                    }
                }
            } else if (at(linep, from_col + 1) != 0) {
                if (at(linep, from_col + 1) == 92 && at(linep, from_col + 2) != 0 && at(linep, from_col + 3) == 39) {
                    from_col = from_col + 3;
                    is_handled = true;
                } else if (at(linep, from_col + 2) == 39) {
                    from_col = from_col + 2;
                    is_handled = true;
                }
            }
        }
        if (!is_handled) {
            if ((!is_inquote || start_in_quotes == 1) && (char_code == initc || char_code == findc)) {
                int bslcnt = 0;
                int current_col = from_col;
                while (is_previous_is(linep, current_col, 92)) {
                    bslcnt = bslcnt + 1;
                    current_col = previous_of(linep, current_col);
                }
                if (bslcnt % 2 == match_escaped) {
                    if (char_code == initc) {
                        count = count + 1;
                    } else {
                        if (count == 0) {
                            return MED_buffer.Pos(from_row, from_col);
                        }
                        count = count - 1;
                    }
                }
            }
        }
    }
    return none;
}

// ------------------------------------------------------------------- gn

/// The area `gn` / `gN` selects: Visual start (`arow`, `acol`) and cursor.
pub type Area {
    pub bool is_ok = false;
    pub int arow = 0;
    pub int acol = 0;
    pub int crow = 0;
    pub int ccol = 0;
    pub str error = "";
}

bool is_earlier(int first_row, int first_col, int second_row, int second_col) {
    return first_row < second_row || (first_row == second_row && first_col < second_col);
}

/// Vim's current_search(): the next match of the last pattern as a Visual
/// area. `vrow`, `vcol` is the Visual start when `is_visual`.
pub Area current_search(MED_editor.Editor editor, int count, bool is_forward, bool is_visual, int vrow, int vcol) {
    Area area = Area();
    str pattern = last_pattern(editor);
    if (pattern == "") {
        area.error = "E35: No previous regular expression";
        return area;
    }
    bool is_no_scs = !editor.is_last_is_sub && editor.is_search_no_scs;
    MED_regex.Regex regex = compile_with(editor, pattern, is_no_scs);
    if (!regex.is_ok) {
        area.error = regex.error;
        return area;
    }
    MED_buffer.Buffer buffer = editor.buffer;
    bool is_skip_first_backward = is_forward && is_visual && is_earlier(editor.row, editor.col, vrow, vcol);
    int visual_row = vrow;
    int visual_col = vcol;
    List<int> position = [editor.row, editor.col];
    if (is_visual) {
        if (is_forward) {
            incl_position(buffer, position);
        } else {
            decl_position(buffer, position);
        }
    }
    // a pattern that matches nothing at all is an error; one that matches the
    // empty string is zero-width
    Hit first = searchit(editor, regex, 0, 0, 1, 1, true, false, false);
    if (!first.is_ok) {
        area.error = "E486: Pattern not found: " + pattern;
        return area;
    }
    bool is_zero_width = first.srow == first.erow && first.scol == first.ecol;
    int end_row = position[0];
    int end_col = position[1];
    bool is_saved_wrap = editor.is_wrapscan;
    for (int round in 0 .. 2) {
        if (round == 0 && is_skip_first_backward) {
            continue;
        }
        int directory = 1;
        if (is_forward) {
            if (round == 0) {
                directory = -1;
            }
        } else if (round == 1) {
            directory = -1;
        }
        bool is_at_end = directory < 0 && !is_zero_width;
        int rounds = 1;
        if (round == 1) {
            rounds = count;
            if (rounds < 1) {
                rounds = 1;
            }
        }
        if (round == 0) {
            editor.is_wrapscan = false;
        }
        Hit hit = searchit(editor, regex, position[0], position[1], directory, rounds, false, is_at_end, false);
        editor.is_wrapscan = is_saved_wrap;
        if (round == 1 && !hit.is_ok) {
            return area;
        }
        if (round == 0 && !hit.is_ok) {
            if (is_forward) {
                // from before the first line, a match at its very start counts
                Hit from_start = searchit(editor, regex, 0, 0, 1, 1, true, false, false);
                if (from_start.is_ok && count > 1) {
                    from_start = searchit(editor, regex, from_start.row, from_start.col, 1, count - 1, false, false, false);
                }
                if (!from_start.is_ok) {
                    return area;
                }
                position = [from_start.row, from_start.col];
                end_row = from_start.erow;
                end_col = from_start.ecol;
                break;
            }
            position = [buffer.line_count() - 1, buffer.line_size(buffer.line_count() - 1)];
        } else {
            position = [hit.row, hit.col];
            if (is_at_end) {
                end_row = hit.srow;
                end_col = hit.scol;
            } else {
                end_row = hit.erow;
                end_col = hit.ecol;
            }
        }
    }
    if (!is_visual) {
        visual_row = position[0];
        visual_col = position[1];
    }
    List<int> cursor = [end_row, end_col];
    if (is_earlier(visual_row, visual_col, end_row, end_col) && is_forward) {
        if (is_skip_first_backward) {
            cursor = [position[0], position[1]];
        } else {
            dec_position(buffer, cursor);
        }
    } else if (is_visual && is_earlier(cursor[0], cursor[1], visual_row, visual_col) && is_forward) {
        cursor = [position[0], position[1]];
    }
    area.is_ok = true;
    area.arow = visual_row;
    area.acol = visual_col;
    area.crow = cursor[0];
    area.ccol = cursor[1];
    return area;
}
