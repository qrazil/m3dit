/* The ex commands the engine hands to the front end.
 *
 * The engine parses every ex line but cannot carry out the commands that need files, buffers, windows or
 * the terminal: it leaves them in `Editor.requests` for the UI layer. This module is that list as data. The
 * editor starts with it (`Editor.ui_commands`); a plugin that moves out of the core takes its names out of
 * the list and registers them itself (docs/CORE-AND-PLUGINS.md 3.1, 7.2 step S0).
 *
 *   MED_cmdtab.core_ui_commands()   the names the core front end carries out */

/// The names of the core's UI commands.
pub List<str> core_ui_commands() {
    return ["edit", "enew", "bnext", "bprevious", "bNext", "buffer", "bdelete", "bwipeout", "bunload", "bfirst", "brewind", "blast", "ls", "buffers", "files", "close", "only", "split", "vsplit", "new", "vnew", "wincmd", "resize", "tabnew", "tabedit", "tabnext", "tabprevious", "tabNext", "tabfirst", "tabrewind", "tablast", "tabclose", "tabonly", "tabs", "tabmove", "Rename", "Delete", "Create", "Mkdir", "Files", "Buffers", "Grep", "Commands", "help", "Explore", "Sexplore", "Vexplore", "Keys", "Plugins", "PluginEnable", "PluginDisable", "Lsp", "bufdo", "list", "List", "ListNext", "ListPrev", "ListFirst", "ListLast", "ListClear", "lnext", "lprev", "lfirst", "llast", "lclear", "ldo", "lfdo", "Recent", "Symbols", "Branches", "Commits", "Changed", "source", "theme", "colorscheme", "checktime", "Session", "Registers", "recover", "args", "next", "Next", "previous", "argadd", "argdelete", "argdo", "windo", "tabdo", "tag", "pop", "tags", "make", "grep", "vimgrep", "file", "preserve", "Formatter", "Profile"];
}
