// Syntax highlighting for the editor: which language a buffer is, and the
// class of every byte of a line. The tokenizer, the language definitions and
// the detection live in the `syntax` library (github.com/qrazil/syntax); this
// module is the adapter: the `syntax` and `syntaxenabled` options, and a
// `SYN_highlight.Highlighter` kept on the editor and updated from the first
// row the buffer changed (`Buffer.dirty_row`).

import engine.MED_editor;
import engine.MED_semtok;
import syntax.core.SYN_detect;
import syntax.core.SYN_highlight;
import syntax.core.SYN_registry;

/// The language of the buffer: `:set syntax=NAME`, else by file name, modeline
/// or shebang; "" when highlighting is off or the file type is not known.
pub str language(MED_editor.Editor editor) {
    if (editor.opts.get("syntaxenabled").or("true") == "false") {
        return "";
    }
    str named = editor.opts.get("syntax").or("");
    if (named == "off" || named == "none") {
        return "";
    }
    if (named != "") {
        // a name, or a Vim file type / alias ("js", "py", "bash", "md")
        str alias = SYN_detect.alias_of(named);
        for (str known in SYN_registry.names()) {
            if (known == alias) {
                return alias;
            }
        }
        return "";
    }
    str first = "";
    if (editor.buffer.line_count() > 0) {
        first = editor.buffer.line(0);
    }
    return SYN_detect.language_of(editor.buffer.path, first);
}

/// The class of each byte of line `row` (all 25 classes of the library; the
/// renderer draws each, `SYN_class.legacy` is the fold onto the first twelve),
/// or an empty list without highlighting. Semantic tokens from a language
/// server (`editor.sem`, engine/MED_semtok.m31) are painted over the lexical
/// classes, on a row whose text is still the one they were computed for.
pub List<int> classes_of(MED_editor.Editor editor, int row, str lang) {
    List<int> lexical = lexical_classes(editor, row, lang);
    if (editor.sem.count == 0 || row >= editor.buffer.line_count()) {
        return lexical;
    }
    return MED_semtok.overlay(editor.sem, row, editor.buffer.line(row), lexical);
}

// The lexer's classes of a row.
List<int> lexical_classes(MED_editor.Editor editor, int row, str lang) {
    if (lang == "") {
        return [];
    }
    int dirty = editor.buffer.dirty_row;
    editor.buffer.dirty_row = 1000000000;
    if (editor.syn.language != lang) {
        editor.syn = SYN_highlight.Highlighter(language: lang);
        editor.syn.set_lines(editor.buffer.lines);
    } else if (dirty < editor.buffer.line_count() || editor.syn.synced != editor.buffer.line_count()) {
        int from = dirty;
        if (from > editor.buffer.line_count()) {
            from = 0;
        }
        editor.syn.update(from, editor.buffer.lines);
    }
    if (row >= editor.buffer.line_count()) {
        return [];
    }
    return editor.syn.classes(row);
}
